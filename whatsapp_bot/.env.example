# AskMukthiGuru WhatsApp Bot Configuration
# ==========================================

# Core Backend Configuration
ASKMUKTHIGURU_API_URL=https://your-backend-host.com
JWT_SECRET=replace_with_value_matching_backend_dotenv_JWT_SECRET

# --- Option A: Twilio WhatsApp Setup ---
# Twilio Account SID & Auth Token (from Twilio Console)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
# Sender phone. Sandbox: whatsapp:+14155238886, or your approved Twilio number
TWILIO_FROM=whatsapp:+14155238886

# --- Option B: Meta WhatsApp Cloud API Setup ---
# From Meta for Developers App Dashboard
META_APP_SECRET=replace_with_meta_app_secret
META_VERIFY_TOKEN=replace_with_custom_webhook_verify_token
META_ACCESS_TOKEN=replace_with_system_user_permanent_token
META_PHONE_NUMBER_ID=replace_with_phone_number_id

# --- Bot Runtime Options (Optional) ---
WA_DB_PATH=./wa_state.db
WA_CHAT_TIMEOUT_S=60
WA_HISTORY_LIMIT=10
WA_ASYNC_ACK=true
# Per-phone edge rate limit: backend turns per window (protects the backend's
# shared 20/minute egress-IP limiter from a single WA number).
WA_RATE_LIMIT_COUNT=10
WA_RATE_LIMIT_WINDOW_S=60
PORT=8080

# Optional: pre-approved Meta template (no variables) used to reopen a closed
# 24-hour window. Without it, replies outside the window are blocked, not sent.
META_TEMPLATE_NAME=
META_TEMPLATE_LANG=en
