# ── Mukthi Guru — Railway Production Dockerfile (Multi-Stage, Memory-Optimised) ──
# Architecture:
#   Stage 1 (builder): Installs Python dependencies in /opt/venv, pre-caches INT8 ONNX models
#   Stage 2 (runtime): Copies clean /opt/venv + model cache + app code
#
# Key optimizations:
#   - Full virtual environment isolation (/opt/venv) preserves PyTorch C-extensions
#   - Build tools (gcc, g++, make) stay in builder stage only (eliminates ~400MB)
#   - Pip cache purged, unneeded build artifacts omitted
#   - CPU-only PyTorch wheel via https://download.pytorch.org/whl/cpu (saves ~2.5GB CUDA bloat)
#   - QUANTIZED_ONLY=true: Bakes in only INT8 ONNX models (~1.3GB vs ~7.5GB unquantized)
#   - Target final image: ~2.5GB (down from 7.8GB)
#   - Runtime uses malloc_trim + gc.collect to minimize resident memory (RSS)

# ── Stage 1: Builder ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gcc g++ make && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/*

WORKDIR /build

# Create clean virtualenv
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install all locked dependencies with CPU wheels for torch/torchvision
COPY backend/requirements.lock ./requirements.lock
RUN pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    -r requirements.lock && \
    pip cache purge

# Pre-cache runtime models (ONNX INT8 quantized models + tokenizers only)
ENV HF_HOME=/build/model_cache/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/build/model_cache/sentence_transformers \
    TRANSFORMERS_CACHE=/build/model_cache/huggingface \
    QUANTIZED_ONLY=true \
    EMBEDDING_BACKEND=onnx_int8 \
    RERANKER_BACKEND=onnx_int8 \
    CURL_CA_BUNDLE=""

COPY backend/scripts/download_models.py ./scripts/download_models.py
RUN python3 scripts/download_models.py && \
    find /build/model_cache -type f -name "*.lock" -delete 2>/dev/null || true && \
    find /build/model_cache -type d -name ".locks" -exec rm -rf {} + 2>/dev/null || true && \
    find /build/model_cache -type d -name "tmp*" -exec rm -rf {} + 2>/dev/null || true

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ffmpeg libgomp1 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/* /tmp/* /var/tmp/*

RUN useradd -m -s /bin/bash appuser

WORKDIR /app

# Copy complete virtualenv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy pre-baked model cache from builder
COPY --chown=appuser:appuser --from=builder /build/model_cache /app/.cache

# Cache buster (filled by Railway buildx with commit SHA; behavior-neutral)
ARG GIT_COMMIT
RUN echo "Build: ${GIT_COMMIT:-$(date +%s)}" > /dev/null

# Copy application code
COPY --chown=appuser:appuser backend/ .

# Approved maintenance utility only
COPY --chown=appuser:appuser scripts/ops/rotate_brain_kek.py ./scripts/ops/rotate_brain_kek.py

# OKF compiled index and memory files
COPY --chown=appuser:appuser memory/ ./memory/

# Create runtime directories with non-root ownership
RUN mkdir -p /app/data /app/logs && chown -R appuser:appuser /app/data /app/logs /app/.cache && \
    find /app -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true && \
    find /app -type f -name "*.pyc" -delete 2>/dev/null || true

# Production environment
ENV ENV=production \
    IS_PRODUCTION=true \
    WEB_CONCURRENCY=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONOPTIMIZE=1 \
    # Model cache paths
    HF_HOME=/app/.cache/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/app/.cache/sentence_transformers \
    TRANSFORMERS_CACHE=/app/.cache/huggingface \
    # Inference configurations
    EMBEDDING_BACKEND=onnx_int8 \
    RERANKER_BACKEND=onnx_int8 \
    EMBEDDING_MODEL=BAAI/bge-m3 \
    EMBEDDING_DIMENSION=1024 \
    RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2 \
    QUANTIZED_ONLY=true \
    # Caching & coalescing
    SEMANTIC_CACHE_ENABLED=true \
    SEMANTIC_CACHE_SIMILARITY=0.92 \
    HYBRID_SEARCH_ENABLED=true \
    CACHE_COALESCE_ENABLED=true \
    REQUEST_COALESCE_ENABLED=true \
    HOT_CACHE_TTL=300 \
    VECTOR_CACHE_ENABLED=true \
    EXACT_CACHE_ENABLED=true \
    # Timeouts & thread controls
    LLM_TIMEOUT=90 \
    PIPELINE_TIMEOUT=180 \
    TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=2 \
    MKL_NUM_THREADS=2 \
    PEFT_FAST_IMPORT_MODE=1

EXPOSE 8000

USER appuser

CMD ["python", "start_railway.py"]
