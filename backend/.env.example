# ============================================================
# Mukthi Guru — Example Environment Configuration
# Copy to .env and fill in values. Do NOT commit .env to git.
# ============================================================

# --- LLM PROVIDER ---
# Options: "openrouter" (live default since 2026-09-12; needs OPENROUTER_API_KEY), "sarvam_cloud", "ollama"
LLM_PROVIDER=openrouter

# --- QUANTIZED ML BACKENDS (Low Memory Footprint & High CPU Speed) ---
# Options: "onnx_int8" (recommended for production/low-RAM), "flagembedding"
EMBEDDING_BACKEND=onnx_int8
RERANKER_BACKEND=onnx_int8

# --- SARVAM CLOUD API ---
SARVAM_API_KEY=
SARVAM_CLOUD_MODEL=sarvam-30b
SARVAM_CLOUD_CLASSIFY_MODEL=sarvam-30b
SARVAM_RPM_LIMIT=60
SARVAM_DAILY_BUDGET_USD=10.0
SARVAM_MONTHLY_BUDGET_USD=100.0
SARVAM_MAX_REQUEST_COST_USD=0.05
SARVAM_BUDGET_GUARD_ENABLED=true

# --- OPENROUTER ---
OPENROUTER_API_KEY=
OPENROUTER_GENERATION_MODEL=deepseek/deepseek-chat
OPENROUTER_GENERATION_MODEL_FALLBACK=meta-llama/llama-3.3-70b-instruct
OPENROUTER_CLASSIFY_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_FAST_MODEL=meta-llama/llama-3.1-8b-instruct
USE_OPENROUTER_FOR_SIMPLE=true
OPENROUTER_POLICY_ID=deepseek-budget-v1
OPENROUTER_ENFORCE_MODEL_POLICY=true
OPENROUTER_REQUIRE_NO_TRAINING=true
OPENROUTER_ALLOW_PROVIDER_FALLBACKS=true
OPENROUTER_ALLOWED_PROVIDERS=
OPENROUTER_DAILY_BUDGET_USD=10.0
OPENROUTER_MONTHLY_BUDGET_USD=40.0
OPENROUTER_MAX_REQUEST_COST_USD=0.03
OPENROUTER_BUDGET_GUARD_ENABLED=true
OPENROUTER_BUDGET_FAIL_CLOSED=true


# --- NVIDIA NIM ---
NIM_API_KEY=
NIM_GENERATION_MODEL=meta/llama-3.1-8b-instruct
NIM_CLASSIFY_MODEL=meta/llama-3.1-8b-instruct
NIM_RPM_LIMIT=30

# --- MODEL PRESET (Ollama only) ---
MODEL_PRESET=qwen
OLLAMA_MODEL=
OLLAMA_CLASSIFY_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# --- YOUTUBE INGESTION ---
# Webshare.io residential proxy (free: 10 proxies). Bypasses YouTube's GCP IP block.
# Set this on both the web API and celery-worker Railway services.
# Sign up: https://webshare.io → get proxy URL like http://user:pass@host:port
WEBSHARE_PROXY_URL=
# Base64-encoded cookies.txt from a logged-in YouTube session.
# Export via browser extension (e.g. "Get cookies.txt" for Chrome).
#   cat cookies.txt | base64 | pbcopy   # macOS, then paste as Railway env var
# This is safer than mounting a file — no filesystem dependency.
YOUTUBE_COOKIES_B64=

# --- INFRASTRUCTURE ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=spiritual_wisdom_contextual
# Quantization: scalar_int8 (default), binary, turboquant_1bit, turboquant_2bit, turboquant_4bit
QDRANT_QUANTIZATION=scalar_int8
QDRANT_QUANTIZATION_OVERSAMPLING=3.0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Memgraph (Graph DB - aliases NEO4J_* by default)
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USERNAME=neo4j
MEMGRAPH_PASSWORD=
MEMGRAPH_DATABASE=memgraph
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# --- SUPABASE ---
# Leaked-password protection requires a Pro plan or above.
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=
JWT_SECRET=
SUPABASE_ANON_KEY=

# HMAC secret signing anonymous chat session tokens (resolve_anon_identity).
# Required in production — startup raises without it. Generate with:
#   openssl rand -hex 32
ANON_SESSION_HMAC_SECRET=

# --- SECOND BRAIN (Mukthi Vault) ---
# Mode-A server-side KEK, wraps each user's per-user DEK. Generate with:
#   openssl rand -base64 32
# Rotating this orphans previously-wrapped DEKs — plan a re-wrap migration
# job before rotating in production. Optional: without it, vault provisioning
# fails closed (503) rather than falling back to an unwrapped/weak key.
BRAIN_KEK=

# --- GOOGLE OAUTH (frontend only) ---
# Google client configuration is browser-facing and belongs in VITE_GOOGLE_CLIENT_ID.

# --- FACEBOOK OAUTH ---
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- SERVER ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
RATE_LIMIT_PER_MINUTE=10
# Master production flag. validate_production_env.py's preflight and several
# config validators (e.g. forwarded_allow_ips wildcard check) key off this.
IS_PRODUCTION=false
# Comma-separated trusted proxy IPs/CIDRs for uvicorn's ProxyHeaders middleware
# (X-Forwarded-For/-Proto trust). Required, non-wildcard, in production —
# start_railway.py refuses to boot without it. Example: 10.0.0.0/8
FORWARDED_ALLOW_IPS=
# P1-OPS-8: max concurrent in-flight /api/chat requests per replica (503 + Retry-After when exhausted)
# Set to 8 to align with realistic 60 RPM Sarvam limits for 8-step Standard path.
MAX_CONCURRENT_CHAT=8

# --- BENCHMARKS ---
# Optional secret for local benchmark auth backdoor (X-Test-Key header).
# Only used when ENABLE_TEST_AUTH=true and IS_PRODUCTION=false are also set.
# If unset, falls back to JWT_SECRET for backward compatibility.
BENCHMARK_SECRET=

# --- ADMIN SECURITY (P1-SEC-1) ---
# Comma-separated UUID allowlist of admin users. When set, an AAL2 superuser
# must also be in this list to access /api/admin/*, /api/ingest/*,
# /api/kg/sparql, /api/metrics/cache and compliance endpoints. Empty = not
# enforced (dev default). Example: 00000000-0000-0000-0000-0000000000aa,11111111-1111-1111-1111-1111111111aa
ADMIN_USER_IDS=

# --- CELERY ---
# Task visibility timeout (seconds). Must be > longest task duration. Default 3600 (1 hour).
CELERY_BROKER_VISIBILITY_TIMEOUT=3600
# OpenAI API key for Whisper transcription (pay-per-use fallback). Optional.
OPENAI_API_KEY=

# --- AUTH BACKDOOR (LOCAL DEV ONLY) ---
# NEVER enable in production. Enables the X-Test-Key benchmark auth; requires
# IS_PRODUCTION=false (see SERVER section above) as well as this flag.
# ENABLE_TEST_AUTH=true

# --- INGESTION SERVICES ---
# Supadata API key for managed YouTube transcript fallback. Free tier: 100 req/month.
SUPADATA_API_KEY=

# --- HALLUCINATION ANOMALY DETECTION ---
# Daily cron/CI check thresholds. Hallucination rate above ANOMALY_HALLUCINATION_RATE_THRESHOLD or
# median faithfulness below ANOMALY_FAITHFULNESS_P50_THRESHOLD triggers alert.
ANOMALY_HALLUCINATION_RATE_THRESHOLD=0.05
ANOMALY_FAITHFULNESS_P50_THRESHOLD=0.80
ANOMALY_LOOKBACK_DAYS=1


# --- GOVERNED SOURCE RELEASES ---
# Keep disabled until the Supabase migration and approval/rollback staging drill pass.
CORPUS_RELEASE_REGISTRY_ENABLED=false
CORPUS_RELEASE_FALLBACK_VERSION=1

# --- Observability ---
# Credential Prometheus presents to GET /internal/metrics, which serves the
# same exposition as the admin-only /metrics. Generate with:
#     python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Leave EMPTY to keep the scrape endpoint disabled (it returns 404 and the
# Prometheus target reports DOWN — a visible failure, not a silent one).
METRICS_SCRAPE_TOKEN=

# Faculty preview gate. When set, /api/chat*, /api/first-person* and /api/jobs*
# return 401 unless the request carries X-Faculty-Code with this exact value.
# Leave EMPTY to disable the gate. Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(16))'
FACULTY_ACCESS_CODE=

# --- FIRST-PERSON VERBATIM ROUTE ---
# Pinned 2026-10-20 so a deployment never inherits a changed code default.
# retrieval_only = deterministic clip-only answer text (the only value the
# production release contract accepts). The default pipeline may still make
# answerability, relevance-scoring and rerank provider calls; it just cannot
# author or paraphrase the served teaching text. "hybrid" = owner opt-in that
# lets the LLM write opening/connective/question prose around verbatim quotes;
# never set it in production. "disabled" keeps the route 404ing.
FIRST_PERSON_MODE=retrieval_only
# Relevance scorer (0-3 per clip). Empty = the default fast OpenRouter model.
# The owner-approved scorer is anthropic/claude-haiku-5.5, which must also be
# listed in OPENROUTER_EXTRA_ALLOWED_MODELS or the budget policy blocks it. A
# fresh clone that copies this file without both lines does NOT run the scorer
# the docs describe (audit 2026-10-25).
FIRST_PERSON_RELEVANCE_MODEL=
# Parent/child context harness (fp-context-v1). OFF: the context collection and
# its payload indexes do not exist yet, so enabling this against the served
# first_person_v9 collection would serve nothing. Wiring also requires the
# harness policy to join the exact-cache fingerprint (see
# docs/FIRST_PERSON_CONTEXT_HARNESS_PHASE_A_2026-10-20.md §A5).
FIRST_PERSON_CONTEXT_HARNESS_ENABLED=false
# Observer only: compares the candidate collection after normal non-crisis answers.
# Does not alter response, citations, cache, route, or crisis behavior. Keep off by default.
FIRST_PERSON_CONTEXT_SHADOW_ENABLED=false
# Explicit fp-context-v1 candidate collection; never set to the active alias/collection.
FIRST_PERSON_CONTEXT_COLLECTION=
FIRST_PERSON_CONTEXT_MAX_SPANS=3
# v10-only serving (owner decision 2026-10-30). Needs the harness on. A question the
# harness cannot answer abstains; no legacy collection is ever read. For v10-only
# set BOTH slots to the same context collection (the contract allows that only
# when the harness and this flag are both on; any other mix stops startup):
#   FIRST_PERSON_COLLECTION=first_person_v10
#   FIRST_PERSON_CONTEXT_COLLECTION=first_person_v10
#   FIRST_PERSON_CONTEXT_HARNESS_ENABLED=true
#   FIRST_PERSON_CONTEXT_TERMINAL_ENABLED=true
# Roll back by restoring FIRST_PERSON_COLLECTION=first_person_v8 and turning both
# flags off in one change (turning a flag off while the slots still match stops startup).
FIRST_PERSON_CONTEXT_TERMINAL_ENABLED=false
# Optional structured span selector (Phase D8). OFF: when on, the model may only
# return span IDs that retrieval already produced; any prose/answer field in its
# reply is ignored and an unknown id falls back to deterministic order.
FIRST_PERSON_CONTEXT_SELECTOR_ENABLED=false
FIRST_PERSON_CONTEXT_SELECTOR_MODEL=
# --- FIRST-PERSON PRIMARY POSTURE (2026-10-27) ---
# Master switch for the FP-primary posture. On: a first-person hit is terminal —
# a direct answer serves the clip and a weak_match serves the clip under the
# honest related label carried in metadata (`verification.direct=false`), and the
# generating graph never runs for a topic the corpus covers. Off: the finer
# FIRST_PERSON_SERVE_WEAK_MATCH knob alone decides (pre-2026-10-27 behaviour).
# Neither setting weakens a gate (relevance minimum, integrity, boundary, output rail).
FIRST_PERSON_PRIMARY_MODE=true
# Finer knob under the primary posture: serve an answerability-gated weak_match clip
# (labelled honestly, in metadata) instead of declining. Only consulted while
# FIRST_PERSON_PRIMARY_MODE=true.
FIRST_PERSON_SERVE_WEAK_MATCH=true
# RAG-2 context enrichment window for the fp-context harness path. When on, each
# retrieved parent context is re-hydrated to the whole parent unit (bounded by
# FIRST_PERSON_CONTEXT_MAX_SPANS) so the harness can see the predecessor span that
# carries an antecedent ("this truth", "it"). Costs one extra scroll per parent.
# Off until measured.
FIRST_PERSON_ENRICHMENT_WINDOW_ENABLED=false
# T3 graph-guided candidate expansion. When on, ontology-neighbour concepts for the
# query run one additional payload-filtered context retrieval over spans already
# tagged with those concepts. The extra pool is appended AFTER the vector results and
# still passes every harness gate, so this is additive only. Never LLM generation.
FIRST_PERSON_GRAPH_EXPANSION_ENABLED=false
FIRST_PERSON_GRAPH_EXPANSION_MAX_NEIGHBORS=8
FIRST_PERSON_GRAPH_EXPANSION_TIMEOUT_S=1.5

# --- FIRST-PERSON OWNER-ONLY LOCAL REVIEW (2026-10-22) ---
# File-backed preview of the Phase-4 `local_review_candidate` tier. It reads
# the pinned candidate manifests directly: NO Qdrant read, NO Qdrant write, NO
# alias, NO Redis, and NO LLM-authored teaching text. Every response is
# labelled "review candidate / not public release".
# The route refuses to run unless this is true AND IS_PRODUCTION=false, so a
# deployment that sets it by accident still serves nothing.
FIRST_PERSON_LOCAL_REVIEW_ENABLED=false
# Path to the local-review contract (default: backend/config/first_person_local_review.json).
# It pins every artifact by sha256; a missing or modified artifact refuses startup.
FIRST_PERSON_LOCAL_REVIEW_CONTRACT_PATH=
# Repository root the pinned artifact paths resolve against (default: derived
# from the contract file's location).
FIRST_PERSON_LOCAL_REVIEW_ROOT=
# Path to the B4 serving-contract declaration (default:
# backend/config/first_person_serving_contract.json). It records, per
# collection, its payload schema, role, corpus version, required payload fields
# and evidence policy. A legacy store pointed at an fp-context collection
# fails closed.
FIRST_PERSON_SERVING_CONTRACT_PATH=
