<urn:mukthiguru:Enlightened%20States%20of%20Consciousness> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#description> """Enlightened States of Consciousness are the third plane of One-Consciousness, characterized by complete awakening and realization. They represent a permanent awakened consciousness that transcends duality, dissolving distinctions between matter and consciousness, self and other, and the divine and human.

In these states, individuals experience a flow with life, influencing external circumstances harmoniously and creating a sense of oneness. The experiences are described as grand, sacred, and blissful, offering a direct perception of reality that goes beyond ordinary limits.""";
  <neo4j://graph.schema#entity_id> "Enlightened States of Consciousness";
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: uSAO5p0GIU8 (URL: https://www.youtube.com/watch?v=uSAO5p0GIU8)<SEP>YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)";
