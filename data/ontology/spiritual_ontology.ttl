  <neo4j://graph.schema#source_id> "chunk-ad21c8251c43d2428c2c1fc6eaf57acc<SEP>chunk-8b1cb9338748404cabaa24ac4be68f56";
  <neo4j://graph.schema#file_path> "YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)";
