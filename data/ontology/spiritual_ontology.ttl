<urn:mukthiguru:Loneliness> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_id> "Loneliness";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#description> """Entity Name: Loneliness

Description List:<SEP>A state of feeling alone, discussed in the context of self-imposed isolation and emotional conflicts.<SEP>Loneliness is an emotional state of isolation, particularly emphasized among youngsters in the context of modern challenges.<SEP>Loneliness is an emotional state of isolation, particularly emphasized among youngsters in the context of modern challenges.<SEP>Increased sense of isolation among young generations, contributing to psychological distress.<SEP>Loneliness is a state of isolation and lack of companionship, frequently experienced after a separation.<SEP>Loneliness is a prolonged state of isolation, disconnected from the active emotion of love.""";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=JwMlR98BgrI)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)<SEP>YouTube Video: nen-DB_tz4M (URL: https://www.youtube.com/watch?v=nen-DB_tz4M)<SEP>YouTube Video: LapJqYf9hzI (URL: https://www.youtube.com/watch?v=LapJqYf9hzI)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=3weAVHuSCxg)";
