<urn:mukthiguru:Judgments> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#file_path> "YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)<SEP>unknown_source<SEP>YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#entity_id> "Judgments";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#description> "Original erroneous phrase \"about judgments\" in the audio text, later corrected to reflect a spiritual concept.<SEP>Judgments and fault-finding are cognitive processes that emerge in relationships after dopamine subsides, leading to ordinary interactions.<SEP>Judgments are constant mental evaluations of others or situations, creating divisions and preventing truth perception.<SEP>Judgments are evaluative opinions or criticisms highlighted in the video as barriers to truth and relationships.<SEP>Judgments are precise evaluations of right, wrong, or appropriate behavior in various contexts.<SEP>Judgments refer to preconceived attitudes or opinions about others and life circumstances, often examined through meditation to assess their validity.<SEP>Judgments refer to preconceived attitudes or opinions about others and life circumstances, often examined through meditation to assess their validity.";
  <neo4j://graph.schema#source_id> "chunk-063bbfb5769dde09e2cc6d99540be5c3<SEP>chunk-9a7c58d7cc886bef4c4d232cf5fffc42<SEP>chunk-3f2351d7bbf12ee7e6a879305b4fddf7<SEP>chunk-557efbfbf9c9ce831df3d12449f77fc2<SEP>chunk-ff648886e29693de0f8c7afb7b4a9d7e<SEP>chunk-15d5c49dad57bbf0bfa887044a164738";
  <neo4j://graph.schema#created_at> "1779650715"^^<http://www.w3.org/2001/XMLSchema#long> .

