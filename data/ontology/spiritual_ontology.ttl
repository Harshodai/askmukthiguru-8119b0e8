<urn:mukthiguru:Soul%20Sync%20Challenge> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#created_at> "1779732038"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#description> "The Soul Sync Challenge is a multi-day event where participants engage in daily mantra practice to expand consciousness.<SEP>The Soul Sync Challenge is a meditation program designed to help participants master synchronization with Universal Consciousness through guided practices.<SEP>The Soul Sync Challenge is a meditation program designed to help participants master synchronization with Universal Consciousness through guided practices.<SEP>The Soul Sync Challenge is a meditation event that occurs on Day Two and involves multiple stages, including the second stage which aims to achieve relaxation.";
  <neo4j://graph.schema#truncate> "";
