  <neo4j://graph.schema#file_path> "unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hcNDrMy6gCE)<SEP>YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)<SEP>YouTube Video: 1PlGMOAypCI (URL: https://www.youtube.com/watch?v=1PlGMOAypCI)";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#entity_id> "Guilt";
  <neo4j://graph.schema#description> "Guilt is an emotional state experienced by Diego following his son's death, stemming from his perceived responsibility and inability to connect with his son.<SEP>Guilt is a state that Diego fell into, believing it was a way to love his son, but was actually a form of self-punishment.<SEP>An emotion parents are advised to overcome for healthy relationships.`<SEP>Guilt is an emotional state arising from remorse over actions or failures, contributing to Dasharatha's torment and eventual demise.<SEP>Guilt is an emotional state discussed in the context of forgiveness, with Krishnaji rejecting its worship.<SEP>Guilt is a concept discussed in the text.<SEP>Guilt is an emotion experienced by Peter after denying Jesus.";
  <neo4j://graph.schema#source_id> "chunk-214089f71bed8468f80247a24979283e<SEP>chunk-999192b96103e7c498639cfadd062722<SEP>chunk-938d8c7cf2e140a4e60de3b5d9b45278<SEP>chunk-c0b80dedb75ca2eb809b280546928f57<SEP>chunk-48c6db0a5b206ddf4f5b6555c5408117<SEP>chunk-96ee5b32030dd42df75feab094827373<SEP>chunk-51a2b155e4eeb45d726ca7ab16117dcc" .

