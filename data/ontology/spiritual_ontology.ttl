  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#description> "Growth is the continuous process of dissolving past suffering and evolving consciousness through spiritual practice.><SEP>Growth is associated with personal development, implicitly connected to suffering in the text.<SEP>Growth refers to personal and collective transformation within the family.<SEP>The process of personal and spiritual development to overcome violent tendencies and achieve peace.<SEP>Growth in life is halted when individuals are stuck in rigid attitudes or judgments.`<SEP>The process of self-improvement across intellectual, emotional, business, and spiritual dimensions.<SEP>The process of self-improvement across intellectual, emotional, business, and spiritual dimensions.";
  <neo4j://graph.schema#entity_id> "Growth";
