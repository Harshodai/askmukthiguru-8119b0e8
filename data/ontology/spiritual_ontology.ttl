<urn:mukthiguru:Harmony%20and%20Equal%20Dignity> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#created_at> "1779675555"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#description> "Harmony and equal dignity is a desired state of peaceful coexistence and mutual respect.<SEP>Harmony and Equal Dignity is the desired state, which is sought instead of the current path of hate and violence.<SEP>Harmony and equal dignity are principles sought by individuals but often undermined by divisive actions and unaddressed biases.";
  <neo4j://graph.schema#truncate> "";
