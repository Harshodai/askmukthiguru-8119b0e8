<urn:mukthiguru:Inner%20State> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0ypG1mlekNY)<SEP>YouTube Video: KTlY-lHs_Ew (URL: https://www.youtube.com/watch?v=KTlY-lHs_Ew)<SEP>YouTube Video: nQpRoOOu5Yc (URL: https://www.youtube.com/watch?v=nQpRoOOu5Yc)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)";
