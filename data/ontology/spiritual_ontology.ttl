  <neo4j://graph.schema#entity_type> "artifact";
  <neo4j://graph.schema#file_path> "unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)";
  <neo4j://graph.schema#source_id> "chunk-3d37678eb5b88fae480d540fa2c225a5<SEP>chunk-6b79e6b00a623d29a4805b544a6d5b42<SEP>chunk-7e91eab8feb161b4474b1300f70608bf<SEP>chunk-8fee4dd509610d97c05752528a7b3d25<SEP>chunk-232217422a9d55b6c921649f7abed07d<SEP>chunk-7f215aec5e563fe08c9394af87e3712d<SEP>chunk-4003efce0728e0c0f59a1a3a79c95022<SEP>chunk-dd1dc8cc2e72a766ab8873bdc25d460b<SEP>chunk-083389ed1f29c477711959b950521642<SEP>chunk-bc58b79c3342230326d74cad5e78c4a8<SEP>chunk-5969bac7e4ebef9ea84bf92976a3cbfa<SEP>chunk-cdb7e2c2a992ab4d052399a789ce199f";
  <neo4j://graph.schema#created_at> "1779231230"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#description> """Namaskara Mudra is a yoga gesture, specifically a hand gesture, in which the palms are joined and held at the heart chakra. This sacred hand gesture is commonly used in meditation to hold sacred intentions, channel energy and intention, and enhance spiritual energy and focus.

Namaskara Mudra is also associated with various meditation practices, and in the Limitless Field Meditation, it is employed to channel divine energy. The gesture is sometimes described as a specific term mentioned in texts and is recognized as a generic hand gesture used in meditation.<SEP>A hand gesture (palms joined at the heart chakra) used in the meditation ritual.<SEP>A hand gesture (mudra) used in meditation or yoga, associated with receiving blessings.<SEP>A hand gesture (Namaskara) used during the mantra chanting to channel blessings.""";
  <neo4j://graph.schema#entity_id> "Namaskara Mudra";
  <neo4j://graph.schema#truncate> "" .

