<urn:mukthiguru:Suering%20States> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#created_at> "1779187997"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#entity_id> "Suering States";
  <neo4j://graph.schema#source_id> "chunk-a954f0d11042551baf073ae27fdc369d<SEP>chunk-f34d4c3475c783164c62af4dbf5b6c3c<SEP>chunk-781c976d80c30eb6312f854bab64a7ec<SEP>chunk-bed95c3be04f868de9c27e6537e903ca<SEP>chunk-a6edb23148812a00c784704ababdb3ee<SEP>chunk-c29e446278bb16bd97c026c06682add6<SEP>chunk-07bbbe415fc6ff4eb6e48c047d81efd5";
