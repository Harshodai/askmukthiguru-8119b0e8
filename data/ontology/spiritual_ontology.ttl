  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#description> """{\"Description\": \"{\\\"Description\\\": \\\"We need to produce a merged description for the entity \\\\\\\"Mother\\\\\\\". The description list includes multiple descriptions. The input format is a JSON object with a \\\\\\\"Description List\\\\\\\" key, and then each description is a JSON object on a new line? Actually, the input is:\"}
{\"Description\": \"The mother is a character in the narrative, depicted as experiencing depression and poverty after her son's death.\"}
{\"Description\": \"Mother is explicitly mentioned as part of the bonding experience between parents and the future child.\"}
{\"Description\": \"The mother is a parent who may become judgmental due to aggressive ambition, affecting her relationship with her child.\"}
{\"Description\": \"Mother imparts ideals that shape one's understanding of life's right and wrongs through teachings.\"}
{\"Description\": \"Mother imparts ideals that shape one's understanding of life's right and wrongs through teachings.\"}
{\"Description\": \"The mother of a five-year-old child uses an Earth Day message to teach her son about environmental consciousness and habit change.\"}
{\"Description\": \"The mother of a five-year-old child uses an Earth Day message to teach her son about environmental consciousness and habit change.\"}<SEP>Mother represents the biological or adoptive maternal figure who nurtures and sustains life through love, lullabies, and guidance.<SEP>Represents the nurturing and creative role of a mother, both biological and adoptive, in sustaining life and shaping a child's development.""";
  <neo4j://graph.schema#source_id> "chunk-41b3a29187ba0c1a38ac4f058b4fd20f<SEP>chunk-e7fcee974f06e1422c855e53a17a24ae<SEP>chunk-9924c7e219f96915a4ef19eba2cb5f62<SEP>chunk-533c11dca17ed148bc0fe09075977a5a<SEP>chunk-c85036006eb9517f84fbb3ee7717030e<SEP>chunk-b54ac9ad4f0146c0455d735ab73fde35<SEP>chunk-369f0db74a66636fddaa77ce9a54b9b6<SEP>chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa<SEP>chunk-0e5b03097ca1fd70284be6d33317832d<SEP>chunk-95ede5878070f28d1b63e5213e0a1f6e<SEP>chunk-85380b1903edbe83293a14871258c806<SEP>chunk-ded082abd496ba4dd1acaf011d64e44c<SEP>chunk-2628a53249868fff005017c0b9ca7f19<SEP>chunk-654ba1397813fb7e7e5aa81442780460<SEP>chunk-41a69529bb31744f3a07ba326cfab626<SEP>chunk-12c41632c244e5787f737f83514e30b2<SEP>chunk-519cd4a91883594546bbe5c947089bed<SEP>chunk-255bf350d451faa2df8677aa580dc07b<SEP>chunk-4da1e45ca993decf20ec10e31d56d36e<SEP>chunk-7988ea96a08eaf2fe8d7d16c8063ffbe<SEP>chunk-3d98a7ecb8a0eae8eb12c9d7525576d1<SEP>chunk-439f02067105223fb4f1c1b8d3263e52<SEP>chunk-b99209818242fa366169c6ab46e01f5f" .

