<urn:mukthiguru:Mask%20of%20Independence> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf";
  <neo4j://graph.schema#source_id> "chunk-0e0d8ce525e6e00265646821c7a82b74";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#created_at> "1779137626"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#description> "Mask of Independence represents Jaya's self-constructed identity as a self-made woman who outgrew the need for love, later recognized as a facade.";
  <neo4j://graph.schema#entity_id> "Mask of Independence" .

<urn:mukthiguru:Masks> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#created_at> "1779257852"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#source_id> "chunk-965f0460a260b37383e3134a787405f5<SEP>chunk-d720c7b9783846012decda752c188747<SEP>chunk-baa29517ede049854e2aecf133575342<SEP>chunk-e8c3861302e4fee45689e6fb65d84e48<SEP>chunk-e89be378630661d2c676d9886934ef21<SEP>chunk-80d013da8e30699bb74f5c6c773c8701<SEP>chunk-1c356513974368f71d2bdbafe2a1f92d";
  <neo4j://graph.schema#entity_id> "Masks";
  <neo4j://graph.schema#description> "Masks are used to conceal emotions, serving as a barrier between individuals and their true feelings.`<SEP>Masks are physical items used to conceal facial expressions and emotions.<SEP>Metaphorical use of masks to conceal emotions, discussed in the context of hiding pains, loneliness, and anxiety.<SEP>Masks symbolize the concealment of true emotions such as pain, loneliness, and anxiety, often worn by individuals to hide vulnerabilities even from close ones.<SEP>Protective masks used by healthcare workers, which can cause discomfort and fatigue.<SEP>Masks are protective equipment worn by healthcare workers, associated with physical strain and health risks during prolonged use.<SEP>Masks are protective equipment used by medical workers, sometimes causing discomfort or health issues.";
