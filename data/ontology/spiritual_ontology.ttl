<urn:mukthiguru:Breathing> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#file_path> "YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=JRlaAip4kmk)<SEP>unknown_source<SEP>YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)";
  <neo4j://graph.schema#entity_id> "Breathing";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#description> "A technique involving inhaling and exhaling focused on the heart, used in the meditation to facilitate peace.<SEP>Breathing is a biological act framed as a movement of existence, devoid of inherent meaning but essential to life.<SEP>Breathing is framed as a biological process tied to existence, with its meaning debated in the context of human experience.<SEP>Breathing is analyzed as a biological act devoid of intrinsic meaning.<SEP>Breathing is a physiological process framed as a movement of pure existence in the text.<SEP>A biological process interrogated for its intrinsic meaning within existential frameworks.";
  <neo4j://graph.schema#created_at> "1779402795"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#source_id> "chunk-7e21cbebb168cec17df5a464a689a4f9<SEP>chunk-ef821e71b2fbcaa55b79671c314f5fac<SEP>chunk-075b8e71a3c71d11c785be4bbfe965ed<SEP>chunk-cd11c060af63780157ebf40717dc0fe2<SEP>chunk-8ac203494cdcc9d8041ac912b2411f28<SEP>chunk-e94d81180e7457d6f36d99965cfbf34d<SEP>chunk-89ddb9ac19fba38ddebc97bcf3b40b3b<SEP>chunk-25679c68ddef27fd2e2fa60d50bdcb05" .

<urn:mukthiguru:Breathing%20Exercise> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#created_at> "1779734201"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#source_id> "chunk-78de7fe55b577c559d0a376641b24b1d<SEP>chunk-190acc93a27012825956522182c7d1a4";
  <neo4j://graph.schema#file_path> "YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=4ytgjpow498)";
  <neo4j://graph.schema#entity_id> "Breathing Exercise";
  <neo4j://graph.schema#description> "Breathing technique involving seven deep inhalations through the nose and slow exhalations through the mouth in awareness, with a noted error in the instruction text where 'seven times.UP Thank you.' should be 'seven times. Up, thank you.'<SEP>Breathing exercise involves slow inhalations and exhalations while counting breaths via thumb-fingertip touch, aimed at activating the parasympathetic nervous system and immune system.";
  <neo4j://graph.schema#entity_type> "method" .

