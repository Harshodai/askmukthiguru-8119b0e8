<urn:mukthiguru:Christina> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#created_at> "1779183960"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf<SEP>unknown_source";
  <neo4j://graph.schema#description> "Christina, a businesswoman and student, experienced emotional turmoil after a conflict with Lee, leading to humiliation and anger. Through self-reflection, she recognized her suffering stemmed from her own consciousness and inner state rather than external circumstances. Struggling to release anger, she confronted her ungratefulness and self-obsession. Her journey highlighted the challenge of achieving self-awareness and understanding inner truths.";
  <neo4j://graph.schema#source_id> "chunk-3315cd2e438010dca35a1192e534e125<SEP>chunk-ce43f1e704f39c7816ab3fb66ad9cae5<SEP>chunk-0e9d5c35a3513fef882cbbe59c504a44<SEP>chunk-56d3e9e42cb5f7a1ad78a7f63103bc6b<SEP>chunk-1444d9544f5a6ff9532dfcc5227c350f<SEP>chunk-54ab0057ebb9d14ac4c0eb525f843612<SEP>chunk-b66967ff647e15e2ccfdb242ffc22fb6<SEP>chunk-999192b96103e7c498639cfadd062722";
