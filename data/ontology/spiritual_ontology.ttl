<urn:mukthiguru:Crocodile> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)";
