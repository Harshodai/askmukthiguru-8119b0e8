  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#entity_id> "Desire";
  <neo4j://graph.schema#entity_type> "concept" .

<urn:mukthiguru:Desire%20and%20Reality> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#description> "Desire and reality are unified in the expanded state of consciousness.<SEP>Desire and reality are described as unified within the field of consciousness, emphasizing their interconnectedness in the practice.<SEP>Desire and Reality are treated as one in Soul Sync, reflecting the practice's focus on manifestation.";
  <neo4j://graph.schema#source_id> "chunk-7e21cbebb168cec17df5a464a689a4f9<SEP>chunk-e69d17b5a95c66d86550266e6f75a794<SEP>chunk-6e3b92943a430e127a61bead1ab61d60";
