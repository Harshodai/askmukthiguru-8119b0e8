<urn:mukthiguru:Kupastha%20Manduka> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#entity_id> "Kupastha Manduka";
  <neo4j://graph.schema#description> "Kupastha manduka (frog in a well) symbolizes limited perspective and rejection of broader truths.<SEP>Kupastha manduka is a metaphor for narrow-mindedness, symbolizing the limitations of rigid thinking.";
