<urn:mukthiguru:Mask> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#description> "The Mask symbolizes Jaya's facade of invincibility and emotional detachment, concealing her true vulnerability.<SEP>A metaphorical mask symbolizing self-deception or denial, which is removed to reveal truth and enable self-awareness.<SEP>Mask symbolizes a metaphorical barrier to truth, described as being \"peeled back\" to reveal clarity after 38 years.<SEP>Mask symbolizes a metaphorical barrier to truth, described as being \"peeled back\" to reveal clarity after 38 years.<SEP>Mask symbolizes a metaphorical barrier to truth, described as being \"peeled back\" to reveal clarity after 38 years.";
  <neo4j://graph.schema#source_id> "chunk-da0dcd44b642ae88bb5ae6bfa953a323<SEP>chunk-97418c51f26c4090e6f6b986b0a848a6<SEP>chunk-eff8e4dcfe33dc3f019672706583990a";
  <neo4j://graph.schema#created_at> "1779524397"^^<http://www.w3.org/2001/XMLSchema#long>;
