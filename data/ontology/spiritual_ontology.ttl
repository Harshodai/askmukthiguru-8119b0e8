  <neo4j://graph.schema#file_path> "unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Z7w7soyXmHs)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=77dJnbTCwsA)";
  <neo4j://graph.schema#source_id> "chunk-349671a87ed47c9a9189c9696547ad85<SEP>chunk-5f1cf5c3d2e4cdae3ebef826fa7dcf7a<SEP>chunk-4ec92fe5b5aa3e573ed7fbd2638fb992<SEP>chunk-8c06aa92798569e877a278c137422317<SEP>chunk-e22181d45ff680a216a2e1e3bb46c19d<SEP>chunk-9d8a8416ae7a083477cbb7ac15043bbb";
