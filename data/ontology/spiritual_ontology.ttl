<urn:mukthiguru:Parasympathetic%20Nervous%20System> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#file_path> "unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=4ytgjpow498)";
  <neo4j://graph.schema#created_at> "1779734201"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#source_id> "chunk-2984b976f037a27596b29e94de8e3b21<SEP>chunk-b694dcc1bb7e7bd6fa7878c3592e7c19<SEP>chunk-4bca5a7f563e294879e45b9c3fe1993e<SEP>chunk-91b2aa787cfc2f8f82f250a6e1012946<SEP>chunk-436cdd40c65f094c48fcf797f8be28ab<SEP>chunk-671c6ddc6c8ba583342b564958bff7bd<SEP>chunk-20e8a5aac153987a81136025a2c382fd<SEP>chunk-45a029373e612fccf7c03c14e620d14c<SEP>chunk-190acc93a27012825956522182c7d1a4";
  <neo4j://graph.schema#entity_id> "Parasympathetic Nervous System";
  <neo4j://graph.schema#description> "The parasympathetic nervous system is a component of the autonomic nervous system that, when shut off by stress, leads to the destruction of other systems.<SEP>The parasympathetic nervous system regulates bodily functions at rest, including digestion and recovery, and is shut off during stress responses.<SEP>The parasympathetic nervous system is a biological system that regulates bodily functions and is affected by stress, leading to shutdown and health issues.<SEP>The parasympathetic nervous system is shut off during stress, redirecting energy to the limbs for rapid response.<SEP>The parasympathetic nervous system regulates bodily functions at rest and is involved in recovery; its shutdown due to stress leads to health deterioration.<SEP>The parasympathetic nervous system regulates bodily functions associated with rest and calm, which is suppressed during prolonged stress states.<SEP>The parasympathetic nervous system regulates bodily functions to promote relaxation and is central to activating the immune system for survival in infection-filled environments.";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#entity_type> "concept" .

<urn:mukthiguru:Parent> a <neo4j://graph.schema#base>;
