<urn:mukthiguru:Death> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#file_path> "unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)<SEP>YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)";
