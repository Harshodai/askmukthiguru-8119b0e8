<urn:mukthiguru:Uncharted%20Consciousness> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#created_at> "1779735063"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#file_path> "YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)";
  <neo4j://graph.schema#description> "Uncharted Consciousness is explored by meditators without guidance.<SEP>Uncharted consciousness represents unexplored aspects of the mind or self-awareness that meditators may explore, often requiring guidance.<SEP>Uncharted consciousness refers to unexplored aspects of the mind or awareness that a seasoned meditator might explore autonomously.<SEP>Uncharted Consciousness refers to the unexplored aspects of the mind that practitioners explore during meditation, either independently or through guided methods.";
  <neo4j://graph.schema#entity_id> "Uncharted Consciousness";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#source_id> "chunk-9dc502f9eccca1fa3646d12dc84a20b5<SEP>chunk-619f3a9b9f1a9a2f69d32ef07fbabf7c<SEP>chunk-ea2c880e0817109d2e1724af65951447<SEP>chunk-b750056201bfac82be4d5952fd13e6ae";
