  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#entity_id> "Stress Chemicals";
  <neo4j://graph.schema#description> "Chemicals released during stress that disrupt bodily functions, communication, and contribute to disease or ill health.<SEP>Chemicals released by the body during stress that can disrupt normal cellular function and communication." .

<urn:mukthiguru:Stress%20Posture> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#file_path> "unknown_source<SEP>YouTube Video: stUPu1-W4bE (URL: https://www.youtube.com/watch?v=stUPu1-W4bE)";
  <neo4j://graph.schema#source_id> "chunk-1140e04073ac9a83dfcd95f7292712fc<SEP>chunk-4a8a747b20d8cc64be6f0587f83f75f8<SEP>chunk-837bb3388ec47b611e5d50b7a992682e<SEP>chunk-0adee7c41f1cb41998ac9e8e2dce0473<SEP>chunk-1a14104939cf6c7cde138464e4bad5e7<SEP>chunk-4b883b28acf7bcbe78afff1c0303d457";
  <neo4j://graph.schema#entity_id> "Stress Posture";
  <neo4j://graph.schema#created_at> "1779409739"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#description> "Stress posture is a state of mental and physical tension that meditation helps alleviate.<SEP>Stress posture is an unconventional term used in the text to describe meditation's role in stress management.<SEP>Stress posture refers to the body's response to stress, mitigated through meditation.<SEP>Stress posture refers to the body's physical and mental response to stress, managed through meditation.><SEP>Stress posture refers to the body's response to stress, which meditation is described as being a great example of.<SEP>Stress posture refers to a method of managing stress through meditation, often integrated into therapeutic practices.";
  <neo4j://graph.schema#entity_type> "concept" .

<urn:mukthiguru:Stress%20and%20Anxiety> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_type> "concept";
