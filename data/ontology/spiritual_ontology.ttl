  <neo4j://graph.schema#created_at> "1779186988"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#description> "A giant lion carcass created by the third fellow after adding flesh and meat to the skeleton.<SEP>Lion carcass is a giant animal carcass formed by the third fellow by adding flesh and meat to the skeleton.<SEP>A lifeless lion carcass created by the third friend in the fable, representing escalating emotional states.`" .

<urn:mukthiguru:Lion%20Cub> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_id> "Lion Cub";
  <neo4j://graph.schema#description> "A lion cub raised by sheep, struggling to fit in due to his true nature.<SEP>A lion cub raised among sheep, struggling with identity and incapable of emulating sheep behavior.<SEP>The lion cub is a young lion who initially identifies with sheep due to parental influence but later realizes his inherent power through self-reflection.<SEP>The lion cub grew up among sheep, believing he was one, and struggled to emulate their behavior.<SEP>A lion cub raised by sheep, struggling with identity conflict and societal expectations due to his upbringing among animals.`";
  <neo4j://graph.schema#entity_type> "creature";
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf<SEP>unknown_source";
  <neo4j://graph.schema#created_at> "1779183742"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#source_id> "chunk-3f368851bf5ddb2f8eff6b6b68ee073b<SEP>chunk-fe2967cbd738ae1882767972220f2846<SEP>chunk-345cde2de9df7f9434b23cd5a304db8f<SEP>chunk-d4fb27ed500b1a960390eadd6d011176<SEP>chunk-6b077b95a5e468c5e42f57a37944c07d" .

