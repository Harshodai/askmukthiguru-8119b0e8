<urn:mukthiguru:Desperation> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#created_at> "1779665557"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#description> "Desperation is an emotional state experienced by Clark, contributing to his self-preoccupation and emotional distance from Doris.<SEP>Desperation is associated with separation and hinders manifestation of desires.<SEP>Desperation is a state of suffering linked to separation and ineffective actions, contrasted with connection in achieving goals.<SEP>Desperation is a concept that Clark experiences.<SEP>Desperation is a state of extreme distress and hopelessness, which can influence the search for a soulmate.<SEP>Desperation is a state of extreme distress and hopelessness, which can influence the search for a soulmate.<SEP>Desperation is a state of neediness that is absent when the heart is awake.";
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf<SEP>unknown_source";
  <neo4j://graph.schema#source_id> "chunk-72503a4964a57bca77130ca63af646a4<SEP>chunk-b4387a01e271d1d16068a0288faa84e5<SEP>chunk-46f092e49beb29848499bc5cec4e1faf<SEP>chunk-23a9d70ceb9180c4dd396af6970d0186<SEP>chunk-7796e9953e60bd3bb11c46251f992983<SEP>chunk-40152a1fb18e76edc2c33e41cc81ed43";
  <neo4j://graph.schema#entity_id> "Desperation" .

