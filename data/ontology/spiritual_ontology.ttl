  <neo4j://graph.schema#created_at> "1779141770"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#description> "Enduring love represents a sustained relationship built on conscious connection rather than fleeting attraction.<SEP>Enduring love signifies a relationship transcending superficial attraction, rooted in sustained connection and mutual transformation.<SEP>A lasting, meaningful connection that is undermined by unresolved pain and avoidance of emotional work.<SEP>Enduring love is portrayed as a desired state of connection contrasting with transient relationships.<SEP>State achieved through transforming consciousness from self-obsession to connection.";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#source_id> "chunk-a813939f321629f8537b01c0cc6653ae<SEP>chunk-b96d370a14bedf82917d4f135e00825e<SEP>chunk-d52f636ec1e248fba87af843ffd93511<SEP>chunk-bb336118db8922490b3e05a79c11dba1<SEP>chunk-4ca9aac0c54b5272b268630d1b3e68f9" .

