  <neo4j://graph.schema#entity_id> "Destructive Self" .

<urn:mukthiguru:Destructive%20States> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_id> "Destructive States";
  <neo4j://graph.schema#created_at> "1779407887"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#description> "Mental or emotional conditions (e.g., lack, fear) that hinder manifestation of goals and dreams.<SEP>Destructive states like discontent, anger, and desire to control are linked to I-consciousness and arise from self-engrossment.<SEP>Destructive states of being including discontent, anger, hate, fear, pain, and desire to control/dominate, associated with I-consciousness.<SEP>Mental or emotional states (e.g., anxiety, disconnection) that hinder goal manifestation and abundance creation.<SEP>Negative mental or emotional states hindering manifestation of goals.<SEP>Negative mental or emotional patterns that hinder personal growth and manifestation of goals.";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#source_id> "chunk-45384d6e9118a3a6dd41204b27b84334<SEP>chunk-35e48385a0a3608b5da5a16afae83eaa<SEP>chunk-c6d1ac7b77c644cdbe0e473d070e10a0<SEP>chunk-bb6c9ed766984ed67a3284de5a2b4231<SEP>chunk-e8122b558719002ee0dce799548c0a97<SEP>chunk-ab021105bc7fcb29c05b5af446cd2565";
  <neo4j://graph.schema#entity_type> "concept";
