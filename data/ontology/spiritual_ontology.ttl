<urn:mukthiguru:Oneness%20State> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#created_at> "1779648142"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#file_path> "YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)";
  <neo4j://graph.schema#description> "Oneness State is the condition where an individual becomes beautiful, extending to family, society, and the world.<SEP>Oneness state is a unified awareness that transforms relationships into love, connection, and compassion, fostering joy and gratitude.<SEP>The Oneness State represents a unified existence characterized by love, connection, and compassion, transforming relationships and fostering joy.<SEP>Oneness State refers to the concept of ultimate unity or singularity, mentioned in the context of a state within the text.<SEP>Oneness State refers to the concept of ultimate unity or singularity, mentioned in the context of a state within the text.<SEP>Oneness State refers to a spiritual condition where divisions and judgments cease, fostering unity with oneself, others, and the world.<SEP>The Oneness State is described as a spiritual condition where divisions, judgments, and disappointments cease to exist, enabling healing of Mother Earth.";
  <neo4j://graph.schema#source_id> "chunk-5750a413a72601ce81e6195a148e09ad<SEP>chunk-acd33e9d80650cd874ca18c3457f81a6<SEP>chunk-1a41bff298d480e5ee5d61353c7e062c<SEP>chunk-b64e03d5159fd3c4e333e9641ee8fb81<SEP>chunk-60c1c33e6390faeb5d8d230c828095d7<SEP>chunk-829692316cdc441972a3bef1cc6809ef";
  <neo4j://graph.schema#entity_id> "Oneness State";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#truncate> "" .

