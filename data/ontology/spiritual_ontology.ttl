<urn:mukthiguru:Inner%20Peace> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#description> "Inner Peace is a state of mental calmness and harmony that can be achieved through meditation practices. It is also described as a state achieved through a program, characterized as a “deep inner calm.” This condition naturally generates human responsibility, kindness, and ethical action without reliance on external moral frameworks. It is regarded as the desired outcome of meditation and is a longed-for experience of tranquility. Additionally, Inner Peace represents a profound sense of harmony and contentment that develops during the journey toward achieving this state.<SEP>Inner peace is a state achieved through the program, described as a \"deep inner calm.\"<SEP>Inner peace is a state achieved through the program, described as a \"deep inner calm.\"";
  <neo4j://graph.schema#source_id> "chunk-30c84c53b6b4f178532cf06dec726c9f<SEP>chunk-cb2b247e069cff8e39d34db433289983<SEP>chunk-b66dbb231f9e1be7773d5bb448709c92<SEP>chunk-837bb3388ec47b611e5d50b7a992682e<SEP>chunk-0adee7c41f1cb41998ac9e8e2dce0473<SEP>chunk-1a14104939cf6c7cde138464e4bad5e7<SEP>chunk-a10d491711164b21994f76ff0fb53caa<SEP>chunk-79727c38a2ca8d63adfca02ee83cd218<SEP>chunk-d3d330d042772c704e2fd89e4454d795";
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: stUPu1-W4bE (URL: https://www.youtube.com/watch?v=stUPu1-W4bE)<SEP>YouTube Video: Qu5IQo0ghbs (URL: https://www.youtube.com/watch?v=Qu5IQo0ghbs)";
  <neo4j://graph.schema#created_at> "1779518079"^^<http://www.w3.org/2001/XMLSchema#long>;
