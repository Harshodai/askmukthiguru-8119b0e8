  <neo4j://graph.schema#description> "The suffering state of being describes the Wounded Child's persistent psychological distress rooted in past trauma and unprocessed pain.";
  <neo4j://graph.schema#created_at> "1779137527"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#entity_id> "Suffering State of Being";
