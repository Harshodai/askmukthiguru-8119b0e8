<urn:mukthiguru:Focus%20Areas> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#source_id> "chunk-d897f0191cd7cbe0dffe03183095b5c3<SEP>chunk-6239363e43b90d034be5850e9ec19b9d<SEP>chunk-7fd8596e77267f333f42ebc055048d2e";
