  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#description> "Gudi Bhadva is a domain-specific term that was misheard and needs correction.<SEP>Gudi Bhadva is a domain-specific term that was misheard as \"Gudi Padma\".<SEP>Gudi Bhadva is a festival observed in some regions, symbolizing the renewal of life and acceptance of all experiences.<SEP>Gudi Bhadva is a festival celebrated in parts of India, traditionally marking the New Year with cultural and religious observances.<SEP>Gudi Bhadva is a term used in the context of a cultural or religious celebration, previously referred to as \"Gudi Padma\" but corrected for consistency.";
  <neo4j://graph.schema#source_id> "chunk-a96284309a8df2d35afbd3fdb0e45ad7<SEP>chunk-12bed1be4bf6242f57b4ecc660b06100<SEP>chunk-27a4dfd2bd2512da5799c450f509330b<SEP>chunk-52ad42f8f8d7bf6cdf3a96f95c014a7c<SEP>chunk-5c9875e9473ebfe7d72af1ccccd742de";
  <neo4j://graph.schema#entity_id> "Gudi Bhadva" .

