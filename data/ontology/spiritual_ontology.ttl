<urn:mukthiguru:enlightenment> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#file_path> "YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=KTe11DlB4QI)<SEP>YouTube Video: LYm7oczfWEk (URL: https://www.youtube.com/watch?v=LYm7oczfWEk)<SEP>unknown_source<SEP>YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)";
