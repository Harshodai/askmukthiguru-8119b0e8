  <neo4j://graph.schema#entity_id> "Father Figures" .

<urn:mukthiguru:Father's%20Day> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#source_id> "chunk-b996638425e80c3edd726b4647655b80<SEP>chunk-db4a0e7f56cb73058e9f9de5ef38915f<SEP>chunk-0bdbf1797b9374df3923aee96614874c<SEP>chunk-accdc31e9607c3940aed49cc5de73ff1<SEP>chunk-dc87b4124e027c8ceb12ac0f766b4f97<SEP>chunk-213b380b49b8d8407371ccc03fea59a4<SEP>chunk-a1980aa574f493c3c88959244cbe1135<SEP>chunk-0299e47f1b152a3bbc2dfc3315ac114a<SEP>chunk-a0d6a357e4a9a2e2dd0c278e4793f48a<SEP>chunk-ed9bd777897b8b08ed12f0776796982a<SEP>chunk-c1b8715ddbbe0589011d5273af6804ce<SEP>chunk-c93698531b3dac1e84db04c1babfa638<SEP>chunk-2356c92f9a3ba0c0acd302b505ca62a8";
