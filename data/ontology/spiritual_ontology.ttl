<urn:mukthiguru:Author> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_type> "person";
  <neo4j://graph.schema#source_id> "chunk-4460c53283867cf0e7a6a331fc3daa9a<SEP>chunk-2b4fda69309d99ad3cadc792e81ed13a<SEP>chunk-bfc9ac02b4b45204e93a15d51a959bb6<SEP>chunk-533c11dca17ed148bc0fe09075977a5a<SEP>chunk-ffbd16a80a3f36425c182278e7bb273d<SEP>chunk-609eba9953b128ee5842ae83faafcdb9<SEP>chunk-8747b8559b6ab050bd73313beb85bb44";
