<urn:mukthiguru:Circulatory%20System> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_id> "Circulatory System";
  <neo4j://graph.schema#description> "The circulatory system is one of the body systems destroyed by stress.<SEP>The circulatory system is part of the human body responsible for transporting blood and is damaged when the parasympathetic nervous system shuts off.<SEP>The circulatory system is affected by stress, leading to health deterioration.";
  <neo4j://graph.schema#source_id> "chunk-4bca5a7f563e294879e45b9c3fe1993e<SEP>chunk-436cdd40c65f094c48fcf797f8be28ab<SEP>chunk-20e8a5aac153987a81136025a2c382fd";
  <neo4j://graph.schema#file_path> "unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#created_at> "1779217200"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#entity_type> "concept" .

<urn:mukthiguru:Circumference> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#description> "Circumference metaphorically represents an individual's social and emotional boundaries, which influence connection with the universe.<SEP>Circumference is the original term that was corrected to Consciousness.<SEP>Original term in the text later replaced by \"consciousness\" to better convey the intended meaning.<SEP>Original term in the text later replaced by \"consciousness\" to better convey the intended meaning.";
  <neo4j://graph.schema#source_id> "chunk-ffdd34b0438c947d32b8b2d304f135c4<SEP>chunk-5df138751f09bcc9c4d02f158a5b7e22<SEP>chunk-c95a104d9da85092c5bc85a30cbd4162<SEP>chunk-237a65ae546a2543e175242df87d7879";
  <neo4j://graph.schema#file_path> "YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)<SEP>YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)";
  <neo4j://graph.schema#created_at> "1779656973"^^<http://www.w3.org/2001/XMLSchema#long>;
