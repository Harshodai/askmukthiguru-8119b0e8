<urn:mukthiguru:Career> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=_XDcXdBDZ0c)<SEP>unknown_source<SEP>YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)";
  <neo4j://graph.schema#created_at> "1779562135"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#description> "Represents professional pursuits and job-related activities prioritized by modern society over personal well-being.<SEP>Career is framed as a domain shaped by either stressful states or inspired states, impacting professional outcomes and organizational culture.<SEP>Career is a concept that becomes sacred when perceived as irreplaceable, leading to fulfillment.<SEP>Professional dissatisfaction linked to self-conflict.<SEP>Career represents professional life and goals, influenced by one's state of being and decision-making.<SEP>Career is presented as a common but limited perception of purpose, often associated with professional life.<SEP>Career is a domain where individuals project insecurities, often fueled by comparison or anger.";
  <neo4j://graph.schema#source_id> "chunk-f16606148225c6dd5acaeaaa44fa569d<SEP>chunk-e897fef731236d55e77f48600e6eadf5<SEP>chunk-2d3e2b583a33b1dd3f28054d2d3f1c75<SEP>chunk-035b6c44730bb7cdf05bfef04ef27b03<SEP>chunk-b46675c05bfa30223c5b090123b0a08b<SEP>chunk-98b12bb1e69b9ff2ff208afa4abc7737<SEP>chunk-e28a16af170670aaf61d68da07b71294";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#entity_id> "Career";
  <neo4j://graph.schema#truncate> "" .

