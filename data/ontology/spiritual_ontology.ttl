  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#entity_type> "method";
  <neo4j://graph.schema#description> "Bikes for short distance commuting are suggested as an eco-friendly alternative inspired by Dutch practices.";
  <neo4j://graph.schema#file_path> "YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)" .

