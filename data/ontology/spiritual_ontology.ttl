  <neo4j://graph.schema#entity_id> "Monkey";
  <neo4j://graph.schema#description> "A monkey attempts to retrieve a dessert from a tree hollow but becomes trapped, leading to relocation by monkey catchers.<SEP>The monkey is part of a parable in the discourse, symbolizing clinging to anger.<SEP>The monkey is a mischievous creature that gets trapped in a tree hole while attempting to steal desserts, leading to its capture.<SEP>A metaphor used to illustrate the lack of freedom when holding onto anger, similar to a monkey clinging to dessert.<SEP>A metaphor for clinging to anger, symbolizing lack of freedom and self-awareness.<SEP>A metaphor for clinging to anger, symbolizing lack of freedom and self-awareness.";
  <neo4j://graph.schema#source_id> "chunk-2be9c30d5eb8cae8ce6cd1e6425921bc<SEP>chunk-61865db1533922fc67b59d104261e28a<SEP>chunk-7bf65c644663a49c4d568dfba9827fc5<SEP>chunk-339fa6ee789d0451cedd5e2548222d96<SEP>chunk-f11387cad436a638d2f57c99446730e6" .

