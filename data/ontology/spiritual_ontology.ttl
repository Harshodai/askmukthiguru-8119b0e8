  <neo4j://graph.schema#created_at> "1779136140"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#description> "Creative solutions emerge from the Beautiful State, enabling innovative problem-solving despite major obstacles.<SEP>Creative Solutions are innovative approaches to overcoming challenges, enabled by the beautiful state of mind.";
  <neo4j://graph.schema#entity_type> "concept" .

<urn:mukthiguru:Creativity> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_id> "Creativity";
  <neo4j://graph.schema#created_at> "1779675473"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#description> "In a beautiful state, creativity and solutions to challenges emerge effortlessly.<SEP>Creativity is a mental ability that decreases under stress, limiting one's ability to respond to life's problems.<SEP>Creativity is hindered by self-criticism, preventing engagement with one's work.<SEP>Creativity is a concept mentioned as a potential outcome of the period of seclusion.<SEP>Creativity is the ability to generate novel ideas, hindered by environments where disrespect prevails.<SEP>Creativity arises from the emergence of new perceptions, worldviews, or life perspectives, enabling transformative outcomes.";
  <neo4j://graph.schema#file_path> "unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)<SEP>YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hqre34QIMZg)";
  <neo4j://graph.schema#source_id> "chunk-bd28b1a048122e44541304a8505b07db<SEP>chunk-20e8a5aac153987a81136025a2c382fd<SEP>chunk-f02b83f12f802c289fd8c9176c6dc8a9<SEP>chunk-550e13cc834f4b3fe1d51617d1c42fa2<SEP>chunk-a9c35b7e3af59116caff7410890807ed<SEP>chunk-10a63ebc48cb5367889fe83878ad4257<SEP>chunk-811f7f6fb4de9a85b774d5d90a726b13";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#entity_type> "concept" .

<urn:mukthiguru:Creature> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#created_at> "1779659276"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#file_path> "YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)<SEP>unknown_source<SEP>YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)";
  <neo4j://graph.schema#source_id> "chunk-9ce1c80b4cf41412d36baabed73cd0a7<SEP>chunk-04d56d56ff3befc2a05ebcfab17f9d42<SEP>chunk-e5bc7202d0a09227aeb490c17e163a8e<SEP>chunk-c70b663ec8c2f1951db8e07e51d5edd1<SEP>chunk-b0aa1897202602a9be2a7516d39d5400";
  <neo4j://graph.schema#description> "A general reference to creatures that contradict the frog's views, categorized as liars or enemies.<SEP>The word \"creature\" in the text is identified as a Creature entity, though its context suggests it may be an error for \"person\" or \"being\".<SEP>Creature refers to all living beings in the universe that consume food, ranging from single-celled organisms to humans.<SEP>Creature symbolizes living beings in a metaphorical context, highlighting the paradox of humans exploiting other life forms.<SEP>Creature symbolizes the existential paradox of becoming the entity one seeks to destroy, leading to awakened perception and renewal.";
  <neo4j://graph.schema#entity_id> "Creature";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#truncate> "" .

