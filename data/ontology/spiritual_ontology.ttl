<urn:mukthiguru:Prompt> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#source_id> "chunk-be9c73e40b66848f42c3e9def2b9ea2d<SEP>chunk-6c1f9ed93ca42208292e5ffaa0d749cb<SEP>chunk-563787893bdbb9cf92c048fe35fdfa81";
  <neo4j://graph.schema#file_path> "YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=_XDcXdBDZ0c)<SEP>YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)<SEP>YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)";
  <neo4j://graph.schema#entity_type> "method";
  <neo4j://graph.schema#entity_id> "Prompt";
  <neo4j://graph.schema#description> "Instructions specifying \"DO NOT rewrite the style\" and \"ONLY fix errors,\" governing the text correction process and emphasizing error correction over stylistic changes.<SEP>The prompt \"What happened to us? How have we become so disconnected? Why do we resist finding a little room to breathe?\" is a Concept entity.<SEP>Prompt instructing to correct text by outputting only the corrected text without conversational filler.";
  <neo4j://graph.schema#created_at> "1779663214"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#truncate> "" .

<urn:mukthiguru:Prompt%20Constraints> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#file_path> "YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)<SEP>YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#created_at> "1779663371"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#description> "The prompt specifies that the original meaning should not be retained absolutely, allowing for corrections to prioritize the author's intended meaning over the garbled text.<SEP>Prompt constraints specify rules for correcting transcriptions, including strict adherence to original meaning, avoiding rewrites, and focusing on homophones, domain terms, and punctuation.<SEP>Constraints from the prompt including adherence to formatting rules, output language requirements, and handling of errors.";
  <neo4j://graph.schema#source_id> "chunk-1439496c0597ca312586a923b138c34d<SEP>chunk-a86eca0b1f90f6c49a60c38f2bf9272a<SEP>chunk-3dcdd5d3569257cdff1dae6995bf7c96";
