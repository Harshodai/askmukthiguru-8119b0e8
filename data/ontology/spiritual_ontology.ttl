<urn:mukthiguru:Suffering%20State%20of%20mind> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_id> "Suffering State of mind";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#description> "The Suffering State of mind represents a negative inner experience marked by stress, anxiety, or unhappiness.";
