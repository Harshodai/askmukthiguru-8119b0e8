<urn:mukthiguru:Discontent> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#file_path> "unknown_source<SEP>YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=E8N04l1Lptk)";
  <neo4j://graph.schema#created_at> "1779701303"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#source_id> "chunk-b8797891f91bec3ca8041425168acbf1<SEP>chunk-075b8e71a3c71d11c785be4bbfe965ed<SEP>chunk-06a765717ff85133b42ac4f705cd51ca<SEP>chunk-6d3db9b5b3712ac82139a300382b6181<SEP>chunk-20d55a95f1cbc94a40998bcd62b8a62f<SEP>chunk-c476acad7c48665109459e4ea38e58d0<SEP>chunk-421a4c58520d1e933d3bc17c203cc893";
