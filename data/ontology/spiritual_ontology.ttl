<urn:mukthiguru:Limited%20Self> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#created_at> "1779662710"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#source_id> "chunk-70c6bbdb11e53c9f8f6f300d287b2520<SEP>chunk-676c070f41c08ddde395290878529cf3<SEP>chunk-9f245e3153d92a2c38134afd812338bf<SEP>chunk-8570f0aea49283824eb9980842a005e9<SEP>chunk-c9bb5b4ae7e13a7674f385925b990906";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#description> "The Limited Self represents ego-bound perceptions that dissolve through expanded consciousness.<SEP>The limited self represents an illusion of separateness and inadequacy that fuels inner conflict and external dissatisfaction.<SEP>The ego-bound identity that enlightenment experiences transcend to reach universal consciousness.<SEP>The ego-identified identity confined to physical form and transient experiences.<SEP>The limited self refers to the egoic identity tied to the body, memories, and identities, which is transcended in higher consciousness.";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#entity_id> "Limited Self";
  <neo4j://graph.schema#file_path> "YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=7Pfat_DztMI)<SEP>unknown_source<SEP>YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)<SEP>YouTube Video: vch9C_hNjGs (URL: https://www.youtube.com/watch?v=vch9C_hNjGs)" .

