<urn:mukthiguru:Inward%20Journey> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_id> "Inward Journey";
  <neo4j://graph.schema#description> "The process of self-exploration and introspection, described as magical and transformative.><SEP>The inward journey symbolizes self-discovery and overcoming external dependencies for true fulfillment.<SEP>Inward journey is described as the path to overcoming addiction and achieving enlightenment through self-awareness.<SEP>The inward journey symbolizes self-discovery and overcoming external dependencies for true fulfillment.<SEP>Inward journey is described as the path to overcoming addiction and achieving enlightenment through self-awareness.<SEP>The metaphorical cure for his addiction, involving self-reflection and personal growth.<SEP>Inward journey refers to self-reflection leading to spiritual growth and decision-making.";
  <neo4j://graph.schema#source_id> "chunk-bebed8e390bd16e43f908369216b9343<SEP>chunk-0443cca2d76c87663467e3610969c2ba<SEP>chunk-5c1ed637dca2d0d131d85c8ff4dd33cb<SEP>chunk-98e0115fe065f5dab78321b7c772863d<SEP>chunk-419f2bb193b6ad2621108753e0e6993e";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#file_path> "YouTube Video: PnvNqgTyIFI (URL: https://www.youtube.com/watch?v=PnvNqgTyIFI)<SEP>unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#created_at> "1779655488"^^<http://www.w3.org/2001/XMLSchema#long> .

