  <neo4j://graph.schema#entity_id> "Ugadi Pachadi";
  <neo4j://graph.schema#description> "Ugadi Pachadi is a traditional dish consumed during Ugadi, symbolizing life's diverse experiences.<SEP>Ugadi Pachadi (Bevubella) is a traditional dish prepared during Ugadi, containing a mix of flavors representing life's experiences.<SEP>Ugadi Pachadi is a dish made of various ingredients, symbolizing the different tastes of life." .

<urn:mukthiguru:Ugadi%20Pachadi%20(Bevu%20Bella)> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_type> "artifact";
  <neo4j://graph.schema#created_at> "1779519080"^^<http://www.w3.org/2001/XMLSchema#long>;
