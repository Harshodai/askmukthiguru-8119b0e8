<urn:mukthiguru:Conscious%20Wealth%20Creator> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#entity_id> "Conscious Wealth Creator";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#source_id> "chunk-a265b1960381a51edc693638b99c32b5<SEP>chunk-1131fb555cf5cb5c110e8720fad1eacd<SEP>chunk-935058526f2844e4cf8a154aae8963aa<SEP>chunk-bb6c9ed766984ed67a3284de5a2b4231<SEP>chunk-ab021105bc7fcb29c05b5af446cd2565<SEP>chunk-87c7719422a9d8333cc199f60bc9b163<SEP>chunk-c89b8cdd64ac1b6adbb6cecedd0bf3f0";
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: qJxGtSDiayM (URL: https://www.youtube.com/watch?v=qJxGtSDiayM)<SEP>YouTube Video: 7lggUuJtZXY (URL: https://www.youtube.com/watch?v=7lggUuJtZXY)";
  <neo4j://graph.schema#created_at> "1779418315"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#description> """Conscious Wealth Creator is a state of being characterized by awareness of one's motivations, purpose, and the impact of wealth creation on the surrounding ecosystem. It involves creating abundance and positive impact through conscious choices, meaningful and joyful work aligned with higher consciousness, and emphasizes connection, purpose, and ecosystem impact over traditional wealth accumulation.

The approach to financial success is guided by mindfulness and intentionality, reflecting an elevated state of being where wealth creation is effortless and aligned with consciousness. This state operates from a place of expansion, passion, and creation, enabling effortless wealth creation and societal impact.""" .

<urn:mukthiguru:Conscious%20Wealth%20Creators> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#entity_id> "Conscious Wealth Creators";
  <neo4j://graph.schema#description> "A group targeted by O&O Academy's courses for integrating consciousness into wealth-building practices.<SEP>Conscious wealth creators are individuals who harmonize spiritual awareness with material prosperity to benefit society.<SEP>Conscious wealth creators pursue success through connection, purpose, and positive impact rather than disconnection and anxiety.<SEP>Conscious wealth creators pursue wealth and success from connection rather than disconnection, focusing on purpose and ecosystem impact.<SEP>Individuals who pursue wealth and success through connection, purpose, and ecosystem impact as discussed in the video.";
  <neo4j://graph.schema#created_at> "1779408029"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#file_path> "unknown_source<SEP>YouTube Video: qJxGtSDiayM (URL: https://www.youtube.com/watch?v=qJxGtSDiayM)";
  <neo4j://graph.schema#source_id> "chunk-d83a359a3b08bc2ee4dd9304ff1558fc<SEP>chunk-50804a0cd2fabf8122814121f088fb8d<SEP>chunk-006aa99cab24a3e6956661a971e44e52<SEP>chunk-5df4284d1aa76cb89d7850ba8ee300b9<SEP>chunk-f3b8314c49f1c4cc362d4a1e403ac6d8";
