<urn:mukthiguru:Disconnected%20Person> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#source_id> "chunk-e53aa20908f0e3dc300b2226e52897f3<SEP>chunk-e27c90d3f030c932363441c1ed78bf62";
