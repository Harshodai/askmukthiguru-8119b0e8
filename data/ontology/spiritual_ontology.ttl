  <neo4j://graph.schema#entity_type> "concept" .

<urn:mukthiguru:Spiritual%20Right%20Action> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#created_at> "1779655593"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#description> "Spiritual Right Action is a principle discussed as a way to transform oneself and impact the web of life. It is defined as acting from innate care and spontaneity rather than rigid formulas or external rules, and it emphasizes present awareness and connection. The principle involves performing actions from a beautiful state, considering one's and others' well-being, and aligning decisions and behaviors with universal consciousness. It is not a step-by-step methodology but a principle that dissolves inner conflict and self-obsession, avoiding self-sacrifice or ideal-driven actions. In a specific context, Spiritual Right Action is described as the fourth sacred secret, guiding the CEO to act from connection and universal vision. It also appears as a path beginning with Serene Mind to achieve clarity and insight, and as a way to achieve ethical behavior emerging from connection.<SEP>Spiritual right action refers to making decisions aligned with ethical principles and universal trust.<SEP>Spiritual right action is a set of principles for making decisions aligned with a higher state of consciousness, leading to positive outcomes.<SEP>Spiritual right action is a principle emphasizing dissolution of suffering states and connection to well-being before taking action.<SEP>Spiritual right action is a set of principles applied in moral and ethical conflicts between right and wrong actions.<SEP>Spiritual right action is a result of an inward journey and guides individuals in making the right decision in life.<SEP>Spiritual right action refers to actions guided by moral or ethical principles, often part of ideal-driven behavior.";
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: 1PlGMOAypCI (URL: https://www.youtube.com/watch?v=1PlGMOAypCI)";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#source_id> "chunk-07e3a1c90936c5a3ded21ee310a7ca5a<SEP>chunk-cde14d696f27021b8bd46431e4e80d28<SEP>chunk-369f0db74a66636fddaa77ce9a54b9b6<SEP>chunk-53db4a4895ca5dc8d4cc1183c39f2b74<SEP>chunk-14be37b1d86fb5b82128188406768290<SEP>chunk-5d7bc721d374a5cb0cba9dd3f98f763b<SEP>chunk-97955748a023be133267a7da54bf7347<SEP>chunk-408480fb5c52e78fc73c22c8275b38ff<SEP>chunk-ce77326926352a7c47bb2a49044d5832<SEP>chunk-37c881d41553a8a7658ca326a33a2864<SEP>chunk-03367dd9ee49f7699a39e3df3605c23c<SEP>chunk-f85d41f2377858e80129dfbf7af31bf8<SEP>chunk-51a2b155e4eeb45d726ca7ab16117dcc<SEP>chunk-8b53cedbcd4de86ef1b08281380f9428<SEP>chunk-12740ae94c3469761e52a81015d8effe";
  <neo4j://graph.schema#entity_id> "Spiritual Right Action" .

<urn:mukthiguru:Spiritual%20Science%20of%20Wealth%20Creation> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#description> "Spiritual science of wealth creation is a systematic approach to wealth creation rooted in consciousness.<SEP>Spiritual Science of Wealth Creation is a concept outlining the scientific principles behind wealth creation.<SEP>The spiritual science of wealth creation is essential for learning and evolving into abundance consciousness.<SEP>Spiritual science of wealth creation is described as knowledge essential for humans to learn and evolve into for wealth creation.<SEP>Spiritual Science of Wealth Creation refers to systematic principles for wealth creation through spiritual awareness.";
  <neo4j://graph.schema#created_at> "1779152982"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#entity_id> "Spiritual Science of Wealth Creation";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#file_path> "unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)";
  <neo4j://graph.schema#source_id> "chunk-ccfc9de0cdb366c2facd9b971eb19ab0<SEP>chunk-2baff9ff7ae96c7443216aa06ccb2687<SEP>chunk-862528746f60f5678c41b67748425947<SEP>chunk-3cf67bb7dd92ee291f3034c55c2bac9c<SEP>chunk-cc573a1ed7984ac5ddefcc442d2f95bf" .

