  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#description> "Kama encompasses love, affection, intimacy, respect, and compassion as fundamental human desires.<SEP>The pursuit of love, which becomes a desperate longing or obsession in the Nobody State and transforms into nurturing, liberating love in the Beautiful State.<SEP>Kama is one of the four pursuits, representing love and compassion.<SEP>Kama represents the pursuit of love, which becomes obsessive longing in the Nobody State but evolves into nurturing love from the Beautiful State.` - Correct.";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#entity_id> "Kama" .

