  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#description> "Self-help refers to practices aimed at personal improvement and motivation.<SEP>Self-help is framed as a traditional approach focused on motivation and personal improvement, now being redefined in the context of spiritual experiences.<SEP>Self-help is a concept that has evolved to incorporate spirituality, focusing on spiritual experiences rather than traditional motivation or inspiration.<SEP>Self-help is contrasted with spiritual experience, shifting focus from motivation to transcendent truth-seeking.<SEP>Self-Help is mentioned as a concept that has evolved from motivation and inspiration to a focus on spiritual experience.<SEP>Self-help is contrasted with spiritual experience, shifting focus from motivation to truth-seeking.";
  <neo4j://graph.schema#created_at> "1779246208"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#entity_id> "Self-Help" .

