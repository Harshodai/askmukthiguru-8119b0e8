<urn:mukthiguru:Internal%20State> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#source_id> "chunk-58262216b12d3a82c0194e2a972ecdde<SEP>chunk-f01f7886f64dcda0228048269c532fa0<SEP>chunk-b37ece05c6dd07c4fd1c02e2cefb7912<SEP>chunk-25f394f47fe40575ea9fbcd110df6414<SEP>chunk-5f06ba1ae7a3d1eb5ae89a5a7db786f0";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#description> "Internal State refers to the emotional and mental condition of individuals and society, encompassing one's psychological well-being and influencing relationships and self-perception. It is shaped by the external environment, which in turn affects the internal state, creating a reciprocal relationship. While physical advancements have been achieved, the internal state of both individuals and society is noted as not improving and is described as deteriorating. This deterioration is characterized by persistent issues such as family breakdown and addiction, indicating a decline in social and emotional health despite progress in other domains. The concept of internal state is applied to both personal and collective contexts, highlighting that the same mental and emotional dynamics affect personal relationships and broader societal well-being. The observed decline in internal state across society is linked to increasing family breakdown and addiction, which are viewed as symptoms of a broader erosion of social and emotional health.<SEP>The internal state of individuals and society is described as deteriorating, with issues like family breakdown and addiction.<SEP>The internal state of individuals and society is described as deteriorating, with issues like family breakdown and addiction.";
  <neo4j://graph.schema#created_at> "1779551793"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#file_path> "unknown_source<SEP>YouTube Video: 2seBB2oByZc (URL: https://www.youtube.com/watch?v=2seBB2oByZc)";
  <neo4j://graph.schema#entity_id> "Internal State" .

