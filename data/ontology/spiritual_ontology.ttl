<urn:mukthiguru:Stressful%20Emotions> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#source_id> "chunk-37e9823f1b7627730cb977ca684bcc4a";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#created_at> "1779138112"^^<http://www.w3.org/2001/XMLSchema#long>;
