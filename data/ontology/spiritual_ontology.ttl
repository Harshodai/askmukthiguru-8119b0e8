  <neo4j://graph.schema#created_at> "1779647362"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#source_id> "chunk-abcd9205e6cb81b428a3257c9dbf7dc6<SEP>chunk-7acdb8dcc103d74a206701373f78fcb9";
