<urn:mukthiguru:Students> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#source_id> "chunk-9ed2c626e4ecfc75e917140a3a7bfdbb<SEP>chunk-ad886d6b8bed920b247267424ac5e9aa<SEP>chunk-45384d6e9118a3a6dd41204b27b84334<SEP>chunk-047b4478344df168d1315f3ec6d2549f<SEP>chunk-37f26db11e149c4af43719c414b748ce<SEP>chunk-7769be7ae0544b9b85386becf7e58bed<SEP>chunk-23f4ae85323a27ae180ceca7fa33c13a<SEP>chunk-c29e446278bb16bd97c026c06682add6<SEP>chunk-ed2a8a5a882c678a038da88cc2f4309e<SEP>chunk-76ae728c8b06838498707d7f45c78764<SEP>chunk-50804a0cd2fabf8122814121f088fb8d<SEP>chunk-132b8aaee32a493c686704b9df170e0b<SEP>chunk-5df4284d1aa76cb89d7850ba8ee300b9<SEP>chunk-8023f21b8329ca4fd7e397012bdb99e9";
