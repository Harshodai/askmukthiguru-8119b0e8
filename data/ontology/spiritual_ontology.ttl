  <neo4j://graph.schema#entity_id> "Panic";
  <neo4j://graph.schema#description> "Panic represents an acute stress response leading to long-term anxiety.<SEP>Panic is an acute stress response that transitions into chronic anxiety, exacerbating fear and uncertainty.<SEP>An intense fear or anxiety that disrupts normal functioning.";
