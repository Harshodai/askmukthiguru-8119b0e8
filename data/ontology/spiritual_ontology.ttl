  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#description> "The process of realizing one's interconnectedness with all life and the world, leading to a unified perspective.<SEP>The process of realizing one's interconnectedness with all life and the world, leading to a unified perspective.<SEP>Awakening to love represents a revolutionary shift in consciousness, transcending fleeting pleasure and romantic infatuation to embrace universal empathy and selflessness.<SEP>Awakening to love represents a revolutionary shift in consciousness, transcending fleeting pleasure and romantic infatuation to embrace universal empathy and selflessness.<SEP>An inner state required to activate latent decision-making potential and achieve extraordinary life outcomes.";
  <neo4j://graph.schema#entity_id> "Awakening in Consciousness" .

