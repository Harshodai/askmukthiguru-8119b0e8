<urn:mukthiguru:Racial%20Discrimination> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#created_at> "1779453183"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#source_id> "chunk-9d6f79b5d9addaa1bb7ed5a41e6ca13e<SEP>chunk-7d81041aa6a8c1ffd7fa363d2179e32d<SEP>chunk-0cb21e09915c74bf08c75e2e9b3c1480<SEP>chunk-4be5f58baaab4360b84499e4e9c8f89b<SEP>chunk-c5d032c6a2271ec421a56c36fda060bb<SEP>chunk-a85ada8ef40f654a099ee00af9f2432f";
  <neo4j://graph.schema#description> "America's societal structure is tied to racial discrimination as a basis for social hierarchy.<SEP>Racial discrimination is a form of discrimination based on race, perpetuated through generational narratives.<SEP>Racial discrimination is a form of discrimination based on race, exemplified by America's historical context.<SEP>Racial discrimination refers to prejudiced treatment based on race or ethnicity.<SEP>Form of discrimination highlighted in the video as a source of conflict and separation.<SEP>Racial Discrimination is a form of social division based on perceived racial differences.";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#entity_id> "Racial Discrimination";
  <neo4j://graph.schema#file_path> "YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)<SEP>YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)" .

