  <neo4j://graph.schema#entity_id> "Beautiful Life";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#description> "Beautiful Life signifies an ideal state of being free from separation and suffering, framed as humanity's destiny.<SEP>A philosophical stance symbolizing self-acceptance and contentment with one's existence.<SEP>The purpose of visiting Ekam Kshetra is to start a beautiful life.<SEP>The beautiful life is a state of consciousness where existence is celebrated as it is, free from \"should be\" or \"should not be.\"<SEP>Beautiful Life signifies an ideal state of harmony and purpose.<SEP>A beautiful life is associated with living in a harmonious, purposeful state aligned with universal balance.";
  <neo4j://graph.schema#source_id> "chunk-d3d95285c3a8dfac657e743e02300c41<SEP>chunk-e22f7c2305a6d6df213efae54a651699<SEP>chunk-9503d97a23d03f63c7c514a61b68c6b4<SEP>chunk-6d0566c8fa6f2aed45fb2e69b00761b1<SEP>chunk-d3ac0c14051bad6207731777eb7b7f65<SEP>chunk-bb8776e3af3003e2566aad28f28875b7<SEP>chunk-287c3c0f3f95498058ee40d18602c6a5";
