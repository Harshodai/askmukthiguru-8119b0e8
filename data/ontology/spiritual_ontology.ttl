<urn:mukthiguru:Chaos> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#description> "{\"Description\": \"Chaos represents disruptive energy drawn into stressful states or decisions.\"}<SEP>Chaos is a concept representing disorder or unpredictability, drawn into business and work when in stressful or unpleasant states.<SEP>Chaos represents disorder and conflict, contrasted with peace as the natural state of the universal field.<SEP>Chaos represents disorder and instability within the Field, contrasting with peace and coherence.<SEP>Chaos refers to a state of disorder and unpredictability, contrasted with the harmony achieved through Oneness.<SEP>Chaos represents the underlying lack of structure in life when actions are not driven by clear purpose, as contrasted with superficial order.<SEP>An emotional state linked to attracting problems in life.";
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=gQiIwfA3mlk)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UZHSssZflFQ)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=OWMBvMlGWTA)<SEP>YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)<SEP>YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)<SEP>YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)<SEP>YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)";
