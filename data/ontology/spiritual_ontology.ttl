<urn:mukthiguru:Stress%20Chemicals> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#source_id> "chunk-05457b0af5553482321d52283975782d<SEP>chunk-5aeea4b62735a07173124f3878e34dac";
