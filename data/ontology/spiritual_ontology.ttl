<urn:mukthiguru:Mukthi> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#file_path> "YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=IGryscyFmV8)<SEP>YouTube Video: pTnZt0SqDFM (URL: https://www.youtube.com/watch?v=pTnZt0SqDFM)<SEP>YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)<SEP>unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)";
  <neo4j://graph.schema#entity_id> "Mukthi";
