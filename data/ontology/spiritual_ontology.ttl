  <neo4j://graph.schema#source_id> "chunk-ae6d476e13e2477cf2c7c9d3b6783d89";
  <neo4j://graph.schema#description> "Suering states of consciousness are emotional or mental conditions that influence behavior and decision-making, including anger, stress, and anxiety.";
  <neo4j://graph.schema#entity_id> "Suering States of Consciousness";
  <neo4j://graph.schema#entity_type> "concept" .

