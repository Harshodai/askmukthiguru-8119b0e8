<urn:mukthiguru:Lion> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_id> "Lion";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#source_id> "chunk-fe2967cbd738ae1882767972220f2846<SEP>chunk-6dd6f0aed7fea431a27783bb1609b0ed<SEP>chunk-be5b7210ecbddf5ded747efb6c288c98<SEP>chunk-12b99bdaf0b9e3dacedf22c15bf06bc9<SEP>chunk-671c6ddc6c8ba583342b564958bff7bd";
  <neo4j://graph.schema#description> "The lion whose roar inspires the lion cub, representing authority and power in the forest.<SEP>Lion is mentioned alongside the tiger in the context of influencing animal behavior.<SEP>Lions maintain respectful distance from humans when hungry as part of natural behavior.<SEP>Lion is a wild animal historically associated with physical danger and life-threatening scenarios.<SEP>The lion is another example of a physical danger that historically triggered a stress response for survival.";
  <neo4j://graph.schema#created_at> "1779217152"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=gQiIwfA3mlk)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)";
  <neo4j://graph.schema#entity_type> "creature" .

<urn:mukthiguru:Lion%20Carcass> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#source_id> "chunk-241b0a84182cb7058f0907819d2555a3<SEP>chunk-6e9975c29b6eeab07aa117c06143418a<SEP>chunk-b19b2a822951a545ded34a82295b89dc";
