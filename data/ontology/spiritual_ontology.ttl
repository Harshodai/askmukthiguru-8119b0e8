<urn:mukthiguru:Inclusive%20Thinking> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#source_id> "chunk-38046723cd74f27b125edb0953caff31<SEP>chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-7abf3d6ec3bef4fcb00fff43b8f7e2bf<SEP>chunk-dcbde403840148f165365cfd6299b08f";
