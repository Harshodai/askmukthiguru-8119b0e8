<urn:mukthiguru:Birbal> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf<SEP>unknown_source";
  <neo4j://graph.schema#source_id> "chunk-48d38d40b501a5ac9741fdde5e643c26<SEP>chunk-b66d4da8c241088f7962f1c7ffd83fd6<SEP>chunk-da4b247a4eac03fe686b0059bd126928<SEP>chunk-2a44f8cb9c9f8ea13650035b5bbd408c<SEP>chunk-813e5d6774fbe0673f530d4b67ec6629";
  <neo4j://graph.schema#entity_type> "person";
  <neo4j://graph.schema#entity_id> "Birbal";
  <neo4j://graph.schema#description> "Birbal was a witty minister of Akbar who participated in his intellectual challenges.<SEP>Birbal is a witty minister who searches for the biggest fool in the kingdom and later helps an old man find his lost key.<SEP>Birbal is a minister of Akbar who solved the emperor's challenge by identifying the \"biggest fool\" in the kingdom.<SEP>Birbal was a witty minister of Akbar who solved the emperor's challenge by identifying the old man as the fool.<SEP>Birbal was a witty minister to Emperor Akbar who solved a challenge by identifying a fool searching for a lost key under a lamppost.";
  <neo4j://graph.schema#created_at> "1779184128"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#truncate> "" .

<urn:mukthiguru:Birbals%20story> a <neo4j://graph.schema#base>;
