<urn:mukthiguru:One-Consciousness> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#entity_id> "One-Consciousness";
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf<SEP>unknown_source";
  <neo4j://graph.schema#description> "One-consciousness represents a transformed state of awareness transcending self-obsession, associated with unity and higher understanding.<SEP>One-consciousness represents an expanded state of interconnectedness with self, others, nature, and the universe, marked by progressive self-expansion and holistic awareness.<SEP>One-consciousness is an expanding state of being where the sense of self increases and expands.<SEP>One-Consciousness is described as a unified state of awareness comprising three progressive planes: beautiful, transcendental, and enlightened states.<SEP>A unified state of awareness transcending individual identity, likened to exploring deep-sea beauties.<SEP>One-consciousness is an expanding state of being marked by deep connection with self, others, nature, and the universe. It generates harmony, intelligence, and transformative energy, enabling enlightenment.";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#created_at> "1779187997"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#source_id> "chunk-35e48385a0a3608b5da5a16afae83eaa<SEP>chunk-c6d1ac7b77c644cdbe0e473d070e10a0<SEP>chunk-386e51b3b7144cbed3517afa02fbb181<SEP>chunk-a6edb23148812a00c784704ababdb3ee<SEP>chunk-18fa3a7d8837c4f0b21f7ce5e53f50b2<SEP>chunk-07bbbe415fc6ff4eb6e48c047d81efd5" .

