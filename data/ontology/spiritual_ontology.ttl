<urn:mukthiguru:Spiritual%20Reflection> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#source_id> "chunk-8e03152ba26c428e5446f721ab8114a4<SEP>chunk-d67f1ccb0ba7106556d6b51966372abe";
