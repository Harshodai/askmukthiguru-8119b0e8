<urn:mukthiguru:Mike> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#entity_type> "person";
  <neo4j://graph.schema#created_at> "1779187500"^^<http://www.w3.org/2001/XMLSchema#long>;
