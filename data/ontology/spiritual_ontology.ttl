<urn:mukthiguru:Desert-Life> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#description> "Metaphor for unawakened existence, representing fear, unhappiness, and disconnection from true self and others.<SEP>Represents the unawakened human state marked by fear, unhappiness, and disconnection from self and others.";
