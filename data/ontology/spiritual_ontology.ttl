<urn:mukthiguru:Superiority> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#description> "A state where the ego feels greater than others, associated with pleasure.<SEP>Superiority is the feeling of being better than others, experienced by lottery winners after initial comparisons.<SEP>A concept discussed in the monologue, touching on themes of dominance and excellence.<SEP>A concept discussed in the monologue, touching on themes of dominance and excellence.<SEP>Superiority is a concept discussed in the context of social comparisons leading to problems.";
  <neo4j://graph.schema#created_at> "1779723367"^^<http://www.w3.org/2001/XMLSchema#long>;
