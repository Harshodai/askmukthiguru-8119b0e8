<urn:mukthiguru:Compound%20Subject> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#created_at> "1779667076"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#file_path> "YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)<SEP>YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#description> "A compound subject is a grammatical term referring to a subject that consists of multiple nouns or pronouns, requiring a plural verb.<SEP>Grammatical structure where multiple nouns (e.g., \"discrimination and separation\") are treated as a single subject.<SEP>Compound subjects require plural verb agreement in formal grammar when referring to multiple nouns.<SEP>A grammatical structure where multiple nouns act as a single subject, requiring a plural verb.<SEP>A grammatical structure where multiple nouns act as a single subject, requiring a plural verb.";
  <neo4j://graph.schema#entity_id> "Compound Subject";
  <neo4j://graph.schema#source_id> "chunk-f5f14fddf14672b2d29a6d11525514fd<SEP>chunk-82910be7ab066a3e5e12d9a354ef4d9a<SEP>chunk-2668d66263a2b6505795cf0f77b429d1<SEP>chunk-c3bdf300b2509154604072df1057a411" .

