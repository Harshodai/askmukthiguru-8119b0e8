<urn:mukthiguru:Privacy> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_id> "Privacy";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#description> "Privacy is highlighted as a contested concept in the digital age, with concerns about surveillance and data monitoring.<SEP>Privacy refers to the right to control personal information and freedom from surveillance.<SEP>The phrase \"a privacy is getting lost\" is critiqued for grammatical inaccuracy, with \"privacy\" being the correct singular form without the article.<SEP>Corrected term from \"A privacy\" to represent the concept of privacy loss.<SEP>Privacy is a central concept discussed as a major issue and a state of being lost or eroded in the context of digital platforms.<SEP>Privacy is a central concept discussed as a major issue and a state of being lost or eroded in the context of digital platforms.<SEP>Privacy refers to the concept of personal freedom and data protection in the context of technology and surveillance.";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#file_path> "unknown_source<SEP>YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)";
  <neo4j://graph.schema#created_at> "1779662211"^^<http://www.w3.org/2001/XMLSchema#long>;
