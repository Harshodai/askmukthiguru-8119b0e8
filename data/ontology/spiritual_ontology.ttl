<urn:mukthiguru:Creative%20Solutions> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#source_id> "chunk-9ed2c626e4ecfc75e917140a3a7bfdbb<SEP>chunk-57a709334836e0a4dc7c14a173461dce";
