<urn:mukthiguru:Enlightened%20Consciousness> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_id> "Enlightened Consciousness";
  <neo4j://graph.schema#source_id> "chunk-559ccba6f58d0c12370fddf8d40ee4db<SEP>chunk-b10ebf50b04723581984202297711043<SEP>chunk-7d91771cf2490944963bfab1edba7973<SEP>chunk-3e6f8e85a056a83c6e414cc14c74ff99<SEP>chunk-4bd79f66852d1c2f19b39d0fa5b7850d<SEP>chunk-492e2a7d0bab4e9fd6187e7d33317fb3";
