<urn:mukthiguru:Sunil> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#created_at> "1779187070"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#entity_id> "Sunil";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#file_path> "The_Four_Sacred_Secrets.pdf<SEP>unknown_source";
  <neo4j://graph.schema#entity_type> "person";
  <neo4j://graph.schema#source_id> "chunk-c4f9e407e113bf4f292d2bfecfb8c361<SEP>chunk-5f6e567050111ca1e6e0891a182bd7b3<SEP>chunk-562a8cc0548c2eafa4b1166a020d46a2<SEP>chunk-f8449165361188bfe6afa260ab623922<SEP>chunk-6159dcadf48bbe1bd234217f23bacc7b<SEP>chunk-7f41805cd78c323a0c0383328a52c327<SEP>chunk-9a28e4054912d7c9812d1628ee5acb4a";
  <neo4j://graph.schema#description> "Sunil is a person who visited the campus for a mentoring session with Krishnaji.<SEP>Sunil is a person who left school to work in Mumbai, experienced disconnection from his father, and sent money home despite emotional strain.<SEP>Sunil is a man who feels abandoned by his parents, becomes obsessed with proving his success to his father, and struggles with relationships due to his competitive mindset.<SEP>Sunil is a person who experienced a profound spiritual transformation through meditation, leading to heightened compassion and a transformed relationship with his daughter.<SEP>Sunil is a person whose story illustrates a journey of awakening to love and personal transformation through consciousness.<SEP>Sunil is a man who experiences emotional struggles in relationships, including feelings of abandonment and bitterness toward his father, and undergoes a transformative realization about connection.<SEP>Sunil is a man who experiences emotional transformation through love and connection, initially struggling with disconnection but later awakening to profound compassion." .

