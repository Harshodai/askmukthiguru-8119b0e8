<urn:mukthiguru:Slavery> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#source_id> "chunk-1585d67082ac380dcec744bed4f90b26<SEP>chunk-5c1ed637dca2d0d131d85c8ff4dd33cb<SEP>chunk-98e0115fe065f5dab78321b7c772863d<SEP>chunk-1d477f5607ac5cfb56e2b711bd58f1aa";
  <neo4j://graph.schema#file_path> "YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)<SEP>unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)";
  <neo4j://graph.schema#created_at> "1779557180"^^<http://www.w3.org/2001/XMLSchema#long>;
  <neo4j://graph.schema#entity_id> "Slavery";
  <neo4j://graph.schema#description> "Slavery is a concept equated with obedience, not love.<SEP>Slavery is portrayed as a state of being enslaved, whether through addiction or possessiveness, characterized by lack of freedom.<SEP>Slavery is portrayed as a state of being enslaved, whether through addiction or possessiveness, characterized by lack of freedom.<SEP>Metaphor for how addiction and obsession enslave individuals, as highlighted in the narrative.<SEP>Slavery is described as dependence on a person, substance, or love-driven fear of loss, contrasting with pure love.<SEP>Slavery is described as dependence on a person, substance, or love-driven fear of loss, contrasting with pure love." .

