<urn:mukthiguru:Father%20Figures> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#file_path> "YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)<SEP>YouTube Video: idoWVpnJz-Y (URL: https://www.youtube.com/watch?v=idoWVpnJz-Y)";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#description> "Five types of father figures honored in the Hindu tradition: biological father, spiritual guide, wisdom-giver, provider, liberator, and ancestral director.<SEP>Father figures encompass individuals who act as paternal roles in one's life, including non-biological figures, as celebrated during Father's Day.";
  <neo4j://graph.schema#source_id> "chunk-a1980aa574f493c3c88959244cbe1135<SEP>chunk-ed9bd777897b8b08ed12f0776796982a";
