  <neo4j://graph.schema#source_id> "chunk-77b30b7416e069e15ef954efa82f97bc<SEP>chunk-2be9c30d5eb8cae8ce6cd1e6425921bc<SEP>chunk-d97614999399e6f5f1181bdaebd85f12<SEP>chunk-922e23e61222fa7ebaae80af23f09b19<SEP>chunk-d18ebd8ed5109a40c69cb7a69ecd8f61<SEP>chunk-b189860a6013a1c7314380e0e0422ab7";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#description> "A couple facing life challenges and emotional struggles, often trapped in negative states and possessive behavior.<SEP>Couple is referenced as a unit that needs to grow and become whole.<SEP>A pair taught to overcome emotional hurts and rediscover love as part of enlightenment practices.<SEP>A pair taught to overcome emotional hurts and rediscover love as part of enlightenment practices.<SEP>Couple refers to the unnamed pair who owned the steel company in Brazil and underwent a mystical transformation to achieve business success.`<SEP>Couple refers to the unnamed pair who owned the steel company in Brazil and underwent a mystical transformation to achieve business success.`<SEP>A collective term for two individuals connected through karmic forces and shared past-life experiences, experiencing attraction and conflict.";
  <neo4j://graph.schema#entity_id> "Couple" .

<urn:mukthiguru:Couples> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#entity_id> "Couples";
