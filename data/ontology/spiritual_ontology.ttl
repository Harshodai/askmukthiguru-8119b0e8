<urn:mukthiguru:Action> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#created_at> "1779748652"^^<http://www.w3.org/2001/XMLSchema#long>;
