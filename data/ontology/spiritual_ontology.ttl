  <neo4j://graph.schema#description> "Perceptions shape how individuals interpret their environment and internal experiences.<SEP>Perceptions are interpretations of reality that may lack openness to alternative perspectives.";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#created_at> "1779242468"^^<http://www.w3.org/2001/XMLSchema#long>;
