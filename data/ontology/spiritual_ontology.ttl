<urn:mukthiguru:Desire> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#description> "Desire is framed as a natural human drive that should not be suppressed, contrasting with compromises.<SEP>Desire is a fundamental human experience that can lead to obsessive craving and suffering when fixated on objects of desire.";
  <neo4j://graph.schema#source_id> "chunk-e9621dc7d3757b01547188c8c828f956<SEP>chunk-4d59e72aadbbf0c922fc8ed13db1693a";
