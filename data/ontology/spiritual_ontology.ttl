<urn:mukthiguru:Broken%20Heart> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#description> "The broken heart symbolizes the protagonist's past pain and trauma, which is metaphorically repaired through her transcendental experience.<SEP>A broken heart describes the intense emotional pain and longing resulting from a relationship's dissolution.<SEP>Broken Heart symbolizes emotional distress following a relationship's end, associated with prolonged suffering.";
  <neo4j://graph.schema#source_id> "chunk-f850af926a91f1ef0f0f13f7bd908f06<SEP>chunk-801a54bafa1f63f0a4d091331cafc3d9<SEP>chunk-0bcd34bbf2440bb034ae1a5607edb427";
