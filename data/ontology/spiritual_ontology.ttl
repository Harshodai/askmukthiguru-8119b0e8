  <neo4j://graph.schema#entity_id> "Creative Force";
  <neo4j://graph.schema#description> "Creative force is portrayed as a dynamic energy interacting with self to manifest in lived experiences.<SEP>Creative force is portrayed as a dynamic energy interacting with self to manifest in lived experiences.<SEP>A dynamic energy described as flowing into one's life through the \"new sense of self,\" enabling transformative creativity.";
  <neo4j://graph.schema#created_at> "1779561559"^^<http://www.w3.org/2001/XMLSchema#long>;
