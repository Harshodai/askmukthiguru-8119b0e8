<urn:mukthiguru:Pre-Written%20Destiny> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#entity_id> "Pre-Written Destiny";
  <neo4j://graph.schema#source_id> "chunk-5637d12f2e1eaf0419e502601bcb1c15";
  <neo4j://graph.schema#file_path> "YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)";
  <neo4j://graph.schema#description> "Pre-written destiny refers to the idea of a fixed fate determined without individual agency, which the speaker contrasts with self-created destiny.";
  <neo4j://graph.schema#entity_type> "concept";
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#created_at> "1779678567"^^<http://www.w3.org/2001/XMLSchema#long> .

<urn:mukthiguru:Pre-written%20Destiny> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#truncate> "";
  <neo4j://graph.schema#description> "Pre-written destiny is the idea that a person's future is already determined and requires no action.<SEP>The belief in a fixed, unalterable future predetermined by external forces, which the speaker challenges in favor of self-created destiny.<SEP>The belief in a fixed, unalterable future predetermined by external forces, which the speaker challenges in favor of self-created destiny.<SEP>The belief in a fixed, unalterable future predetermined by external forces, which the speaker challenges in favor of self-created destiny.<SEP>The belief in a fixed, unalterable future predetermined by external forces, which the speaker challenges in favor of self-created destiny.<SEP>Pre-written destiny is a specific concept of destiny that is pre-determined.<SEP>Pre-written destiny is a specific concept of destiny that is pre-determined.";
