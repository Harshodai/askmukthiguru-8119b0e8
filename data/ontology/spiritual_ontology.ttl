<urn:mukthiguru:Field%20of%20Consciousness> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#source_id> "chunk-e69d17b5a95c66d86550266e6f75a794<SEP>chunk-8f35cfdcddeef4d10f1b5998a3a18b8b<SEP>chunk-e41aa29188359857d686593b398cb57d<SEP>chunk-e2e44adeb9e364c8a1e4597e2d7040b0<SEP>chunk-f4e78af21ffa64a146419829fbc464c1<SEP>chunk-e62e4366c052c78d46a09bec53d2a9c4";
