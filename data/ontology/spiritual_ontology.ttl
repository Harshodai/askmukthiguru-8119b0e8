<urn:mukthiguru:Prefrontal%20Cortex> a <neo4j://graph.schema#base>;
  <neo4j://graph.schema#file_path> "unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)<SEP>YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)";
