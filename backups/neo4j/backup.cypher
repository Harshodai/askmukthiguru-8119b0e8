UNWIND [{start: {_id:348}, end: {_id:7281}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", keywords:"identification,metadata", truncate:"", weight:1.0, description:"The video ID cHAJiF2byzg uniquely identifies the YouTube Video.", created_at:1779662662, source_id:"chunk-a532d15b45a354bea11d6dc57df813b2"}}, {start: {_id:348}, end: {_id:7301}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", truncate:"", keywords:"access,linking", weight:1.0, description:"The URL provides direct access to the YouTube Video on the YouTube platform.", created_at:1779662662, source_id:"chunk-a532d15b45a354bea11d6dc57df813b2"}}, {start: {_id:7303}, end: {_id:348}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", keywords:"composition,media content", truncate:"", weight:1.0, description:"The Video Content is the primary content of the YouTube Video.", created_at:1779662662, source_id:"chunk-a532d15b45a354bea11d6dc57df813b2"}}, {start: {_id:7302}, end: {_id:7303}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", keywords:"discussion,thematic focus", truncate:"", weight:1.0, description:"The Video Content includes a discussion about the \"state of humanity.\"", created_at:1779662662, source_id:"chunk-a532d15b45a354bea11d6dc57df813b2"}}, {start: {_id:852}, end: {_id:7303}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", truncate:"", keywords:"conceptual reference,thematic element", weight:1.0, description:"The Video Content references \"fear\" as part of its thematic content.", created_at:1779662663, source_id:"chunk-a532d15b45a354bea11d6dc57df813b2"}}, {start: {_id:852}, end: {_id:7302}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", truncate:"", keywords:"conceptual link,thematic element", weight:1.0, description:"The corrected text directly associates \"state of humanity\" with \"fear,\" establishing a thematic connection between the two concepts.", created_at:1779662663, source_id:"chunk-a532d15b45a354bea11d6dc57df813b2"}}, {start: {_id:7304}, end: {_id:7290}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", keywords:"content,thematic focus", truncate:"", weight:1.0, description:"YouTube Video: cHAJiF2byzg contains the repeated statement \"A state of humanity is, and fear.\" as part of its thematic content.", created_at:1779662692, source_id:"chunk-6a2dcd2eb95d21b4ee80f566c015729b"}}, {start: {_id:3952}, end: {_id:348}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", keywords:"content,repetition", truncate:"", weight:1.0, description:"The YouTube Video includes the repeated phrase \"A state of humanity is, and fear.\"", created_at:1779662693, source_id:"chunk-66bd03dce1e8f5f9bd71a996fc9f8702"}}, {start: {_id:2917}, end: {_id:7305}, properties:{file_path:"YouTube Video: vch9C_hNjGs (URL: https://www.youtube.com/watch?v=vch9C_hNjGs)", truncate:"", keywords:"cause and effect,universal fulfillment", weight:1.0, description:"Achievements emerge organically from the bliss of being, serving universal fulfillment rather than self-interest.", created_at:1779662712, source_id:"chunk-c9bb5b4ae7e13a7674f385925b990906"}}, {start: {_id:2917}, end: {_id:5146}, properties:{file_path:"YouTube Video: vch9C_hNjGs (URL: https://www.youtube.com/watch?v=vch9C_hNjGs)", keywords:"alignment,direction", truncate:"", weight:1.0, description:"Achievements flow into the universe to fulfill a greater purpose beyond individual goals.", created_at:1779662712, source_id:"chunk-c9bb5b4ae7e13a7674f385925b990906"}}, {start: {_id:496}, end: {_id:499}, properties:{file_path:"unknown_source", truncate:"", keywords:"internal experience,self-centered thinking", weight:1.0, description:"Stress is an internal experience that arises from self-centered thinking, which is a form of anxiety.", created_at:1779662747, source_id:"chunk-9f51181a0a82fab99daeacb192359f2b"}}, {start: {_id:197}, end: {_id:499}, properties:{file_path:"unknown_source<SEP>YouTube Video: k8iO5daXllM (URL: https://www.youtube.com/watch?v=k8iO5daXllM)", truncate:"", keywords:"anxiety,cause,internal experience,psychological impact,self-centered focus", weight:3.0, created_at:1779663934, description:"Stress is linked to the inner world, where self-centered focus leads to internal experience.<SEP>The inner world's self-focused nature directly causes stress and anxiety.<SEP>The Inner World is characterized by stress and anxiety due to excessive focus on oneself.", source_id:"chunk-9f51181a0a82fab99daeacb192359f2b<SEP>chunk-28f74829653c4417f524f54649fb5c5d<SEP>chunk-3fcd5590a066218a6f24158434a46bcf"}}, {start: {_id:7306}, end: {_id:499}, properties:{file_path:"unknown_source", keywords:"reduction,understanding", truncate:"", weight:1.0, description:"Understanding the difference between problem and suffering leads to the reduction of stress.", created_at:1779662747, source_id:"chunk-9f51181a0a82fab99daeacb192359f2b"}}, {start: {_id:197}, end: {_id:1301}, properties:{file_path:"unknown_source<SEP>YouTube Video: k8iO5daXllM (URL: https://www.youtube.com/watch?v=k8iO5daXllM)", keywords:"meditation,problem-solving,resolution,self-awareness", truncate:"", weight:2.0, description:"The inner world, when meditated upon, brings intelligence that helps solve problems.<SEP>Meditating on the inner world can unlock intelligence to resolve problems.", created_at:1779663806, source_id:"chunk-9f51181a0a82fab99daeacb192359f2b<SEP>chunk-28f74829653c4417f524f54649fb5c5d"}}, {start: {_id:1619}, end: {_id:7307}, properties:{file_path:"YouTube Video: k8iO5daXllM (URL: https://www.youtube.com/watch?v=k8iO5daXllM)", keywords:"association,employment", truncate:"", weight:1.0, description:"The Text Correction Expert role is associated with the Mukthi Guru platform, providing correction services.", created_at:1779662775, source_id:"chunk-963de118dd8c42af405a0b9cfddcf2c4"}}, {start: {_id:1787}, end: {_id:7307}, properties:{file_path:"YouTube Video: k8iO5daXllM (URL: https://www.youtube.com/watch?v=k8iO5daXllM)", truncate:"", keywords:"error correction,focus area", weight:1.0, description:"The role focuses on correcting homophones and misheard words in the text.", created_at:1779662775, source_id:"chunk-963de118dd8c42af405a0b9cfddcf2c4"}}, {start: {_id:1786}, end: {_id:7307}, properties:{file_path:"YouTube Video: k8iO5daXllM (URL: https://www.youtube.com/watch?v=k8iO5daXllM)", truncate:"", keywords:"focus area,terminology accuracy", weight:1.0, description:"The role ensures accurate correction of domain-specific terms from the provided list.", created_at:1779662775, source_id:"chunk-963de118dd8c42af405a0b9cfddcf2c4"}}, {start: {_id:277}, end: {_id:7307}, properties:{file_path:"YouTube Video: k8iO5daXllM (URL: https://www.youtube.com/watch?v=k8iO5daXllM)", truncate:"", keywords:"focus area,readability enhancement", weight:1.0, description:"The role corrects punctuation and capitalization to improve text readability.", created_at:1779662775, source_id:"chunk-963de118dd8c42af405a0b9cfddcf2c4"}}, {start: {_id:1789}, end: {_id:7307}, properties:{file_path:"YouTube Video: k8iO5daXllM (URL: https://www.youtube.com/watch?v=k8iO5daXllM)", keywords:"compliance,guidelines", truncate:"", weight:1.0, description:"The role adheres to constraints such as no summarization and exclusive error correction.", created_at:1779662775, source_id:"chunk-963de118dd8c42af405a0b9cfddcf2c4"}}, {start: {_id:1083}, end: {_id:7307}, properties:{file_path:"YouTube Video: k8iO5daXllM (URL: https://www.youtube.com/watch?v=k8iO5daXllM)", truncate:"", keywords:"correction input,processing", weight:1.0, description:"The role processes the provided text to correct errors.", created_at:1779662775, source_id:"chunk-963de118dd8c42af405a0b9cfddcf2c4"}}] AS row
