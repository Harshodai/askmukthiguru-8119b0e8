UNWIND [{_id:5397, properties:{file_path:"YouTube Video: leypd9opVSc (URL: https://www.youtube.com/watch?v=leypd9opVSc)", entity_type:"concept", truncate:"", description:"Sacred Experience refers to the spiritual journey during conception and pregnancy, emphasizing the connection between parents and their future child.", created_at:1779511063, source_id:"chunk-255bf350d451faa2df8677aa580dc07b", entity_id:"Sacred Experience"}}, {_id:5398, properties:{file_path:"YouTube Video: leypd9opVSc (URL: https://www.youtube.com/watch?v=leypd9opVSc)", entity_type:"person", truncate:"", description:"Future Child symbolizes the unborn child whose essence is drawn from both parents, central to the bonding process.", created_at:1779511063, source_id:"chunk-255bf350d451faa2df8677aa580dc07b", entity_id:"Future Child"}}, {_id:5400, properties:{file_path:"YouTube Video: leypd9opVSc (URL: https://www.youtube.com/watch?v=leypd9opVSc)", entity_type:"concept", truncate:"", description:"Bonding Experience describes the deepened parental connection resulting from conceiving and birthing an awakened child.", created_at:1779511063, source_id:"chunk-255bf350d451faa2df8677aa580dc07b", entity_id:"Bonding Experience"}}, {_id:5401, properties:{file_path:"YouTube Video: leypd9opVSc (URL: https://www.youtube.com/watch?v=leypd9opVSc)", entity_type:"UNKNOWN", truncate:"", description:"The Bonding Experience is highlighted as equally relevant to single mothers, emphasizing inclusivity in the process.", created_at:1779511064, source_id:"chunk-255bf350d451faa2df8677aa580dc07b", entity_id:"single mothers"}}, {_id:5402, properties:{file_path:"unknown_source<SEP>YouTube Video: uSAO5p0GIU8 (URL: https://www.youtube.com/watch?v=uSAO5p0GIU8)", entity_type:"concept", truncate:"", description:"Awakening of consciousness is a process enabling individuals to transcend unhappiness and suffering through spiritual understanding.<SEP>Awakening of consciousness is a process leading to enlightenment and understanding of life's challenges.<SEP>Awakening of consciousness is a process leading to enlightenment and understanding of life's challenges.<SEP>Awakening of consciousness is a process leading to enlightenment and understanding of life's challenges.<SEP>Awakening of consciousness is a process leading to enlightenment and understanding of life's challenges.", created_at:1779511614, source_id:"chunk-eb1bcec2ec4775f87f2a9dcf795a907a<SEP>chunk-1d721d9fcd5e561bfe9353bb3e49e8a1", entity_id:"Awakening of Consciousness"}}, {_id:5405, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The why of unhappiness is a concept understood through the awakening of consciousness, revealing the root causes of suffering.", created_at:1779511100, source_id:"chunk-eb1bcec2ec4775f87f2a9dcf795a907a", entity_id:"Why of Unhappiness"}}, {_id:5406, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The how of liberation is a method learned through spiritual practice, enabling individuals to live joyfully and free from suffering.", created_at:1779511101, source_id:"chunk-eb1bcec2ec4775f87f2a9dcf795a907a", entity_id:"How of Liberation"}}, {_id:5409, properties:{file_path:"YouTube Video: uSAO5p0GIU8 (URL: https://www.youtube.com/watch?v=uSAO5p0GIU8)", entity_type:"concept", truncate:"", description:"Mystic science refers to the systematic study of consciousness and its awakening in spirituality.<SEP>Mystic science refers to the systematic study of consciousness and its awakening in spirituality.<SEP>Mystic science refers to the systematic study of consciousness and its awakening in spirituality.<SEP>Mystic science refers to the systematic study of consciousness and its awakening in spirituality.", created_at:1779511614, source_id:"chunk-1d721d9fcd5e561bfe9353bb3e49e8a1", entity_id:"Mystic Science"}}, {_id:5412, properties:{file_path:"unknown_source<SEP>YouTube Video: 4Fjf6IQsjQs (URL: https://www.youtube.com/watch?v=4Fjf6IQsjQs)", entity_type:"creature", truncate:"", description:"Single-cell organisms are cited as examples of intelligence within the universe's biological systems.<SEP>Single-cell organisms are cited as examples of intelligence within the universe, contributing to the concept of an intelligent universe.", created_at:1779511874, source_id:"chunk-3a9b1e90fab2bdbcbb151bc873bcb657<SEP>chunk-55cc26bf031f0db4fced411b5d43e45c", entity_id:"Single-Cell Organisms"}}, {_id:5413, properties:{file_path:"unknown_source<SEP>YouTube Video: 4Fjf6IQsjQs (URL: https://www.youtube.com/watch?v=4Fjf6IQsjQs)", entity_type:"concept", truncate:"", description:"The intelligent universe is described as a system where intelligence permeates all levels of existence, from single-cell organisms to galaxies and stars.<SEP>The intelligent universe is described as a system where intelligence permeates all elements, from single-cell organisms to galaxies and stars, enabling human beings to tap into and utilize this intelligence for problem-solving and enlightenment.", created_at:1779511874, source_id:"chunk-3a9b1e90fab2bdbcbb151bc873bcb657<SEP>chunk-55cc26bf031f0db4fced411b5d43e45c", entity_id:"Intelligent Universe"}}, {_id:5414, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Good or enlightenment represents the potential outcomes of harnessing the universe's intelligence for human benefit.", created_at:1779511807, source_id:"chunk-3a9b1e90fab2bdbcbb151bc873bcb657", entity_id:"Good or Enlightenment"}}, {_id:5415, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Intoxication with bliss occurs during the experience of wholeness.", created_at:1779511944, source_id:"chunk-633783812b5d5da425ce397a32e3139c", entity_id:"Intoxication With Bliss"}}, {_id:5416, properties:{file_path:"unknown_source<SEP>YouTube Video: E-LCT0YEpWQ (URL: https://www.youtube.com/watch?v=E-LCT0YEpWQ)", entity_type:"concept", truncate:"", description:"Sensory experiences (seeing, hearing, touching, tasting, smelling) are considered bliss.<SEP>Sensory experiences include perceptions through sight, hearing, touch, taste, and smell.", created_at:1779511968, source_id:"chunk-633783812b5d5da425ce397a32e3139c<SEP>chunk-e7a44718d07524dc9d25d8465c12f664", entity_id:"Sensory Experiences"}}, {_id:5417, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The enlightened state of Ananda is characterized by bliss and intoxication with blissful experiences.", created_at:1779511944, source_id:"chunk-633783812b5d5da425ce397a32e3139c", entity_id:"Enlightened State Of Ananda"}}, {_id:5418, properties:{file_path:"unknown_source<SEP>YouTube Video: E-LCT0YEpWQ (URL: https://www.youtube.com/watch?v=E-LCT0YEpWQ)", entity_type:"concept", truncate:"", description:"Mental experiences are categorized as bliss in the state.<SEP>Mental experiences encompass thoughts, perceptions, and cognitive processes within consciousness.", created_at:1779511968, source_id:"chunk-633783812b5d5da425ce397a32e3139c<SEP>chunk-e7a44718d07524dc9d25d8465c12f664", entity_id:"Mental Experiences"}}, {_id:5419, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The experience of wholeness leads to intoxication with bliss.", created_at:1779511944, source_id:"chunk-633783812b5d5da425ce397a32e3139c", entity_id:"Wholeness Experience"}}, {_id:5420, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Experience in consciousness is described as bliss in the state.", created_at:1779511944, source_id:"chunk-633783812b5d5da425ce397a32e3139c", entity_id:"Experience In Consciousness"}}, {_id:5421, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Bliss in the state is the enlightened condition associated with experiences.", created_at:1779511944, source_id:"chunk-633783812b5d5da425ce397a32e3139c", entity_id:"Bliss In The State"}}, {_id:5422, properties:{file_path:"YouTube Video: E-LCT0YEpWQ (URL: https://www.youtube.com/watch?v=E-LCT0YEpWQ)", entity_type:"concept", truncate:"", description:"The enlightened state of Ananda is characterized by intoxication with bliss and wholeness.", created_at:1779511968, source_id:"chunk-e7a44718d07524dc9d25d8465c12f664", entity_id:"Enlightened State of Ananda"}}, {_id:5423, properties:{file_path:"unknown_source<SEP>YouTube Video: HZIuHUGmnGY (URL: https://www.youtube.com/watch?v=HZIuHUGmnGY)<SEP>YouTube Video: R0bGNxoJ4sM (URL: https://www.youtube.com/watch?v=R0bGNxoJ4sM)<SEP>YouTube Video: tegTDWT3SDc (URL: https://www.youtube.com/watch?v=tegTDWT3SDc)<SEP>YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", entity_type:"concept", truncate:"", created_at:1779650813, description:"Ananda refers to a state of ultimate bliss or happiness, discussed in the video as a thought structure rather than an experienced reality.", source_id:"chunk-c195d5abc160d6408ccad089d03fdf8f<SEP>chunk-5da4be811aa540e35dbc3127e30549e4<SEP>chunk-16505689511452878f9de53f0eb16c6e<SEP>chunk-b898618f68efd08df9f5924199c43f87<SEP>chunk-aaeba0a2e3dac75ac3bf2d72063fa0eb<SEP>chunk-680dd7bb1c61258ea018e46f2177de41<SEP>chunk-7796e9953e60bd3bb11c46251f992983<SEP>chunk-6bd1265c66d1065be54810dd4e52f30a<SEP>chunk-5eced850d74f972c1d65bf6b3ae924fd<SEP>chunk-1e936532a5c53d8221f209a5d79cf8e0", entity_id:"Ananda"}}] AS row
