UNWIND [{start: {name:"Deeksha"}, end: {_id:1787}, properties:{file_path:"unknown_source", keywords:"correction example,misheard term", truncate:"", weight:1.0, description:"Homophones and misheard words include the misheard term \"Deeksha\" which needs correction.", created_at:1779393636, source_id:"chunk-d66cf68ce9f6d614d8c2ffeac6619b27"}}, {start: {name:"Consciousness"}, end: {_id:3605}, properties:{file_path:"unknown_source", keywords:"emotional release,healing", truncate:"", weight:1.0, description:"Disappointment falls off when consciousness is aware of being felt, per the text.", created_at:1779394641, source_id:"chunk-834da746d2aa7b2a05efc6fe3ab1fc17"}}, {start: {name:"Suffering"}, end: {_id:707}, properties:{file_path:"YouTube Video: zGOKGrTNlk4 (URL: https://www.youtube.com/watch?v=zGOKGrTNlk4)<SEP>unknown_source<SEP>YouTube Video: XFFgRTgP8Rs (URL: https://www.youtube.com/watch?v=XFFgRTgP8Rs)", keywords:"acceptance,awareness,dissolution,insight,misery re-evaluation,paradigm challenge,resolution", truncate:"", weight:5.0, created_at:1779748312, description:"Recognizing suffering truth is essential for breaking the cycle of unconscious buildup.<SEP>Recognizing the truth about self-image dissolves suffering by addressing its root cause rather than external factors.<SEP>Recognizing the truth about self-image dissolves suffering by addressing its root cause.<SEP>Truth dissolves suffering by revealing the root cause.<SEP>Truth challenges the belief that suffering is necessary for divine connection.", source_id:"chunk-28084224d33efa95fcb7e18cd0d14748<SEP>chunk-6202900249469971e378d57b74b99662<SEP>chunk-87e2f7787298d3205ec139c556ef83c0<SEP>chunk-d305977f98ef25807e2b5a0d7a24ce2c<SEP>chunk-0218062ded6a8b7c8b783d92c65d1917"}}, {start: {name:"Beautiful State"}, end: {_id:4519}, properties:{file_path:"YouTube Video: KTlY-lHs_Ew (URL: https://www.youtube.com/watch?v=KTlY-lHs_Ew)", keywords:"analogy,comparison", truncate:"", weight:1.0, description:"The video draws an analogy between lower education grades and a beautiful state.", created_at:1779398198, source_id:"chunk-dba394b8ea38273841a7f5467d696e0c"}}, {start: {name:"Suffering"}, end: {_id:4551}, properties:{file_path:"unknown_source", keywords:"causation,metaphorical", truncate:"", weight:1.0, description:"Suffering is portrayed as the root cause of the \"virus of the bacteria,\" which metaphorically diseases the planet.", created_at:1779399162, source_id:"chunk-8c47a43e466f805ea381f194db0fb072"}}, {start: {name:"Consciousness"}, end: {_id:3996}, properties:{file_path:"unknown_source", truncate:"", keywords:"existential fulfillment,transcendence", weight:1.0, description:"Awakened consciousness ends the \"surge\" of suffering, initiating authentic living.", created_at:1779402345, source_id:"chunk-075b8e71a3c71d11c785be4bbfe965ed"}}, {start: {name:"Consciousness"}, end: {_id:4618}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"illusory perception,metaphysical analysis", weight:1.0, description:"The text connects consciousness to the phenomenon of mind-created suffering as a key philosophical inquiry.", created_at:1779402518, source_id:"chunk-b85547a9c5ce2c1aff2a86073a2bcb87"}}, {start: {name:"Consciousness"}, end: {_id:4657}, properties:{file_path:"unknown_source<SEP>YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", keywords:"consciousness,energy,interconnectedness,reality", truncate:"", weight:2.0, description:"The Field and consciousness are inseparable, with the Field representing the substrate of all existence.<SEP>The field is described as a field of energy and consciousness, encompassing all atoms and molecules in the universe.", created_at:1779404285, source_id:"chunk-3269918410ef2996ad74d621f6f6159f<SEP>chunk-3538d3a6dca3eeca95cabf452a553746"}}, {start: {name:"Consciousness"}, end: {_id:4656}, properties:{file_path:"unknown_source<SEP>YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", keywords:"awareness,creation,evolution,transformation", truncate:"", weight:2.0, description:"Human evolution is driven by advancing consciousness, enabling conscious creation in the world.<SEP>Human evolution involves the evolution of consciousness as a core component.", created_at:1779404507, source_id:"chunk-3269918410ef2996ad74d621f6f6159f<SEP>chunk-e0280d57f075227c7dc8487c44357147"}}, {start: {name:"Consciousness"}, end: {_id:4661}, properties:{file_path:"unknown_source", keywords:"continuity,unity", truncate:"", weight:1.0, description:"Consciousness is the essence of the River of Life, connecting all beings across time and space.", created_at:1779403919, source_id:"chunk-3269918410ef2996ad74d621f6f6159f"}}, {start: {name:"Dharma"}, end: {_id:1799}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)<SEP>unknown_source", truncate:"", keywords:"awakening,peace,responsibility,spiritual duty", weight:2.0, description:"Dharma is the path of awakening to peace for every human being.<SEP>Dharma is the responsibility of human beings to follow noble actions for collective well-being.", created_at:1779519924, source_id:"chunk-a20fa03637522df32905bf3e04315780<SEP>chunk-7abe568e63ed3025b11ad246b7eb6e12"}}, {start: {name:"Consciousness"}, end: {_id:4679}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", keywords:"consciousness,creation", truncate:"", weight:1.0, description:"Evolution is linked to consciousness and the ability to create in the world.", created_at:1779404286, source_id:"chunk-3538d3a6dca3eeca95cabf452a553746"}}, {start: {name:"Dharma"}, end: {_id:4691}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", truncate:"", keywords:"planetary peace,wisdom dissemination", weight:1.0, description:"Dharma involves sharing ancient wisdom to create a more peaceful planet.", created_at:1779404457, source_id:"chunk-bbe524f38300203502fa50c361b4f994"}}, {start: {name:"Consciousness"}, end: {_id:3833}, properties:{file_path:"unknown_source", keywords:"transformation", truncate:"", weight:1.0, description:"The creature's impact leads to a transformation in consciousness, moving from separation to unity.", created_at:1779405612, source_id:"chunk-04d56d56ff3befc2a05ebcfab17f9d42"}}, {start: {name:"Ekam"}, end: {_id:4770}, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", truncate:"", keywords:"concept application,domain relevance", weight:1.0, description:"Ekam is a spiritual concept relevant to Mukthi Guru's domain.", created_at:1779408607, source_id:"chunk-10449d3ca4c3cfdd2cd451c07c6fbbce"}}, {start: {name:"Deeksha"}, end: {_id:4770}, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", truncate:"", keywords:"concept application,domain relevance", weight:1.0, description:"Deeksha is a spiritual concept relevant to Mukthi Guru's domain.", created_at:1779408608, source_id:"chunk-10449d3ca4c3cfdd2cd451c07c6fbbce"}}, {start: {name:"Consciousness"}, end: {_id:1083}, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", truncate:"", keywords:"textual focus,thematic content", weight:1.0, description:"Consciousness is a thematic concept in the provided text.", created_at:1779408608, source_id:"chunk-10449d3ca4c3cfdd2cd451c07c6fbbce"}}, {start: {name:"Consciousness"}, end: {_id:4766}, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", truncate:"", keywords:"foundation for true partnership", weight:1.0, description:"True partnership emerges from a higher level of consciousness that aligns mutual purposes and understanding.", created_at:1779408761, source_id:"chunk-10375887a7aa4a1c7205e37d5e7b18dc"}}, {start: {name:"Consciousness"}, end: {_id:4814}, properties:{file_path:"YouTube Video: stUPu1-W4bE (URL: https://www.youtube.com/watch?v=stUPu1-W4bE)", truncate:"", keywords:"awareness,consciousness expansion", weight:1.0, description:"Meditation opens different regions of consciousness.", created_at:1779409349, source_id:"chunk-4a8a747b20d8cc64be6f0587f83f75f8"}}, {start: {name:"Oneness"}, end: {_id:904}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"oneness,opposite,origin,separation", truncate:"", weight:3.0, description:"Separation is the opposite of oneness, and is described as the state of being separated from love and oneness.<SEP>Oneness is the opposite of separation, and is described as the state of being one with love.<SEP>Oneness is the opposite of Separation and the origin state.", created_at:1779420638, source_id:"chunk-7a50476fe3717f3e56d4d65eb5669d3f<SEP>chunk-4f108a1313b1da3a2fa234ff5f49d6e5"}}] AS row
