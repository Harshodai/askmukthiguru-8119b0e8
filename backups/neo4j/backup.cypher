id:3041}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", truncate:"", keywords:"moral dilemma,narrative context", weight:1.0, description:"The Mahabharata serves as the narrative context where the concept of Dharma Sankhata is explored through the Pandavas' ethical struggles.", created_at:1779667974, source_id:"chunk-151ea8496c9d62859f2ebee56a03be85"}}, {start: {_id:7555}, end: {_id:1638}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", truncate:"", keywords:"content source,thematic focus", weight:1.0, description:"The video explores transcendental spirituality as a means to address existential questions and human dilemmas.", created_at:1779667995, source_id:"chunk-13a0732528361d17a646ba4a3dc581f6"}}, {start: {_id:7556}, end: {_id:7555}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", truncate:"", keywords:"decision-making,philosophical framework", weight:1.0, description:"The video frames the \"right course of action\" as a central question explored through transcendental spirituality.", created_at:1779667995, source_id:"chunk-13a0732528361d17a646ba4a3dc581f6"}}, {start: {_id:7557}, end: {_id:1638}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", truncate:"", keywords:"content source,thematic focus", weight:1.0, description:"The video also examines engaged spirituality's role in practical life decisions and ethical living.", created_at:1779667995, source_id:"chunk-13a0732528361d17a646ba4a3dc581f6"}}, {start: {_id:7557}, end: {_id:7555}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", truncate:"", keywords:"complementary systems,mutual reinforcement", weight:1.0, description:"The video posits that transcendental and engaged spirituality mutually strengthen each other in addressing life's challenges.", created_at:1779667995, source_id:"chunk-13a0732528361d17a646ba4a3dc581f6"}}, {start: {_id:7557}, end: {_id:7556}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", truncate:"", keywords:"ethical inquiry,practical application", weight:1.0, description:"The video connects the \"right course of action\" to engaged spirituality's emphasis on real-world moral choices.", created_at:1779667995, source_id:"chunk-13a0732528361d17a646ba4a3dc581f6"}}] AS row
