UNWIND [{start: {_id:1800}, end: {_id:1200}, properties:{file_path:"unknown_source", keywords:"behavior,proximity", truncate:"", weight:1.0, description:"A tiger's state (full or hungry) affects the deer's behavior, causing them to graze close or maintain distance.", created_at:1779149612, source_id:"chunk-6dd6f0aed7fea431a27783bb1609b0ed"}}, {start: {_id:1071}, end: {_id:1798}, properties:{file_path:"unknown_source<SEP>YouTube Video: 8p3zqYg5wuo (URL: https://www.youtube.com/watch?v=8p3zqYg5wuo)", keywords:"communication,ecological interaction,interaction,non-verbal", truncate:"", weight:4.0, created_at:1779406374, description:"Earth communicates with trees as part of the interconnected natural communication network.<SEP>Earth communicates with trees, which in turn communicate with other trees and mushrooms.<SEP>The earth communicates with trees, and trees communicate with other trees through mushrooms.<SEP>Earth communicates with trees.", source_id:"chunk-6dd6f0aed7fea431a27783bb1609b0ed<SEP>chunk-279428eb24ce3ae24c276976981916e9<SEP>chunk-85ff6540f61eaa4adc3ec9e5f4057b70<SEP>chunk-53a1844f9e75d5bbffcc37eefcf95719"}}, {start: {_id:364}, end: {_id:1796}, properties:{file_path:"unknown_source", keywords:"behavior,distance", truncate:"", weight:1.0, description:"A lion's state (hungry) causes zebras to maintain a respectful distance.", created_at:1779149612, source_id:"chunk-6dd6f0aed7fea431a27783bb1609b0ed"}}, {start: {_id:1799}, end: {_id:116}, properties:{file_path:"unknown_source<SEP>YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", keywords:"communication,consciousness,interconnectedness,unity", truncate:"", weight:2.0, description:"Human Beings communicate with the universe through their state of consciousness.<SEP>Humans are inseparable from the universe, along with all of nature.", created_at:1779404150, source_id:"chunk-6dd6f0aed7fea431a27783bb1609b0ed<SEP>chunk-a20fa03637522df32905bf3e04315780"}}, {start: {_id:1797}, end: {_id:1798}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=gQiIwfA3mlk)<SEP>YouTube Video: 8p3zqYg5wuo (URL: https://www.youtube.com/watch?v=8p3zqYg5wuo)", keywords:"communication,ecological network,ecosystem interaction,interaction,mutualism,network,symbiosis,symbiotic communication", truncate:"", weight:6.0, created_at:1779406375, description:"Trees communicate with mushrooms on the forest floor, forming a symbiotic ecological relationship.<SEP>Trees communicate with mushrooms as part of the forest's communication network.<SEP>Trees communicate with mushrooms through an invisible field in the forest.<SEP>Mushrooms and trees engage in a symbiotic relationship, exchanging minerals and sugars for mutual growth.<SEP>Trees communicate with the forest floor mushrooms, which act as a communication medium.<SEP>Trees communicate with mushrooms.", source_id:"chunk-6dd6f0aed7fea431a27783bb1609b0ed<SEP>chunk-279428eb24ce3ae24c276976981916e9<SEP>chunk-be5b7210ecbddf5ded747efb6c288c98<SEP>chunk-54304c335de80180a629fdfe3979a92e<SEP>chunk-85ff6540f61eaa4adc3ec9e5f4057b70<SEP>chunk-53a1844f9e75d5bbffcc37eefcf95719"}}, {start: {_id:1803}, end: {_id:1802}, properties:{file_path:"unknown_source", keywords:"growth,location", truncate:"", weight:1.0, description:"Certain ferns grow in the hills near Akam.", created_at:1779149613, source_id:"chunk-6dd6f0aed7fea431a27783bb1609b0ed"}}, {start: {_id:1071}, end: {_id:1801}, properties:{file_path:"unknown_source", keywords:"communication,life_forms", truncate:"", weight:1.0, description:"The invisible field is where Earth communicates with trees and other life forms.", created_at:1779149613, source_id:"chunk-6dd6f0aed7fea431a27783bb1609b0ed"}}, {start: {_id:1716}, end: {_id:1193}, properties:{file_path:"unknown_source", keywords:"biological,communication", truncate:"", weight:1.0, description:"Cells communicate to achieve health through biological processes.", created_at:1779149613, source_i