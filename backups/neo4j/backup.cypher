UNWIND [{start: {_id:6205}, end: {_id:499}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"chronic state,stress", truncate:"", weight:1.0, description:"Stress can lead to chronic inflammation if not dissolved quickly.", created_at:1779556008, source_id:"chunk-080d730202516ec2f29ea5332581d23c"}}, {start: {_id:6205}, end: {_id:6204}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"biological effect,negative impact", weight:1.0, description:"Chronic inflammation negatively impacts tissues over time", created_at:1779556008, source_id:"chunk-080d730202516ec2f29ea5332581d23c"}}, {start: {_id:6205}, end: {_id:348}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"content,source", weight:1.0, description:"The video explains chronic inflammation as a prolonged state of the body.", created_at:1779556008, source_id:"chunk-080d730202516ec2f29ea5332581d23c"}}, {start: {_id:6207}, end: {_id:6206}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"chemical release,emotional state", weight:1.0, description:"Prolonged emotional inflammation triggers the release of stress chemicals into the bloodstream.", created_at:1779556010, source_id:"chunk-05457b0af5553482321d52283975782d"}}, {start: {_id:6208}, end: {_id:6207}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"emotional impact,physiological change", weight:1.0, description:"Chronic emotional", created_at:1779556010, source_id:"chunk-05457b0af5553482321d52283975782d"}}, {start: {_id:6210}, end: {_id:6206}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"chemical impact,communication disruption", weight:1.0, description:"Stress chemicals disrupt cellular and organ communication, causing signaling breakdown and health consequences.", created_at:1779556010, source_id:"chunk-05457b0af5553482321d52283975782d"}}, {start: {_id:738}, end: {_id:6217}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"mind-body connection,victimization", weight:1.0, description:"An unhappy mind victimizes the body, leading to health issues.", created_at:1779556038, source_id:"chunk-289fa3c790540a34a24858f5f191d9ca"}}, {start: {_id:2119}, end: {_id:6002}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"cyclical states,operational nature", weight:1.0, description:"The human mind operates in opposites, switching between pleasure and stress.", created_at:1779556038, source_id:"chunk-289fa3c790540a34a24858f5f191d9ca"}}, {start: {_id:6216}, end: {_id:499}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"chemical reaction,health impact", weight:1.0, description:"Dissolving stress leads to acid arising, affecting the body.", created_at:1779556039, source_id:"chunk-289fa3c790540a34a24858f5f191d9ca"}}, {start: {_id:738}, end: {_id:40}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"health improvement,miracle zone", weight:1.0, description:"Living in calm and courage pushes the body into a 'miracle zone' with robust health.", created_at:1779556039, source_id:"chunk-289fa3c790540a34a24858f5f191d9ca"}}, {start: {_id:2753}, end: {_id:311}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"cycle,opposites", weight:1.0, description:"The mind cycles between pleasure and stress, as seen in the lottery winner example.", created_at:1779556039, source_id:"chunk-289fa3c790540a34a24858f5f191d9ca"}}, {start: {_id:6212}, end: {_id:6211}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"emotional response,initial experience", weight:1.0, description:"Lottery Winners experience initial thrill after winning, which is a temporary state of excitement.", created_at:1779556061, source_id:"chunk-9c1aa39a1d495c6095f631b7613571fb"}}, {start: {_id:6211}, end: {_id:6213}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"mental state,return to baseline", weight:1.0, description:"After the initial thrill, lottery winners return to their previous mental state, indicating no lasting change in happiness.", created_at:1779556061, source_id:"chunk-9c1aa39a1d495c6095f631b7613571fb"}}, {start: {_id:6211}, end: {_id:2264}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"envy,social reaction", truncate:"", weight:1.0, description:"Relatives feel envy towards the lottery winner's wealth, representing a social reaction.", created_at:1779556061, source_id:"chunk-9c1aa39a1d495c6095f631b7613571fb"}}, {start: {_id:6211}, end: {_id:3670}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"envy,social reaction", truncate:"", weight:1.0, description:"Neighbors become envious of the lottery winner's wealth, indicating a social reaction.", created_at:1779556061, source_id:"chunk-9c1aa39a1d495c6095f631b7613571fb"}}, {start: {_id:860}, end: {_id:6211}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"envy,social reaction", truncate:"", weight:1.0, description:"Friends feel envy towards the lottery winner's wealth, representing a social reaction.", created_at:1779556062, source_id:"chunk-9c1aa39a1d495c6095f631b7613571fb"}}, {start: {_id:6214}, end: {_id:6211}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"comparison,superiority", truncate:"", weight:1.0, description:"Competitors lead to feelings of superiority in lottery winners, resulting from comparisons.", created_at:1779556062, source_id:"chunk-9c1aa39a1d495c6095f631b7613571fb"}}, {start: {_id:6107}, end: {_id:2753}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"creates,generates", weight:1.0, description:"Imagination generates pleasurable states through the mind's habit-driven processes.", created_at:1779556073, source_id:"chunk-2d8b862305b33bd0f79f0f3bd76e8c3a"}}, {start: {_id:6218}, end: {_id:2753}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"affects,bloats", weight:1.0, description:"Pleasure causes the illusory ego to feel bloated and superior.", created_at:1779556073, source_id:"chunk-2d8b862305b33bd0f79f0f3bd76e8c3a"}}, {start: {_id:742}, end: {_id:2753}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"liberates,overcomes", truncate:"", weight:1.0, description:"Awareness dissolves the attachment to pleasurable states by recognizing their illusory nature.", created_at:1779556073, source_id:"chunk-2d8b862305b33bd0f79f0f3bd76e8c3a"}}] AS row
