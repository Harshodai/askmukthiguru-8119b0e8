:"chunk-37a50ba57b87bf8d444df3da83283e84<SEP>chunk-428c28379181a7cdc217fc69118ccc4d", entity_id:"Judging"}}, {_id:7861, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oZRQoiRe7s4)", entity_type:"concept", truncate:"", description:"Idealized Love is a distorted perception of love where expectations are imposed on others' behavior, leading to dissatisfaction.<SEP>Idealized Love is a distorted perception of love where expectations are imposed on others' behavior, leading to dissatisfaction.", created_at:1779687750, source_id:"chunk-428c28379181a7cdc217fc69118ccc4d", entity_id:"Idealized Love"}}, {_id:7862, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oZRQoiRe7s4)", entity_type:"concept", truncate:"", description:"Exclusive attention describes the expectation that a partner should prioritize the individual above all others, often creating unrealistic demands.<SEP>Exclusive attention describes the expectation that a partner should prioritize the individual above all others, often creating unrealistic demands.", created_at:1779687751, source_id:"chunk-428c28379181a7cdc217fc69118ccc4d", entity_id:"Exclusive Attention"}}, {_id:7863, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oZRQoiRe7s4)", entity_type:"concept", truncate:"", description:"Controlled behavior involves imposing specific expectations on a partner's actions, stifling genuine connection and autonomy.<SEP>Controlled behavior involves imposing specific expectations on a partner's actions, stifling genuine connection and autonomy.", created_at:1779687751, source_id:"chunk-428c28379181a7cdc217fc69118ccc4d", entity_id:"Controlled Behavior"}}, {_id:7864, properties:{file_path:"unknown_source", entity_type:"content", truncate:"", description:"Lullabies are soothing songs sung by mothers to comfort and put their children to sleep.", created_at:1779687842, source_id:"chunk-439f02067105223fb4f1c1b8d3263e52",