UNWIND [{start: {_id:7766}, end: {_id:7765}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jy4hcpUSBms)", keywords:"dark forces,mythology", truncate:"", weight:3.0, description:"Shumba and Nishumba are mythological Asuras representing separation and illusion.` -> Correct.<SEP>Shumba and Nishumba are seen as the third and the final dark forces in mythology.", created_at:1779675420, source_id:"chunk-06509bca67cf9977473996911215a1e2<SEP>chunk-d333235fcabc3883b17563e023b36fd9"}}, {start: {_id:3471}, end: {_id:7758}, properties:{file_path:"unknown_source", keywords:"divine culmination,victory", truncate:"", weight:1.0, description:"Parashakti manifests on the tenth day (Vijayadashami) as the ultimate transcendence of all gunas.", created_at:1779673265, source_id:"chunk-7b3a64aa7e92b879d5649be1dd23a938"}}, {start: {_id:3755}, end: {_id:7760}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jy4hcpUSBms)", keywords:"consciousness,divine vehicle,symbolic association,unity", truncate:"", weight:2.0, description:"Hamsa symbolizes undifferentiated unity consciousness (\"I am you\") in the seeker?s journey.<SEP>Mahasaraswati rides the Himalayan Swan (Hamsa) as a sacred symbol.", created_at:1779673409, source_id:"chunk-7b3a64aa7e92b879d5649be1dd23a938<SEP>chunk-a7efc3b9dab03e6e433daab7a3b11310"}}, {start: {_id:3471}, end: {_id:7767}, properties:{file_path:"unknown_source", keywords:"location,spiritual journey", truncate:"", weight:1.0, description:"Vodashram is the setting for the seeker's transformative experience during Navaratri.` -> Correct.", created_at:1779673266, source_id:"chunk-06509bca67cf9977473996911215a1e2"}}, {start: {_id:7763}, end: {_id:7768}, properties:{file_path:"unknown_source", keywords:"symbolism,transcendence", truncate:"", weight:1.0, description:"The Himalayan Swan embodies undifferentiated consciousness and unity with the divine.` -> Correct.",