UNWIND [{start: {_id:2391}, end: {_id:5121}, properties:{file_path:"unknown_source<SEP>YouTube Video: LYm7oczfWEk (URL: https://www.youtube.com/watch?v=LYm7oczfWEk)", truncate:"", keywords:"enlightenment pursuit,goal,journey,method,program goal,program objective,purpose,spiritual goal,spiritual journey,spiritual objective,spiritual practice", weight:7.0, description:"The Oneness Yoga Challenge is framed as a critical element in the process of achieving enlightenment through physical and energetic perfection.<SEP>The Oneness Yoga Challenge is a method towards achieving Enlightenment.<SEP>The challenge aims to guide participants toward Enlightenment through energy channel mastery.<SEP>The Oneness Yoga Challenge is presented as a means to achieve Enlightenment by perfecting the body and energy channels.<SEP>The challenge aims to guide seekers toward achieving enlightenment through energy channel perfection.<SEP>The Oneness Yoga Challenge is designed to help seekers achieve enlightenment by perfecting their body and<SEP>The Oneness Yoga Challenge is presented as a method to achieve enlightenment.", created_at:1779439597, source_id:"chunk-d0f73f6be38d246bcc320bc477e06c62<SEP>chunk-f30aeaccdf125f8eb8df6eca704db273<SEP>chunk-1c57270923c0b9f6969285d11c29b4d9<SEP>chunk-1c981d2c6af3d27d3259ad2743465f9c<SEP>chunk-c8155d06192483203d070c3a6b141e8c<SEP>chunk-98b25b308c4bb7434621f489a95e2f07<SEP>chunk-8d7bf03b4b4565c628e7a6f285bed9c8"}}, {start: {_id:5120}, end: {_id:5121}, properties:{file_path:"unknown_source<SEP>YouTube Video: LYm7oczfWEk (URL: https://www.youtube.com/watch?v=LYm7oczfWEk)", truncate:"", keywords:"energy alignment,energy channels,focus,involvement,practice,requirement,spiritual practice,spiritual preparation", weight:4.0, description:"The challenge involves aligning the 72,000 energy channels as a critical component for enlightenment.<SEP>The challenge involves perfecting the 72,000 energy channels.<SEP>The challenge emphasizes the 72,000 energy channels in achieving enlightenment.<SEP>The challenge references the 72,000 channels as part of its framework for achieving enlightenment through energy channel perfection.", created_at:1779439676, source_id:"chunk-d0f73f6be38d246bcc320bc477e06c62<SEP>chunk-f30aeaccdf125f8eb8df6eca704db273<SEP>chunk-8d7bf03b4b4565c628e7a6f285bed9c8<SEP>chunk-84d6d16d5c59a95373799db641f8719e"}}, {start: {_id:738}, end: {_id:2391}, properties:{file_path:"unknown_source<SEP>YouTube Video: LYm7oczfWEk (URL: https://www.youtube.com/watch?v=LYm7oczfWEk)<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"attainment,component,energetic perfection,inner stillness,journey component,necessity,physical alignment,physical aspect", weight:5.0, description:"Enlightenment requires perfection of the body and its 72,000 energy channels for achievement.<SEP>The body is a component of the journey to Enlightenment that needs to be perfected.<SEP>Achieving enlightenment requires the perfection of the body.<SEP>Body is associated with inner stillness, which is a component of enlightenment.<SEP>Body is associated with inner stillness, which is a component of enlightenment.", created_at:1779556866, source_id:"chunk-d0f73f6be38d246bcc320bc477e06c62<SEP>chunk-1c981d2c6af3d27d3259ad2743465f9c<SEP>chunk-8d7bf03b4b4565c628e7a6f285bed9c8<SEP>chunk-d887f374fce140e42345a26a703cd352"}}, {start: {_id:738}, end: {_id:5121}, properties:{file_path:"unknown_source<SEP>YouTube Video: LYm7oczfWEk (URL: https://www.youtube.com/watch?v=LYm7oczfWEk)", truncate:"", keywords:"focus,physical requirement,practice,program goal,spiritual practice,spiritual requirement", weight:3.0, created_at:1779439597, description:"The challenge emphasizes perfecting the body's energy channels as part of the enlightenment journey.<SEP>The challenge is presented as a means to perfect the body and energy flow for enlightenment.<SEP>The challenge focuses on the body as part of the journey to enlightenment.", 