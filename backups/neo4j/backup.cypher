UNWIND [{start: {_id:226}, end: {_id:2686}, properties:{file_path:"unknown_source", keywords:"consciousness study,discovery", truncate:"", weight:1.0, description:"India?s ancient sages discovered Brahma Garbha as part of their exploration of consciousness.", created_at:1779183417, source_id:"chunk-1d01b8567ae6021fb37c32daeed210ed"}}, {start: {_id:226}, end: {_id:2787}, properties:{file_path:"unknown_source", keywords:"biological association,consciousness", truncate:"", weight:1.0, description:"Brahma Garbha is associated with the pineal, pituitary, and hypothalamus axes in the brain.", created_at:1779183417, source_id:"chunk-1d01b8567ae6021fb37c32daeed210ed"}}, {start: {_id:226}, end: {_id:2791}, properties:{file_path:"unknown_source", truncate:"", keywords:"consciousness expansion,overcoming limitations", weight:1.0, description:"Brahma Garbha activation enables breaking through the thought barrier to connect with the world of matter.", created_at:1779183417, source_id:"chunk-1d01b8567ae6021fb37c32daeed210ed"}}, {start: {_id:17}, end: {_id:2680}, properties:{file_path:"unknown_source", keywords:"authorship,content creation", truncate:"", weight:1.0, description:"Krishnaji authors \"The First Sacred Secret\" to guide practitioners in the Soul Sync journey.", created_at:1779183450, source_id:"chunk-3c49e28407e5138bcf1195c71da21835"}}, {start: {_id:2797}, end: {_id:266}, properties:{file_path:"unknown_source", keywords:"distribution,hosting", truncate:"", weight:1.0, description:"Breathing Room provides and hosts the app for downloading the audio guide.", created_at:1779183450, source_id:"chunk-3c49e28407e5138bcf1195c71da21835"}}, {start: {_id:2797}, end: {_id:265}, properties:{file_path:"unknown_source", keywords:"content delivery,hosting", truncate:"", weight:1.0, description:"The app serves as the platform for accessing the audio guide led by Preethaji.", created_at:1779183450, source_id:"chunk-3c49e28407e5138bcf1195c71da21835"}}, {start: {_id:118}, end: {_id:2801}, properties:{file_path:"unknown_source", keywords:"allegory,spiritual teaching", truncate:"", weight:1.0, description:"The fable about Yesmi and Nomi allegorically explains the First Sacred Secret's core concept.", created_at:1779183545, source_id:"chunk-81f7d5b351616383eb1a7cca9b4d2b48"}}, {start: {_id:2802}, end: {_id:311}, properties:{file_path:"unknown_source", keywords:"psychology,societal impact", truncate:"", weight:1.0, description:"The stressful state drives conflicts, addictions, and political corruption in human societies.", created_at:1779183546, source_id:"chunk-81f7d5b351616383eb1a7cca9b4d2b48"}}, {start: {_id:904}, end: {_id:311}, properties:{file_path:"unknown_source", keywords:"consequence,emotional effect", truncate:"", weight:1.0, description:"The stressful state leads to separation and loneliness even in social contexts.", created_at:1779183546, source_id:"chunk-8b68736730809289d016abf18cb33a9d"}}, {start: {_id:311}, end: {_id:135}, properties:{file_path:"unknown_source", keywords:"contrast,resolution", truncate:"", weight:1.0, description:"Yesmi's presence contrasts with Nomi's stressful state and offers resolution through empathy.", created_at:1779183546, source_id:"chunk-8b68736730809289d016abf18cb33a9d"}}, {start: {_id:175}, end: {_id:176}, properties:{file_path:"unknown_source", keywords:"aspects of life", truncate:"", weight:1.0, description:"Spiritual vision encompasses the two aspects of life: doing and being.", created_at:1779183622, source_id:"chunk-a9b7e140ee77320c86ccf75a15dd21b2"}}, {start: {_id:177}, end: {_id:176}, properties:{file_path:"unknown_source", keywords:"aspects of life", truncate:"", weight:1.0, description:"Spiritual vision encompasses the two aspects of life: doing and being.", created_at:1779183622, source_id:"chunk-a9b7e140ee77320c86ccf75a15dd21b2"}}, {start: {_id:156}, end: {_id:155}, properties:{file_path:"unknown_source", keywords:"adaptation,resilience", truncate:"", weight:1.0, description:"Machli?s loss of territory (problem) is resolved without prolonged suffering, contrasting human responses.", created_at:1779183622, source_id:"chunk-98ebbba09ead01df2486b7e4f58bcc9b"}}, {start: {_id:17}, end: {_id:4}, properties:{file_path:"unknown_source", keywords:"authorship,source", truncate:"", weight:1.0, description:"Krishnaji authored the text contained in The Four Sacred Secrets.pdf.", created_at:1779183622, source_id:"chunk-98ebbba09ead01df2486b7e4f58bcc9b"}}, {start: {_id:2809}, end: {_id:2810}, properties:{file_path:"unknown_source", keywords:"linguistic,related phrases", truncate:"", weight:1.0, description:"Both phrases are related Sanskrit affirmations used in Soul Sync.", created_at:1779183687, source_id:"chunk-6e3b92943a430e127a61bead1ab61d60"}}, {start: {_id:81}, end: {_id:176}, properties:{file_path:"unknown_source", keywords:"cause and effect,spiritual practice", truncate:"", weight:1.0, description:"Narrator's establishment in spiritual vision leads to significant life occurrences and awareness of its foundational role.", created_at:1779183712, source_id:"chunk-e48cb770a294a3d305875880cc43095f"}}, {start: {_id:2813}, end: {_id:176}, properties:{file_path:"unknown_source", keywords:"conceptual framework,contrast", truncate:"", weight:1.0, description:"Spiritual vision rejects destination-oriented thinking, prioritizing the journey's conscious state.", created_at:1779183712, source_id:"chunk-e48cb770a294a3d305875880cc43095f"}}, {start: {_id:2813}, end: {_id:213}, properties:{file_path:"unknown_source", truncate:"", keywords:"component relationship,conceptual structure", weight:1.0, description:"Goals inherently involve destinations as future endpoints or outcomes.", created_at:1779183712, source_id:"chunk-e48cb770a294a3d305875880cc43095f"}}, {start: {_id:2815}, end: {_id:338}, properties:{file_path:"unknown_source", keywords:"association,lingering pain", truncate:"", weight:1.0, description:"The Wounded Child is tied to the persistence of emotional pain and self-centric misery.", created_at:1779183733, source_id:"chunk-6e5caa7e31ebe95d72aef04edb890b5c"}}, {start: {_id:350}, end: {_id:39}, properties:{file_path:"unknown_source", keywords:"embodiment,emotional state", truncate:"", weight:1.0, description:"The Happy Child embodies joy through radiant expressions and freedom from fear.", created_at:1779183733, source_id:"chunk-6e5caa7e31ebe95d72aef04edb890b5c"}}] AS row
