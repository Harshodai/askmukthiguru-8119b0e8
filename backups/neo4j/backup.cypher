UNWIND [{start: {_id:108}, end: {_id:1832}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", keywords:"mantra,spiritual unity", truncate:"", weight:1.0, description:"Hamsa Soham Ekam is a mantra that embodies the spiritual unity with the Divine as expressed in the chant.", created_at:1779254515, source_id:"chunk-b65b7a91b3418aca3d1c110687b32d7d"}}, {start: {_id:1832}, end: {_id:4135}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"co-occurrence,spiritual practice", weight:1.0, description:"Both Hamsa Soham Ekam and Ye Ye Ye are used in the same spiritual context, indicating a shared thematic or ritualistic purpose.", created_at:1779254515, source_id:"chunk-b65b7a91b3418aca3d1c110687b32d7d"}}, {start: {_id:1996}, end: {_id:1883}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"correction focus,error category", weight:1.0, description:"Homophones and misheard words are a specific category of transcription errors to be corrected.", created_at:1779254705, source_id:"chunk-630c2f6f755544fb8faad7d730e0ae19"}}, {start: {_id:2462}, end: {_id:1883}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"correction focus,error category", weight:1.0, description:"Punctuation and capitalization errors are a specific category of transcription errors to be corrected.", created_at:1779254706, source_id:"chunk-630c2f6f755544fb8faad7d730e0ae19"}}, {start: {_id:1883}, end: {_id:4137}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"correction target,error example", weight:1.0, description:"The repeated \"Ye\" phrases are an example of transcription errors requiring correction.", created_at:1779254706, source_id:"chunk-630c2f6f755544fb8faad7d730e0ae19"}}, {start: {_id:4136}, end: {_id:1883}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"error resolution,task requirement", weight:1.0, description:"Corrected text output must resolve transcription errors without altering the original meaning.", created_at:1779254706, source_id:"chunk-630c2f6f755544fb8faad7d730e0ae19"}}, {start: {_id:1766}, end: {_id:4139}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"linguistic variation,spiritual practice", weight:1.0, description:"Both \"Hamsa Soham\" and \"Soham\" are used as mantras, indicating a linguistic or contextual relationship in spiritual practice.", created_at:1779254747, source_id:"chunk-f02d58016cb210cdabb5a0e4e34489b9"}}, {start: {_id:4140}, end: {_id:4141}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", keywords:"forgiveness,reconciliation", truncate:"", weight:1.0, description:"The term \"Christian Namaste\" contextualizes the emphasis on family forgiveness and support for transformation within familial relationships.", created_at:1779254747, source_id:"chunk-f02d58016cb210cdabb5a0e4e34489b9"}}, {start: {_id:1883}, end: {_id:4145}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"error correction,readability", weight:1.0, description:"The user's job involves addressing transcription errors to improve readability.", created_at:1779254830, source_id:"chunk-863f9e536320fb607179b5b22c477c8c"}}, {start: {_id:4144}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"content inclusion,source material", weight:1.0, description:"The YouTube Video contains the original chant lines as part of its content.", created_at:1779254830, source_id:"chunk-863f9e536320fb607179