We also need to mention \"Drive is a central theme discussed in the context of purpose and family dynamics,", created_at:1779673130, source_id:"chunk-f911f447e8921c9205ec53996cfbe423<SEP>chunk-56da25e7d132b4ecea54c551b7809f75<SEP>chunk-e5d8a73bfe09b1e5fab115705dfa0fe7<SEP>chunk-87ae4401ec344e0f145a40afa02041af<SEP>chunk-20d895bd21d3a068503f3d99fc9f225c<SEP>chunk-47e1f1988fb8839c7401d731e2c56670<SEP>chunk-86cc773cadf6118a5b4bbfcd380c38c3<SEP>chunk-e8e24c4cdde1291a97c096da1259ca59", entity_id:"Drive"}}, {_id:7038, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", created_at:1779654040, description:"Uncertainties are unpredictable factors complicating sustained effort.<SEP>Uncertainties are unpredictable factors that can influence decisions and outcomes.<SEP>Uncertainties denote unpredictable or unclear circumstances affecting decision-making.", source_id:"chunk-f911f447e8921c9205ec53996cfbe423<SEP>chunk-20d895bd21d3a068503f3d99fc9f225c<SEP>chunk-46d6abd520d390d99cea37e408f7a403", entity_id:"Uncertainties"}}, {_id:7040, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"naturalobject", truncate:"", description:"Roots symbolize foundational consciousness and emotional grounding.<SEP>Roots metaphorically signify the foundational consciousness and inner state required for enduring challenges.<SEP>Roots metaphorically signify the foundational consciousness and inner state required for enduring challenges.<SEP>Roots represent the core foundation of the tree, drawing strength from the earth, analogous to consciousness as the basis for personal resilience.<SEP>Roots anchor the tree to the earth, serving as the foundation for its strength and stability.", created_at:1779654040, source_id:"chunk-f911f447e8921c9205ec53996cfbe423<SEP>chunk-56da25e7d132b4ecea54c551b7809f75<SEP>chunk-e5d8a73bfe09b1e5fab115705dfa0fe7<SEP>chunk-46d6abd520d390d99cea37e408f7a403", entity_id:"Roots"}}, {_id:7042, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"Quitting is presented as a result of weak will or absent emotional states.<SEP>The act of abandoning efforts or goals, resulting from weak willpower and absence of a beautiful state.", created_at:1779653590, source_id:"chunk-f911f447e8921c9205ec53996cfbe423<SEP>chunk-37eeb06653208eee260f3881daf51f3a<SEP>chunk-87ae4401ec344e0f145a40afa02041af", entity_id:"Quitting"}}, {_id:7047, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"The capacity to sustain effort and determination, which requires a beautiful state to be maintained and prevent collapse.", created_at:1779653590, source_id:"chunk-37eeb06653208eee260f3881daf51f3a", entity_id:"Willpower/Drive"}}, {_id:7048, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"Incorrect use of \"you'd\" instead of \"you have\" in dialogue.", created_at:1779653761, source_id:"chunk-37a347510a58c57299357a9871f2208b", entity_id:"Grammatical Error: \"you'd\""}}, {_id:7049, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"Incorrect use of \"that\" instead of \"the\" in a rhetorical question.", created_at:1779653761, source_id:"chunk-37a347510a58c57299357a9871f2208b", entity_id:"Grammatical Error: \"that\""}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:7050, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"Informal grammatical construction (\"es with\") requiring revision for clarity.", created_at:1779653761, source_id:"chunk-37a347510a58c57299357a9871f2208b", entity_id:"Grammatical Error: \"es with\""}}, {_id:7051, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"Subject-verb agreement error (\"are\" instead of \"is\") in a philosophical statement.", created_at:1779653761, source_id:"chunk-37a347510a58c57299357a9871f2208b", entity_id:"Grammatical Error: \"are\""}}, {_id:7052, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"Overly complex sentence structure that could be split for readability.", created_at:1779653761, source_id:"chunk-37a347510a58c57299357a9871f2208b", entity_id:"Grammatical Error: Long Sentence"}}, {_id:7053, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"Rhetorical question lacking a question mark at the end.", created_at:1779653761, source_id:"chunk-37a347510a58c57299357a9871f2208b", entity_id:"Grammatical Error: Missing Question Mark"}}, {_id:7054, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"This concept represents the core issues discussed in the input text, related to work and personal relationships.", created_at:1779653774, source_id:"chunk-ac365deba67716da64cdb0c640371200", entity_id:"Problems and Challenges in Work and Relationships"}}, {_id:7055, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"content", truncate:"", created_at:1779653805, description:"A closing expression of gratitude.", source_id:"chunk-e95ff9d14447fc65612b05aac22a6049", entity_id:"Thank you. Thank you."}}, {_id:7056, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"This highlights that a lack of willpower leads to quitting challenges.", created_at:1779653805, source_id:"chunk-e95ff9d14447fc65612b05aac22a6049", entity_id:"When your will is weak"}}, {_id:7057, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"Stresses the importance of maintaining a positive emotional state to persevere through difficulties.", created_at:1779653805, source_id:"chunk-e95ff9d14447fc65612b05aac22a6049", entity_id:"The key is to learn to live in a beautiful state"}}, {_id:7058, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"This quote emphasizes that decisions made from a positive emotional state foster a strong will to accomplish goals.", created_at:1779653806, source_id:"chunk-e95ff9d14447fc65612b05aac22a6049", entity_id:"When your decisions arise from a beautiful state"}}, {_id:7060, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"UNKNOWN", truncate:"", description:"This relationship indicates that having strength to hold on (fourth quote) is the solution to the problem of a weak will (second quote).", created_at:1779653806, source_id:"chunk-e95ff9d14447fc65612b05aac22a6049", entity_id:"Then you will have the strength to hold on and not quit during challenges"}}, {_id:7061, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"Soulmate represents an idealized partner believed to share a deep, pre-destined connection with another person.<SEP>Soulmate is an idealized partner, often associated with initial positive experiences in a relationship.", created_at:1779654022, source_id:"chunk-e5d8a73bfe09b1e5fab115705dfa0fe7<SEP>chunk-20d895bd21d3a068503f3d99fc9f225c", entity_id:"Soulmate"}}, {_id:7062, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"UNKNOWN", truncate:"", description:"Consciousness serves as the root enabling drive and willpower to thrive, much like the earth supports the tree.", created_at:1779653846, source_id:"chunk-e5d8a73bfe09b1e5fab115705dfa0fe7", entity_id:"Drive and Willpower"}}, {_id:7063, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"UNKNOWN", truncate:"", description:"Consciousness provides the grounding needed to navigate challenges and uncertainties, similar to roots sustaining a tree during storms.", created_at:1779653846, source_id:"chunk-e5d8a73bfe09b1e5fab115705dfa0fe7", entity_id:"Challenges and Uncertainties"}}, {_id:7064, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"A state of satisfaction, resulting from sustained drive and willpower in a beautiful state.", created_at:1779653849, source_id:"chunk-87ae4401ec344e0f145a40afa02041af", entity_id:"Fulfillment"}}, {_id:7065, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"UNKNOWN", truncate:"", description:"Weak will and absence of a beautiful state lead to quitting.", created_at:1779653883, source_id:"chunk-87ae4401ec344e0f145a40afa02041af", entity_id:"Weak Will"}}, {_id:7066, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"A person's chosen career or life path, discussed in the video as requiring perseverance to overcome challenges and achieve success.<SEP>A person's chosen career or life path, discussed in the video as requiring perseverance to overcome challenges and achieve success.", created_at:1779653935, source_id:"chunk-55dc4edcd2b102395a856543b6549ab5", entity_id:"Right Field"}}, {_id:7067, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"Metaphorical transformation symbolizing how initial positive experiences (heaven) can deteriorate into adversity (hell) without perseverance.<SEP>Metaphorical transformation symbolizing how initial positive experiences (heaven) can deteriorate into adversity (hell) without perseverance.", created_at:1779653935, source_id:"chunk-55dc4edcd2b102395a856543b6549ab5", entity_id:"Heaven Turning into Hell"}}, {_id:7068, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"The act of continuing despite difficulties, emphasized in the video as essential for overcoming challenges and achieving success.<SEP>The act of continuing despite difficulties, emphasized in the video as essential for overcoming challenges and achieving success.", created_at:1779653935, source_id:"chunk-55dc4edcd2b102395a856543b6549ab5", entity_id:"Perseverance"}}, {_id:7069, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", description:"Stability in decisions or structures depends on foundational elements like roots or willpower.", created_at:1779654040, source_id:"chunk-46d6abd520d390d99cea37e408f7a403", entity_id:"Stability"}}, {_id:7070, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", entity_type:"UNKNOWN", truncate:"", description:"The proposed sentence \"Ones from our minds\" is repeatedly deemed awkward, prompting multiple revision attempts in the text.", created_at:1779655070, source_id:"chunk-0e9a254b995e0c98e3ca94960e93f701", entity_id:"awkwardness"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:7071, properties:{file_path:"unknown_source<SEP>YouTube Video: Gdd-5uWUW5w (URL: https://www.youtube.com/watch?v=Gdd-5uWUW5w)", entity_type:"person", truncate:"", description:"Ukrainian citizens are civilians from Ukraine who, according to the text, hate Russian citizens and are influenced by leaders.<SEP>Ukrainian citizens are described as hating Russian citizens due to war.", created_at:1779655094, source_id:"chunk-ce9ebce1893fdadbc7506d753964c3f9<SEP>chunk-d3f41a9eb02b7a6a41e590b4f8a66d6e", entity_id:"Ukrainian Citizens"}}, {_id:7072, properties:{file_path:"unknown_source<SEP>YouTube Video: Gdd-5uWUW5w (URL: https://www.youtube.com/watch?v=Gdd-5uWUW5w)", entity_type:"person", truncate:"", description:"Russian citizens are civilians from Russia who, according to the text, hate Ukrainian citizens and are influenced by leaders.<SEP>Russian citizens are described as hating Ukrainian citizens due to war.", created_at:1779655094, source_id:"chunk-ce9ebce1893fdadbc7506d753964c3f9<SEP>chunk-d3f41a9eb02b7a6a41e590b4f8a66d6e", entity_id:"Russian Citizens"}}, {_id:7073, properties:{file_path:"unknown_source<SEP>YouTube Video: Gdd-5uWUW5w (URL: https://www.youtube.com/watch?v=Gdd-5uWUW5w)", entity_type:"person", truncate:"", description:"Russian soldiers are a group of military personnel from Russia who are involved in conflicts, often experiencing mutual hatred with Ukrainian soldiers.<SEP>Russian soldiers are mentioned as hating Ukrainian soldiers in the context of war.", created_at:1779655094, source_id:"chunk-ce9ebce1893fdadbc7506d753964c3f9<SEP>chunk-d3f41a9eb02b7a6a41e590b4f8a66d6e", entity_id:"Russian Soldiers"}}, {_id:7074, properties:{file_path:"unknown_source<SEP>YouTube Video: Gdd-5uWUW5w (URL: https://www.youtube.com/watch?v=Gdd-5uWUW5w)", entity_type:"person", truncate:"", description:"Ukrainian soldiers are a group of military personnel from Ukraine who are involved in conflicts, often experiencing mutual hatred with Russian soldiers.<SEP>Ukrainian soldiers are mentioned as hating Russian soldiers in the context of war.", created_at:1779655094, source_id:"chunk-ce9ebce1893fdadbc7506d753964c3f9<SEP>chunk-d3f41a9eb02b7a6a41e590b4f8a66d6e", entity_id:"Ukrainian Soldiers"}}, {_id:7075, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Vengeance is a concept where victims seek retaliation, perpetuating cycles of hate and conflict.", created_at:1779655079, source_id:"chunk-ce9ebce1893fdadbc7506d753964c3f9", entity_id:"Vengeance"}}, {_id:7076, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Peaceful solutions are achievable if leaders and citizens eliminate hate, conflict, and frustration.", created_at:1779655079, source_id:"chunk-ce9ebce1893fdadbc7506d753964c3f9", entity_id:"Peaceful Solutions"}}, {_id:7077, properties:{file_path:"YouTube Video: Gdd-5uWUW5w (URL: https://www.youtube.com/watch?v=Gdd-5uWUW5w)", entity_type:"concept", truncate:"", description:"Orphaned children are noted as a result of war's destruction.", created_at:1779655094, source_id:"chunk-d3f41a9eb02b7a6a41e590b4f8a66d6e", entity_id:"Orphaned Children"}}, {_id:7078, properties:{file_path:"YouTube Video: Gdd-5uWUW5w (URL: https://www.youtube.com/watch?v=Gdd-5uWUW5w)", entity_type:"concept", truncate:"", description:"War and conflict are described as a state that breeds hate and leads to various negative consequences.", created_at:1779655094, source_id:"chunk-d3f41a9eb02b7a6a41e590b4f8a66d6e", entity_id:"War and Conflict"}}, {_id:7079, properties:{file_path:"YouTube Video: Gdd-5uWUW5w (URL: https://www.youtube.com/watch?v=Gdd-5uWUW5w)", entity_type:"concept", truncate:"", description:"Widows are mentioned as a consequence of war, resulting from loss of life.", created_at:1779655094, source_id:"chunk-d3f41a9eb02b7a6a41e590b4f8a66d6e", entity_id:"Widows"}}, {_id:7080, properties:{file_path:"YouTube Video: Gdd-5uWUW5w (URL: https://www.youtube.com/watch?v=Gdd-5uWUW5w)", entity_type:"concept", truncate:"", description:"Broken homes are listed as a consequence of war's impact on families.", created_at:1779655094, source_id:"chunk-d3f41a9eb02b7a6a41e590b4f8a66d6e", entity_id:"Broken Homes"}}, {_id:7081, properties:{file_path:"YouTube Video: Gdd-5uWUW5w (URL: https://www.youtube.com/watch?v=Gdd-5uWUW5w)", entity_type:"concept", truncate:"", description:"Unemployment is cited as a negative outcome of war.", created_at:1779655094, source_id:"chunk-d3f41a9eb02b7a6a41e590b4f8a66d6e", entity_id:"Unemployment"}}, {_id:7082, properties:{file_path:"YouTube Video: Gdd-5uWUW5w (URL: https://www.youtube.com/watch?v=Gdd-5uWUW5w)", entity_type:"naturalobject", truncate:"", description:"Toxins left behind by war are noted as a harmful consequence.", created_at:1779655094, source_id:"chunk-d3f41a9eb02b7a6a41e590b4f8a66d6e", entity_id:"Toxins"}}, {_id:7083, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Body shame refers to negative self-perception and dissatisfaction with one's physical appearance, linked to mental health issues.", created_at:1779655139, source_id:"chunk-82bf38447aaaf69048a1ca14b819e43a", entity_id:"Body Shame"}}, {_id:7084, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Parental attitudes and comments significantly shape children's self-perception and body image through direct verbal interactions.", created_at:1779655140, source_id:"chunk-82bf38447aaaf69048a1ca14b819e43a", entity_id:"Parental Influence"}}, {_id:7085, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Namaste serves as a respectful closing to the dialogue on self-perception and mental health.", created_at:1779655212, source_id:"chunk-82bf38447aaaf69048a1ca14b819e43a", entity_id:"discussion conclusion"}}, {_id:7088, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"naturalobject", truncate:"", description:"Orcas are another name for killer whales, commonly used in marine biology and popular culture.<SEP>Orcas are marine mammals, referred to as \"killer whales\" in the text, with domain-specific terminology adjustments.<SEP>Orcas are another name for killer whales, characterized by their complex social structures.<SEP>Orcas are marine mammals, referred to as \"killer whales\" in the text, with domain-specific terminology adjustments.", created_at:1779656863, source_id:"chunk-5df138751f09bcc9c4d02f158a5b7e22<SEP>chunk-ba530f2475447367e3d5327e8faa29a8<SEP>chunk-f04ab7a9bf5f1c24c23dba56cff7596f<SEP>chunk-335fbb4571ba31c5e62057c887e19129", entity_id:"Orcas"}}, {_id:7089, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)<SEP>unknown_source", entity_type:"naturalobject", truncate:"", description:"Killer whales are large marine mammals recognized for their high intelligence and exceptional hunting abilities. In scientific and domain-specific contexts, they are also referred to as 'orcas.'

As a species, killer whales exhibit a distinctive life history where females outlive males by a significant margin. This extended female lifespan, which extends into the post-reproductive stage, plays a crucial role in supporting offspring and grandchildren, thereby enhancing the survival and reproductive success of the species. The longer post-reproductive life of females contributes to the overall resilience of the population.<SEP>Killer whales are a species where females live significantly longer than males to support offspring and grandchildren.<SEP>Killer whales are a species where females live longer post-reproductive age to support younger generations, aiding species survival.<SEP>Killer whales are a species where females live significantly longer than males to support offspring and grandchildren.<SEP>Killer whales are a species where females live longer post-reproductive age to support younger generations, aiding species survival.<SEP>Killer whales are marine mammals known for their intelligence and social behavior.<SEP>Killer whales are marine mammals referred to as \"orcas\" in the text, with domain-specific terminology adjustments.", created_at:1779656863, source_id:"chunk-5df138751f09bcc9c4d02f158a5b7e22<SEP>chunk-ba530f2475447367e3d5327e8faa29a8<SEP>chunk-b2b3f4e0ec4ca323c0c90b860c94bdb5<SEP>chunk-efef91f79f63a3dccc0da4a26bee1fef<SEP>chunk-f04ab7a9bf5f1c24c23dba56cff7596f", entity_id:"Killer Whales"}}, {_id:7090, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"content", truncate:"", description:"QzJ_Ft1de1o is a YouTube video (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o) discussing readability fixes and domain-specific terminology in a text about orcas.<SEP>QzJ_Ft1de1o is a YouTube video (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o) containing grammatical analysis and linguistic discussion.<SEP>QzJ_Ft1de1o is a YouTube video analyzing grammatical corrections and discussing spiritual practices, available at https://www.youtube.com/watch?v=QzJ_Ft1de1o.<SEP>QzJ_Ft1de1o is a YouTube video (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o) discussing readability fixes and domain-specific terminology in a text about orcas.", created_at:1779656863, source_id:"chunk-ba530f2475447367e3d5327e8faa29a8<SEP>chunk-cef8de5a4c7a9eb5661ebb0fdc46fa34<SEP>chunk-4f58924914d8390f9a0f22a991598555", entity_id:"QzJ_Ft1de1o"}}, {_id:7091, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"method", truncate:"", description:"Readability fixes include punctuation adjustments, grammatical corrections, and style improvements to enhance text clarity.<SEP>Readability fixes include punctuation adjustments, grammatical corrections, and style improvements to enhance text clarity.", created_at:1779656863, source_id:"chunk-ba530f2475447367e3d5327e8faa29a8", entity_id:"Readability Fixes"}}, {_id:7092, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"concept", truncate:"", description:"Male orcas is a term correction from \"male killer whales\" for consistency in the text.<SEP>Male orcas (formerly referred to as male killer whales) are a type of orca with a lifespan of up to 50 years.<SEP>Male orcas is a term correction from \"male killer whales\" for consistency in the text.", created_at:1779656863, source_id:"chunk-ba530f2475447367e3d5327e8faa29a8<SEP>chunk-335fbb4571ba31c5e62057c887e19129", entity_id:"Male Orcas"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
