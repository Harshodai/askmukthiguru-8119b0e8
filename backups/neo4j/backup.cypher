UNWIND [{_id:5078, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"person", truncate:"", created_at:1779433760, description:"Shri PR G is a person associated with prosperity and fortune in a transcendental philosophical context.<SEP>Shri PR G is a person associated with concepts of prosperity and transcendental realms, as discussed in the context of wealth manifestation.<SEP>Shri PR G is a person mentioned in the corrections, with the name capitalized as per the instructions.<SEP>Shri PR G is mentioned as a person referenced in the context of the text.<SEP>Shri PR G is mentioned in the context of prosperity and transcendental realms.", source_id:"chunk-068119dd429404d7b660b1eacf50b8a7<SEP>chunk-d25900147d2885c1a704f8d6ecab098b<SEP>chunk-5baab383769ea33393f76b07d34a78c0<SEP>chunk-ad8cd9c49a16ec95450897f747dabecf<SEP>chunk-2b2dda4f9865c4e1ca128a82cc17cc68", entity_id:"Shri PR G"}}, {_id:5079, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"UNKNOWN", truncate:"", description:"Transcendental success is connected to preserving and nurturing wealth creation as part of its conceptual framework.", created_at:1779433296, source_id:"chunk-068119dd429404d7b660b1eacf50b8a7", entity_id:"Wealth Preservation"}}, {_id:5080, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)<SEP>unknown_source<SEP>YouTube Video: pmSPHJfg3AU (URL: https://www.youtube.com/watch?v=pmSPHJfg3AU)<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"location", truncate:"", description:"Hyderabad is a city in India referenced as Ramya's origin.<SEP>Hyderabad is the city where Ramya resides.<SEP>Hyderabad is the city where Ramya is from and where she shares her experiences.<SEP>Hyderabad is a city in India, home to Arna.<SEP>Hyderabad is the location associated with Arna.<SEP>A city referenced as an example location where universal physical laws apply.", created_at:1779563465, source_id:"chunk-d25900147d2885c1a704f8d6ecab098b<SEP>chunk-05876490ec07e753e9e70eaf93dbcac0<SEP>chunk-2b2dda4f9865c4e1ca128a82cc17cc68<SEP>chunk-9631a67f046d45e3e2ba8f3d8b8dfbfd<SEP>chunk-26b56a81ecc68984178f2485406fb618<SEP>chunk-088b2986c8580178cc7f54a0f65ceaa7", entity_id:"Hyderabad"}}, {_id:5081, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"person", truncate:"", created_at:1779433760, description:"Ramya is a person from Hyderabad mentioned in the sixth paragraph of the text.<SEP>Ramya is a person from Hyderabad sharing her experiences in the Soul Circle and discussing her son and spiritual journey.<SEP>Ramya is a speaker from Hyderabad who shares personal experiences and insights on transcendental concepts and spiritual liberation.", source_id:"chunk-d25900147d2885c1a704f8d6ecab098b<SEP>chunk-05876490ec07e753e9e70eaf93dbcac0<SEP>chunk-2b2dda4f9865c4e1ca128a82cc17cc68", entity_id:"Ramya"}}, {_id:5082, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"concept", truncate:"", description:"The transcendental realm is a higher plane of existence where prosperity concepts originate before physical manifestation.", created_at:1779433322, source_id:"chunk-d25900147d2885c1a704f8d6ecab098b", entity_id:"Transcendental Realm"}}, {_id:5083, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=PslFhdZaBFA)", entity_type:"concept", truncate:"", created_at:1779665564, description:"The Soul Circle is a group or concept influencing Ramya's life, where members' emotional states impact her daily experiences.<SEP>Soul Circle refers to a group of close individuals with whom one shares a deep connection.<SEP>A soul circle refers to a group of individuals closely connected to one?s life, with whom one shares profound spiritual or emotional bonds.", source_id:"chunk-161257a3b15bcafcf939769dfff5e967<SEP>chunk-05876490ec07e753e9e70eaf93dbcac0<SEP>chunk-40152a1fb18e76edc2c33e41cc81ed43<SEP>chunk-112f236855c8c9ac7864c1e2a1d43d1a", entity_id:"Soul Circle"}}, {_id:5084, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"location", truncate:"", created_at:1779433791, description:"Dasha represents a spiritual or conceptual space where Ramya experienced liberation from samsara.<SEP>Dasha is mentioned as a period where Ramya experienced liberation.<SEP>Dasha is a location referenced in the context of liberation from samsara.", source_id:"chunk-05876490ec07e753e9e70eaf93dbcac0<SEP>chunk-2b2dda4f9865c4e1ca128a82cc17cc68<SEP>chunk-3a0add62a70895b5ac3db1f7977a8549", entity_id:"Dasha"}}, {_id:5087, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"concept", truncate:"", description:"Energy currents are described as flowing through life and influencing it under Consciousness.", created_at:1779433655, source_id:"chunk-ad8cd9c49a16ec95450897f747dabecf", entity_id:"Energy Currents"}}, {_id:5088, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"concept", truncate:"", description:"Samsaras are cyclical patterns of existence tied to Consciousness and human experience.", created_at:1779433655, source_id:"chunk-ad8cd9c49a16ec95450897f747dabecf", entity_id:"Samsaras"}}, {_id:5089, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"event", truncate:"", description:"Soul Circle Day is an event mentioned in Ramya's personal experience.", created_at:1779433760, source_id:"chunk-2b2dda4f9865c4e1ca128a82cc17cc68", entity_id:"Soul Circle Day"}}, {_id:5093, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"concept", truncate:"", description:"Transcendental protection is a concept discussed in the video, linked to prosperity and physical manifestations.", created_at:1779433760, source_id:"chunk-2b2dda4f9865c4e1ca128a82cc17cc68", entity_id:"Transcendental Protection"}}, {_id:5094, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"concept", truncate:"", description:"The cycle of good fortune describes the family's improved circumstances after the Abundance Festival.", created_at:1779433791, source_id:"chunk-3a0add62a70895b5ac3db1f7977a8549", entity_id:"cycle of good fortune"}}, {_id:5095, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"organization", truncate:"", description:"The interior designing firm is a business run by the speaker and Rishi, which remained stable during COVID.", created_at:1779433791, source_id:"chunk-3a0add62a70895b5ac3db1f7977a8549", entity_id:"interior designing firm"}}, {_id:5096, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"concept", truncate:"", description:"The cycle of misfortune refers to the family's previous struggles before a transformative change.", created_at:1779433791, source_id:"chunk-3a0add62a70895b5ac3db1f7977a8549", entity_id:"cycle of misfortune"}}, {_id:5100, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"concept", truncate:"", description:"Money pouring in describes the financial success of the firm during the pandemic.", created_at:1779433792, source_id:"chunk-3a0add62a70895b5ac3db1f7977a8549", entity_id:"money pouring in"}}, {_id:5101, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"UNKNOWN", truncate:"", description:"The speaker attended the Abundance Festival, which marked a shift in their family's fortune.", created_at:1779433850, source_id:"chunk-3a0add62a70895b5ac3db1f7977a8549", entity_id:"speaker"}}, {_id:5102, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"person", truncate:"", description:"Sri MTI Guru is a spiritual leader mentioned in the context of gratitude for business growth.", created_at:1779433874, source_id:"chunk-a8830e719ab8be4a9944bce2ee0a988b", entity_id:"Sri MTI Guru"}}, {_id:5103, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"person", truncate:"", description:"Sri Krishna J PR is a spiritual leader mentioned in the context of gratitude for business growth.", created_at:1779433874, source_id:"chunk-a8830e719ab8be4a9944bce2ee0a988b", entity_id:"Sri Krishna J PR"}}, {_id:5104, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"concept", truncate:"", description:"Business Growth refers to the 400% increase in the speaker's business, resulting from the Satsang.", created_at:1779433874, source_id:"chunk-a8830e719ab8be4a9944bce2ee0a988b", entity_id:"Business Growth"}}, {_id:5105, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The relationship between the narrator and their daughter is mentioned in the text.", created_at:1779434931, source_id:"chunk-f75a0e9daa5e637539a5dd564ff6b877", entity_id:"Father-Daughter Relationship"}}] AS row
