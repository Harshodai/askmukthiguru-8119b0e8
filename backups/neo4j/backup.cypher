UNWIND [{start: {_id:89}, end: {_id:3634}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"metaphor,self-harm", truncate:"", weight:1.0, description:"Anger is compared to crude oil as an ineffective and damaging fuel that harms the user first.", created_at:1779558095, source_id:"chunk-a9818a0388e6c7fbe12a262f4b70178a"}}, {start: {_id:89}, end: {_id:333}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"conflict,loss", weight:1.0, description:"Anger leads to the loss of loved ones or distancing due to provocative behavior.", created_at:1779558095, source_id:"chunk-a9818a0388e6c7fbe12a262f4b70178a"}}, {start: {_id:89}, end: {_id:6320}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"contrast,positive alternative", weight:1.0, description:"Anger is contrasted with positive emotions (aviation gasoline) as a superior fuel for personal growth.", created_at:1779558095, source_id:"chunk-a9818a0388e6c7fbe12a262f4b70178a"}}, {start: {_id:89}, end: {_id:6319}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"self-destruction,transformation", weight:1.0, description:"Anger transforms individuals into intolerant, impatient beings who provoke conflict.", created_at:1779558095, source_id:"chunk-a9818a0388e6c7fbe12a262f4b70178a"}}, {start: {_id:89}, end: {_id:755}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"conflict,obstruction", truncate:"", weight:1.0, description:"Anger prevents peace and resolution, perpetuating cycles of conflict.", created_at:1779558095, source_id:"chunk-a9818a0388e6c7fbe12a262f4b70178a"}}, {start: {_id:89}, end: {_id:6321}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"lack of clarity,obstruction", weight:1.0, description:"Anger obstructs self-awareness and realization, keeping individuals from growth.", created_at:1779558095, source_id:"chunk-a9818a0388e6c7fbe12a262f4b70178a"}}, {start: {_id:89}, end: {_id:6322}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"contrast,intensity", truncate:"", weight:1.0, description:"Anger is characterized by the contrast between crude (raw) and sophisticated (refined) expressions of anger.", created_at:1779558096, source_id:"chunk-a9818a0388e6c7fbe12a262f4b70178a"}}, {start: {_id:89}, end: {_id:6323}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"contrast,manifestation", truncate:"", weight:1.0, description:"Anger manifests as either expressive (openly displayed) or suppressive (internally restrained), highlighting its dual nature.", created_at:1779558096, source_id:"chunk-a9818a0388e6c7fbe12a262f4b70178a"}}, {start: {_id:115}, end: {_id:6324}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"emotional liberation,transformation", weight:1.0, description:"Releasing anger enables freedom and the capacity for happiness and renewed love.", created_at:1779558158, source_id:"chunk-04a5cce20e9ca029b1d885a9ee7c4ec6"}}, {start: {_id:301}, end: {_id:6324}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"emotional well-being,positive outcome", weight:1.0, description:"Letting go of anger is directly linked to achieving happiness and emotional freedom.", created_at:1779558158, source_id:"chunk-04a5cce20e9ca029b1d885a9ee7c4ec6"}}, {start: {_id:6324}, end: {_id:6326}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"cessation,emotional liberation", weight:1.0, description:"Releasing anger stops self-harm and breaks the cycle of self-inflicted pain.", created_at:1779558158, source_id:"chunk-04a5cce20e9ca029b1d885a9ee7c4ec6"}}, {start: {_id:3697}, end: {_id:6324}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"behavioral shift,resolution", weight:1.0, description:"Letting go of anger eliminates the need to blame others, fostering self-awareness.", created_at:1779558158, source_id:"chunk-04a5cce20e9ca029b1d885a9ee7c4ec6"}}, {start: {_id:6327}, end: {_id:6280}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"anger management,self-awareness", weight:1.0, description:"Syrian mind meditation is taught as a method to achieve freedom from anger by addressing angry thoughts and fostering self-awareness.", created_at:1779558180, source_id:"chunk-10353e11213908c6dce7cb7f38908ef1"}}, {start: {_id:89}, end: {_id:6325}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"metaphor,self-harm", truncate:"", weight:1.0, description:"Anger is compared to a monkey's mind clinging to dessert, illustrating how anger traps individuals in self-destructive patterns.", created_at:1779558180, source_id:"chunk-04a5cce20e9ca029b1d885a9ee7c4ec6"}}, {start: {_id:1479}, end: {_id:89}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"enemy concept,philosophical teaching", weight:1.0, description:"The ancients identified anger as humanity's greatest enemy and most difficult adversary to overcome.", created_at:1779558181, source_id:"chunk-04a5cce20e9ca029b1d885a9ee7c4ec6"}}, {start: {_id:6280}, end: {_id:348}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"anger management,educational content", weight:1.0, description:"The YouTube Video contains content about Syrian mind meditation as a practice for overcoming anger.", created_at:1779558181, source_id:"chunk-10353e11213908c6dce7cb7f38908ef1"}}, {start: {_id:6328}, end: {_id:6280}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"anger management,anger reduction,mental health,neural disruption", weight:2.0, description:"Syrian mind meditation is taught to break anger circuits in the brain, disrupting anger-related neural patterns.<SEP>Syrian mind meditation is designed to break anger circuits in the brain, alleviating emotional distress.", created_at:1779558218, source_id:"chunk-10353e11213908c6dce7cb7f38908ef1<SEP>chunk-9dcd575f5f6aeb9b5b2721f919d303c4"}}, {start: {_id:89}, end: {_id:6326}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"consequences,self-destructive behavior", weight:1.0, description:"Anger leads to self-harm through persistent resentment and refusal to release emotional burdens.", created_at:1779558181, source_id:"chunk-04a5cce20e9ca029b1d885a9ee7c4ec6"}}, {start: {_id:1351}, end: {_id:6280}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"emotional regulation,self-reflection", weight:1.0, description:"The practice emphasizes self-awareness to recognize and address angry thoughts, fostering emotional regulation.", created_at:1779558181, source_id:"chunk-10353e11213908c6dce7cb7f38908ef1"}}, {start: {_id:89}, end: {_id:1351}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"awareness,emotional recognition", weight:1.0, description:"The text states that self-awareness reveals anger's role in suffering, connecting anger to the need for inner truth recognition.", created_at:1779558182, source_id:"chunk-10353e11213908c6dce7cb7f38908ef1"}}] AS row
