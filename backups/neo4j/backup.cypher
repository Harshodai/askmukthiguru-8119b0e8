UNWIND [{start: {_id:413}, end: {_id:338}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"fear of vulnerability,relational barriers", weight:1.0, description:"The wounded child hinders trust to protect against perceived emotional threats.", created_at:1779137586, source_id:"chunk-c0e08ca8392db0f9984988041685087e"}}, {start: {_id:377}, end: {_id:415}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"conceptual framework,psychological duality", weight:1.0, description:"The Wounded Child State is central to understanding the dual aspects described in the concept.", created_at:1779137605, source_id:"chunk-749e889c128e710cc18adc38c4d377cb"}}, {start: {_id:417}, end: {_id:416}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"childhood experience,personal history", weight:1.0, description:"Jaya endured an abusive and impoverished childhood with her mother.", created_at:1779137605, source_id:"chunk-749e889c128e710cc18adc38c4d377cb"}}, {start: {_id:417}, end: {_id:377}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", truncate:"", keywords:"emotional disconnect,emotional response,isolation,psychological impact", weight:2.0, description:"Jaya's experiences led to a wounded child state influencing her self-perception.<SEP>Jaya?s inability to connect stems from a wounded child state manifesting as insensitivity and disconnection in relationships.", created_at:1779179147, source_id:"chunk-749e889c128e710cc18adc38c4d377cb<SEP>chunk-25634a7e16db511e9e5b4a8597da99fd"}}, {start: {_id:418}, end: {_id:416}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"abusive environment,family dynamics", truncate:"", weight:1.0, description:"Jaya's mother's abusive behavior and alcoholism created a traumatic childhood for Jaya.", created_at:1779137605, source_id:"chunk-749e889c128e710cc18adc38c4d377cb"}}, {start: {_id:417}, end: {_id:414}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"caregiver role,familial responsibility", weight:1.0, description:"Jaya acted as a caregiver and protector for her younger siblings during her childhood.", created_at:1779137605, source_id:"chunk-749e889c128e710cc18adc38c4d377cb"}}, {start: {_id:417}, end: {_id:422}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"familial responsibility,savior role", truncate:"", weight:1.0, description:"Jaya acted as a savior to her two younger siblings, motivating her to escape her abusive home.", created_at:1779137627, source_id:"chunk-0e0d8ce525e6e00265646821c7a82b74"}}, {start: {_id:423}, end: {_id:417}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"retreat location,transformation", truncate:"", weight:1.0, description:"Jaya's meditative journey at the Academy Retreat triggered her realization about her unresolved childhood trauma.", created_at:1779137627, source_id:"chunk-0e0d8ce525e6e00265646821c7a82b74"}}, {start: {_id:421}, end: {_id:417}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"empowerment,trauma reinterpretation", truncate:"", weight:1.0, description:"Jaya initially glorified her childhood trauma as purposeful but later acknowledged it as unresolved pain.", created_at:1779137627, source_id:"chunk-0e0d8ce525e6e00265646821c7a82b74"}}, {start: {_id:420}, end: {_id:417}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"psychological coping,self-deception", truncate:"", weight:1.0, description:"Jaya used empowerment narratives to manage bitterness but never truly freed herself from her past.", created_at:1779137627, source_id:"chunk-0e0d8ce525e6e00265646821c7a82b74"}}, {start: {_id:417}, end: {_id:419}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"identity facade,self-realization", truncate:"", weight:1.0, description:"Jaya's \"independent woman\" persona was revealed as a mask hiding unresolved dependency needs.", created_at:1779137627, source_id:"chunk-0e0d8ce525e6e00265646821c7a82b74"}}, {start: {_id:89}, end: {_id:417}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"driving force,emotional driver,motivation", truncate:"", weight:3.0, created_at:1779183782, description:"Jaya?s anger fuels her actions, including her need to prove herself and rejection of emotional vulnerability.<SEP>Anger drives Jaya's pursuit of success and reactions to perceived injustices.<SEP>Jaya's anger drove her to prove herself and mask vulnerability, fueling her career ambitions.", source_id:"chunk-abf598569eb5f03bc21c09bf7af4abf7<SEP>chunk-697da9f4d9cac1cfedd243857a8b8ccc<SEP>chunk-da0dcd44b642ae88bb5ae6bfa953a323"}}, {start: {_id:417}, end: {_id:426}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"psychological conflict,rebellion", truncate:"", weight:1.0, description:"Jaya?s efforts to rise to power are driven by opposition to her mother?s influence and the need to validate her own perspective.", created_at:1779137648, source_id:"chunk-abf598569eb5f03bc21c09bf7af4abf7"}}, {start: {_id:417}, end: {_id:424}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"obsession,psychological impact", truncate:"", weight:1.0, description:"Jaya?s fixation on revisiting the past perpetuates her emotional struggles and prevents closure.", created_at:1779137648, source_id:"chunk-abf598569eb5f03bc21c09bf7af4abf7"}}, {start: {_id:425}, end: {_id:417}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"defense mechanism,self-perception", truncate:"", weight:1.0, description:"Jaya?s constructed image masks her true vulnerability and longing for connection.", created_at:1779137648, source_id:"chunk-abf598569eb5f03bc21c09bf7af4abf7"}}, {start: {_id:417}, end: {_id:338}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"emotional state,identity,internal conflict,psychological state,self-awareness,trauma", truncate:"", weight:3.0, created_at:1779183782, description:"Jaya?s core identity remains tied to childhood pain, undermining her outward persona of invincibility.<SEP>Jaya's Wounded Child state influences her behavior and emotional responses.<SEP>Jaya's Wounded Child state manifests in moments of disappointment, reflecting unresolved childhood pain.", source_id:"chunk-abf598569eb5f03bc21c09bf7af4abf7<SEP>chunk-697da9f4d9cac1cfedd243857a8b8ccc<SEP>chunk-da0dcd44b642ae88bb5ae6bfa953a323"}}, {start: {_id:428}, end: {_id:417}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"contradiction,emotional state", truncate:"", weight:1.0, description:"Jaya helps others through charitable efforts but continues to feel that nobody cares for her, creating an internal contradiction.", created_at:1779137648, source_id:"chunk-abf598569eb5f03bc21c09bf7af4abf7"}}, {start: {_id:417}, end: {_id:429}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional drive,motivation", truncate:"", weight:1.0, description:"Jaya?s rage against life persists despite her charitable efforts, driving her actions and emotional struggles.", created_at:1779137648, source_id:"chunk-abf598569eb5f03bc21c09bf7af4abf7"}}, {start: {_id:417}, end: {_id:435}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conditional love,parental discipline", truncate:"", weight:1.0, description:"Jaya disciplines and supports her children's education/career but struggles to connect emotionally.", created_at:1779137692, source_id:"chunk-c0eee090a2741e82903b80d77573da86"}}, {start: {_id:417}, end: {_id:433}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"authority issues,workplace conflict", truncate:"", weight:1.0, description:"Jaya's inability to respect employees leads to frequent resignations.", created_at:1779137692, source_id:"chunk-c0eee090a2741e82903b80d77573da86"}}] AS row
