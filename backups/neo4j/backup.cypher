UNWIND [{_id:2871, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"concept", truncate:"", description:"No. Ekam is described as a space of divine power with healing properties for hearts and addictions.", created_at:1779225502, source_id:"chunk-fe2346fa14faa0c7de81fae68776a0fd", entity_id:"No. Ekam"}}, {_id:2872, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"event", truncate:"", description:"An annual festival where the father and son undergo spiritual transformation, marked by divine intervention and emotional reconciliation.", created_at:1779225543, source_id:"chunk-eae1f6658ba1fd4f52f2452752071fc4", entity_id:"Festival in Ekam"}}, {_id:2873, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A state of peace and acceptance of oneself and life, transcending judgment.", created_at:1779184195, source_id:"chunk-66f6c16a0cd4b4ef4b399e98335000b4", entity_id:"Calm Consciousness"}}, {_id:2874, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)<SEP>unknown_source<SEP>YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)<SEP>YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)<SEP>YouTube Video: k8iO5daXllM (URL: https://www.youtube.com/watch?v=k8iO5daXllM)", entity_type:"concept", truncate:"", description:"Employment opportunity considered by the son after his spiritual awakening, symbolizing hope and stability.<SEP>Job represents a human activity analyzed through the lens of existential purpose and societal expectations.<SEP>Employment or work that provides sustenance and purpose.<SEP>Employment role perceived as thankless and monotonous, prompting existential reflection.<SEP>Job is a source of income and identity, and its loss can lead to anxiety.<SEP>Employment or occupation providing income, central to financial stability and self-worth in the context described.<SEP>Employment or occupation providing income, central to financial stability and self-worth in the context described.", created_at:1779663717, source_id:"chunk-eae1f6658ba1fd4f52f2452752071fc4<SEP>chunk-075b8e71a3c71d11c785be4bbfe965ed<SEP>chunk-a9f29aa70d2aed842238204adf8a81c5<SEP>chunk-795d6a47694e346b9ff7bde9c51e23ec<SEP>chunk-33160338b40b6e5d5350d51dafa984b5<SEP>chunk-0fd54b20f9240836a740d21443f8c6ce", entity_id:"Job"}}, {_id:2875, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A manifestation of universal intelligence experienced as great power during the practice.", created_at:1779184283, source_id:"chunk-0f072682ae3f44593523bf73ac3ea68d", entity_id:"Great Power"}}, {_id:2876, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A manifestation of universal intelligence experienced as great peace during the practice.", created_at:1779184283, source_id:"chunk-0f072682ae3f44593523bf73ac3ea68d", entity_id:"Great Peace"}}, {_id:2877, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A manifestation of universal intelligence experienced as great love during the practice.", created_at:1779184283, source_id:"chunk-0f072682ae3f44593523bf73ac3ea68d", entity_id:"Great Love"}}, {_id:2878, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The innermost longing or wish that individuals seek to fulfill through the practice.", created_at:1779184283, source_id:"chunk-0f072682ae3f44593523bf73ac3ea68d", entity_id:"Deepest Desire"}}, {_id:2879, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"The Doctor is a British physician who experienced a miraculous recovery from cancer after overcoming fear through universal intelligence connection.", created_at:1779184283, source_id:"chunk-a8aa437c4036f2bcb15546966bd2e573", entity_id:"The Doctor"}}, {_id:2880, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"The Man from France is a vice president who found peace and career success in India after connecting with universal intelligence.", created_at:1779184283, source_id:"chunk-a8aa437c4036f2bcb15546966bd2e573", entity_id:"Man from France"}}, {_id:2881, properties:{file_path:"unknown_source", entity_type:"content", truncate:"", description:"The Four Sacred Secrets.pdf is a document containing teachings about universal intelligence and human experiences.", created_at:1779184284, source_id:"chunk-a8aa437c4036f2bcb15546966bd2e573", entity_id:"Four Sacred Secrets.pdf"}}, {_id:2882, properties:{file_path:"unknown_source", entity_type:"location", truncate:"", description:"The Town Hall is the location where the Lizard resides and where the roof collapse fear originated.", created_at:1779184284, source_id:"chunk-a8aa437c4036f2bcb15546966bd2e573", entity_id:"Town Hall"}}, {_id:2884, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The Green Energy Opportunity in France represents a career breakthrough achieved through connecting with universal intelligence.", created_at:1779184284, source_id:"chunk-a8aa437c4036f2bcb15546966bd2e573", entity_id:"Green Energy Opportunity"}}, {_id:2885, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The game symbolizes avoidance of accountability in choices.", created_at:1779184335, source_id:"chunk-035b6c44730bb7cdf05bfef04ef27b03", entity_id:"Indecisive Decisions"}}, {_id:2886, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"concept", truncate:"", description:"De-addiction is a clinical term for addiction treatment, which conflicts with the spiritual context of the platform discussed in the text.<SEP>A clinical term mistakenly used in the spiritual context, identified as a transcription or contextual error.", created_at:1779225846, source_id:"chunk-1cce98cd0aed40f77c27d3d6b1cb14b9<SEP>chunk-59c75858fc62071381380d482998c935", entity_id:"De-addiction"}}, {_id:2887, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Sustaining states of suffering are described as disconnecting individuals from universal intelligence and from each other, contrasting with the beautiful state that allows drawing blessings from the source.<SEP>Sustaining states of suffering are described as disconnecting individuals from universal intelligence and from each other, contrasting with the beautiful state that allows drawing blessings from the source.", created_at:1779185993, source_id:"chunk-d46158568d6d67d2d4fe51b282a138b1", entity_id:"Sustaining States"}}, {_id:2888, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Cultural expressions throughout history are paralleled with humanity's relationship with universal consciousness, suggesting a universal human experience of transcendence.<SEP>The text draws parallels between humanity's relationship with universal consciousness and cultural expressions of transcendence.<SEP>Cultural expressions throughout history are paralleled with humanity's relationship with universal consciousness, suggesting a universal human experience of transcendence.<SEP>The text draws parallels between humanity's relationship with universal consciousness and cultural expressions of transcendence.", created_at:1779185993, source_id:"chunk-d46158568d6d67d2d4fe51b282a138b1<SEP>chunk-5e714c1a6ea0e14019d2ce93ffec1a74", entity_id:"Cultural Expressions"}}, {_id:2889, properties:{file_path:"unknown_source", entity_type:"naturalobject", truncate:"", description:"The spinal cord is a body part mentioned as a source of intelligence that can alleviate disconnection.<SEP>The spinal cord is a body part mentioned as a source of intelligence that can alleviate disconnection.", created_at:1779185994, source_id:"chunk-5e714c1a6ea0e14019d2ce93ffec1a74", entity_id:"Spinal Cord"}}, {_id:2890, properties:{file_path:"unknown_source", entity_type:"content", truncate:"", description:"The book titled \"The Third Life Journey: Beco me a Heartful Partner\" is discussed in the text.<SEP>The book titled \"The Third Life Journey: Beco me a Heartful Partner\" is discussed in the text.", created_at:1779185994, source_id:"chunk-5e714c1a6ea0e14019d2ce93ffec1a74<SEP>chunk-fd3430fc74e8c69c17bfda413095345b", entity_id:"The Third Life Journey: Beco me a Heartful Partner"}}, {_id:2891, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"The text discusses the concept of finding the right life partners through love and connection.<SEP>The text discusses the concept of finding the right life partners through love and connection.<SEP>Life partner is mentioned as a source of connection and motivation.", created_at:1779653409, source_id:"chunk-5e714c1a6ea0e14019d2ce93ffec1a74<SEP>chunk-f911f447e8921c9205ec53996cfbe423", entity_id:"Life Partner"}}] AS row
