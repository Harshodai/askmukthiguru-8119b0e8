UNWIND [{start: {_id:533}, end: {_id:289}, properties:{file_path:"unknown_source", truncate:"", keywords:"behavioral outcome,negative consequence", weight:1.0, description:"Without the \"beautiful state,\" compassion leads to frustration and negative reactions toward the beggar.", created_at:1779721203, source_id:"chunk-56e6dfdbd728360a59cb27db0201ee18"}}, {start: {_id:7972}, end: {_id:6376}, properties:{file_path:"unknown_source", keywords:"compassion example,recipient", truncate:"", weight:1.0, description:"Giving to the beggar serves as the primary example of compassion in the text.", created_at:1779721203, source_id:"chunk-56e6dfdbd728360a59cb27db0201ee18"}}, {start: {_id:1620}, end: {_id:1966}, properties:{file_path:"unknown_source", keywords:"focus area,task", truncate:"", weight:1.0, description:"Text Correction Expert is responsible for correcting homophones and misheard words as part of their task.", created_at:1779721204, source_id:"chunk-a8de9d54e57d76758c3eb9ce7b788164"}}, {start: {_id:1620}, end: {_id:1968}, properties:{file_path:"unknown_source", keywords:"focus area,task", truncate:"", weight:1.0, description:"Text Correction Expert is responsible for correcting punctuation and capitalization.", created_at:1779721205, source_id:"chunk-a8de9d54e57d76758c3eb9ce7b788164"}}, {start: {_id:1620}, end: {_id:7657}, properties:{file_path:"unknown_source", keywords:"adherence,constraint", truncate:"", weight:1.0, description:"Text Correction Expert must adhere to the specified constraints during correction.", created_at:1779721205, source_id:"chunk-a8de9d54e57d76758c3eb9ce7b788164"}}, {start: {_id:3254}, end: {_id:7976}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-pBQ6Sy444o)", keywords:"collaboration,peace", truncate:"", weight:2.0, description:"America has contributed to peace through the UN since the Second World War.<SEP>America has contributed to peace through the UN since the Second World War.", created_at:1779721421, source_id:"chunk-6f44feb0c73b510c94a19d581648544c"}}, {start: {_id:3254}, end: {_id:7977}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-pBQ6Sy444o)<SEP>unknown_source", truncate:"", keywords:"contradiction,contribution,environmental activism,sustainability", weight:3.0, description:"America birthed and advanced the environment movement but remains a major polluter.<SEP>America played a key role in the emergence and advancement of global environmental movements.<SEP>America birthed and advanced the environment movement but remains a major polluter.", created_at:1779721421, source_id:"chunk-6f44feb0c73b510c94a19d581648544c<SEP>chunk-be58ce08f202f47f60f3c79e064a2364"}}, {start: {_id:3254}, end: {_id:7978}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-pBQ6Sy444o)", keywords:"leadership,responsibility", truncate:"", weight:2.0, description:"America?s leadership choices are critical to addressing the precarious future of Earth.<SEP>America?s leadership choices are critical to addressing the precarious future of Earth.", created_at:1779721421, source_id:"chunk-6f44feb0c73b510c94a19d581648544c"}}, {start: {_id:3254}, end: {_id:4745}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-pBQ6Sy444o)<SEP>unknown_source", truncate:"", keywords:"globalism,governance,leadership selection,nationalism", weight:3.0, description:"America needs a leader with a global outlook, not limited to national or international interests.<SEP>America requires a leader with a global outlook to make wise choices for Earth's future.<SEP>America needs a leader with a global outlook, not limited to national or international interests.", created_at:1779721421, source_id:"chunk-6f44feb0c73b510c94a19d581648544c<SEP>chunk-be58ce08f202f47f60f3c79e064a2364"}}, {start: {_id:3254}, end: {_id:5836}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-pBQ6Sy444o)<SEP>unknown_source", truncate:"", keywords:"global influence,influence,responsibility,societal impact", weight:3.0, description:"America?s actions impact all living beings, emphasizing the need for beneficial leadership.<SEP>America's choices directly affect all living beings through its global influence.<SEP>America?s actions impact all living beings, emphasizing the need for beneficial leadership.", created_at:1779721422, source_id:"chunk-6f44feb0c73b510c94a19d581648544c<SEP>chunk-be58ce08f202f47f60f3c79e064a2364"}}, {start: {_id:3254}, end: {_id:7979}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-pBQ6Sy444o)", truncate:"", keywords:"internal conflict,societal duality", weight:2.0, description:"America exhibits a duality between its ideals of freedom and its darker aspects of intolerance and prejudice.<SEP>America exhibits a duality between its ideals of freedom and its darker aspects of intolerance and prejudice.", created_at:1779721422, source_id:"chunk-6f44feb0c73b510c94a19d581648544c"}}, {start: {_id:3254}, end: {_id:7981}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-pBQ6Sy444o)", truncate:"", keywords:"cultural values,societal identity", weight:2.0, description:"America is associated with promoting freedom, openness, and non-judgment of different lifestyles and cultures.<SEP>America is associated with promoting freedom, openness, and non-judgment of different lifestyles and cultures.", created_at:1779721422, source_id:"chunk-6f44feb0c73b510c94a19d581648544c"}}, {start: {_id:1071}, end: {_id:4745}, properties:{file_path:"unknown_source", truncate:"", keywords:"environmental stewardship,global responsibility", weight:1.0, description:"The leader must prioritize Earth's well-being over national interests, addressing planetary challenges.", created_at:1779721388, source_id:"chunk-be58ce08f202f47f60f3c79e064a2364"}}, {start: {_id:3254}, end: {_id:7982}, properties:{file_path:"unknown_source", keywords:"cooperation,peace", truncate:"", weight:1.0, description:"America has contributed significantly to global peace efforts through the UN since World War II.", created_at:1779721418, source_id:"chunk-be58ce08f202f47f60f3c79e064a2364"}}, {start: {_id:3254}, end: {_id:7983}, properties:{file_path:"unknown_source", keywords:"environmental harm,pollution", truncate:"", weight:1.0, description:"America is identified as one of Earth's greatest polluters due to industrial and societal activities.", created_at:1779721419, source_id:"chunk-be58ce08f202f47f60f3c79e064a2364"}}, {start: {_id:3254}, end: {_id:7984}, properties:{file_path:"unknown_source", keywords:"freedom,non-judgment,openness", truncate:"", weight:1.0, description:"America is associated with ideals of cultural acceptance and open-mindedness.", created_at:1779721419, source_id:"chunk-be58ce08f202f47f60f3c79e064a2364"}}, {start: {_id:3254}, end: {_id:7986}, properties:{file_path:"unknown_source", keywords:"insecurity,intolerance,prejudice", truncate:"", weight:1.0, description:"America's society exhibits conflicting values including intolerance toward differences.", created_at:1779721419, source_id:"chunk-be58ce08f202f47f60f3c79e064a2364"}}, {start: {_id:3254}, end: {_id:7985}, properties:{file_path:"unknown_source", keywords:"cultural influence,innovation", truncate:"", weight:1.0, description:"America has historically set global trends in culture and ideology for over a century.", created_at:1779721419, source_id:"chunk-be58ce08f202f47f60f3c79e064a2364"}}, {start: {_id:1638}, end: {_id:7990}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=FP5O9F9JiOk)", truncate:"", keywords:"content inclusion,spiritual theme", weight:1.0, description:"The video contains the statement about awakening and karma clearance.", created_at:1779722159, source_id:"chunk-50619ac266270eee683f2f92df3d75e3"}}, {start: {_id:7991}, end: {_id:1638}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=FP5O9F9JiOk)", truncate:"", keywords:"content inclusion,patriotic theme", weight:1.0, description:"The video includes the invocation for America's ethical alignment.", created_at:1779722160, source_id:"chunk-50619ac266270eee683f2f92df3d75e3"}}] AS row
