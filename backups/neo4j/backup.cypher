outube.com/watch?v=5Tdb7hBwX88)", keywords:"correctness,divine matrix,guidance,impacting,spiritual collaboration,verification", truncate:"", weight:3.0, created_at:1779734108, description:"The Limitless Field impacts Sri Preethaji, who uses it to guide individuals and dissolve negative thoughts.<SEP>Sri Preethaji is associated with the Limitless Field as a spiritual collaborator.<SEP>Sri Preethaji and Limitless Field are both concepts verified as correct despite possible misheard versions.", source_id:"chunk-9ec14937b8902b88b2d052765d91f9c8<SEP>chunk-7a5e3663de47874378de2e99b5670753<SEP>chunk-193c5fa66362388f7a23833d6a925623"}}, {start: {_id:3796}, end: {name:"Sri Preethaji"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)", truncate:"", keywords:"domain-specific terms,reference list", weight:1.0, description:"Sri Preethaji is included in the domain-specific terms list.", created_at:1779241219, source_id:"chunk-4aa2186804f084108c45c41993118d21"}}, {start: {_id:3796}, end: {name:"Sri Krishnaji"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)", truncate:"", keywords:"domain-specific terms,reference list", weight:1.0, description:"Sri Krishnaji is included in the domain-specific terms list.", created_at:1779241219, source_id:"chunk-4aa2186804f084108c45c41993118d21"}}, {start: {_id:1791}, end: {name:"Sri Krishnaji"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", keywords:"content,correction", truncate:"", weight:3.0, description:"Sri Krishnaji's name is corrected in the corrected text.", created_at:1779242394, source_id:"chunk-b72bbb5cf0b255f790de83b4c2787c2c"}}, {start: {_id:1787}, end: {name:"Sri Preethaji"}, properties:{file_path:"unknown_source", truncate:"", keywords:"correction example,domain term,misheard term", weight:2.0, description:"Homophones and misheard words include the misheard term \"Sri Preethaji\" which needs correction.<SEP>The correction of \"Sri Preethaji\" is an example of fixing a misheard word.", created_at:1779393636, source_id:"chunk-d66cf68ce9f6d614d8c2ffeac6619b27"}}, {start: {_id:1787}, end: {name:"Sri Krishnaji"}, properties:{file_path:"unknown_source", keywords:"correction example,misheard term", truncate:"", weight:1.0, description:"Homophones and misheard words include the misheard term \"Sri Krishnaji\" which needs correction.", created_at:1779393636, source_id:"chunk-d66cf68ce9f6d614d8c2ffeac6619b27"}}, {start: {_id:1594}, end: {name:"Sri Preethaji"}, properties:{file_path:"YouTube Video: stUPu1-W4bE (URL: https://www.youtube.com/watch?v=stUPu1-W4bE)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=5Tdb7hBwX88)", truncate:"", keywords:"correctness,spiritual association,spiritual instruction,spiritual leadership,spiritual practice,teaching,term integration,verification", weight:5.0, created_at:1779734109, description:"Sri Preethaji co-teaches Sadhana, integrating meditation as a central practice.<SEP>Sri Preethaji teaches Sadhana, which includes meditation.<SEP>Sri Preethaji co-teaches Sadhana, which includes meditation as a core component.<SEP>Sri Preethaji is associated with the concept of Sadhana in the integrated text.<SEP>Sri Preethaji and Sadhana are both concepts verified as correct despite possible misheard versions.", source_id:"chunk-94fd769ad6dd92d26be8bab1935e1e46<SEP>chunk-f9cb26e7b3e7b78f3a46a447d2d553c9<SEP>chunk-837bb3388ec47b611e5d50b7a992682e<SEP>chunk-c98ca02a6bec59f7fd2e10703ed31704<SEP>chunk-193c5fa66362388f7a23833d6a925623"}}, {start: {_id:1594}, end: {name:"Sri Krishnaji"}, properties:{file_path:"YouTube Video: stUPu1-W4bE (URL: https://www.youtube.com/watch?v=stUPu1-W4bE)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=5Tdb7hBwX88)", truncate:"", keywords:"correctness,spiritual instruction,spiritual leadership,spiritual practice,teaching,verification", weight:4.0, description:"Sri Krishnaji co-teaches Sadhana, emphasizing meditation?s role in spiritual growth.<SEP>Sri Krishnaji teaches Sadhana, which includes meditation.<SEP>Sri Krishnaji co-teaches Sadhana, which includes meditation as a core component.<SEP>Sri Krishnaji and Sadhana are both concepts verified as correct despite possible misheard versions.", created_at:1779734107, source_id:"chunk-94fd769ad6dd92d26be8bab1935e1e46<SEP>chunk-f9cb26e7b3e7b78f3a46a447d2d553c9<SEP>chunk-837bb3388ec47b611e5d50b7a992682e<SEP>chunk-193c5fa66362388f7a23833d6a925623"}}, {start: {_id:5033}, end: {name:"Sri Preethaji"}, properties:{file_path:"YouTube Video: tOi1Ho5Kwhk (URL: https://www.youtube.com/watch?v=tOi1Ho5Kwhk)", truncate:"", keywords:"domain-specific term,spiritual leader", weight:5.0, description:"The Festival of Happening references Sri Preethaji as a domain-specific term.<SEP>Sri Preethaji is associated with the Festival of Happening.<SEP>The Festival of Happening references Sri Preethaji.", created_at:1779429893, source_id:"chunk-8baf1265be404bc46eddc076192461b0"}}, {start: {_id:2629}, end: {name:"Sri Preethaji"}, properties:{file_path:"YouTube Video: tOi1Ho5Kwhk (URL: https://www.youtube.com/watch?v=tOi1Ho5Kwhk)", truncate:"", keywords:"domain-specific term,spiritual leader", weight:2.0, description:"The Abundance Festival references Sri Preethaji as a domain-specific term.<SEP>The Abundance Festival references Sri Preethaji.", created_at:1779429894, source_id:"chunk-8baf1265be404bc46eddc076192461b0"}}, {start: {_id:5033}, end: {name:"Sri Krishnaji"}, properties:{file_path:"YouTube Video: tOi1Ho5Kwhk (URL: https://www.youtube.com/watch?v=tOi1Ho5Kwhk)", truncate:"", keywords:"domain-specific term,spiritual leader", weight:5.0, description:"The Festival of Happening references Sri Krishnaji as a domain-specific term.<SEP>Sri Krishnaji is associated with the Festival of Happening.<SEP>The Festival of Happening references Sri Krishnaji.", created_at:1779429894, source_id:"chunk-8baf1265be404bc46eddc076