UNWIND [{start: {_id:3039}, end: {_id:7564}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", truncate:"", keywords:"common error,misspelling,spelling correction,terminology", weight:2.0, description:"Draupati is identified as a frequent misspelling of the name \"Draupadi\".<SEP>Draupati is the incorrect spelling later replaced by the correct term \"Draupadi\".", created_at:1779668076, source_id:"chunk-6d57c4e7a0dfab13272b92d39272400b<SEP>chunk-a777766ccd192f3d87f1d3e0e9fa98c8"}}, {start: {_id:7565}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", keywords:"content,educational", truncate:"", weight:1.0, description:"The video discusses dissolving inner conflicts as a prerequisite for effective decision-making.", created_at:1779668023, source_id:"chunk-6d57c4e7a0dfab13272b92d39272400b"}}, {start: {_id:7566}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", keywords:"content,educational", truncate:"", weight:1.0, description:"The video emphasizes making decisions from a calm state to ensure clarity and accuracy.", created_at:1779668023, source_id:"chunk-6d57c4e7a0dfab13272b92d39272400b"}}, {start: {_id:7567}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", truncate:"", keywords:"content correction,educational content", weight:1.0, description:"The YouTube video includes a correction of \"Draupati\" to \"Draupadi\".", created_at:1779668045, source_id:"chunk-c5812c68fdc1057fe39cd634aad0e223"}}, {start: {_id:7564}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", truncate:"", keywords:"content editing,correction", weight:1.0, description:"The YouTube Video corrected the term \"Draupati\" to \"Draupadi\".", created_at:1779668076, source_id:"chunk-a777766ccd192f3