UNWIND [{_id:4845, properties:{file_path:"unknown_source<SEP>YouTube Video: qQmrTz6i2x4 (URL: https://www.youtube.com/watch?v=qQmrTz6i2x4)", entity_type:"content", truncate:"", description:"The chanting of Om is a ritual practice used to facilitate visualization and energy growth during the process.<SEP>The chanting of Om is an auditory element in the meditation practice, used to enhance visualization of lunar-related imagery.", created_at:1779411599, source_id:"chunk-724531516c99b2814a8e329894ee9bdf<SEP>chunk-faad39bb9ba8730957c6d719dd0fa2bc", entity_id:"Chanting of Om"}}, {_id:4846, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A honey-colored, molten light is visualized as growing in correlation with the moon's phases during the ritual.", created_at:1779411559, source_id:"chunk-724531516c99b2814a8e329894ee9bdf", entity_id:"Luminous Light"}}, {_id:4848, properties:{file_path:"YouTube Video: qQmrTz6i2x4 (URL: https://www.youtube.com/watch?v=qQmrTz6i2x4)", entity_type:"concept", truncate:"", description:"A luminous, honey-colored light visualized during meditation, symbolizing lunar phases and spiritual growth.", created_at:1779411599, source_id:"chunk-faad39bb9ba8730957c6d719dd0fa2bc", entity_id:"Luminous Honey-Colored Light"}}, {_id:4849, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Soft radiance is a state of gentle luminosity linked to calmness and physical well-being.", created_at:1779412507, source_id:"chunk-001ceefc701be2ec77d8774583dfaee8", entity_id:"Soft Radiance"}}, {_id:4850, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The concept of the world as a secure and harmonious environment.", created_at:1779412507, source_id:"chunk-001ceefc701be2ec77d8774583dfaee8", entity_id:"Safe Place"}}, {_id:4851, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Slow breaths are a breathing technique used to achieve calmness and courage.", created_at:1779412507, source_id:"chunk-001ceefc701be2ec77d8774583dfaee8", entity_id:"Slow Breaths"}}, {_id:4852, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A desired physical state of health and healing, emphasized in the mantra.", created_at:1779412507, source_id:"chunk-001ceefc701be2ec77d8774583dfaee8", entity_id:"Healed and Healthy State"}}, {_id:4853, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A mental state characterized by calmness and courage, invoked through self-affirmation.", created_at:1779412507, source_id:"chunk-001ceefc701be2ec77d8774583dfaee8", entity_id:"Calm and Courageous State"}}, {_id:4854, properties:{file_path:"YouTube Video: 5hNCT4duOgc (URL: https://www.youtube.com/watch?v=5hNCT4duOgc)", entity_type:"concept", truncate:"", description:"Affirmations for calmness, courage, healing, and global harmony, emphasizing body awareness and positive visualization.", created_at:1779412529, source_id:"chunk-d6bda38ec2ac70c5b39894384ca14857", entity_id:"Guided Meditation Affirmations"}}, {_id:4855, properties:{file_path:"YouTube Video: 5hNCT4duOgc (URL: https://www.youtube.com/watch?v=5hNCT4duOgc)", entity_type:"data", truncate:"", description:"URL linking to the YouTube video containing the guided meditation content.", created_at:1779412529, source_id:"chunk-d6bda38ec2ac70c5b39894384ca14857", entity_id:"https://www.youtube.com/watch?v=5hNCT4duOgc"}}, {_id:4856, properties:{file_path:"YouTube Video: 5hNCT4duOgc (URL: https://www.youtube.com/watch?v=5hNCT4duOgc)", entity_type:"content", truncate:"", description:"Guided meditation video containing affirmations for calmness, courage, healing, and global harmony, with a focus on body awareness and positive visualization.", created_at:1779412529, source_id:"chunk-d6bda38ec2ac70c5b39894384ca14857", entity_id:"YouTube Video: 5hNCT4duOgc"}}, {_id:4857, properties:{file_path:"unknown_source<SEP>YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"concept", truncate:"", description:"Modern life refers to contemporary existence characterized by stress, global connectivity, and challenges in achieving fulfillment.<SEP>Modern life involves global connectivity and prolonged stress affecting daily well-being and fulfillment.<SEP>Modern life is characterized by comforts and global connectivity but often leads to stress and inability to cope with life changes.<SEP>Modern life refers to contemporary society characterized by technological advancements, global connectivity, and associated stressors affecting individuals' well-being.", created_at:1779414274, source_id:"chunk-09281c1d13593beda4d12244d150cf31<SEP>chunk-455b122fda4addf20dfaf68404d297db<SEP>chunk-4bed43ee7fc71a8a85a60323529265cc<SEP>chunk-61b4ea6aaf1b9ba778cf54922eb9b8fa", entity_id:"Modern Life"}}, {_id:4858, properties:{file_path:"unknown_source<SEP>YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"artifact", truncate:"", description:"The Breathing Room platform is a meditation platform offering guided practices to address stress and modern life challenges, incorporating ancient techniques from the O&O Academy of philosophy and meditation school centered in India.<SEP>Breathing Room Platform is a meditation and wellness platform offering practices for joyful living, including eating, breathing, and meditation, based on practices from the O&O Academy.", created_at:1779413884, source_id:"chunk-09281c1d13593beda4d12244d150cf31<SEP>chunk-8924b6a6a34d401eea1dd88448275257", entity_id:"Breathing Room Platform"}}, {_id:4859, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Joyful conversations represent heartfelt, meaningful interactions that many find challenging due to stress and trust issues.", created_at:1779413749, source_id:"chunk-09281c1d13593beda4d12244d150cf31", entity_id:"Joyful Conversations"}}, {_id:4860, properties:{file_path:"unknown_source<SEP>YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"organization", truncate:"", description:"O&O Academy of philosophy and meditation school is an Indian institution providing meditation practices adapted for contemporary needs.<SEP>O&O Academy of Philosophy and Meditation School is an Indian institution focused on philosophy and meditation, providing practices for the Breathing Room platform.<SEP>Organization centered in India, referenced in the video as a source of practices.<SEP>O&O Academy of philosophy and meditation school is an Indian institution providing well-tested meditation practices centered in India.", created_at:1779414169, source_id:"chunk-09281c1d13593beda4d12244d150cf31<SEP>chunk-8924b6a6a34d401eea1dd88448275257<SEP>chunk-35e8d232b554b659ba6aef9a72d19bb8<SEP>chunk-455b122fda4addf20dfaf68404d297db", entity_id:"O&O Academy of Philosophy and Meditation School"}}, {_id:4861, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Meditation practices lead users to relaxation and calm mental states as described in the platform's methodology.", created_at:1779413773, source_id:"chunk-09281c1d13593beda4d12244d150cf31", entity_id:"Relaxation and Calm"}}, {_id:4862, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"content", truncate:"", description:"Namast?. Modern life, with all its comforts and global connectivity, still does not make us wake up with a smile on our faces and kick off the sheets to go out and live a fulfilling day. So many of us wake up with butterflies in our stomach, unable to cope with the changes of life.", created_at:1779413809, source_id:"chunk-5ffb39a92a1dd1b071afec2852568b14", entity_id:"Sample Text"}}, {_id:4863, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"UNKNOWN", truncate:"", description:"The Breathing Room's name has inconsistent capitalization, which is a transcription error.", created_at:1779414012, source_id:"chunk-0891d811d05e0ff0fd82c20d195e706c", entity_id:"capitalization error"}}, {_id:4864, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"UNKNOWN", truncate:"", description:"Breathing Room is capitalized in some references (e.g., \"Enter the Breathing Room\") but not in others (e.g., \"the Breathing Room platform\"), creating inconsistency.", created_at:1779414054, source_id:"chunk-3a8bed92469d79105da75d0930238822", entity_id:"capitalization inconsistency"}}, {_id:4865, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"UNKNOWN", truncate:"", description:"O&O Academy is consistently capitalized as a proper name for the meditation platform.", created_at:1779414054, source_id:"chunk-3a8bed92469d79105da75d0930238822", entity_id:"capitalization correctness"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:4866, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"category", truncate:"", description:"Error involving inconsistent capitalization of the proper noun \"Breathing Room\" in the video transcript.", created_at:1779414107, source_id:"chunk-35e8d232b554b659ba6aef9a72d19bb8", entity_id:"Inconsistent Capitalization Error"}}, {_id:4867, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"method", truncate:"", description:"Unique meditation techniques described as \"never-before\" and guided by the O&O Academy.", created_at:1779414107, source_id:"chunk-35e8d232b554b659ba6aef9a72d19bb8", entity_id:"Specially Guided Meditations"}}, {_id:4869, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"concept", truncate:"", description:"Describes emotional and mental conditions characterized by calmness, surety, and inspiration.", created_at:1779414108, source_id:"chunk-35e8d232b554b659ba6aef9a72d19bb8", entity_id:"Beautiful States of Calm"}}, {_id:4871, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"concept", truncate:"", description:"Worry manifests as persistent anxiety affecting peaceful activities like eating.", created_at:1779414169, source_id:"chunk-455b122fda4addf20dfaf68404d297db", entity_id:"Worry"}}, {_id:4872, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"concept", truncate:"", description:"Global connectivity is a defining aspect of modern life with mixed impacts on well-being.<SEP>A characteristic of modern life enabling widespread communication and information exchange but contributing to stress and disconnection.", created_at:1779414274, source_id:"chunk-455b122fda4addf20dfaf68404d297db<SEP>chunk-61b4ea6aaf1b9ba778cf54922eb9b8fa", entity_id:"Global Connectivity"}}, {_id:4873, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"concept", truncate:"", description:"Ancient Practices refer to traditional meditation techniques from the O&O Academy, modified for contemporary use.", created_at:1779414195, source_id:"chunk-09d79ee40c176e3ec0ecf0d2471f0b89", entity_id:"Ancient Practices"}}, {_id:4874, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"concept", truncate:"", description:"Domain-specific terms are listed as a category to address in transcription error fixes.", created_at:1779414213, source_id:"chunk-0aa7c64571d312e22700180e7e895ad6", entity_id:"Domain-specific terms"}}, {_id:4875, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"concept", truncate:"", description:"Transcription errors include homophones, domain terms, and formatting issues targeted for correction.", created_at:1779414213, source_id:"chunk-0aa7c64571d312e22700180e7e895ad6", entity_id:"Transcription errors"}}, {_id:4876, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"concept", truncate:"", description:"Namast? Modern life is a phrase examined in the video for capitalization and spacing accuracy.", created_at:1779414213, source_id:"chunk-0aa7c64571d312e22700180e7e895ad6", entity_id:"Namast? Modern life"}}, {_id:4877, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"concept", truncate:"", description:"Namast? is a term discussed in the video, analyzed for transcription errors and punctuation.", created_at:1779414213, source_id:"chunk-0aa7c64571d312e22700180e7e895ad6", entity_id:"Namast?"}}, {_id:4879, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"concept", truncate:"", description:"Represents the desired state of waking up with a smile and living a fulfilling day, which modern life often fails to provide.<SEP>Fulfilling Day represents the ideal state of waking up with a smile and living a purposeful, joyful day, contrasted with modern life's", created_at:1779414273, source_id:"chunk-4bed43ee7fc71a8a85a60323529265cc<SEP>chunk-61b4ea6aaf1b9ba778cf54922eb9b8fa", entity_id:"Fulfilling Day"}}, {_id:4880, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"concept", truncate:"", description:"A metaphorical expression representing anxiety or unease resulting from stress and life changes.<SEP>A metaphor for anxiety and unease caused by life changes, linked to modern life's challenges.", created_at:1779414274, source_id:"chunk-4bed43ee7fc71a8a85a60323529265cc<SEP>chunk-61b4ea6aaf1b9ba778cf54922eb9b8fa", entity_id:"Butterflies in Our Stomach"}}, {_id:4881, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"concept", truncate:"", description:"A habitual behavior of not breathing fully due to prolonged stress and adaptation to modern life's pressures.", created_at:1779414244, source_id:"chunk-4bed43ee7fc71a8a85a60323529265cc", entity_id:"Breathing Habit"}}, {_id:4882, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", entity_type:"concept", truncate:"", description:"A phrase symbolizing the paradox of modern life's comforts and global connectivity versus the lack of fulfillment and chronic stress experienced by individuals.", created_at:1779414274, source_id:"chunk-61b4ea6aaf1b9ba778cf54922eb9b8fa", entity_id:"Namast? Modern Life"}}, {_id:4883, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)", entity_type:"UNKNOWN", truncate:"", description:"Rule 1 was applied to the original text", created_at:1779415210, source_id:"chunk-d41c554dd0c716bd78a2547adde2a335", entity_id:"Rule 1"}}, {_id:4884, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)", entity_type:"data", truncate:"", description:"A YouTube video titled \"I6yC-aUQUvw\" hosted on YouTube, containing a discussion about punctuation and capitalization in written text.<SEP>A YouTube video discussing readability improvements in text structure.<SEP>A YouTube video titled \"I6yC-aUQUvw\" hosted on YouTube, containing a discussion about text correction challenges.<SEP>A YouTube video with the title \"I6yC-aUQUvw\" and associated URL content.", created_at:1779415438, source_id:"chunk-c7379196e71801ae32380230fbd6d871<SEP>chunk-2117c284d143a0b06c5cfb98ca8fe397<SEP>chunk-fe6aa1715a2c22c11127203343d4b084<SEP>chunk-3b6cbec9369c2bb4f64ac5f3c1f234b9", entity_id:"YouTube Video: I6yC-aUQUvw"}}, {_id:4885, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)", entity_type:"concept", truncate:"", description:"A potential grammatical issue involving punctuation or capitalization that could affect readability, discussed in the context of analyzing written text structure.", created_at:1779415229, source_id:"chunk-c7379196e71801ae32380230fbd6d871", entity_id:"Punctuation or Capitalization Error"}}, {_id:4886, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)", entity_type:"artifact", truncate:"", description:"A web address linking to the YouTube video containing the discussed content about punctuation and capitalization.", created_at:1779415229, source_id:"chunk-c7379196e71801ae32380230fbd6d871", entity_id:"URL: https://www.youtube.com/watch?v=I6yC-aUQUvw"}}, {_id:4887, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)<SEP>unknown_source", entity_type:"method", truncate:"", description:"A genre or style of writing characterized by powerful, concise structures, such as three consecutive questions.<SEP>Spiritual writing is a method of prose that uses stylistic devices like repetition for rhythm and emphasis.", created_at:1779436311, source_id:"chunk-2117c284d143a0b06c5cfb98ca8fe397<SEP>chunk-3dec9ae2729a31a5655fed97d0a0165a", entity_id:"Spiritual Writing"}}, {_id:4888, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)", entity_type:"concept", truncate:"", description:"A quality describing text that is awkward or lacks smooth flow.", created_at:1779415256, source_id:"chunk-2117c284d143a0b06c5cfb98ca8fe397", entity_id:"Clunky"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:4890, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)", entity_type:"content", truncate:"", description:"Original text line with three consecutive questions discussing disconnection and resistance to breathing room.", created_at:1779415256, source_id:"chunk-2117c284d143a0b06c5cfb98ca8fe397", entity_id:"Original Three-Question Line"}}, {_id:4891, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)", entity_type:"UNKNOWN", truncate:"", description:"The revised bullet-point structure improves readability by breaking up the questions.", created_at:1779415257, source_id:"chunk-2117c284d143a0b06c5cfb98ca8fe397", entity_id:"Revised Bullet-Point Line"}}, {_id:4892, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)", entity_type:"concept", truncate:"", description:"Run-on feel refers to a continuous flow of text without proper punctuation or separation, affecting readability and structural clarity.", created_at:1779415280, source_id:"chunk-d08234aef1ec6afbd127700e08544b48", entity_id:"Run-On Feel"}}, {_id:4893, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=iikr2xzAK6Y)", entity_type:"concept", truncate:"", description:"Style is a constraint that encompasses the original tone and formatting of the text. The prompt instructs that this style be retained, and any corrections must preserve the original writing style, including the message's tone and structure. Additionally, Style is explicitly defined as a constraint that should not be rewritten.<SEP>Style is a constraint for the task.", created_at:1779726798, source_id:"chunk-d08234aef1ec6afbd127700e08544b48<SEP>chunk-1625d2a99ff17f15ce8a139663adfc1b<SEP>chunk-3718c86a25fb0b5558d0d13c8bf954d4<SEP>chunk-7756246b3abfc0beb67b4b123552595d", entity_id:"Style"}}, {_id:4894, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)", entity_type:"concept", truncate:"", description:"The process of evaluating whether to make changes to the text, including considerations for minimal intrusion.", created_at:1779415301, source_id:"chunk-fbfd88a298992820a55b4002c8cc0934", entity_id:"Decision-Making Process"}}, {_id:4895, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)", entity_type:"method", truncate:"", description:"Approach to text correction that makes minimal alterations when no clear errors are present.", created_at:1779415396, source_id:"chunk-fe6aa1715a2c22c11127203343d4b084", entity_id:"Least Intrusive Change"}}, {_id:4896, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)", entity_type:"event", truncate:"", description:"Analysis of challenges in text correction, including debates about maintaining original meaning and handling error-free texts.", created_at:1779415396, source_id:"chunk-fe6aa1715a2c22c11127203343d4b084", entity_id:"Text Correction Discussion"}}, {_id:4897, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)", entity_type:"data", truncate:"", description:"URL link directing to the YouTube video containing the text correction analysis.<SEP>URL link to the YouTube video containing the discussed content.", created_at:1779415438, source_id:"chunk-fe6aa1715a2c22c11127203343d4b084<SEP>chunk-3b6cbec9369c2bb4f64ac5f3c1f234b9", entity_id:"https://www.youtube.com/watch?v=I6yC-aUQUvw"}}, {_id:4898, properties:{file_path:"unknown_source<SEP>YouTube Video: 9-NMv5E-18s (URL: https://www.youtube.com/watch?v=9-NMv5E-18s)<SEP>YouTube Video: WfkCDNu4SuE (URL: https://www.youtube.com/watch?v=WfkCDNu4SuE)", entity_type:"creature", truncate:"", description:"Kaitabha is a dark force of greed and anger, representing negative qualities.<SEP>Kaitabha symbolizes the dark force of anger in Hindu philosophy, conquered through spiritual awakening.<SEP>Kaitabha is another demon defeated by Durga in the Navratri myth.<SEP>Kaitabha is a demon defeated by Goddess Durga during the first three days of Navratri.", created_at:1779519149, source_id:"chunk-ae85e43970032506c9fc6caf0b0538ed<SEP>chunk-d51e7d7fdd9bf5d32d4f076f7cdbb5be<SEP>chunk-adf8cda164a53953c2d871599de03c16<SEP>chunk-49d819fbab36af31ec15419ab94d1279", entity_id:"Kaitabha"}}, {_id:4899, properties:{file_path:"unknown_source<SEP>YouTube Video: 9-NMv5E-18s (URL: https://www.youtube.com/watch?v=9-NMv5E-18s)<SEP>YouTube Video: WfkCDNu4SuE (URL: https://www.youtube.com/watch?v=WfkCDNu4SuE)", entity_type:"creature", truncate:"", description:"Mahishasura is a demon who assumes various forms in battle and is ultimately killed by the Goddess.<SEP>Mahishasura is a mythological demon referenced as a metaphor for the ever-changing nature of desires.<SEP>Mahishasura is a mythological demon defeated by Goddess Durga, symbolizing the destruction of ignorance and ego.`<SEP>...` -> Correct.<SEP>Mahishasura is referenced as the demon killed by Durga in the myth of Navratri.", created_at:1779519141, source_id:"chunk-ae85e43970032506c9fc6caf0b0538ed<SEP>chunk-8cc3598abebcf159e6f8db2b03c316fe<SEP>chunk-672a64891a721958057240b2cc83a897<SEP>chunk-adf8cda164a53953c2d871599de03c16", entity_id:"Mahishasura"}}, {_id:4900, properties:{file_path:"unknown_source<SEP>YouTube Video: 9-NMv5E-18s (URL: https://www.youtube.com/watch?v=9-NMv5E-18s)", entity_type:"creature", truncate:"", description:"Rakta Bhija is a concept related to the demon's blood giving rise to new forms.<SEP>Rakta Bhija is a mythological figure symbolizing the proliferation of desires upon suppression.", created_at:1779416791, source_id:"chunk-ae85e43970032506c9fc6caf0b0538ed<SEP>chunk-8cc3598abebcf159e6f8db2b03c316fe", entity_id:"Rakta Bhija"}}, {_id:4901, properties:{file_path:"unknown_source<SEP>YouTube Video: 9-NMv5E-18s (URL: https://www.youtube.com/watch?v=9-NMv5E-18s)<SEP>YouTube Video: WfkCDNu4SuE (URL: https://www.youtube.com/watch?v=WfkCDNu4SuE)", entity_type:"creature", truncate:"", description:"Madhu is a dark force of greed and anger, representing negative qualities.<SEP>Madhu represents the dark force of greed in Hindu philosophy, overcome by divine grace during spiritual evolution.<SEP>Madhu is one of the demons killed by Durga during the first three days of Navratri.<SEP>Madhu is a demon defeated by Goddess Durga during the first three days of Navratri.", created_at:1779519149, source_id:"chunk-ae85e43970032506c9fc6caf0b0538ed<SEP>chunk-d51e7d7fdd9bf5d32d4f076f7cdbb5be<SEP>chunk-adf8cda164a53953c2d871599de03c16<SEP>chunk-49d819fbab36af31ec15419ab94d1279", entity_id:"Madhu"}}, {_id:4902, properties:{file_path:"unknown_source", entity_type:"creature", truncate:"", description:"Surah is a form of the demon that appears during the battle with the Goddess.", created_at:1779416691, source_id:"chunk-ae85e43970032506c9fc6caf0b0538ed", entity_id:"Surah"}}, {_id:4903, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Maha Lakshmi is the Goddess of wealth who blesses those who are calm and peaceful.", created_at:1779416692, source_id:"chunk-ae85e43970032506c9fc6caf0b0538ed", entity_id:"Maha Lakshmi"}}, {_id:4904, properties:{file_path:"unknown_source<SEP>YouTube Video: 9-NMv5E-18s (URL: https://www.youtube.com/watch?v=9-NMv5E-18s)", entity_type:"person", truncate:"", created_at:1779416791, description:"Krishna Jay is a teacher who shares insights on the evolutionary path of the seeker.<SEP>Krishna Jay is a spiritual teacher discussing evolutionary consciousness and the transcendence of desire.<SEP>Krishna Jay is a spiritual teacher mentioned in the context of discussing the evolutionary path of the seeker.", source_id:"chunk-ae85e43970032506c9fc6caf0b0538ed<SEP>chunk-d51e7d7fdd9bf5d32d4f076f7cdbb5be<SEP>chunk-8cc3598abebcf159e6f8db2b03c316fe", entity_id:"Krishna Jay"}}, {_id:4905, properties:{file_path:"unknown_source<SEP>YouTube Video: 9-NMv5E-18s (URL: https://www.youtube.com/watch?v=9-NMv5E-18s)", entity_type:"person", truncate:"", description:"Goddess Durga is the Divine Mother who provides grace to overcome tamas and rajas.<SEP>Goddess Durga is a Hindu deity symbolizing protection and the triumph of good over evil, associated with Navratri.", created_at:1779416741, source_id:"chunk-ae85e43970032506c9fc6caf0b0538ed<SEP>chunk-d51e7d7fdd9bf5d32d4f076f7cdbb5be", entity_id:"Goddess Durga"}}, {_id:4906, properties:{file_path:"unknown_source<SEP>YouTube Video: 9-NMv5E-18s (URL: https://www.youtube.com/watch?v=9-NMv5E-18s)", entity_type:"person", truncate:"", description:"Goddess Mahadurga is the Goddess associated with the first three days of Navratri.<SEP>Goddess Mahadurga is a divine figure in Hinduism, depicted as a warrior who defeats demons and embodies feminine power.", created_at:1779416741, source_id:"chunk-ae85e43970032506c9fc6caf0b0538ed<SEP>chunk-d51e7d7fdd9bf5d32d4f076f7cdbb5be", entity_id:"Goddess Mahadurga"}}, {_id:4907, properties:{file_path:"unknown_source<SEP>YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", entity_type:"calmness", truncate:"", description:"Maha Lakshmi blesses those who are calm and peaceful.<SEP>Successful leaders remain calm.<SEP>Successful leaders remain calm.", created_at:1779560222, source_id:"chunk-ae85e43970032506c9fc6caf0b0538ed<SEP>chunk-8fe41869f1b0fa2b6e988f652c7091c5", entity_id:"Calmness"}}, {_id:4908, properties:{file_path:"YouTube Video: 9-NMv5E-18s (URL: https://www.youtube.com/watch?v=9-NMv5E-18s)", entity_type:"creature", truncate:"", description:"Sura is a demonic entity in Hindu mythology, capable of regenerating from spilled blood, analogous to mythical adversaries.", created_at:1779416741, source_id:"chunk-d51e7d7fdd9bf5d32d4f076f7cdbb5be", entity_id:"Sura"}}, {_id:4914, properties:{file_path:"YouTube Video: 9-NMv5E-18s (URL: https://www.youtube.com/watch?v=9-NMv5E-18s)", entity_type:"concept", truncate:"", description:"The evolutionary path of the seeker involves transcending the desiring mind and realizing higher consciousness.", created_at:1779416791, source_id:"chunk-8cc3598abebcf159e6f8db2b03c316fe", entity_id:"Evolutionary Path of the Seeker"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:4915, properties:{file_path:"YouTube Video: 9-NMv5E-18s (URL: https://www.youtube.com/watch?v=9-NMv5E-18s)<SEP>YouTube Video: tegTDWT3SDc (URL: https://www.youtube.com/watch?v=tegTDWT3SDc)", entity_type:"concept", truncate:"", description:"Witness Consciousness refers to the state of being an observer of one's own mind and desires.<SEP>Witness consciousness is a state of awareness where one observes thoughts without attachment, part of the second level of awakening.", created_at:1779524484, source_id:"chunk-8cc3598abebcf159e6f8db2b03c316fe<SEP>chunk-ea232d61d1eebbbf47a086d1e047bec3", entity_id:"Witness Consciousness"}}, {_id:4916, properties:{file_path:"YouTube Video: 9-NMv5E-18s (URL: https://www.youtube.com/watch?v=9-NMv5E-18s)", entity_type:"concept", truncate:"", description:"The ever-hungry mind is described as a trickster that generates new cravings when one is suppressed.", created_at:1779416792, source_id:"chunk-8cc3598abebcf159e6f8db2b03c316fe", entity_id:"Ever-Hungry Mind"}}, {_id:4917, properties:{file_path:"YouTube Video: 9-NMv5E-18s (URL: https://www.youtube.com/watch?v=9-NMv5E-18s)", entity_type:"concept", truncate:"", description:"Craving for position represents a form of desire related to social status or authority.", created_at:1779416792, source_id:"chunk-8cc3598abebcf159e6f8db2b03c316fe", entity_id:"Craving for Position"}}, {_id:4920, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=iikr2xzAK6Y)", entity_type:"content", truncate:"", description:"The output text after corrections have been applied.<SEP>The output text after corrections have been applied.<SEP>Corrected text is the output of the task.", created_at:1779726798, source_id:"chunk-8b875733f77c698a06c289ab42079023<SEP>chunk-7756246b3abfc0beb67b4b123552595d", entity_id:"Corrected text"}}, {_id:4921, properties:{file_path:"unknown_source<SEP>YouTube Video: 7lggUuJtZXY (URL: https://www.youtube.com/watch?v=7lggUuJtZXY)", entity_type:"concept", truncate:"", description:"A state of being associated with difficulty in wealth creation processes.`<SEP>A state of being associated with difficulty in wealth creation processes.`<SEP>Struggling wealth creator is driven by fear, anxiety, and separation, facing challenges in wealth creation.", created_at:1779418251, source_id:"chunk-87c7719422a9d8333cc199f60bc9b163<SEP>chunk-c89b8cdd64ac1b6adbb6cecedd0bf3f0", entity_id:"Struggling Wealth Creator"}}, {_id:4922, properties:{file_path:"unknown_source<SEP>YouTube Video: 7lggUuJtZXY (URL: https://www.youtube.com/watch?v=7lggUuJtZXY)", entity_type:"concept", truncate:"", description:"A transformation in personal energy dynamics leading to increased influence and creation capacity.`<SEP>A transformation in personal energy dynamics leading to increased influence and creation capacity.`<SEP>Power shift describes a transformation in mindset leading to enhanced innovation, team creation, and wealth emergence, directly experienced by the conscious wealth creator.", created_at:1779418251, source_id:"chunk-87c7719422a9d8333cc199f60bc9b163<SEP>chunk-c89b8cdd64ac1b6adbb6cecedd0bf3f0", entity_id:"Power Shift"}}, {_id:4923, properties:{file_path:"unknown_source<SEP>YouTube Video: 7lggUuJtZXY (URL: https://www.youtube.com/watch?v=7lggUuJtZXY)<SEP>YouTube Video: o6X1TVEFHAY (URL: https://www.youtube.com/watch?v=o6X1TVEFHAY)", entity_type:"concept", truncate:"", created_at:1779425433, description:"A state of awareness where creation occurs effortlessly and intuitively.`<SEP>A state of awareness where creation occurs effortlessly and intuitively.`<SEP>Creation dimension refers to a state of consciousness where opportunities replace problems, enabling effortless creation.<SEP>The creation dimension represents a consciousness state where wealth creation becomes effortless and intuitive.", source_id:"chunk-87c7719422a9d8333cc199f60bc9b163<SEP>chunk-c89b8cdd64ac1b6adbb6cecedd0bf3f0<SEP>chunk-b818c65344c12c13e644d0fa2726456e", entity_id:"Creation Dimension"}}, {_id:4924, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A grammatical error involving improper joining of independent clauses with only a comma.`<SEP>A grammatical error involving improper joining of independent clauses with only a comma.`", created_at:1779418238, source_id:"chunk-87c7719422a9d8333cc199f60bc9b163", entity_id:"Comma Splice"}}, {_id:4925, properties:{file_path:"unknown_source<SEP>YouTube Video: o6X1TVEFHAY (URL: https://www.youtube.com/watch?v=o6X1TVEFHAY)", entity_type:"concept", truncate:"", description:"The act of introducing new ideas or methods for creating value and solutions.<SEP>The act of introducing new ideas or methods for creating value and solutions.<SEP>Innovation is emphasized as a critical driver of wealth creation in the described mindset.", created_at:1779425433, source_id:"chunk-87c7719422a9d8333cc199f60bc9b163<SEP>chunk-b818c65344c12c13e644d0fa2726456e", entity_id:"Innovate"}}, {_id:4933, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Positive outcomes perceived when awakened to the creation dimension.<SEP>Positive outcomes perceived when awakened to the creation dimension.", created_at:1779418240, source_id:"chunk-d097880e58e4b221fa91dccc5ac053c2", entity_id:"opportunities"}}, {_id:4935, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Negative situations or obstacles, such as chaos, that one encounters.`<SEP>Negative situations or obstacles, such as chaos, that one encounters.`", created_at:1779418240, source_id:"chunk-d097880e58e4b221fa91dccc5ac053c2", entity_id:"problems and chaos"}}, {_id:4936, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Obstacles or challenges that shift to opportunities in a transformed mindset.<SEP>Obstacles or challenges that shift to opportunities in a transformed mindset.", created_at:1779418240, source_id:"chunk-d097880e58e4b221fa91dccc5ac053c2", entity_id:"roadblocks"}}, {_id:4937, properties:{file_path:"YouTube Video: 7lggUuJtZXY (URL: https://www.youtube.com/watch?v=7lggUuJtZXY)", entity_type:"content", truncate:"", description:"YouTube Video: 7lggUuJtZXY is a video discussing the transition from struggling to conscious wealth creation, emphasizing effortless wealth creation through passion and creation dimensions.", created_at:1779418251, source_id:"chunk-c89b8cdd64ac1b6adbb6cecedd0bf3f0", entity_id:"YouTube Video: 7lggUuJtZXY"}}, {_id:4938, properties:{file_path:"unknown_source<SEP>YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", description:"Inclusive thinking involves embracing diversity and interconnectedness in decision-making to address systemic exploitation.<SEP>Emphasizes unity in thought and action to end exploitation and economic unrest.<SEP>Inclusive thinking emphasizes unity in cognitive and behavioral patterns to transcend exploitative paradigms.<SEP>A paradigm advocating for unity in thought and action to eliminate exploitation and foster collective well-being.", created_at:1779420717, source_id:"chunk-38046723cd74f27b125edb0953caff31<SEP>chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-7abf3d6ec3bef4fcb00fff43b8f7e2bf<SEP>chunk-dcbde403840148f165365cfd6299b08f", entity_id:"Inclusive Thinking"}}, {_id:4939, properties:{file_path:"unknown_source<SEP>YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", created_at:1779420520, description:"A conscious world leader regards Mother Earth and its inhabitants as an interconnected family, emphasizing global stewardship.<SEP>Perceives Mother Earth and its inhabitants as family, promoting global oneness.<SEP>Conscious world leader regards planetary ecosystems and humanity as an interconnected familial entity requiring holistic stewardship.", source_id:"chunk-38046723cd74f27b125edb0953caff31<SEP>chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-7abf3d6ec3bef4fcb00fff43b8f7e2bf", entity_id:"Conscious World Leader"}}, {_id:4940, properties:{file_path:"unknown_source<SEP>YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"person", truncate:"", created_at:1779420747, description:"A conscious household leader views the home as an extension of family dynamics and shared responsibility.<SEP>Perceives home as family, emphasizing a paradigm of unity in domestic leadership.<SEP>A leader perceiving home as family.<SEP>Conscious household leader perceives domestic life as an extension of familial bonds and shared responsibility.<SEP>A conscious household leader who perceives home as family.", source_id:"chunk-38046723cd74f27b125edb0953caff31<SEP>chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-75cd94439105286110a38283159573c6<SEP>chunk-7abf3d6ec3bef4fcb00fff43b8f7e2bf<SEP>chunk-c639141ec491d448e8e3d57ed9e03d3d", entity_id:"Conscious Household Leader"}}, {_id:4941, properties:{file_path:"unknown_source<SEP>YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"person", truncate:"", created_at:1779420747, description:"A conscious business leader perceives the organization as a familial unit, prioritizing collective welfare over profit.<SEP>Perceives organization as family, highlighting cooperative leadership in business.<SEP>A leader perceiving organization as family.<SEP>Conscious business leader views organizational structures as analogous to family systems prioritizing collective well-being.<SEP>A conscious business leader who perceives organization as family.", source_id:"chunk-38046723cd74f27b125edb0953caff31<SEP>chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-75cd94439105286110a38283159573c6<SEP>chunk-7abf3d6ec3bef4fcb00fff43b8f7e2bf<SEP>chunk-c639141ec491d448e8e3d57ed9e03d3d", entity_id:"Conscious Business Leader"}}, {_id:4942, properties:{file_path:"unknown_source<SEP>YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", description:"Conscious creation of wealth is a philosophy emphasizing ethical and holistic approaches to wealth generation for societal and familial well-being.<SEP>Refers to the idea that creating wealth consciously is necessary for sustained well-being of family and society.<SEP>The concept of conscious creation of wealth for family and society well-being.<SEP>Conscious creation of wealth refers to a philosophical approach to economic practices emphasizing ethical and sustainable prosperity.", created_at:1779420520, source_id:"chunk-38046723cd74f27b125edb0953caff31<SEP>chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-75cd94439105286110a38283159573c6<SEP>chunk-7abf3d6ec3bef4fcb00fff43b8f7e2bf", entity_id:"Conscious Creation of Wealth"}}, {_id:4943, properties:{file_path:"unknown_source<SEP>YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"person", truncate:"", description:"A conscious political leader interprets the country as a family, advocating for inclusive governance and equity.<SEP>Perceives country as family, reflecting inclusive governance principles.<SEP>A leader perceiving country as family.<SEP>Conscious political leader interprets governance as stewardship of societal welfare akin to familial care.<SEP>A perspective on leadership where a leader views their country as an extension of family, emphasizing interconnectedness and responsibility.<SEP>A conscious political leader who perceives country as family.", created_at:1779420747, source_id:"chunk-38046723cd74f27b125edb0953caff31<SEP>chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-75cd94439105286110a38283159573c6<SEP>chunk-7abf3d6ec3bef4fcb00fff43b8f7e2bf<SEP>chunk-dcbde403840148f165365cfd6299b08f<SEP>chunk-c639141ec491d448e8e3d57ed9e03d3d", entity_id:"Conscious Political Leader"}}, {_id:4944, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Three fundamental shifts in wealth creators and leaders are proposed as prerequisites to resolving economic unrest.", created_at:1779420159, source_id:"chunk-38046723cd74f27b125edb0953caff31", entity_id:"Three Fundamental Shifts"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:4945, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Wealth creators and leaders are individuals responsible for generating and managing wealth, requiring shifts in thinking to address economic unrest.", created_at:1779420159, source_id:"chunk-38046723cd74f27b125edb0953caff31", entity_id:"Wealth Creators and Leaders"}}, {_id:4946, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Inclusive thinking is presented as a solution to end exploitation and economic unrest.", created_at:1779420159, source_id:"chunk-38046723cd74f27b125edb0953caff31<SEP>chunk-7abf3d6ec3bef4fcb00fff43b8f7e2bf", entity_id:"exploitation"}}, {_id:4947, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The shifts are framed as essential for addressing and resolving economic unrest.", created_at:1779420159, source_id:"chunk-38046723cd74f27b125edb0953caff31", entity_id:"economic unrest"}}, {_id:4948, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The political leader interprets the country as a family, advocating inclusive policies.", created_at:1779420159, source_id:"chunk-38046723cd74f27b125edb0953caff31<SEP>chunk-7abf3d6ec3bef4fcb00fff43b8f7e2bf", entity_id:"country"}}, {_id:4949, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The household leader perceives the home as a familial unit requiring conscious stewardship.", created_at:1779420159, source_id:"chunk-38046723cd74f27b125edb0953caff31<SEP>chunk-7abf3d6ec3bef4fcb00fff43b8f7e2bf", entity_id:"home"}}, {_id:4950, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"person", truncate:"", created_at:1779420717, description:"Dr. Joe Dispenza is a domain-specific name mentioned in the text, categorized as a person.<SEP>Dr. Joe Dispenza is the speaker in the YouTube video QAnRefsK-3Y.<SEP>Dr. Joe Dispenza is mentioned as being present during the discussion, though no specific actions or attributes are attributed to him in the provided text.<SEP>Dr. Joe Dispenza is a speaker mentioned in the video, associated with enlightenment and awakening.<SEP>Dr. Joe Dispenza is a guest speaker in the YouTube video, discussing leadership and paradigm shifts.", source_id:"chunk-9d9744dacd10c03b653c5a3fe39dda9e<SEP>chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-a84002ccf9bfe2d1ba87d2c2ea84b743<SEP>chunk-7a50476fe3717f3e56d4d65eb5669d3f<SEP>chunk-4f108a1313b1da3a2fa234ff5f49d6e5<SEP>chunk-dcbde403840148f165365cfd6299b08f", entity_id:"Dr. Joe Dispenza"}}, {_id:4951, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", description:"Describes the long-term welfare of families and society linked to conscious wealth creation.", created_at:1779420211, source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4", entity_id:"Sustained Well-being"}}, {_id:4952, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", description:"A paradigm characterized by competition, contrasted with cooperation-driven approaches.<SEP>Comparison-Driven is a state that must be shifted from, towards cooperation-driven.", created_at:1779420547, source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-4f108a1313b1da3a2fa234ff5f49d6e5", entity_id:"Comparison-Driven"}}, {_id:4953, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", description:"A paradigm focused on personal gratification, contrasted with purpose-driven leadership.<SEP>Pleasure-Driven is a state that must be shifted from, towards purpose-driven.", created_at:1779420548, source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-4f108a1313b1da3a2fa234ff5f49d6e5", entity_id:"Pleasure-Driven"}}, {_id:4954, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", created_at:1779420717, description:"A paradigm emphasizing collaboration over competition in wealth creation.<SEP>Cooperation-Driven is the desired state in the first paradigm shift.<SEP>A proposed shift from comparison-driven behavior to collaborative approaches in wealth creation and leadership.", source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-4f108a1313b1da3a2fa234ff5f49d6e5<SEP>chunk-dcbde403840148f165365cfd6299b08f", entity_id:"Cooperation-Driven"}}, {_id:4955, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", created_at:1779420717, description:"A paradigm prioritizing meaningful goals over mere pleasure in leadership.<SEP>Purpose-Driven is the desired state in the second paradigm shift.<SEP>A leadership paradigm prioritizing meaningful objectives over personal pleasure, emphasizing societal contribution.", source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-4f108a1313b1da3a2fa234ff5f49d6e5<SEP>chunk-dcbde403840148f165365cfd6299b08f", entity_id:"Purpose-Driven"}}, {_id:4956, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", created_at:1779420548, description:"A paradigm based on division, contrasted with oneness-driven unity.<SEP>Separation-driven is a concept contrasted with oneness-driven, representing a state of disconnection.<SEP>Separation-Driven is a state that must be shifted from, towards oneness-driven.", source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-a84002ccf9bfe2d1ba87d2c2ea84b743<SEP>chunk-4f108a1313b1da3a2fa234ff5f49d6e5", entity_id:"Separation-Driven"}}, {_id:4958, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", description:"A paradigm emphasizing interconnectedness and global unity.<SEP>Oneness-driven is a concept contrasted with separation-driven, representing a state of unity.<SEP>Oneness-Driven is the desired state in the ultimate paradigm shift.<SEP>An ultimate paradigm shift from separation to unity, requiring profound personal and collective transformation.", created_at:1779420718, source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-a84002ccf9bfe2d1ba87d2c2ea84b743<SEP>chunk-4f108a1313b1da3a2fa234ff5f49d6e5<SEP>chunk-dcbde403840148f165365cfd6299b08f", entity_id:"Oneness-Driven"}}, {_id:4959, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)<SEP>YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"location", truncate:"", created_at:1779663135, description:"Political leaders perceive country as family, emphasizing inclusive policies.<SEP>Country is perceived as family by a conscious political leader, representing the national domain.<SEP>The country symbolizes the entity being protected through acts of war and self-defense, with citizens owing allegiance to its safety.", source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-c639141ec491d448e8e3d57ed9e03d3d<SEP>chunk-0360e3d7478d7aa88e74b472aef4bc64", entity_id:"Country"}}, {_id:4960, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=zGhlBQ8iWl4)", entity_type:"concept", truncate:"", description:"Paradigm shift is a key theme, involving a move from pleasure-driven to purpose-driven and from separation-driven to oneness-driven.<SEP>Paradigm shift represents a fundamental transformation in societal structures and values.<SEP>Paradigm shift represents a fundamental transformation in societal structures and values.", created_at:1779701484, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743<SEP>chunk-4f108a1313b1da3a2fa234ff5f49d6e5<SEP>chunk-c2a3583743d6818c48f0ebcba32019d3", entity_id:"Paradigm Shift"}}, {_id:4961, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"artifact", truncate:"", created_at:1779420877, description:"QAnRefsK-3Y is a YouTube video (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y) discussing spiritual and philosophical concepts.<SEP>YouTube Video titled \"QAnRefsK-3Y\" hosted at the provided URL, containing a quote and other statements.<SEP>QAnRefsK-3Y is a YouTube video referenced as the source of the quoted statements.", source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743<SEP>chunk-7bd479153c285286517cbed7a414b233<SEP>chunk-af881796b97d19f020179697b9daf675", entity_id:"QAnRefsK-3Y"}}, {_id:4962, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)<SEP>YouTube Video: tegTDWT3SDc (URL: https://www.youtube.com/watch?v=tegTDWT3SDc)", entity_type:"concept", truncate:"", description:"Awakening experience is a spiritual state discussed in the video, linked to enlightenment.<SEP>Awakening Experience is described as a powerful experience needed to move closer to oneness.<SEP>A transformative experience enabling individuals to transcend separation and embrace interconnectedness.<SEP>Awakening Experience refers to a transformative, direct encounter with divine consciousness and self-realization described by the narrator.", created_at:1779524424, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743<SEP>chunk-7a50476fe3717f3e56d4d65eb5669d3f<SEP>chunk-dcbde403840148f165365cfd6299b08f<SEP>chunk-0e0d394b4b504c272b6565228b821607", entity_id:"Awakening Experience"}}, {_id:4963, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)<SEP>unknown_source<SEP>YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"event", truncate:"", description:"Enlightenment experience is a spiritual state discussed in the video, linked to awakening.<SEP>Enlightenment Experience is described as a powerful experience needed to move closer to oneness.<SEP>Enlightenment Experience is a necessary condition for the paradigm shift, involving a powerful awakening.<SEP>Enlightenment experience surges spiritual current, enabling oneness and non-duality beyond the limited self.<SEP>A type of transcendental experience characterized by nervous system charging and a state of oneness.<SEP>A transcendental experience causing nervous system activation and entry into non-duality and oneness.", created_at:1779661704, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743<SEP>chunk-7a50476fe3717f3e56d4d65eb5669d3f<SEP>chunk-4f108a1313b1da3a2fa234ff5f49d6e5<SEP>chunk-888705ac7721cd21ad67f22ea71eac64<SEP>chunk-355c42e8aaaf893df441489ff3a44b86<SEP>chunk-9f245e3153d92a2c38134afd812338bf", entity_id:"Enlightenment Experience"}}, {_id:4964, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", created_at:1779420547, description:"Zero point is mentioned as the origin from which humanity descended.<SEP>Zero Point is referenced as the origin point from which separation occurred, and is associated with singularity and pure love.<SEP>Zero Point is a foundational concept in the text, representing a state of pure origin and density.", source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743<SEP>chunk-7a50476fe3717f3e56d4d65eb5669d3f<SEP>chunk-4f108a1313b1da3a2fa234ff5f49d6e5", entity_id:"Zero Point"}}, {_id:4965, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", description:"Pure love is described as the origin of humanity, pure and all-encompassing.<SEP>Pure Love is described as a state of being from which separation occurred, and is associated with singularity, the zero point, and oneness.<SEP>Pure Love is described as the origin from which separation descends, associated with oneness.<SEP>Pure love is portrayed as the fundamental nature of existence, contrasted with human experiences of separation.", created_at:1779420877, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743<SEP>chunk-7a50476fe3717f3e56d4d65eb5669d3f<SEP>chunk-4f108a1313b1da3a2fa234ff5f49d6e5<SEP>chunk-af881796b97d19f020179697b9daf675", entity_id:"Pure Love"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:4966, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", created_at:1779420877, description:"Density is a state of separation from pure love, where senses deceive.<SEP>Density is mentioned as a state of being resulting from separation, and is associated with pure love and oneness.<SEP>Density symbolizes the physical realm where beings experience separation from their origin.", source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743<SEP>chunk-7a50476fe3717f3e56d4d65eb5669d3f<SEP>chunk-af881796b97d19f020179697b9daf675", entity_id:"Density"}}, {_id:4967, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)<SEP>YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", created_at:1779555418, description:"Pain and suffering are not the opposite of love but the separation from it.<SEP>Pain and suffering are described as not the opposite of love, but the separation from it.<SEP>Framed as manifestations of separation from love rather than love's antithesis.<SEP>Pain and suffering are linked to separation from love, arising from disconnection from unity.<SEP>Consequences of layoffs on employees and their families, acknowledged by the CEO.", source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743<SEP>chunk-7a50476fe3717f3e56d4d65eb5669d3f<SEP>chunk-44b4ed2b95749854883160c9435c1c98<SEP>chunk-af881796b97d19f020179697b9daf675<SEP>chunk-5424541c24943ffc408f99bb3aa45c96", entity_id:"Pain and Suffering"}}, {_id:4968, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", description:"Anger, hostility, and violence are not the opposite of love but the separation from it.<SEP>Anger and hostility and violence are described as not the opposite of love, but the separation from it.", created_at:1779420357, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743<SEP>chunk-7a50476fe3717f3e56d4d65eb5669d3f", entity_id:"Anger and Hostility and Violence"}}, {_id:4969, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", description:"One mind in one heart is the desired outcome of moving closer to love.<SEP>One Mind in One Heart is described as a state of unity that can be achieved by moving closer to love, and is associated with oneness and the zero point.<SEP>Described as a unified state of consciousness achieved through transcending separation.<SEP>One mind in one heart signifies the potential unity of consciousness when approaching love.", created_at:1779420878, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743<SEP>chunk-7a50476fe3717f3e56d4d65eb5669d3f<SEP>chunk-44b4ed2b95749854883160c9435c1c98<SEP>chunk-af881796b97d19f020179697b9daf675", entity_id:"One Mind in One Heart"}}, {_id:4970, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", created_at:1779420877, description:"Singularity is a concept mentioned as the origin of humanity, synonymous with pure love and zero point.<SEP>Singularity is mentioned as a state of being from which separation occurred, and is associated with pure love, the zero point, and the zero point.<SEP>Singularity is characterized as the zero point, representing pure love and oneness before material existence.", source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743<SEP>chunk-7a50476fe3717f3e56d4d65eb5669d3f<SEP>chunk-af881796b97d19f020179697b9daf675", entity_id:"Singularity"}}, {_id:4971, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", description:"Nation of separation is discussed as a state of being fooled by senses into separation.<SEP>A societal framework rooted in division, contrasted with the innate human state of oneness and unity.", created_at:1779420718, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743<SEP>chunk-dcbde403840148f165365cfd6299b08f", entity_id:"Nation of Separation"}}, {_id:4972, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"content", truncate:"", description:"A statement from the YouTube video expressing the", created_at:1779420307, source_id:"chunk-7bd479153c285286517cbed7a414b233", entity_id:"One-Mind Statement"}}, {_id:4973, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)<SEP>unknown_source<SEP>YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)<SEP>YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", entity_type:"method", truncate:"", created_at:1779672419, description:"Economic Unrest is addressed through shifts in thinking and action.<SEP>The solution to global issues is portrayed as inherent within individuals, requiring internal realization rather than external measures.<SEP>Solutions are portrayed as inherent within individuals, contrasting with external problem-solving.<SEP>The alternative strategy to retain employees through collaboration and transparency.<SEP>Solution is discussed as a response to a perceived problem, requiring linguistic correction.<SEP>Solution is discussed as a response to a perceived problem, requiring linguistic correction.<SEP>A solution is needed to address the problem of excessive negative thoughts.", source_id:"chunk-4f108a1313b1da3a2fa234ff5f49d6e5<SEP>chunk-c31c96b585957b3d969c1f44467db292<SEP>chunk-a1a3adb6e659bbb8209f01781e8bec78<SEP>chunk-5424541c24943ffc408f99bb3aa45c96<SEP>chunk-c47a850c80a21ed6c67cbed2bc4b8ec0<SEP>chunk-9174f4aac6278b492855cabdc7a615b1", entity_id:"Solution"}}, {_id:4975, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", description:"Characterized as expressions of separation from love through destructive behaviors and biases.", created_at:1779420665, source_id:"chunk-44b4ed2b95749854883160c9435c1c98", entity_id:"Anger and Hostility and Violence, Prejudice"}}, {_id:4978, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"content", truncate:"", description:"YouTube Video titled \"QAnRefsK-3Y\" hosted on YouTube, containing a discussion on paradigm shifts and leadership principles.", created_at:1779420717, source_id:"chunk-dcbde403840148f165365cfd6299b08f", entity_id:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)"}}, {_id:4979, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", description:"Hostility is associated with separation from love, reflecting disunity and conflict.", created_at:1779420878, source_id:"chunk-af881796b97d19f020179697b9daf675", entity_id:"Hostility"}}, {_id:4980, properties:{file_path:"unknown_source<SEP>YouTube Video: smrj15-QOAI (URL: https://www.youtube.com/watch?v=smrj15-QOAI)", entity_type:"concept", truncate:"", description:"Adi Lakshmi is described as the source of all forms of abundance, including financial abundance.<SEP>Adi Lakshmi is the primordial source of abundance, from which other forms of abundance, including Sadi Lakshmi, originate.", created_at:1779422736, source_id:"chunk-edc51a29631077e242d8d4d37a955e71<SEP>chunk-a55555a2261b1413bf3e29da19d21267", entity_id:"Adi Lakshmi"}}, {_id:4981, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Sadi Lakshmi refers to the seven facets of abundance derived from Adi Lakshmi.", created_at:1779422510, source_id:"chunk-edc51a29631077e242d8d4d37a955e71<SEP>chunk-a55555a2261b1413bf3e29da19d21267", entity_id:"Sadi Lakshmi"}}, {_id:4982, properties:{file_path:"unknown_source<SEP>YouTube Video: smrj15-QOAI (URL: https://www.youtube.com/watch?v=smrj15-QOAI)", entity_type:"concept", truncate:"", created_at:1779423439, description:"Lakshmi Consciousness represents a positive, sacred, noble, abundant, and joyful state of mind attracting prosperity.<SEP>Lakshmi Consciousness refers to a positive, sacred, noble, abundant, and joyful state of mind associated with prosperity and wealth.<SEP>A specific state of consciousness related to Lakshmi, mentioned in the text.`", source_id:"chunk-edc51a29631077e242d8d4d37a955e71<SEP>chunk-0e4e727add2cb9caa8f4ff786f6c1360<SEP>chunk-ff51aa4461148b2b87ba9c4aa3794e5c", entity_id:"Lakshmi Consciousness"}}, {_id:4983, properties:{file_path:"unknown_source<SEP>YouTube Video: smrj15-QOAI (URL: https://www.youtube.com/watch?v=smrj15-QOAI)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=X3LKG0Ycl3A)", entity_type:"concept", truncate:"", description:"The Manifest is a program focused on manifesting wealth, consciousness, and abundance through understanding abundance consciousness.<SEP>An upcoming event or program aimed at redefining wealth understanding and empowering wealth creators through consciousness-based principles.<SEP>A term discussed in the video, appearing multiple times in the text.<SEP>Manifest refers to the process of making abstract intentions tangible, central to the described methodology.", created_at:1779728755, source_id:"chunk-161257a3b15bcafcf939769dfff5e967<SEP>chunk-edc51a29631077e242d8d4d37a955e71<SEP>chunk-0e4e727add2cb9caa8f4ff786f6c1360<SEP>chunk-576f10f06b7632e1972cb071c6564b42<SEP>chunk-6f90bcd92d07d52aa1d337005e488437", entity_id:"Manifest"}}, {_id:4984, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Farmers in India practice agriculture by selecting seeds, plowing, sowing, and relying on natural factors like rainfall and sunshine.", created_at:1779422510, source_id:"ch