UNWIND [{start: {_id:1500}, end: {_id:4655}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"concept correction,terminology", weight:1.0, description:"Original erroneous term \"peace festival\" was replaced with \"Limitless Field\" to accurately reflect the intended concept.", created_at:1779453162, source_id:"chunk-f1f81e864da7b8ec0ed93a28a3397730"}}, {start: {_id:3294}, end: {_id:5322}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"elimination of bias,unity", truncate:"", weight:1.0, description:"True Oneness dissolves racial discrimination by fostering interconnectedness.", created_at:1779453287, source_id:"chunk-a85ada8ef40f654a099ee00af9f2432f"}}, {start: {_id:486}, end: {_id:5321}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"cultural context,socioeconomic inequality", weight:1.0, description:"India exemplifies wealth discrimination through historical and systemic factors.", created_at:1779453287, source_id:"chunk-a85ada8ef40f654a099ee00af9f2432f"}}, {start: {_id:5332}, end: {_id:5315}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"spiritual growth,transcendence", weight:1.0, description:"Awakening consciousness enables the realization of extraordinary peace.", created_at:1779453287, source_id:"chunk-a85ada8ef40f654a099ee00af9f2432f"}}, {start: {_id:1517}, end: {_id:5334}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"causes,social strife", truncate:"", weight:1.0, description:"Conflict stems from self-imposed divisions and separation.", created_at:1779453288, source_id:"chunk-a85ada8ef40f654a099ee00af9f2432f"}}, {start: {_id:5333}, end: {_id:755}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"emotional harmony,foundation", weight:1.0, description:"Peace emerges through authentic connection and compassionate love.", created_at:1779453288, source_id:"chunk-a85ada8ef40f654a099ee00af9f2432f"}}, {start: {_id:3291}, end: {_id:5322}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"equality,social harmony", truncate:"", weight:1.0, description:"Awakening to oneness eradicates caste-based divisions.", created_at:1779453288, source_id:"chunk-a85ada8ef40f654a099ee00af9f2432f"}}, {start: {_id:5335}, end: {_id:765}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"inferiority,superiority", truncate:"", weight:1.0, description:"Discrimination arises from distorted self-perception and comparison.", created_at:1779453288, source_id:"chunk-a85ada8ef40f654a099ee00af9f2432f"}}, {start: {_id:5322}, end: {_id:5321}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"economic justice,shared humanity", weight:1.0, description:"Oneness promotes fairness over wealth-based hierarchies.", created_at:1779453288, source_id:"chunk-a85ada8ef40f654a099ee00af9f2432f"}}, {start: {_id:1474}, end: {_id:5323}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"consciousness,state", truncate:"", weight:1.0, description:"Awakening is a state of being that can be achieved by the human species.", created_at:1779453404, source_id:"chunk-33d7c3c80b54f2e14938cedf8a3a292d"}}, {start: {_id:5336}, end: {_id:2544}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"lack of understanding,unawareness", weight:1.0, description:"Unawakened consciousness lacks understanding of the interconnection of the universe.", created_at:1779453404, source_id:"chunk-33d7c3c80b54f2e14938cedf8a3a292d"}}, {start: {_id:5323}, end: {_id:2544}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"consciousness,state", truncate:"", weight:1.0, description:"The human species can exist in a state of unawakened consciousness.", created_at:1779453405, source_id:"chunk-33d7c3c80b54f2e14938cedf8a3a292d"}}, {start: {_id:1474}, end: {_id:5336}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"interconnectedness,understanding", weight:1.0, description:"Awakening leads to the understanding of the interconnection of the universe.", created_at:1779453405, source_id:"chunk-33d7c3c80b54f2e14938cedf8a3a292d"}}, {start: {_id:158}, end: {_id:936}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"origin,source", weight:1.0, description:"Problems arise from the state of separation and division.", created_at:1779453405, source_id:"chunk-33d7c3c80b54f2e14938cedf8a3a292d"}}, {start: {_id:1474}, end: {_id:5337}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"communication,understanding", truncate:"", weight:1.0, description:"Awakening leads to the understanding of the communication between the universe.", created_at:1779453405, source_id:"chunk-33d7c3c80b54f2e14938cedf8a3a292d"}}, {start: {_id:5339}, end: {_id:5340}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"ethical imperative,societal harmony", weight:1.0, description:"Mutual care is presented as essential for achieving authentic peace.", created_at:1779453507, source_id:"chunk-1756c3e8d7e9eefbffb3f49a179b77fc"}}, {start: {_id:5315}, end: {_id:5325}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"conceptual contrast,transformative potential", weight:1.0, description:"The text distinguishes superficial peace from profound spiritual unity.", created_at:1779453507, source_id:"chunk-1756c3e8d7e9eefbffb3f49a179b77fc"}}, {start: {_id:3643}, end: {_id:5338}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"existential priorities,societal norms", weight:1.0, description:"Current human existence is dominated by materialistic pursuits like wealth accumulation.", created_at:1779453507, source_id:"chunk-1756c3e8d7e9eefbffb3f49a179b77fc"}}, {start: {_id:158}, end: {_id:2544}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"conflict manifestation,pain", weight:1.0, description:"Global challenges stem from collective unconsciousness filled with discord.", created_at:1779453507, source_id:"chunk-1756c3e8d7e9eefbffb3f49a179b77fc"}}, {start: {_id:4394}, end: {_id:116}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"cosmic unity,universal interdependence", weight:1.0, description:"The universe is portrayed as fundamentally interconnected, with all beings sharing an intrinsic bond.", created_at:1779453507, source_id:"chunk-1756c3e8d7e9eefbffb3f49a179b77fc"}}] AS row
