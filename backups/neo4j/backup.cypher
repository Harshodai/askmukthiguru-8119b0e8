UNWIND [{start: {_id:916}, end: {_id:2753}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"duality,opposites", weight:1.0, description:"Pleasure and pain are presented as dualistic experiences arising from the same imaginative processes.", created_at:1779556073, source_id:"chunk-2d8b862305b33bd0f79f0f3bd76e8c3a"}}, {start: {_id:6107}, end: {_id:916}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"creates,generates", weight:1.0, description:"Imagination also generates suffering states through the mind's habit-driven processes.", created_at:1779556073, source_id:"chunk-2d8b862305b33bd0f79f0f3bd76e8c3a"}}, {start: {_id:6107}, end: {_id:499}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"linked to,unreal", truncate:"", weight:1.0, description:"Stress is described as an unreal experience built on the same imaginative processes as pleasure and pain.", created_at:1779556073, source_id:"chunk-2d8b862305b33bd0f79f0f3bd76e8c3a"}}, {start: {_id:6218}, end: {_id:916}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"affects,shrinks", weight:1.0, description:"Pain causes the illusory ego to feel shrunk and inferior.", created_at:1779556073, source_id:"chunk-2d8b862305b33bd0f79f0f3bd76e8c3a"}}, {start: {_id:742}, end: {_id:916}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"liberates,overcomes", truncate:"", weight:1.0, description:"Awareness also dissolves the fear of suffering by recognizing its illusory nature.", created_at:1779556073, source_id:"chunk-2d8b862305b33bd0f79f0f3bd76e8c3a"}}, {start: {_id:1071}, end: {_id:6221}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"assimilation,natural cycle", weight:1.0, description:"Leaves are naturally digested by the Earth, sustaining ecological balance through nutrient recycling.", created_at:1779556194, source_id:"chunk-fd5ce10ac8b9d8fd71b9d99f866818d3"}}, {start: {_id:144}, end: {_id:6225}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"non-comparison,transcendent presence", weight:1.0, description:"Beautiful states emerge from being present to various aspects of life, free from divisive comparisons.", created_at:1779556194, source_id:"chunk-fd5ce10ac8b9d8fd71b9d99f866818d3"}}, {start: {_id:6219}, end: {_id:6226}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"emotional response,self-perception", weight:1.0, description:"The illusory sense of self triggers negative emotions like jealousy or anger when perceived as lesser than others.", created_at:1779556194, source_id:"chunk-fd5ce10ac8b9d8fd71b9d99f866818d3"}}, {start: {_id:6224}, end: {_id:409}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"emotional release,symbolic contrast", weight:1.0, description:"The metaphor contrasts natural cycles (leaves) with human stagnation (plastic) to illustrate overcoming past fixation.", created_at:1779556194, source_id:"chunk-fd5ce10ac8b9d8fd71b9d99f866818d3"}}, {start: {_id:1071}, end: {_id:6222}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"ecological disruption,human impact", weight:1.0, description:"Plastic resists assimilation, symbolizing human waste that harms natural systems.", created_at:1779556194, source_id:"chunk-fd5ce10ac8b9d8fd71b9d99f866818d3"}}, {start: {_id:6222}, end: {_id:1932}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"assimilation failure,symbolism", weight:1.0, description:"Plastic near a tree symbolizes unassimilated experiences choking life, mirroring how unprocessed experiences harm growth.", created_at:1779556213, source_id:"chunk-6d16539213ab1e4cb0268da2ab5977c1"}}, {start: {_id:5902}, end: {_id:1249}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"neutrality,perception", truncate:"", weight:1.0, description:"Expanded consciousness allows perception of reality as it is, without hierarchical distortion.", created_at:1779556213, source_id:"chunk-6d16539213ab1e4cb0268da2ab5977c1"}}, {start: {_id:157}, end: {_id:6112}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"exaggeration,fear projection", weight:1.0, description:"Challenges are perceived as exaggerated threats (lizards as Godzilla) without conscious awareness.", created_at:1779556213, source_id:"chunk-6d16539213ab1e4cb0268da2ab5977c1"}}, {start: {_id:6103}, end: {_id:6008}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"assimilation,transformation", truncate:"", weight:1.0, description:"Enlightened awareness assimilates past experiences into personal strength rather than letting them choke.", created_at:1779556213, source_id:"chunk-6d16539213ab1e4cb0268da2ab5977c1"}}, {start: {_id:5902}, end: {_id:6223}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"equality,non-judgment", truncate:"", weight:1.0, description:"In expanded consciousness, all situations and entities are seen as neither superior nor inferior.", created_at:1779556213, source_id:"chunk-6d16539213ab1e4cb0268da2ab5977c1"}}, {start: {_id:6103}, end: {_id:5902}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"perception,state alignment", weight:1.0, description:"Enlightened awareness aligns with expanded consciousness, enabling undistorted reality perception.", created_at:1779556214, source_id:"chunk-6d16539213ab1e4cb0268da2ab5977c1"}}, {start: {_id:2391}, end: {_id:115}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)<SEP>unknown_source", truncate:"", keywords:"abstract idea,fearlessness,liberation,philosophical concept", weight:2.0, description:"Enlightenment is fundamentally about experiencing freedom from mental constraints.<SEP>Enlightenment eliminates fear and fosters freedom through present-moment awareness.", created_at:1779556412, source_id:"chunk-922e23e61222fa7ebaae80af23f09b19<SEP>chunk-e2d0ff9dea6a5334fbc3569bce6e4413"}}, {start: {_id:5614}, end: {_id:6227}, properties:{file_path:"unknown_source", keywords:"dopamine-driven,romantic obsession", truncate:"", weight:1.0, description:"Tulsidas experiences intense romantic love linked to dopamine release, driving obsessive behavior.", created_at:1779556407, source_id:"chunk-0443cca2d76c87663467e3610969c2ba"}}, {start: {_id:6232}, end: {_id:6233}, properties:{file_path:"unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", keywords:"bonding,demonstration,example,natural nurturing", truncate:"", weight:2.0, description:"The mother cow's care for her calf exemplifies natural bonding critical for healthy development.<SEP>Mother cow's care for her calf exemplifies the importance of physical touch for infants, as referenced in the narrative.", created_at:1779557032, source_id:"chunk-0443cca2d76c87663467e3610969c2ba<SEP>chunk-9c98dc777cc549809cb267c54df4e36b"}}, {start: {_id:2391}, end: {_id:6229}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"metaphorical contrast,psychological concept", weight:1.0, description:"Enlightenment involves breaking free from the cyclical nature of the past mind.", created_at:1779556408, source_id:"chunk-922e23e61222fa7ebaae80af23f09b19"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
