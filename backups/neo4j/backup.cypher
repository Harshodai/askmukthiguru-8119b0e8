UNWIND [{start: {name:"Beautiful State"}, end: {_id:155}, properties:{file_path:"unknown_source<SEP>YouTube Video: XFFgRTgP8Rs (URL: https://www.youtube.com/watch?v=XFFgRTgP8Rs)", keywords:"approach,contrast,empowerment,outcomes,problem-solving,response framework", truncate:"", weight:3.0, created_at:1779519723, description:"Living in a beautiful state enables creative solutions to challenges and dissolves barriers to progress.<SEP>Addressing problems from beautiful states leads to healing and clarity versus suffering?s chaos.<SEP>The problem persists because people don't address it from the beautiful state.", source_id:"chunk-ddc2a8c2bf46af1d243c4bae41044efd<SEP>chunk-98ebbba09ead01df2486b7e4f58bcc9b<SEP>chunk-53efe9fd171ffdc347c0abe139250e7d"}}, {start: {name:"Ekam"}, end: {_id:62}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", keywords:"association,construction,domain-specific term,leadership,organizational affiliation,rebellion,shared goals,spiritual concept,spiritual leadership,vision", truncate:"", weight:6.0, description:"Preethaji envisioned and oversaw the construction of Ekam to serve as a sacred structure for human consciousness transformation.<SEP>Preethaji is associated with the domain-specific term Ekam, which is correctly used.<SEP>Preethaji and Ekam are associated with the academy, and Preethaji wants the students, seekers, and Deeksha givers to do something.<SEP>Preethaji is associated with Ekam (the academy) as a leader.<SEP>Preethaji is associated with Ekam academy as its spiritual leader.", created_at:1779257820, source_id:"chunk-08a8bfd8ab34e14f6fb9afe4224d7966<SEP>chunk-87a42eb6572d13c3b49d24da9eb84c9b<SEP>chunk-daf915b21797ffa8160181c2f2ccf170<SEP>chunk-50f9429535917e274bee7a3453149639"}}, {start: {name:"Beautiful State"}, end: {_id:124}, properties:{file_path:"unknown_source", keywords:"human experience,spiritual concept", truncate:"", weight:1.0, description:"The beautiful state aligns with the pursuit of a transformed consciousness free from suffering.", created_at:1779183572, source_id:"chunk-81f7d5b351616383eb1a7cca9b4d2b48"}}, {start: {name:"Beautiful State"}, end: {_id:2798}, properties:{file_path:"unknown_source", keywords:"characteristic,embodiment", truncate:"", weight:1.0, description:"The beautiful state is characterized by inner simplicity and uncluttered mind.", created_at:1779183593, source_id:"chunk-8b68736730809289d016abf18cb33a9d"}}, {start: {name:"Beautiful State"}, end: {_id:2800}, properties:{file_path:"unknown_source", keywords:"characteristic,outcome", truncate:"", weight:1.0, description:"The beautiful state enables decisive and powerful actions through clarity of mind.", created_at:1779183593, source_id:"chunk-8b68736730809289d016abf18cb33a9d"}}, {start: {name:"Ekam"}, end: {_id:2814}, properties:{file_path:"unknown_source", keywords:"meditation purpose,spiritual goal", truncate:"", weight:1.0, description:"Ekam serves as a destination for meditation aimed at achieving world peace.", created_at:1779183712, source_id:"chunk-e48cb770a294a3d305875880cc43095f"}}, {start: {name:"Suffering"}, end: {_id:377}, properties:{file_path:"unknown_source", keywords:"emotional state,pain perpetuation", truncate:"", weight:1.0, description:"The wounded child state perpetuates suffering and loneliness, affecting present interactions.", created_at:1779183840, source_id:"chunk-5d0f74c4239eabf7a6fea87da28be5d8"}}, {start: {name:"Mantra"}, end: {_id:2175}, properties:{file_path:"unknown_source", truncate:"", keywords:"practice component,verbal affirmation", weight:1.0, description:"The meditation practice includes repeating a specific mantra to facilitate the process.", created_at:1779184400, source_id:"chunk-0f072682ae3f44593523bf73ac3ea68d"}}, {start: {name:"Beautiful State"}, end: {_id:1176}, properties:{file_path:"unknown_source", keywords:"holistic consideration", truncate:"", weight:1.0, description:"In a beautiful state, actions naturally balance self and others' well-being.", created_at:1779187362, source_id:"chunk-03367dd9ee49f7699a39e3df3605c23c"}}, {start: {name:"Beautiful State"}, end: {_id:2978}, properties:{file_path:"unknown_source", keywords:"positive outcome,pursuit state", truncate:"", weight:1.0, description:"Each of the four prime pursuits can be pursued from a beautiful state, leading to positive outcomes.", created_at:1779187599, source_id:"chunk-dc9927460d19d840d6ca22cca3f93322"}}, {start: {name:"Beautiful State"}, end: {_id:3002}, properties:{file_path:"unknown_source", keywords:"fulfillment,harmony", truncate:"", weight:1.0, description:"Pursuing purpose from the Beautiful State fosters harmony and fulfillment.` - Correct.", created_at:1779187669, source_id:"chunk-be5de8ed1db1e01f9ee5a260fb8d11ce"}}, {start: {name:"Beautiful State"}, end: {_id:186}, properties:{file_path:"unknown_source", keywords:"inspiration,positive alignment", truncate:"", weight:1.0, description:"The beautiful state aligns work with universal intelligence, fostering creativity and purpose.", created_at:1779187669, source_id:"chunk-b46675c05bfa30223c5b090123b0a08b"}}, {start: {name:"Beautiful State"}, end: {_id:785}, properties:{file_path:"unknown_source", keywords:"alignment,synergy", truncate:"", weight:1.0, description:"The beautiful state harmonizes with universal intelligence, enabling inspired outcomes.", created_at:1779187669, source_id:"chunk-b46675c05bfa30223c5b090123b0a08b"}}, {start: {name:"Consciousness"}, end: {_id:3032}, properties:{file_path:"unknown_source", keywords:"all that is,encompasses", truncate:"", weight:1.0, description:"Consciousness encompasses all existence, with individuals being part of it.", created_at:1779187966, source_id:"chunk-0ee45ed086ccf00bec8f02b0098563bd"}}, {start: {name:"Consciousness"}, end: {_id:145}, properties:{file_path:"unknown_source", keywords:"physical vs. experiential", truncate:"", weight:1.0, description:"Consciousness manifests physically (sensory experience) and experientially (subjective interpretation). Suering states arise from misalignment with universal intelligence.", created_at:1779188048, source_id:"chunk-07bbbe415fc6ff4eb6e48c047d81efd5"}}, {start: {name:"Consciousness"}, end: {_id:50}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=JYqlxlBZHc4)", keywords:"awareness,transformation", truncate:"", weight:1.0, description:"The man's heightened consciousness creates synchronicities in his life.", created_at:1779188834, source_id:"chunk-165a6947c193c6485a15dca83d2b7887"}}, {start: {name:"Ekam"}, end: {_id:3163}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=y4ZR5U8VuQY)<SEP>YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=aSNQUkuyB18)", truncate:"", keywords:"capitalization,correction,correction task,linguistic adjustment,misheard term,term correction", weight:7.0, description:"\"ekam\" is corrected to \"Ekam\" as per the provided list.<SEP>\"Ekam\" is the correct capitalized version replacing lowercase \"ekam\" in the text.<SEP>\"Ekam\" is the correct capitalized version replacing lowercase \"ekam\" in the text.<SEP>ekam is a misheard version of Ekam.<SEP>ekam is a misheard version of Ekam.", created_at:1779737814, source_id:"chunk-d22846f24d18f20fdaf21ce0958a7d11<SEP>chunk-49b001b9176c6f2a9840cbab29ab25fc<SEP>chunk-5797c6b92be5c0efc461bac799bf75df"}}, {start: {name:"Deeksha"}, end: {_id:3170}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=y4ZR5U8VuQY)", truncate:"", keywords:"capitalization,term correction", weight:1.0, description:"\"deeksha\" is corrected to \"Deeksha\" for proper noun consistency.", created_at:1779190065, source_id:"chunk-d22846f24d18f20fdaf21ce0958a7d11"}}, {start: {name:"Ekam"}, end: {_id:2097}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com