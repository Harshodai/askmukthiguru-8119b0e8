UNWIND [{start: {_id:1881}, end: {_id:1790}, properties:{file_path:"unknown_source", keywords:"correction,focus", truncate:"", weight:5.0, description:"Punctuation and Capitalization is a focus area for domain-specific terms.", created_at:1779220883, source_id:"chunk-5ee2024af2a8a7300e58c08aea173e13"}}, {start: {_id:360}, end: {_id:761}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", keywords:"division,self-judgment", truncate:"", weight:1.0, description:"Self-criticism generates inner conflict through constant commentary.", created_at:1779220962, source_id:"chunk-f02b83f12f802c289fd8c9176c6dc8a9"}}, {start: {_id:1406}, end: {_id:1617}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", keywords:"origin,progression", truncate:"", weight:1.0, description:"Depression originates in the mind and progresses to affect the brain.", created_at:1779220962, source_id:"chunk-f02b83f12f802c289fd8c9176c6dc8a9"}}, {start: {_id:755}, end: {_id:1469}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", truncate:"", keywords:"conflict resolution,self-acceptance", weight:1.0, description:"Lack of peace leads to inner war and self-division.", created_at:1779220962, source_id:"chunk-f02b83f12f802c289fd8c9176c6dc8a9"}}, {start: {_id:603}, end: {_id:761}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", keywords:"discontent,evaluation", truncate:"", weight:1.0, description:"Self-criticism drives comparison between reality and idealized standards.", created_at:1779220963, source_id:"chunk-f02b83f12f802c289fd8c9176c6dc8a9"}}, {start: {_id:360}, end: {_id:1469}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", keywords:"self-division,strife", truncate:"", weight:1.0, description:"War manifests as inner conflict and division against oneself.", created_at:1779220963, source_id:"chunk-f02b83f12f802c289fd8c9176c6dc8a9"}}, {start: {_id:761}, end: {_id:1469}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", keywords:"division,inner strife", truncate:"", weight:1.0, description:"Self-criticism creates a state of war within oneself.", created_at:1779220963, source_id:"chunk-f02b83f12f802c289fd8c9176c6dc8a9"}}, {start: {_id:479}, end: {_id:1617}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", truncate:"", keywords:"mental recovery", weight:1.0, description:"Healing the mind through observation can resolve depression.", created_at:1779220963, source_id:"chunk-f02b83f12f802c289fd8c9176c6dc8a9"}}, {start: {_id:2187}, end: {_id:761}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", keywords:"disconnection,judgment", truncate:"", weight:1.0, description:"Self-criticism prevents acceptance of experiences as they are.", created_at:1779220963, source_id:"chunk-f02b83f12f802c289fd8c9176c6dc8a9"}}, {start: {_id:788}, end: {_id:479}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", keywords:"neurological recovery", truncate:"", weight:1.0, description:"Healing the mind can lead to brain recovery from depression.", created_at:1779220963, source_id:"chunk-f02b83f12f802c289fd8c9176c6dc8a9"}}, {start: {_id:32}, end: {_id:761}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", truncate:"", keywords:"disengagement,lack of fulfillment", weight:1.0, description:"Self-criticism undermines sense of purpose at work.", created_at:1779220963, source_id:"chunk-f02b83f12f802c289fd8c9176c6dc8a9"}}, {start: {_id:2703}, end: {_id:761}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", keywords:"inhibition,stagnation", truncate:"", weight:1.0, description:"Self-criticism stifles creativity and engagement with work.", created_at:1779220963, source_id:"chunk-f02b83f12f802c289fd8c9176c6dc8a9"}}, {start: {_id:755}, end: {_id:761}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", keywords:"self-acceptance,self-judgment", truncate:"", weight:1.0, description:"Lack of self-acceptance (peace) directly leads to self-criticism and judgment of oneself.", created_at:1779220963, source_id:"chunk-f02b83f12f802c289fd8c9176c6dc8a9"}}, {start: {_id:2192}, end: {_id:761}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", truncate:"", keywords:"internal conflict,self-judgment", weight:1.0, description:"The inner critic manifests as persistent self-criticism, perpetuating inner conflict.", created_at:1779221016, source_id:"chunk-a5d16b7b208928b7a3800de53c2fa4eb"}}, {start: {_id:870}, end: {_id:479}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", keywords:"self-compassion,wholeness", truncate:"", weight:1.0, description:"Accepting failures and defeats promotes healing through self-compassion and wholeness.", created_at:1779221016, source_id:"chunk-a5d16b7b208928b7a3800de53c2fa4eb"}}, {start: {_id:741}, end: {_id:39}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", keywords:"fulfillment,self-realization", truncate:"", weight:1.0, description:"Joy and fulfillment emerge when one feels at \"home\" in their authentic self.", created_at:1779221016, source_id:"chunk-a5d16b7b208928b7a3800de53c2fa4eb"}}, {start: {_id:40}, end: {_id:2194}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", truncate:"", keywords:"emotional balance,mindfulness", weight:1.0, description:"Observing one's inner state leads to a calm and balanced emotional state.", created_at:1779221016, source_id:"chunk-a5d16b7b208928b7a3800de53c2fa4eb"}}, {start: {_id:742}, end: {_id:761}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", keywords:"detachment,non-judgment", truncate:"", weight:1.0, description:"Awareness dissolves self-criticism by fostering detachment and non-judgmental observation.", created_at:1779221016, source_id:"chunk-a5d16b7b208928b7a3800de53c2fa4eb"}}, {start: {_id:479}, end: {_id:741}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", keywords:"belonging,inner peace", truncate:"", weight:1.0, description:"Healing leads to a sense of belonging and being at \"home\" in oneself.", created_at:1779221016, source_id:"chunk-a5d16b7b208928b7a3800de53c2fa4eb"}}, {start: {_id:40}, end: {_id:479}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", truncate:"", keywords:"inner peace,self-acceptance", weight:1.0, description:"Calmness radiates from a healed state of self-acceptance and inner peace.", created_at:1779221016, source_id:"chunk-a5d16b7b208928b7a3800de53c2fa4eb"}}] AS row
