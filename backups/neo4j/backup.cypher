UNWIND [{start: {_id:852}, end: {_id:1283}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"emotional cause,psychological effect", weight:1.0, description:"Insecurity leads to fear.", created_at:1779192822, source_id:"chunk-f97c33bc1c34505752dbdf13ce792596"}}, {start: {_id:3319}, end: {_id:852}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"emotional cause,psychological effect", created_at:1779192822, weight:1.0, description:"Anger and insecurity lead to fear.", source_id:"chunk-f97c33bc1c34505752dbdf13ce792596"}}, {start: {_id:89}, end: {_id:3321}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"cultural transmission,generational impact", weight:1.0, description:"The fires of discrimination are passed down through stories, leading to emotions like anger.", created_at:1779192876, source_id:"chunk-1a2d9f9a94f699ed87aa72d476d3870c"}}, {start: {_id:3320}, end: {_id:3324}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"discrimination basis,societal issue", weight:1.0, description:"Most nations discriminate on the basis of gender, which is a form of societal discrimination.", created_at:1779192876, source_id:"chunk-1a2d9f9a94f699ed87aa72d476d3870c"}}, {start: {_id:3325}, end: {_id:1982}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"discussion,video", weight:1.0, description:"YouTube is the source of the video content that discusses discrimination and its impacts.", created_at:1779192876, source_id:"chunk-1a2d9f9a94f699ed87aa72d476d3870c"}}, {start: {_id:3323}, end: {_id:3090}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"emotional impact,generational trauma", weight:1.0, description:"Discrimination leads to negative emotions like anger, insecurity, hate, and violence, which are passed down through generations.", created_at:1779192876, source_id:"chunk-1a2d9f9a94f699ed87aa72d476d3870c"}}, {start: {_id:3090}, end: {_id:3321}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"conceptual link,societal problem", weight:1.0, description:"The concept of discrimination is linked to the fires of discrimination, which represent a state of societal conflict.", created_at:1779192876, source_id:"chunk-1a2d9f9a94f699ed87aa72d476d3870c"}}, {start: {_id:3090}, end: {_id:3322}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"catalyst,trigger", weight:1.0, description:"Discrimination is a background issue that can be triggered by a painful event like Flesh Set-Up, bringing emotions to the surface.", created_at:1779192877, source_id:"chunk-1a2d9f9a94f699ed87aa72d476d3870c"}}, {start: {_id:3290}, end: {_id:3305}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"change,method", weight:1.0, description:"Inner Evolution is associated with peaceful methods as a way to bring about change.", created_at:1779192877, source_id:"chunk-1a2d9f9a94f699ed87aa72d476d3870c"}}, {start: {_id:89}, end: {_id:3271}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"emotional driver,societal impact", weight:1.0, description:"Anger and hate are described as prerequisites for violent acts like throat-crushing and arson.", created_at:1779193196, source_id:"chunk-638abb6fbdf727a0284e50fe14e82b1f"}}, {start: {_id:292}, end: {_id:3270}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", keywords:"cause,emotional driver", truncate:"", weight:1.0, description:"Hate drives racial violence, contributing to its recurrence.", created_at:1779193196, source_id:"chunk-638abb6fbdf727a0284e50fe14e82b1f"}}, {start: {_id:89}, end: {_id:3270}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", keywords:"cause,emotional driver", truncate:"", weight:1.0, description:"Anger and hate are prerequisites for racial violence, leading to its eruption.", created_at:1779193196, source_id:"chunk-638abb6fbdf727a0284e50fe14e82b1f"}}, {start: {_id:3284}, end: {_id:3271}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"conflict perpetuation,social consequences", weight:1.0, description:"Prejudices manifest as violence, both overt and covert, perpetuating cycles of discrimination.", created_at:1779193256, source_id:"chunk-0cb21e09915c74bf08c75e2e9b3c1480"}}, {start: {_id:3327}, end: {_id:3326}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"self-reflection,societal change", weight:1.0, description:"The nation must confront its prejudices and enter the crucible of truth for transformative societal change.", created_at:1779193256, source_id:"chunk-0cb21e09915c74bf08c75e2e9b3c1480"}}, {start: {_id:3090}, end: {_id:486}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", keywords:"caste discrimination", truncate:"", weight:1.0, description:"India's discrimination is based on caste, as highlighted in the text.", created_at:1779193256, source_id:"chunk-0cb21e09915c74bf08c75e2e9b3c1480"}}, {start: {_id:3257}, end: {_id:3090}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", keywords:"class discrimination", truncate:"", weight:1.0, description:"China's discrimination is based on class, as mentioned in the text."