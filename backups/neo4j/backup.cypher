UNWIND [{start: {_id:2000}, end: {_id:577}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", keywords:"affected by,impact", truncate:"", weight:1.0, description:"Mental health is affected by negative emotions, which are reinforced by the brain's negativity bias.", created_at:1779154408, source_id:"chunk-f82fe879a5991d902752f3c7f1e83fb7"}}, {start: {_id:704}, end: {_id:404}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", truncate:"", keywords:"method,neurological activity", weight:2.0, description:"Observation helps reduce amygdala activity by shifting focus to the prefrontal cortex.<SEP>Observation reduces amygdala activity by shifting focus to the prefrontal cortex.", created_at:1779154408, source_id:"chunk-f82fe879a5991d902752f3c7f1e83fb7"}}, {start: {_id:404}, end: {_id:2001}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", truncate:"", keywords:"method,neurological activity", weight:2.0, description:"Observation enhances prefrontal cortex activity by shifting focus away from the amygdala.<SEP>Observation increases prefrontal cortex activity by shifting focus from the amygdala.", created_at:1779154408, source_id:"chunk-f82fe879a5991d902752f3c7f1e83fb7"}}, {start: {_id:704}, end: {_id:2001}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", truncate:"", keywords:"activity shift,method,neurological shift", weight:2.0, description:"Activity shifts from the amygdala to the prefrontal cortex through observation.<SEP>Activity should shift from the amygdala to the prefrontal cortex for logical thinking.", created_at:1779154652, source_id:"chunk-f82fe879a5991d902752f3c7f1e83fb7<SEP>chunk-22f4f001e75bdf8bb249d6c2ed547355"}}, {start: {_id:2024}, end: {_id:404}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", truncate:"", keywords:"activity shift,enables,method,neurological shift", weight:2.0, description:"Observation is the method used to achieve the neurological shift from the amygdala to the prefrontal cortex.<SEP>Observation enables the neurological shift by shifting focus from the amygdala to the prefrontal cortex.", created_at:1779154409, source_id:"chunk-f82fe879a5991d902752f3c7f1e83fb7"}}, {start: {_id:1068}, end: {_id:2000}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", keywords:"affected by,impact", truncate:"", weight:1.0, description:"The human brain's negativity bias affects mental health by reinforcing unpleasant memories.", created_at:1779154409, source_id:"chunk-f82fe879a5991d902752f3c7f1e83fb7"}}, {start: {_id:577}, end: {_id:404}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", truncate:"", keywords:"awareness,naming", weight:1.0, description:"Observation allows for naming negative emotions like anger, anxiety, or sadness without changing them.", created_at:1779154409, source_id:"chunk-f82fe879a5991d902752f3c7f1e83fb7"}}, {start: {_id:704}, end: {_id:1068}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", truncate:"", keywords:"negative attraction,neurological bias", weight:1.0, description:"The human brain's natural attraction to negative stimuli is mediated by the amygdala.", created_at:1779154409, source_id:"chunk-f82fe879a5991d902752f3c7f1e83fb7"}}, {start: {_id:2024}, end: {_id:579}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", keywords:"activity shift,enables", truncate:"", weight:1.0, description:"Being in the present moment enables the neurological shift by focusing attention away from negative mental movies.", created_at:1779154409, source_id:"chunk-f82fe879a5991d902752f3c7f1e83fb7"}}, {start: {_id:704}, end: {_id:2024}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", truncate:"", keywords:"activity source,neurological shift", weight:1.0, description:"The amygdala is the activity source that can be shifted to the prefrontal cortex through observation.", created_at:1779154409, source_id:"chunk-f82fe879a5991d902752f3c7f1e83fb7"}}, {start: {_id:89}, end: {_id:2027}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", truncate:"", keywords:"emotional awareness,observation", weight:1.0, description:"Anger is observed as a transient emotion without judgment during the practice.", created_at:1779154447, source_id:"chunk-dd06aca0e8b0e45b68bcb022e995fab4"}}, {start: {_id:496}, end: {_id:2027}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", truncate:"", keywords:"emotional awareness,observation", weight:1.0, description:"Anxiety is acknowledged and observed as part of the practice's non-reactive approach.", created_at:1779154447, source_id:"chunk-dd06aca0e8b0e45b68bcb022e995fab4"}}, {start: {_id:2027}, end: {_id:2028}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", truncate:"", keywords:"emotional awareness,observation", weight:1.0, description:"Sadness is included in the practice's framework for neutral observation.", created_at:1779154447, source_id:"chunk-dd06aca0e8b0e45b68bcb022e995fab4"}}, {start: {_id:2027}, end: {_id:2026}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", keywords:"focus,visualization", truncate:"", weight:1.0, description:"The practice incorporates visualizing a tiny flame at the eyebrow center to anchor awareness and promote calmness.", created_at:1779154447, source_id:"chunk-dd06aca0e8b0e45b68bcb022e995fab4"}}, {start: {_id:2032}, end: {_id:2034}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", keywords:"correction,mishearing", truncate:"", weight:1.0, description:"The phrase \"freedom is a choice of negative emotions and only the wise naked\" contains a mishearing where \"naked\" should be corrected to \"na?ve\" for clarity and context.>", created_at:1779154493, source_id:"chunk-63d51e5603b1ddfb42503cb776ec9717"}}, {start: {_id:2033}, end: {_id:2035}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", truncate:"", keywords:"material reference,noun usage", weight:1.0, description:"Velcro is referenced as a noun to describe a material or texture, highlighting its use in the phrase \"like a velcro.\">", created_at:1779154493, source_id:"chunk-63d51e5603b1ddfb42503cb776ec9717"}}, {start: {_id:348}, end: {_id:2035}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", keywords:"analogy,discussion", truncate:"", weight:1.0, description:"The video discusses the use of \"velcro\" as an analogy for negative emotions, noting its potential inaccuracy.", created_at:1779154524, source_id:"chunk-0de2aa96810cf511e8f01e5a2ce5d71a"}}, {start: {_id:1999}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)", truncate:"", keywords:"correct usage,technical term", weight:1.0, description:"The video correctly references \"Teflon\" as a non-stick coating material.", created_at:1779154524, source_id:"chunk-0de2aa96810cf511e8f01e5a2ce5d71a"}}, {start: {_id:1451}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=B8wapoLAu84)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"content origin,reference,video analysis", weight:2.0, description:"The YouTube video serves as the source material containing the discussed text and concepts.<SEP>The YouTube video serves as the source material for the author's discussion on text errors.", created_