UNWIND [{start: {_id:5636}, end: {_id:781}, properties:{file_path:"unknown_source", keywords:"emotional healing,self-compassion", truncate:"", weight:1.0, description:"Forgiving oneself fosters inner peace, which radiates to families and the world through interconnected consciousness.", created_at:1779520409, source_id:"chunk-d3d330d042772c704e2fd89e4454d795"}}, {start: {_id:5643}, end: {_id:5645}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", keywords:"causation,self-harm", truncate:"", weight:1.0, description:"Inner unhappiness leads to self-inflicted violence, as running from unhappiness results in violence inflicted on oneself.", created_at:1779520474, source_id:"chunk-2225477f1ce6601f366c9da4b0d0f105"}}, {start: {_id:5636}, end: {_id:5637}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", truncate:"", keywords:"concept,pillar", weight:1.0, description:"The Temple of Peace is composed of the pillar of forgiveness of oneself.", created_at:1779520474, source_id:"chunk-2225477f1ce6601f366c9da4b0d0f105"}}, {start: {_id:3877}, end: {_id:348}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", truncate:"", keywords:"content,event", weight:2.0, description:"International World Peace Day is covered in the YouTube video, which discusses the four pillars of peace.<SEP>The YouTube video is about International World Peace Day and its four pillars.", created_at:1779520474, source_id:"chunk-2225477f1ce6601f366c9da4b0d0f105"}}, {start: {_id:5639}, end: {_id:5637}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", truncate:"", keywords:"concept,pillar", weight:1.0, description:"The Temple of Peace includes the pillar of non-judgment of others.", created_at:1779520475, source_id:"chunk-2225477f1ce6601f366c9da4b0d0f105"}}, {start: {_id:5638}, end: {_id:5637}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", truncate:"", keywords:"concept,pillar", weight:1.0, description:"The Temple of Peace incorporates the pillar of peace education for children.", created_at:1779520475, source_id:"chunk-2225477f1ce6601f366c9da4b0d0f105"}}, {start: {_id:5644}, end: {_id:5637}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", truncate:"", keywords:"concept,pillar", weight:1.0, description:"The Temple of Peace features the pillar of meditation for world peace.", created_at:1779520475, source_id:"chunk-2225477f1ce6601f366c9da4b0d0f105"}}, {start: {_id:2391}, end: {_id:579}, properties:{file_path:"YouTube Video: 6j6EGVpQkI8 (URL: https://www.youtube.com/watch?v=6j6EGVpQkI8)", truncate:"", keywords:"mindfulness,temporal focus", weight:1.0, description:"Enlightenment involves living in the present moment with intense awareness, free from preoccupation with past or future.", created_at:1779520523, source_id:"chunk-e56919e461f379123fc8b4b2380a2a52"}}, {start: {_id:2391}, end: {_id:2364}, properties:{file_path:"YouTube Video: 6j6EGVpQkI8 (URL: https://www.youtube.com/watch?v=6j6EGVpQkI8)", keywords:"information,neutrality", truncate:"", weight:1.0, description:"In enlightenment, thoughts are observed as information without emotional charge or compulsion.", created_at:1779520523, source_id:"chunk-e56919e461f379123fc8b4b2380a2a52"}}, {start: {_id:2391}, end: {_id:2367}, properties:{file_path:"YouTube Video: 6j6EGVpQkI8 (URL: https://www.youtube.com/watch?v=6j6EGVpQkI8)", keywords:"detachment,objectivity", truncate:"", weight:1.0, description:"Memories in enlightenment exist as uncharged information, free from emotional influence or preoccupation.", created_at:1779520524, source_id:"chunk-e56919e461f379123fc8b4b2380a2a52"}}, {start: {_id:2391}, end: {_id:5635}, properties:{file_path:"YouTube Video: 6j6EGVpQkI8 (URL: https://www.youtube.com/watch?v=6j6EGVpQkI8)", keywords:"rejection,transcendence", truncate:"", weight:1.0, description:"Enlightenment is distinguished from mere invention, representing an ancient pursuit of unity rather than a new creation.", created_at:1779520524, source_id:"chunk-e56919e461f379123fc8b4b2380a2a52"}}, {start: {_id:5658}, end: {_id:5659}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", truncate:"", keywords:"education impact,prevention", weight:1.0, description:"Teaching children peace and compassion is linked to preventing global conflicts and securing the future.", created_at:1779520556, source_id:"chunk-1229d4c4d857130f683000d1d6617fab"}}, {start: {_id:5660}, end: {_id:5659}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", truncate:"", keywords:"historical reference,prevention", weight:1.0, description:"Fostering peace in children is associated with avoiding destructive historical outcomes like Hitler?s rise.", created_at:1779520556, source_id:"chunk-1229d4c4d857130f683000d1d6617fab"}}, {start: {_id:5661}, end: {_id:5659}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", truncate:"", keywords:"historical reference,inspiration", weight:1.0, description:"Cultivating peace and compassion is likened to nurturing positive historical figures like Gandhi.", created_at:1779520556, source_id:"chunk-1229d4c4d857130f683000d1d6617fab"}}, {start: {_id:5667}, end: {_id:123}, properties:{file_path:"unknown_source", keywords:"conflict,ingrained traits", truncate:"", weight:1.0, description:"Aggression is an inherent trait of humanity that leads to wars.", created_at:1779520631, source_id:"chunk-8ae1e84c94c9daf68cd33af74bbc6fbf"}}, {start: {_id:292}, end: {_id:5669}, properties:{file_path:"unknown_source", keywords:"cause,effect", truncate:"", weight:1.0, description:"Hate increases with each generation of war-mongering.", created_at:1779520631, source_id:"chunk-8ae1e84c94c9daf68cd33af74bbc6fbf"}}, {start: {_id:89}, end: {_id:123}, properties:{file_path:"unknown_source", keywords:"conflict,ingrained traits", truncate:"", weight:1.0, description:"Anger is an inherent trait of humanity that leads to wars.", created_at:1779520631, source_id:"chunk-8ae1e84c94c9daf68cd33af74bbc6fbf"}}, {start: {_id:5667}, end: {_id:5666}, properties:{file_path:"unknown_source", keywords:"conflict,outcome", truncate:"", weight:1.0, description:"Aggression is linked to the Mahabharata war.", created_at:1779520631, source_id:"chunk-8ae1e84c94c9daf68cd33af74bbc6fbf"}}, {start: {_id:5667}, end: {_id:5664}, properties:{file_path:"unknown_source", keywords:"conflict,outcome", truncate:"", weight:1.0, description:"Aggression is linked to World War One.", created_at:1779520631, source_id:"chunk-8ae1e84c94c9daf68cd33af74bbc6fbf"}}, {start: {_id:123}, end: {_id:5668}, properties:{file_path:"unknown_source", keywords:"conflict,ingrained traits", truncate:"", weight:1.0, description:"Territoriality is an inherent trait of humanity that leads to wars.", created_at:1779520631, source_id:"chunk-8ae1e84c94c9daf68cd33af74bbc6fbf"}}] AS row
