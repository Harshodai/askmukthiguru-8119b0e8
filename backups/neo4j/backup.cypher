UNWIND [{start: {_id:748}, end: {_id:4257}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"meditative technique,visualization", weight:1.0, description:"The instruction specifies the method of performing dharana by focusing on a form in the chidakasha or dark space.", created_at:1779259855, source_id:"chunk-ff46b53ab89c597d3fb954e4982613d0"}}, {start: {_id:3473}, end: {_id:4257}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"meditative focus,spatial concept", weight:1.0, description:"The instruction references the chidakasha as the mental space for conducting dharana.", created_at:1779259855, source_id:"chunk-ff46b53ab89c597d3fb954e4982613d0"}}, {start: {_id:3490}, end: {_id:4257}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"meditative focus,spatial concept", weight:1.0, description:"The instruction also references the dark space in front of closed eyes as an alternative focus for dharana.", created_at:1779259855, source_id:"chunk-ff46b53ab89c597d3fb954e4982613d0"}}, {start: {_id:4241}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"content inclusion,textual source", weight:1.0, description:"The video contains the unstructured list of mantra phrases as part of its content.", created_at:1779259903, source_id:"chunk-2e98fa36d7235c33584ec813d1767281"}}, {start: {_id:4257}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"content inclusion,textual source", weight:1.0, description:"The video includes the instructional sentence about meditation practice.", created_at:1779259903, source_id:"chunk-2e98fa36d7235c33584ec813d1767281"}}, {start: {_id:4257}, end: {_id:4241}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"meditation components,thematic link", weight:1.0, description:"Both elements relate to meditation practices but serve distinct roles (recitation vs. visualization).", created_at:1779259903, source_id:"chunk-2e98fa36d7235c33584ec813d1767281"}}, {start: {_id:4259}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"content inclusion,textual source", weight:1.0, description:"The video contains the standalone \"Namaste\" statement as part of its content.", created_at:1779259903, source_id:"chunk-2e98fa36d7235c33584ec813d1767281"}}, {start: {_id:4231}, end: {_id:4258}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"alternative concepts,meditative locations", weight:1.0, description:"Both terms represent spatial focal points in meditation, presented as alternatives in the instruction.", created_at:1779259903, source_id:"chunk-2e98fa36d7235c33584ec813d1767281"}}, {start: {_id:4260}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"structural problem,textual issue", weight:1.0, description:"The video's original text exhibits readability errors requiring correction.", created_at:1779259903, source_id:"chunk-2e98fa36d7235c33584ec813d1767281"}}, {start: {_id:4259}, end: {_id:4258}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"conceptual association,spatial context", weight:1.0, description:"The \"Namaste\" thought is directed at the \"dark space in front of your closed eyes.\"", created_at:1779259903, source_id:"chunk-2e98fa36d7235c33584ec813d1767281"}}, {start: {_id:4257}, end: {_id:4259}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"meditation components,sequential ideas", weight:1.0, description:"The instruction and thought represent consecutive conceptual elements in the meditation process.", created_at:1779259904, source_id:"chunk-2e98fa36d7235c33584ec813d1767281"}}, {start: {_id:4257}, end: {_id:4258}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"content inclusion,spatial reference", weight:1.0, description:"The instruction specifies visualizing \"her form\" in the \"dark space in front of your closed eyes.\"", created_at:1779259904, source_id:"chunk-2e98fa36d7235c33584ec813d1767281"}}, {start: {_id:4257}, end: {_id:4261}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"content inclusion,object of focus", weight:1.0, description:"The directive explicitly references \"her form\" as the meditative object to contemplate.", created_at:1779259904, source_id:"chunk-2e98fa36d7235c33584ec813d1767281"}}, {start: {_id:4257}, end: {_id:849}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"directive,method application", weight:1.0, description:"The phrase \"Do a dharana\" directly applies the meditation technique to the practice.", created_at:1779259904, source_id:"chunk-2e98fa36d7235c33584ec813d1767281"}}, {start: {_id:4264}, end: {_id:4263}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"contains correction,correction", weight:2.0, description:"The term \"a dharana\" is corrected to \"Dharana\" in the corrected mantra.<SEP>The corrected mantra contains the correction of the mishearing.", created_at:1779259926, source_id:"chunk-ff94932b6f3b0d226dc634858c45e539"}}, {start: {_id:4260}, end: {_id:3372}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"causation,problem", weight:2.0, description:"The lack of punctuation in the original mantra is caused by its structure as a run-on sentence.<SEP>The run-on sentence structure is a problem that leads to a readability error.", created_at:1779259926, source_id:"chunk-ff94932b6f3b0d226dc634858c45e539"}}, {start: {_id:4262}, end: {_id:4260}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"solution", weight:1.0, description:"Adding commas is a solution to fix the readability error.", created_at:1779259926, source_id:"chunk-ff94932b6f3b0d226dc634858c45e539"}}, {start: {_id:4264}, end: {_id:4265}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"correction,mantra revision", weight:1.0, description:"Original mantra phrase \"Do a dharana\" was corrected to \"Dharana upon her form in your chidakasha or the dark space in front of your closed eyes.\"", created_at:1779259982, source_id:"chunk-521ddf24bfc548a5754de0c8b7f6c963"}}, {start: {_id:3473}, end: {_id:4264}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"concept inclusion,mantra content", weight:1.0, description:"The corrected mantra includes the concept", created_at:1779259982, source_id:"chunk-521ddf24bfc548a5754de0c8b7f6c963"}}, {start: {_id:1335}, end: {_id:4267}, properties:{file_path:"unknown_source<SEP>YouTube Video: UNdwPjyLGn0 (URL: https://www.youtube.com/watch?v=UNdwPjyLGn0)", keywords:"celebration,enlightenment,event participation", truncate:"", weight:3.0, description:"Buddha Purnima is celebrated in honor of the Buddha's enlightenment and teachings.<SEP>Buddha is associated with Buddha Purnima.", created_at:1779390965, source_id:"chunk-955183a7876a0d1c45e94af3baafdb73<SEP>chunk-49ad825cb7cba993a98976aa8215c0f0"}}] AS row
