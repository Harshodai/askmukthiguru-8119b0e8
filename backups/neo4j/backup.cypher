UNWIND [{start: {_id:1188}, end: {_id:1187}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emulation,identity loss", truncate:"", weight:1.0, description:"Obsessing over a role model leads to adopting their identity and living a secondhand life.", created_at:1779142792, source_id:"chunk-843a288acbc9e654c4e8d31eb046a7fa"}}, {start: {_id:1186}, end: {_id:1185}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"ideal-driven,obsession", truncate:"", weight:1.0, description:"Pursuing an ideal obsessively can lead to an intense fixation on fulfilling it.", created_at:1779142792, source_id:"chunk-843a288acbc9e654c4e8d31eb046a7fa"}}, {start: {_id:1184}, end: {_id:1189}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"defined,governance principles", truncate:"", weight:1.0, description:"Confucius established defined communication language as part of his governance principles to achieve order and virtue.", created_at:1779142792, source_id:"chunk-843a288acbc9e654c4e8d31eb046a7fa"}}, {start: {_id:1183}, end: {_id:1189}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"language rules,system components", truncate:"", weight:1.0, description:"The Confucian system includes defined language for communication as part of its laws, ethics, and principles.", created_at:1779142792, source_id:"chunk-843a288acbc9e654c4e8d31eb046a7fa"}}, {start: {_id:1185}, end: {_id:1187}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"obsession,secondhand life", truncate:"", weight:1.0, description:"Obsession over an ideal or role model can result in living a secondhand life.", created_at:1779142792, source_id:"chunk-843a288acbc9e654c4e8d31eb046a7fa"}}, {start: {_id:1191}, end: {_id:1163}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"moral judgment,questioning", truncate:"", weight:1.0, description:"The royal adviser questioned the young man's decision to report his father.", created_at:1779142829, source_id:"chunk-05a2f5d02725dc2dcf8ad2e755a9ea94"}}, {start: {_id:1184}, end: {_id:82}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"investigation,punishment", truncate:"", weight:1.0, description:"Confucius set a punishment for the thief (father) after the young man's report.", created_at:1779142829, source_id:"chunk-05a2f5d02725dc2dcf8ad2e755a9ea94"}}, {start: {_id:82}, end: {_id:1190}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"starvation,theft", truncate:"", weight:1.0, description:"The father stole the horse due to starvation.", created_at:1779142829, source_id:"chunk-05a2f5d02725dc2dcf8ad2e755a9ea94"}}, {start: {_id:1184}, end: {_id:1163}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"honesty,moral dilemma,reversal", truncate:"", weight:2.0, description:"Confucius reversed his judgment, imprisoning the son instead of the father due to the young man's honesty.<SEP>The young man's honesty in reporting his father led to a moral dilemma for Confucius.", created_at:1779142829, source_id:"chunk-05a2f5d02725dc2dcf8ad2e755a9ea94"}}, {start: {_id:1184}, end: {_id:1190}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"investigation,punishment", truncate:"", weight:1.0, description:"Confucius set a punishment for the thief (father) after the young man's report.", created_at:1779142829, source_id:"chunk-05a2f5d02725dc2dcf8ad2e755a9ea94"}}, {start: {_id:1184}, end: {_id:1194}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"moral judgment,philosophical critique", weight:1.0, description:"Confucius critiques the son's heartless actions and views honesty as dangerous.", created_at:1779142867, source_id:"chunk-5d7bc721d374a5cb0cba9dd3f98f763b"}}, {start: {_id:360}, end: {_id:1143}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"dissolution,prerequisite,self-awareness", truncate:"", weight:2.0, description:"Spiritual right action involves dissolving inner conflict and self-obsession.<SEP>Spiritual right action is performed after dissolving inner conflict, not during it.", created_at:1779187292, source_id:"chunk-5d7bc721d374a5cb0cba9dd3f98f763b<SEP>chunk-37c881d41553a8a7658ca326a33a2864"}}, {start: {_id:506}, end: {_id:1143}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"overcoming,self-awareness", truncate:"", weight:1.0, description:"Spiritual right action requires moving out of self-obsession.", created_at:1779142867, source_id:"chunk-5d7bc721d374a5cb0cba9dd3f98f763b"}}, {start: {_id:1192}, end: {_id:1194}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"moral conflict,obsession", truncate:"", weight:1.0, description:"The son's obsession with honesty leads to moral conflict and inconsiderate behavior.", created_at:1779142867, source_id:"chunk-5d7bc721d374a5cb0cba9dd3f98f763b"}}, {start: {_id:1193}, end: {_id:1143}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"balance,prioritization", truncate:"", weight:1.0, description:"Spiritual right action involves not sacrificing health for ideals.", created_at:1779142868, source_id:"chunk-5d7bc721d374a5cb0cba9dd3f98f763b"}}, {start: {_id:1143}, end: {_id:933}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"balance,prioritization", truncate:"", weight:1.0, description:"Spiritual right action involves not sacrificing wealth for ideals.", created_at:1779142868, source_id:"chunk-5d7bc721d374a5cb0cba9dd3f98f763b"}}, {start: {_id:301}, end: {_id:1143}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"balance,prioritization", truncate:"", weight:1.0, description:"Spiritual right action involves not sacrificing happiness for ideals.", created_at:1779142868, source_id:"chunk-5d7bc721d374a5cb0cba9dd3f98f763b"}}, {start: {_id:1145}, end: {_id:1143}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"spiritual focus,transformation", truncate:"", weight:1.0, description:"The Fourth Sacred Secret centers on transforming oneself through spiritual right action.", created_at:1779142927, source_id:"chunk-97955748a023be133267a7da54bf7347"}}, {start: {_id:1204}, end: {_id:1198}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"interaction,nibbling", truncate:"", weight:1.0, description:"The mice are nibbling on the creeping vine that the protagonist is holding.", created_at:1779142956, source_id:"chunk-351f2fd92d6acb5e48e41564a39fe72b"}}, {start: {_id:1203}, end: {_id:1200}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"danger,predation", truncate:"", weight:1.0, description:"The tiger is positioned above the pit, posing a threat to the protagonist.", created_at:1779142956, source_id:"chunk-351f2fd92d6acb5e48e41564a39fe72b"}}] AS row
