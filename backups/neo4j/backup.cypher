UNWIND [{start: {_id:6866}, end: {_id:6867}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", truncate:"", keywords:"relationship,rule", weight:2.0, description:"Capitalization Rules are related to Punctuation Rules as they are both part of the analysis.<SEP>Punctuation Rules are related to Capitalization Rules as they are both part of the analysis.", created_at:1779651197, source_id:"chunk-0288711820bdd733aaf8d2718e8e4d83"}}, {start: {_id:6865}, end: {_id:348}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", truncate:"", keywords:"context,source", weight:1.0, description:"The YouTube Video is the source of the text block.", created_at:1779651220, source_id:"chunk-0288711820bdd733aaf8d2718e8e4d83"}}, {start: {_id:6868}, end: {_id:348}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", truncate:"", keywords:"conceptual analysis,explanation", weight:1.0, description:"The YouTube Video explains the rules and process of This Game.", created_at:1779651222, source_id:"chunk-5033c74f902a9903394abee3925147c5"}}, {start: {_id:1474}, end: {_id:6868}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", keywords:"consciousness,termination", truncate:"", weight:1.0, description:"Awakening is the condition that stops This Game.", created_at:1779651223, source_id:"chunk-5033c74f902a9903394abee3925147c5"}}, {start: {_id:6854}, end: {_id:6868}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", keywords:"enlightenment,termination", truncate:"", weight:1.0, description:"Spiritual enlightenment is the condition that stops This Game.", created_at:1779651223, source_id:"chunk-5033c74f902a9903394abee3925147c5"}}, {start: {_id:2406}, end: {_id:6870}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", keywords:"error type,example", truncate:"", weight:1.0, description:"thdraw. is an example of a transcription error involving incorrect spelling.", created_at:1779651256, source_id:"chunk-3580a12191412ce9ae4bc3e84d94ab1e"}}, {start: {_id:6855}, end: {_id:6835}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", truncate:"", keywords:"spiritual alignment,transformation", weight:1.0, description:"Awakening enables the discovery or transformation into a soul mate, creating a magical connection.", created_at:1779651262, source_id:"chunk-ae734d382508c61512b864b733d3338d"}}, {start: {_id:6840}, end: {_id:6871}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", truncate:"", keywords:"existential consequence,perpetuation", weight:1.0, description:"Failing to awaken ensures the \"game\" continues indefinitely, leading to life's end without fulfillment.", created_at:1779651262, source_id:"chunk-ae734d382508c61512b864b733d3338d"}}, {start: {_id:1474}, end: {_id:6872}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", truncate:"", keywords:"spiritual resolution,termination", weight:1.0, description:"The Game persists until awakening occurs, which provides the only means to stop its cycle.", created_at:1779651358, source_id:"chunk-1eb764bde7f7f1e1e97d8931c7b9875e"}}, {start: {_id:6874}, end: {_id:25}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", truncate:"", keywords:"instantaneous alignment,magical shift", weight:1.0, description:"Existing relationships transform into soul mate bonds through spiritual awakening.", created_at:1779651358, source_id:"chunk-1eb764bde7f7f1e1e97d8931c7b9875e"}}, {start: {_id:287}, end: {_id:6872}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", truncate:"", keywords:"existential risk,inevitability", weight:1.0, description:"The Game's continuation without awakening directly results in life ending.", created_at:1779651358, source_id:"chunk-1eb764bde7f7f1e1e97d8931c7b9875e"}}, {start: {_id:6873}, end: {_id:6844}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", truncate:"", keywords:"emotional resonance,spiritual harmony", weight:1.0, description:"Soul mate relationships manifest joy through conscious connection and alignment.", created_at:1779651358, source_id:"chunk-1eb764bde7f7f1e1e97d8931c7b9875e"}}, {start: {_id:543}, end: {_id:25}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", truncate:"", keywords:"spiritual alignment,transcendent potential", weight:1.0, description:"Existing relationships transform into soul mate bonds through spiritual awakening, as described in the text.", created_at:1779651359, source_id:"chunk-1eb764bde7f7f1e1e97d8931c7b9875e"}}, {start: {_id:1474}, end: {_id:543}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", truncate:"", keywords:"spiritual growth,transcendent potential", weight:1.0, description:"Awakening elevates relationships beyond ordinary dynamics into sacred partnerships.", created_at:1779651360, source_id:"chunk-1eb764bde7f7f1e1e97d8931c7b9875e"}}, {start: {_id:1474}, end: {_id:287}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", truncate:"", keywords:"existential consequence,prevention", weight:1.0, description:"Awakening halts the game and prevents life from ending, while failure to awaken leads to life's termination.", created_at:1779651360, source_id:"chunk-1eb764bde7f7f1e1e97d8931c7b9875e"}}, {start: {_id:6875}, end: {_id:6876}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", truncate:"", keywords:"behavioral reaction,emotional response", weight:1.0, description:"al is characterized by instantaneous reactions in relationships.", created_at:1779651386, source_id:"chunk-f4478bc9186f899d1dcee60e679b892c"}}, {start: {_id:603}, end: {_id:6878}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"cognitive conditioning,inherent behavior", weight:1.0, description:"The mind's propensity for comparison stems from early conditioning through familial and social systems.", created_at:1779651478, source_id:"chunk-0cd54f605ef5308b827b0b4e872697da"}}, {start: {_id:5561}, end: {_id:6878}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"behavioral reinforcement,exposure", weight:1.0, description:"The mind's comparative tendencies are reinforced through engagement with social media platforms.", created_at:1779651478, source_id:"chunk-0cd54f605ef5308b827b0b4e872697da"}}, {start: {_id:739}, end: {_id:6878}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"behavioral modeling,early conditioning", weight:1.0, description:"Familial comparison practices shape the mind's inherent tendency to compare.", created_at:1779651478, source_id:"chunk-0cd54f605ef5308b827b0b4e872697da"}}, {start: {_id:603}, end: {_id:739}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"behavioral modeling,foundational influence", weight:1.0, description:"Familial interactions establish comparison as a normalized cognitive pattern.", created_at:1779651478, source_id:"chunk-0cd54f605ef5308b827b0b4e872697da"}}] AS row
