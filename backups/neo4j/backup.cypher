UNWIND [{_id:5944, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Breath cycles are counted to eight during the practice to maintain focus.", created_at:1779552843, source_id:"chunk-58a607380e83d993d819574f258cb8d8", entity_id:"Eight Counts"}}, {_id:5945, properties:{file_path:"YouTube Video: utRatnFr-S8 (URL: https://www.youtube.com/watch?v=utRatnFr-S8)", entity_type:"concept", truncate:"", description:"Coherence of thought refers to the synchronization of brain activity achieved through focused breath observation, as described in the video.<SEP>Coherence of thought refers to the synchronization of brain activity achieved through focused breath observation, as described in the video.", created_at:1779553350, source_id:"chunk-9e16050d1d7a218aab478a93f783bdbb", entity_id:"Coherence of Thought"}}, {_id:5946, properties:{file_path:"YouTube Video: utRatnFr-S8 (URL: https://www.youtube.com/watch?v=utRatnFr-S8)", entity_type:"method", truncate:"", description:"Fingertip-Thumb Touch is a technique where touching fingertips to thumbs serves as an anchor for concentration during meditation, as described in the video.<SEP>Fingertip-Thumb Touch is a technique where touching fingertips to thumbs serves as an anchor for concentration during meditation, as described in the video.", created_at:1779553350, source_id:"chunk-9e16050d1d7a218aab478a93f783bdbb", entity_id:"Fingertip-Thumb Touch"}}, {_id:5947, properties:{file_path:"YouTube Video: utRatnFr-S8 (URL: https://www.youtube.com/watch?v=utRatnFr-S8)", entity_type:"concept", truncate:"", description:"Coherent thinking is a cognitive skill considered one of the first sciences of intelligence, involving focused and logical thought processes.", created_at:1779553350, source_id:"chunk-e4c11128c169e1d5ce39555c52bb0d91", entity_id:"Coherent Thinking"}}, {_id:5948, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A meditation genre targeting daydreaming tendencies.", created_at:1779553383, source_id:"chunk-cddb578bcf069a8520c0ab7c85bb4c9d", entity_id:"Freeing from Daydreaming"}}, {_id:5949, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A meditation genre focused on halting conflicting thoughts.", created_at:1779553383, source_id:"chunk-cddb578bcf069a8520c0ab7c85bb4c9d", entity_id:"Stopping Conflicting Thought Noise"}}, {_id:5950, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A meditation genre to release attachment to everyday concerns.", created_at:1779553383, source_id:"chunk-cddb578bcf069a8520c0ab7c85bb4c9d", entity_id:"Detaching from Worries"}}, {_id:5951, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A meditation genre aimed at inducing trance states.", created_at:1779553383, source_id:"chunk-cddb578bcf069a8520c0ab7c85bb4c9d", entity_id:"Generating Trance"}}, {_id:5952, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A meditation genre for physical and mental stress relief.", created_at:1779553383, source_id:"chunk-cddb578bcf069a8520c0ab7c85bb4c9d", entity_id:"Releasing Stress"}}, {_id:5953, properties:{file_path:"unknown_source<SEP>YouTube Video: b6nQnYzo_bY (URL: https://www.youtube.com/watch?v=b6nQnYzo_bY)", entity_type:"concept", truncate:"", description:"Meditation's role in enhancing creative potential.<SEP>Meditation helps in discovering and enhancing creativity.", created_at:1779553397, source_id:"chunk-cddb578bcf069a8520c0ab7c85bb4c9d<SEP>chunk-71283d3fd5fc26f39a3118a107aca96c", entity_id:"Unearthing Creativity"}}, {_id:5954, properties:{file_path:"unknown_source<SEP>YouTube Video: b6nQnYzo_bY (URL: https://www.youtube.com/watch?v=b6nQnYzo_bY)", entity_type:"concept", truncate:"", description:"A meditation genre fostering heightened awareness of positive consciousness.<SEP>Meditation aims to awaken individuals to positive and beautiful states of living.", created_at:1779553397, source_id:"chunk-cddb578bcf069a8520c0ab7c85bb4c9d<SEP>chunk-71283d3fd5fc26f39a3118a107aca96c", entity_id:"Awakening to Beautiful States"}}, {_id:5955, properties:{file_path:"unknown_source<SEP>YouTube Video: b6nQnYzo_bY (URL: https://www.youtube.com/watch?v=b6nQnYzo_bY)", entity_type:"concept", truncate:"", description:"Meditation's function in revealing latent capabilities.<SEP>Through meditation, individuals can uncover their hidden potential.", created_at:1779553397, source_id:"chunk-cddb578bcf069a8520c0ab7c85bb4c9d<SEP>chunk-71283d3fd5fc26f39a3118a107aca96c", entity_id:"Discovering Hidden Potential"}}, {_id:5956, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Meditation's outcome of transcending isolation.", created_at:1779553383, source_id:"chunk-cddb578bcf069a8520c0ab7c85bb4c9d", entity_id:"Experiencing Connection and Oneness"}}, {_id:5957, properties:{file_path:"YouTube Video: b6nQnYzo_bY (URL: https://www.youtube.com/watch?v=b6nQnYzo_bY)", entity_type:"concept", truncate:"", description:"The central purpose of meditation is to de-clutch you from unconscious thinking habits and awaken you to beautiful states of living.", created_at:1779553397, source_id:"chunk-71283d3fd5fc26f39a3118a107aca96c", entity_id:"Central Purpose of Meditation"}}, {_id:5958, properties:{file_path:"YouTube Video: b6nQnYzo_bY (URL: https://www.youtube.com/watch?v=b6nQnYzo_bY)", entity_type:"concept", truncate:"", description:"This involves breaking free from unconscious thinking habits to achieve greater awareness.", created_at:1779553397, source_id:"chunk-71283d3fd5fc26f39a3118a107aca96c", entity_id:"De-clutching from Unconscious Thinking"}}, {_id:5959, properties:{file_path:"YouTube Video: b6nQnYzo_bY (URL: https://www.youtube.com/watch?v=b6nQnYzo_bY)", entity_type:"concept", truncate:"", description:"Meditation facilitates a shift from isolation to experiencing greater connection and oneness.", created_at:1779553397, source_id:"chunk-71283d3fd5fc26f39a3118a107aca96c", entity_id:"Moving from Isolation to Connection"}}, {_id:5960, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Ease describes a state of freedom from difficulty or stress.", created_at:1779553411, source_id:"chunk-f23630b9a3bbcb8da2d31a0a2eac21bd", entity_id:"Ease"}}, {_id:5961, properties:{file_path:"unknown_source<SEP>YouTube Video: zFOxZ2oo8-U (URL: https://www.youtube.com/watch?v=zFOxZ2oo8-U)", entity_type:"concept", truncate:"", description:"Fashion denotes a current trend or style in behavior or culture.<SEP>Fashion denotes a transient cultural practice or style.", created_at:1779553430, source_id:"chunk-f23630b9a3bbcb8da2d31a0a2eac21bd<SEP>chunk-4516f9311c2e84fab0f3a3d114030507", entity_id:"Fashion"}}, {_id:5962, properties:{file_path:"unknown_source<SEP>YouTube Video: zFOxZ2oo8-U (URL: https://www.youtube.com/watch?v=zFOxZ2oo8-U)", entity_type:"concept", truncate:"", description:"Empowerment signifies a sense of strength and self-efficacy.<SEP>Empowerment signifies a sense of strength and agency.", created_at:1779553430, source_id:"chunk-f23630b9a3bbcb8da2d31a0a2eac21bd<SEP>chunk-4516f9311c2e84fab0f3a3d114030507", entity_id:"Empowerment"}}, {_id:5963, properties:{file_path:"unknown_source<SEP>YouTube Video: zFOxZ2oo8-U (URL: https://www.youtube.com/watch?v=zFOxZ2oo8-U)", entity_type:"concept", truncate:"", description:"Fad refers to a short-lived trend or practice that loses relevance over time.<SEP>Fad refers to a short-lived trend or practice that loses relevance over time.", created_at:1779553430, source_id:"chunk-f23630b9a3bbcb8da2d31a0a2eac21bd<SEP>chunk-4516f9311c2e84fab0f3a3d114030507", entity_id:"Fad"}}] AS row
