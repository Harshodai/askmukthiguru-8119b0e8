UNWIND [{start: {_id:1283}, end: {_id:1286}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"childhood trauma,emotional impact", truncate:"", weight:1.0, description:"Mei's insecurity originates from childhood experiences with her mother, shaping her adult behavior.", created_at:1779143410, source_id:"chunk-bff75bb2f7b2ca92ac4ac1a9d943c725"}}, {start: {_id:1285}, end: {_id:1286}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional neglect,parental influence", truncate:"", weight:1.0, description:"Mei's distorted relationship with money stems from childhood experiences of feeling inadequate to please her mother, which influenced her adult behavior.", created_at:1779143410, source_id:"chunk-bff75bb2f7b2ca92ac4ac1a9d943c725"}}, {start: {_id:1287}, end: {_id:1290}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cause,historical context", truncate:"", weight:1.0, description:"Dislike of money stems from unresolved past experiences (\"inflammation\"), shaping present attitudes toward wealth.", created_at:1779143471, source_id:"chunk-d857b265b139964df02ec1f7935d551c"}}, {start: {_id:1289}, end: {_id:1205}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"behavioral reaction,psychological response", weight:1.0, description:"The Nobody State manifests as avoidance of financial entitlement, leading to undercharging and self-deprecation.", created_at:1779143471, source_id:"chunk-d857b265b139964df02ec1f7935d551c"}}, {start: {_id:1288}, end: {_id:1205}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"behavioral reaction,psychological response", weight:1.0, description:"The Nobody State can paradoxically trigger obsessive pursuit of wealth as a compensatory reaction.", created_at:1779143471, source_id:"chunk-d857b265b139964df02ec1f7935d551c"}}, {start: {_id:1292}, end: {_id:1293}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"fear,negative energy", truncate:"", weight:1.0, description:"the people who have it are linked to the Nobody State through fear of being insignificant and the negative energy it generates.", created_at:1779143489, source_id:"chunk-80ca049174c7e20382ae27ec1972b6dc"}}, {start: {_id:1291}, end: {_id:1292}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cause,psychological impact", truncate:"", weight:1.0, description:"the Nobody State is connected to financial obsession as a manifestation of fear and self-doubt, driving unwise decisions.", created_at:1779143489, source_id:"chunk-80ca049174c7e20382ae27ec1972b6dc"}}, {start: {_id:1295}, end: {_id:1292}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cause,manifestation", truncate:"", weight:1.0, description:"the Nobody State generates a Negative Energy Field through suffering and obsession, impacting others.", created_at:1779143489, source_id:"chunk-80ca049174c7e20382ae27ec1972b6dc"}}, {start: {_id:1291}, end: {_id:1296}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"behavioral consequence", truncate:"", weight:1.0, description:"financial obsession leads to unwise decisions that negatively impact others, as observed in the text.", created_at:1779143489, source_id:"chunk-80ca049174c7e20382ae27ec1972b6dc"}}, {start: {_id:1216}, end: {_id:261}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"calm courage,transformation", truncate:"", weight:1.0, description:"Mike awakened to calm courage and conscious awareness of his past negative impact.", created_at:1779143519, source_id:"chunk-200c896d057fae8b41a69675f296365e"}}, {start: {_id:1205}, end: {_id:933}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"blocks prosperity,prevents wealth", truncate:"", weight:1.0, description:"The Nobody State stops wealth from flowing into lives and blocks the goddess Lakshmi from entering.", created_at:1779143519, source_id:"chunk-200c896d057fae8b41a69675f296365e"}}, {start: {_id:1301}, end: {_id:1205}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"hinders cognition,prevents intelligence", weight:1.0, description:"The Nobody State impedes intellectual growth and clear thinking.", created_at:1779143519, source_id:"chunk-200c896d057fae8b41a69675f296365e"}}, {start: {_id:1302}, end: {_id:1216}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"knowledge utilization,purpose", truncate:"", weight:1.0, description:"Mike?s transformed consciousness led him to a new purpose: using knowledge for societal benefit.", created_at:1779143519, source_id:"chunk-200c896d057fae8b41a69675f296365e"}}, {start: {_id:1303}, end: {_id:1205}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"disrupts harmony,prevents auspiciousness", weight:1.0, description:"The state disrupts positive circumstances and societal harmony.", created_at:1779143519, source_id:"chunk-200c896d057fae8b41a69675f296365e"}}, {start: {_id:184}, end: {_id:1216}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"motivation,pursuit", truncate:"", weight:1.0, description:"Mike initially pursued financial security as part of his career, which was driven by his previous motivations.", created_at:1779143519, source_id:"chunk-200c896d057fae8b41a69675f296365e"}}, {start: {_id:1299}, end: {_id:1205}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"blocks entry,closes opportunities", truncate:"", weight:1.0, description:"The Nobody State prevents Lakshmi, the goddess of wealth, from entering lives.", created_at:1779143520, source_id:"chunk-200c896d057fae8b41a69675f296365e"}}, {start: {_id:1298}, end: {_id:1216}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"motivation,previous state", truncate:"", weight:1.0, description:"Mike's actions were previously driven by financial obsession, which contributed to his negative state.", created_at:1779143520, source_id:"chunk-200c896d057fae8b41a69675f296365e"}}, {start: {_id:1216}, end: {_id:1300}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"association,collaboration", truncate:"", weight:1.0, description:"A new team has gathered around Mike after his transformation, indicating a shift towards collaboration and the greater good.", created_at:1779143520, source_id:"chunk-200c896d057fae8b41a69675f296365e"}}, {start: {_id:1305}, end: {_id:1306}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"contrast,transcendence", truncate:"", weight:1.0, description:"The journey involves moving away from destructive mental states toward creative consciousness.", created_at:1779143569, source_id:"chunk-45384d6e9118a3a6dd41204b27b84334"}}, {start: {_id:1304}, end: {_id:1300}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"educational initiative,service provision", weight:1.0, description:"The team provides architectural solutions online to aspiring learners as part of their mission.", created_at:1779143569, source_id:"chunk-45384d6e9118a3a6dd41204b27b84334"}}] AS row
