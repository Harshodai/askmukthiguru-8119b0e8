UNWIND [{_id:4757, properties:{file_path:"YouTube Video: qJxGtSDiayM (URL: https://www.youtube.com/watch?v=qJxGtSDiayM)", entity_type:"concept", truncate:"", description:"Homophone trio \"to\" (preposition), \"too\" (also), and \"two\" (number), often confused.", created_at:1779408076, source_id:"chunk-c3d136b6bcef23a68b868c6566ab3004", entity_id:"To/Too/Two"}}, {_id:4758, properties:{file_path:"YouTube Video: qJxGtSDiayM (URL: https://www.youtube.com/watch?v=qJxGtSDiayM)", entity_type:"concept", truncate:"", description:"Homophone pair (\"then,\" \"than\") clarified in the video for grammatical accuracy.<SEP>Commonly confused words including 'then' and 'than'.", created_at:1779408198, source_id:"chunk-86716b76fcd4b5a5419e00dae817fca6<SEP>chunk-00739151b6b139671349bef9d79c6e2e", entity_id:"then/than"}}, {_id:4759, properties:{file_path:"YouTube Video: qJxGtSDiayM (URL: https://www.youtube.com/watch?v=qJxGtSDiayM)", entity_type:"concept", truncate:"", description:"Homophone pair (\"your,\" \"you're\") addressed in the video's content analysis.<SEP>Commonly confused words including 'your' and 'you're'.", created_at:1779408198, source_id:"chunk-86716b76fcd4b5a5419e00dae817fca6<SEP>chunk-00739151b6b139671349bef9d79c6e2e", entity_id:"your/you're"}}, {_id:4760, properties:{file_path:"YouTube Video: qJxGtSDiayM (URL: https://www.youtube.com/watch?v=qJxGtSDiayM)", entity_type:"concept", truncate:"", description:"Homophone pair (\"affect,\" \"effect\") discussed in the video for proper application.<SEP>Commonly confused words including 'affect' and 'effect'.", created_at:1779408198, source_id:"chunk-86716b76fcd4b5a5419e00dae817fca6<SEP>chunk-00739151b6b139671349bef9d79c6e2e", entity_id:"affect/effect"}}, {_id:4761, properties:{file_path:"YouTube Video: qJxGtSDiayM (URL: https://www.youtube.com/watch?v=qJxGtSDiayM)", entity_type:"concept", truncate:"", description:"Homophone pair (\"its,\" \"it's\") examined in the video regarding usage context.<SEP>Commonly confused words including 'its' and 'it's'.", created_at:1779408198, source_id:"chunk-86716b76fcd4b5a5419e00dae817fca6<SEP>chunk-00739151b6b139671349bef9d79c6e2e", entity_id:"its/it's"}}, {_id:4762, properties:{file_path:"YouTube Video: qJxGtSDiayM (URL: https://www.youtube.com/watch?v=qJxGtSDiayM)", entity_type:"concept", truncate:"", description:"Homophone pair (\"principal,\" \"principle\") explained in the video's educational content.<SEP>Commonly confused words including 'principal' and 'principle'.", created_at:1779408198, source_id:"chunk-86716b76fcd4b5a5419e00dae817fca6<SEP>chunk-00739151b6b139671349bef9d79c6e2e", entity_id:"principal/principle"}}, {_id:4763, properties:{file_path:"YouTube Video: qJxGtSDiayM (URL: https://www.youtube.com/watch?v=qJxGtSDiayM)", entity_type:"concept", truncate:"", description:"Homophone trio (\"to,\" \"too,\" \"two\") discussed in the video as not present in the content.<SEP>Commonly confused words including 'to', 'too', and 'two'.", created_at:1779408198, source_id:"chunk-86716b76fcd4b5a5419e00dae817fca6<SEP>chunk-00739151b6b139671349bef9d79c6e2e", entity_id:"to/too/two"}}, {_id:4764, properties:{file_path:"YouTube Video: qJxGtSDiayM (URL: https://www.youtube.com/watch?v=qJxGtSDiayM)", entity_type:"concept", truncate:"", description:"Homophone pair (\"accept,\" \"except\") analyzed for common misuse in the video.<SEP>Commonly confused words including 'accept' and 'except'.", created_at:1779408198, source_id:"chunk-86716b76fcd4b5a5419e00dae817fca6<SEP>chunk-00739151b6b139671349bef9d79c6e2e", entity_id:"accept/except"}}, {_id:4765, properties:{file_path:"YouTube Video: qJxGtSDiayM (URL: https://www.youtube.com/watch?v=qJxGtSDiayM)", entity_type:"concept", truncate:"", description:"Homophone trio (\"there,\" \"their,\" \"they're\") addressed in the video regarding common errors.<SEP>Commonly confused words including 'there', 'their', and 'they're'.", created_at:1779408199, source_id:"chunk-86716b76fcd4b5a5419e00dae817fca6<SEP>chunk-00739151b6b139671349bef9d79c6e2e", entity_id:"there/their/they're"}}, {_id:4766, properties:{file_path:"unknown_source<SEP>YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", created_at:1779408725, description:"Partnership is a concept referring to a collaborative arrangement between entities, as described in the text.<SEP>Partnership is a thematic concept mentioned in the provided text.<SEP>Partnership refers to collaborative relationships between individuals or entities, requiring mutual understanding and shared purpose.", source_id:"chunk-7b5354d289e817bf80207997616dffb4<SEP>chunk-10449d3ca4c3cfdd2cd451c07c6fbbce<SEP>chunk-10375887a7aa4a1c7205e37d5e7b18dc<SEP>chunk-3c35c8046e4068fa71b3df5521e81022", entity_id:"Partnership"}}, {_id:4767, properties:{file_path:"unknown_source<SEP>YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", created_at:1779408825, description:"Legal frameworks are a set of laws and regulations governing interactions, as mentioned in the text.<SEP>Legal frameworks refer to systems of laws and regulations governing business and social interactions.<SEP>Legal frameworks are systems of laws and regulations that govern agreements and contracts.", source_id:"chunk-7b5354d289e817bf80207997616dffb4<SEP>chunk-80c1d7e6f2de50ad90c1a12150a2d57e<SEP>chunk-f5f14fddf14672b2d29a6d11525514fd", entity_id:"Legal Frameworks"}}, {_id:4768, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"data", truncate:"", description:"YouTube Video with URL https://www.youtube.com/watch?v=ZD1nQPtpojM serves as the source material for text correction tasks.", created_at:1779408548, source_id:"chunk-10449d3ca4c3cfdd2cd451c07c6fbbce", entity_id:"YouTube Video (ZD1nQPtpojM)"}}, {_id:4769, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"data", truncate:"", description:"List of Important Terms includes domain-specific spiritual terminology for correction reference.", created_at:1779408548, source_id:"chunk-10449d3ca4c3cfdd2cd451c07c6fbbce", entity_id:"List of Important Terms"}}, {_id:4770, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", entity_type:"concept", truncate:"", description:"Ekam is a spiritual concept relevant to Mukthi Guru's domain.<SEP>Spiritual context refers to a framework of beliefs or practices related to spirituality, influencing terminology choices.", created_at:1779673177, source_id:"chunk-10449d3ca4c3cfdd2cd451c07c6fbbce<SEP>chunk-98921940959422839d1d78085fa664be", entity_id:"Spiritual Context"}}, {_id:4771, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"Business cooperation involves collaborative efforts between business entities, frequently hindered by distrust and short-term thinking.", created_at:1779408725, source_id:"chunk-10375887a7aa4a1c7205e37d5e7b18dc", entity_id:"Business Cooperation"}}, {_id:4772, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"Businesses are domains where trust and cooperation are critical for success but often compromised by short-term perspectives.<SEP>Businesses are commercial enterprises engaged in economic activities and professional operations.", created_at:1779408781, source_id:"chunk-10375887a7aa4a1c7205e37d5e7b18dc<SEP>chunk-80c1d7e6f2de50ad90c1a12150a2d57e", entity_id:"Businesses"}}, {_id:4773, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"Daily work represents routine activities that require transformed consciousness for meaningful contribution to life and business.<SEP>Daily work refers to routine tasks and activities performed in professional and personal settings.", created_at:1779408781, source_id:"chunk-10375887a7aa4a1c7205e37d5e7b18dc<SEP>chunk-80c1d7e6f2de50ad90c1a12150a2d57e", entity_id:"Daily Work"}}, {_id:4774, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"A state of being characterized by higher awareness and purpose, enabling true partnership and progress.<SEP>The Transformed State is a beautiful, no-suffering state from which positive outcomes like blessings, grace, and miracles arise.", created_at:1779563471, source_id:"chunk-10375887a7aa4a1c7205e37d5e7b18dc<SEP>chunk-5ccc31c8e1d16623e7633752bbd5a9ab", entity_id:"Transformed State"}}, {_id:4775, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"UNKNOWN", truncate:"", description:"Short-term vision and fear-driven decisions obstruct progress, leading to faster failure.", created_at:1779408761, source_id:"chunk-10375887a7aa4a1c7205e37d5e7b18dc", entity_id:"Short Vision"}}, {_id:4777, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"True cooperation and partnership are concepts emphasizing collaborative efforts and mutual support in professional and personal contexts.", created_at:1779408781, source_id:"chunk-80c1d7e6f2de50ad90c1a12150a2d57e", entity_id:"True Cooperation and Partnership"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:4778, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"A higher level of consciousness signifies elevated mental awareness and ethical decision-making.", created_at:1779408781, source_id:"chunk-80c1d7e6f2de50ad90c1a12150a2d57e", entity_id:"Higher Level of Consciousness"}}, {_id:4779, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"Connection among partners highlights interdependence and mutual respect in collaborative efforts.", created_at:1779408782, source_id:"chunk-80c1d7e6f2de50ad90c1a12150a2d57e", entity_id:"Connection Among Partners"}}, {_id:4780, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"The magical journey represents a transformative process of growth and collaboration arising from elevated consciousness.", created_at:1779408782, source_id:"chunk-80c1d7e6f2de50ad90c1a12150a2d57e", entity_id:"Magical Journey"}}, {_id:4781, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"A plural verb is a verb form used with compound subjects to indicate plural agreement.", created_at:1779408825, source_id:"chunk-f5f14fddf14672b2d29a6d11525514fd", entity_id:"Plural Verb"}}, {_id:4782, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)<SEP>YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", entity_type:"concept", truncate:"", description:"A compound subject is a grammatical term referring to a subject that consists of multiple nouns or pronouns, requiring a plural verb.<SEP>Grammatical structure where multiple nouns (e.g., \"discrimination and separation\") are treated as a single subject.<SEP>Compound subjects require plural verb agreement in formal grammar when referring to multiple nouns.<SEP>A grammatical structure where multiple nouns act as a single subject, requiring a plural verb.<SEP>A grammatical structure where multiple nouns act as a single subject, requiring a plural verb.", created_at:1779667076, source_id:"chunk-f5f14fddf14672b2d29a6d11525514fd<SEP>chunk-82910be7ab066a3e5e12d9a354ef4d9a<SEP>chunk-2668d66263a2b6505795cf0f77b429d1<SEP>chunk-c3bdf300b2509154604072df1057a411", entity_id:"Compound Subject"}}, {_id:4783, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"Prenuptial agreements are contracts made by couples before marriage to outline terms in case of divorce.", created_at:1779408825, source_id:"chunk-f5f14fddf14672b2d29a6d11525514fd", entity_id:"Prenuptial Agreements"}}, {_id:4784, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"Contractions are shortened forms of words or phrases, such as \"it's\" and \"they're\", used in standard English grammar.", created_at:1779408825, source_id:"chunk-f5f14fddf14672b2d29a6d11525514fd", entity_id:"Contractions"}}, {_id:4787, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"Guidelines on comma placement in specific clauses such as \"hat even today,\" \"married couples,\" \"get married,\" \"so that,\" \"divorce,\" \"Now,\" and \"surprising to see that even today.\"", created_at:1779408933, source_id:"chunk-a41af49b3094099fda23d61ef9f2c3b3", entity_id:"Comma Usage Guidelines"}}, {_id:4788, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"Grammatical rule stating the comma after \"Now\" is correct in the given context.", created_at:1779408973, source_id:"chunk-24e80c4f8368ed4c0ed245d066d85aa5", entity_id:"Comma after \"Now\""}}, {_id:4789, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"Grammatical rule validating the comma following \"married couples\".", created_at:1779408973, source_id:"chunk-24e80c4f8368ed4c0ed245d066d85aa5", entity_id:"Comma after \"married couples\""}}, {_id:4790, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"Grammatical rule approving the comma placement after \"divorce\".", created_at:1779408973, source_id:"chunk-24e80c4f8368ed4c0ed245d066d85aa5", entity_id:"Comma after \"divorce\""}}, {_id:4791, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"Grammatical rule explaining the comma usage after \"so that\".", created_at:1779408973, source_id:"chunk-24e80c4f8368ed4c0ed245d066d85aa5", entity_id:"Comma after \"so that\""}}, {_id:4792, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"Grammatical rule confirming the comma placement after the phrase \"surprising to see that even today\".", created_at:1779408973, source_id:"chunk-24e80c4f8368ed4c0ed245d066d85aa5", entity_id:"Comma after \"surprising to see that even today\""}}, {_id:4793, properties:{file_path:"YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", description:"Grammatical rule justifying the comma after \"get married\".", created_at:1779408973, source_id:"chunk-24e80c4f8368ed4c0ed245d066d85aa5", entity_id:"Comma after \"get married\""}}, {_id:4794, properties:{file_path:"unknown_source<SEP>YouTube Video: stUPu1-W4bE (URL: https://www.youtube.com/watch?v=stUPu1-W4bE)", entity_type:"concept", truncate:"", created_at:1779409739, description:"Burnout process is mitigated by meditation, helping individuals recover faster.<SEP>Burnout process describes chronic workplace stress leading to exhaustion, mitigated by meditation.<SEP>Burnout process describes chronic workplace or achievement-related stress, mitigated by meditation.><SEP>Burnout process is a state of physical or mental exhaustion, which meditation helps slow down.<SEP>Burnout process describes the physical and mental exhaustion experienced by high achievers, which meditation helps mitigate.", source_id:"chunk-1140e04073ac9a83dfcd95f7292712fc<SEP>chunk-4a8a747b20d8cc64be6f0587f83f75f8<SEP>chunk-0adee7c41f1cb41998ac9e8e2dce0473<SEP>chunk-1a14104939cf6c7cde138464e4bad5e7<SEP>chunk-4b883b28acf7bcbe78afff1c0303d457", entity_id:"Burnout Process"}}, {_id:4795, properties:{file_path:"unknown_source<SEP>YouTube Video: stUPu1-W4bE (URL: https://www.youtube.com/watch?v=stUPu1-W4bE)", entity_type:"concept", truncate:"", description:"Psychosomatic ailments are conditions where mental and physical symptoms are interconnected, and meditation can help heal them.<SEP>Psychosomatic ailments are physical conditions influenced by psychological factors, which meditation can help heal.<SEP>Psychosomatic ailments are physical conditions influenced by mental or emotional factors, addressed through meditation.<SEP>Psychosomatic ailments are physical conditions linked to mental stress, which meditation helps heal.<SEP>Psychosomatic ailments are physical conditions influenced by psychological factors, which meditation can help heal.><SEP>Psychosomatic ailments are physical conditions influenced by psychological factors, which meditation can help heal.", created_at:1779409685, source_id:"chunk-1140e04073ac9a83dfcd95f7292712fc<SEP>chunk-4a8a747b20d8cc64be6f0587f83f75f8<SEP>chunk-94fd769ad6dd92d26be8bab1935e1e46<SEP>chun