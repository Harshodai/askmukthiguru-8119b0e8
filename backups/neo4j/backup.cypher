UNWIND [{start: {_id:4617}, end: {_id:1620}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"constraint,correction principle", weight:1.0, description:"The expert must retain the original meaning while fixing errors in the text.", created_at:1779402434, source_id:"chunk-288b6f3cbc1fbe491495841582bf9281"}}, {start: {_id:4616}, end: {_id:1620}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"constraint,procedural rule", weight:1.0, description:"The expert follows strict output format rules for corrected text without summaries.", created_at:1779402434, source_id:"chunk-288b6f3cbc1fbe491495841582bf9281"}}, {start: {_id:1474}, end: {_id:4611}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"existential outcome,self-inquiry", weight:1.0, description:"The spiritual quest is linked to the potential for awakening as opposed to depression.", created_at:1779402518, source_id:"chunk-b85547a9c5ce2c1aff2a86073a2bcb87"}}, {start: {_id:1406}, end: {_id:4611}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"existential contrast,philosophical inquiry", weight:1.0, description:"The spiritual quest is juxtaposed with depression as part of the text's exploration of meaning and consciousness.", created_at:1779402518, source_id:"chunk-b85547a9c5ce2c1aff2a86073a2bcb87"}}, {start: {_id:4612}, end: {_id:4620}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"human experience,philosophical inquiry", weight:1.0, description:"The search for meaning is framed as an existential quest exploring the significance of existence and human experiences.", created_at:1779402546, source_id:"chunk-cd11c060af63780157ebf40717dc0fe2"}}, {start: {_id:3882}, end: {_id:3032}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"biological function,biological process,bodily functions,daily occurrence,existence,philosophical inquiry", weight:3.0, created_at:1779402774, description:"Breathing is analyzed as a biological process tied to existence, with its significance debated in the context of human experience.<SEP>Breathing is questioned as a meaningful or meaningless act of existence.<SEP>Breathing is characterized as a movement of pure existence, devoid of intrinsic meaning.", source_id:"chunk-cd11c060af63780157ebf40717dc0fe2<SEP>chunk-8ac203494cdcc9d8041ac912b2411f28<SEP>chunk-e94d81180e7457d6f36d99965cfbf34d"}}, {start: {_id:1071}, end: {_id:4619}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", keywords:"nourishment,sustenance", truncate:"", weight:1.0, description:"Rain droplets nourish the earth, supporting life through their existence and functional impact.", created_at:1779402546, source_id:"chunk-cd11c060af63780157ebf40717dc0fe2"}}, {start: {_id:3032}, end: {_id:2805}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"daily actions,daily occurrence,daily routine,existence,existential analysis,human experience", weight:3.0, created_at:1779402774, description:"Waking up is analyzed as a daily occurrence linked to existence, with its significance questioned in the philosophical discourse.<SEP>Waking up is examined for its intrinsic meaning within the framework of existence.<SEP>Waking up is analyzed as an act with existential implications but no inherent purpose.", source_id:"chunk-cd11c060af63780157ebf40717dc0fe2<SEP>chunk-8ac203494cdcc9d8041ac912b2411f28<SEP>chunk-e94d81180e7457d6f36d99965cfbf34d"}}, {start: {_id:4612}, end: {_id:4621}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"philosophical inquiry,societal constructs", weight:1.0, description:"The existential quest examines societal concepts like marriage, job, and money as part of its exploration of meaning.", created_at:1779402569, source_id:"chunk-06a765717ff85133b42ac4f705cd51ca"}}, {start: {_id:4613}, end: {_id:4623}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"pervasive dissatisfaction,superficiality", weight:1.0, description:"Discontent undermines perceived value in relationships, achievements, and glamour due to superficiality.", created_at:1779402570, source_id:"chunk-06a765717ff85133b42ac4f705cd51ca"}}, {start: {_id:4506}, end: {_id:4622}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"existential critique,metaphorical representation", weight:1.0, description:"The \"true man show\" metaphor embodies the concept of superficiality in modern existence.", created_at:1779402570, source_id:"chunk-06a765717ff85133b42ac4f705cd51ca"}}, {start: {_id:4612}, end: {_id:4622}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"existential themes,metaphorical critique", weight:1.0, description:"The \"true man show\" metaphor reflects the existential quest's critique of superficiality in modern life.", created_at:1779402570, source_id:"chunk-06a765717ff85133b42ac4f705cd51ca"}}, {start: {_id:4611}, end: {_id:4624}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"content includes,thematic focus", weight:1.0, description:"The video discusses the spiritual quest as a core theme in its content.", created_at:1779402615, source_id:"chunk-1324fa0c36b3af6d5b8a9fbc0e3a438e"}}, {start: {_id:1406}, end: {_id:4624}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"content includes,mental health,philosophical inquiry,psychological focus", weight:2.0, description:"The video addresses depression as a key psychological state explored in the speech.<SEP>The video explores the intersection of depression and existential questions about meaning.", created_at:1779402818, source_id:"chunk-1324fa0c36b3af6d5b8a9fbc0e3a438e<SEP>chunk-89ddb9ac19fba38ddebc97bcf3b40b3b"}}, {start: {_id:4626}, end: {_id:4624}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"content includes,process description", weight:1.0, description:"The video outlines the healing process as part of the journey toward spiritual awakening.", created_at:1779402616, source_id:"chunk-1324fa0c36b3af6d5b8a9fbc0e3a438e"}}, {start: {_id:4625}, end: {_id:4624}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"content includes,transformative state", weight:1.0, description:"The video presents spiritual awakening as the ultimate goal of the journey.", created_at:1779402616, source_id:"chunk-1324fa0c36b3af6d5b8a9fbc0e3a438e"}}, {start: {_id:4625}, end: {_id:4611}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"journey stages,transformative outcome", weight:1.0, description:"The spiritual quest culminates in spiritual awakening as its final stage.", created_at:1779402616, source_id:"chunk-1324fa0c36b3af6d5b8a9fbc0e3a438e"}}, {start: {_id:4618}, end: {_id:4624}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"conceptual analysis,content includes", weight:1.0, description:"The video analyzes mind-created suffering as a source of discontent.", created_at:1779402616, source_id:"chunk-1324fa0c36b3af6d5b8a9fbc0e3a438e"}}, {start: {_id:4626}, end: {_id:4625}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"holistic approach,preparatory step,sequential progression,sequential transformation", weight:2.0, description:"Healing depression is a necessary precursor to achieving spiritual awakening.<SEP>The Healing Process is presented as a precursor to Spiritual Awakening in the journey toward consciousness.", created_at:1779402924, source_id:"chunk-1324fa0c36b3af6d5b8a9fbc0e3a438e<SEP>chunk-81310581d9c3ed56ae9e89492e24dc8b"}}, {start: {_id:1406}, end: {_id:4618}, properties:{file_path:"YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"aspect,psychological manifestation", weight:1.0, description:"Depression is framed as a manifestation of mind-created suffering.", created_at:1779402616, source_id:"chunk-1324fa0c36b3af6d5b8a9fbc0e3a438e"}}] AS row
