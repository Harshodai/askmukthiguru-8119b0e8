UNWIND [{start: {_id:615}, end: {_id:619}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"consequences,driving force", truncate:"", weight:1.0, description:"Self-doubt leads individuals to seek external solutions like substance use.", created_at:1779138862, source_id:"chunk-0e910622cdbaf731d9c63e3af759ab25"}}, {start: {_id:615}, end: {_id:616}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"behavioral manifestation,harm", truncate:"", weight:1.0, description:"Narcotics use exemplifies harmful external solutions to internal conflict.", created_at:1779138862, source_id:"chunk-0e910622cdbaf731d9c63e3af759ab25"}}, {start: {_id:619}, end: {_id:618}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"extreme consequence,severity", truncate:"", weight:1.0, description:"The text links severe self-doubt to suicidal tendencies as a tragic outcome.", created_at:1779138862, source_id:"chunk-0e910622cdbaf731d9c63e3af759ab25"}}, {start: {_id:617}, end: {_id:615}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"behavioral manifestation,harm", truncate:"", weight:1.0, description:"Alcohol consumption reflects destructive coping mechanisms.", created_at:1779138862, source_id:"chunk-0e910622cdbaf731d9c63e3af759ab25"}}, {start: {_id:621}, end: {_id:625}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"indecision,metaphor", truncate:"", weight:1.0, description:"The text uses \"mit suicide\" as a metaphor to discuss the impact of internal conflict on making important life decisions.", created_at:1779138888, source_id:"chunk-3a9f26816f36d2d6507e237b6a559579"}}, {start: {_id:623}, end: {_id:624}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"decision-making,gameplay", truncate:"", weight:1.0, description:"The Game of Tag incorporates the method \"Eeny Meeny Miney Mo\" to demonstrate random decision-making instead of clear choices.", created_at:1779138888, source_id:"chunk-3a9f26816f36d2d6507e237b6a559579"}}, {start: {_id:623}, end: {_id:621}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"illustration,randomness", truncate:"", weight:1.0, description:"The method \"Eeny Meeny Miney Mo\" illustrates how indecision leads to randomness in critical life decisions.", created_at:1779138888, source_id:"chunk-3a9f26816f36d2d6507e237b6a559579"}}, {start: {_id:635}, end: {_id:631}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conceptual representation,embodiment", truncate:"", weight:1.0, description:"The heads physically manifest Ravana's internal ideological and emotional conflicts.", created_at:1779138909, source_id:"chunk-e8cb0cf14adb586ae1629961d6d5940a"}}, {start: {_id:632}, end: {_id:634}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"narrative context,villainy", truncate:"", weight:1.0, description:"Ravana serves as the central antagonist in the Ramayana, driving the epic's conflict.", created_at:1779138909, source_id:"chunk-e8cb0cf14adb586ae1629961d6d5940a"}}, {start: {_id:634}, end: {_id:631}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"internal conflict,symbolism", truncate:"", weight:1.0, description:"The ten heads metaphorically represent Ravana's psychological struggle with conflicting values.", created_at:1779138909, source_id:"chunk-e8cb0cf14adb586ae1629961d6d5940a"}}, {start: {_id:633}, end: {_id:634}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"consequences,destruction", truncate:"", weight:1.0, description:"Ravana's actions lead to the collapse of his kingdom, as described in the Ramayana.", created_at:1779138909, source_id:"chunk-e8cb0cf14adb586ae1629961d6d5940a"}}, {start: {_id:633}, end: {_id:636}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"narrative outcome,salvation", truncate:"", weight:1.0, description:"Rama's role in the Ramayana contrasts with Ravana's, symbolizing the preservation of order.", created_at:1779138909, source_id:"chunk-e8cb0cf14adb586ae1629961d6d5940a"}}, {start: {_id:60}, end: {_id:637}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"moral paradox,philosophical inquiry", truncate:"", weight:1.0, description:"The document poses the question about moral decline and its relevance across time.", created_at:1779138929, source_id:"chunk-6ad010179b68a77812793b24f711cf95"}}, {start: {_id:612}, end: {_id:634}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"conceptual example,inner conflict,self-destruction", truncate:"", weight:2.0, description:"Ravana's ten heads symbolize his inner war with conflicting values and desires, leading to self-destructive tendencies.<SEP>Ravana's inner war between knowledge and desires exemplifies how unresolved internal conflict leads to self-destruction and societal collapse.", created_at:1779179454, source_id:"chunk-6ad010179b68a77812793b24f711cf95<SEP>chunk-676c070f41c08ddde395290878529cf3"}}, {start: {_id:612}, end: {_id:638}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"destructive outcomes,psychological struggle", weight:1.0, description:"Inner war directly results in self-destructive behavior that harms the individual and others.", created_at:1779138929, source_id:"chunk-6ad010179b68a77812793b24f711cf95"}}, {start: {_id:634}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"narrative source,symbolic analysis", truncate:"", weight:1.0, description:"The document contains the story of Ravana and his inner conflict.", created_at:1779138929, source_id:"chunk-6ad010179b68a77812793b24f711cf95"}}, {start: {_id:639}, end: {_id:612}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional turmoil,triggers", truncate:"", weight:1.0, description:"Conflicting desires spark inner war by creating irreconcilable motivations.", created_at:1779138929, source_id:"chunk-6ad010179b68a77812793b24f711cf95"}}, {start: {_id:29}, end: {_id:612}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cause and effect,societal impact", truncate:"", weight:1.0, description:"Unresolved inner war generates chaos in the individual's life and their community.", created_at:1779138929, source_id:"chunk-6ad010179b68a77812793b24f711cf95"}}, {start: {_id:360}, end: {_id:634}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"inner turmoil,self-destruction", truncate:"", weight:1.0, description:"Ravana's inability to resolve conflicting desires exemplifies the destructive power of inner conflict, leading to his downfall.", created_at:1779138947, source_id:"chunk-c3c756183e3f4bbcd6f10defea6c686f"}}, {start: {_id:640}, end: {_id:360}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional consequences,psychological impact", weight:1.0, description:"Inner conflict intensifies dissatisfaction, which can escalate into depression and self-hatred.", created_at:1779138947, source_id:"chunk-c3c756183e3f4bbcd6f10defea6c686f"}}] AS row
