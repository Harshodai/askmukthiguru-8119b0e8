UNWIND [{start: {name:"Ekam"}, end: {_id:1761}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", truncate:"", keywords:"emotional impact,spiritual intervention", weight:1.0, description:"The divine opened Ekam's heart and made him aware of his son's loneliness.", created_at:1779225389, source_id:"chunk-a00a616ea914a3f9cb6efa32114cd948"}}, {start: {name:"Ekam"}, end: {_id:2856}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", truncate:"", keywords:"awareness,emotional realization", weight:1.0, description:"Ekam became conscious of his son's loneliness through the divine intervention.", created_at:1779225389, source_id:"chunk-a00a616ea914a3f9cb6efa32114cd948"}}, {start: {name:"Ekam"}, end: {_id:82}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", truncate:"", keywords:"emotional connection,spiritual experience", weight:1.0, description:"At Ekam, the father experiences a spiritual connection and emotional oneness with his son.", created_at:1779225428, source_id:"chunk-ea7d74ec407517f9b38e9ad416479a66"}}, {start: {name:"Ekam"}, end: {_id:1194}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", truncate:"", keywords:"healing,spiritual transformation", weight:1.0, description:"The son's journey at Ekam involves heart healing and overcoming addiction.", created_at:1779225625, source_id:"chunk-94adc3d4525b736bf33ffd5d5752ec38"}}, {start: {name:"Deeksha"}, end: {_id:2892}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)<SEP>YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", truncate:"", keywords:"contextual relevance,core concept,exclusion,identity differentiation,mantra evaluation,teaching,terminology", weight:4.0, description:"The spiritual platform emphasizes Deeksha as central to its identity, differentiating itself from clinical de-addiction centers.<SEP>The spiritual platform's context necessitates the use of \"Deeksha\" over the clinical term \"de-addiction.\"<SEP>Deeksha is analyzed but excluded from the final mantra interpretation due to lack of clarity.<SEP>The Spiritual Platform teaches the concept of Deeksha as part of its spiritual teachings.", created_at:1779447879, source_id:"chunk-1cce98cd0aed40f77c27d3d6b1cb14b9<SEP>chunk-59c75858fc62071381380d482998c935<SEP>chunk-237725492b688a0663257df076c15f50<SEP>chunk-19de200e362a0af16f232c1f956ad32c"}}, {start: {name:"Deeksha"}, end: {_id:2870}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", truncate:"", keywords:"alternative term,contextual replacement,possible error,terminology conflict", weight:3.0, description:"de-addiction might be a mistake for Deeksha.<SEP>\"de-addiction\" is identified as an inappropriate term in the spiritual context, contrasting with the correct term \"Deeksha\".", created_at:1779225826, source_id:"chunk-c1ab541b2cf5308d3b299d7516e3021f<SEP>chunk-437aa718018411e1f3f26388805d3883"}}, {start: {name:"Deeksha"}, end: {_id:2913}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", truncate:"", keywords:"domain-specific reference,validation", weight:1.0, description:"\"Deeksha\" is validated as the correct term from the predefined spiritual list.", created_at:1779225872, source_id:"chunk-59c75858fc62071381380d482998c935"}}, {start: {name:"Deeksha"}, end: {_id:1638}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", truncate:"", keywords:"correction,transcription error", weight:1.0, description:"The video addresses \"Deeksha\" as a mishearing requiring correction to its intended form.", created_at:1779225926, source_id:"chunk-fd29211eaa388c14b9d3c59363eea8da"}}, {start: {name:"Ekam"}, end: {_id:2946}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=gMrOMT4mfno)", keywords:"blessing,representation,spiritual authority,spiritual leadership", truncate:"", weight:2.0, description:"Shri Preethaji brings blessings from Ekam to guide others toward enlightenment.<SEP>Shri Preethaji is a representative of Ekam, bringing blessings and teachings.", created_at:1779226276, source_id:"chunk-77d6f5a3144b96f2147a4737563dbfb7<SEP>chunk-5ce3bc6c0c74a0d11ac1dfb141fbb291"}}, {start: {name:"Ekam"}, end: {_id:2950}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=gMrOMT4mfno)", keywords:"blessing,representation,spiritual authority,spiritual leadership", truncate:"", weight:2.0, description:"Shri Krishnaji collaborates with Ekam to promote enlightenment through their global tour.<SEP>Shri Krishnaji is a representative of Ekam, bringing blessings and teachings.", created_at:1779226276, source_id:"chunk-77d6f5a3144b96f2147a4737563dbfb7<SEP>chunk-5ce3bc6c0c74a0d11ac1dfb141fbb291"}}, {start: {name:"Ekam"}, end: {_id:2968}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=gMrOMT4mfno)", truncate:"", keywords:"representation,spiritual leadership", weight:1.0, description:"Shri Prithaji is a representative of Ekam, bringing blessings and teachings.", created_at:1779226276, source_id:"chunk-5ce3bc6c0c74a0d11ac1dfb141fbb291"}}, {start: {name:"Ekam"}, end: {_id:3205}, properties:{file_path:"unknown_source", keywords:"redundancy,term correction", truncate:"", weight:1.0, description:"\"Ekams\" was corrected to \"Ekam\" to remove redundancy and align with the platform's terminology.", created_at:1779228590, source_id:"chunk-6995806c11a29b44fc7094ee22938f78"}}, {start: {name:"Ekam"}, end: {_id:3184}, properties:{file_path:"unknown_source", keywords:"death concept,spiritual philosophy", truncate:"", weight:1.0, description:"Ekam's teachings frame death as Mahaprasthana, a transition to higher consciousness.", created_at:1779228590, source_id:"chunk-6995806c11a29b44fc7094ee22938f78"}}, {start: {name:"Ekam"}, end: {_id:3229}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"generational impact,research,scientific research", weight:2.0, description:"Ekam studies how epigenetic tendencies transmit traits across generations.<SEP>Ekam's processes observe experiences flowing into future generations as epigenetic tendencies.", created_at:1779229139, source_id:"chunk-fff4055f00cd2414c407b066c68e8d55<SEP>chunk-7ac9109abdb5bdc9de2685e960e358c1"}}, {start: {name:"Consciousness"}, end: {_id:3328}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"emotional binding,existential entrapment", weight:1.0, description:"Objects of attachment or hate bind consciousness to past experiences post-death.", created_at:1779228762, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281"}}, {start: {name:"Consciousness"}, end: {_id:889}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"metaphorical entrapment,unresolved suffering", weight:1.0, description:"Being stuck in vasanas is likened to an inescapable nightmare.", created_at:1779228762, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281"}}, {start: {name:"Jeevan Mukta"}, end: {_id:848}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"progressive blissfulness,union", weight:1.0, description:"Jeevan Mukta experiences progressive blissfulness until union with Universal Consciousness or Brahman.", created_at:1779228802, source_id:"chunk-484efc8f94e4787f4bc0cc8762ad9476"}}, {start: {name:"Jeevan Mukta"}, end: {_id:3431}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"spiritual progression,ultimate unity", weight:1.0, description:"Jeevan Mukta leads to progressive blissfulness until union with Universal Consciousness or Brahman.", created_at:1779229187, source_id:"chunk-dd4f29607e86446996b5a0f4d31130d7"}}, {start: {name:"Brahman"}, end: {_id:1463}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"spiritual identity,universal consciousness", weight:1.0, description:"The concept of Brahman equates all beings encountered in life to the ultimate reality.", created_at:1779229239, source_id:"chunk-98219edafe8ffc379bb20679c2f8f076"}}, {start: {name:"Suffering State"}, end: {_id:3468}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=MKOAMUmZ-RA)", truncate:"", keywords:"negative impact,self-sabotage", weight:1.0, description:"Living in a suffering state hinders self-improvement and problem-solving.", created_at:1779230345, source_id:"chunk-8ae7d2bf13d490cfea1a9347ee1a6a78"}}] AS row
