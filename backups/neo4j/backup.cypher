UNWIND [{start: {_id:856}, end: {_id:848}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"mental clarity,spiritual growth", truncate:"", weight:1.0, description:"Releasing fear is presented as a pathway to connecting with universal consciousness.", created_at:1779140137, source_id:"chunk-9adf0c9fc04ec5f278c69f868ef4b504"}}, {start: {_id:846}, end: {_id:785}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"biological access points,energy centers", weight:1.0, description:"These body parts are mentioned as locations where universal intelligence can be accessed.", created_at:1779140137, source_id:"chunk-9adf0c9fc04ec5f278c69f868ef4b504"}}, {start: {_id:299}, end: {_id:449}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"necessity,transformation", truncate:"", weight:1.0, description:"Love is essential for maintaining healthy relationships and transforming interactions to avoid recurring pain.", created_at:1779140163, source_id:"chunk-e529b36ff201e9fd0aaf1f7dc5280697"}}, {start: {_id:284}, end: {_id:299}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"empathy,essence,human experience,manifestation,requirement,understanding", truncate:"", weight:3.0, created_at:1779562320, description:"Connection forms the foundation of love, enabling mutual understanding beyond surface-level compatibility.<SEP>Love emerges as the practical expression of deep connection in relationships.<SEP>Connection underlies love, transcending romance and embodying compassion and unity within human experience.", source_id:"chunk-e529b36ff201e9fd0aaf1f7dc5280697<SEP>chunk-b96d370a14bedf82917d4f135e00825e<SEP>chunk-ea7262ae497f1dc36bddbc40ddb97a59"}}, {start: {_id:284}, end: {_id:858}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"empathy,shared experiences", truncate:"", weight:1.0, description:"Family members exemplify deep connection through empathetic emotional alignment and shared life experiences.", created_at:1779140163, source_id:"chunk-e529b36ff201e9fd0aaf1f7dc5280697"}}, {start: {_id:299}, end: {_id:857}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"idealization,manifestation", truncate:"", weight:1.0, description:"This idealized love embodies the transformative potential of love to resolve conflicts and deepen bonds.", created_at:1779140163, source_id:"chunk-e529b36ff201e9fd0aaf1f7dc5280697"}}, {start: {_id:352}, end: {_id:81}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"empathic connection,familial love", truncate:"", weight:1.0, description:"Narrator feels their mother's love and sacrifices, though initially perceives her affection as favoring the sister.", created_at:1779140210, source_id:"chunk-9924c7e219f96915a4ef19eba2cb5f62"}}, {start: {_id:82}, end: {_id:81}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: y2ZgKdt4Cj0 (URL: https://www.youtube.com/watch?v=y2ZgKdt4Cj0)", keywords:"empathic connection,familial love,growing closer,reconnecting", truncate:"", weight:2.0, description:"Narrator feels their father's love, which balances the perceived imbalance in maternal affection.<SEP>The narrator and father are reconnecting through the Field of Abundance, improving their previously rocky relationship.", created_at:1779435140, source_id:"chunk-9924c7e219f96915a4ef19eba2cb5f62<SEP>chunk-84c6a3d9c8b4cde9bffa20b37bd7d9c0"}}, {start: {_id:81}, end: {_id:859}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"empathic connection,familial bond", truncate:"", weight:1.0, description:"Narrator shares feelings with their sister, experiencing her emotions as their own.", created_at:1779140211, source_id:"chunk-9924c7e219f96915a4ef19eba2cb5f62"}}, {start: {_id:81}, end: {_id:861}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"educational experience,empathic connection", weight:1.0, description:"Narrator connects with teachers, perceiving their emotions during their formative years.", created_at:1779140211, source_id:"chunk-9924c7e219f96915a4ef19eba2cb5f62"}}, {start: {_id:860}, end: {_id:81}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"empathic connection,social bond", truncate:"", weight:1.0, description:"Narrator feels friends' emotions, fostering mutual understanding.", created_at:1779140211, source_id:"chunk-9924c7e219f96915a4ef19eba2cb5f62"}}, {start: {_id:17}, end: {_id:81}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional growth,emotional reciprocity,emotional support,expanded connection,long-term commitment,marital bond,marriage,unconditional acceptance", truncate:"", weight:4.0, created_at:1779141655, description:"Krishnaji deepens the narrator's understanding of connection and connects with their inner being, transforming their relationship.<SEP>Krishnaji demonstrates acceptance of the narrator's emotions, fostering mutual restfulness and connection.<SEP>Narrator and Krishnaji share a 22-year marriage marked by mutual emotional support and understanding.<SEP>The narrator and Krishnaji have maintained a consistent, supportive relationship for twenty-two years.", source_id:"chunk-9924c7e219f96915a4ef19eba2cb5f62<SEP>chunk-ad886d6b8bed920b247267424ac5e9aa<SEP>chunk-c85036006eb9517f84fbb3ee7717030e"}}, {start: {_id:284}, end: {_id:81}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"core experience,natural state", truncate:"", weight:1.0, description:"Connection is the narrator's innate ability to feel others' emotions, central to their identity and interactions.", created_at:1779140211, source_id:"chunk-9924c7e219f96915a4ef19eba2cb5f62"}}, {start: {_id:225}, end: {_id:81}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"cultural influence,educational environment", weight:1.0, description:"The narrator's relationship dynamics with Krishnaji influence the academy's culture, affecting students' experiences.", created_at:1779140252, source_id:"chunk-ad886d6b8bed920b247267424ac5e9aa"}}, {start: {_id:862}, end: {_id:17}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"familial bond,parental connection", truncate:"", weight:1.0, description:"Krishnaji's sensitivity and connection extend to their daughter, reinforcing family bonds.", created_at:1779140252, source_id:"chunk-ad886d6b8bed920b247267424ac5e9aa"}}, {start: {_id:225}, end: {_id:172}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"cultural influence,educational affiliation,familial experience,mentorship,shared experiences,transformation", weight:4.0, created_at:1779144562, description:"The academy's culture, shaped by the narrator and Krishnaji's relationship, leads students to experience a sense of family.<SEP>Students at the academy report similar transformative experiences to the man?s.\" But since Students wasn't an entity, this is incorrect. So need to correct that by adding Students as an entity and then the relation.<SEP>Preethaji mentors thousands of students at the academy.<SEP>Students are part of the academy and are mentored by Preethaji.", source_id:"chunk-ad886d6b8bed920b247267424ac5e9aa<SEP>chunk-047b4478344df168d1315f3ec6d2549f<SEP>chunk-37f26db11e149c4af43719c414b748ce"}}, {start: {_id:225}, end: {_id:299}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cultural fabric,emotional foundation", truncate:"", weight:1.0, description:"Love and sensitivity permeate the academy's culture, influencing its natural dynamics and student experiences.", created_at:1779140252, source_id:"chunk-ad886d6b8bed920b247267424ac5e9aa"}}, {start: {_id:869}, end: {_id:868}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"necessity,relationship health", truncate:"", weight:1.0, description:"Mutual Evolution is essential for the thriving of Intimate Relationships.", created_at:1779140274, source_id:"chunk-c219578ff4da1678ae1ff2890bf677ec"}}, {start: {_id:866}, end: {_id:865}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conceptual identity,equivalence", truncate:"", weight:1.0, description:"Elixir of Life is the same as the Silent Power, representing a state of connection free of expectation.", created_at:1779140274, source_id:"chunk-c219578ff4da1678ae1ff2890bf677ec"}}, {start: {_id:863}, end: {_id:864}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"belonging,membership", truncate:"", weight:1.0, description:"Our Daughter is a member of the academy, experiencing a sense of family and shared culture.", created_at:1779140274, source_id:"chunk-c219578ff4da1678ae1ff2890bf677ec"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
