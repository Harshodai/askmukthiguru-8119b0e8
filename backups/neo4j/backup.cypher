UNWIND [{_id:4340, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)<SEP>YouTube Video: idoWVpnJz-Y (URL: https://www.youtube.com/watch?v=idoWVpnJz-Y)", entity_type:"concept", truncate:"", description:"Five types of father figures honored in the Hindu tradition: biological father, spiritual guide, wisdom-giver, provider, liberator, and ancestral director.<SEP>Father figures encompass individuals who act as paternal roles in one's life, including non-biological figures, as celebrated during Father's Day.", created_at:1779401956, source_id:"chunk-a1980aa574f493c3c88959244cbe1135<SEP>chunk-ed9bd777897b8b08ed12f0776796982a", entity_id:"Father Figures"}}, {_id:4341, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", entity_type:"concept", truncate:"", description:"A section in the input text that proposes fixes for the content.", created_at:1779262125, source_id:"chunk-0299e47f1b152a3bbc2dfc3315ac114a", entity_id:"My proposed fix"}}, {_id:4343, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", entity_type:"concept", truncate:"", description:"The number five, in the context of people worthy of honour as a father.", created_at:1779262125, source_id:"chunk-0299e47f1b152a3bbc2dfc3315ac114a", entity_id:"five people"}}, {_id:4344, properties:{file_path:"YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)<SEP>unknown_source", entity_type:"concept", truncate:"", created_at:1779393003, description:"Scavenging describes actions motivated by scarcity, such as seeking love or wealth through lack rather than connection.<SEP>Scavenging is a survival-driven behavior where individuals seek love, wealth, or money due to a state of scarcity.<SEP>Scavenging refers to the act of seeking people, love, wealth, or money driven by a sense of lack, focusing on filling personal voids rather than broader world concerns.", source_id:"chunk-5e61401ea9338b4be3174333aecd001b<SEP>chunk-9146e187edbee9cdbc50b048c433c6f9<SEP>chunk-407afcc34149e3cdc533c3a522a0ac53", entity_id:"Scavenging"}}, {_id:4345, properties:{file_path:"YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)<SEP>unknown_source", entity_type:"concept", truncate:"", description:"Space of scarcity refers to a mindset driven by lack, leading to behaviors like scavenging for love or wealth, contrasting with spiritual abundance.<SEP>A mindset characterized by lack, which leads to negative behaviors like scavenging.", created_at:1779392875, source_id:"chunk-5e61401ea9338b4be3174333aecd001b<SEP>chunk-3e00aec0d824214dc3b1bf504e305af0", entity_id:"Space of Scarcity"}}, {_id:4346, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", entity_type:"person", truncate:"", created_at:1779264471, description:"Rajiv is an individual from Sri Lanka seeking guidance during the economic crisis and job losses.<SEP>Rajiv is a person from Sri Lanka raising concerns about job loss and stress during the crisis.<SEP>Rajiv is a person from Sri Lanka who states his identity.<SEP>Rajiv is a person who addresses Pranam Krishnaji and Preethaji, and identifies as being from Sri Lanka.<SEP>Rajiv is a person from Sri Lanka who asks a question about overcoming economic crisis and finding hope.", source_id:"chunk-956d12a94e0e0bb6b9859844aca052b9<SEP>chunk-7c8c081356f803e6e944675013e90777<SEP>chunk-5794169a657bef1dbd99e3cafd5f72b2<SEP>chunk-a6c15670069ce32c9ed3e708da13d692<SEP>chunk-f84d092d5f110856868650619246d106", entity_id:"Rajiv"}}, {_id:4347, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", entity_type:"location", truncate:"", created_at:1779264471, description:"Sri Lanka is the location associated with Rajiv and mentioned in the context of global economic challenges.<SEP>Sri Lanka is one of the countries experiencing economic decline during the crisis.<SEP>Sri Lanka is the country of origin for Rajiv.<SEP>Sri Lanka is a location associated with Rajiv's origin.<SEP>Sri Lanka is the location of Rajiv, providing geographical context to the query.", source_id:"chunk-956d12a94e0e0bb6b9859844aca052b9<SEP>chunk-0de990c9c98448c49e9565dc513c171a<SEP>chunk-5794169a657bef1dbd99e3cafd5f72b2<SEP>chunk-a6c15670069ce32c9ed3e708da13d692<SEP>chunk-f84d092d5f110856868650619246d106", entity_id:"Sri Lanka"}}, {_id:4348, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", entity_type:"concept", truncate:"", description:"Global scenario describes the worldwide impact of the economic crisis affecting multiple countries.<SEP>Global scenario refers to the worldwide nature of the economic crisis affecting multiple regions.", created_at:1779264621, source_id:"chunk-956d12a94e0e0bb6b9859844aca052b9<SEP>chunk-e7c9f032dc546ceb8596a807018125ca", entity_id:"Global Scenario"}}, {_id:4349, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", entity_type:"person", truncate:"", created_at:1779665593, description:"Pranam Krishnaji is a spiritual figure mentioned in the text providing guidance during the crisis.<SEP>Pranam Krishnaji is a spiritual figure referenced in the text requiring transcription accuracy.<SEP>Pranam Krishnaji is a person mentioned in the salutation.<SEP>Pranam Krishnaji is a person addressed by Rajiv in the context of the reviewed content.<SEP>Pranam Krishnaji is mentioned as a spiritual figure, offering guidance and blessings.<SEP>Pranam Krishnaji is mentioned as part of the source context in the YouTube video.<SEP>Pranam Krishnaji is a person who is addressed with respect and is a leader in the context of the text.", source_id:"chunk-956d12a94e0e0bb6b9859844aca052b9<SEP>chunk-7c8c081356f803e6e944675013e90777<SEP>chunk-5794169a657bef1dbd99e3cafd5f72b2<SEP>chunk-a6c15670069ce32c9ed3e708da13d692<SEP>chunk-f84d092d5f110856868650619246d106<SEP>chunk-1858c31999fe39fe76b1a067f13f934d<SEP>chunk-5318d0efb35dd682803e91090103f4f5", entity_id:"Pranam Krishnaji"}}, {_id:4350, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", entity_type:"concept", truncate:"", created_at:1779264471, description:"Economic problem refers to external challenges like job losses and financial instability caused by the crisis.<SEP>An external challenge or hardship, such as an economic problem, which can lead to suffering.<SEP>An economic problem refers to external challenges impacting individuals, often leading to panic or anxiety when experienced.<SEP>Economic Problem refers to financial challenges that can trigger emotional reactions like panic or anxiety.<SEP>The economic problem is described as an external challenge that can lead to anxiety and suffering.", source_id:"chunk-956d12a94e0e0bb6b9859844aca052b9<SEP>chunk-4a88b9900bf621d698b72b33414ac811<SEP>chunk-28a9278165fe13a505446b814c02e9dc<SEP>chunk-9b20e4da8cf63963d1d2795ec8336f99<SEP>chunk-f84d092d5f110856868650619246d106", entity_id:"Economic Problem"}}, {_id:4351, properties:{file_path:"unknown_source", entity_type:"data", truncate:"", description:"Savings refers to financial reserves that have dwindled due to the crisis's economic impact.", created_at:1779263365, source_id:"chunk-956d12a94e0e0bb6b9859844aca052b9", entity_id:"Savings"}}, {_id:4352, properties:{file_path:"unknown_source", entity_type:"organization", truncate:"", description:"Economists are professionals involved in analyzing and addressing the economic crisis and its implications.", created_at:1779263365, source_id:"chunk-956d12a94e0e0bb6b9859844aca052b9", entity_id:"Economists"}}, {_id:4353, properties:{file_path:"unknown_source", entity_type:"organization", truncate:"", description:"Companies are mentioned as entities experiencing value declines during the economic downturn.", created_at:1779263365, source_id:"chunk-956d12a94e0e0bb6b9859844aca052b9", entity_id:"Companies"}}, {_id:4354, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)<SEP>YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"concept", truncate:"", description:"World leaders are mentioned as key figures who can leverage the crisis as an opportunity for positive change.<SEP>World leaders are individuals in positions of power who are expected to develop sustainable economic solutions.<SEP>World Leaders are mentioned in the corrected text as a group that will develop sustainable economic solutions.<SEP>World leaders are referenced as potential agents of change toward sustainable economic solutions.<SEP>World leaders exemplify success through relentless study and global awareness.<SEP>World leaders are individuals who achieve global influence and success through diverse knowledge and relentless effort.", created_at:1779648860, source_id:"chunk-956d12a94e0e0bb6b9859844aca052b9<SEP>chunk-070ab85d13e241f53294ba4c4f14edc8<SEP>chunk-f052a215d39997af4ee3fc4e97afa78e<SEP>chunk-1858c31999fe39fe76b1a067f13f934d<SEP>chunk-3f2351d7bbf12ee7e6a879305b4fddf7<SEP>chunk-40aaf5f6f81cde9add3f7814c3b1e73a", entity_id:"World Leaders"}}, {_id:4355, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The Text Correction Expert must not change the original meaning.", created_at:1779263508, source_id:"chunk-c7315241db164c482e52e3d3d9618453", entity_id:"Constraints: DO NOT retain the original meaning absolutely"}}, {_id:4356, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", entity_type:"concept", truncate:"", description:"Increased stress and suffering are consequences of the crisis and breakdown mentioned in the text.<SEP>Stress and suffering are mentioned as consequences of the economic situation.", created_at:1779264007, source_id:"chunk-7c8c081356f803e6e944675013e90777<SEP>chunk-5794169a657bef1dbd99e3cafd5f72b2", entity_id:"Stress and Suffering"}}, {_id:4357, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", entity_type:"concept", truncate:"", description:"The 'next move' refers to future actions to be taken once the situation stabilizes.", created_at:1779263608, source_id:"chunk-7c8c081356f803e6e944675013e90777", entity_id:"Next Move"}}, {_id:4358, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", entity_type:"concept", truncate:"", description:"A mental state of calmness and clarity that enables connection to universal intelligence.", created_at:1779263794, source_id:"chunk-4a88b9900bf621d698b72b33414ac811", entity_id:"State of Inner Stillness"}}, {_id:4359, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", entity_type:"concept", truncate:"", description:"The ability to gain insights or solutions without conscious reasoning, often linked to inner stillness.<SEP>Intuition refers to the ability to gain insights about future directions through connection to universal intelligence.", created_at:1779264136, source_id:"chunk-4a88b9900bf621d698b72b33414ac811<SEP>chunk-9b20e4da8cf63963d1d2795ec8336f99", entity_id:"Intuition"}}, {_id:4361, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)<SEP>unknown_source<SEP>YouTube Video: fiABnex9O6Y (URL: https://www.youtube.com/watch?v=fiABnex9O6Y)<SEP>YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", entity_type:"concept", truncate:"", description:"We need to produce a merged description for the entity \"Mystic\". The description list includes:

