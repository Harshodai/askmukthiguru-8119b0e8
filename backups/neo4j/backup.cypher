UNWIND [{_id:4122, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"concept", truncate:"", description:"Victims of domestic violence during lockdowns, subjected to abuse due to perpetrators' unchecked aggression.", created_at:1779254179, source_id:"chunk-4043681cb90e5032a1d66db36f936a98", entity_id:"Innocent Children and Women"}}, {_id:4123, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"concept", truncate:"", description:"Men prone to violence, often addicts, who target innocent children and women during lockdowns due to frustration.", created_at:1779254179, source_id:"chunk-4043681cb90e5032a1d66db36f936a98", entity_id:"Domestic Violence Perpetrators"}}, {_id:4124, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"concept", truncate:"", description:"Silent torture refers to the hidden abuse and violence occurring within families, often unnoticed by society.", created_at:1779254180, source_id:"chunk-4043681cb90e5032a1d66db36f936a98", entity_id:"Silent Torture"}}, {_id:4125, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"concept", truncate:"", description:"Suspicion is a concept that, along with anger and jealousy, can grow and consume a person.", created_at:1779254321, source_id:"chunk-1585d67082ac380dcec744bed4f90b26", entity_id:"Suspicion"}}, {_id:4126, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)<SEP>unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"concept", truncate:"", description:"Slavery is a concept equated with obedience, not love.<SEP>Slavery is portrayed as a state of being enslaved, whether through addiction or possessiveness, characterized by lack of freedom.<SEP>Slavery is portrayed as a state of being enslaved, whether through addiction or possessiveness, characterized by lack of freedom.<SEP>Metaphor for how addiction and obsession enslave individuals, as highlighted in the narrative.<SEP>Slavery is described as dependence on a person, substance, or love-driven fear of loss, contrasting with pure love.<SEP>Slavery is described as dependence on a person, substance, or love-driven fear of loss, contrasting with pure love.", created_at:1779557180, source_id:"chunk-1585d67082ac380dcec744bed4f90b26<SEP>chunk-5c1ed637dca2d0d131d85c8ff4dd33cb<SEP>chunk-98e0115fe065f5dab78321b7c772863d<SEP>chunk-1d477f5607ac5cfb56e2b711bd58f1aa", entity_id:"Slavery"}}, {_id:4127, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)<SEP>YouTube Video: WfkCDNu4SuE (URL: https://www.youtube.com/watch?v=WfkCDNu4SuE)<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=RvgN5Mfbd5A)", entity_type:"concept", truncate:"", description:"Jealousy is a concept that, along with anger and suspicion, can grow and consume a person.<SEP>Jealousy is a greed-related state dissolved during the spiritual process of Navratri.<SEP>A suffering state arising from feeling lesser than others in love or status.<SEP>Jealousy is an emotion conflicting with the selflessness of true friendship.", created_at:1779675623, source_id:"chunk-ae33a0629a1035831d09370dbcb6fa05<SEP>chunk-fee40675765ad977a79817e44542ea72<SEP>chunk-1585d67082ac380dcec744bed4f90b26<SEP>chunk-49d819fbab36af31ec15419ab94d1279<SEP>chunk-beeabf4db9d94499feff9e07a340c9a1<SEP>chunk-f9137367b6fc0c1e310ef8df615fc408", entity_id:"Jealousy"}}, {_id:4130, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"concept", truncate:"", description:"Obedience is equated with slavery, not love.", created_at:1779254321, source_id:"chunk-1585d67082ac380dcec744bed4f90b26", entity_id:"Obedience"}}, {_id:4131, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"concept", truncate:"", description:"Insult is a concept that obstructs the possibility of love.", created_at:1779254322, source_id:"chunk-1585d67082ac380dcec744bed4f90b26", entity_id:"Insult"}}, {_id:4133, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"person", truncate:"", description:"Girl Child is a person who, when violated, can cause a family to lose abundance.", created_at:1779254323, source_id:"chunk-1585d67082ac380dcec744bed4f90b26", entity_id:"Girl Child"}}, {_id:4134, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"content", truncate:"", description:"YouTube video discussing family harmony, divine connection, and the mantra Hamsa Soham Ekam for spiritual transformation.", created_at:1779254369, source_id:"chunk-22fbf22f17126e6b5377570cdb342627", entity_id:"The Secret of Consciousness (YouTube Video)"}}, {_id:4135, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"concept", truncate:"", description:"Ye Ye Ye is a mantra or chant phrase used in the repetition, possibly indicating a call or invocation.", created_at:1779254416, source_id:"chunk-b65b7a91b3418aca3d1c110687b32d7d", entity_id:"Ye Ye Ye"}}, {_id:4136, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"concept", truncate:"", description:"Corrected text output must strictly adhere to error fixes without rewriting or summarizing the original content.", created_at:1779254677, source_id:"chunk-630c2f6f755544fb8faad7d730e0ae19", entity_id:"Corrected Text Output"}}, {_id:4137, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"concept", truncate:"", description:"The repeated \"Ye\" phrases in the input text represent a transcription error requiring correction.", created_at:1779254677, source_id:"chunk-630c2f6f755544fb8faad7d730e0ae19", entity_id:"Ye Repetition"}}, {_id:4139, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"content", truncate:"", created_at:1779255640, description:"Soham is a variation of the mantra mentioned alongside \"Hamsa Soham,\" used in repetitive spiritual contexts.<SEP>A mantra-like term in the chant, interpreted as a central conceptual element in the edited text.<SEP>Soham is a term used in the content, part of a repetitive phrase structure.<SEP>A term used in spiritual practices, often associated with mantras or affirmations in Hindu traditions.<SEP>A term used in the chant, possibly representing a spiritual or meditative concept.<SEP>Soham is a term used in the chant, representing a spiritual or meditative concept.<SEP>Soham is a term used in the text, appearing in the context of correcting a transcription and as part of a repetitive phrase.", source_id:"chunk-f02d58016cb210cdabb5a0e4e34489b9<SEP>chunk-a9194a082af2660cd6f682f46026e1e2<SEP>chunk-9cae7143f497353be3068de2f13fe25c<SEP>chunk-a838d7152e4bebf83c9201b3d383a669<SEP>chunk-b1305ddb839be73a31e060addb9a200a<SEP>chunk-3f84526c0b3a657b3cc715347c2c1a58<SEP>chunk-52bc2f160d5933b804fba7010cd61529", entity_id:"Soham"}}, {_id:4140, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"concept", truncate:"", description:"Christian Namaste is a term that blends Christian and Indian cultural elements, as referenced in the closing of a text. It appears in the context of a revised chant and a corrected version, where it functions as a closing phrase symbolizing forgiveness and spiritual closure. The phrase is also described as a greeting that blends Christian and Indian traditions, embodying respect and spiritual connection.

Additionally, Christian Namaste is presented as a spiritual or religious concept, a mantra, or a blessing, often associated with forgiveness and support within a family. It is mentioned in the content as a term that may carry spiritual significance, and it is used in various contexts, including as a greeting, a closing phrase, and a spiritual concept. The phrase's usage spans across different parts of the text, indicating its multifaceted role in the narrative.", created_at:1779255740, source_id:"chunk-f02d58016cb210cdabb5a0e4e34489b9<SEP>chunk-fa4bb63d0902fb02ca5150a0e404f97c<SEP>chunk-9cae7143f497353be3068de2f13fe25c<SEP>chunk-a838d7152e4bebf83c9201b3d383a669<SEP>chunk-b1305ddb839be73a31e060addb9a200a<SEP>chunk-41070a47242b017794bd4b01d9403428<SEP>chunk-3f84526c0b3a657b3cc715347c2c1a58<SEP>chunk-52bc2f160d5933b804fba7010cd61529", entity_id:"Christian Namaste"}}, {_id:4141, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"UNKNOWN", truncate:"", description:"The term \"Christian Namaste\" contextualizes the emphasis on family forgiveness and support for transformation within familial relationships.", created_at:1779254747, source_id:"chunk-f02d58016cb210cdabb5a0e4e34489b9", entity_id:"family dynamics"}}, {_id:4142, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"concept", truncate:"", description:"Repetitive structure in the original text causing awkward phrasing and poor readability.", created_at:1779254801, source_id:"chunk-863f9e536320fb607179b5b22c477c8c", entity_id:"Structural Issue"}}, {_id:4143, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"artifact", truncate:"", description:"The original source material from which the chant was transcribed.", created_at:1779254801, source_id:"chunk-863f9e536320fb607179b5b22c477c8c", entity_id:"Recording"}}, {_id:4144, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"content", truncate:"", description:"Repetitive phrases from the chant transcription, including \"me. Hamsa soham We come.\"", created_at:1779254801, source_id:"chunk-863f9e536320fb607179b5b22c477c8c", entity_id:"Original Chant Lines"}}, {_id:4145, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"method", truncate:"", description:"The task of fixing transcription errors and improving readability in the chant text.", created_at:1779254801, source_id:"chunk-863f9e536320fb607179b5b22c477c8c", entity_id:"User's Job"}}] AS row
