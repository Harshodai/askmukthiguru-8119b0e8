UNWIND [{start: {_id:5869}, end: {_id:2466}, properties:{file_path:"YouTube Video: 2seBB2oByZc (URL: https://www.youtube.com/watch?v=2seBB2oByZc)", truncate:"", keywords:"crisis management,state responsibility", weight:1.0, description:"The state is positioned as the entity addressing social crises.", created_at:1779537175, source_id:"chunk-5f06ba1ae7a3d1eb5ae89a5a7db786f0"}}, {start: {_id:5865}, end: {_id:5866}, properties:{file_path:"YouTube Video: 2seBB2oByZc (URL: https://www.youtube.com/watch?v=2seBB2oByZc)", truncate:"", keywords:"accessibility,social function", weight:1.0, description:"Marriages are held in community centers as free social events.", created_at:1779537175, source_id:"chunk-5f06ba1ae7a3d1eb5ae89a5a7db786f0"}}, {start: {_id:5867}, end: {_id:5865}, properties:{file_path:"YouTube Video: 2seBB2oByZc (URL: https://www.youtube.com/watch?v=2seBB2oByZc)", truncate:"", keywords:"accessibility,social function", weight:1.0, description:"Birthday parties are enabled through community centers.", created_at:1779537176, source_id:"chunk-5f06ba1ae7a3d1eb5ae89a5a7db786f0"}}, {start: {_id:5852}, end: {_id:5854}, properties:{file_path:"unknown_source<SEP>YouTube Video: uvhEf3ToMHI (URL: https://www.youtube.com/watch?v=uvhEf3ToMHI)", keywords:"dispelling,enlightenment,festival purpose", truncate:"", weight:2.0, description:"Mahashivaratri is observed to eliminate ignorance and its manifestations in human existence.<SEP>Mahashivaratri is a day to dispel ignorance and begin an enlightenment state journey.", created_at:1779551476, source_id:"chunk-0b3b9413e3a4acbecc07f577488e54e4<SEP>chunk-8f956406c1498a0f42494ef30d6087a0"}}, {start: {_id:5855}, end: {_id:5854}, properties:{file_path:"unknown_source", keywords:"initiation,spiritual practice", truncate:"", weight:1.0, description:"The festival marks the beginning of the first enlightenment state journey for participants.", created_at:1779551416, source_id:"chunk-0b3b9413e3a4acbecc07f577488e54e4"}}, {start: {_id:5852}, end: {_id:5856}, properties:{file_path:"unknown_source", keywords:"driving force,false pursuit", truncate:"", weight:1.0, description:"Ignorance leads individuals to seek happiness through material achievements.", created_at:1779551432, source_id:"chunk-0b3b9413e3a4acbecc07f577488e54e4"}}, {start: {_id:5853}, end: {_id:5854}, properties:{file_path:"unknown_source<SEP>YouTube Video: uvhEf3ToMHI (URL: https://www.youtube.com/watch?v=uvhEf3ToMHI)", keywords:"dispelling,spiritual cleansing,spiritual significance", truncate:"", weight:2.0, description:"The festival symbolically removes darkness (suffering) to facilitate enlightenment.<SEP>Mahashivaratri is celebrated to dispel the darkness of ignorance and suffering.", created_at:1779551476, source_id:"chunk-0b3b9413e3a4acbecc07f577488e54e4<SEP>chunk-8f956406c1498a0f42494ef30d6087a0"}}, {start: {_id:5857}, end: {_id:5854}, properties:{file_path:"YouTube Video: uvhEf3ToMHI (URL: https://www.youtube.com/watch?v=uvhEf3ToMHI)", keywords:"associated with,part of", truncate:"", weight:1.0, description:"The enlightened festival is part of the Mahashivaratri event.", created_at:1779551476, source_id:"chunk-8f956406c1498a0f42494ef30d6087a0"}}, {start: {_id:752}, end: {_id:197}, properties:{file_path:"YouTube Video: 2seBB2oByZc (URL: https://www.youtube.com/watch?v=2seBB2oByZc)", truncate:"", keywords:"conflict,improvement,respect,social harmony", weight:2.0, description:"The community's lack of respect for the inner world leads to conflict and resistance against its importance.<SEP>Improving the inner world can lead to better community engagement and harmony.", created_at:1779551918, source_id:"chunk-9eea478f3eb12a678ce672d3075c4af8"}}, {start: {_id:752}, end: {_id:2392}, properties:{file_path:"YouTube Video: 2seBB2oByZc (URL: https://www.youtube.com/watch?v=2seBB2oByZc)", keywords:"influence,social factors", truncate:"", weight:1.0, description:"Religion plays a role in the community's dynamics and interactions.", created_at:17