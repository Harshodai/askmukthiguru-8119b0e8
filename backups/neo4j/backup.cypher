UNWIND [{start: {_id:463}, end: {_id:2452}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2DLb6hDIhmg)", keywords:"adaptation,extinction", truncate:"", weight:1.0, description:"The text connects civilizations' extinction to their inability to adapt, paralleling the need to respect nature's dangers.", created_at:1779211125, source_id:"chunk-eabf34c739b02ca3de693a11f2216499"}}, {start: {_id:463}, end: {_id:1395}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2DLb6hDIhmg)", truncate:"", keywords:"authority,historical lessons", weight:1.0, description:"Leaders' directives mirror the consequences faced by past civilizations that failed to adapt, emphasizing the necessity of heeding historical lessons.", created_at:1779211126, source_id:"chunk-eabf34c739b02ca3de693a11f2216499"}}, {start: {_id:463}, end: {_id:692}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2DLb6hDIhmg)", truncate:"", keywords:"adaptation failure,extinction", weight:1.0, description:"Civilizations faced total extinction due to their refusal to adapt and change, serving as a historical warning against stagnation.", created_at:1779211126, source_id:"chunk-eabf34c739b02ca3de693a11f2216499"}}, {start: {_id:694}, end: {_id:697}, properties:{file_path:"unknown_source", keywords:"conceptual relationship,definition", truncate:"", weight:1.0, description:"Mananam Trayati Iti Mantra is presented as a type of mantra with the function of silencing the mind, though its literal meaning is debated.", created_at:1779212331, source_id:"chunk-0a2c974bf936eb57ae5447e3de45ce75"}}, {start: {_id:722}, end: {_id:2129}, properties:{file_path:"unknown_source", keywords:"meditation focus,spiritual symbolism", truncate:"", weight:1.0, description:"Hanuman's ego-victory symbolizes the meditative focus on selflessness during mantra chanting.", created_at:1779212331, source_id:"chunk-04b32295251921d572678567c60204df"}}, {start: {_id:2176}, end: {_id:703}, properties:{file_path:"unknown_source", keywords:"category classification,examples", truncate:"", weight:1.0, description:"Ekam mantra is categorized as a siddha mantra with universal applicability and healing potential.", created_at:1779212332, source_id:"chunk-04b32295251921d572678567c60204df"}}, {start: {_id:479}, end: {_id:714}, properties:{file_path:"unknown_source", truncate:"", keywords:"energy transfer,spiritual application", weight:1.0, description:"Mantra shakti generated through chanting can be directed toward others for recovery or empowerment.", created_at:1779212332, source_id:"chunk-04b32295251921d572678567c60204df"}}, {start: {_id:704}, end: {_id:747}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"emotional regulation,silences", weight:1.0, description:"Silencing the amygdala leads to the silencing of painful mental chatter.", created_at:1779212553, source_id:"chunk-9656a8edd47ef08164c3565d2801af16"}}, {start: {_id:704}, end: {_id:725}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"neurological impact,practice", weight:1.0, description:"Repetition of mantra directly impacts the amygdala to achieve mental calmness.", created_at:1779212553, source_id:"chunk-9656a8edd47ef08164c3565d2801af16"}}, {start: {_id:704}, end: {_id:749}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"psychological effect,silences", weight:1.0, description:"Silencing the amygdala leads to reduced painful mental chatter.", created_at:1779212595, source_id:"chunk-5bdd4af6edc5e8065c7f95fb8fc0543f"}}, {start: {_id:748}, end: {_id:2129}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", keywords:"example,focus technique", truncate:"", weight:1.0, description:"Hanuman serves as an example for performing dharana on a form or essence.", created_at:1779212595, source_id:"chunk-5bdd4af6edc5e8065c7f95fb8fc0543f"}}, {start: {_id:2129}, end: {_id:756}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", keywords:"no changes,proper noun", truncate:"", weight:1.0, description:"Hanuman is identified as a proper name requiring no modifications in the text.", created_at:1779212621, source_id:"chunk-afe36d24117a71892315d804e0792496"}}, {start: {_id:750}, end: {_id:763}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"common usage,valid spelling", weight:1.0, description:"egolessness is acknowledged as a valid spelling choice in the context of spiritual terminology.", created_at:1779212621, source_id:"chunk-afe36d24117a71892315d804e0792496"}}, {start: {_id:1791}, end: {_id:773}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", keywords:"accuracy,replacement", truncate:"", weight:1.0, description:"The corrected text replaces \"manenath trananath\" with \"manana that protects\" for accuracy.", created_at:1779212678, source_id:"chunk-f4e31e3d7acd5226175acba9778623e9"}}, {start: {_id:769}, end: {_id:2144}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"analysis,domain-specific term", weight:1.0, description:"The original text includes the term \"darshan,\" which is analyzed as a domain-specific term.", created_at:1779212678, source_id:"chunk-f4e31e3d7acd5226175acba9778623e9"}}, {start: {_id:774}, end: {_id:2144}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", keywords:"correction,mishearing", truncate:"", weight:1.0, description:"The original text contains \"manenath trananath,\" which is a mishearing of \"manana that protects.\"", created_at:1779212678, source_id:"chunk-f4e31e3d7acd5226175acba9778623e9"}}, {start: {_id:2144}, end: {_id:750}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"common variant,term analysis", weight:1.0, description:"The original text includes the term \"egolessness\" as a direct transcription, noted as a common variant but not corrected.", created_at:1779212678, source_id:"chunk-f4e31e3d7acd5226175acba9778623e9"}}, {start: {_id:348}, end: {_id:775}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"content,error,source", weight:2.0, description:"The YouTube video contains the text where the term \"manenath trananath\" is defined and needs correction.<SEP>The YouTube Video contains the incorrect term \"manenath trananath\" which is discussed in the text.", created_at:1779212785, source_id:"chunk-22ae4a6d383bcd6eb1c726163e13f796<SEP>chunk-9b83c76bc3fe3180b40c2a152ab4f314"}}, {start: {_id:775}, end: {_id:805}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", keywords:"definition,meaning", truncate:"", weight:1.0, description:"The term \"manenath trananath\" is defined as \"that which protects\".", created_at:1779212741, source_id:"chunk-22ae4a6d383bcd6eb1c726163e13f796"}}, {start: {_id:1594}, end: {_id:775}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", keywords:"context,correction,list", truncate:"", weight:2.0, description:"The term \"manenath trananath\" is being corrected based on the context of the list of terms.<SEP>The term \"manenath trananath\" is part of a list of terms including \"Sadhana\".", created_at:1779212742, source_id:"chunk-22ae4a6d383bcd6eb1c726163e13f796"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
