UNWIND [{start: {_id:1815}, end: {_id:4441}, properties:{file_path:"YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)", keywords:"intentionality,passion", truncate:"", weight:1.0, description:"Actions emerge from a deep state of connection with passionate intent.", created_at:1779392981, source_id:"chunk-8c7d4ae28dcb0e3eed4f5fc9c1814de9"}}, {start: {_id:4437}, end: {_id:1329}, properties:{file_path:"YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)", keywords:"lack,negative impact", truncate:"", weight:1.0, description:"Scarcity-driven actions harm the web of life through self-centered behavior.", created_at:1779392981, source_id:"chunk-8c7d4ae28dcb0e3eed4f5fc9c1814de9"}}, {start: {_id:2390}, end: {_id:348}, properties:{file_path:"YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)<SEP>YouTube Video: KTlY-lHs_Ew (URL: https://www.youtube.com/watch?v=KTlY-lHs_Ew)", truncate:"", keywords:"conceptual focus,content,content focus,critique,discussion,reference,source,thematic discussion", weight:5.0, created_at:1779398288, description:"The video serves as the source for the discussion on spirituality and its implications.<SEP>The video centers on exploring spirituality through analogies and philosophical reflections.<SEP>The video critiques spirituality as distinct from religious practices and daily routines.<SEP>The video discusses spirituality as a concept, including its stages and enlightenment.<SEP>The spiritual concepts are discussed in the context of the YouTube video source.", source_id:"chunk-8c7d4ae28dcb0e3eed4f5fc9c1814de9<SEP>chunk-8747b8559b6ab050bd73313beb85bb44<SEP>chunk-35e15581ad50dde0c800dac7e7b512c1<SEP>chunk-dba394b8ea38273841a7f5467d696e0c<SEP>chunk-6a5c1cd3abe977e04aa0398546d911a7"}}, {start: {_id:4453}, end: {_id:4344}, properties:{file_path:"YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)", truncate:"", keywords:"cause and effect,motivation", weight:1.0, description:"Scavenging is driven by a sense of lack, which limits one's ability to think beyond personal voids.", created_at:1779393027, source_id:"chunk-407afcc34149e3cdc533c3a522a0ac53"}}, {start: {_id:1970}, end: {_id:4454}, properties:{file_path:"YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)", truncate:"", keywords:"state and outcome", weight:1.0, description:"Abundance consciousness leads to an effortless, harmonious life filled with synchronicities and magic.", created_at:1779393027, source_id:"chunk-407afcc34149e3cdc533c3a522a0ac53"}}, {start: {_id:299}, end: {_id:4344}, properties:{file_path:"YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)", keywords:"motivation,seeking", truncate:"", weight:1.0, description:"Scavenging for love reflects a desire to fulfill emotional needs stemming from a sense of lack.", created_at:1779393027, source_id:"chunk-407afcc34149e3cdc533c3a522a0ac53"}}, {start: {_id:4344}, end: {_id:933}, properties:{file_path:"YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)", keywords:"motivation,seeking", truncate:"", weight:1.0, description:"Scavenging for wealth highlights the pursuit of material security driven by insecurity.", created_at:1779393028, source_id:"chunk-407afcc34149e3cdc533c3a522a0ac53"}}, {start: {_id:1948}, end: {_id:4344}, properties:{file_path:"YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)", keywords:"motivation,seeking", truncate:"", weight:1.0, description:"Scavenging for money underscores the focus on financial resources to address personal voids.", created_at:1779393028, source_id:"chunk-407afcc34149e3cdc533c3a522a0ac53"}}, {start: {_id:176}, end: {_id:4460}, properties:{file_path:"unknown_source", truncate:"", keywords:"educational content,philosophical concept", weight:1.0, description:"The teaching of spiritual vision is explicitly linked to the concept of living in a state.", created_at:1779393616, source_id:"chunk-0cb2ad4f2fa6ea6751b33e0b49df2868"}}, {start: {_id:4302}, end: {_id:2466}, properties:{file_path:"unknown_source<SEP>YouTube Video: 4_Fqfew1PRk (URL: https://www.youtube.com/watch?v=4_Fqfew1PRk)", keywords:"contrast,societal perception,spiritual perspective,spiritual philosophy", truncate:"", weight:2.0, description:"The text contrasts \"living in a state\" with viewing life as \"duty,\" positioning them as opposing perspectives.<SEP>Living in a state transforms the perception of life from duty to presence, contrasting societal views of obligations as burdens.", created_at:1779393710, source_id:"chunk-0cb2ad4f2fa6ea6751b33e0b49df2868<SEP>chunk-858bc08530c3ab537fc81f04b5fef0be"}}, {start: {_id:1787}, end: {_id:1594}, properties:{file_path:"unknown_source", keywords:"correction example,misheard term", truncate:"", weight:1.0, description:"Homophones and misheard words include the misheard term \"Sadhana\" which needs correction.", created_at:1779393637, source_id:"chunk-d66cf68ce9f6d614d8c2ffeac6619b27"}}, {start: {_id:1787}, end: {_id:1500}, properties:{file_path:"unknown_source", keywords:"correction example,misheard term", truncate:"", weight:1.0, description:"Homophones and misheard words include the misheard term \"Limitless Field\" which needs correction.", created_at:1779393637, source_id:"chunk-d66cf68ce9f6d614d8c2ffeac6619b27"}}, {start: {_id:4326}, end: {_id:4462}, properties:{file_path:"YouTube Video: 4_Fqfew1PRk (URL: https://www.youtube.com/watch?v=4_Fqfew1PRk)", truncate:"", keywords:"educational focus,practical application", weight:1.0, description:"Coachings include managing calendars as part of organizational strategies, limited by state.", created_at:1779393709, source_id:"chunk-858bc08530c3ab537fc81f04b5fef0be"}}, {start: {_id:2466}, end: {_id:348}, properties:{file_path:"YouTube Video: 4_Fqfew1PRk (URL: https://www.youtube.com/watch?v=4_Fqfew1PRk)", truncate:"", keywords:"conceptual focus,content source", weight:1.0, description:"The YouTube video contains the lecture discussing the concept of living in a state versus duty.", created_at:1779393710, source_id:"chunk-858bc08530c3ab537fc81f04b5fef0be"}}, {start: {_id:4302}, end: {_id:4461}, properties:{file_path:"YouTube Video: 4_Fqfew1PRk (URL: https://www.youtube.com/watch?v=4_Fqfew1PRk)", truncate:"", keywords:"cultural expectations,obligation", weight:1.0, description:"Duty is culturally enforced through societal roles like husband, wife, parent, and child, reinforcing perceived burdens.", created_at:1779393710, source_id:"chunk-858bc08530c3ab537fc81f04b5fef0be"}}, {start: {_id:2466}, end: {_id:4463}, properties:{file_path:"YouTube Video: 4_Fqfew1PRk (URL: https://www.youtube.com/watch?v=4_Fqfew1PRk)", keywords:"absence,consequence", truncate:"", weight:1.0, description:"Lack of a spiritual state leads to exhaustion and inability to sustain management practices.", created_at:1779393710, source_id:"chunk-858bc08530c3ab537fc81f04b5fef0be"}}, {start: {_id:4303}, end: {_id:4464}, properties:{file_path:"YouTube Video: 4_Fqfew1PRk (URL: https://www.youtube.com/watch?v=4_Fqfew1PRk)", keywords:"location,participation", truncate:"", weight:1.0, description:"Prieta G is currently in Miami and participating in a program there.", created_at:1779393756, source_id:"chunk-49304f84faf57d420319d7f532984c7b"}}, {start: {_id:4464}, end: {_id:4465}, properties:{file_path:"YouTube Video: 4_Fqfew1PRk (URL: https://www.youtube.com/watch?v=4_Fqfew1PRk)", keywords:"busyness,time constraints", truncate:"", weight:1.0, description:"Prieta G's busyness with the program leads to infrequent communication with her father.", created_at:1779393756, source_id:"chunk-49304f84faf57d420319d7f532984c7b"}}, {start: {_id:4464}, end: {_id:2466}, properties:{file_path:"YouTube Video: 4_Fqfew1PRk (URL: https://www.youtube.com/watch?v=4_Fqfew1PRk)", keywords:"emotional state,love", truncate:"", weight:1.0, description:"Prieta G's actions reflect a state of being loved and the emotional connection with her father.", created_at:1779393756, source_id:"chunk-49304f84faf57d420319d7f532984c7b"}}, {start: {_id:4303}, end: {_id:4465}, properties:{file_path:"YouTube Video: 4_Fqfew1PRk (URL: https://www.youtube.com/watch?v=4_Fqfew1PRk)", keywords:"event location,venue", truncate:"", weight:1.0, description:"The program is being conducted in Miami.", created_at:1779393756, source_id:"chunk-49304f84faf57d420319d7f532984c7b"}}] AS row
