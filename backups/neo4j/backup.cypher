UNWIND [{start: {name:"Consciousness"}, end: {_id:6450}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"clarity,conceptual link", truncate:"", weight:1.0, description:"Consciousness fosters equanimity, enabling individuals to remain unfazed by challenges and respond with clarity.", created_at:1779561380, source_id:"chunk-9645fe2118f4e6de1b034351a972ae59"}}, {start: {name:"Dharma"}, end: {_id:6478}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"categorization,classification", truncate:"", weight:2.0, description:"Sudharma is a subset of Dharma, representing purpose aligned with one's true self.<SEP>Sudharma is a subset of Dharma, representing purpose aligned with one's true self.", created_at:1779561734, source_id:"chunk-6b92caeb732cbb11f4b5fe1ca7825dee"}}, {start: {name:"Dharma"}, end: {_id:6479}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"classification,contrast", truncate:"", weight:2.0, description:"Paradharma contrasts with Dharma by representing purposes that contradict one's inherent nature.<SEP>Paradharma contrasts with Dharma by representing purposes that contradict one's inherent nature.", created_at:1779561734, source_id:"chunk-6b92caeb732cbb11f4b5fe1ca7825dee"}}, {start: {name:"Ekam"}, end: {_id:6651}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"inner journey,transformation", weight:1.0, description:"ed undergoes an inner journey at Ekam, leading to self-realization.", created_at:1779564385, source_id:"chunk-08331bfaac45fcb68867c11cb7fb41b4"}}, {start: {name:"Consciousness"}, end: {_id:6717}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"composition,duality", truncate:"", weight:2.0, description:"Consciousness is defined as a duality of matter and energy, forming the basis of existence.<SEP>Consciousness is defined as a duality of matter and energy, forming the basis of existence.", created_at:1779646728, source_id:"chunk-c2d71d77d8cb4da3ae9b2dde12795713"}}, {start: {name:"Consciousness"}, end: {_id:6711}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"representation,symbolism", truncate:"", weight:1.0, description:"Dark clouds represent the suffering and problems of humanity within the concept of Consciousness.", created_at:1779646730, source_id:"chunk-5750a413a72601ce81e6195a148e09ad"}}, {start: {name:"Consciousness"}, end: {_id:6357}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"consciousness type,experience", weight:1.0, description:"Consciousness is experienced as eye Consciousness, a divided state.", created_at:1779646731, source_id:"chunk-5750a413a72601ce81e6195a148e09ad"}}, {start: {name:"Consciousness"}, end: {_id:5443}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"consciousness type,experience", weight:1.0, description:"Consciousness is experienced as One Consciousness, a unified state.", created_at:1779646731, source_id:"chunk-5750a413a72601ce81e6195a148e09ad"}}, {start: {name:"Oneness"}, end: {_id:6726}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"alleviation,emotional balance", weight:1.0, description:"Reaching Oneness alleviates stress and anxiety, promoting emotional balance.", created_at:1779647006, source_id:"chunk-abcd9205e6cb81b428a3257c9dbf7dc6"}}, {start: {name:"Consciousness"}, end: {_id:6736}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"modes of experience,states of awareness", weight:1.0, description:"Consciousness manifests as either divided eye Consciousness or unified One Consciousness.", created_at:1779647056, source_id:"chunk-c4dd697e014967c1d2f280a84164c9e2"}}, {start: {name:"Oneness"}, end: {_id:6718}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"concept,reference", weight:1.0, description:"The phrase \"Oneness state\" references the concept of Oneness.", created_at:1779647229, source_id:"chunk-b64e03d5159fd3c4e333e9641ee8fb81"}}, {start: {name:"Oneness"}, end: {_id:6740}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"metaphor,philosophical concept", weight:1.0, description:"The video explores the concept of Oneness and its contrast with human fragmentation through metaphor.", created_at:1779647320, source_id:"chunk-fb20367827f31cb284dc2e32ba2e1bb0"}}, {start: {name:"Oneness"}, end: {_id:5763}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"resolution,synthesis", truncate:"", weight:1.0, description:"Values are among the fragmented pieces synthesized into Oneness per the text's metaphor.", created_at:1779647442, source_id:"chunk-7acdb8dcc103d74a206701373f78fcb9"}}, {start: {name:"Ekam"}, end: {_id:6740}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"correction instruction,terminology", weight:1.0, description:"The YouTube video provides guidelines to correct the term \"Ekam\" in the text, ensuring consistent capitalization and adherence to intended meaning.", created_at:1779648167, source_id:"chunk-84c10fe557e02dadbe2e1141b93facd2"}}, {start: {name:"Oneness"}, end: {_id:6790}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"discussion,solution", truncate:"", weight:1.0, description:"The video discusses Oneness as a solution to global divisiveness and promotes World Oneness Day.", created_at:1779648506, source_id:"chunk-5e293d2f56a82348c78f2cc08b14a7e1"}}, {start: {name:"Deeksha"}, end: {_id:1661}, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", truncate:"", keywords:"correction focus,domain-specific term", weight:1.0, description:"The task involves correcting the term \"Deeksha\" as part of the domain-specific terms.", created_at:1779652190, source_id:"chunk-0e391fe0cec27f44babfa66b10652acf"}}, {start: {name:"Ekam"}, end: {_id:1661}, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", truncate:"", keywords:"correction focus,domain-specific term", weight:1.0, description:"The task involves correcting the term \"Ekam\" as part of the domain-specific terms.", created_at:1779652194, source_id:"chunk-0e391fe0cec27f44babfa66b10652acf"}}, {start: {name:"Beautiful State"}, end: {_id:2081}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", keywords:"consciousness,emotional basis,foundation,powerful decisions", truncate:"", weight:2.0, description:"Decisions rooted in a beautiful state foster stronger willpower.<SEP>Decisions made from a beautiful state are more powerful and lead to accomplishment.", created_at:1779653612, source_id:"chunk-f911f447e8921c9205ec53996cfbe423<SEP>chunk-37eeb06653208eee260f3881daf51f3a"}}, {start: {name:"Beautiful State"}, end: {_id:7040}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", keywords:"enhancement,metaphor", truncate:"", weight:1.0, description:"The beautiful state enhances the roots (consciousness), leading to stronger drive and willpower.", created_at:1779653558, source_id:"chunk-56da25e7d132b4ecea54c551b7809f75"}}, {start: {name:"Beautiful State"}, end: {_id:2668}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", keywords:"enhancement,resilience", truncate:"", weight:1.0, description:"A beautiful state enhances willpower, making it more resilient against challenges.", created_at:1779653558, source_id:"chunk-56da25e7d132b4ecea54c551b7809f75"}}] AS row
