 keywords:"positive,state of mind", truncate:"", weight:1.0, description:"Abundance consciousness leads to acts of contribution.", created_at:1779392913, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0"}}, {start: {_id:2390}, end: {_id:1329}, properties:{file_path:"YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)", truncate:"", keywords:"contribution,interconnectedness", weight:1.0, description:"Spirituality's expanded state leads to actions that impact the web of life.", created_at:1779392981, source_id:"chunk-8c7d4ae28dcb0e3eed4f5fc9c1814de9"}}] AS row
