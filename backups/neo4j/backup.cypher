UNWIND [{start: {_id:4944}, end: {_id:4947}, properties:{file_path:"unknown_source", keywords:"necessity,resolution", truncate:"", weight:1.0, description:"The shifts are framed as essential for addressing and resolving economic unrest.", created_at:1779420160, source_id:"chunk-38046723cd74f27b125edb0953caff31"}}, {start: {_id:4940}, end: {_id:4949}, properties:{file_path:"unknown_source<SEP>YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"family analogy,perception", truncate:"", weight:2.0, description:"The household leader perceives the home as a familial unit requiring conscious stewardship.<SEP>Conscious household leader conceptualizes home as a microcosm of family dynamics.", created_at:1779420522, source_id:"chunk-38046723cd74f27b125edb0953caff31<SEP>chunk-7abf3d6ec3bef4fcb00fff43b8f7e2bf"}}, {start: {_id:4943}, end: {_id:4948}, properties:{file_path:"unknown_source<SEP>YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"family analogy,perception", truncate:"", weight:2.0, description:"The political leader interprets the country as a family, advocating inclusive policies.<SEP>Conscious political leader frames governance as familial responsibility toward societal welfare.", created_at:1779420521, source_id:"chunk-38046723cd74f27b125edb0953caff31<SEP>chunk-7abf3d6ec3bef4fcb00fff43b8f7e2bf"}}, {start: {_id:4942}, end: {_id:1777}, properties:{file_path:"unknown_source", keywords:"holistic approach,necessity", truncate:"", weight:1.0, description:"Wealth creation must align with familial and societal well-being for sustainability.", created_at:1779420160, source_id:"chunk-38046723cd74f27b125edb0953caff31"}}, {start: {_id:4944}, end: {_id:4945}, properties:{file_path:"unknown_source", keywords:"necessity,prerequisite", truncate:"", weight:1.0, description:"Three fundamental shifts in wealth creators and leaders are necessary to address and resolve economic unrest.", created_at:1779420160, source_id:"chunk-38046723cd74f27b125edb0953caff31"}}, {start: {_id:2549}, end: {_id:4938}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"economic stability,elimination", weight:1.0, description:"Inclusive thinking ends exploitation, contributing to economic stability.", created_at:1779420231, source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4"}}, {start: {_id:4942}, end: {_id:4951}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"necessity,well-being", truncate:"", weight:1.0, description:"Conscious wealth creation is necessary for sustained family and societal well-being.", created_at:1779420231, source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4"}}, {start: {_id:4952}, end: {_id:1937}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"cooperation,paradigm shift", weight:1.0, description:"Wealth creators must shift from comparison to cooperation-driven approaches.", created_at:1779420231, source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4"}}, {start: {_id:4943}, end: {_id:4959}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"family,inclusive governance,perception", weight:2.0, description:"Political leaders perceive country as family, emphasizing inclusive policies.<SEP>The political leader perceives country as family, connecting national identity to family.", created_at:1779420845, source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-c639141ec491d448e8e3d57ed9e03d3d"}}, {start: {_id:4953}, end: {_id:1937}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"paradigm shift,purpose", truncate:"", weight:1.0, description:"Leaders must shift from pleasure to purpose-driven motivations.", created_at:1779420232, source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4"}}, {start: {_id:2578}, end: {_id:4938}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"elimination,systemic change", weight:1.0, description:"Inclusive thinking in wealth creators and leaders is presented as a solution to end economic unrest through paradigm shifts.", created_at:1779420232, source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4"}}, {start: {_id:4940}, end: {_id:741}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"family,family unity,perception", truncate:"", weight:2.0, description:"Household leaders perceive home as family, fostering domestic unity.<SEP>The leader perceives home as family, indicating a conceptual link between the household and family.", created_at:1779420845, source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-c639141ec491d448e8e3d57ed9e03d3d"}}, {start: {_id:4956}, end: {_id:1937}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"oneness,paradigm shift", truncate:"", weight:1.0, description:"Shift from separation to oneness-driven paradigms for global unity.", created_at:1779420232, source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4"}}, {start: {_id:4941}, end: {_id:254}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"family,family unity,perception", truncate:"", weight:2.0, description:"Business leaders perceive organization as family, promoting cooperative leadership.<SEP>The business leader perceives organization as family, linking business structures to family concepts.", created_at:1779420845, source_id:"chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-c639141ec491d448e8e3d57ed9e03d3d"}}, {start: {_id:4950}, end: {_id:4961}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"presentation,speaker", truncate:"", weight:1.0, description:"Dr. Joe Dispenza is the speaker in the YouTube video QAnRefsK-3Y.", created_at:1779420282, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:4962}, end: {_id:4963}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"related concepts,spiritual progression", weight:1.0, description:"The video links awakening experiences to enlightenment experiences as part of spiritual growth.", created_at:1779420282, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:4960}, end: {_id:4961}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"discussion topic,philosophical concept", weight:1.0, description:"The video discusses the paradigm shift from pleasure-driven to purpose-driven and from separation-driven to oneness-driven.", created_at:1779420282, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:4961}, end: {_id:4956}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"contrasting concept,spiritual state", weight:1.0, description:"The video contrasts separation-driven with oneness-driven as a state of disconnection.", created_at:1779420282, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:4958}, end: {_id:4961}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"contrasting concept,spiritual state", weight:1.0, description:"The video contrasts oneness-driven with separation-driven as a state of unity.", created_at:1779420282, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:4961}, end: {_id:4964}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"origin,spiritual concept", truncate:"", weight:1.0, description:"Zero point is mentioned as the origin from which humanity descended.", created_at:1779420282, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}] AS row
