UNWIND [{start: {_id:1238}, end: {_id:7188}, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", keywords:"connection,presence", truncate:"", weight:1.0, description:"The spirit of Earth is present in the butterfly, showing its presence in transformation.", created_at:1779659842, source_id:"chunk-831e414d3c516304d3109f8ff76d5f01"}}, {start: {_id:7188}, end: {_id:6962}, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", keywords:"connection,presence", truncate:"", weight:1.0, description:"The spirit of Earth is present in the wind, linking it to the air element.", created_at:1779659842, source_id:"chunk-831e414d3c516304d3109f8ff76d5f01"}}, {start: {_id:7187}, end: {_id:7188}, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", keywords:"connection,presence", truncate:"", weight:1.0, description:"The spirit of Earth is present in the colors of changing seasons, indicating its presence in seasonal changes.", created_at:1779659842, source_id:"chunk-831e414d3c516304d3109f8ff76d5f01"}}, {start: {_id:7185}, end: {_id:7174}, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", truncate:"", keywords:"conceptual relationship,philosophical hierarchy", weight:1.0, description:"The text establishes a relationship between celebrating life and the entity responsible for giving life.", created_at:1779659845, source_id:"chunk-456304668c2993662550f7a84adc904b"}}, {start: {_id:7175}, end: {_id:348}, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", truncate:"", keywords:"content hosting,media identification", weight:1.0, description:"YouTube Video hosts the content associated with the identifier Mr1cjAz2y9I.", created_at:1779659845, source_id:"chunk-456304668c2993662550f7a84adc904b"}}, {start: {_id:7186}, end: {_id:3953}, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", truncate:"", keywords:"correction process,error identification", weight:1.0, description:"Misheard Words are addressed through linguistic correction to produce the corrected text.", created_at:1779659845, source_id:"chunk-456304668c2993662550f7a84adc904b"}}, {start: {_id:1791}, end: {_id:7186}, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", truncate:"", keywords:"process outcome,text revision", weight:1.0, description:"Linguistic Correction leads to the creation of the corrected text.", created_at:1779659846, source_id:"chunk-456304668c2993662550f7a84adc904b"}}, {start: {_id:7189}, end: {_id:3350}, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", keywords:"representation,symbolism", truncate:"", weight:1.0, description:"The groups are metaphorically associated with colors, likening them to flowers from trees.", created_at:1779659889, source_id:"chunk-a28c71d3080d41b1e18683441ac8c1c6"}}, {start: {_id:7173}, end: {_id:3360}, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", keywords:"metaphor,symbolism", truncate:"", weight:1.0, description:"Dhara?s waters are metaphorically equated to blood and tears, emphasizing life and emotion.", created_at:1779659889, source_id:"chunk-a28c71d3080d41b1e18683441ac8c1c6"}}, {start: {_id:7173}, end: {_id:3362}, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", keywords:"metaphor,symbolism", truncate:"", weight:1.0, description:"Dhara?s soil is linked to flesh and bones, symbolizing physical and bodily unity with the Earth.", created_at:1779659889, source_id:"chunk-a28c71d3080d41b1e18683441ac8c1c6"}}, {start: {_id:7173}, end: {_id:3384}, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", keywords:"metaphor,symbolism", truncate:"", weight:1.0, description:"Fruit and grains are described as radiant skin, representing sustenance and beauty from the Earth.", created_at:1779659889, source_id:"chunk-a28c71d3080d41b1e18683441ac8c1c6"}}, {start: {_id:7173}, end: {_id:2533}, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", keywords:"interconnectedness,philosophy", truncate:"", weight:1.0, description:"The text emphasizes unity with the Earth through Dhara, framing all existence as interconnected.", created_at:1779659890, source_id:"chunk-a28c71d3080d41b1e18683441ac8c1c6"}}, {start: {_id:3736}, end: {_id:2343}, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", keywords:"application,no changes", truncate:"", weight:1.0, description:"The correction process was applied to the input text, but it found no errors, resulting in the same text.", created_at:1779659920, source_id:"chunk-25c321e128bae2ec1d82719bef8c6996"}}, {start: {_id:2343}, end: {_id:7195}, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", keywords:"compliance,identical", truncate:"", weight:1.0, description:"The input text and output text are identical, indicating full compliance with the correction rules.", created_at:1779659920, source_id:"chunk-25c321e128bae2ec1d82719bef8c6996"}}, {start: {_id:3736}, end: {_id:4474}, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", keywords:"execution,guidelines", truncate:"", weight:1.0, description:"The correction rules provide guidelines for the execution of the correction process.", created_at:1779659920, source_id:"chunk-25c321e128bae2ec1d82719bef8c6996"}}, {start: {_id:7194}, end: {_id:4963}, properties:{file_path:"unknown_source", keywords:"self-realization,societal impact", truncate:"", weight:1.0, description:"Enlightenment transforms individuals into awakened societal roles (e.g., leaders, teachers) through non-dual consciousness.", created_at:1779659940, source_id:"chunk-888705ac7721cd21ad67f22ea71eac64"}}, {start: {_id:3971}, end: {_id:7193}, properties:{file_path:"unknown_source<SEP>YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", keywords:"activation,compassion,emotional shift,neural activation,self-transcendence,spiritual effect", truncate:"", weight:3.0, created_at:1779661753, description:"Transformation experience activates heart neurons, enabling transcendence of self-centricity and fostering love/compassion.<SEP>Transformation Experience activates neurons in the heart.<SEP>Transformational experiences activate heart neurons, enabling transcendence of self-centricity.` - OK", source_id:"chunk-888705ac7721cd21ad67f22ea71eac64<SEP>chunk-355c42e8aaaf893df441489ff3a44b86<SEP>chunk-9f245e3153d92a2c38134afd812338bf"}}, {start: {_id:1490}, end: {_id:7190}, properties:{file_path:"unknown_source<SEP>YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"consciousness expansion,potential for greatness,spiritual journey", weight:2.0, description:"Transcendental experiences reveal dimensions beyond the mind, enabling human consciousness to transcend mediocrity.` - Looks correct.<SEP>Transcendental experiences reveal a dimension beyond the mind, unlocking the potential of human consciousness.`", created_at:1779661732, source_id:"chunk-888705ac7721cd21ad67f22ea71eac64<SEP>chunk-71c647fd13898f185a71091bf9fbd510"}}, {start: {_id:982}, end: {_id:5972}, properties:{file_path:"unknown_source<SEP>YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"activation,biological activation,divine discovery,mind-body connection,neurological activation,physiological effect,spiritual process", weight:4.0, description:"Mystical experience activates the pineal gland, revealing sacred dimensions and converting seekers to faith-driven behavior.<SEP>Mystical experiences activate the pineal gland, enabling access to a sacred dimension.<SEP>A mystical experience involves the activation of the pineal gland, connecting the mind and body.`<SEP>Mystical experiences involve activation of the pineal gland located in the middle of the eyebrows.", created_at:1779661799, source_id:"chunk-888705ac7721cd21ad67f22ea71eac64<SEP>chunk-2fad0fbe65ec4abc3eb5db49059e7a50<SEP>chunk-71c647fd13898f185a71091bf9fbd510<SEP>chunk-84fe7edeb817f0143052c09f97b672fc"}}, {start: {_id:1490}, end: {_id:982}, properties:{file_path:"unknown_source", truncate:"", keywords:"consciousness shift,divine connection", weight:1.0, description:"Mystical experience shifts human consciousness from belief/atheism to divine discovery.", created_at:1779659940, source_id:"chunk-888705ac7721cd21ad67f22ea71eac64"}}] AS row
