UNWIND [{start: {_id:1490}, end: {_id:7193}, properties:{file_path:"unknown_source", keywords:"compassion,self-transcendence", truncate:"", weight:1.0, description:"Transformation experience elevates consciousness to cause-oriented compassion and love.", created_at:1779659940, source_id:"chunk-888705ac7721cd21ad67f22ea71eac64"}}, {start: {_id:4963}, end: {_id:1490}, properties:{file_path:"unknown_source", keywords:"non-duality,oneness", truncate:"", weight:1.0, description:"Enlightenment experience dissolves the limited self, revealing oneness and non-dual consciousness.", created_at:1779659941, source_id:"chunk-888705ac7721cd21ad67f22ea71eac64"}}, {start: {_id:1620}, end: {_id:7196}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"correction task,source material", weight:2.0, description:"YouTube video provides text input for the Text Correction Expert's error-fixing work.<SEP>YouTube video provides text input for the Text Correction Expert's error-fixing work.", created_at:1779661444, source_id:"chunk-cffb9eac72e7a5a6fe069d5ec4bb333b"}}, {start: {_id:1490}, end: {_id:4464}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"consciousness expansion,philosophical perspective", weight:1.0, description:"Prieta G discusses human consciousness as capable of transformative experiences that transcend mediocrity and lead to higher states.", created_at:1779661449, source_id:"chunk-7762957fcc0ae7195e6993c4e83cbc1f"}}, {start: {_id:1401}, end: {_id:4464}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"contrast,philosophical critique", weight:1.0, description:"Prieta G discusses the journey beyond mediocrity, emphasizing that living with a complaining or anxious mind is mediocre and contrasts it with the potential of human consciousness.", created_a