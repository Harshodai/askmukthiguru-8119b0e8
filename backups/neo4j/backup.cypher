UNWIND [{_id:1408, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"UNKNOWN", truncate:"", description:"The \"Nobody State\" leads to pursuing wealth through fear rather than joy.", created_at:1779144386, source_id:"chunk-a3883befbc3677e763ade9f571892747", entity_id:"Wealth Pursuit"}}, {_id:1409, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"UNKNOWN", truncate:"", description:"The journey metaphorically addresses navigating wealth pursuit and avoiding self-obsession/mediocrity.", created_at:1779144386, source_id:"chunk-a3883befbc3677e763ade9f571892747", entity_id:"Wealth and Mediocrity"}}, {_id:1410, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"organization", truncate:"", created_at:1779187754, description:"Animal Care Company is a business specializing in animal care services, founded by the man.<SEP>Animal Care Company is a business established by the man, central to the story's narrative.<SEP>The company is an animal care business founded by the man.", source_id:"chunk-935058526f2844e4cf8a154aae8963aa<SEP>chunk-8e03152ba26c428e5446f721ab8114a4<SEP>chunk-d67f1ccb0ba7106556d6b51966372abe", entity_id:"Animal Care Company"}}, {_id:1411, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Fear of Failure is an emotional barrier linked to the man's disconnection from his employees.", created_at:1779144450, source_id:"chunk-935058526f2844e4cf8a154aae8963aa", entity_id:"Fear of Failure"}}, {_id:1412, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)<SEP>YouTube Video: pPHQMD3w9-s (URL: https://www.youtube.com/watch?v=pPHQMD3w9-s)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)<SEP>unknown_source", entity_type:"method", truncate:"", description:"The text includes several grammatical corrections, such as changing \"not being capable\" to \"not capable\" and \"life\" to \"lives\".<SEP>Concept involving fixing comma errors in the sentence \"We are falling sick, our friends or relatives, the people we know, are falling sick.\"<SEP>The process of identifying and fixing errors in sentences, such as run-on sentences, fragments, and vague terms, to improve clarity and grammatical correctness.<SEP>The correction involves changing a preposition to fix the error.<SEP>The correction involves changing a preposition to fix the error.", created_at:1779737165, source_id:"chunk-436cdd40c65f094c48fcf797f8be28ab<SEP>chunk-5ad87d01b925f7db7d300ff617025fd6<SEP>chunk-e00176cad030937cceed8d9e04c9350c<SEP>chunk-aa435522f2e8968c2579690697fe5849<SEP>chunk-95bb20fa08d8c179f5fbb773fd59108f", entity_id:"Grammatical Correction"}}, {_id:1413, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: Gdd-5uWUW5w (URL: https://www.youtube.com/watch?v=Gdd-5uWUW5w)", entity_type:"concept", truncate:"", created_at:1779655094, description:"Future Generations refers to upcoming generations whose fate is tied to conscious evolution and preservation of life on Earth.<SEP>Future Generations are impacted by collective actions and the cultivation of connected states.<SEP>Future generations are mentioned as beneficiaries of positive change.<SEP>Future generations are mentioned as beneficiaries of positive change.<SEP>Future generations are affected by the hate and Samskaras passed down from previous generations, continuing conflicts.<SEP>Future generations are mentioned as being affected by the passing of Samskaras from previous generations.", source_id:"chunk-935058526f2844e4cf8a154aae8963aa<SEP>chunk-b4387a01e271d1d16068a0288faa84e5<SEP>chunk-b628c030400a26f95b386175dbe5ab57<SEP>chunk-cd538a6e8a311df1e5a60102db1f1b82<SEP>chunk-ce9ebce1893fdadbc7506d753964c3f9<SEP>chunk-d3f41a9eb02b7a6a41e590b4f8a66d6e", entity_id:"Future Generations"}}, {_id:1414, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Work environment refers to the atmosphere within the animal care company, transformed by the man's spiritual reflection.", created_at:1779144475, source_id:"chunk-8e03152ba26c428e5446f721ab8114a4", entity_id:"Work Environment"}}, {_id:1415, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"concept", truncate:"", description:"Spiritual reflection is the process through which the man gained insight into his impact on employees.<SEP>Spiritual reflection is a process the man uses to realize the impact of his actions.", created_at:1779187754, source_id:"chunk-8e03152ba26c428e5446f721ab8114a4<SEP>chunk-d67f1ccb0ba7106556d6b51966372abe", entity_id:"Spiritual Reflection"}}, {_id:1416, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Grand Vision represents the holistic approach to life, combining consciousness and prosperity.", created_at:1779144475, source_id:"chunk-8e03152ba26c428e5446f721ab8114a4", entity_id:"Grand Vision"}}, {_id:1417, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)<SEP>YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", entity_type:"concept", truncate:"", description:"Prosperity is one of the key elements of the grand vision, linked to material and emotional well-being.<SEP>Prosperity is tied to a specific state of awakened consciousness for endurance and flow.<SEP>Prosperity is mentioned as a result of wealth creation processes in the text.<SEP>Prosperity is described as a transcendental concept linked to wealth manifestation in physical form.", created_at:1779433322, source_id:"chunk-8e03152ba26c428e5446f721ab8114a4<SEP>chunk-7f167e0e6ad11f51a72e88b506b459a9<SEP>chunk-83abb98046d1159250c7575ec257ce14<SEP>chunk-068119dd429404d7b660b1eacf50b8a7<SEP>chunk-d25900147d2885c1a704f8d6ecab098b", entity_id:"Prosperity"}}, {_id:1418, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"artifact", truncate:"", description:"Benz is a luxury car used metaphorically to represent material prosperity and balance.", created_at:1779144476, source_id:"chunk-8e03152ba26c428e5446f721ab8114a4", entity_id:"Benz"}}, {_id:1419, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"UNKNOWN", truncate:"", description:"The Grand Vision combines prosperity and love to create a beautiful life.", created_at:1779144500, source_id:"chunk-8e03152ba26c428e5446f721ab8114a4", entity_id:"Prosperity, Love"}}, {_id:1420, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"UNKNOWN", truncate:"", description:"The Grand Vision includes loved ones and the world, emphasizing balance.", created_at:1779144500, source_id:"chunk-8e03152ba26c428e5446f721ab8114a4", entity_id:"Loved Ones, World"}}, {_id:1421, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"organization", truncate:"", description:"Faculty members at the academy mentored by Preethaji.", created_at:1779144527, source_id:"chunk-37f26db11e149c4af43719c414b748ce", entity_id:"Faculty Members"}}, {_id:1422, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AviNwtN1luo)", entity_type:"concept", truncate:"", created_at:1779666070, description:"Amazing teams supporting Preethaji's operations.<SEP>Collaborative groups formed through heightened creative and innovative capacities.<SEP>Collaborative groups formed through heightened creative and innovative capacities.<SEP>Teams are groups intended to take on The Mystic Secrets as part of their collective spiritual and professional development.", source_id:"chunk-37f26db11e149c4af43719c414b748ce<SEP>chunk-87c7719422a9d8333cc199f60bc9b163<SEP>chunk-20b522ad915c05aa0d61fb0dbb9917a4", entity_id:"Teams"}}, {_id:1423, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"concept", truncate:"", description:"Trustworthy business partners supporting Preethaji's businesses.<SEP>Collaborative decisions affected by indecision.", created_at:1779184194, source_id:"chunk-37f26db11e149c4af43719c414b748ce<SEP>chunk-035b6c44730bb7cdf05bfef04ef27b03<SEP>chunk-50804a0cd2fabf8122814121f088fb8d", entity_id:"Business Partners"}}, {_id:1424, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"organization", truncate:"", description:"CEOs of businesses supported by Preethaji.", created_at:1779144528, source_id:"chunk-37f26db11e149c4af43719c414b748ce", entity_id:"CEOs"}}, {_id:1425, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Philosophy and meditation are core disciplines taught at O&O Academy to facilitate internal and external life transformation.", created_at:1779144591, source_id:"chunk-2da89c2811049fcf9342c94e7de23b62", entity_id:"Philosophy and Meditation"}}, {_id:1426, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Transforming human consciousness is the primary mission of O&O Academy, achieved through specialized curricula and faculty expertise.", created_at:1779144591, source_id:"chunk-2da89c2811049fcf9342c94e7de23b62", entity_id:"Transforming Human Consciousness"}}, {_id:1427, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"content", truncate:"", description:"A curriculum spanning several levels of learning designed to transform students' consciousness through structured programs.<SEP>The curriculum taught at the academy is designed to facilitate personal transformation and destiny creation.", created_at:1779144680, source_id:"chunk-2da89c2811049fcf9342c94e7de23b62<SEP>chunk-35a211b7f3bf5a88de37f2e6c5d66a39", entity_id:"Curriculum"}}] AS row
