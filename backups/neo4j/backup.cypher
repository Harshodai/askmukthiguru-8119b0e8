UNWIND [{start: {_id:3470}, end: {_id:4203}, properties:{file_path:"unknown_source", keywords:"divine aspects,spiritual progression", truncate:"", weight:1.0, description:"The fourth to sixth days of Navratri are dedicated to the Mother Goddess as Mahalakshmi, symbolizing the transition from spiritual dissolution to abundance.`", created_at:1779519117, source_id:"chunk-672a64891a721958057240b2cc83a897"}}, {start: {_id:4201}, end: {_id:5550}, properties:{file_path:"unknown_source", truncate:"", keywords:"consciousness,spiritual transformation", weight:1.0, description:"Navratri's rituals symbolize the dissolution of tamas (darkness) through meditative awareness and spiritual awakening.`", created_at:1779519117, source_id:"chunk-672a64891a721958057240b2cc83a897"}}, {start: {_id:5348}, end: {_id:5560}, properties:{file_path:"unknown_source", keywords:"health crisis,social impact", truncate:"", weight:1.0, description:"COVID-19 has exacerbated social alienation and weakened human connections through fear of disease transmission and reduced physical interaction.", created_at:1779519167, source_id:"chunk-13c9585183fe0f71b4560d16c5cd2726"}}, {start: {_id:5566}, end: {_id:5565}, properties:{file_path:"unknown_source", truncate:"", keywords:"public health policy,social inequality", weight:1.0, description:"Plague-era quarantines institutionalized racial segregation, with lasting effects on South African apartheid policies.", created_at:1779519167, source_id:"chunk-13c9585183fe0f71b4560d16c5cd2726"}}, {start: {_id:5567}, end: {_id:5564}, properties:{file_path:"unknown_source", keywords:"cultural adaptation,survival mindset", truncate:"", weight:1.0, description:"Parents delayed naming children until they survived smallpox, reflecting pandemic-driven societal shifts.", created_at:1779519168, source_id:"chunk-13c9585183fe0f71b4560d16c5cd2726"}}, {start: {_id:5568}, end: {_id:5562}, properties:{file_path:"unknown_source", keywords:"cultural change,historical impact", truncate:"", weight:1.0, description:"The Spanish Flu led to long-term changes in hygiene habits, such as reduced bathing frequency, persisting for centuries.", created_at:1779519168, source_id:"chunk-13c9585183fe0f71b4560d16c5cd2726"}}, {start: {_id:5560}, end: {_id:5561}, properties:{file_path:"unknown_source", truncate:"", keywords:"digital engagement,social fragmentation", weight:1.0, description:"Social media has replaced face-to-face interactions, deepening social alienation before and during the pandemic.", created_at:1779519168, source_id:"chunk-13c9585183fe0f71b4560d16c5cd2726"}}, {start: {_id:5348}, end: {_id:5561}, properties:{file_path:"unknown_source", truncate:"", keywords:"behavioral amplification,crisis context", weight:1.0, description:"COVID-19 intensified reliance on digital platforms, further eroding in-person relationships.", created_at:1779519168, source_id:"chunk-13c9585183fe0f71b4560d16c5cd2726"}}, {start: {_id:5545}, end: {_id:4901}, properties:{file_path:"YouTube Video: WfkCDNu4SuE (URL: https://www.youtube.com/watch?v=WfkCDNu4SuE)", keywords:"defeat,destruction", truncate:"", weight:1.0, description:"Durga defeats the demon Madhu, symbolizing the dissolution of anger and greed.", created_at:1779519180, source_id:"chunk-49d819fbab36af31ec15419ab94d1279"}}, {start: {_id:5559}, end: {_id:5555}, properties:{file_path:"YouTube Video: WfkCDNu4SuE (URL: https://www.youtube.com/watch?v=WfkCDNu4SuE)", truncate:"", keywords:"consequence,spiritual outcome", weight:1.0, description:"The first three days of Navratri are associated with the downward collapse of destinies if not transcended, leading to a disastrous fate.", created_at:1779519180, source_id:"chunk-49d819fbab36af31ec15419ab94d1279"}}, {start: {_id:5556}, end: {_id:3470}, properties:{file_path:"YouTube Video: WfkCDNu4SuE (URL: https://www.youtube.com/watch?v=WfkCDNu4SuE)", truncate:"", keywords:"deity association,prosperity focus", weight:1.0, description:"The fourth to sixth days of Navratri are associated with Goddess Mahalakshmi and the blessings of abundance.", created_at:1779519180, source_id:"chunk-49d819fbab36af31ec15419ab94d1279"}}, {start: {_id:5545}, end: {_id:4898}, properties:{file_path:"YouTube Video: WfkCDNu4SuE (URL: https://www.youtube.com/watch?v=WfkCDNu4SuE)", keywords:"defeat,destruction", truncate:"", weight:1.0, description:"Durga defeats the demon Kaitabha, symbolizing the dissolution of anger and greed.", created_at:1779519180, source_id:"chunk-49d819fbab36af31ec15419ab94d1279"}}, {start: {_id:89}, end: {_id:5545}, properties:{file_path:"YouTube Video: WfkCDNu4SuE (URL: https://www.youtube.com/watch?v=WfkCDNu4SuE)", keywords:"dissolution,transcendence", truncate:"", weight:1.0, description:"Durga's actions dissolve anger-related states like frustration, hate, and vengefulness.", created_at:1779519180, source_id:"chunk-49d819fbab36af31ec15419ab94d1279"}}, {start: {_id:5545}, end: {_id:5552}, properties:{file_path:"YouTube Video: WfkCDNu4SuE (URL: https://www.youtube.com/watch?v=WfkCDNu4SuE)", keywords:"dissolution,transcendence", truncate:"", weight:1.0, description:"Durga's actions dissolve greed-related states like jealousy, anxiety, and covetousness.", created_at:1779519181, source_id:"chunk-49d819fbab36af31ec15419ab94d1279"}}, {start: {_id:5545}, end: {_id:5555}, properties:{file_path:"YouTube Video: WfkCDNu4SuE (URL: https://www.youtube.com/watch?v=WfkCDNu4SuE)", truncate:"", keywords:"deity association,spiritual focus", weight:1.0, description:"The first three days of Navratri are associated with Goddess Durga and the dissolution of negative states.", created_at:1779519181, source_id:"chunk-49d819fbab36af31ec15419ab94d1279"}}, {start: {_id:5348}, end: {_id:3234}, properties:{file_path:"YouTube Video: d0v8RE6i0GM (URL: https://www.youtube.com/watch?v=d0v8RE6i0GM)", truncate:"", keywords:"alienation,impact", weight:1.0, description:"COVID-19 exacerbated pre-existing alienation in human relationships caused by digital dependency.", created_at:1779519184, source_id:"chunk-47ba35801c62795c3acbb6bf1357ab08"}}, {start: {_id:5348}, end: {_id:5571}, properties:{file_path:"YouTube Video: d0v8RE6i0GM (URL: https://www.youtube.com/watch?v=d0v8RE6i0GM)", truncate:"", keywords:"economic disruption,financial crisis", weight:1.0, description:"COVID-19 caused a global economic downturn and increased poverty.", created_at:1779519184, source_id:"chunk-47ba35801c62795c3acbb6bf1357ab08"}}, {start: {_id:3234}, end: {_id:5561}, properties:{file_path:"YouTube Video: d0v8RE6i0GM (URL: https://www.youtube.com/watch?v=d0v8RE6i0GM)", keywords:"alienation,dependency", truncate:"", weight:1.0, description:"Social media contributed to reduced real-world interactions and increased digital dependency.", created_at:1779519184, source_id:"chunk-47ba35801c62795c3acbb6bf1357ab08"}}, {start: {_id:5348}, end: {_id:5562}, properties:{file_path:"YouTube Video: d0v8RE6i0GM (URL: https://www.youtube.com/watch?v=d0v8RE6i0GM)", keywords:"comparison,lethality", truncate:"", weight:1.0, description:"COVID-19 is contrasted with the Spanish Flu in terms of mortality rates and societal impact.", created_at:1779519185, source_id:"chunk-47ba35801c62795c3acbb6bf1357ab08"}}, {start: {_id:3234}, end: {_id:5569}, properties:{file_path:"YouTube Video: d0v8RE6i0GM (URL: https://www.youtube.com/watch?v=d0v8RE6i0GM)", keywords:"alienation,dependency", truncate:"", weight:1.0, description:"Streaming platforms like Netflix and YouTube replaced in-person socialization.", created_at:1779519185, source_id:"chunk-47ba35801c62795c3acbb6bf1357ab08"}}] AS row
