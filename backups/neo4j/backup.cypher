UNWIND [{_id:2576, properties:{file_path:"unknown_source", entity_type:"event", truncate:"", description:"Peace meditation is an event mentioned as a purpose of the video and a guided session.", created_at:1779174144, source_id:"chunk-9d2a0ad692331733d51852934ce7b3f5", entity_id:"Peace Meditation"}}, {_id:2577, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", entity_type:"concept", truncate:"", created_at:1779236823, description:"Healing the world is mentioned as the purpose of the peace intention.<SEP>Healing the World refers to the collective healing of humanity through emotional intelligence and connection, as mentioned in the text.<SEP>Healing the world is a goal promoted through heart intelligence.", source_id:"chunk-9d2a0ad692331733d51852934ce7b3f5<SEP>chunk-6537d9939653cd5b7d036dced5f9de7b<SEP>chunk-d1d61cdae8bf4b3876281c2ab93a30b0", entity_id:"Healing the World"}}, {_id:2578, properties:{file_path:"unknown_source<SEP>YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", description:"Economic unrest is a concept addressed as a reason for peace meditation.<SEP>Economic unrest refers to instability caused by inequitable wealth distribution and exploitative practices.<SEP>Refers to the instability in economic systems addressed through paradigm shifts in wealth creators and leaders.<SEP>Economic Unrest is a problem that requires shifts in thinking and action.<SEP>A state of instability in economic systems, addressed through proposed shifts in leadership and societal values.", created_at:1779420717, source_id:"chunk-9d2a0ad692331733d51852934ce7b3f5<SEP>chunk-136e0828d80d107f75974ede595c760a<SEP>chunk-38046723cd74f27b125edb0953caff31<SEP>chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-4f108a1313b1da3a2fa234ff5f49d6e5<SEP>chunk-dcbde403840148f165365cfd6299b08f", entity_id:"Economic Unrest"}}, {_id:2579, properties:{file_path:"unknown_so