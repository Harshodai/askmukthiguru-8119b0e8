UNWIND [{start: {_id:1516}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"discusses,source material", truncate:"", weight:1.0, description:"The document discusses peacemaking and its role in conflict resolution.", created_at:1779145253, source_id:"chunk-6333458ab425b6d36a113393a04c6884"}}, {start: {_id:196}, end: {_id:1526}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"amplification,collective impact,consciousness connection,influence", truncate:"", weight:2.0, description:"Individual consciousness influences collective consciousness, affecting societal outcomes like war or peace.<SEP>Individual thoughts amplify into collective outcomes like war or harmony.", created_at:1779188102, source_id:"chunk-6333458ab425b6d36a113393a04c6884<SEP>chunk-caff4fa153aca65c602a6ac671b90d21"}}, {start: {_id:1524}, end: {_id:755}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"contrasts with,inherent nature", truncate:"", weight:1.0, description:"Peace is presented as a natural state of being, not a cultivated virtue.", created_at:1779145253, source_id:"chunk-6333458ab425b6d36a113393a04c6884"}}, {start: {_id:1530}, end: {_id:1529}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"global engagement,participation", truncate:"", weight:1.0, description:"Peacemakers join online or in-person to engage in collective meditation.", created_at:1779145278, source_id:"chunk-4e6b8198f0f9d175c647ec3cce9d4ad7"}}, {start: {_id:1527}, end: {_id:831}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"annual event,temporal timing", truncate:"", weight:1.0, description:"The festival occurs annually in August.", created_at:1779145278, source_id:"chunk-4e6b8198f0f9d175c647ec3cce9d4ad7"}}, {start: {_id:831}, end: {_id:1534}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"peace activism,philosophical foundation", weight:1.0, description:"The festival is rooted in a movement toward conscious transformation for peace, not traditional activism.", created_at:1779145278, source_id:"chunk-4e6b8198f0f9d175c647ec3cce9d4ad7"}}, {start: {_id:1530}, end: {_id:1528}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"social harmony,theme", truncate:"", weight:1.0, description:"The meditation addresses religious tolerance as a component of peace.", created_at:1779145278, source_id:"chunk-4e6b8198f0f9d175c647ec3cce9d4ad7"}}, {start: {_id:1508}, end: {_id:1536}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"enlightenment framework,spiritual experience", weight:1.0, description:"The festival is designed to guide participants through experiencing the five classical enlightened states of consciousness.", created_at:1779145312, source_id:"chunk-aa6df70374eb253c7ca1bd643516678c"}}, {start: {_id:1508}, end: {_id:1538}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"creators,designers", truncate:"", weight:1.0, description:"Preethaji and the author co-designed the festival to enable participants to experience enlightened states.", created_at:1779145312, source_id:"chunk-aa6df70374eb253c7ca1bd643516678c"}}, {start: {_id:1541}, end: {_id:1539}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"access,promotional offer", truncate:"", weight:1.0, description:"Breathing Room offers meditations from The Four Sacred Secrets using the code \"soul sync.\"", created_at:1779145384, source_id:"chunk-64534fa37e2772d16d26e6098d4409b0"}}, {start: {_id:1540}, end: {_id:4}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"acknowledgment,contribution", truncate:"", weight:1.0, description:"Sarah Rainone is acknowledged for her role in crafting the book's content.", created_at:1779145384, source_id:"chunk-64534fa37e2772d16d26e6098d4409b0"}}, {start: {_id:1544}, end: {_id:864}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"curriculum design,teaching methods", truncate:""