UNWIND [{_id:1101, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"UNKNOWN", truncate:"", description:"Past pain causes heartbreak cycles by undermining trust and vulnerability.", created_at:1779141920, source_id:"chunk-326ece98f6d256a814a626f5e89cbf94", entity_id:"Past Pain"}}, {_id:1102, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", created_at:1779661692, description:"The document discusses the concept of security.<SEP>Security is the state of being free from danger or threat.<SEP>Security is the state of being free from danger or threat.<SEP>Security is a concept that oscillates with insecurity.`", source_id:"chunk-0abffe0fa33b9e8c05e4d3ce9e08d67e<SEP>chunk-7796e9953e60bd3bb11c46251f992983<SEP>chunk-71c647fd13898f185a71091bf9fbd510", entity_id:"Security"}}, {_id:1103, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Material comfort", created_at:1779141974, source_id:"chunk-af38aa53fa5d28b5d2a8db0db8864a46", entity_id:"Material Comforts"}}, {_id:1104, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"organization", truncate:"", description:"The Two Foundations section contrasts relationships built on spiritual vision with those based on fragile external factors like wealth or appearance, highlighting the risks of separation and division.<SEP>An organization or program addressing relationship challenges and spiritual vision.", created_at:1779186111, source_id:"chunk-dfd063e448fde077331ddbd4cc16008f<SEP>chunk-3e351e3f449821330f87c8b4e26de0d2", entity_id:"The Two Foundations"}}, {_id:1105, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Marriages and friendships are cited as relationships strengthened by spiritual vision, which heals emotional rifts and fosters cooperation.", created_at:1779142030, source_id:"chunk-dfd063e448fde077331ddbd4cc16008f", entity_id:"Marriages and Friendships"}}, {_id:1106, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"naturalobject", truncate:"", description:"A pile of bones discovered in the forest by the four friends, which they attempt to reconstruct into a skeleton.", created_at:1779142089, source_id:"chunk-6e9975c29b6eeab07aa117c06143418a", entity_id:"Heap of Bones"}}, {_id:1107, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"person", truncate:"", description:"The four friends encounter the heap of bones in the forest, prompting their experiments.<SEP>Four unnamed friends in an ancient Indian fable who demonstrate the consequences of ignoring warnings and indulging in hurt.`", created_at:1779186988, source_id:"chunk-6e9975c29b6eeab07aa117c06143418a<SEP>chunk-b19b2a822951a545ded34a82295b89dc", entity_id:"Four Friends"}}, {_id:1108, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0k5f8G9uXqY)", entity_type:"concept", truncate:"", created_at:1779157899, description:"Aversion is the third stage of disconnection, characterized by mutual irritation and emotional pain in the presence of a partner.<SEP>Aversion is a concept related to avoidance or dislike mentioned in the text.<SEP>Aversion refers to a negative emotional or mental resistance, discussed alongside anger as a shared experience.", source_id:"chunk-3b8dde7779e0c2342011917f0bce24aa<SEP>chunk-b0b6f9f02020768407fee531e6074a4d<SEP>chunk-ba6b7dbad29f123e1a2c91144bb54a85", entity_id:"Aversion"}}, {_id:1109, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"An ancient fable used to illustrate how small hurts escalate into destructive inner states, affecting relationships through stages of disconnection.", created_at:1779142132, source_id:"chunk-3b8dde7779e0c2342011917f0bce24aa", entity_id:"Ancient Fable"}}, {_id:1110, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Initial hurt refers to the first stage of disconnection where minor irritations begin to affect a relationship.", created_at:1779142132, source_id:"chunk-3b8dde7779e0c2342011917f0bce24aa", entity_id:"Initial Hurt"}}, {_id:1111, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Harmful obsessions arise when unresolved hurtful feelings escalate into destructive fixations, damaging self-respect and connection.", created_at:1779142132, source_id:"chunk-3b8dde7779e0c2342011917f0bce24aa", entity_id:"Harmful Obsessions"}}, {_id:1112, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Hypothetical romantic vacation setting where loneliness persists despite the idealized environment, highlighting emotional disconnection.", created_at:1779142173, source_id:"chunk-8aad6ef1fd3889e4b8c9933c17173354", entity_id:"Romantic Vacation"}}, {_id:1113, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"The third stage of disconnection is characterized by aversion, where the presence of a partner becomes irritating and painful, leading to distorted negative perceptions and loss of respect.", created_at:1779142173, source_id:"chunk-8aad6ef1fd3889e4b8c9933c17173354", entity_id:"Third Stage of Disconnection: Aversion"}}, {_id:1114, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Partner's actions and behaviors become unbearable during the third stage of disconnection, leading to irritation and pain.", created_at:1779142173, source_id:"chunk-8aad6ef1fd3889e4b8c9933c17173354", entity_id:"Partner's Actions/Behaviors"}}, {_id:1115, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"UNKNOWN", truncate:"", description:"The third stage is defined by aversion, where negative perceptions of a partner intensify, leading to pain and loss of respect.", created_at:1779142194, source_id:"chunk-8aad6ef1fd3889e4b8c9933c17173354", entity_id:"aversion"}}, {_id:1116, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"naturalobject", truncate:"", description:"Hollow of a tree is a natural object where desserts are placed to trap monkeys.", created_at:1779142221, source_id:"chunk-b0b6f9f02020768407fee531e6074a4d", entity_id:"Hollow of a tree"}}, {_id:1117, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"method", truncate:"", description:"Method is a smart technique used by villagers to catch monkeys by placing desserts in a tree hollow.", created_at:1779142221, source_id:"chunk-b0b6f9f02020768407fee531e6074a4d", entity_id:"Method"}}, {_id:1118, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=KTe11DlB4QI)", entity_type:"person", truncate:"", description:"Sri Bhagawan is identified as a person referenced in philosophical teachings, previously categorized incorrectly as \"Other\".<SEP>Sri Bhagawan is a spiritual figure referenced in the context of a country's genius and destiny.", created_at:1779214387, source_id:"chunk-ebde78f6be0d6b08e313feb85264c28a<SEP>chunk-f830d9b272fb6dc4d8ef5074127fb8c0", entity_id:"Sri Bhagawan"}}, {_id:1119, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=KTe11DlB4QI)", entity_type:"concept", truncate:"", description:"Indian dance is categorized as a cultural concept rather than an artifact, with enlightenment as its central theme.", created_at:1779213961, source_id:"chunk-ebde78f6be0d6b08e313feb85264c28a", entity_id:"Indian dance"}}, {_id:1120, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=O1VkNuEChD4)", entity_type:"concept", truncate:"", description:"A monkey attempts to retrieve a dessert from a tree hollow but becomes trapped, leading to relocation by monkey catchers.<SEP>The monkey is part of a parable in the discourse, symbolizing clinging to anger.<SEP>The monkey is a mischievous creature that gets trapped in a tree hole while attempting to steal desserts, leading to its capture.<SEP>A metaphor used to illustrate the lack of freedom when holding onto anger, similar to a monkey clinging to dessert.<SEP>A metaphor for clinging to anger, symbolizing lack of freedom and self-awareness.<SEP>A metaphor for clinging to anger, symbolizing lack of freedom and self-awareness.", created_at:1779557376, source_id:"chunk-2be9c30d5eb8cae8ce6cd1e6425921bc<SEP>chunk-61865db1533922fc67b59d104261e28a<SEP>chunk-7bf65c644663a49c4d568dfba9827fc5<SEP>chunk-339fa6ee789d0451cedd5e2548222d96<SEP>chunk-f11387cad436a638d2f57c99446730e6", entity_id:"Monkey"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:1121, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"artifact", truncate:"", description:"The vehicle transporting the couple from the airport to the campus, site of their argument.", created_at:1779142251, source_id:"chunk-2be9c30d5eb8cae8ce6cd1e6425921bc", entity_id:"Taxi"}}, {_id:1122, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"naturalobject", truncate:"", description:"An aromatic and juicy dessert in a tree hollow that the monkey becomes attached to.", created_at:1779142251, source_id:"chunk-2be9c30d5eb8cae8ce6cd1e6425921bc", entity_id:"Dessert"}}, {_id:1123, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"event", truncate:"", description:"A narrative about a couple?s conflict and reconciliation during their journey to O&O Academy.", created_at:1779142252, source_id:"chunk-2be9c30d5eb8cae8ce6cd1e6425921bc", entity_id:"Story of the Couple"}}, {_id:1124, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Emotional pain caused by feeling neglected in the relationship.", created_at:1779142252, source_id:"chunk-2be9c30d5eb8cae8ce6cd1e6425921bc", entity_id:"Doriss Hurt"}}, {_id:1125, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"location", truncate:"", description:"The starting point of the couple?s journey to O&O Academy.", created_at:1779142252, source_id:"chunk-2be9c30d5eb8cae8ce6cd1e6425921bc", entity_id:"Airport"}}, {_id:1126, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=KTe11DlB4QI)<SEP>YouTube Video: LYm7oczfWEk (URL: https://www.youtube.com/watch?v=LYm7oczfWEk)<SEP>unknown_source<SEP>YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", entity_type:"concept", truncate:"", created_at:1779519948, description:"enlightenment refers to a state of spiritual awareness or total cessation of ignorance, central to the discussion.<SEP>enlightenment is the lowercase version of the concept, as used in the proposed correction.<SEP>A spiritual state achieved through perfecting the body and energy channels.><SEP>enlightenment refers to a state of awakened consciousness beyond ordinary human perception, enabling profound transformation and freedom from mental limitations.<SEP>Enlightenment represents a state of liberation and peace, synonymous with Mukti, emphasizing harmony and collective tranquility.", source_id:"chunk-ebde78f6be0d6b08e313feb85264c28a<SEP>chunk-c237c67faa181266b2d01c5cc57665f5<SEP>chunk-98b25b308c4bb7434621f489a95e2f07<SEP>chunk-3fe7a56df750b7915fb511efbfa521f5<SEP>chunk-3262d5415ded94fc1fc56ae56e675a4b", entity_id:"enlightenment"}}, {_id:1127, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"event", truncate:"", description:"The couple?s journey in a taxi from the airport, marked by conflict.", created_at:1779142252, source_id:"chunk-2be9c30d5eb8cae8ce6cd1e6425921bc", entity_id:"Taxi Ride"}}, {_id:1128, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Advice to the couple to continue their journey and reconcile.", created_at:1779142252, source_id:"chunk-2be9c30d5eb8cae8ce6cd1e6425921bc", entity_id:"Faculty Members Suggestion"}}, {_id:1129, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=KTe11DlB4QI)", entity_type:"artifact", truncate:"", created_at:1779214387, description:"Natya Shastra is an ancient Indian text on classical dance, cited as a reference for artistic direction.<SEP>Natya Shastra is a 2000-year-old classical Indian dance form and theoretical text referenced in the discussion.<SEP>Natya Shastra is an ancient Indian text on performing arts and classical dance.<SEP>Natya Shastra is an ancient Indian text on performing arts, serving as the foundational source for the dance form \"e form.\"<SEP>Natya Shastra is a classical text on performing arts used to explain the direction of art forms towards enlightenment.", source_id:"chunk-ebde78f6be0d6b08e313feb85264c28a<SEP>chunk-061e2a4672fa2680d7a89f99e4d6de80<SEP>chunk-6b1d348d30a4810b6faddaada697a8bb<SEP>chunk-2d2eb7415c7c2507d0b30788e61632a1<SEP>chunk-f830d9b272fb6dc4d8ef5074127fb8c0", entity_id:"Natya Shastra"}}, {_id:1130, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=KTe11DlB4QI)", entity_type:"concept", truncate:"", description:"architecture is noted as an art form directed toward enlightenment as its unifying principle.", created_at:1779213961, source_id:"chunk-ebde78f6be0d6b08e313feb85264c28a", entity_id:"architecture"}}, {_id:1131, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"method", truncate:"", description:"Eight conscious breaths is a meditation step involving focused breathing without additional modifications.", created_at:1779142412, source_id:"chunk-41c56c693f43ab87b485549113485860", entity_id:"Eight Conscious Breaths"}}, {_id:1132, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=KTe11DlB4QI)", entity_type:"concept", truncate:"", description:"classical dance form is a traditional Indian dance form referenced in the context of the Natya Shastra.", created_at:1779213961, source_id:"chunk-ebde78f6be0d6b08e313feb85264c28a", entity_id:"classical dance form"}}, {_id:1133, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=KTe11DlB4QI)", entity_type:"artifact", truncate:"", description:"astrology is referenced alongside other art forms under the umbrella of enlightenment.", created_at:1779213961, source_id:"chunk-ebde78f6be0d6b08e313feb85264c28a", entity_id:"astrology"}}, {_id:1134, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=KTe11DlB4QI)", entity_type:"concept", truncate:"", description:"Sanskrit phrase from the Natya Shastra, discussed as a philosophical concept extending beyond the original text.", created_at:1779213996, source_id:"chunk-061e2a4672fa2680d7a89f99e4d6de80", entity_id:"Yatha Drishti Tatho Manaha Yatha Mana Tatho Bhavaha Yatha Bhava Tatho Rasaha"}}, {_id:1135, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=KTe11DlB4QI)", entity_type:"concept", truncate:"", description:"Term interpreted as a possible mishearing of \"manah\" (mind), analyzed in the context of thought processes.<SEP>Manaha is a term in the text that was corrected to Manah.", created_at:1779214148, source_id:"chunk-061e2a4672fa2680d7a89f99e4d6de80<SEP>chunk-d5209ab8570771473f1dc46fb7d0a708", entity_id:"Manaha"}}, {_id:1136, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"method", truncate:"", description:"Heart awakening to a state of connection with another person is a meditation goal for fostering deep love and healing.", created_at:1779142412, source_id:"chunk-41c56c693f43ab87b485549113485860", entity_id:"Heart Awakening"}}, {_id:1137, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Stage Two (Aversion) involves negative feelings, brain chemistry changes, and loss of respect due to unresolved conflict.", created_at:1779142412, source_id:"chunk-41c56c693f43ab87b485549113485860", entity_id:"Stage Two (Aversion)"}}, {_id:1138, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"person", truncate:"", description:"The author discusses the stages of disconnection and meditation practices in the text.<SEP>The author of the document is a person who has a deep connection with their mother and Krishnaji.", created_at:1779186869, source_id:"chunk-41c56c693f43ab87b485549113485860<SEP>chunk-4fa62785a13cb6543b898c589a3bd605", entity_id:"The Author"}}, {_id:1139, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Temporary fixes are short-term solutions sought due to the inner void, contrasting with meaningful connections.<SEP>Temporary fixes are sought instead of meaningful connections when in an inner void.", created_at:1779142463, source_id:"chunk-41c56c693f43ab87b485549113485860<SEP>chunk-07e3a1c90936c5a3ded21ee310a7ca5a", entity_id:"Temporary Fixes"}}, {_id:1140, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"UNKNOWN", truncate:"", description:"The text outlines specific meditation steps for achieving connection.", created_at:1779142436, source_id:"chunk-41c56c693f43ab87b485549113485860", entity_id:"Meditation Steps"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:1141, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Life?s challenges are discussed as part of the goal to transform oneself.", created_at:1779142463, source_id:"chunk-07e3a1c90936c5a3ded21ee310a7ca5a", entity_id:"Lifes Challenges"}}, {_id:1142, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"person", truncate:"", description:"The migrant worker is involved in an incident with the author, illustrating societal dynamics.<SEP>Migrant Worker is a person who was helped by Krishnaji and showed compassion to him.", created_at:1779187169, source_id:"chunk-07e3a1c90936c5a3ded21ee310a7ca5a<SEP>chunk-0e75139b40ca183a0159101fa414702c", entity_id:"Migrant Worker"}}, {_id:1143, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: 1PlGMOAypCI (URL: https://www.youtube.com/watch?v=1PlGMOAypCI)", entity_type:"concept", truncate:"", description:"Spiritual Right Action is a principle discussed as a way to transform oneself and impact the web of life. It is defined as acting from innate care and spontaneity rather than rigid formulas or external rules, and it emphasizes present awareness and connection. The principle involves performing actions from a beautiful state, considering one's and others' well-being, and aligning decisions and behaviors with universal consciousness. It is not a step-by-step methodology but a principle that dissolves inner conflict and self-obsession, avoiding self-sacrifice or ideal-driven actions. In a specific context, Spiritual Right Action is described as the fourth sacred secret, guiding the CEO to act from connection and universal vision. It also appears as a path beginning with Serene Mind to achieve clarity and insight, and as a way to achieve ethical behavior emerging from connection.<SEP>Spiritual right action refers to making decisions aligned with ethical principles and universal trust.<SEP>Spiritual right action is a set of principles for making decisions aligned with a higher state of consciousness, leading to positive outcomes.<SEP>Spiritual right action is a principle emphasizing dissolution of suffering states and connection to well-being before taking action.<SEP>Spiritual right action is a set of principles applied in moral and ethical conflicts between right and wrong actions.<SEP>Spiritual right action is a result of an inward journey and guides individuals in making the right decision in life.<SEP>Spiritual right action refers to actions guided by moral or ethical principles, often part of ideal-driven behavior.", created_at:1779655593, source_id:"chunk-07e3a1c90936c5a3ded21ee310a7ca5a<SEP>chunk-cde14d696f27021b8bd46431e4e80d28<SEP>chunk-369f0db74a66636fddaa77ce9a54b9b6<SEP>chunk-53db4a4895ca5dc8d4cc1183c39f2b74<SEP>chunk-14be37b1d86fb5b82128188406768290<SEP>chunk-5d7bc721d374a5cb0cba9dd3f98f763b<SEP>chunk-97955748a023be133267a7da54bf7347<SEP>chunk-408480fb5c52e78fc73c22c8275b38ff<SEP>chunk-ce77326926352a7c47bb2a49044d5832<SEP>chunk-37c881d41553a8a7658ca326a33a2864<SEP>chunk-03367dd9ee49f7699a39e3df3605c23c<SEP>chunk-f85d41f2377858e80129dfbf7af31bf8<SEP>chunk-51a2b155e4eeb45d726ca7ab16117dcc<SEP>chunk-8b53cedbcd4de86ef1b08281380f9428<SEP>chunk-12740ae94c3469761e52a81015d8effe", entity_id:"Spiritual Right Action"}}, {_id:1144, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Meaningful connections are contrasted with temporary fixes as a deeper goal.", created_at:1779142463, source_id:"chunk-07e3a1c90936c5a3ded21ee310a7ca5a", entity_id:"Meaningful Connections"}}, {_id:1145, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"concept", truncate:"", created_at:1779187323, description:"The fourth and last sacred secret is the power of spiritual right action.<SEP>The Fourth Sacred Secret is a spiritual concept emphasizing transformation through right action rooted in love and care.<SEP>The Fourth Sacred Secret focuses on spiritual right action rooted in love, care, and alignment with universal consciousness.", source_id:"chunk-07e3a1c90936c5a3ded21ee310a7ca5a<SEP>chunk-97955748a023be133267a7da54bf7347<SEP>chunk-f85d41f2377858e80129dfbf7af31bf8", entity_id:"Fourth Sacred Secret"}}, {_id:1146, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Letting go of hurt is part of the process to nurture deeper relationships.", created_at:1779142464, source_id:"chunk-07e3a1c90936c5a3ded21ee310a7ca5a", entity_id:"Letting Go of Hurt"}}, {_id:1147, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Deeper relationships are the outcome of awareness and letting go of hurt.", created_at:1779142464, source_id:"chunk-07e3a1c90936c5a3ded21ee310a7ca5a", entity_id:"Deeper Relationships"}}, {_id:1148, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"A fragmented sense of self is linked to the loss of respect.", created_at:1779142464, source_id:"chunk-07e3a1c90936c5a3ded21ee310a7ca5a", entity_id:"Fragmented Sense of Self"}}, {_id:1149, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Loss of respect is a state that creates an inner void.", created_at:1779142464, source_id:"chunk-07e3a1c90936c5a3ded21ee310a7ca5a", entity_id:"Loss of Respect"}}, {_id:1150, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"group", truncate:"", description:"A mob is a collective group that gathers around the Narrator after an accident, which the Woman disperses.<SEP>Mob is a group that surrounds Krishnaji after an incident and could have caused harm.", created_at:1779187169, source_id:"chunk-aa9fb91dec3c3871071d93754b61c5e8<SEP>chunk-0e75139b40ca183a0159101fa414702c", entity_id:"Mob"}}, {_id:1151, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"artifact", truncate:"", description:"The Bike is an artifact that the Narrator uses, which the Woman helps with and transports.", created_at:1779142502, source_id:"chunk-aa9fb91dec3c3871071d93754b61c5e8", entity_id:"Bike"}}, {_id:1152, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2DLb6hDIhmg)", entity_type:"location", truncate:"", description:"The Hut is a location where the Woman takes the Narrator for safety and care.<SEP>Structure where the elephant threw the student during its frenzied state.", created_at:1779211103, source_id:"chunk-aa9fb91dec3c3871071d93754b61c5e8<SEP>chunk-2ed6c538824d03e53845129e9fe68f60", entity_id:"Hut"}}, {_id:1153, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"event", truncate:"", description:"Angry mob represents a threat from which the woman protected the narrator, highlighting conflict and intervention.", created_at:1779142518, source_id:"chunk-cde14d696f27021b8bd46431e4e80d28", entity_id:"Angry Mob"}}, {_id:1154, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Communication to the universe involves transmitting consciousness or intentions into a universal field of awareness.", created_at:1779142518, source_id:"chunk-cde14d696f27021b8bd46431e4e80d28", entity_id:"Communication to the Universe"}}, {_id:1156, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", entity_type:"concept", truncate:"", description:"State of being influences how individuals send information into the universe through their consciousness.<SEP>A state of being describes an inherent condition, such as peace, rather than a learned virtue.<SEP>State of being describes the current emotional or psychological condition of an individual.><SEP>An elevated consciousness characterized by bliss and sacred perception of all experiences.<SEP>An elevated consciousness characterized by bliss and sacred perception of all experiences.", created_at:1779665838, source_id:"chunk-cde14d696f27021b8bd46431e4e80d28<SEP>chunk-6333458ab425b6d36a113393a04c6884<SEP>chunk-5d0f74c4239eabf7a6fea87da28be5d8<SEP>chunk-cd8bf67cc8d8498084f884afbf901342", entity_id:"State of Being"}}, {_id:1157, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"organization", truncate:"", description:"the academy is associated with Preethaji and the source document, promoting spiritual right action principles for life decisions.", created_at:1779142557, source_id:"chunk-5655e9ab49fbb632676d8c50aa4d7718", entity_id:"the academy"}}, {_id:1158, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"spiritual right action refers to principles for aligning with the universe's consciousness through conscious states and connection, leading to unexpected positive outcomes.", created_at:1779142557, source_id:"chunk-5655e9ab49fbb632676d8c50aa4d7718", entity_id:"spiritual right action"}}, {_id:1159, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"concept", truncate:"", description:"life is portrayed as a flow influenced by conscious states and spiritual alignment.<SEP>Life becomes more fulfilling through heightened awareness and conscious engagement.", created_at:1779675447, source_id:"chunk-5655e9ab49fbb632676d8c50aa4d7718<SEP>chunk-69ad193b229bafe28becd7a15ba050a2", entity_id:"life"}}, {_id:1160, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Principle of alignment with consciousness emphasizes harmonizing actions with universal consciousness through connection and conscious states.", created_at:1779142557, source_id:"chunk-5655e9ab49fbb632676d8c50aa4d7718", entity_id:"Principle of Alignment with Consciousness"}}, {_id:1161, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Principle of inspired action frames spiritual right action as guidance rather than rigid laws, serving as inspiration for life decisions.", created_at:1779142558, source_id:"chunk-5655e9ab49fbb632676d8c50aa4d7718", entity_id:"Principle of Inspired Action"}}] AS row
