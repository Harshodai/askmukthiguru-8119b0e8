UNWIND [{start: {_id:1347}, end: {_id:7461}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AviNwtN1luo)", truncate:"", keywords:"collective growth,team bonding", weight:1.0, description:"The Lady's suggestion of a spiritual journey fosters team bonding and growth.", created_at:1779666053, source_id:"chunk-b5d50cf4e2baff26a499b709d68ef082"}}, {start: {_id:4607}, end: {_id:7461}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AviNwtN1luo)", truncate:"", keywords:"collective inspiration,team synergy", weight:1.0, description:"The Lady's vision of a connected brain promotes team synergy and inspiration.", created_at:1779666054, source_id:"chunk-b5d50cf4e2baff26a499b709d68ef082"}}, {start: {_id:7461}, end: {_id:7459}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AviNwtN1luo)", truncate:"", keywords:"leadership principle,team dynamics", weight:1.0, description:"The Lady invokes Yatha raja tatha praja to explain the link between leadership and team behavior.", created_at:1779666054, source_id:"chunk-b5d50cf4e2baff26a499b709d68ef082"}}, {start: {_id:7467}, end: {_id:7466}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AviNwtN1luo)", truncate:"", keywords:"course instruction,leadership", weight:1.0, description:"Pritharji leads and instructs The Mystic Secrets as its creator and guide.", created_at:1779666070, source_id:"chunk-20b522ad915c05aa0d61fb0dbb9917a4"}}, {start: {_id:1422}, end: {_id:7466}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AviNwtN1luo)", truncate:"", keywords:"collective journey,target audience", weight:1.0, description:"The Mystic Secrets is designed for teams to undertake as a shared spiritual and professional experience.", created_at:1779666070, source_id:"chunk-20b522ad915c05aa0d61fb0dbb9917a4"}}, {start: {_id:4606}, end: {_id:7466}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AviNwtN1luo)", truncate:"", keywords:"brain connectivity,collective consciousness", weight:1.0, description:"The Mystic Secrets enables collective brain connectivity, fostering shared inspiration and ideas among team members.", created_at:1779666071, source_id:"chunk-20b522ad915c05aa0d61fb0dbb9917a4"}}, {start: {_id:3090}, end: {_id:5323}, properties:{file_path:"unknown_source", keywords:"biological paradox,self-harm", truncate:"", weight:1.0, description:"Humans uniquely inflict harm on their own species based on superficial differences like skin color.", created_at:1779666123, source_id:"chunk-1939ef89c77285b5d61536082f605bb4"}}, {start: {_id:533}, end: {_id:1899}, properties:{file_path:"unknown_source", truncate:"", keywords:"leadership qualities,transformative force", weight:1.0, description:"Compassion enables individuals to become heart leaders by transcending differences.", created_at:1779666123, source_id:"chunk-1939ef89c77285b5d61536082f605bb4"}}, {start: {_id:7475}, end: {_id:7478}, properties:{file_path:"unknown_source", truncate:"", keywords:"biological commonality,philosophical appeal", weight:1.0, description:"Shared evolutionary history underscores the illusion of differences and promotes unity.", created_at:1779666124, source_id:"chunk-1939ef89c77285b5d61536082f605bb4"}}, {start: {_id:7477}, end: {_id:7474}, properties:{file_path:"unknown_source", truncate:"", keywords:"psychological impact,scientific findings", weight:1.0, description:"Research shows stress reduces the brain's acceptance of differences, increasing alienation.", created_at:1779666124, source_id:"chunk-1939ef89c77285b5d61536082f605bb4"}}, {start: {_id:7476}, end: {_id:5573}, properties:{file_path:"unknown_source", truncate:"", keywords:"behavioral response,environmental factors", weight:1.0, description:"Competitive organizations practice social alienation more frequently due to stress-driven environments.", created_at:1779666124, source_id:"chunk-1939ef89c77285b5d61536082f605bb4"}}, {start: {_id:7469}, end: {_id:5573}, properties:{file_path:"unknown_source", keywords:"cognitive response,societal behavior", truncate:"", weight:1.0, description:"Perceived differences lead to social alienation through fear and unfamiliarity.", created_at:1779666124, source_id:"chunk-1939ef89c77285b5d61536082f605bb4"}}, {start: {_id:7469}, end: {_id:7478}, properties:{file_path:"unknown_source", truncate:"", keywords:"existential perspective,paradox resolution", weight:1.0, description:"Differences are superficial compared to shared humanity, urging acceptance over judgment.", created_at:1779666124, source_id:"chunk-1939ef89c77285b5d61536082f605bb4"}}, {start: {_id:496}, end: {_id:7468}, properties:{file_path:"unknown_source<SEP>YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"causation,psychological factors,social tension,social triggers", weight:2.0, description:"Widespread anxiety exacerbates communal and racial violence by heightening societal tensions.<SEP>Widespread anxiety is linked to increased instances of communal violence during times of social unrest.", created_at:1779666397, source_id:"chunk-1939ef89c77285b5d61536082f605bb4<SEP>chunk-10bef6757e8808291f38e464343bf8be"}}, {start: {_id:496}, end: {_id:3270}, properties:{file_path:"unknown_source<SEP>YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"causation,psychological factors,social tension,social triggers", weight:2.0, description:"Anxiety increases the likelihood of racial violence through heightened fear of difference.<SEP>Anxiety is associated with heightened racial violence due to societal divisions.", created_at:1779666398, source_id:"chunk-1939ef89c77285b5d61536082f605bb4<SEP>chunk-10bef6757e8808291f38e464343bf8be"}}, {start: {_id:3885}, end: {_id:7483}, properties:{file_path:"unknown_source", keywords:"existence,pervade", truncate:"", weight:1.0, description:"Spirits are described as pervading other Lokas, indicating their presence across different planes of existence.", created_at:1779666217, source_id:"chunk-ef84739ec9f14b6d1ebaee11b611e3e8"}}, {start: {_id:251}, end: {_id:3901}, properties:{file_path:"unknown_source", keywords:"action,location", truncate:"", weight:1.0, description:"The spirits are described as pervading other Lokas to Abraham, which is a location, and their action is pervading.", created_at:1779666217, source_id:"chunk-e62e4366c052c78d46a09bec53d2a9c4"}}, {start: {_id:3892}, end: {_id:7479}, properties:{file_path:"unknown_source", keywords:"equivalence,explanation", truncate:"", weight:1.0, description:"\"Sarvam khalvidam Brahman\" is explicitly identified as one Brahma Sutra in the text.", created_at:1779666217, source_id:"chunk-ef84739ec9f14b6d1ebaee11b611e3e8"}}, {start: {_id:3887}, end: {_id:7479}, properties:{file_path:"unknown_source<SEP>YouTube Video: 6-GWHR9_iSU (URL: https://www.youtube.com/watch?v=6-GWHR9_iSU)", keywords:"collection,philosophical concept,teaching", truncate:"", weight:2.0, description:"Sarvam khalvidam Brahman is one of the Brahma Sutras, which are teachings on enlightened states of consciousness.<SEP>The Brahma Sutras include the specific sutra \"Sarvam khalvidam Brahman.\"", created_at:1779666246, source_id:"chunk-e62e4366c052c78d46a09bec53d2a9c4<SEP>chunk-5b76959242343174ca2993b42bcf33e0"}}, {start: {_id:2097}, end: {_id:7487}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"error analysis,linguistic focus", weight:1.0, description:"The YouTube video is analyzed for homophones and misheard words as part of error checking.", created_at:1779666359, source_id:"chunk-db7d5a106bdc58ffca9bc17f8723f7e5"}}] AS row
