UNWIND [{_id:1493, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"The Limitless Field is a medium for experiencing transcendental and enlightened states of consciousness.", created_at:1779145019, source_id:"chunk-4387dd7058fa0d482c87322707ef132a", entity_id:"The Limitless Field"}}, {_id:1494, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"concept", truncate:"", description:"Quantum physics is a field of study exploring fundamental questions about the nature of reality.<SEP>quantum physics explores fundamental principles of nature, influencing understanding of consciousness.", created_at:1779174139, source_id:"chunk-4387dd7058fa0d482c87322707ef132a<SEP>chunk-9d9744dacd10c03b653c5a3fe39dda9e", entity_id:"quantum physics"}}, {_id:1495, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"An energy field is a region around a person where consciousness creates an impact on others.", created_at:1779145019, source_id:"chunk-4387dd7058fa0d482c87322707ef132a", entity_id:"energy field"}}, {_id:1496, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"naturalobject", truncate:"", description:"The electron is a subatomic particle that exhibits both particle-like and wave-like properties.", created_at:1779145019, source_id:"chunk-4387dd7058fa0d482c87322707ef132a", entity_id:"electron"}}, {_id:1497, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"UNKNOWN", truncate:"", description:"The Limitless Field serves as a medium for experiencing transcendental and enlightened states of consciousness.", created_at:1779145020, source_id:"chunk-4387dd7058fa0d482c87322707ef132a", entity_id:"transcendental states"}}, {_id:1498, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=