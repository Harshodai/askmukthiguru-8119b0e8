UNWIND [{start: {name:"Ekam"}, end: {_id:1503}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"impact,meditation", truncate:"", weight:1.0, description:"Meditating at Ekam impacts the psychic energy centers, facilitating cosmic energy flow into human consciousness.", created_at:1779145125, source_id:"chunk-7e637a18b58bf595a06a2db9ad36bf77"}}, {start: {name:"Ekam"}, end: {_id:1507}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", keywords:"consciousness amplification,event hosting,organization,sacred architecture,spiritual leadership,spiritual principles,wellness", truncate:"", weight:4.0, description:"Ekam hosts the Ekam Abundance Festival, which challenges linear cause-effect assumptions in human life.<SEP>Ekam's structure hosts the Abundance Festival to demonstrate cause-effect reversal through non-local principles.<SEP>Ekam organizes the festival to promote healing and self-realization through spiritual practices like Deeksha and Sadhana.<SEP>Ekam organizes the Ekam Abundance Festival focused on addiction recovery and personal transformation.", created_at:1779224869, source_id:"chunk-d4f348195cac29cb9f7fb85f914fa19c<SEP>chunk-9d5ed1319932eeba02c60354b423c137<SEP>chunk-91b4190f855a81f99cd10dbd03ae90db<SEP>chunk-f3c9a2b1053591399fd7351098da3627"}}, {start: {name:"Ekam"}, end: {_id:831}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"collective consciousness,event hosting,global harmony,universal harmony", truncate:"", weight:2.0, description:"Ekam hosts the Ekam World Peace Festival to promote collective harmony and peace.<SEP>The World Peace Festival uses Ekam's architecture to amplify cosmic energies for global harmony.", created_at:1779188103, source_id:"chunk-d4f348195cac29cb9f7fb85f914fa19c<SEP>chunk-9d5ed1319932eeba02c60354b423c137"}}, {start: {name:"Ekam"}, end: {_id:1508}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"event hosting,facilitator,mystical unity,non-dual awareness,organizer,spiritual awakening", truncate:"", weight:3.0, created_at:1779188103, description:"Ekam hosts the Ekam Enlightenment Festival to guide participants toward spiritual oneness.<SEP>Ekam organizes the festival and acts as a consciousness amplifier during the event.<SEP>The Enlightenment Festival leverages Ekam's design to facilitate group transcendence into Ekam states.", source_id:"chunk-d4f348195cac29cb9f7fb85f914fa19c<SEP>chunk-aa6df70374eb253c7ca1bd643516678c<SEP>chunk-9d5ed1319932eeba02c60354b423c137"}}, {start: {name:"Ekam"}, end: {_id:1511}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"architectural resonance,energy amplification", weight:1.0, description:"Ekam's structure resonates with and amplifies sacred healing energies of the earth and universe.", created_at:1779145174, source_id:"chunk-d4f348195cac29cb9f7fb85f914fa19c"}}, {start: {name:"Ekam"}, end: {_id:1510}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"collective impact,spiritual alignment", weight:1.0, description:"Ekam's design aims to align human consciousness with the collective for profound shifts toward peace.", created_at:1779145174, source_id:"chunk-d4f348195cac29cb9f7fb85f914fa19c"}}, {start: {name:"Ekam"}, end: {_id:1512}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"consciousness guidance,transcendental realms", weight:1.0, description:"Ekam's powerful field facilitates entry into transcendental realms during meditation processes.", created_at:1779145174, source_id:"chunk-d4f348195cac29cb9f7fb85f914fa19c"}}, {start: {name:"Consciousness"}, end: {_id:864}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"core theme,teaching focus", truncate:"", weight:1.0, description:"The Academy centers its teachings on transforming human consciousness across cultures.", created_at:17791