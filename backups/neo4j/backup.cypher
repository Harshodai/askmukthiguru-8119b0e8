UNWIND [{start: {_id:3931}, end: {_id:1301}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", keywords:"global need,intelligence", truncate:"", weight:1.0, description:"The need for spiritual growth is tied to the need for intelligence and stress management.", created_at:1779246171, source_id:"chunk-99430e4042493d6e8f0a7ec8dfcc1cb3"}}, {start: {_id:3931}, end: {_id:3928}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", keywords:"global need,self-help", truncate:"", weight:1.0, description:"Self-help is evolving to meet the global need for spiritual experience and stress relief.", created_at:1779246171, source_id:"chunk-99430e4042493d6e8f0a7ec8dfcc1cb3"}}, {start: {_id:3939}, end: {_id:3940}, properties:{file_path:"unknown_source", keywords:"existence,manifestation", truncate:"", weight:1.0, description:"Life forms are waves within the infinite consciousness.", created_at:1779246618, source_id:"chunk-5be4ab3ffc3d58a2d8190326819f706c"}}, {start: {_id:1799}, end: {_id:3938}, properties:{file_path:"unknown_source", keywords:"awakening,integration", truncate:"", weight:1.0, description:"Human beings must awaken to an inclusive consciousness to fulfill their potential.", created_at:1779246618, source_id:"chunk-5be4ab3ffc3d58a2d8190326819f706c"}}, {start: {_id:3938}, end: {_id:3939}, properties:{file_path:"unknown_source", keywords:"aspiration,manifestation", truncate:"", weight:1.0, description:"The infinite consciousness manifests as the universe and inspires the aspiration for an inclusive consciousness.", created_at:1779246618, source_id:"chunk-5be4ab3ffc3d58a2d8190326819f706c"}}, {start: {_id:3938}, end: {_id:3940}, properties:{file_path:"unknown_source", keywords:"awakening,integration", truncate:"", weight:1.0, description:"Life forms are part of the narrative of an inclusive consciousness.", created_at:1779246618, source_id:"chunk-5be4ab3ffc3d58a2d8190326819f706c"}}