UNWIND [{start: {name:"Guru"}, end: {_id:3888}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"enlightenment,spiritual guidance", weight:1.0, description:"Guru Purnima celebrates the role of Gurus in achieving liberation.", created_at:1779665876, source_id:"chunk-ed14675eaeee5b36e94642ad031a9dc4"}}, {start: {name:"Consciousness"}, end: {_id:7461}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AviNwtN1luo)", truncate:"", keywords:"leadership development,self-awareness", weight:1.0, description:"The Lady's expanded consciousness is a key to leading with purpose.", created_at:1779666053, source_id:"chunk-b5d50cf4e2baff26a499b709d68ef082"}}, {start: {name:"Brahman"}, end: {_id:7482}, properties:{file_path:"unknown_source", keywords:"cosmological hierarchy,unity", truncate:"", weight:1.0, description:"Brahman encompasses all entities including Devas, Suras, and Lokas as part of its indivisible consciousness.", created_at:1779666217, source_id:"chunk-ef84739ec9f14b6d1ebaee11b611e3e8"}}, {start: {name:"Brahman"}, end: {_id:7484}, properties:{file_path:"unknown_source", keywords:"transcendence,unity", truncate:"", weight:1.0, description:"Brahman is described as encompassing both the physical universe and higher consciousness states.", created_at:1779666218, source_id:"chunk-ef84739ec9f14b6d1ebaee11b611e3e8"}}, {start: {name:"Brahman"}, end: {_id:251}, properties:{file_path:"unknown_source", keywords:"description,identity", truncate:"", weight:1.0, description:"Brahman is described as the field of consciousness, indicating that they are the same concept.", created_at:1779666218, source_id:"chunk-e62e4366c052c78d46a09bec53d2a9c4"}}, {start: {name:"Brahman"}, end: {_id:7479}, properties:{file_path:"unknown_source<SEP>YouTube Video: 6-GWHR9_iSU (URL: https://www.youtube.com/watch?v=6-GWHR9_iSU)", keywords:"concept,philosophical concept,unity,universal scope", truncate:"", weight:2.0, description:"Sarvam khalvidam Brahman means all that exists is Brahman, indicating a relationship of unity between the concept and the idea of Brahman.<SEP>The sutra describes Brahman as the indivisible consciousness underlying all existence, spanning from micro to macro levels.", created_at:1779666246, source_id:"chunk-e62e4366c052c78d46a09bec53d2a9c4<SEP>chunk-5b76959242343174ca2993b42bcf33e0"}}, {start: {name:"Consciousness"}, end: {_id:7530}, properties:{file_path:"unknown_source", truncate:"", keywords:"interconnected system,systemic impact", weight:4.0, description:"Individual consciousness interacts with the broader fabric of intelligence, determining karma manifestation through collective actions.<SEP>Individual consciousness interacts with the broader fabric of intelligence, determining karma manifestation through collective actions.<SEP>Individual consciousness interacts with the broader fabric of intelligence, determining karma manifestation through collective actions.<SEP>Individual consciousness interacts with the broader fabric of intelligence, determining karma manifestation through collective actions.", created_at:1779667929, source_id:"chunk-e346b8f3e13471227b92c08380bf14d1"}}, {start: {name:"Dharma"}, end: {_id:2144}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", truncate:"", keywords:"content,themes", weight:1.0, description:"The dharma theme is part of the original text's content.", created_at:1779668369, source_id:"chunk-9dc446aa1478fdaca34017fdd93d325e"}}, {start: {name:"Dharma"}, end: {_id:295}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", keywords:"decision-making,principles", truncate:"", weight:1.0, description:"Well-being and dharma are linked as guiding principles in discovering right action through decisions.", created_at:1779668555, source_id:"chunk-b0665bc54ec5c34cda1db12508303332"}}, {start: {name:"Consciousness"}, end: {_id:234}, properties:{file_path:"unknown_source", keywords:"impact,support,transformation", truncate:"", weight:1.0, description:"Consciousness impacts and supports others, leading to their transformation.", created_at:1779668711, source_id:"chunk-c088c9de5db4ddb6d01a048401214aef"}}, {start: {name:"Consciousness"}, end: {_id:7589}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"impact,transformation", truncate:"", weight:1.0, description:"Consciousness impacts the people around you during personal transformation.", created_at:1779668956, source_id:"chunk-472321605b70f46b6792fb017a049d8d"}}, {start: {name:"Consciousness"}, end: {_id:333}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"connection,impact,mutual influence,support,transformation", weight:3.0, created_at:1779669125, description:"Consciousness creates a connection with loved ones as self-awareness expands.<SEP>Expanded consciousness enables supporting and transforming loved ones through non-judgmental presence and mutual inclusion.<SEP>Consciousness impacts loved ones as the individual's awareness expands and transforms.", source_id:"chunk-472321605b70f46b6792fb017a049d8d<SEP>chunk-313c3c4bd3fa26c1b3b5e358022a1e6b<SEP>chunk-607beefb79fd1c2b867abf7979a1dbfc"}}, {start: {name:"Consciousness"}, end: {_id:1358}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"agency,position", weight:1.0, description:"Consciousness enables a position to impact others through transformation and self-awareness.", created_at:1779668956, source_id:"chunk-472321605b70f46b6792fb017a049d8d"}}, {start: {name:"Consciousness"}, end: {_id:7605}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"expansion,unity", weight:1.0, description:"Consciousness transforms to include others, dissolving separateness and fostering mutual support.", created_at:1779669036, source_id:"chunk-313c3c4bd3fa26c1b3b5e358022a1e6b"}}, {start: {name:"Consciousness"}, end: {_id:4615}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"impact,transformation", truncate:"", weight:1.0, description:"Consciousness affects others through the individual's sense of interconnectedness.", created_at:1779669125, source_id:"chunk-607beefb79fd1c2b867abf7979a1dbfc"}}, {start: {name:"Consciousness"}, end: {_id:598}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"evolution,replacement", truncate:"", weight:1.0, description:"Consciousness transformation replaces judgment with supportive actions toward others.", created_at:1779669356, source_id:"chunk-fb3062b3d6881522fcc2387d435da879"}}, {start: {name:"Karma"}, end: {_id:7698}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Ji-hdW1t30g)", keywords:"analogy,comparison,similarity", truncate:"", weight:2.0, description:"Karma is compared to the law of gravity as a natural, non-agency-driven universal law.<SEP>Karma is likened to the law of gravity as a natural, impersonal law governing universal cause-and-effect.", created_at:1779671952, source_id:"chunk-295ff82e6931c82451b6f00c8154605e<SEP>chunk-ed6b93b857d66f4aba7388c8d2b20ca9"}}, {start: {name:"Consciousness"}, end: {_id:7693}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"context,metaphorical association", weight:1.0, description:"Consciousness is described as carrying a \"huge load of thoughts.\"", created_at:1779671942, source_id:"chunk-c47a850c80a21ed6c67cbed2bc4b8ec0"}}, {start: {name:"Karma"}, end: {_id:7701}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Ji-hdW1t30g)", truncate:"", keywords:"agency,contrast", weight:1.0, description:"Sin involves human agency and punishment, while Karma operates impersonally like natural laws.", created_at:1779671953, source_id:"chunk-ed6b93b857d66f4aba7388c8d2b20ca9"}}, {start: {name:"Consciousness"}, end: {_id:2404}, properties:{file_path:"unknown_source", keywords:"harmony,impact", truncate:"", weight:1.0, description:"An individual in a beautiful state creates an environment in the realm of consciousness that impacts others.", created_at:1779672444, source_id:"chunk-0ec81fd92a8028a31f8c6ce341a46fe9"}}] AS row
