UNWIND [{_id:2914, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"UNKNOWN", truncate:"", description:"\"De-addiction\" is identified as a clinical term incompatible with the spiritual context.", created_at:1779225872, source_id:"chunk-59c75858fc62071381380d482998c935", entity_id:"clinical terminology"}}, {_id:2915, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Events marking milestones like anniversaries, referenced in the context of decision-making.", created_at:1779186460, source_id:"chunk-8c0fbc02d7372a76ebf44b3a7fb627dc", entity_id:"Celebrations"}}, {_id:2916, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Milestone events such as anniversaries, mentioned in the context of relationship decisions and celebrations.", created_at:1779186460, source_id:"chunk-8c0fbc02d7372a76ebf44b3a7fb627dc", entity_id:"Anniversaries"}}, {_id:2917, properties:{file_path:"unknown_source<SEP>YouTube Video: vch9C_hNjGs (URL: https://www.youtube.com/watch?v=vch9C_hNjGs)", entity_type:"concept", truncate:"", created_at:1779662710, description:"Accomplishments mentioned alongside relationships as sources of potential dissatisfaction.<SEP>Actions or accomplishments created from a state of pure consciousness.<SEP>Achievements in this context are actions or results created from a state of cosmic consciousness, aimed at fulfilling a greater purpose beyond self.", source_id:"chunk-8c0fbc02d7372a76ebf44b3a7fb627dc<SEP>chunk-8570f0aea49283824eb9980842a005e9<SEP>chunk-c9bb5b4ae7e13a7674f385925b990906", entity_id:"Achievements"}}, {_id:2918, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"UNKNOWN", truncate:"", description:"The YouTube video's content is analyzed for transcription errors and contextual term usage.", created_at:1779225872, source_id:"chunk-59c75858fc62071381380d482998c935", entity_id:"transcription analysis"}}, {_id:2919, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The text emphasizes that the most important decision for a relationship is not about celebrations but about the relationship's foundation and priorities.", created_at:1779186609, source_id:"chunk-8c0fbc02d7372a76ebf44b3a7fb627dc", entity_id:"Priorities"}}, {_id:2920, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A beautiful state of connection refers to a harmonious, compassionate relationship characterized by mutual empathy and presence.", created_at:1779186658, source_id:"chunk-7f41805cd78c323a0c0383328a52c327", entity_id:"Beautiful state of connection"}}, {_id:2921, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Sunil's daughter is his child, whom he initially relates to through duty but later seeks to connect with more deeply after his spiritual awakening.", created_at:1779186658, source_id:"chunk-7f41805cd78c323a0c0383328a52c327", entity_id:"Sunil's daughter"}}, {_id:2923, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Moon's boyfriend is a person who scolds Moon after the accident, handles police formalities, and is perceived as insensitive by Moon.` - Correct.<SEP>formalities handling, assistance<|", created_at:1779186733, source_id:"chunk-c8cc27957b68d36b9eca4a85d95d3c9f", entity_id:"Moon's Boyfriend"}}, {_id:2924, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Protective feeling describes the boyfriend?s care and concern for Moon?s well-being.", created_at:1779186734, source_id:"chunk-bda2d2f720df9a2377a09a7b416beb0e", entity_id:"Protective Feeling"}}, {_id:2925, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Moon observes her own self-obsessed thoughts and begins to recognize them.", created_at:1779186838, source_id:"chunk-bda2d2f720df9a2377a09a7b416beb0e", entity_id:"Self-Obsessed Thinking"}}, {_id:2926, properties:{file_path:"unknown_source", entity_type:"location", truncate:"", description:"Bapu Sabhaagar, Gyan Bhavan, Gandhi Maidan, Patna, Bihar is the venue for the event hosted by Shri Preethaji and Shri Krishnaji.", created_at:1779226100, source_id:"chunk-77d6f5a3144b96f2147a4737563dbfb7", entity_id:"Bapu Sabhaagar, Gyan Bhavan, Gandhi Maidan, Patna, Bihar"}}, {_id:2927, properties:{file_path:"unknown_source", entity_type:"content", truncate:"", description:"Four Sacred Secrets (Chaar Param Rahasya) is a global best-selling book by Shri Preethaji and Shri Krishnaji, offering life-transforming insights, now available in Hindi.", created_at:1779226100, source_id:"chunk-77d6f5a3144b96f2147a4737563dbfb7", entity_id:"Four Sacred Secrets (Chaar Param Rahasya)"}}, {_id:2928, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Using wealth or beauty as the primary basis for relationships creates instability.", created_at:1779186963, source_id:"chunk-5506ec1bf2947c78c3b169a20af36482", entity_id:"Relationship Foundation"}}, {_id:2929, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Passion diminishes rapidly with shifts in relational dynamics or external circumstances.", created_at:1779186963, source_id:"chunk-5506ec1bf2947c78c3b169a20af36482", entity_id:"Change of Status"}}, {_id:2930, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"New relationships may temporarily mask loneliness or hurt but often recreate similar issues.", created_at:1779186963, source_id:"chunk-5506ec1bf2947c78c3b169a20af36482", entity_id:"Loneliness/Hurt"}}, {_id:2931, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"New relationships may temporarily mask loneliness or hurt but often recreate similar issues.", created_at:1779186963, source_id:"chunk-5506ec1bf2947c78c3b169a20af36482", entity_id:"Relationship Motivation"}}, {_id:2932, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Using wealth or beauty as the primary basis for relationships creates instability.", created_at:1779186963, source_id:"chunk-5506ec1bf2947c78c3b169a20af36482", entity_id:"Wealth/Beauty"}}, {_id:2933, properties:{file_path:"unknown_source", entity_type:"method", truncate:"", description:"The villagers' method of using desserts to catch monkeys.", created_at:1779186986, source_id:"chunk-71a9fb4bfe84373a489e9a88ded57dae", entity_id:"Monkey Catching Method"}}, {_id:2934, properties:{file_path:"unknown_source", entity_type:"process", truncate:"", description:"The process between Clark and Doris, leading to their relationship.", created_at:1779186986, source_id:"chunk-f01f7886f64dcda0228048269c532fa0", entity_id:"Their Process"}}] AS row
