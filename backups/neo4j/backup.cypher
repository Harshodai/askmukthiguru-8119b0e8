UNWIND [{_id:200, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"organization", truncate:"", created_at:1779183332, description:"Larssen & Toubro is the construction company contracted to execute the project on the sacred site.<SEP>Larssen & Toubro is the construction company responsible for executing the Ekam project on the sacred site.<SEP>Larssen & Toubro is the construction company responsible for executing the Ekam project on the sacred site.", source_id:"chunk-d6d985847ffebe163bb1dd6d9757e27c<SEP>chunk-6fc0263d49e5375ab049da188ead9d87<SEP>chunk-08a8bfd8ab34e14f6fb9afe4224d7966", entity_id:"Larssen & Toubro"}}, {_id:201, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"location", truncate:"", description:"A national forest where the project site is located, leading to a conflict with the Forest Department.<SEP>The national forest is a protected area where the project site is located, subject to strict forest laws.<SEP>The national forest is a protected area where the Ekam project site is located, leading to legal disputes over construction access.<SEP>The national forest where Ekam was built, located in the foothills of a mountain range with strict legal protections.", created_at:1779183333, source_id:"chunk-d6d985847ffebe163bb1dd6d9757e27c<SEP>chunk-65e7f74bfe44ee1fe112dc5e95ecdb2e<SEP>chunk-6fc0263d49e5375ab049da188ead9d87<SEP>chunk-08a8bfd8ab34e14f6fb9afe4224d7966", entity_id:"National Forest"}}, {_id:202, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"location", truncate:"", description:"A forty-four-acre plot in a forest, located in the foothills of a mountain range, chosen for its radiant energies.", created_at:1779136252, source_id:"chunk-d6d985847ffebe163bb1dd6d9757e27c", entity_id:"Land"}}, {_id:203, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"organization", truncate:"", created_at:1779174769, description:"The Forest Department is a government body responsible for managing national forests and issuing regulatory notices.<SEP>The Forest Department is a government body responsible for managing national forests and enforcing forest laws.<SEP>The Forest Department is a government body that blocked access to the construction site, citing the land's location within a national forest.", source_id:"chunk-d6d985847ffebe163bb1dd6d9757e27c<SEP>chunk-65e7f74bfe44ee1fe112dc5e95ecdb2e<SEP>chunk-6fc0263d49e5375ab049da188ead9d87", entity_id:"Forest Department"}}, {_id:204, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"naturalobject", truncate:"", description:"The land is located in the foothills of a mountain range, radiating energies.<SEP>The mountain range near the site radiated energies that influenced the selection of the sacred land.", created_at:1779174795, source_id:"chunk-d6d985847ffebe163bb1dd6d9757e27c<SEP>chunk-6fc0263d49e5375ab049da188ead9d87", entity_id:"Mountain Range"}}, {_id:205, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"organization", truncate:"", description:"The construction company mobilized workforce and equipment for the project, facing cost overruns due to site blockage.", created_at:1779136279, source_id:"chunk-65e7f74bfe44ee1fe112dc5e95ecdb2e", entity_id:"Construction Company"}}, {_id:206, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"India's strict forest laws prohibit construction in national forests without explicit permission, with legal processes taking years.", created_at:1779136279, source_id:"chunk-65e7f74bfe44ee1fe112dc5e95ecdb2e", entity_id:"Strict Forest Laws"}}, {_id:207, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"data", truncate:"", description:"Approved building plans for the project were approved by relevant authorities but neglected to account for forest restrictions.<SEP>Approved building plans for Ekam were approved by relevant authorities but neglected to account for the site's location in a national forest.", created_at:1779174795, source_id:"chunk-65e7f74bfe44ee1fe112dc5e95ecdb2e<SEP>chunk-6fc0263d49e5375ab049da188ead9d87", entity_id:"Building Plans"}}, {_id:208, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"organization", truncate:"", description:"The Department of Housing and Urban Development is a government body overseeing urban development and building regulations.", created_at:1779136279, source_id:"chunk-65e7f74bfe44ee1fe112dc5e95ecdb2e", entity_id:"Department of Housing and Urban Development"}}, {_id:209, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"data", truncate:"", description:"Cost overruns refer to financial losses incurred due to halted construction and mobilized resources.<SEP>Cost overruns occurred due to blocked construction access and mobilization of resources, escalating financial burdens.", created_at:1779174795, source_id:"chunk-65e7f74bfe44ee1fe112dc5e95ecdb2e<SEP>chunk-6fc0263d49e5375ab049da188ead9d87", entity_id:"Cost Overruns"}}, {_id:210, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Project Ekam is a visionary initiative aimed at transforming consciousness, perceived as sacred and essential to awaken millions.", created_at:1779136279, source_id:"chunk-65e7f74bfe44ee1fe112dc5e95ecdb2e", entity_id:"Project Ekam"}}, {_id:211, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"location", truncate:"", description:"The construction site is the location where the project was intended to be built, which is in the national forest and was blocked by the Forest Department.<SEP>The construction site is the location where the project was intended to be built, blocked by the Forest Department.", created_at:1779136280, source_id:"chunk-65e7f74bfe44ee1fe112dc5e95ecdb2e", entity_id:"Construction Site"}}, {_id:212, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"UNKNOWN", truncate:"", description:"The department failed to inform the project team about forest restrictions despite approved plans.\" But \"Project Team\" isn't an entity in the current input. Wait, in the current input, the user refers to themselves as \"we,\" which is the project team, but since it's a pronoun, it's not extracted. However, the previous output included \"Project Team\" as an entity. But in the current input, there's no explicit mention of \"Project Team\" as a named entity. Therefore, the previous output might have incorrectly included \"Project Team\" as an entity. Wait, looking back at the input text provided in the current task:", created_at:1779136280, source_id:"chunk-65e7f74bfe44ee1fe112dc5e95ecdb2e", entity_id:"Project Team"}}, {_id:213, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"concept", truncate:"", created_at:1779183674, description:"Future-oriented plans and hopes for life, distinct from spiritual vision which focuses on present-state consciousness.<SEP>Goals are presented as elements influenced by the individual's psychological state, affecting their alignment with purpose or stress.<SEP>Goals are future-oriented aspirations and plans for life, distinct from the present-state focus of spiritual vision.", source_id:"chunk-9c97a5c948e2a2d2773c3f2ccee7edeb<SEP>chunk-e897fef731236d55e77f48600e6eadf5<SEP>chunk-e48cb770a294a3d305875880cc43095f", entity_id:"Goals"}}, {_id:214, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"location", truncate:"", description:"Road used for meditation and spiritual purposes after obtaining permission from authorities.<SEP>The twisting road where the car accident occurred.", created_at:1779144028, source_id:"chunk-9c97a5c948e2a2d2773c3f2ccee7edeb<SEP>chunk-bcdc6f717c6627075a9723ba584173eb", entity_id:"Road"}}, {_id:215, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"organization", truncate:"", created_at:1779183332, description:"Government agency responsible for granting permissions to use roads in forest areas.<SEP>The National Forest Department is the authority that initially blocked access to the construction site due to strict forest laws.", source_id:"chunk-9c97a5c948e2a2d2773c3f2ccee7edeb<SEP>chunk-fb514840089d6805bbfb2598cae38dae<SEP>chunk-08a8bfd8ab34e14f6fb9afe4224d7966", entity_id:"National Forest Department"}}, {_id:216, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Historic and unusual events resulting from the spiritual vision, including permission approval and meditative impact.", created_at:1779136297, source_id:"chunk-9c97a5c948e2a2d2773c3f2ccee7edeb", entity_id:"Incredible Occurrences"}}, {_id:217, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"The project unfolding in consciousness, central to the narrative and leading to significant outcomes.", created_at:1779136297, source_id:"chunk-9c97a5c948e2a2d2773c3f2ccee7edeb", entity_id:"Project"}}, {_id:218, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)<SEP>YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"concept", truncate:"", description:"An example of a vision (e.g., being a parent) that contrasts with spiritual vision's focus on consciousness state.<SEP>Parent represents an example of a vision (e.g., being a parent) that operates within the framework of spiritual vision.<SEP>Parents are called to consciously pass on states of connection and oneness to their children and grandchildren through stories and conversations.<SEP>Parent symbolizes familial love and nurturing, as listed among the manifestations of love in the text.", created_at:1779659276, source_id:"chunk-9c97a5c948e2a2d2773c3f2ccee7edeb<SEP>chunk-e48cb770a294a3d305875880cc43095f<SEP>chunk-6e3da3d5c67b838008777970dd3f104c<SEP>chunk-b0aa1897202602a9be2a7516d39d5400", entity_id:"Parent"}}, {_id:219, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"UNKNOWN", truncate:"", description:"Staying grounded in spiritual vision facilitated obtaining permission for the road.", created_at:1779136298, source_id:"chunk-9c97a5c948e2a2d2773c3f2ccee7edeb", entity_id:"Road Permission"}}] AS row
