UNWIND [{start: {_id:7127}, end: {_id:7128}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", keywords:"futility,intervention", truncate:"", weight:1.0, description:"The video argues that cosmetic procedures are futile for achieving lasting happiness through appearance alteration.", created_at:1779655686, source_id:"chunk-97eda5ea96b7f1db5f0d7a104094ffd9"}}, {start: {_id:784}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", truncate:"", keywords:"aging,transience", weight:1.0, description:"The video emphasizes the natural aging process of the human body as a counterpoint to pursuit of static beauty.", created_at:1779655686, source_id:"chunk-97eda5ea96b7f1db5f0d7a104094ffd9"}}, {start: {_id:4460}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", keywords:"education,guidance", truncate:"", weight:1.0, description:"The video advocates teaching children to respect their bodies and care for them.", created_at:1779655686, source_id:"chunk-97eda5ea96b7f1db5f0d7a104094ffd9"}}, {start: {_id:784}, end: {_id:7128}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", keywords:"perception,reality", truncate:"", weight:1.0, description:"The video contrasts societal perceptions of physical appearance with the biological reality of the aging human body.", created_at:1779655686, source_id:"chunk-97eda5ea96b7f1db5f0d7a104094ffd9"}}, {start: {_id:466}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", truncate:"", keywords:"self-perception,societal pressure", weight:1.0, description:"The video promotes self-acceptance despite societal pressures on body image.", created_at:1779655686, source_id:"chunk-97eda5ea96b7f1db5f0d7a104094ffd9"}}, {start: {_id:301}, end: {_id:348}, properties:{file_path:"Y