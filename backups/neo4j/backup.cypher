UNWIND [{start: {_id:5369}, end: {_id:178}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", keywords:"collective action,unity", truncate:"", weight:1.0, description:"Emphasizes transitioning from individual to collective (\"we\") perspectives.", created_at:1779455746, source_id:"chunk-3a7068f2a209054e42abe5d72250029a"}}, {start: {_id:4020}, end: {_id:178}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", keywords:"interdependence,sustainability", truncate:"", weight:1.0, description:"Proposes creating equilibrium between societal and planetary needs.", created_at:1779455746, source_id:"chunk-3a7068f2a209054e42abe5d72250029a"}}, {start: {_id:5367}, end: {_id:1469}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", truncate:"", keywords:"global issue,resource allocation", weight:1.0, description:"War preparation costs are contrasted with the potential to end starvation, highlighting a resource allocation paradox.", created_at:1779455773, source_id:"chunk-e1d5e0073f33e1ee1857e1f6302d5b7f"}}, {start: {_id:5346}, end: {_id:5373}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)<SEP>YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", truncate:"", keywords:"cause,instigation,origin", weight:3.0, description:"The text posits that wars originate from the \"mental infection of violence\" within human psychology.<SEP>Wars are caused by the mental infection of violence, which has been present for 70,000 years.<SEP>Wars are instigated by the internal mental infection of violence.", created_at:1779519946, source_id:"chunk-e1d5e0073f33e1ee1857e1f6302d5b7f<SEP>chunk-60af06a20529afe356c9b2c29e286a87"}}, {start: {_id:5356}, end: {_id:1469}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)<SEP>YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", truncate:"", keywords:"contrast,global issue,resource allocation", weight:2.0, description:"Less than one percent of war preparation funds could address global drinking water challenges, per the text.<SEP>War spending contrasts sharply with the minimal investment needed to solve global water crises.", created_at:1779519902, source_id:"chunk-e1d5e0073f33e1ee1857e1f6302d5b7f<SEP>chunk-ab90f4a2ea15bf468182f88153f57ef6"}}, {start: {_id:752}, end: {_id:5346}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", keywords:"parallel,transmission", truncate:"", weight:1.0, description:"The infection spreads both across generations and parallelly between communities, per the text.", created_at:1779455773, source_id:"chunk-e1d5e0073f33e1ee1857e1f6302d5b7f"}}, {start: {_id:1949}, end: {_id:5346}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", keywords:"generational,transmission", truncate:"", weight:1.0, description:"The mental infection of violence is transmitted across generations, perpetuating the cycle of violence.", created_at:1779455774, source_id:"chunk-e1d5e0073f33e1ee1857e1f6302d5b7f"}}, {start: {_id:752}, end: {_id:3271}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", truncate:"", keywords:"behavioral impact,social dynamics", weight:1.0, description:"Violence within individuals influences community interactions and perpetuates conflict cycles.", created_at:1779455774, source_id:"chunk-e1d5e0073f33e1ee1857e1f6302d5b7f"}}, {start: {_id:5374}, end: {_id:17}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", truncate:"", keywords:"champion for peace,participation", weight:1.0, description:"Krishnaji participates in the gathering as a champion for peace and humanity.", created_at:1779455816, source_id:"chunk-00b63395d5ef5274c1baeb0f4e99541f"}}, {start: {_id:2582}, end: {_id:5375}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", truncate:"", keywords:"infection,threat", weight:1.0, description:"COVID is a threat that requires spiritual awakening and conquest.", created_at:1779455816, source_id:"chunk-00b63395d5ef5274c1baeb0f4e99541f"}}, {start: {_id:5374}, end: {_id:62}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", truncate:"", keywords:"champion for peace,participation", weight:1.0, description:"Preethaji participates in the gathering as a champion for peace and humanity.", created_at:1779455816, source_id:"chunk-00b63395d5ef5274c1baeb0f4e99541f"}}, {start: {_id:430}, end: {_id:5376}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", truncate:"", keywords:"content,message", weight:1.0, description:"The video discusses childhood as purity of soul and heart, linking it to inner solutions.", created_at:1779455921, source_id:"chunk-a1a3adb6e659bbb8209f01781e8bec78"}}, {start: {_id:4973}, end: {_id:5376}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", truncate:"", keywords:"content,theme", weight:1.0, description:"The video emphasizes that solutions are born within individuals, not external.", created_at:1779455921, source_id:"chunk-a1a3adb6e659bbb8209f01781e8bec78"}}, {start: {_id:755}, end: {_id:5376}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", truncate:"", keywords:"content,goal", weight:1.0, description:"The video advocates for peace through collective \"we\" beyond individualism.", created_at:1779455921, source_id:"chunk-a1a3adb6e659bbb8209f01781e8bec78"}}, {start: {_id:5368}, end: {_id:5376}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", truncate:"", keywords:"concept,content", weight:1.0, description:"The video introduces the concept of equilibrium between self, society, and planet.", created_at:1779455921, source_id:"chunk-a1a3adb6e659bbb8209f01781e8bec78"}}, {start: {_id:62}, end: {_id:5376}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", keywords:"content creator,speaker", truncate:"", weight:1.0, description:"Preethaji is associated with the video's message as a speaker.", created_at:1779455922, source_id:"chunk-a1a3adb6e659bbb8209f01781e8bec78"}}, {start: {_id:5377}, end: {_id:5376}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", truncate:"", keywords:"content,message", weight:1.0, description:"The video emphasizes purity of soul as a key aspect of childhood.", created_at:1779455922, source_id:"chunk-a1a3adb6e659bbb8209f01781e8bec78"}}, {start: {_id:5378}, end: {_id:5376}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", truncate:"", keywords:"content,message", weight:1.0, description:"The video highlights purity of heart in the context of childhood.", created_at:1779455922, source_id:"chunk-a1a3adb6e659bbb8209f01781e8bec78"}}, {start: {_id:5379}, end: {_id:5376}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", truncate:"", keywords:"action,content", weight:1.0, description:"The video suggests making an unknown child smile as an action.", created_at:1779455922, source_id:"chunk-a1a3adb6e659bbb8209f01781e8bec78"}}, {start: {_id:5382}, end: {_id:5383}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", keywords:"capitalization,terminology", truncate:"", weight:1.0, description:"\"Limitless Field\" in the text requires capitalization for proper terminology alignment.", created_at:1779510749, source_id:"