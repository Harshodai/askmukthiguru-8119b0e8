UNWIND [{start: {_id:1473}, end: {_id:7611}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"avoidance,empathy", weight:2.0, description:"Transformed consciousness replaces judgment with support, moving beyond analysis to physical and emotional support.<SEP>Transformed consciousness replaces judgment with support, moving beyond analysis to physical and emotional support.", created_at:1779669328, source_id:"chunk-4f083f509b73a704942cae198b15e4c6"}}, {start: {_id:7584}, end: {_id:5621}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"interconnectedness,transformation", weight:2.0, description:"An expanded sense of self leads to impacting others through empathy and understanding.<SEP>An expanded sense of self leads to impacting others through empathy and understanding.", created_at:1779669355, source_id:"chunk-4f083f509b73a704942cae198b15e4c6"}}, {start: {_id:4615}, end: {_id:5621}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"expansion,inclusion", truncate:"", weight:1.0, description:"Expanded sense of self includes others, fostering care and transformation.", created_at:1779669356, source_id:"chunk-fb3062b3d6881522fcc2387d435da879"}}, {start: {_id:5621}, end: {_id:7622}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"inclusion,transformation", truncate:"", weight:1.0, description:"Expanded sense of self includes others, fostering care and transformation through direct support.", created_at:1779669356, source_id:"chunk-fb3062b3d6881522fcc2387d435da879"}}, {start: {_id:7587}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"conceptual framework,content source", weight:1.0, description:"The video explores the expansion of self-perception beyond physical boundaries.", created_at:1779669399, source_id:"chunk-7aa2539edad7b667d56ec7a44037cb45"}}, {start: {_id:5800}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"content source,ethical emphasis", weight:1.0, description:"The video positions caring as foundational to human connection and mutual growth.", created_at:1779669399, source_id:"chunk-7aa2539edad7b667d56ec7a44037cb45"}}, {start: {_id:7584}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"content source,relational dynamic", weight:1.0, description:"The video frames human interaction as inherently impactful and reciprocal.", created_at:1779669399, source_id:"chunk-7aa2539edad7b667d56ec7a44037cb45"}}, {start: {_id:7585}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"content source,philosophical implication", weight:1.0, description:"The video suggests that meaningful change in others stems from expanded self-awareness.", created_at:1779669400, source_id:"chunk-7aa2539edad7b667d56ec7a44037cb45"}}, {start: {_id:7587}, end: {_id:7585}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"philosophical basis,practical outcome", weight:1.0, description:"Self-expansion provides framework for understanding and effecting others' transformation.", created_at:1779669400, source_id:"chunk-7aa2539edad7b667d56ec7a44037cb45"}}, {start: {_id:5800}, end: {_id:7587}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"conceptual foundation,ethical action", weight:1.0, description:"Expanded self-perception enables caring for others as part of interconnected existence.", created_at:1779669400, source_id:"chunk-7aa2539edad7b667d56ec7a44037cb45"}}, {start: {_id:5800}, end: {_id:7585}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"ethical practice,transformative result", weight:1.0, description:"Caring actions directly contribute to others' personal and relational transformation.", created_at:1779669400, source_id:"chunk-7aa2539edad7b667d56ec7a44037cb45"}}, {start: {_id:2023}, end: {_id:852}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", keywords:"existential basis,existential concern,fear,universal fear", truncate:"", weight:2.0, description:"All fear is rooted in the fear of death, as stated in the text.<SEP>All fears are fundamentally rooted in the fear of death, as stated explicitly in the text.", created_at:1779671551, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400<SEP>chunk-4d4c85ceafd744808b1dcd571678ad02"}}, {start: {_id:2023}, end: {_id:7626}, properties:{file_path:"unknown_source", keywords:"existential impact,loss", truncate:"", weight:1.0, description:"Death is associated with the loss of a part of one's identity and memories.", created_at:1779669413, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400"}}, {start: {_id:2391}, end: {_id:852}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", keywords:"absence of fear,liberation,transcendence", truncate:"", weight:2.0, description:"Enlightenment is described as liberation from fear and transcending the fear of death.<SEP>Enlightenment is described as total liberation from fear, contrasting with mere fearlessness.", created_at:1779671552, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400<SEP>chunk-4d4c85ceafd744808b1dcd571678ad02"}}, {start: {_id:2023}, end: {_id:543}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=3weAVHuSCxg)", keywords:"dissolution,emotional consequences,emotional impact,metaphor", truncate:"", weight:2.0, description:"The breakup of a relationship is likened to experiencing death, as it feels like a loss of a part of oneself.<SEP>The death of a relationship triggers emotional states like regret and loneliness.", created_at:1779738031, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400<SEP>chunk-0bcd34bbf2440bb034ae1a5607edb427"}}, {start: {_id:2391}, end: {_id:287}, properties:{file_path:"unknown_source", keywords:"celebration,transcendence", truncate:"", weight:1.0, description:"Enlightenment involves celebrating every moment of life and transcending the fear of death.", created_at:1779669413, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400"}}, {start: {_id:2023}, end: {_id:7624}, properties:{file_path:"unknown_source", keywords:"emotional consequence,shame", truncate:"", weight:1.0, description:"Feeling shame is equated to the death of respectability, which is a form of death.", created_at:1779669414, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400"}}, {start: {_id:7629}, end: {_id:7630}, properties:{file_path:"unknown_source", keywords:"fundamental questions,grappling", truncate:"", weight:1.0, description:"The classical seeker grapples with fundamental questions.", created_at:1779669414, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400"}}, {start: {_id:7625}, end: {_id:2023}, properties:{file_path:"unknown_source", keywords:"historical pursuit,research", truncate:"", weight:1.0, description:"Ancient Health and Metallurgic Sciences in India conducted research on conquering death.", created_at:1779669414, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400"}}, {start: {_id:2391}, end: {_id:1301}, properties:{file_path:"unknown_source", keywords:"perception,qualities", truncate:"", weight:2.0, description:"Enlightenment is for those who are intelligent and perceptive.", created_at:1779669414, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
