UNWIND [{start: {_id:4020}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: pTnZt0SqDFM (URL: https://www.youtube.com/watch?v=pTnZt0SqDFM)", truncate:"", keywords:"disease,division", weight:1.0, description:"The planet's diseased state is caused by individual suffering and separation.", created_at:1779399612, source_id:"chunk-1a7e64bb8a0d59d10204b5dfcccfe785"}}, {start: {_id:4653}, end: {name:"Dharma"}, properties:{file_path:"unknown_source<SEP>YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", keywords:"Dharma,ethical mission,personal philosophy,practice,societal impact,wisdom sharing", truncate:"", weight:3.0, created_at:1779404264, description:"Craig's Dharma involves disseminating ancient wisdom to foster global peace and transformation.<SEP>Craig practices Dharma by disseminating ancient wisdom for planetary peace.<SEP>Craig is living his Dharma of sharing wisdom with millions.", source_id:"chunk-3269918410ef2996ad74d621f6f6159f<SEP>chunk-e41aa29188359857d686593b398cb57d<SEP>chunk-e2e44adeb9e364c8a1e4597e2d7040b0"}}, {start: {_id:1474}, end: {name:"Samsara"}, properties:{file_path:"unknown_source", keywords:"liberation,truth realization", truncate:"", weight:1.0, description:"Awakening involves escaping Samsara's cycle to realize ultimate truth and unity.", created_at:1779403918, source_id:"chunk-3269918410ef2996ad74d621f6f6159f"}}, {start: {_id:1324}, end: {name:"Samsara"}, properties:{file_path:"unknown_source", keywords:"suffering,transcendence", truncate:"", weight:1.0, description:"Overcoming Samsara leads to Mukti, liberation from suffering and illusion.", created_at:1779403918, source_id:"chunk-3269918410ef2996ad74d621f6f6159f"}}, {start: {_id:1799}, end: {name:"Samsara"}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", truncate:"", keywords:"awakening,cycle", weight:1.0, description:"Humans must awaken from the cycle of Samsara to achieve peace.", created_at:1779404149, source_id:"chunk-a20fa03637522df32905bf3e04315780"}}, {start: {_id:4715}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"causation,psychological impact", truncate:"", weight:1.0, description:"Destructive tendencies in the mind cause suffering.", created_at:1779404784, source_id:"chunk-0b8200467f9ed7bc0b0109cef2c5f58c"}}, {start: {_id:4716}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"potential risk,proactive management", truncate:"", weight:1.0, description:"Future tendencies can cause suffering, requiring proactive management.", created_at:1779404784, source_id:"chunk-0b8200467f9ed7bc0b0109cef2c5f58c"}}, {start: {_id:1071}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: q15gR1aGjVs (URL: https://www.youtube.com/watch?v=q15gR1aGjVs)", truncate:"", keywords:"harmonization,natural restoration", weight:1.0, description:"Achieving oneness could synchronize human and Earth electromagnetic fields, restoring natural cycles and global harmony.", created_at:1779405655, source_id:"chunk-e1495814eef87b4611431212c4eeb855"}}, {start: {_id:4969}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"one mind in one heart,oneness", weight:1.0, description:"Oneness leads to one mind in one heart, and one mind in one heart is described as a state of unity.", created_at:1779420380, source_id:"chunk-7a50476fe3717f3e56d4d65eb5669d3f"}}, {start: {_id:2629}, end: {name:"Consciousness"}, properties:{file_path:"unknown_source<SEP>YouTube Video: tOi1Ho5Kwhk (URL: https://www.youtube.com/watch?v=tOi1Ho5Kwhk)<SEP>YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", keywords:"consciousness cultivation,event theme,external world,focus,holistic approach,inner transformation,involves,spiritual focus,spiritual practice", truncate:"", weight:6.0, description:"Focuses on external abundance while integrating inner consciousness work.<SEP>The festival also focuses on consciousness development as part of spiritual practices.<SEP>Festival integrates consciousness work as part of its spiritual framework.<SEP>Abundance Festival connects external world focus with inner consciousness development.<SEP>The Abundance Festival involves working on consciousness to address challenges.<SEP>Abundance Festival addresses challenges through Consciousness exploration.", created_at:1779433713, source_id:"chunk-ac12dffa6ce039201a2a2ead8652a28d<SEP>chunk-d1c28363f61d0804fe0da48af4c11dd4<SEP>chunk-c5f3bfe2a8c8ea1bf2d9597c128a1514<SEP>chunk-8ff5db384f4494f2be81335882ee46ae<SEP>chunk-498e1fd5e415407ac1ad5829d73bec9b<SEP>chunk-ad8cd9c49a16ec95450897f747dabecf"}}, {start: {_id:2629}, end: {name:"Ekam"}, properties:{file_path:"YouTube Video: tOi1Ho5Kwhk (URL: https://www.youtube.com/watch?v=tOi1Ho5Kwhk)", truncate:"", keywords:"domain-specific term,spiritual concept", weight:2.0, description:"The Abundance Festival references Ekam as a domain-specific term.<SEP>The Abundance Festival references Ekam.", created_at:1779429894, source_id:"chunk-8baf1265be404bc46eddc076192461b0"}}, {start: {_id:2629}, end: {name:"Deeksha"}, properties:{file_path:"YouTube Video: tOi1Ho5Kwhk (URL: https://www.youtube.com/watch?v=tOi1Ho5Kwhk)", truncate:"", keywords:"domain-specific term,spiritual practice", weight:2.0, description:"The Abundance Festival references Deeksha as a domain-specific term.<SEP>The Abundance Festival references Deeksha.", created_at:1779429894, source_id:"chunk-8baf1265be404bc46eddc076192461b0"}}, {start: {_id:5058}, end: {name:"Consciousness"}, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", truncate:"", keywords:"mitigate", weight:1.0, description:"Working on consciousness mitigates bad samsara.", created_at:1779433127, source_id:"chunk-498e1fd5e415407ac1ad5829d73bec9b"}}, {start: {_id:2629}, end: {name:"Samsara"}, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", truncate:"", keywords:"cause,focus", weight:1.0, description:"The Abundance Festival focuses on addressing bad samsara through consciousness and cleansing.", created_at:1779433127, source_id:"chunk-498e1fd5e415407ac1ad5829d73bec9b"}}, {start: {_id:157}, end: {name:"Samsara"}, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", truncate:"", keywords:"result", weight:1.0, description:"Bad samsara results in challenges that need to be addressed.", created_at:1779433128, source_id:"chunk-498e1fd5e415407ac1ad5829d73bec9b"}}, {start: {_id:5057}, end: {name:"Consciousness"}, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", truncate:"", keywords:"address", weight:1.0, description:"Consciousness addresses conflicts resulting from bad samsara.", created_at:1779433128, source_id:"chunk-498e1fd5e415407ac1ad5829d73bec9b"}}, {start: {_id:157}, end: {name:"Consciousness"}, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", truncate:"", keywords:"address", weight:1.0, description:"Consciousness addresses challenges resulting from bad samsara.", created_at:1779433128, source_id:"chunk-498e1fd5e415407ac1ad5829d73bec9b"}}, {start: {_id:5054}, end: {name:"Consciousness"}, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", truncate:"", keywords:"associated with,consciousness framework,intelligence,prosperity,transcendental realm,wealth aspects", weight:3.0, created_at:1779433296, description:"Buddhi relates consciousness to wealth-related outcomes.<SEP>Buddhi is where consciousness is open, linked to intelligence in wealth preservation.<SEP>Buddhi is described as the locus of open consciousness within a transcendental framework.", source_id:"chunk-83abb98046d1159250c7575ec257ce14<SEP>chunk-fb861a7ad5968de00a0781413686a72d<SEP>chunk-068119dd429404d7b660b1eacf50b8a7"}}, {start: {_id:4559}, end: {name:"Samsara"}, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", truncate:"", keywords:"philosophical concept,spiritual freedom", weight:1.0, description:"Samsara represents the cycle from which liberation is sought in the context of transcendental teachings.", created_at:1779433296, source_id:"chunk-068119dd429404d7b660b1eacf50b8a7"}}, {start: {_id:5081}, end: {name:"Samsara"}, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", truncate:"", keywords:"conceptual conflict,release", weight:1.0, description:"Ramya's liberation in Dasha involves overcoming samsara.", created_at:1779433402, source_id:"chunk-05876490ec07e753e9e70eaf93dbcac0"}}] AS row
