UNWIND [{start: {_id:4963}, end: {_id:4961}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"enlightenment,spiritual progression", weight:1.0, description:"The video links enlightenment experiences to awakening experiences as part of spiritual growth.", created_at:1779420283, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:4962}, end: {_id:4961}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"enlightenment,spiritual progression", weight:1.0, description:"The video links awakening experiences to enlightenment experiences as part of spiritual growth.", created_at:1779420283, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:4965}, end: {_id:4961}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"origin,spiritual concept", truncate:"", weight:1.0, description:"Pure love is described as the origin of humanity, pure and all-encompassing.", created_at:1779420283, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:4966}, end: {_id:4961}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"spiritual concept,state", truncate:"", weight:1.0, description:"Density is a state of separation from pure love, where senses deceive.", created_at:1779420283, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:852}, end: {_id:4961}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"emotion,spiritual concept", truncate:"", weight:1.0, description:"Fear is not the opposite of love but the separation from it.", created_at:1779420283, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:4967}, end: {_id:4961}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"emotion,spiritual concept", truncate:"", weight:1.0, description:"Pain and suffering are not the opposite of love but the separation from it.", created_at:1779420283, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:4968}, end: {_id:4961}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"emotion,spiritual concept", truncate:"", weight:1.0, description:"Anger, hostility, and violence are not the opposite of love but the separation from it.", created_at:1779420283, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:3050}, end: {_id:4961}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"emotion,spiritual concept", truncate:"", weight:1.0, description:"Prejudice is not the opposite of love but the separation from it.", created_at:1779420283, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:4969}, end: {_id:4961}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"outcome,spiritual goal", truncate:"", weight:1.0, description:"One mind in one heart is the desired outcome of moving closer to love.", created_at:1779420284, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:4961}, end: {_id:1451}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"origin,spiritual concept", truncate:"", weight:1.0, description:"Source is mentioned as the origin of humanity, synonymous with singularity and pure love.", created_at:1779420284, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:4961}, end: {_id:4970}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"origin,spiritual concept", truncate:"", weight:1.0, description:"Singularity is a concept mentioned as the origin of humanity, synonymous with pure love and zero point.", created_at:1779420284, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:4971}, end: {_id:4961}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"spiritual concept,state", truncate:"", weight:1.0, description:"Nation of separation is discussed as a state of being fooled by senses into separation.", created_at:1779420284, source_id:"chunk-a84002ccf9bfe2d1ba87d2c2ea84b743"}}, {start: {_id:4972}, end: {_id:4961}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"content inclusion,video content", weight:1.0, description:"The YouTube video includes the quote as part of its content.", created_at:1779420307, source_id:"chunk-7bd479153c285286517cbed7a414b233"}}, {start: {_id:852}, end: {_id:904}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"cause-effect,emotional manifestation,fear,love,separation", weight:3.0, created_at:1779420973, description:"Separation leads to fear, and fear is described as the separation from love.<SEP>Separation is characterized by the separation from love, leading to fear.<SEP>Fear arises from separation from love, not as love's direct opposite.", source_id:"chunk-7a50476fe3717f3e56d4d65eb5669d3f<SEP>chunk-4f108a1313b1da3a2fa234ff5f49d6e5<SEP>chunk-af881796b97d19f020179697b9daf675"}}, {start: {_id:4967}, end: {_id:904}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"cause-effect,emotional manifestation,pain and suffering,separation", weight:2.0, description:"Separation leads to pain and suffering, and pain and suffering are described as the separation from love.<SEP>Pain and suffering result from disconnection from love's unity.", created_at:1779420973, source_id:"chunk-7a50476fe3717f3e56d4d65eb5669d3f<SEP>chunk-af881796b97d19f020179697b9daf675"}}, {start: {_id:4962}, end: {_id:4969}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"awakening experience,one mind in one heart", weight:1.0, description:"Awakening experience leads to one mind in one heart, and one mind in one heart is described as a state of unity.", created_at:1779420380, source_id:"chunk-7a50476fe3717f3e56d4d65eb5669d3f"}}, {start: {_id:4968}, end: {_id:904}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"anger and hostility and violence,separation", weight:1.0, description:"Separation leads to anger, hostility, and violence, and these are described as the separation from love.", created_at:1779420381, source_id:"chunk-7a50476fe3717f3e56d4d65eb5669d3f"}}, {start: {_id:4963}, end: {_id:4969}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"enlightenment experience,one mind in one heart", weight:1.0, description:"Enlightenment experience leads to one mind in one heart, and one mind in one heart is described as a state of unity.", created_at:1779420381, source_id:"chunk-7a50476fe3717f3e56d4d65eb5669d3f"}}, {start: {_id:3050}, end: {_id:904}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"cause-effect,emotional manifestation,prejudice,separation", weight:2.0, description:"Separation leads to prejudice, and prejudice is described as the separation from love.<SEP>Prejudice arises from separation's judgmental framework.", created_at:1779420973, source_id:"chunk-7a50476fe3717f3e56d4d65eb5669d3f<SEP>chunk-af881796b97d19f020179697b9daf675"}}, {start: {_id:4050}, end: {_id:2275}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"error,potential", weight:1.0, description:"The text may have a missing period at the end of the last sentence.", created_at:1779420426, source_id:"chunk-75cd94439105286110a38283159573c6"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
