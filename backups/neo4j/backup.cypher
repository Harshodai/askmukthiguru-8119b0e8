UNWIND [{start: {_id:4579}, end: {_id:2668}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"enables,sustains", weight:1.0, description:"The beautiful state enables and sustains willpower.", created_at:1779653882, source_id:"chunk-87ae4401ec344e0f145a40afa02041af"}}, {start: {_id:4579}, end: {_id:157}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"causes,prevents", weight:1.0, description:"The absence of a beautiful state leads to challenges.", created_at:1779653882, source_id:"chunk-87ae4401ec344e0f145a40afa02041af"}}, {start: {_id:4579}, end: {_id:449}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"causes,prevents", weight:1.0, description:"The absence of a beautiful state leads to relationship issues.", created_at:1779653882, source_id:"chunk-87ae4401ec344e0f145a40afa02041af"}}, {start: {_id:7035}, end: {_id:2668}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"collapses without", weight:2.0, description:"Without a beautiful state, drive and willpower collapse.<SEP>Without a beautiful state, willpower and drive collapse.", created_at:1779653882, source_id:"chunk-87ae4401ec344e0f145a40afa02041af"}}, {start: {_id:157}, end: {_id:449}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"arise from", weight:1.0, description:"Challenges and relationships arise from the absence of a beautiful state.", created_at:1779653882, source_id:"chunk-87ae4401ec344e0f145a40afa02041af"}}, {start: {_id:4579}, end: {_id:309}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"includes", weight:1.0, description:"The beautiful state includes passion.", created_at:1779653882, source_id:"chunk-87ae4401ec344e0f145a40afa02041af"}}, {start: {_id:2081}, end: {_id:2668}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"leads to", weight:1.0, description:"Decisions from a beautiful state lead to powerful will.", created_at:1779653882, source_id:"chunk-87ae4401ec344e0f145a40afa02041af"}}, {start: {_id:4579}, end: {_id:299}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"includes", weight:1.0, created_at:1779653883, description:"The beautiful state includes love.", source_id:"chunk-87ae4401ec344e0f145a40afa02041af"}}, {start: {_id:4579}, end: {_id:755}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"includes", weight:1.0, created_at:1779653883, description:"The beautiful state includes peace.", source_id:"chunk-87ae4401ec344e0f145a40afa02041af"}}, {start: {_id:4579}, end: {_id:2081}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"drives,informs", weight:1.0, description:"Decisions made from a beautiful state drive willpower.", created_at:1779653883, source_id:"chunk-87ae4401ec344e0f145a40afa02041af"}}, {start: {_id:7042}, end: {_id:7065}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"leads to", weight:1.0, description:"Weak will and absence of a beautiful state lead to quitting.", created_at:1779653883, source_id:"chunk-87ae4401ec344e0f145a40afa02041af"}}, {start: {_id:4579}, end: {_id:501}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", keywords:"enables,leads to", truncate:"", weight:2.0, description:"Living in a beautiful state leads to success.<SEP>Living in a beautiful state enables success.", created_at:1779653883, source_id:"chunk-87ae4401ec344e0f145a40afa02041af"}}, {start: {_id:4579}, end: {_id:7064}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", keywords:"enables,leads to", truncate:"", weight:2.0, description:"Living in a beautiful state leads to fulfillment.<SEP>The beautiful state enables fulfillment.", created_at:1779653883, source_id:"chunk-87ae4401ec344e0f145a40afa02041af"}}, {start: {_id:157}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", keywords:"motivation,perseverance", truncate:"", weight:1.0, description:"The video emphasizes overcoming challenges as essential to achieving success and fulfillment.", created_at:1779653995, source_id:"chunk-55dc4edcd2b102395a856543b6549ab5"}}, {start: {_id:4280}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"community impact,personal growth", weight:1.0, description:"The video links perseverance to achieving success and fulfillment for oneself and others.", created_at:1779653995, source_id:"chunk-55dc4edcd2b102395a856543b6549ab5"}}, {start: {_id:449}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"interpersonal dynamics,resilience", weight:1.0, description:"The video notes that relationships require resilience and perseverance during challenges.", created_at:1779653995, source_id:"chunk-55dc4edcd2b102395a856543b6549ab5"}}, {start: {_id:7067}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", keywords:"consequences,metaphor", truncate:"", weight:1.0, description:"The video uses the metaphor to illustrate the consequences of not persevering through difficulties.", created_at:1779653995, source_id:"chunk-55dc4edcd2b102395a856543b6549ab5"}}, {start: {_id:7066}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"career guidance,perseverance", weight:1.0, description:"The video discusses choosing the right field and the perseverance needed to stay committed to it.", created_at:1779653995, source_id:"chunk-55dc4edcd2b102395a856543b6549ab5"}}, {start: {_id:7068}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", keywords:"core theme,motivation", truncate:"", weight:1.0, description:"The video centers on perseverance as the key to overcoming challenges and achieving fulfillment.", created_at:1779653996, source_id:"chunk-55dc4edcd2b102395a856543b6549ab5"}}, {start: {_id:499}, end: {_id:294}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"emotional strain,work-related pressure", weight:1.0, description:"Stress is directly linked to the pressures of work, contributing to the individual's desire to quit.", created_at:1779654059, source_id:"chunk-20d895bd21d3a068503f3d99fc9f225c"}}] AS row
