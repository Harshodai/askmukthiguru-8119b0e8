UNWIND [{start: {_id:659}, end: {_id:646}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"behavioral influence,comparison", truncate:"", weight:1.0, description:"Beth's comparison with siblings drives her Destructive Self, which contributes to the inner war.", created_at:1779139067, source_id:"chunk-3c5cad218c7d45700a257c9263d28c19"}}, {start: {_id:660}, end: {_id:655}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"comparison,conflict component", truncate:"", weight:1.0, description:"Life as a War includes the Inert Self as a component of the inner war.", created_at:1779139067, source_id:"chunk-3c5cad218c7d45700a257c9263d28c19"}}, {start: {_id:659}, end: {_id:661}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"comparison,relationship outcome", truncate:"", weight:2.0, description:"Unhealthy Relationships are a result of Beth's inner war, where she makes enemies of friends and family.<SEP>Beth's inner war leads to unhealthy relationships as she makes enemies of friends and family.", created_at:1779139067, source_id:"chunk-3c5cad218c7d45700a257c9263d28c19"}}, {start: {_id:659}, end: {_id:657}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"behavioral pattern,comparison", truncate:"", weight:2.0, description:"Beth's inner war results in a vicious cycle of overeating, inactivity, and poor financial decisions.<SEP>Vicious Cycle is a behavioral pattern in Beth's life, resulting from her inner war.", created_at:1779139067, source_id:"chunk-3c5cad218c7d45700a257c9263d28c19"}}, {start: {_id:659}, end: {_id:660}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"comparison,overarching theme", truncate:"", weight:1.0, description:"Life as a War is the overarching theme of Beth's inner conflict, where she compares herself to others.", created_at:1779139067, source_id:"chunk-3c5cad218c7d45700a257c9263d28c19"}}, {start: {_id:646}, end: {_id:666}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cultural change,self-transcendence", truncate:"", weight:1.0, description:"Attempting to change behavior, culture, or language to transcend the destructive self.", created_at:1779139093, source_id:"chunk-0b07ef4dcf56fe79aaec78af52489ef5"}}, {start: {_id:664}, end: {_id:662}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"hopelessness,motivation", truncate:"", weight:1.0, description:"The inert self leads to giving up hope that positive outcomes will occur.", created_at:1779139093, source_id:"chunk-0b07ef4dcf56fe79aaec78af52489ef5"}}, {start: {_id:665}, end: {_id:642}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"competition,self-esteem", truncate:"", weight:1.0, description:"The shrinking self experiences life as a race due to constant comparison.", created_at:1779139093, source_id:"chunk-0b07ef4dcf56fe79aaec78af52489ef5"}}, {start: {_id:663}, end: {_id:662}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"external validation,self-esteem", truncate:"", weight:1.0, description:"Engaging in adventure sports to project a better self-image, though it may increase inner conflict.", created_at:1779139093, source_id:"chunk-0b07ef4dcf56fe79aaec78af52489ef5"}}, {start: {_id:646}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"document content,psychological concept", weight:1.0, description:"The document discusses the destructive self as a key theme in self-transformation.", created_at:1779139121, source_id:"chunk-48d38d40b501a5ac9741fdde5e643c26"}}, {start: {_id:669}, end: {_id:672}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"intellectual challenge,ruler", truncate:"", weight:1.0, description:"Akbar posed the challenge to his ministers as part of his intellectually stimulating governance.", created_at:1779139122, source_id:"chunk-48d38d40b501a5ac9741fdde5e643c26"}}, {start: {_id:673}, end: {_id:670}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"reactive behavior,stagnation", truncate:"", weight:1.0, description:"Inertia drives desperate actions like gym visits or detox without addressing root causes.", created_at:1779139122, source_id:"chunk-48d38d40b501a5ac9741fdde5e643c26"}}, {start: {_id:667}, end: {_id:672}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"participant,problem-solving", truncate:"", weight:1.0, description:"Birbal engaged with Akbar's challenge to identify the biggest fool in the kingdom.", created_at:1779139122, source_id:"chunk-48d38d40b501a5ac9741fdde5e643c26"}}, {start: {_id:646}, end: {_id:588}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"psychological state,self-perception", truncate:"", weight:1.0, description:"The destructive self perpetuates inner division through self-sabotage.", created_at:1779139122, source_id:"chunk-48d38d40b501a5ac9741fdde5e643c26"}}, {start: {_id:671}, end: {_id:672}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"challenge focus,concept", truncate:"", weight:1.0, description:"The biggest fool was the central concept of Akbar's intellectual challenge to his ministers.", created_at:1779139122, source_id:"chunk-48d38d40b501a5ac9741fdde5e643c26"}}, {start: {_id:676}, end: {_id:679}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"location,search", truncate:"", weight:1.0, description:"The old man was searching for the lost key, which was found in a dark corner far from where he was initially searching.", created_at:1779139161, source_id:"chunk-b66d4da8c241088f7962f1c7ffd83fd6"}}, {start: {_id:667}, end: {_id:677}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"challenge,task assignment", truncate:"", weight:1.0, description:"The emperor assigned Birbal the task of finding the biggest fool in the kingdom, which Birbal completed successfully.", created_at:1779139161, source_id:"chunk-b66d4da8c241088f7962f1c7ffd83fd6"}}, {start: {_id:675}, end: {_id:21}, properties:{file_path: