, created_at:1779138343, source_id:"chunk-8a04f21972a9b754834645505ed6ec02"}}, {start: {_id:532}, end: {_id:522}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"human experience,sacred aspect", truncate:"", weight:1.0, description:"Transcendental images represent the sacred side of human experience.", created_at:1779138343, source_id:"chunk-8a04f21972a9b754834645505ed6ec02"}}, {start: {_id:521}, end: {_id:530}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"cultural contrast,ordinary representation", weight:1.0, description:"The temple includes everyday scenes like cattle grazing and maternal care.", created_at:1779138343, source_id:"chunk-8a04f21972a9b754834645505ed6ec02"}}, {start: {_id:531}, end: {_id:530}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cultural paradox,emotional duality", truncate:"", weight:1.0, description:"The temple displays provocative postures alongside sacred themes.", created_at:1779138344, source_id:"chunk-8a04f21972a9b754834645505ed6ec02"}}, {start: {_id:529}, end: {_id:530}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"cultural juxtaposition,negative symbolism", weight:1.0, description:"The temple depicts demons to represent anger and negativity.", created_at:1779138344, source_id:"chunk-8a04f21972a9b754834645505ed6ec02"}}, {start: {_id:530}, end: {_id:532}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"cultural synthesis,philosophical concept", weight:1.0, description:"The temple embodies the totality of human experience through mixed imagery.", created_at:1779138344, source_id:"chunk-8a04f21972a9b754834645505ed6ec02"}}, {start: {_id:225}, end: {_id:537}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"educational setting,event hosting", truncate:"", weight:1.0, description:"The academy hosts the course where the Q&A session takes place, establishing its role in the narrative.", created_at:1779138389, source_id:"chunk-b6f27d31a498b77b0b04616019c42b1a"}}, {start: {_id:535}, end: {_id:506}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional state,psychological impact", truncate:"", weight:1.0, description:"Self-obsession is linked to the participant's initial focus on changing his girlfriend rather than addressing his own narrow perspective.", created_at:1779138389, source_id:"chunk-b6f27d31a498b77b0b04616019c42b1a"}}, {start: {_id:535}, end: {_id:538}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"adventurous activities,courage", truncate:"", weight:1.0, description:"The participant's engagement in spelunking demonstrates his fear-confronting and courageous nature.", created_at:1779138389, source_id:"chunk-b6f27d31a498b77b0b04616019c42b1a"}}] AS row
