UNWIND [{start: {_id:337}, end: {_id:346}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"growth,symbolism", truncate:"", weight:1.0, description:"The river's flow presents chances for emotional connection and expansion.", created_at:1779137257, source_id:"chunk-e88f2f26245ad8ca0468808d9150fa60"}}, {start: {_id:337}, end: {_id:347}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"growth,symbolism", truncate:"", weight:1.0, description:"The river's flow presents chances for emotional connection and expansion.", created_at:1779137257, source_id:"chunk-e88f2f26245ad8ca0468808d9150fa60"}}, {start: {_id:350}, end: {_id:338}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"contrast,contrasting states,emotional transformation,existential states", truncate:"", weight:2.0, description:"The Happy Child and Wounded Child represent contrasting emotional and psychological states of being, coexisting within individuals despite temporal separation.<SEP>The Wounded Child and Happy Child represent conflicting internal states; reconnecting with the Happy Child fosters healing.", created_at:1779179149, source_id:"chunk-41b3a29187ba0c1a38ac4f058b4fd20f<SEP>chunk-b75e52bdeada1ddd1aebcff0a658afb0"}}, {start: {_id:352}, end: {_id:348}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=CQEGJ0OaIPo)", keywords:"content subject,cultural symbolism,maternal relationship,participation", truncate:"", weight:2.0, description:"The mother is a participant in the YouTube video, engaging in a conversation about love and cookies with her son.<SEP>The video discusses the mother's role and her impact on a child's life, emphasizing her divine and nurturing qualities.", created_at:1779687982, source_id:"chunk-41b3a29187ba0c1a38ac4f058b4fd20f<SEP>chunk-b99209818242fa366169c6ab46e01f5f"}}, {start: {_id:338}, end: {_id:353}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional state", truncate:"", weight:1.0, description:"The Wounded Child represents a state of suffering and self-centric misery, contrasting with the Happy Child's joyful existence.", created_at:1779137308, source_id:"chunk-41b3a29187ba0c1a38ac4f058b4fd20f"}}, {start: {_id:348}, end: {_id:349}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"content subject,participation", truncate:"", weight:1.0, description:"The young boy is a participant in the YouTube video, engaging in a dialogue about love and cookies with his mother.", created_at:1779137308, source_id:"chunk-41b3a29187ba0c1a38ac4f058b4fd20f"}}, {start: {_id:351}, end: {_id:348}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"engagement,popularity", truncate:"", weight:1.0, description:"The YouTube video's high view count reflects its significant impact and audience engagement.", created_at:1779137308, source_id:"chunk-41b3a29187ba0c1a38ac4f058b4fd20f"}}, {start: {_id:355}, end: {_id:360}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional struggle,shame", truncate:"", weight:1.0, description:"The child feels ashamed of his feelings due to societal pressures and parental comparisons.", created_at:1779137383, source_id:"chunk-3f368851bf5ddb2f8eff6b6b68ee073b"}}, {start: {_id:357}, end: {_id:356}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"birth,death,parent-child", truncate:"", weight:2.0, description:"The lioness delivers the cub and dies shortly after, leaving the cub orphaned.<SEP>The lioness gave birth to the lion cub and died shortly after.", created_at:1779179148, source_id:"chunk-3f368851bf5ddb2f8eff6b6b68ee073b<SEP>chunk-d4fb27ed500b1a960390eadd6d011176"}}, {start: {_id:133}, end: {_id:361}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"narrative,wisdom", truncate:"", weight:1.0, description:"The Upanishads contain the fable about the lion cub to illustrate deeper truths.", created_at:1779137383, source_id:"chunk-3f368851bf5ddb2f8eff6b6b68ee073b"}}, {start: {_id:357}, end: {_id:359}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"adoption,assumption,guidance,identity conflict,influence,nurturing,parental guidance,question,questioning,sheltering,societal norms", truncate:"", weight:6.0, created_at:1779183763, description:"The mother sheep assumes the lion cub is her offspring and shelters him.<SEP>The lion cub asks the mother sheep about roaring, and she explains his role as a sheep.<SEP>The mother sheep tells the lion cub to stop fantasizing, shaping his initial behavior and self-doubt.<SEP>The lion cub questioned the mother sheep about his identity and roaring ability.<SEP>The mother sheep adopted and raised the lion cub as her own.<SEP>The lion cub?s upbringing by the mother sheep creates an identity crisis and internal struggle.`", source_id:"chunk-3f368851bf5ddb2f8eff6b6b68ee073b<SEP>chunk-fe2967cbd738ae1882767972220f2846<SEP>chunk-345cde2de9df7f9434b23cd5a304db8f<SEP>chunk-d4fb27ed500b1a960390eadd6d011176<SEP>chunk-6b077b95a5e468c5e42f57a37944c07d"}}, {start: {_id:360}, end: {_id:39}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"contrast,innocence", truncate:"", weight:1.0, description:"The fable contrasts the child's later dissatisfaction with the joy of innocence.", created_at:1779137383, source_id:"chunk-3f368851bf5ddb2f8eff6b6b68ee073b"}}, {start: {_id:358}, end: {_id:357}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"identity,upbringing", truncate:"", weight:1.0, description:"The lion cub grows up among the sheep and adopts their behaviors, believing he is one of them.", created_at:1779137384, source_id:"chunk-3f368851bf5ddb2f8eff6b6b68ee073b"}}, {start: {_id:357}, end: {_id:362}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"inability,nature", truncate:"", weight:1.0, description:"The lion cub struggles to fit in with the sheep due to his true nature as a lion.", created_at:1779137384, source_id:"chunk-3f368851bf5ddb2f8eff6b6b68ee073b"}}, {start: {_id:357}, end: {_id:365}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"identity conflict,upbringing", truncate:"", weight:1.0, description:"The lion cub is raised among sheep, leading to confusion about his true nature.", created_at:1779137399, source_id:"chunk-fe2967cbd738ae1882767972220f2846"}}, {start: {_id:364}, end: {_id:357}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"aspiration,inspiration", truncate:"", weight:1.0, description:"The lion's roar inspires the lion cub to desire a different identity.", created_at:1779137399, source_id:"chunk-fe2967cbd738ae1882767972220f2846"}}, {start: {_id:364}, end: {_id:359}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"hierarchy,reality", truncate:"", weight:1.0, description:"The mother sheep emphasizes the lion's status as king and the sheep's subservient role.", created_at:1779137400, source_id:"chunk-fe2967cbd738ae1882767972220f2846"}}, {start: {_id:363}, end: {_id:357}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"behavioral limitation,identity conflict", weight:1.0, description:"The lion cub's struggle to graze properly underscores his inability to fully embrace his sheep upbringing.", created_at:1779137400, source_id:"chunk-fe2967cbd738ae1882767972220f2846"}}, {start: {_id:363}, end: {_id:359}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"criticism,guidance", truncate:"", weight:1.0, description:"The mother sheep highlights the lion cub's grazing inadequacy as evidence of his unsuitability for sheep life.", created_at:1779137400, source_id:"chunk-fe2967cbd738ae1882767972220f2846"}}, {start: {_id:367}, end: {_id:369}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"formative influence,relational dynamics", weight:1.0, description:"Emotional experiences in parental relationships are foundational to shaping love, rejection, and social behavior patterns.", created_at:1779137427, source_id:"chunk-391c88f34f518d5844e754bc2fc76c03"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
