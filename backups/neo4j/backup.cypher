editations"}}, {_id:2190, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Q4QyNologtw)", entity_type:"organization", truncate:"", description:"A structured program designed to help young people discover their purpose and overcome personal challenges.", created_at:1779158797, source_id:"chunk-f02bf32393ef9705110f96bbc12d8064", entity_id:"Youth Course"}}, {_id:2191, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Q4QyNologtw)", entity_type:"organization", truncate:"", description:"An advanced phase of the youth program where the student gained clarity about his career path.", created_at:1779158797, source_id:"chunk-f02bf32393ef9705110f96bbc12d8064", entity_id:"Next Stage of Youth Program"}}, {_id:2192, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", entity_type:"concept", truncate:"", description:"The inner critic represents self-judgment and negative self-talk that creates internal conflict.", created_at:1779220992, source_id:"chunk-a5d16b7b208928b7a3800de53c2fa4eb", entity_id:"Inner Critic"}}, {_id:2193, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Q4QyNologtw)", entity_type:"UNKNOWN", truncate:"", description:"Swadharma emphasizes love and passion as essential for overcoming obstacles and achieving fulfillment.", created_at:1779158824, source_id:"chunk-f02bf32393ef9705110f96bbc12d8064", entity_id:"Love and Passion"}}, {_id:2194, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)", entity_type:"UNKNOWN", truncate:"", description:"Observing one's inner state leads to a calm and balanced emotional state.", created_at:1779221016, source_id:"chunk-a5d16b7b208928b7a3800de53c2fa4eb", entity_id:"Self-Observation"}}, {_id:2195, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Q4QyNologtw)", entity_type:"concept", truncate:"", descripti