UNWIND [{start: {_id:1883}, end: {_id:5280}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", truncate:"", keywords:"content analysis,error identification", weight:1.0, description:"Video contains text with transcription errors requiring correction.", created_at:1779447326, source_id:"chunk-390580a8c4bf54c69179d629a432021f"}}, {start: {_id:65}, end: {_id:5277}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", truncate:"", keywords:"negative impact,psychological effect", weight:1.0, description:"A disconnected person's state leads to self-destruction and harmful outcomes.", created_at:1779447486, source_id:"chunk-e27c90d3f030c932363441c1ed78bf62"}}, {start: {_id:5284}, end: {_id:348}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", keywords:"audience,message source", truncate:"", weight:1.0, description:"The YouTube video contains a message addressed to the leaders of this world.", created_at:1779447529, source_id:"chunk-19ac6161864512557b2b640d349a424f"}}, {start: {_id:5284}, end: {_id:5283}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", keywords:"identity,leadership", truncate:"", weight:1.0, description:"The leaders of this world are identified as the next generation leaders.", created_at:1779447529, source_id:"chunk-19ac6161864512557b2b640d349a424f"}}, {start: {_id:5284}, end: {_id:4498}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", keywords:"leadership domain,scope", truncate:"", weight:1.0, description:"The leaders of this world are instructed to lead in politics.", created_at:1779447529, source_id:"chunk-19ac6161864512557b2b640d349a424f"}}, {start: {_id:44}, end: {_id:5284}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", keywords:"leadership domain,scope", truncate:"", weight:1.0, description:"The leaders of this world are instructed to lead in business.", created_at:1779447529, source_id:"chunk-19ac6161864512557b2b640d349a424f"}}, {start: {_id:5284}, end: {_id:2390}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", keywords:"leadership domain,scope", truncate:"", weight:1.0, description:"The leaders of this world are instructed to lead in spirituality.", created_at:1779447530, source_id:"chunk-19ac6161864512557b2b640d349a424f"}}, {start: {_id:5284}, end: {_id:5276}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", keywords:"leadership domain,scope", truncate:"", weight:1.0, description:"The leaders of this world are instructed to lead in social work.", created_at:1779447530, source_id:"chunk-19ac6161864512557b2b640d349a424f"}}, {start: {_id:2598}, end: {_id:930}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", keywords:"consequence,dissatisfaction", truncate:"", weight:1.0, description:"Youth's dissatisfaction and inability to handle emotions lead to the development of addictions as a coping mechanism.", created_at:1779447637, source_id:"chunk-fafff025e01a29bbcee9969fc4559382"}}, {start: {_id:5285}, end: {_id:657}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", keywords:"existential impact,loss", truncate:"", weight:1.0, description:"The vicious cycle of addictions results in the loss of meaning and purpose in life for the individual.", created_at:1779447637, source_id:"chunk-fafff025e01a29bbcee9969fc4559382"}}, {start: {_id:951}, end: {_id:930}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", keywords:"consequence,dissatisfaction", truncate:"", weight:1.0, description:"Youth's dissatisfaction leads to emotional or physical hurt as a direct consequence of their disconnected consciousness.", created_at:1779447637, source_id:"chunk-fafff025e01a29bbcee9969fc4559382"}}, {start: {_id:4515}, end: {_id:930}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", truncate:"", keywords:"initial reaction,temporary effect", weight:1.0, description:"Youth initially experiences a surge of energy from frustration, which is temporary and unsustainable.", created_at:1779447637, source_id:"chunk-fafff025e01a29bbcee9969fc4559382"}}, {start: {_id:65}, end: {_id:951}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", truncate:"", keywords:"outcome,progressive effect", weight:1.0, description:"Hurt acts as a transitional state that progresses toward self-destruction.", created_at:1779447637, source_id:"chunk-fafff025e01a29bbcee9969fc4559382"}}, {start: {_id:2598}, end: {_id:4515}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", keywords:"driving factor,transition", truncate:"", weight:1.0, description:"The initial energy driven by frustration transitions into addictive behaviors as it depletes.", created_at:1779447638, source_id:"chunk-fafff025e01a29bbcee9969fc4559382"}}, {start: {_id:1395}, end: {_id:4498}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", keywords:"domain,governance,leadership", truncate:"", weight:1.0, description:"The speech mentions that leaders will operate in the domain of politics.", created_at:1779447742, source_id:"chunk-18bc78e6744f00b7477a42dba8a8367d"}}, {start: {_id:44}, end: {_id:1395}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", keywords:"commerce,domain,leadership", truncate:"", weight:1.0, description:"The speech states that leaders will be active in the business sector.", created_at:1779447742, source_id:"c