UNWIND [{start: {_id:8194}, end: {_id:1401}, properties:{file_path:"unknown_source", keywords:"causes,confinement", truncate:"", weight:1.0, description:"A restricted perspective leads to mediocrity and prevents growth.", created_at:1779734195, source_id:"chunk-0a805eaee62c04f0b4972c562982e21f"}}, {start: {_id:8196}, end: {_id:8203}, properties:{file_path:"unknown_source", keywords:"growth,self-challenge", truncate:"", weight:1.0, description:"Courageous souls challenge themselves to transcend limitations and achieve growth.", created_at:1779734195, source_id:"chunk-0a805eaee62c04f0b4972c562982e21f"}}, {start: {_id:157}, end: {_id:8196}, properties:{file_path:"unknown_source", keywords:"challenge embrace,transcendence", truncate:"", weight:1.0, description:"They embrace challenges as a means to stimulate growth and transcend mediocrity.", created_at:1779734195, source_id:"chunk-0a805eaee62c04f0b4972c562982e21f"}}, {start: {_id:8196}, end: {_id:2402}, properties:{file_path:"unknown_source", keywords:"growth achievement,self-improvement", truncate:"", weight:1.0, description:"By embracing challenges, they achieve intellectual, emotional, and other forms of growth.", created_at:1779734195, source_id:"chunk-0a805eaee62c04f0b4972c562982e21f"}}, {start: {_id:8196}, end: {_id:8199}, properties:{file_path:"unknown_source", keywords:"achievement,self-improvement", truncate:"", weight:1.0, description:"Courageous souls achieve intellectual growth through embracing challenges.", created_at:1779734195, source_id:"chunk-0a805eaee62c04f0b4972c562982e21f"}}, {start: {_id:157}, end: {_id:2402}, properties:{file_path:"unknown_source", keywords:"catalyst,stimulation", truncate:"", weight:1.0, description:"Challenges act as a catalyst for growth by stimulating self-improvement.", created_at:1779734195, source_id:"chunk-0a805eaee62c04f0b4972c562982e21f"}}, {start: {_id:8196}, end: {_id:8198}, properties:{file_path:"unknown_source", keywords:"achievement,self-improvement", truncate:"", weight:1.0, description:"Courageous souls achieve emotional growth through embracing challenges.", created_at:1779734196, source_id:"chunk-0a805eaee62c04f0b4972c562982e21f"}}, {start: {_id:8200}, end: {_id:8196}, properties:{file_path:"unknown_source", keywords:"achievement,self-improvement", truncate:"", weight:1.0, description:"Courageous souls achieve business growth through embracing challenges.", created_at:1779734196, source_id:"chunk-0a805eaee62c04f0b4972c562982e21f"}}, {start: {_id:8196}, end: {_id:8201}, properties:{file_path:"unknown_source", keywords:"achievement,self-improvement", truncate:"", weight:1.0, description:"Courageous souls achieve spiritual growth through embracing challenges.", created_at:1779734196, source_id:"chunk-0a805eaee62c04f0b4972c562982e21f"}}, {start: {_id:3867}, end: {_id:1310}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=4ytgjpow498)", keywords:"activation,immune support", truncate:"", weight:1.0, description:"Breathing exercise activates the parasympathetic nervous system through slow inhalations/exhalations, which in turn supports immune system function.", created_at:1779734236, source_id:"chunk-190acc93a27012825956522182c7d1a4"}}, {start: {_id:6997}, end: {_id:1310}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=4ytgjpow498)", truncate:"", keywords:"biological activation,health", weight:1.0, description:"The parasympathetic nervous system's activation enhances immune system functionality for combating infections.", created_at:1779734236, source_id:"chunk-190acc93a27012825956522182c7d1a4"}}, {start: {_id:6997}, end: {_id:8204}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=4ytgjpow498)", truncate:"", keywords:"protection,survival adaptation", weight:1.0, description:"Strengthening the immune system helps survive in infection-filled environments by improving pathogen resistance.", created_at:1779734237, source_id:"chunk-190acc93a27012825956522182c7d1a4"}}, {start: {_id:3867}, end: {_id:6997}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=4ytgjpow498)", truncate:"", keywords:"health enhancement,prevention", weight:1.0, description:"The exercise aims to strengthen the immune system to counter threats in infection-prone settings.", created_at:1779734237, source_id:"chunk-190acc93a27012825956522182c7d1a4"}}, {start: {_id:7389}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=4ytgjpow498)", keywords:"addressed to,audience", truncate:"", weight:1.0, description:"The YouTube Video is directed towards the viewer (You) as the intended audience.", created_at:1779734256, source_id:"chunk-5bf3950956a6b9404d15a3583f147386"}}, {start: {_id:1615}, end: {_id:296}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=4ytgjpow498)", keywords:"component,technique", truncate:"", weight:1.0, description:"Breath is a central element in the guided meditation practice.", created_at:1779734256, source_id:"chunk-5bf3950956a6b9404d15a3583f147386"}}, {start: {_id:8206}, end: {_id:296}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=4ytgjpow498)", truncate:"", keywords:"outcome,result", weight:1.0, description:"The guided meditation aims to induce a state of deep relaxation through breath-focused exercises.", created_at:1779734256, source_id:"chunk-5bf3950956a6b9404d15a3583f147386"}}, {start: {_id:1636}, end: {_id:8207}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=5Tdb7hBwX88)", truncate:"", keywords:"auditory focus,relaxation technique", weight:1.0, description:"Humming like a bee is linked to achieving relaxation.", created_at:1779734281, source_id:"chunk-edcfa2369ad86b20d06a2814301a95a8"}}, {start: {_id:8211}, end: {_id:2406}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=5Tdb7hBwX88)", truncate:"", keywords:"data inconsistency,transcription artifact", weight:1.0, description:"\"Mm\" is flagged as a transcription error due to its inconsistent use.", created_at:1779734281, source_id:"chunk-edcfa2369ad86b20d06a2814301a95a8"}}, {start: {_id:8092}, end: {_id:8183}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=5Tdb7hBwX88)", truncate:"", keywords:"breathing technique,sequence", weight:1.0, description:"Inhale deeply and exhaling are part of a coordinated breathing method.", created_at:1779734281, source_id:"chunk-edcfa2369ad86b20d06a2814301a95a8"}}, {start: {_id:8209}, end: {_id:8210}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=5Tdb7hBwX88)", keywords:"focus,sensory experience", truncate:"", weight:1.0, description:"Feeling vibrations is connected to attentive listening for relaxation.", created_at:1779734281, source_id:"chunk-edcfa2369ad86b20d06a2814301a95a8"}}] AS row
