UNWIND [{start: {_id:557}, end: {_id:554}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"connection,presence", truncate:"", weight:1.0, description:"His son's presence is felt by Diego during meditation with Krishnaji, leading to connection.", created_at:1779138598, source_id:"chunk-0c857ef7148c7fabda317a3a8fe52f05"}}, {start: {_id:556}, end: {_id:553}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"community,event location", truncate:"", weight:1.0, description:"Diego holds annual talent search competitions in his city, making it a community event.", created_at:1779138598, source_id:"chunk-0c857ef7148c7fabda317a3a8fe52f05"}}, {start: {_id:555}, end: {_id:553}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"memory,tribute", truncate:"", weight:1.0, description:"Diego organizes the competitions in memory of his son to honor his legacy.", created_at:1779138598, source_id:"chunk-0c857ef7148c7fabda317a3a8fe52f05"}}, {start: {_id:558}, end: {_id:553}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"action,inspiration", truncate:"", weight:1.0, description:"Diego's son's love for DJing inspires the type of talent searches Diego organizes.", created_at:1779138598, source_id:"chunk-0c857ef7148c7fabda317a3a8fe52f05"}}, {start: {_id:558}, end: {_id:557}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"action,interest", truncate:"", weight:1.0, description:"His son's interest in DJing directly influences the focus of the talent searches.", created_at:1779138598, source_id:"chunk-0c857ef7148c7fabda317a3a8fe52f05"}}, {start: {_id:553}, end: {_id:559}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"calm,resolution", truncate:"", weight:1.0, description:"Diego's internal war resolves into a sense of calm after meditation and self-reflection.", created_at:1779138598, source_id:"chunk-0c857ef7148c7fabda317a3a8fe52f05"}}, {start: {_id:506}, end: {_id:564}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"mental clarity,self-obsession", truncate:"", weight:1.0, description:"The practice helps transition from self-obsession to serenity, fostering emotional balance.", created_at:1779138626, source_id:"chunk-7d095ecda8ad504c7c7ad3c217e955be"}}, {start: {_id:562}, end: {_id:564}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"clarity,prevention", truncate:"", weight:1.0, description:"The practice prevents limited states from escalating into obsessive states during moments of conflict.", created_at:1779138626, source_id:"chunk-7d095ecda8ad504c7c7ad3c217e955be"}}, {start: {_id:563}, end: {_id:564}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"problem resolution,serenity", truncate:"", weight:1.0, description:"Practitioners report situations resolving magically as a result of the practice.", created_at:1779138626, source_id:"chunk-7d095ecda8ad504c7c7ad3c217e955be"}}, {start: {_id:560}, end: {_id:563}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"practitioner outcomes,success stories", weight:1.0, description:"Graduates report magical resolution of situations as a result of practicing The Serene Mind Practice.", created_at:1779138626, source_id:"chunk-7d095ecda8ad504c7c7ad3c217e955be"}}, {start: {_id:565}, end: {_id:564}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"adaptability,creativity", truncate:"", weight:1.0, description:"The practice enables novel and effective responses to challenges through heightened clarity.", created_at:1779138626, source_id:"chunk-7d095ecda8ad504c7c7ad3c217e955be"}}, {start: {_id:561}, end: {_id:564}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"habit,practice,practitioners,regular practice", weight:2.0, description:"Leaders and seekers are practitioners of The Serene Mind Practice, including leaders, seekers, teenagers, and children.<SEP>Leaders and seekers regularly practice The Serene Mind Practice, leading to positive outcomes.", created_at:1779138626, source_id:"chunk-7d095ecda8ad504c7c7ad3c217e955be"}}, {start: {_id:560}, end: {_id:565}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"adaptability,practitioner outcomes", truncate:"", weight:1.0, description:"Graduates demonstrate improved responses to challenges through the practice.", created_at:1779138626, source_id:"chunk-7d095ecda8ad504c7c7ad3c217e955be"}}, {start: {_id:564}, end: {_id:503}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"alleviation,freedom", truncate:"", weight:1.0, description:"The practice helps transition from suering to freedom, fostering emotional balance.", created_at:1779138626, source_id:"chunk-7d095ecda8ad504c7c7ad3c217e955be"}}, {start: {_id:560}, end: {_id:564}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"practitioner outcomes,success stories", weight:1.0, description:"Graduates have successfully applied the practice, leading to magical resolution of challenges.", created_at:1779138626, source_id:"chunk-7d095ecda8ad504c7c7ad3c217e955be"}}, {start: {_id:62}, end: {_id:564}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"audio guide,led by", truncate:"", weight:1.0, description:"Preethaji leads the audio guide version of the Serene Mind Practice.", created_at:1779138672, source_id:"chunk-c14547accc3c893d2fdd3408fe344de0"}}, {start: {_id:567}, end: {_id:564}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"part of,step in", truncate:"", weight:1.0, description:"STEP ONE is the first step in the Serene Mind Practice.", created_at:1779138672, source_id:"chunk-c14547accc3c893d2fdd3408fe344de0"}}, {start: {_id:568}, end: {_id:62}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"audio guide,led by", truncate:"", weight:1.0, description:"Preethaji is the leader of the audio book edition of the Serene Mind Practice.", created_at:1779138672, source_id:"chunk-c14547accc3c893d2fdd34