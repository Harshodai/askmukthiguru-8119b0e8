UNWIND [{start: {_id:6236}, end: {_id:6227}, properties:{file_path:"unknown_source", truncate:"", keywords:"neurochemical dependency,pleasure-seeking", weight:1.0, description:"Tulsidas's brain becomes dependent on dopamine for euphoric experiences, creating cravings.", created_at:1779556408, source_id:"chunk-0443cca2d76c87663467e3610969c2ba"}}, {start: {_id:2391}, end: {_id:6230}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"educational application,societal impact", weight:1.0, description:"Enlightenment is taught to Indian youth to reduce stress and promote free living.", created_at:1779556408, source_id:"chunk-922e23e61222fa7ebaae80af23f09b19"}}, {start: {_id:6236}, end: {_id:5614}, properties:{file_path:"unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"chemical dependency,neurochemical basis,pleasure mechanism,transient pleasure", weight:2.0, description:"Romantic love is chemically driven by dopamine, making it transient and unsustainable.<SEP>Romantic love triggers dopamine release, creating euphoric pleasure sensations.", created_at:1779557055, source_id:"chunk-0443cca2d76c87663467e3610969c2ba<SEP>chunk-463088ccb7af0ca596d7f4a288f68a78"}}, {start: {_id:6234}, end: {_id:6227}, properties:{file_path:"unknown_source", keywords:"desperation,destructive obsession", truncate:"", weight:1.0, description:"Tulsidas's reckless climb using a python illustrates his destructive obsession with romantic highs.", created_at:1779556408, source_id:"chunk-0443cca2d76c87663467e3610969c2ba"}}, {start: {_id:2391}, end: {_id:2249}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"global outreach,universal principles", weight:1.0, description:"Enlightenment principles are applied to worldwide youth education initiatives.", created_at:1779556408, source_id:"chunk-922e23e61222fa7ebaae80af23f09b19"}}, {start: {_id:6227}, end: {_id:6228}, properties:{file_path:"unknown_source", truncate:"", keywords:"conflict,confrontation,possessiveness,wisdom", weight:2.0, description:"Tulsidas's attachment to his wife becomes possessive and controlling, causing relational strife.<SEP>Tulsidas's wife challenges his obsession, catalyzing his self-realization.", created_at:1779556408, source_id:"chunk-0443cca2d76c87663467e3610969c2ba"}}, {start: {_id:909}, end: {_id:5614}, properties:{file_path:"unknown_source", keywords:"emotional attunement,shared joy", truncate:"", weight:1.0, description:"Love involves feeling others' emotions and celebrating their experiences as one's own.", created_at:1779556408, source_id:"chunk-e2d0ff9dea6a5334fbc3569bce6e4413"}}, {start: {_id:992}, end: {_id:2391}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"emotional growth,relationship dynamics", weight:1.0, description:"Enlightenment helps couples overcome emotional hurts and rediscover love.", created_at:1779556408, source_id:"chunk-922e23e61222fa7ebaae80af23f09b19"}}, {start: {_id:3655}, end: {_id:5614}, properties:{file_path:"unknown_source", keywords:"heartfelt bonding,mutual support", truncate:"", weight:1.0, description:"Love drives individuals to uplift others from unhappiness and celebrate their well-being.", created_at:1779556409, source_id:"chunk-e2d0ff9dea6a5334fbc3569bce6e4413"}}, {start: {_id:2201}, end: {_id:6239}, properties:{file_path:"unknown_source", keywords:"affliction,pathology", truncate:"", weight:1.0, description:"Hunger for love is explicitly referred to as a disease requiring a cure through self-awareness.", created_at:1779556409, source_id:"chunk-5c1ed637dca2d0d131d85c8ff4dd33cb"}}, {start: {_id:140}, end: {_id:6227}, properties:{file_path:"unknown_source", keywords:"extreme measures,self-destruction", truncate:"", weight:1.0, description:"Tulsidas risks drowning in the river to fulfill cravings, demonstrating addiction's dangers.", created_at:1779556409, source_id:"chunk-0443cca2d76c87663467e3610969c2ba"}}, {start: {_id:6231}, end: {_id:2391}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"organizational leadership,systemic change", weight:1.0, description:"Enlightenment enables leaders to function through awareness of interconnection.", created_at:1779556409, source_id:"chunk-922e23e61222fa7ebaae80af23f09b19"}}, {start: {_id:6240}, end: {_id:299}, properties:{file_path:"unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", keywords:"consciousness,neurological basis,radiance", truncate:"", weight:2.0, description:"Love arises from the awakening of heart neurons, manifesting as consciousness radiance.<SEP>Love is linked to the activation of heart neurons (40,000) in conscious experience.", created_at:1779557205, source_id:"chunk-5c1ed637dca2d0d131d85c8ff4dd33cb<SEP>chunk-1d477f5607ac5cfb56e2b711bd58f1aa"}}, {start: {_id:2391}, end: {_id:1364}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"holistic understanding,spiritual unity,systemic thinking,transcendence", weight:2.0, description:"Enlightenment emphasizes perceiving interconnectedness in all aspects of life.<SEP>Enlightenment is characterized by the realization of interconnection with all existence.", created_at:1779563437, source_id:"chunk-922e23e61222fa7ebaae80af23f09b19<SEP>chunk-6cdea9db2f882e51edbd9de21797726f"}}, {start: {_id:929}, end: {_id:299}, properties:{file_path:"unknown_source", keywords:"independence,transcendence", truncate:"", weight:1.0, description:"Love transcends external dependencies, remaining self-reliant and unaffected by external influences.", created_at:1779556409, source_id:"chunk-5c1ed637dca2d0d131d85c8ff4dd33cb"}}, {start: {_id:2391}, end: {_id:1771}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"existential freedom,inner peace", weight:1.0, description:"Enlightenment creates profound stillness amidst life's chaos as ultimate freedom.", created_at:1779556409, source_id:"chunk-922e23e61222fa7ebaae80af23f09b19"}}, {start: {_id:2391}, end: {_id:6227}, properties:{file_path:"unknown_source", keywords:"breakthrough,self-realization", truncate:"", weight:1.0, description:"Tulsidas transitions from addiction to enlightenment through inward journey.", created_at:1779556409, source_id:"chunk-0443cca2d76c87663467e3610969c2ba"}}, {start: {_id:2391}, end: {_id:6238}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", keywords:"liberation,transcendence", truncate:"", weight:1.0, description:"Enlightenment involves moving beyond the cycle of managing problems and personal struggles, leading to true living.", created_at:1779556410, source_id:"chunk-922e23e61222fa7ebaae80af23f09b19"}}, {start: {_id:497}, end: {_id:2391}, properties:{file_path:"unknown_source", keywords:"self-destruction vs. breakthrough", truncate:"", weight:1.0, description:"Addiction leads to self-destruction, while enlightenment offers liberation from cravings.", created_at:1779556412, source_id:"chunk-0443cca2d76c87663467e3610969c2ba"}}, {start: {_id:497}, end: {_id:4126}, properties:{file_path:"unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", keywords:"dependency,enslavement,metaphorical equivalence", truncate:"", weight:2.0, description:"Addiction is directly linked to slavery, as every addiction creates a form of enslavement.<SEP>The narrative equates addiction with slavery, emphasizing loss of freedom.", created_at:1779557129, source_id:"chunk-5c1ed637dca2d0d131d85c8ff4dd33cb<SEP>chunk-98e0115fe065f5dab78321b7c772863d"}}] AS row
