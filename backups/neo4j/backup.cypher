UNWIND [{_id:7158, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"concept", truncate:"", description:"Duty or Responsibility denotes obligations tied to ecological or social roles within a species.<SEP>Duty or Responsibility denotes obligations tied to ecological or social roles within a species.", created_at:1779656790, source_id:"chunk-bc3611b977330c3669fa3dd3bfb5860e", entity_id:"Duty or Responsibility"}}, {_id:7159, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"creature", truncate:"", description:"Male Killer Whale is a male orca not biologically designated for nurturing roles, typically dying around age 50.<SEP>Male Killer Whale is a male orca not biologically designated for nurturing roles, typically dying around age 50.<SEP>Male killer whale is a species of orca known for its social structure and hunting behavior, with males typically living until around 50 years old.", created_at:1779656816, source_id:"chunk-bc3611b977330c3669fa3dd3bfb5860e<SEP>chunk-f8d4df49e2bb59337f3b12dcef1d6f2c", entity_id:"Male Killer Whale"}}, {_id:7160, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"naturalobject", truncate:"", description:"Younger sibling whales are orcas dependent on the grandmother whale for survival and cultural transmission of hunting techniques.<SEP>Younger sibling whales are orcas dependent on the grandmother whale for survival and cultural transmission of hunting techniques.", created_at:1779656790, source_id:"chunk-bc3611b977330c3669fa3dd3bfb5860e", entity_id:"Younger Sibling Whales"}}, {_id:7162, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)<SEP>YouTube Video: V2WQ20Ocw_o (URL: https://www.youtube.com/watch?v=V2WQ20Ocw_o)", entity_type:"naturalobject", truncate:"", description:"Genes represent hereditary units influencing human traits, including longevity, linked to evolutionary adaptation for species survival.<SEP>Genes are biological entities through which the state and actions are transmitted from one generation to the next.", created_at:1779667228, source_id:"chunk-f8d4df49e2bb59337f3b12dcef1d6f2c<SEP>chunk-e984e154069661974d2a04e43c43e80a", entity_id:"Genes"}}, {_id:7163, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"concept", truncate:"", description:"Original phrase suggesting that something must occur.", created_at:1779656841, source_id:"chunk-646980d0eb4b0de704b49201aabfd524", entity_id:"what has to happen"}}, {_id:7164, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"event", truncate:"", description:"YouTube Video QzJ_Ft1de1o is a video discussing impact, communities, and biological concepts like longevity genes.", created_at:1779656853, source_id:"chunk-7438d62acfd111c95d021226c6581819", entity_id:"YouTube Video QzJ_Ft1de1o"}}, {_id:7165, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"data", truncate:"", description:"URL linking to the YouTube video containing the discussed content.", created_at:1779656853, source_id:"chunk-7438d62acfd111c95d021226c6581819", entity_id:"https://www.youtube.com/watch?v=QzJ_Ft1de1o"}}, {_id:7166, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"UNKNOWN", truncate:"", description:"Suggested rephrasing of the original phrase for better naturalness.", created_at:1779656862, source_id:"chunk-646980d0eb4b0de704b49201aabfd524", entity_id:"what needs to happen"}}, {_id:7167, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"concept", truncate:"", description:"Live a Long Life is the corrected phrase that replaced Live Long.", created_at:1779656874, source_id:"chunk-c95a104d9da85092c5bc85a30cbd4162", entity_id:"Live a Long Life"}}, {_id:7168, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"concept", truncate:"", description:"Live Long is the original phrase that was corrected to Live a Long Life.", created_at:1779656874, source_id:"chunk-c95a104d9da85092c5bc85a30cbd4162", entity_id:"Live Long"}}, {_id:7169, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"concept", truncate:"", description:"Let Us is the original phrase that was corrected to Let's.", created_at:1779656874, source_id:"chunk-c95a104d9da85092c5bc85a30cbd4162", entity_id:"Let Us"}}, {_id:7170, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"concept", truncate:"", description:"Let's is the corrected phrase that replaced Let Us.", created_at:1779656874, source_id:"chunk-c95a104d9da85092c5bc85a30cbd4162", entity_id:"Let's"}}, {_id:7171, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"naturalobject", truncate:"", description:"Biological cells in the body where strength is stored, tied to purpose emergence.<SEP>Biological cells in the body where strength is stored, tied to purpose emergence.", created_at:1779656973, source_id:"chunk-237a65ae546a2543e175242df87d7879", entity_id:"Cell"}}, {_id:7172, properties:{file_path:"unknown_source<SEP>YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"concept", truncate:"", description:"{\"Description\": \"We need to synthesize the descriptions of the entity \\\"Kaya\\\"...\"}
