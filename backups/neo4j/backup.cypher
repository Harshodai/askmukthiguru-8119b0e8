UNWIND [{start: {_id:569}, end: {_id:564}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"part of,step in", truncate:"", weight:1.0, description:"STEP THREE is the third step in the Serene Mind Practice.", created_at:1779138672, source_id:"chunk-c14547accc3c893d2fdd3408fe344de0"}}, {start: {_id:566}, end: {_id:564}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"part of,step in", truncate:"", weight:1.0, description:"STEP FOUR is the fourth step in the Serene Mind Practice.", created_at:1779138672, source_id:"chunk-c14547accc3c893d2fdd3408fe344de0"}}, {start: {_id:571}, end: {_id:564}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"part of,step in", truncate:"", weight:1.0, description:"STEP FIVE is the fifth step in the Serene Mind Practice.", created_at:1779138672, source_id:"chunk-c14547accc3c893d2fdd3408fe344de0"}}, {start: {_id:472}, end: {_id:573}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"historical example,inner truth", truncate:"", weight:1.0, description:"The Second Sacred Secret uses Gandhi's journey as an example of addressing inner truth to achieve greatness.", created_at:1779138689, source_id:"chunk-dfb4cd1f4b16e36588d2ae2b6b987ae7"}}, {start: {_id:580}, end: {_id:574}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"energy,method application", truncate:"", weight:1.0, description:"The Three-Minute Pause method helps achieve renewed focus and energy, per the text.", created_at:1779138689, source_id:"chunk-dfb4cd1f4b16e36588d2ae2b6b987ae7"}}, {start: {_id:472}, end: {_id:575}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"compassion,transformation", truncate:"", weight:1.0, description:"Gandhi transformed negative emotions into compassion, leading to nonviolent resistance.", created_at:1779138689, source_id:"chunk-dfb4cd1f4b16e36588d2ae2b6b987ae7"}}, {start: {_id:577}, end: {_id:573}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"caution,emotional awareness", truncate:"", weight:1.0, description:"The text warns against mistaking negative emotions for positive traits and highlights their potential harm.", created_at:1779138689, source_id:"chunk-dfb4cd1f4b16e36588d2ae2b6b987ae7"}}, {start: {_id:578}, end: {_id:573}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"inner truth,life transformation", truncate:"", weight:1.0, description:"The Second Sacred Secret encourages embarking on a second life journey through understanding inner truth.", created_at:1779138689, source_id:"chunk-dfb4cd1f4b16e36588d2ae2b6b987ae7"}}, {start: {_id:575}, end: {_id:21}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"content,theme", truncate:"", weight:1.0, description:"The source document's content discusses nonviolent resistance as a theme.", created_at:1779138733, source_id:"chunk-65c5a866de092cd58e4d4a2b1044a21e"}}, {start: {_id:62}, end: {_id:583}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"author,content", truncate:"", weight:1.0, description:"Preethaji is the author of The Second Life Journey: Dissolve the Inner Divide.", created_at:1779138733, source_id:"chunk-65c5a866de092cd58e4d4a2b1044a21e"}}, {start: {_id:588}, end: {_id:585}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"concept,content", truncate:"", weight:1.0, description:"The model poem is associated with the concept of an inner divide.", created_at:1779138733, source_id:"chunk-65c5a866de092cd58e4d4a2b1044a21e"}}, {start: {_id:61}, end: {_id:583}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"content,subject", truncate:"", weight:1.0, description:"Lokaa is the subject of The Second Life Journey: Dissolve the Inner Divide.", created_at:1779138733, source_id:"chunk-65c5a866de092cd58e4d4a2b1044a21e"}}, {start: {_id:582}, end: {_id:21}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"content,theme", truncate:"", weight:1.0, description:"The source document's content discusses inspiring a nation as a theme.", created_at:1779138733, source_id:"chunk-65c5a866de092cd58e4d4a2b1044a21e"}}, {start: {_id:588}, end: {_id:586}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"concept,content", truncate:"", weight:1.0, description:"Lokaa's poem is associated with the absence of an inner divide.", created_at:1779138733, source_id:"chunk-65c5a866de092cd58e4d4a2b1044a21e"}}, {start: {_id:587}, end: {_id:61}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"content,poem,poem contrast,thematic difference", truncate:"", weight:2.0, description:"Lokaa wrote a poem inspired by the poem \"Inside-Outside\".<SEP>Lokaa's poem does not have the inner divide present in the model poem \"Inside-Outside\".", created_at:1779179454, source_id:"chunk-65c5a866de092cd58e4d4a2b1044a21e<SEP>chunk-2bd00175db71e25481fb9ce67f057b84"}}, {start: {_id:584}, end: {_id:587}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"author,content", truncate:"", weight:1.0, description:"Abigail Grith is the author of the poem \"Inside-Outside\".", created_at:1779138733, source_id:"chunk-65c5a866de092cd58e4d4a2b1044a21e"}}, {start: {_id:61}, end: {_id:586}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"Lokaa,content", weight:1.0, created_at:1779138733, description:"Lokaa is the author of Lokaa's poem.", source_id:"chunk-65c5a866de092cd58e4d4a2b1044a21e"}}, {start: {_id:61}, end: {_id:585}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"Lokaa,content", truncate:"", weight:1.0, description:"Lokaa is contrasted with the model poem in terms of inner divide.", created_at:1779138733, source_id:"chunk-65c5a866de092cd58e4d4a2b1044a21e"}}, {start: {_id:597}, end: {_id:600}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"rivalry,social interaction", truncate:"", weight:1.0, description:"Peers are viewed as competitors due to societal conditioning rather than collaborators.", created_at:1779138786, source_id:"chunk-3b972b1465c1099f09b7fe384e4ebabc"}}, {start: {_id:430}, end: {_id:596}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"innocence,simplicity", truncate:"", weight:1.0, description:"Childhood is idealized as a time of unselfconscious joy and wholeness, contrasting with adult divisions.", created_at:1779138786, source_id:"chunk-3b972b1465c1099f09b7fe384e4ebabc"}}] AS row
