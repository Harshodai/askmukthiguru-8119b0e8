UNWIND [{start: {_id:32}, end: {_id:50}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)<SEP>unknown_source", truncate:"", keywords:"alignment,attraction,manifestation,meaningful occurrences,personal discovery", weight:4.0, created_at:1779562066, description:"Living a discovered purpose attracts synchronicities that guide toward destiny.<SEP>Living a discovered purpose attracts synchronicities that guide toward destiny.<SEP>Holding onto one's purpose leads to the manifestation of meaningful synchronicities.<SEP>Synchronicities are described as events that align with one's purpose, emphasizing their role in guiding individuals toward meaningful goals.", source_id:"chunk-6b92caeb732cbb11f4b5fe1ca7825dee<SEP>chunk-6f1a73ee81a735372368488ff67b808c<SEP>chunk-1f2ebd75b5a73d8a2845b5a7f6f03a0e"}}, {start: {_id:6481}, end: {_id:3031}, properties:{file_path:"unknown_source", keywords:"connection,importance,realization", truncate:"", weight:1.0, description:"The manager realizes the importance of the team over his emotional hurt, leading to a new perspective.", created_at:1779561759, source_id:"chunk-6f1a73ee81a735372368488ff67b808c"}}, {start: {_id:2384}, end: {_id:6481}, properties:{file_path:"unknown_source", truncate:"", keywords:"emotional release,letting go,self-discovery", weight:1.0, description:"The manager lets go of emotional hurt, enabling self-discovery and a new vista.", created_at:1779561759, source_id:"chunk-6f1a73ee81a735372368488ff67b808c"}}, {start: {_id:186}, end: {_id:32}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"common perception,conceptual aspect,inner lack,motivation", weight:2.0, description:"Purpose is often narrowly perceived as career-focused by general audiences.<SEP>Without purpose, career is driven by inner lack, fear, and external validation.", created_at:1779562206, source_id:"chunk-98b12bb1e69b9ff2ff208afa4abc7737<SEP>chunk-e28a16af170670aaf61d68da07b71294"}}, {start: {_id:6482}, end: {_id:6483}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"content origin,source location", weight:1.0, description:"The video is hosted in northeastern India and addresses themes relevant to the region's cultural context.", created_at:1779561820, source_id:"chunk-98b12bb1e69b9ff2ff208afa4abc7737"}}, {start: {_id:4436}, end: {_id:32}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"conceptual aspect,conscious perspective", weight:1.0, description:"Conscious individuals associate purpose with contribution rather than mere career goals.", created_at:1779561821, source_id:"chunk-98b12bb1e69b9ff2ff208afa4abc7737"}}, {start: {_id:32}, end: {_id:6341}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"conceptual aspect,spiritual view", weight:1.0, description:"Spiritual seekers link purpose to unconditional love or selfless motives.", created_at:1779561821, source_id:"chunk-98b12bb1e69b9ff2ff208afa4abc7737"}}, {start: {_id:2391}, end: {_id:32}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"conceptual aspect,spiritual view", weight:1.0, description:"Spiritual seekers also connect purpose to enlightenment as a higher form of fulfillment.", created_at:1779561821, source_id:"chunk-98b12bb1e69b9ff2ff208afa4abc7737"}}, {start: {_id:32}, end: {_id:6484}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"environmental conservation,personal mission", weight:1.0, description:"Purpose examples include ecological preservation efforts like protecting rainforests in northeastern India.", created_at:1779562066, source_id:"chunk-1f2ebd75b5a73d8a2845b5a7f6f03a0e"}}, {start: {_id:6485}, end: {_id:50}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"experience,manifestation", truncate:"", weight:1.0, description:"Followers regularly manifest synchronicities in their lives, both on a massive scale and in daily experiences.", created_at:1779562066, source_id:"chunk-1f2ebd75b5a73d8a2845b5a7f6f03a0e"}}, {start: {_id:6486}, end: {_id:50}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"alleviation,resolution", truncate:"", weight:1.0, description:"Synchronicities help reduce inner struggles and lead to a sense of peace.", created_at:1779562066, source_id:"chunk-1f2ebd75b5a73d8a2845b5a7f6f03a0e"}}, {start: {_id:755}, end: {_id:50}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"emotional impact,transformation", weight:1.0, description:"Experiencing synchronicities leads to a magical quality in life and inner peace.", created_at:1779562066, source_id:"chunk-1f2ebd75b5a73d8a2845b5a7f6f03a0e"}}, {start: {_id:6489}, end: {_id:6490}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"existential void,routine behavior", weight:1.0, description:"Absence of purpose leads to repetitive, unexamined daily habits creating an illusion of order.", created_at:1779562081, source_id:"chunk-a9f75e7b1831f124898c085ae0393e6e"}}, {start: {_id:5272}, end: {_id:5732}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"existential clarity,existential inquiry,introspection,meaningful living", weight:2.0, description:"Questioning life's purpose initiates self-discovery through confronting unanswered questions.<SEP>Self-discovery enables redefining purpose to create a meaningful life trajectory.", created_at:1779562081, source_id:"chunk-a9f75e7b1831f124898c085ae0393e6e"}}, {start: {_id:29}, end: {_id:6490}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"internal disarray,superficial stability", weight:1.0, description:"Without purpose, life becomes externally ordered but internally chaotic despite appearances.", created_at:1779562081, source_id:"chunk-a9f75e7b1831f124898c085ae0393e6e"}}, {start: {_id:234}, end: {_id:543}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"emotional conflict,existential doubt", weight:1.0, description:"The person questions the meaning of their relationship and feels emotional disconnection from their partner.", created_at:1779562101, source_id:"chunk-795d6a47694e346b9ff7bde9c51e23ec"}}, {start: {_id:2874}, end: {_id:234}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"monotony,resentment", truncate:"", weight:1.0, description:"The person perceives their job as monotonous and resents its thankless nature despite sacrifices made.", created_at:1779562101, source_id:"chunk-795d6a47694e346b9ff7bde9c51e23ec"}}, {start: {_id:234}, end: {_id:6498}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"escapism,existential despair", weight:1.0, description:"The person contemplates quitting responsibilities due to overwhelming existential despair and desire for escape.", created_at:1779562101, source_id:"chunk-795d6a47694e346b9ff7bde9c51e23ec"}}, {start: {_id:6497}, end: {_id:234}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"identity conflict,self-doubt", weight:1.0, description:"The person experiences a crisis in purpose, questioning their life choices and self-identity over years.", created_at:1779562101, source_id:"chunk-795d6a47694e346b9ff7bde9c51e23ec"}}, {start: {_id:234}, end: {_id:6495}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"psychological torment,self-imposed constraints", weight:1.0, description:"The metaphorical \"Y equals chains\" symbolizes the person's self-imposed limitations and psychological torment.", created_at:1779562101, source_id:"chunk-795d6a47694e346b9ff7bde9c51e23ec"}}] AS row
