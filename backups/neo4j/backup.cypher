UNWIND [{start: {_id:1840}, end: {_id:1828}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"energy alignment,energy center,energy channeling,energy flow,meditation,spiritual alignment,spiritual gesture,yoga practice", weight:4.0, description:"Namaskara Mudra is practiced at the heart chakra to focus intention and energy.<SEP>Namaskara Mudra helps balance and align the Heart Chakra.<SEP>Namaskara Mudra is performed at the heart chakra.<SEP>The Namaskara Mudra is performed at the heart chakra to align energy and connect with divine power.", created_at:1779150954, source_id:"chunk-6b79e6b00a623d29a4805b544a6d5b42<SEP>chunk-8fee4dd509610d97c05752528a7b3d25<SEP>chunk-dd1dc8cc2e72a766ab8873bdc25d460b<SEP>chunk-083389ed1f29c477711959b950521642"}}, {start: {_id:1829}, end: {_id:1853}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", keywords:"divine energy,unity", truncate:"", weight:1.0, description:"Akam Ketra is identified as the mystic powerhouse symbolizing divine unity and energy.", created_at:1779150543, source_id:"chunk-6b79e6b00a623d29a4805b544a6d5b42"}}, {start: {_id:1820}, end: {_id:731}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"awakening,meditation goal,spiritual energy,spiritual experience,transcendence,transcendental,transcendental experience", weight:4.0, description:"Kundalini is awakened through limitless field meditation for spiritual transcendence.<SEP>Kundalini awakening is a goal of Limitless Field Meditation.<SEP>The meditation aims to facilitate the awakening of Kundalini energy in the Limitless Field.<SEP>The Limitless Field Meditation facilitates the transcendental awakening of Kundalini energy.", created_at:1779150836, source_id:"chunk-6b79e6b00a623d29a4805b544a6d5b42<SEP>chunk-8fee4dd509610d97c05752528a7b3d25<SEP>chunk-232217422a9d55b6c921649f7abed07d<SEP>chunk-4003efce0728e0c0f59a1a3a79c95022"}}, {start: {_id:1831}, end: {_id:108}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"divinity,meaning,subject,unity", weight:2.0, description:"The mantra embodies the meaning of unity with the divine and divine presence within self.<SEP>The mantra's meaning explicitly references the divine as central to its spiritual message.", created_at:1779150836, source_id:"chunk-6b79e6b00a623d29a4805b544a6d5b42<SEP>chunk-4003efce0728e0c0f59a1a3a79c95022"}}, {start: {_id:1703}, end: {_id:1854}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"awakening,divine connection", weight:1.0, description:"Power is awakened for the user, initiating a connection to divine energy and grace.", created_at:1779150543, source_id:"chunk-6b79e6b00a623d29a4805b544a6d5b42"}}, {start: {_id:1852}, end: {_id:1855}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"divine,spiritual", weight:1.0, description:"Divine grace is framed as the act enabling transcendental experiences and unity.", created_at:1779150543, source_id:"chunk-6b79e6b00a623d29a4805b544a6d5b42"}}, {start: {_id:1860}, end: {_id:1859}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"non-duality,philosophical continuity", weight:1.0, description:"Both phrases express interconnected themes of unity between the self and the divine, with the latter serving as a concise version of the former.", created_at:1779150592, source_id:"chunk-5cf2245301754ae3b4356c05ea36901b"}}, {start: {_id:1829}, end: {_id:1831}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"mantra association,spiritual practice", weight:2.0, description:"Akam Ketra is associated with the mantra Akam Mantra Hamsa Soham Ekam, reflecting its role in spiritual practices.<SEP>The Akam Mantra is chanted in the context of Akam Ketra as part of divine meditation.", created_at:1779151048, source_id:"chunk-5cf2245301754ae3b4356c05ea36901b<SEP>chunk-2079b0e2ccfe992809b146ad6448b0ca"}}, {start: {_id:1860}, end: {_id:731}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"philosophical basis,spiritual practice", weight:1.0, description:"Limitless Field Meditation is linked to the concept of divine unity, as expressed in the phrase about self-divine oneness.", created_at:1779150592, source_id:"chunk-5cf2245301754ae3b4356c05ea36901b"}}, {start: {_id:1852}, end: {_id:1703}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"awakening,divine attribution,divine intervention,source,spiritual concept,spiritual manifestation", weight:3.0, created_at:1779150954, description:"Power is characterized as an act of divine grace in the input text.<SEP>Divine grace is the source of awakened power mentioned in the meditation context.<SEP>Power is awakened through divine grace, representing a connection between human consciousness and higher spiritual forces.", source_id:"chunk-449f6963d54a8ba71d9c6f5f49484dc0<SEP>chunk-4003efce0728e0c0f59a1a3a79c95022<SEP>chunk-083389ed1f29c477711959b950521642"}}, {start: {_id:731}, end: {_id:1853}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"meditation focus,spiritual exploration", weight:1.0, description:"Limitless Field Meditation explores the mystic powerhouse Akam Ketra.", created_at:1779150664, source_id:"chunk-8fee4dd509610d97c05752528a7b3d25"}}, {start: {_id:1861}, end: {_id:1862}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"meditation outcome,spiritual aim", weight:1.0, description:"Sacred Intention aims for transcendental awakening.", created_at:1779150664, source_id:"chunk-8fee4dd509610d97c05752528a7b3d25"}}, {start: {_id:1820}, end: {_id:1828}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"energy activation,spiritual practice", weight:1.0, description:"Namaskara Mudra is used to activate and channel Kundalini energy.", created_at:1779150664, source_id:"chunk-8fee4dd509610d97c05752528a7b3d25"}}, {start: {_id:1852}, end: {_id:1861}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"divine connection,spiritual goal", created_at:1779150664, weight:1.0, description:"Sacred Intention seeks divine grace.", source_id:"chunk-8fee4dd509610d97c05752528a7b3d25"}}, {start: {_id:1840}, end: {_id:1853}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"energy center,spiritual power", weight:1.0, description:"Heart Chakra is connected to the mystic powerhouse Akam Ketra.", created_at:1779150664, source_id:"chunk-8fee4dd509610d97c05752528a7b3d25"}}, {start: {_id:731}, end: {_id:1828}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"meditation technique,ritual gesture", weight:1.0, description:"The practice involves joining palms in Namaskara Mudra at the heart chakra as part of the meditation protocol.", created_at:1779150719, source_id:"chunk-232217422a9d55b6c921649f7abed07d"}}, {start: {_id:1828}, end: {_id:1864}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"anatomical focus,yoga technique", weight:1.0, description:"The practice involves joining palms in Namaskara Mudra at the heart chakra as part of the meditation protocol.", created_at:1779150719, source_id:"chunk-232217422a9d55b6c921649f7abed07d"}}, {start: {_id:1829}, end: {_id:731}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"divine center,divine experience,energy center,mystic focus,mystical realm,transcendental practice", weight:3.0, created_at:1779151006, description:"The practice seeks to connect practitioners with the mystic powerhouse Akam Ketra for divine encounters.<SEP>The Akam Ketra serves as the central focus of the Limitless Field Meditation, representing the divine within.<SEP>Limitless Field meditation incorporates the mystic powerhouse Akam Ketra as its focal point for spiritual awakening.", source_id:"chunk-232217422a9d55b6c921649f7abed07d<SEP>chunk-4003efce0728e0c0f59a1a3a79c95022<SEP>chunk-bc58b79c3342230326d74cad5e78c4a8"}}, {start: {_id:731}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"content dissemination,instructional material", weight:1.0, description:"The video contains or references the meditation instructions and concepts discussed.", created_at:1779150719, source_id:"chunk-232217422a9d55b6c921649f7abed07d"}}, {start: {_id:1820}, end: {_id:1861}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UrVvSqKYU8c)", truncate:"", keywords:"spiritual experience,transcendental awakening", weight:1.0, description:"The sacred intention involves experiencing the transcendental awakening of Kundalini energy.", created_at:1779150789, source_id:"chunk-7f215aec5e563fe08c9394af87e3712d"}}] AS row
