UNWIND [{start: {_id:1786}, end: {_id:1790}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)<SEP>unknown_source", truncate:"", keywords:"correction scope,domain terms,error relationship,relationship", weight:3.0, description:"Domain-specific names and terms are related to punctuation and capitalization.<SEP>Domain-specific names and terms are a subset of errors that include punctuation and capitalization issues.", created_at:1779393636, source_id:"chunk-337b1d2d15308f5767eda973156454fe<SEP>chunk-d66cf68ce9f6d614d8c2ffeac6619b27"}}, {start: {_id:4117}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", keywords:"guideline application", truncate:"", weight:1.0, description:"The video's text must adhere to the correction rules for accuracy.", created_at:1779254090, source_id:"chunk-d57e9e7661b8c29c289bb2a8bcb7d92d"}}, {start: {_id:1791}, end: {_id:4117}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", keywords:"method implementation", truncate:"", weight:1.0, description:"The rules govern the creation of the corrected text output.", created_at:1779254090, source_id:"chunk-d57e9e7661b8c29c289bb2a8bcb7d92d"}}, {start: {_id:4121}, end: {_id:4119}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"behavioral change,social impact", weight:1.0, description:"Lockdowns increased domestic violence as perpetrators, restricted from addictive behaviors, redirected frustration toward families.", created_at:1779254291, source_id:"chunk-4043681cb90e5032a1d66db36f936a98"}}, {start: {_id:4123}, end: {_id:4122}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", keywords:"abuse,victimization", truncate:"", weight:1.0, description:"Perpetrators target innocent family members due to unchecked aggression during lockdowns.", created_at:1779254291, source_id:"chunk-4043681cb90e5032a1d66db36f936a98"}}, {start: {_id:2598}, end: {_id:4123}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"behavioral dependency,frustration", weight:1.0, description:"Perpetrators' inability to engage in addictive behaviors during lockdowns amplifies frustration and violence.", created_at:1779254291, source_id:"chunk-4043681cb90e5032a1d66db36f936a98"}}, {start: {_id:2145}, end: {_id:4119}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"public health,societal stress", weight:1.0, description:"The global crisis led to lockdowns, indirectly intensifying domestic violence through economic and psychological stress.", created_at:1779254291, source_id:"chunk-4043681cb90e5032a1d66db36f936a98"}}, {start: {_id:4121}, end: {_id:2145}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"crisis consequence,societal impact", weight:1.0, description:"The global crisis exacerbated domestic violence through economic and psychological stress.", created_at:1779254291, source_id:"chunk-4043681cb90e5032a1d66db36f936a98"}}, {start: {_id:4120}, end: {_id:4123}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"behavioral cause,emotional triggers", weight:1.0, description:"These emotions, allowed to grow unchecked, drive perpetrators to commit violence against families.", created_at:1779254291, source_id:"chunk-4043681cb90e5032a1d66db36f936a98"}}, {start: {_id:4121}, end: {_id:4124}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"hidden impact,social issue", weight:1.0, description:"Silent torture in families is a hidden consequence of the global crisis and lockdowns.", created_at:1779254291, source_id:"chunk-4043681cb90e5032a1d66db36f936a98"}}, {start: {_id:4130}, end: {_id:4126}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"equivalence,negative impact", weight:1.0, description:"Obedience is equated with slavery, not love.", created_at:1779254348, source_id:"chunk-1585d67082ac380dcec744bed4f90b26"}}, {start: {_id:89}, end: {_id:4125}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", keywords:"consumption,growth", truncate:"", weight:1.0, description:"Anger, suspicion, and jealousy can grow and consume a person.", created_at:1779254348, source_id:"chunk-1585d67082ac380dcec744bed4f90b26"}}, {start: {_id:299}, end: {_id:956}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", keywords:"necessity,prerequisite", truncate:"", weight:1.0, description:"Love can only exist when there is mutual respect between individuals.", created_at:1779254348, source_id:"chunk-1585d67082ac380dcec744bed4f90b26"}}, {start: {_id:453}, end: {_id:739}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"causality,loss", weight:1.0, description:"Disrespect of women and girl children causes a family to lose abundance.", created_at:1779254348, source_id:"chunk-1585d67082ac380dcec744bed4f90b26"}}, {start: {_id:852}, end: {_id:299}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)<SEP>YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"emotional barrier,obstruction,opposition,separation", weight:2.0, description:"Fear and anger obstruct the possibility of love.<SEP>Fear is not love's opposite but results from separation from it, as stated in the text.", created_at:1779420694, source_id:"chunk-1585d67082ac380dcec744bed4f90b26<SEP>chunk-44b4ed2b95749854883160c9435c1c98"}}, {start: {_id:739}, end: {_id:138}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"context,violation", weight:1.0, description:"The woman's disrespect and violation in a family lead to loss of abundance.", created_at:1779254349, source_id:"chunk-1585d67082ac380dcec744bed4f90b26"}}, {start: {_id:4131}, end: {_id:299}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"emotional barrier,obstruction", weight:1.0, description:"Insulting someone hinders the development of love.", created_at:1779254349, source_id:"chunk-1585d67082ac380dcec744bed4f90b26"}}, {start: {_id:739}, end: {_id:4133}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"context,violation", weight:1.0, description:"The girl child's violation in a family leads to loss of abundance.", created_at:1779254349, source_id:"chunk-1585d67082ac380dcec744bed4f90b26"}}, {start: {_id:299}, end: {_id:3271}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", keywords:"cause,emotional need", truncate:"", weight:1.0, description:"Violence may arise from a lack of love and inability to express it respectfully.", created_at:1779254349, source_id:"chunk-1585d67082ac380dcec744bed4f90b26"}}, {start: {_id:1832}, end: {_id:4134}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"spiritual message,video content", weight:1.0, description:"The mantra is central to the video's message about consciousness and family transformation.", created_at:1779254395, source_id:"chunk-22fbf22f17126e6b5377570cdb342627"}}] AS row
