UNWIND [{_id:1955, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", entity_type:"concept", truncate:"", description:"Self-harm is noted as the leading cause of death for people aged 15-44, with higher mortality among men.<SEP>Self-Harm refers to intentional harm inflicted on oneself, statistically more prevalent among men.<SEP>Self-harm refers to intentional physical injury as a response to emotional or psychological pain.", created_at:1779219003, source_id:"chunk-5d0f74c4239eabf7a6fea87da28be5d8<SEP>chunk-61a7ee017159ac7e6854fff065426b75<SEP>chunk-959b75d8730e8069b5cdeee7b801f17f<SEP>chunk-0390556d788c91f6a96de617dfba0674", entity_id:"Self-Harm"}}, {_id:1956, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", entity_type:"concept", truncate:"", description:"Friendships are social bonds characterized by superficiality in modern contexts, contributing to loneliness.<SEP>Friendships are social bonds characterized by mutual affection and support.", created_at:1779219003, source_id:"chunk-61a7ee017159ac7e6854fff065426b75<SEP>chunk-0390556d788c91f6a96de617dfba0674", entity_id:"Friendships"}}, {_id:1957, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", entity_type:"concept", truncate:"", created_at:1779219054, description:"Interaction denotes surface-level exchanges without emotional depth, contrasting with true connection.<SEP>Interaction is contrasted with connection, emphasizing depth versus superficiality.<SEP>Interaction involves superficial exchanges between individuals without deep connection.<SEP>Interaction denotes physical or social engagement lacking deeper spiritual significance.", source_id:"chunk-61a7ee017159ac7e6854fff065426b75<SEP>chunk-0390556d788c91f6a96de617dfba0674<SEP>chunk-efcb91e5fdaab3bfd47bb92c605956fe", entity_id:"Interaction"}}, {_id:1958, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)", entity_type:"concept", truncate:"", created_at:1779152887, description:"Earth-like consciousness is discussed as essential for growing wealth, even for deities, highlighting its fundamental role in economic prosperity.<SEP>A type of consciousness associated with leadership and wealth attraction.<SEP>earth-like consciousness is a state of mind associated with abundance and spiritual alignment, enabling individuals to become heart leaders.", source_id:"chunk-7f96797acd949b60d31248b83d9abf45<SEP>chunk-48b6f5afbbb30d33dc95910a500c6a85<SEP>chunk-3cf67bb7dd92ee291f3034c55c2bac9c", entity_id:"earth-like consciousness"}}, {_id:1959, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)", entity_type:"artifact", truncate:"", description:"The Stone is a sacred object believed to hold the potential to manifest the deity's form as Mola Viran.", created_at:1779152458, source_id:"chunk-e485856c846e316df06cb23fc5d1ca15", entity_id:"Stone"}}, {_id:1960, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)", entity_type:"concept", truncate:"", description:"Actions taken to promote inclusivity and nurture the whole.", created_at:1779152546, source_id:"chunk-948edf40820be95513a6d203f6c87e9f", entity_id:"inclusive actions"}}, {_id:1961, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", entity_type:"concept", truncate:"", description:"Emotional crisis is a state where connection provides strength and grace through mutual understanding.<SEP>Emotional Crisis denotes intense psychological distress, alleviated through meaningful connections.<SEP>Emotional crisis is a state of intense emotional distress or turmoil.<SEP>Emotional crisis describes a state of intense psychological distress or turmoil.", created_at:1779219003, source_id:"chunk-61a7ee017159ac7e6854fff065426b75<SEP>chunk-959b75d8730e8069b5cdeee7b801f17f<SEP>chunk-1638eab96ec57bc1b768b7d70d8ef77f<SEP>chunk-0390556d788c91f6a96de617dfba0674", entity_id:"Emotional Crisis"}}, {_id:1962, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)", entity_type:"concept", truncate:"", description:"An individual or entity involved in creating wealth, discussed in the context of inclusivity.", created_at:1779152546, source_id:"chunk-948edf40820be95513a6d203f6c87e9f", entity_id:"wealth creator"}}, {_id:1963, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)", entity_type:"concept", truncate:"", description:"The entirety or collective well-being emphasized in the text.", created_at:1779152546, source_id:"chunk-948edf40820be95513a6d203f6c87e9f", entity_id:"whole"}}, {_id:1964, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)", entity_type:"concept", truncate:"", description:"A state of awareness that emphasizes inclusivity and interconnectedness.", created_at:1779152546, source_id:"chunk-948edf40820be95513a6d203f6c87e9f", entity_id:"inclusive consciousness"}}, {_id:1965, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)<SEP>YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"concept", truncate:"", description:"Strength manifests as resilience derived from connection, enabling overcoming adversity.<SEP>Strength is a quality or beautiful aspect embodied by loved ones, acknowledged as integral to the experience of love and its transformative effects.<SEP>Strength is a quality or beautiful aspect embodied by loved ones, acknowledged as integral to the experience of love and its transformative effects.<SEP>Strength is derived from a solid foundation, analogous to the tree's reliance on its roots.<SEP>Immense strength built in every cell of the body, linked to purpose and longevity.<SEP>Immense strength built in every cell of the body, linked to purpose and longevity.", created_at:1779656973, source_id:"chunk-61a7ee017159ac7e6854fff065426b75<SEP>chunk-5bd21ff5a870ab22c344b6bc7a8c56b4<SEP>chunk-46d6abd520d390d99cea37e408f7a403<SEP>chunk-237a65ae546a2543e175242df87d7879", entity_id:"Strength"}}, {_id:1966, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)<SEP>YouTube Video: pTnZt0SqDFM (URL: https://www.youtube.com/watch?v=pTnZt0SqDFM)", entity_type:"concept", truncate:"", description:"Words that sound similar but have different meanings, leading to transcription errors.<SEP>Category discussing words that sound similar but have different meanings or spellings, including \"in suffering\" as an example.", created_at:1779399677, source_id:"chunk-948edf40820be95513a6d203f6c87e9f<SEP>chunk-aba1fa51c438208d47c78877a58241d4<SEP>chunk-a8de9d54e57d76758c3eb9ce7b788164", entity_id:"homophones and misheard words"}}, {_id:1967, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)", entity_type:"concept", truncate:"", description:"Errors in the transcription of the video content, including homophones and domain-specific terms.", created_at:1779152547, source_id:"chunk-948edf40820be95513a6d203f6c87e9f", entity_id:"transcription errors"}}, {_id:1968, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)", entity_type:"concept", truncate:"", description:"Formatting aspects such as punctuation and capitalization that affect readability.", created_at:1779152547, source_id:"chunk-948edf40820be95513a6d203f6c87e9f<SEP>chunk-a8de9d54e57d76758c3eb9ce7b788164", entity_id:"punctuation and capitalization"}}, {_id:1969, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)", entity_type:"concept", truncate:"", description:"Specialized terminology relevant to the spiritual or philosophical context of the text.", created_at:1779152547, source_id:"chunk-948edf40820be95513a6d203f6c87e9f<SEP>chunk-9670225f84c4c4d682af773cdfe87366<SEP>chunk-a8de9d54e57d76758c3eb9ce7b788164", entity_id:"domain-specific names and terms"}}, {_id:1970, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)<SEP>unknown_source<SEP>YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)<SEP>YouTube Video: smrj15-QOAI (URL: https://www.youtube.com/watch?v=smrj15-QOAI)", entity_type:"concept", truncate:"", created_at:1779423459, description:"Abundance Consciousness is a state of mind essential for creating enduring wealth and financial abundance, and it also attracts prosperity. It is a mental state that enables individuals to contribute back to the world, perform actions with passion, and experience synchronicities and magic.

The concept is linked to spiritual evolution and is awakened through spiritual science. It is characterized by ease, synchronicities, and magic, and it contrasts with misfortune consciousness.

By fostering a mindset of abundance, it leads to positive actions and a sense of ease, and it is considered a prerequisite for creating wealth and contributing to the world.", source_id:"chunk-2baff9ff7ae96c7443216aa06ccb2687<SEP>chunk-862528746f60f5678c41b67748425947<SEP>chunk-3cf67bb7dd92ee291f3034c55c2bac9c<SEP>chunk-cc573a1ed7984ac5ddefcc442d2f95bf<SEP>chunk-9146e187edbee9cdbc50b048c433c6f9<SEP>chunk-3e00aec0d824214dc3b1bf504e305af0<SEP>chunk-407afcc34149e3cdc533c3a522a0ac53<SEP>chunk-8de47a5ff0c1ad110a1c99957f390ebf<SEP>chunk-ff51aa4461148b2b87ba9c4aa3794e5c", entity_id:"Abundance Consciousness"}}, {_id:1971, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)", entity_type:"concept", truncate:"", description:"Enduring Wealth refers to the creation of lasting financial prosperity through spiritual and conscious practices.<SEP>Enduring wealth flows in abundance and is the goal of those who want to create wealth.<SEP>Enduring wealth is portrayed as a result of nurturing abundance consciousness and spiritual alignment.<SEP>Enduring Wealth represents sustainable financial prosperity rooted in spiritual alignment.", created_at:1779152982, source_id:"chunk-2baff9ff7ae96c7443216aa06ccb2687<SEP>chunk-862528746f60f5678c41b67748425947<SEP>chunk-3cf67bb7dd92ee291f3034c55c2bac9c<SEP>chunk-cc573a1ed7984ac5ddefcc442d2f95bf", entity_id:"Enduring Wealth"}}, {_id:1972, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)", entity_type:"content", truncate:"", description:"omes your reality is the title of a YouTube video.", created_at:1779152614, source_id:"chunk-71510604a44bc705b1a00eb06fb8c047", entity_id:"omes your reality"}}, {_id:1973, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)", entity_type:"data", truncate:"", description:"This URL is associated with the YouTube Video.", created_at:1779152614, source_id:"chunk-71510604a44bc705b1a00eb06fb8c047", entity_id:"https://www.youtube.com/watch?v=oUCZWSi8zY4"}}, {_id:1974, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)", entity_type:"concept", truncate:"", description:"abundance is a concept discussed in the context of the ACAM Abundance Festival.<SEP>Abundance is a concept discussed in the video, contrasting with the term \"Ekam\" mentioned in the user's list.", created_at:1779152765, source_id:"chunk-71510604a44bc705b1a00eb06fb8c047<SEP>chunk-5731699645f9202b5e1c450356988b09<SEP>chunk-6a05be89bdb9093be2522608eb8c0a87", entity_id:"abundance"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
