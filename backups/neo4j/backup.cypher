UNWIND [{_id:6763, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"artifact", truncate:"", description:"The term \"broken glasses\" is suggested to be corrected to \"glass\" as it refers to a single mirror, making \"glass\" the more appropriate uncountable noun.", created_at:1779648023, source_id:"chunk-89ab86758e55eda4e32bf5581a61d209", entity_id:"Broken Glasses"}}, {_id:6764, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"naturalobject", truncate:"", description:"The corrected term \"glass\" is an uncountable noun representing the material of the mirror.<SEP>Glass is a material used in mirrors and other objects.<SEP>Glass is a material used in mirrors and other objects.", created_at:1779648099, source_id:"chunk-89ab86758e55eda4e32bf5581a61d209<SEP>chunk-b4ecf7e4c6ac98b4463f375b4140f36f", entity_id:"Glass"}}, {_id:6765, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"concept", truncate:"", description:"Frustration arises from a sense of disintegration.<SEP>Frustration arises from a sense of disintegration.", created_at:1779648098, source_id:"chunk-b4ecf7e4c6ac98b4463f375b4140f36f", entity_id:"Frustrated"}}, {_id:6766, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"concept", truncate:"", description:"Disintegrated describes a state of being broken or fragmented.<SEP>Disintegrated describes a state of being broken or fragmented.", created_at:1779648098, source_id:"chunk-b4ecf7e4c6ac98b4463f375b4140f36f", entity_id:"Disintegrated"}}, {_id:6767, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"concept", truncate:"", description:"Stressed is an emotional state resulting from disintegration.<SEP>Stressed is an emotional state resulting from disintegration.", created_at:1779648098, source_id:"chunk-b4ecf7e4c6ac98b4463f375b4140f36f", entity_id:"Stressed"}}, {_id:6768, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"concept", truncate:"", description:"Being lost is a state of disorientation connected to disintegration.<SEP>Being lost is a state of disorientation connected to disintegration.", created_at:1779648098, source_id:"chunk-b4ecf7e4c6ac98b4463f375b4140f36f", entity_id:"Lost"}}, {_id:6769, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"concept", truncate:"", description:"The state of Oneness is achieved through integration.<SEP>The state of Oneness is achieved through integration.<SEP>A spiritual or philosophical condition where all existence is perceived as interconnected.", created_at:1779648715, source_id:"chunk-b4ecf7e4c6ac98b4463f375b4140f36f<SEP>chunk-73d463f43d27a07d4aa8c95e74926d9e", entity_id:"State of Oneness"}}, {_id:6770, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"concept", truncate:"", description:"A better place signifies an improved state of the world.<SEP>A better place signifies an improved state of the world.", created_at:1779648099, source_id:"chunk-b4ecf7e4c6ac98b4463f375b4140f36f", entity_id:"Better Place"}}, {_id:6771, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"concept", truncate:"", description:"A state of balance and agreement that exists in the body and family when in oneness.", created_at:1779648084, source_id:"chunk-09bf0a07734e74605b4d135353c1c8b6", entity_id:"harmony"}}, {_id:6772, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"concept", truncate:"", description:"A state of imbalance and disagreement associated with unhealthiness.", created_at:1779648084, source_id:"chunk-09bf0a07734e74605b4d135353c1c8b6", entity_id:"disharmony"}}, {_id:6773, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"concept", truncate:"", description:"An individual with whom one interacts, mentioned in the context of harmony.", created_at:1779648084, source_id:"chunk-09bf0a07734e74605b4d135353c1c8b6", entity_id:"fellow human being"}}, {_id:6774, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"concept", truncate:"", description:"A sense of interrelation and unity within the family when in the state of oneness.", created_at:1779648084, source_id:"chunk-09bf0a07734e74605b4d135353c1c8b6", entity_id:"connection"}}, {_id:6775, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"concept", truncate:"", description:"Negative health outcomes resulting from disharmony or lack of harmony.", created_at:1779648084, source_id:"chunk-09bf0a07734e74605b4d135353c1c8b6", entity_id:"health issues"}}, {_id:6779, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"concept", truncate:"", description:"Inferior/Superior Attitude is a type of attitude where individuals feel either inferior or superior, leading to the devaluation of others.<SEP>Inferior/Superior Attitude is a type of attitude where individuals feel either inferior or superior, leading to the devaluation of others.", created_at:1779648280, source_id:"chunk-3df6d7e17b29056ecebd37bab054ca0d", entity_id:"Inferior/Superior Attitude"}}, {_id:6780, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"concept", truncate:"", description:"Arrogant Attitude is a type of attitude characterized by overconfidence and a sense of superiority, as discussed in the video.<SEP>Arrogant Attitude is a type of attitude characterized by overconfidence and a sense of superiority, as discussed in the video.", created_at:1779648280, source_id:"chunk-3df6d7e17b29056ecebd37bab054ca0d", entity_id:"Arrogant Attitude"}}, {_id:6781, properties:{file_path:"YouTube Video: K-AFDVOkIoE (URL: https://www.youtube.com/watch?v=K-AFDVOkIoE)", entity_type:"concept", truncate:"", description:"Practicing sustainability at home is a concept referring to individual actions taken to reduce environmental impact, metaphorically linked to nurturing Mother Earth.<SEP>Practicing sustainability at home is a concept referring to individual actions taken to reduce environmental impact, metaphorically linked to nurturing Mother Earth.", created_at:1779648280, source_id:"chunk-393e1029671c8cd325c8aaceacba56f1", entity_id:"Practicing Sustainability at Home"}}, {_id:6782, properties:{file_path:"YouTube Video: K-AFDVOkIoE (URL: https://www.youtube.com/watch?v=K-AFDVOkIoE)", entity_type:"event", truncate:"", description:"Earth Day is an annual global event celebrated on April 22nd to honor and protect Mother Earth, symbolizing environmental awareness and action.<SEP>Earth Day is an annual global event celebrated on April 22nd to honor and protect Mother Earth, symbolizing environmental awareness and action.<SEP>Earth Day is an annual global event observed on April 22nd to promote environmental awareness and planetary stewardship.", created_at:1779648349, source_id:"chunk-393e1029671c8cd325c8aaceacba56f1<SEP>chunk-b1e9b7eb495ce02a274d514dffa406f5", entity_id:"Earth Day"}}, {_id:6783, properties:{file_path:"YouTube Video: K-AFDVOkIoE (URL: https://www.youtube.com/watch?v=K-AFDVOkIoE)", entity_type:"person", truncate:"", description:"Three astronauts who traveled to the Moon aboard Apollo Eight in 1968, witnessing the Earthrise and capturing its iconic photograph.<SEP>Three astronauts who traveled to the Moon aboard Apollo Eight in 1968, witnessing the Earthrise and capturing its iconic photograph.", created_at:1779648280, source_id:"chunk-393e1029671c8cd325c8aaceacba56f1", entity_id:"Apollo Eight Astronauts"}}, {_id:6784, properties:{file_path:"YouTube Video: K-AFDVOkIoE (URL: https://www.youtube.com/watch?v=K-AFDVOkIoE)", entity_type:"artifact", truncate:"", description:"The Earthrise photograph taken by Apollo Eight astronauts, depicting Earth as a fragile blue planet against the Moon's desolate landscape, catalyzing environmental movements.<SEP>The Earthrise photograph taken by Apollo Eight astronauts, depicting Earth as a fragile blue planet against the Moon's desolate landscape, catalyzing environmental movements.", created_at:1779648280, source_id:"chunk-393e1029671c8cd325c8aaceacba56f1", entity_id:"Earthrise Photograph"}}, {_id:6785, properties:{file_path:"YouTube Video: K-AFDVOkIoE (URL: https://www.youtube.com/watch?v=K-AFDVOkIoE)", entity_type:"UNKNOWN", truncate:"", description:"Mother Earth is metaphorically linked to \"sustainability at home,\" encouraging individual environmental responsibility.", created_at:1779648324, source_id:"chunk-393e1029671c8cd325c8aaceacba56f1", entity_id:"sustainability at home"}}] AS row
