UNWIND [{start: {_id:472}, end: {_id:482}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"discrimination,insult", truncate:"", weight:1.0, description:"The ticket collector insulted Gandhi and ordered him to move to third-class.", created_at:1779138072, source_id:"chunk-51b5d128cc55be8ec4b28c0575f1cf41"}}, {start: {_id:472}, end: {_id:484}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"forced removal,humiliation", truncate:"", weight:1.0, description:"Gandhi was forced off the train onto the platform in Pietermartizburg.", created_at:1779138072, source_id:"chunk-51b5d128cc55be8ec4b28c0575f1cf41"}}, {start: {_id:472}, end: {_id:17}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"analysis,interpretation", truncate:"", weight:1.0, description:"Krishnaji and the author interpret Gandhi?s experiences and choices.", created_at:1779138072, source_id:"chunk-51b5d128cc55be8ec4b28c0575f1cf41"}}, {start: {_id:472}, end: {_id:486}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"consideration,return option", truncate:"", weight:1.0, description:"Gandhi considered returning to India out of anger after the incident.", created_at:1779138072, source_id:"chunk-51b5d128cc55be8ec4b28c0575f1cf41"}}, {start: {_id:472}, end: {_id:21}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"analysis,documentation", truncate:"", weight:1.0, description:"The document analyzes Gandhi?s transformative experience in South Africa.", created_at:1779138072, source_id:"chunk-51b5d128cc55be8ec4b28c0575f1cf41"}}, {start: {_id:472}, end: {_id:278}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"rebellion,shared goals", truncate:"", weight:1.0, description:"Gandhi and Jordan share a commitment to discovery, which contrasts with Cruz's vision of control and order.", created_at:1779138072, source_id:"chunk-51b5d128cc55be8ec4b28c0575f1cf41"}}, {start: {_id:281}, end: {_id:472}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"ideological conflict,rebellion", truncate:"", weight:1.0, description:"Gandhi's actions and beliefs are in rebellion against Cruz's vision of control and order.", created_at:1779138072, source_id:"chunk-51b5d128cc55be8ec4b28c0575f1cf41"}}, {start: {_id:488}, end: {_id:489}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"inspiration,strategy", truncate:"", weight:1.0, description:"The nonviolent resistance movement inspired Gandhi's later leadership in India's independence movement.", created_at:1779138086, source_id:"chunk-ceb359127e8a043974d8be0d50ff7d93"}}, {start: {_id:487}, end: {_id:472}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"opposition,resistance", truncate:"", weight:1.0, description:"Gandhi opposed the British Empire through nonviolent resistance and led India to independence.", created_at:1779138086, source_id:"chunk-ceb359127e8a043974d8be0d50ff7d93"}}, {start: {_id:472}, end: {_id:489}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"compassion,leadership,motivation,philosophy", truncate:"", weight:2.0, description:"Gandhi initiated and led the nonviolent resistance movement against injustice in South Africa.<SEP>Gandhi's nonviolent resistance movement was motivated by compassion for his people, not personal hate.", created_at:1779179367, source_id:"chunk-ceb359127e8a043974d8be0d50ff7d93<SEP>chunk-dec047b5cab8e88110c88f8cc2cfcd7d"}}, {start: {_id:487}, end: {_id:488}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conflict,resolution", truncate:"", weight:1.0, description:"The independence movement culminated in India's peaceful liberation from the British Empire.", created_at:1779138087, source_id:"chunk-ceb359127e8a043974d8be0d50ff7d93"}}, {start: {_id:472}, end: {_id:488}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"achievement,leadership", truncate:"", weight:1.0, description:"Gandhi led India's independence movement, achieving freedom without violence.", created_at:1779138087, source_id:"chunk-ceb359127e8a043974d8be0d50ff7d93"}}, {start: {_id:472}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"inspiration,source", truncate:"", weight:1.0, description:"Gandhi's experiences and ideas are documented in The_Four_Sacred_Secrets.pdf.", created_at:1779138087, source_id:"chunk-ceb359127e8a043974d8be0d50ff7d93"}}, {start: {_id:476}, end: {_id:493}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"independence,leadership", truncate:"", weight:1.0, description:"Mahatma Gandhi led the nation of 390 million Indians to independence from British rule through non-violent resistance.", created_at:1779138113, source_id:"chunk-37e9823f1b7627730cb977ca684bcc4a"}}, {start: {_id:473}, end: {_id:491}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"alternative approach,greatness", truncate:"", weight:1.0, description:"Gandhi's emphasis on inner truth challenges traditional strategies for achieving greatness.", created_at:1779138113, source_id:"chunk-37e9823f1b7627730cb977ca684bcc4a"}}, {start: {_id:139}, end: {_id:490}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional awareness,misidentification", weight:1.0, description:"Mistaking stressful emotions for positive states due to lack of self-awareness.", created_at:1779138113, source_id:"chunk-37e9823f1b7627730cb977ca684bcc4a"}}, {start: {_id:476}, end: {_id:494}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"philosophy,resistance", truncate:"", weight:1.0, description:"Gandhi employed non-violent resistance as a core principle in his struggle for independence.", created_at:1779138113, source_id:"chunk-37e9823f1b7627730cb977ca684bcc4a"}}, {start: {_id:492}, end: {_id:493}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"colonialism,liberation", truncate:"", weight:1.0, description:"The nation overcame British colonial rule through Gandhi's leadership and non-violent methods.", created_at:1779138113, source_id:"chunk-37e9823f1b7627730cb977ca684bcc4a"}}, {start: {_id:118}, end: {_id:491}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"contrasting approach,foundational principle", weight:1.0, description:"The first sacred secret challenges traditional strategies by prioritizing inner truth over strategic planning.", created_at:1779138113, source_id:"chunk-37e9823f1b7627730cb977ca684bcc4a"}}, {start: {_id:495}, end: {_id:490}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional confusion,misidentification", weight:1.0, description:"Individuals often mistake stressful emotions for positive states due to lack of self-awareness.", created_at:1779138113, source_id:"chunk-37e9823f1b7627730cb977ca684bcc4a"}}] AS row
