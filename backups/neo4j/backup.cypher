UNWIND [{start: {_id:2162}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0k5f8G9uXqY)", keywords:"social constructs,unity", truncate:"", weight:1.0, description:"Transcending labels is essential to achieve oneness and unity among humanity.", created_at:1779157754, source_id:"chunk-90c446d17c5f31f5c15266790a0e5852"}}, {start: {_id:108}, end: {name:"Ekam"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=_XDcXdBDZ0c)", truncate:"", keywords:"divine invocation,spiritual practice", weight:1.0, description:"Ekam is chanted as part of divine blessings, linking it to the concept of the Divine.", created_at:1779165332, source_id:"chunk-a1a5a74c6d8e05a60b03459a012aa68f"}}, {start: {_id:1786}, end: {name:"Ekam"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)<SEP>unknown_source", truncate:"", keywords:"correction example,correction target,example,misheard term", weight:2.0, description:"Ekam is an example of a domain-specific term to be corrected.<SEP>The misheard term \"Ekam\" is an example of a domain-specific term that was misheard.", created_at:1779393637, source_id:"chunk-95a91e026d1863541a1b478787efb747<SEP>chunk-d66cf68ce9f6d614d8c2ffeac6619b27"}}, {start: {_id:2299}, end: {name:"Ekam"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"component,sacred structure", weight:1.0, description:"Amruta Kalesha is an integral part of Ekam's sacred architecture.", created_at:1779167089, source_id:"chunk-9f2392959877074397c1ce18b8f748b3"}}, {start: {_id:2309}, end: {name:"Ekam"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"linguistic accuracy,philosophical context", weight:1.0, description:"Ekam is used correctly in the text without errors.", created_at:1779167181, source_id:"chunk-5dcadb28ba25332dd33280807411fe6e"}}, {start: {_id:2359}, end: {name:"Suffering State"}, properties:{file_path:"unknown_source", keywords:"disconnection,impact", truncate:"", weight:1.0, description:"Disconnection perpetuates collective suffering through anxiety and division.", created_at:1779173268, source_id:"chunk-a29dd9226d9c6641c3dfa10db6f15eb5"}}, {start: {_id:506}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"negativity,self-engagement", truncate:"", weight:1.0, description:"Suffering arises from self-engagement and repetitive negative thoughts.", created_at:1779173268, source_id:"chunk-0b93a19f07fdaada8a87bb7bfa37fae9"}}, {start: {_id:17}, end: {name:"Suffering"}, properties:{file_path:"unknown_source<SEP>YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", keywords:"existential analysis,insight,self-awareness,spiritual context", truncate:"", weight:2.0, description:"Krishnaji's teachings link suffering to self-engagement and its dissolution.<SEP>Krishnaji analyzes suffering in spiritual terms.", created_at:1779662139, source_id:"chunk-0b93a19f07fdaada8a87bb7bfa37fae9<SEP>chunk-ccf8c615204507c39f3ca144b897ce7d"}}, {start: {_id:2370}, end: {name:"Suffering State"}, properties:{file_path:"unknown_source", keywords:"human specificity,self-absorption", truncate:"", weight:1.0, description:"Suffering arises from self-referential inner dialogue unique to humans.`", created_at:1779173269, source_id:"chunk-bd988ca2fbb6c189e4b536ea7d78104c"}}, {start: {_id:2372}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"causation,disconnection", truncate:"", weight:1.0, description:"Self-obsessed thoughts directly cause suffering and disconnection from reality.`", created_at:1779173270, source_id:"chunk-bd988ca2fbb6c189e4b536ea7d78104c"}}, {start: {_id:137}, end: {name:"Suffering State"}, properties:{file_path:"unknown_source", keywords:"agitation,self-obsession", truncate:"", weight:1.0, descripti