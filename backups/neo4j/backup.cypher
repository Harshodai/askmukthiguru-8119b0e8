eated_at:1779236734, source_id:"chunk-b4fe0cbe12e5b4a3116f1a065a295316"}}, {start: {_id:3671}, end: {_id:2215}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"emotional connection,healing", weight:1.0, description:"Colleagues can use Listening to help each other heal.", created_at:1779236734, source_id:"chunk-b4fe0cbe12e5b4a3116f1a065a295316"}}, {start: {_id:3671}, end: {_id:3682}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"emotional connection,healing", weight:1.0, description:"Colleagues can use Holding to help each other heal.", created_at:1779236734, source_id:"chunk-b4fe0cbe12e5b4a3116f1a065a295316"}}, {start: {_id:3684}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"hosting,source", weight:1.0, description:"The YouTube video hosts the original TED talk transcript.", created_at:1779236793, source_id:"chunk-2b42ee8fd386f9e10963b4508c131024"}}, {start: {_id:1791}, end: {_id:3684}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", keywords:"correction,editing", truncate:"", weight:1.0, description:"The corrected text is derived from the original transcript with grammatical improvements.", created_at:1779236793, source_id:"chunk-2b42ee8fd386f9e10963b4508c131024"}}, {start: {_id:1791}, end: {_id:794}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"conceptual emphasis,thematic message", weight:1.0, description:"The corrected text emphasizes heart intelligence as critical for worldwide healing.", created_at:1779236793, source_id:"chunk-2b42ee8fd386f9e10963b4508c131024"}}, {start: {_id:1791}, end: {_id:3683}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"conceptual reference,thematic message", weight:1.0, description:"The corrected text includes the phrase \"the world to be healed,\" highlighting world healing as a central theme tied to heart intelligence.", created_at:1779236794, source_id:"chunk-2b42ee8fd386f9e10963b4508c131024"}}, {start: {_id:3685}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", keywords:"content theme,repetition", truncate:"", weight:3.0, description:"The video features repeated use of the term \"immune,\" suggesting it as a central thematic element.<SEP>The YouTube Video contains repeated mentions of the concept \"immune\", suggesting it as a central theme.", created_at:1779236912, source_id:"chunk-e4f69c3d781bdabd783bd4c228c2e28c<SEP>chunk-e69254036bef20e8d5497ffdee26a7aa"}}, {start: {_id:348}, end: {_id:3687}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"reference,source", weight:1.0, description:"The YouTube Video is linked to the provided URL as its source.", created_at:1779236949, source_id:"chunk-6677368e048351336b65843a972054ea"}}, {start: {_id:348}, end: {_id:3686}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"content,theme", weight:1.0, description:"The YouTube Video features the repeated term \"immune\" as its primary content or thematic element.", created_at:1779236950, source_id:"chunk-6677368e048351336b65843a972054ea"}}] AS row
