UNWIND [{start: {_id:5544}, end: {_id:2232}, properties:{file_path:"unknown_source<SEP>YouTube Video: yJoWk10CSjg (URL: https://www.youtube.com/watch?v=yJoWk10CSjg)", keywords:"divine symbolism,ecological reverence,protection,religious", truncate:"", weight:2.0, description:"Hinduism is linked to the protection of Mother Earth through its great religions.<SEP>Hinduism's deity Ganesha embodies the unity of nature and life, reinforcing ecological harmony.", created_at:1779537013, source_id:"chunk-2c155ca915a56ff1bf0ef30ef075e557<SEP>chunk-c09aade9dbfd355fb478c083ce9dcbcd"}}, {start: {_id:123}, end: {_id:5836}, properties:{file_path:"YouTube Video: yJoWk10CSjg (URL: https://www.youtube.com/watch?v=yJoWk10CSjg)", truncate:"", keywords:"ethical responsibility,interconnectedness", weight:1.0, description:"Humanity's peace is contingent on the well-being of all living beings, reflecting their shared existence.", created_at:1779536560, source_id:"chunk-a674092e280907c9a7ef3fa28f1ef9b8"}}, {start: {_id:5844}, end: {_id:2452}, properties:{file_path:"YouTube Video: yJoWk10CSjg (URL: https://www.youtube.com/watch?v=yJoWk10CSjg)", keywords:"mystic connection,unity", truncate:"", weight:1.0, description:"Humans and nature are described as interconnected through mystic bonds, fostering universal intelligence.", created_at:1779536560, source_id:"chunk-a674092e280907c9a7ef3fa28f1ef9b8"}}, {start: {_id:1071}, end: {_id:5836}, properties:{file_path:"YouTube Video: yJoWk10CSjg (URL: https://www.youtube.com/watch?v=yJoWk10CSjg)", truncate:"", keywords:"sentience,shared ownership", weight:1.0, description:"The earth is portrayed as a shared entity for all sentient living beings, emphasizing collective stewardship.", created_at:1779536560, source_id:"chunk-a674092e280907c9a7ef3fa28f1ef9b8"}}, {start: {_id:5844}, end: {_id:1798}, properties:{file_path:"YouTube Video: yJoWk10CSjg (URL: https://www.youtube.com/watch?v=yJoWk10CSjg)", keywords:"mystic connection,oneness", truncate:"", weight:1