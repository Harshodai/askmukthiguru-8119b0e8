operties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"behavioral response,emotional manifestation", weight:1.0, description:"The wounded child state manifests through suffering states characterized by dwelling on past pain or stress.", created_at:1779137831, source_id:"chunk-f34d4c3475c783164c62af4dbf5b6c3c"}}, {start: {_id:454}, end: {_id:354}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional transformation,positive feelings", weight:1.0, description:"The happy child state fosters a profound sense of belonging transcending cultural and linguistic barriers.", created_at:1779137893, source_id:"chunk-c9bf814a48dc1240281eb32fd8bfe8b4"}}, {start: {_id:179}, end: {_id:377}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"inner conflict,psychological impact", truncate:"", weight:1.0, description:"The wounded child state influences the present inner state by projecting past hurts into current experiences.", created_at:1779137893, source_id:"chunk-c9bf814a48dc1240281eb32fd8bfe8b4"}}, {start: {_id:40}, end: {_id:457}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional healing,positive outcomes", truncate:"", weight:1.0, description:"Achieving calm enables the development of trust in life's transformative potential.", created_at:1779137893, source_id:"chunk-c9bf814a48dc1240281eb32fd8bfe8b4"}}, {start: {_id:456}, end: {_id:38}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional state,psychological effect", truncate:"", weight:1.0, description:"The suering state generates inner agitation when actively resisted, perpetuating emotional turmoil.", created_at:1779137893, source_id:"chunk-c9bf814a48dc1240281eb32fd8bfe8b4"}}, {start: {_id:354}, end: {_id:299}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional transformation,universal connection", weight:1.0, description:"The happy child state cultivates unconditional love and kinship with all people.", created_at:1779137893, source_id:"chunk-c9bf814a48dc1240281eb32fd8bfe8b4"}}, {start: {_id:453}, end: {_id:40}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional healing,prosperity", truncate:"", weight:1.0, description:"The state of calm attracts greater abundance through transformed energy patterns.", created_at:1779137893, source_id:"chunk-c9bf814a48dc1240281eb32fd8bfe8b4"}}, {start: {_id:454}, end: {_id:299}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional connection,universal feelings", weight:1.0, description:"Belonging and love together create a foundation for transcendent human connection.", created_at:1779137893, source_id:"chunk-c9bf814a48dc1240281eb32fd8bfe8b4"}}, {start: {_id:459}, end: {_id:357}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"confrontation,guidance", truncate:"", weight:1.0, description:"The big lion confronts the lion cub?s self-doubt, dragging him to the river to trigger self-realization.", created_at:1779137910, source_id:"chunk-345cde2de9df7f9434b23cd5a304db8f"}}, {start: {_id:357}, end: {_id:140}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"reflection,self-discovery", truncate:"", weight:1.0, description:"The river?s reflection prompts the lion cub to recognize his inherent power and roar.", created_at:1779137910, source_id:"chunk-345cde2de9df7f9434b23cd5a304db8f"}}, {start: {_id:357}, end: {_id:458}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"empowerment,transformation", truncate:"", weight:1.0, description:"The roar marks the lion cub?s transformation from self-doubt to self-awareness and power.", created_at:1779137910, source_id:"chunk-345cde2de9df7f9434b23cd5a304db8f"}}, {start: {_id:460}, end: {_id:357}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"awe,impact", truncate:"", weight:1.0, description:"The jungle animals? silence reflects their awe at the lion cub?s roar and newfound power.", created_at:1779137910, source_id:"chunk-345cde2de9df7f9434b23cd5a304db8f"}}, {start: {_id:354}, end: {_id:357}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"metaphor,self-perception", truncate:"", weight:1.0, description:"The happy child state metaphorically parallels the lion cub?s journey from insecurity to self-realization.", created_at:1779137910, source_id:"chunk-345cde2de9df7f9434b23cd5a304db8f"}}, {start: {_id:464}, end: {_id:377}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"healing,transformation,transition", truncate:"", weight:2.0, description:"The Soul Sync Exercise facilitates a transition from the wounded child state to the happy child state through structured steps.<SEP>The Soul Sync Exercise facilitates the transition from the wounded child state to the happy child state through conscious breathing and visualization.", created_at:1779183866, source_id:"chunk-da4a30723d6bfb88a08e73a51a9a3d62<SEP>chunk-0c3de714c4e42df4c68c8fd79dfac5ad"}}] AS row
