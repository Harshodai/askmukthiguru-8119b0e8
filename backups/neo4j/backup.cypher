UNWIND [{start: {_id:6618}, end: {_id:6619}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"effect precedes cause", truncate:"", weight:1.0, description:"In the Subatomic World, the effect (glass falling) precedes the cause (pushing).", created_at:1779563535, source_id:"chunk-5ccc31c8e1d16623e7633752bbd5a9ab"}}, {start: {_id:2528}, end: {_id:4774}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"positive outcomes", weight:1.0, description:"The Transformed State results in grace.", created_at:1779563536, source_id:"chunk-5ccc31c8e1d16623e7633752bbd5a9ab"}}, {start: {_id:3121}, end: {_id:155}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"problem resolution", truncate:"", weight:1.0, description:"Addressing problems from a transformed state leads to miracles.", created_at:1779563536, source_id:"chunk-5ccc31c8e1d16623e7633752bbd5a9ab"}}, {start: {_id:6618}, end: {_id:6617}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"definition,relationship", truncate:"", weight:1.0, description:"The Third Law defines the cause and effect relationship.", created_at:1779563536, source_id:"chunk-5ccc31c8e1d16623e7633752bbd5a9ab"}}, {start: {_id:3121}, end: {_id:4774}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"positive outcomes", weight:1.0, description:"The Transformed State results in miracles.", created_at:1779563536, source_id:"chunk-5ccc31c8e1d16623e7633752bbd5a9ab"}}, {start: {_id:6623}, end: {_id:1351}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"contrast,self-perception", truncate:"", weight:1.0, description:"Recognizing one's own blind spots is challenging, highlighting the contrast with self-awareness.", created_at:1779563552, source_id:"chunk-a5a06fbb8006348a3ccd90b704dc666e"}}, {start: {_id:6626}, end: {_id:6624}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"cause,family dynamics", truncate:"", weight:4.0, description:"Judgment in families is a result of being unenlightened.<SEP>Judgment in families is a result of being unenlightened.", created_at:1779564166, source_id:"chunk-855eeb4014bec08fbcd5dda2853ca446"}}, {start: {_id:598}, end: {_id:6624}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"cause,family dynamics", truncate:"", weight:8.0, description:"Judgment in families occurs because of the unenlightened state.<SEP>Judgment in families occurs due to the unenlightened state.<SEP>Judgment in families is a result of being unenlightened.<SEP>Judgment in families occurs because of the unenlightened state.<SEP>Judgment in families occurs due to the unenlightened state.<SEP>Judgment in families is a result of being unenlightened.", created_at:1779564185, source_id:"chunk-855eeb4014bec08fbcd5dda2853ca446"}}, {start: {_id:739}, end: {_id:598}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"context,occurrence", truncate:"", weight:2.0, description:"Judgment occurs in families, especially in the context of the unenlightened state.<SEP>Judgment occurs in families, especially in the context of the unenlightened state.", created_at:1779564185, source_id:"chunk-855eeb4014bec08fbcd5dda2853ca446"}}, {start: {_id:598}, end: {_id:1617}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"habit,nature", weight:2.0, description:"The mind's nature includes a tendency to constantly judge, making it a habit.<SEP>The mind's nature includes a tendency to constantly judge, making it a habit.", created_at:1779564185, source_id:"chunk-855eeb4014bec08fbcd5dda2853ca446"}}, {start: {_id:2082}, end: {_id:598}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"critical thinking,resistance,self-centeredness,self-perception", weight:3.0, description:"The ego resists being wrong and perceives itself as incapable of error.<SEP>The ego resists being wrong and perceives itself as incapable of error.<SEP>Ego constantly judges others and resists self-reflection, perpetuating a cycle of blame without explicitly requiring a separate \"relationships\" entity.", created_at:1779564204, source_id:"chunk-855eeb4014bec08fbcd5dda2853ca446<SEP>chunk-ab3c93f98db9784d720f1684c8d13dfb"}}, {start: {_id:6625}, end: {_id:598}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"context,occurrence", truncate:"", weight:2.0, description:"Judgment occurs globally, affecting families worldwide.<SEP>Judgment occurs globally, affecting families worldwide.", created_at:1779564185, source_id:"chunk-855eeb4014bec08fbcd5dda2853ca446"}}, {start: {_id:3697}, end: {_id:2082}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"attribution,externalization", truncate:"", weight:2.0, description:"The ego attributes unhappiness to others, externalizing blame.<SEP>The ego attributes unhappiness to others, externalizing blame.", created_at:1779564202, source_id:"chunk-855eeb4014bec08fbcd5dda2853ca446"}}, {start: {_id:6544}, end: {_id:6547}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"afterlife judgment,moral accountability", weight:1.0, description:"Chitragupta assigns individuals to hell based on their life actions and choices.", created_at:1779564201, source_id:"chunk-ab3c93f98db9784d720f1684c8d13dfb"}}, {start: {_id:6544}, end: {_id:6543}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"afterlife judgment,moral accountability", weight:1.0, description:"Chitragupta assigns individuals to heaven based on their life actions and choices.", created_at:1779564202, source_id:"chunk-ab3c93f98db9784d720f1684c8d13dfb"}}, {start: {_id:2082}, end: {_id:449}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"interpersonal conflict,self-destruction", weight:1.0, description:"Ego's refusal to acknowledge mistakes damages relationships and leads to self-destruction (corrected to remove redundant entity dependency).", created_at:1779564204, source_id:"chunk-ab3c93f98db9784d720f1684c8d13dfb"}}, {start: {_id:6547}, end: {_id:234}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"experience,location visit", truncate:"", weight:1.0, description:"The person visits hell and observes the setup with a massive table and long utensils.", created_at:1779564225, source_id:"chunk-8bc65d58c3a45098cba0eac97acb3b39"}}, {start: {_id:6543}, end: {_id:234}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"experience,location visit,observation", weight:2.0, description:"The person visits heaven and observes people helping each other eat.<SEP>The person visits heaven and observes the cooperative eating.", created_at:1779564225, source_id:"chunk-8bc65d58c3a45098cba0eac97acb3b39"}}, {start: {_id:6628}, end: {_id:234}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"artifact presence,observation", weight:1.0, description:"The person observes the massive table in hell.", created_at:1779564225, source_id:"chunk-8bc65d58c3a45098cba0eac