UNWIND [{start: {name:"Serene Mind"}, end: {_id:785}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"access,emotional detachment,solution provision", truncate:"", weight:2.0, description:"Practicing Serene Mind allows individuals to access solutions from universal intelligence by relinquishing attachments.<SEP>Practicing Serene Mind allows individuals to access universal intelligence, which presents solutions to despair.", created_at:1779187441, source_id:"chunk-6bd5636c13f54dcbb4aa1a8db98334b5<SEP>chunk-d47f9b2e2b97109267ed4aa51e7ce893"}}, {start: {name:"Serene Mind"}, end: {_id:1279}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"intuition,self-interest", truncate:"", weight:1.0, description:"Serene Mind facilitates solutions by reducing self-interest and enhancing intuition or inspiration.", created_at:1779143371, source_id:"chunk-9d4d6de56ac10d5ab428310e3d4ea053"}}, {start: {name:"Serene Mind"}, end: {_id:1143}, properties:{file_path:"unknown_source", keywords:"clarity,foundation,prerequisite", truncate:"", weight:2.0, description:"Dissolving suffering states through Serene Mind is essential for spiritual right action.<SEP>Serene Mind is essential for making spiritual right actions aligned with universal intelligence.", created_at:1779187435, source_id:"chunk-03367dd9ee49f7699a39e3df3605c23c<SEP>chunk-f85d41f2377858e80129dfbf7af31bf8"}}, {start: {name:"Yoga"}, end: {_id:5073}, properties:{file_path:"unknown_source<SEP>YouTube Video: OnAAtrwsfOc (URL: https://www.youtube.com/watch?v=OnAAtrwsfOc)", keywords:"application,current intention,focus,intended outcome,intended purpose,modern application,purpose", truncate:"", weight:5.0, created_at:1779441604, description:"Yoga is also applied to promote youthfulness in contemporary times.<SEP>Yoga is also associated with fostering youthfulness in contemporary practice.<SEP>Yoga's purpose includes youthfulness as another intended outcome.<SEP>Yoga is described as being intended for youthfulness in contemporary contexts.<SEP>Youthfulness is another current intention of yoga.", source_id:"chunk-3c35da3ef16cded7b3dd200cbc19a5f4<SEP>chunk-b0711a74429c017f31e7a7d0d9eeca01<SEP>chunk-4b35201ea3b2c1a816e4f9f7600e1284<SEP>chunk-cbc63c32944f9f552dca3de43ae2906d<SEP>chunk-fcb0245a76a7b396fd778f0392cfe0f8"}}, {start: {name:"Yoga"}, end: {_id:5144}, properties:{file_path:"YouTube Video: OnAAtrwsfOc (URL: https://www.youtube.com/watch?v=OnAAtrwsfOc)", truncate:"", keywords:"content topic,video content", weight:1.0, description:"The video discusses yoga's origins and its perceived future trajectory.", created_at:1779440970, source_id:"chunk-d7ea1b9fc81f64e7ae9644bf15bc144a"}}, {start: {name:"Serene Mind"}, end: {_id:5889}, properties:{file_path:"unknown_source", keywords:"emotional regulation,mindfulness", truncate:"", weight:1.0, description:"Serene mind is practiced when experiencing distraction or disturbance to restore calmness.", created_at:1779552069, source_id:"chunk-48f438418db1330dddb1b4a3303306e1"}}, {start: {name:"Serene Mind"}, end: {_id:5890}, properties:{file_path:"unknown_source", keywords:"mindfulness,present-moment focus", truncate:"", weight:1.0, description:"Serene mind helps redirect attention from past regrets or future anxieties to the present.", created_at:1779552069, source_id:"chunk-48f438418db1330dddb1b4a3303306e1"}}, {start: {name:"Serene Mind"}, end: {_id:5891}, properties:{file_path:"unknown_source", keywords:"intentional practice,self-regulation", truncate:"", weight:1.0, description:"Serene mind serves as a method to consciously return to equilibrium.", created_at:1779552069, source_id:"chunk-48f438418db1330dddb1b4a3303306e1"}}, {start: {name:"Serene Mind"}, end: {_id:5892}, properties:{file_path:"YouTube Video: igSp4H0OWLE (URL: https://www.youtube.com/watch?v=igSp4H0OWLE)", truncate:"", keywords:"emotional awareness,recognition", weight:1.0, description:"The practice involves recognizing and acknowledging current 