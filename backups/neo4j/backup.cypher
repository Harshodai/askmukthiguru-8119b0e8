UNWIND [{start: {_id:3511}, end: {_id:123}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AB-t5CoxMHM)", truncate:"", keywords:"conflict,identity formation", weight:1.0, description:"Perceiving differences leads to conflict and division among humans.", created_at:1779232054, source_id:"chunk-c69cfc9260a595202e649b77a2983253"}}, {start: {_id:3503}, end: {_id:123}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AB-t5CoxMHM)", truncate:"", keywords:"foundation,societal structure", weight:1.0, description:"The educational system is presented as the basis for careers and achievements within humanity's structure.", created_at:1779232099, source_id:"chunk-ce09b6c6a2ea185889fd9682aa9fd726"}}, {start: {_id:3504}, end: {_id:123}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AB-t5CoxMHM)", keywords:"fragmentation,impact", truncate:"", weight:1.0, description:"Civilizational progress is linked to increased societal divisions.", created_at:1779232099, source_id:"chunk-ce09b6c6a2ea185889fd9682aa9fd726"}}, {start: {_id:123}, end: {_id:3505}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AB-t5CoxMHM)", keywords:"differentiation,impact", truncate:"", weight:1.0, description:"Scientific advancement exacerbates factors dividing people.", created_at:1779232099, source_id:"chunk-ce09b6c6a2ea185889fd9682aa9fd726"}}, {start: {_id:3506}, end: {_id:123}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AB-t5CoxMHM)", keywords:"differentiation,method", truncate:"", weight:1.0, description:"Clothes are used as a means of creating divisions.", created_at:1779232099, source_id:"chunk-ce09b6c6a2ea185889fd9682aa9fd726"}}, {start: {_id:123}, end: {_id:3507}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AB-t5CoxMHM)", keywords:"differentiation,method", truncate:"", weight:1.0, description:"Lifestyle serves as a tool for standing out from others.", created_at:1779232099, source_id:"chunk-ce09b6c6a2ea185889fd9682aa9fd726"}}, {start: {_id:3508}, end: {_id:123}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AB-t5CoxMHM)", keywords:"differentiation,method", truncate:"", weight:1.0, description:"Activities are employed to foster uniqueness.", created_at:1779232099, source_id:"chunk-ce09b6c6a2ea185889fd9682aa9fd726"}}, {start: {_id:2201}, end: {_id:123}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AB-t5CoxMHM)", truncate:"", keywords:"manifestation,mental health", weight:1.0, description:"The obsession with uniqueness is framed as a disease affecting the human mind.", created_at:1779232100, source_id:"chunk-ce09b6c6a2ea185889fd9682aa9fd726"}}, {start: {_id:123}, end: {_id:3512}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AB-t5CoxMHM)", truncate:"", keywords:"manifestation,mental health", weight:1.0, description:"Sickness is described alongside disease as a mental health challenge.", created_at:1779232100, source_id:"chunk-ce09b6c6a2ea185889fd9682aa9fd726"}}, {start: {_id:2119}, end: {_id:123}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AB-t5CoxMHM)", truncate:"", keywords:"focus,healing", weight:1.0, description:"The human mind is identified as requiring healing to overcome divisions.", created_at:1779232100, source_id:"chunk-ce09b6c6a2ea185889fd9682aa9fd726"}}, {start: {_id:3514}, end: {_id:1761}, properties:{file_path:"unknown_source", keywords:"conceptual link,spiritual presence", truncate:"", weight:1.0, description:"antir yamin describes the divine's manifestation within the heart.", created_at:1779232626, source_id:"chunk-37d176f97b7ba2ae42fdf4ae41e9150e"}}, {start: {_id:1679}, end: {_id:3513}, properties:{file_path:"unknown_source", keywords:"spiritual practice,temporal context", 