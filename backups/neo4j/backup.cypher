.", created_at:1779173830, source_id:"chunk-5c8f3b58191cd7eb20e97c7adfd8085c"}}, {start: {_id:2477}, end: {name:"Oneness"}, properties:{file_path:"unknown_source", keywords:"example,interconnectedness", truncate:"", weight:1.0, description:"Human body communication illustrates oneness.", created_at:1779173830, source_id:"chunk-5c8f3b58191cd7eb20e97c7adfd8085c"}}, {start: {_id:479}, end: {name:"Oneness"}, properties:{file_path:"unknown_source", truncate:"", keywords:"outcome,personal healing", weight:1.0, description:"Oneness leads to healing.", created_at:1779173831, source_id:"chunk-5c8f3b58191cd7eb20e97c7adfd8085c"}}, {start: {_id:2586}, end: {name:"Karma"}, properties:{file_path:"unknown_source", keywords:"example,manifestation", truncate:"", weight:1.0, description:"Humanity's Karma exemplifies collective karma through events like the COVID-19 pandemic.", created_at:1779174300, source_id:"chunk-8828f50e6038efd15058fd650efc925a"}}] AS row
