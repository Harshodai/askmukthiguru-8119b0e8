UNWIND [{start: {_id:6}, end: {_id:0}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"discussion,product development", truncate:"", weight:1.0, description:"CFO discusses the meditation app as part of their work, indicating its role in their professional activities.", created_at:1779135263, source_id:"chunk-371c6c26a34760723cf924823ebf0f83"}}, {start: {_id:11}, end: {_id:5}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"core objectives,life vision", truncate:"", weight:1.0, description:"Prosperity and love are central to achieving the lives humans dream of through greater power.", created_at:1779135263, source_id:"chunk-371c6c26a34760723cf924823ebf0f83"}}, {start: {_id:2}, end: {_id:1}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"contrast,limitation", truncate:"", weight:1.0, description:"Strategies for awakening aim to transcend the limitations of tactical approaches that only yield temporary results.", created_at:1779135263, source_id:"chunk-371c6c26a34760723cf924823ebf0f83"}}, {start: {_id:6}, end: {_id:9}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional state,maintenance", truncate:"", weight:1.0, description:"CFO maintains inner stillness during the conversation with Jordan, demonstrating composure amidst discussion of the meditation app.", created_at:1779135264, source_id:"chunk-371c6c26a34760723cf924823ebf0f83"}}, {start: {_id:3}, end: {_id:2}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"components,practices", truncate:"", weight:1.0, description:"Ancient disciplines and trendy hacks are specific practices within the broader strategies for awakening.", created_at:1779135264, source_id:"chunk-371c6c26a34760723cf924823ebf0f83"}}, {start: {_id:2}, end: {_id:4}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"content origin,source", truncate:"", weight:1.0, description:"The Four Sacred Secrets.pdf serves as the source document containing the text about l