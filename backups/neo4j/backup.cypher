UNWIND [{start: {_id:3254}, end: {_id:3282}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"criticism,ideological framework", weight:1.0, description:"America's reliance on values and ideals to counter racial violence is deemed inadequate.", created_at:1779192044, source_id:"chunk-3ae96ad01fcb39bd7a75f6d45072f0d6"}}, {start: {_id:3254}, end: {_id:1395}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"insufficiency,leadership,leadership shortage,societal expectations", weight:2.0, description:"America lacks sufficient leaders to guide the nation toward peace and justice.<SEP>America historically looks up to leaders to guide the nation toward peace and truth.", created_at:1779193256, source_id:"chunk-3ae96ad01fcb39bd7a75f6d45072f0d6<SEP>chunk-0cb21e09915c74bf08c75e2e9b3c1480"}}, {start: {_id:3286}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"historical analysis,social commentary", weight:1.0, description:"The video explores the Italian Rebellion as an example of violence from societal tensions.", created_at:1779192110, source_id:"chunk-9d6f79b5d9addaa1bb7ed5a41e6ca13e"}}, {start: {_id:3291}, end: {_id:486}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"discrimination,social hierarchy", weight:1.0, description:"India's discrimination is rooted in caste-based social stratification.", created_at:1779192110, source_id:"chunk-9d6f79b5d9addaa1bb7ed5a41e6ca13e"}}, {start: {_id:3256}, end: {_id:3296}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"cultural conflict,discrimination", weight:1.0, description:"The Middle East's challenges are associated with religious-based discrimination.", created_at:1779192110, source_id:"chunk-9d6f79b5d9addaa1bb7ed5a41e6ca13e"}}, {start: {_id:3254}, end: {_id:3294}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"discrimination,social division", weight:1.0, description:"America's societal structure is tied to racial discrimination as a basis for social hierarchy.", created_at:1779192110, source_id:"chunk-9d6f79b5d9addaa1bb7ed5a41e6ca13e"}}, {start: {_id:3257}, end: {_id:3293}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"discrimination,economic hierarchy", weight:1.0, description:"China's societal issues are linked to class-based discrimination.", created_at:1779192110, source_id:"chunk-9d6f79b5d9addaa1bb7ed5a41e6ca13e"}}, {start: {_id:755}, end: {_id:3271}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"conflict resolution,fragility,paradox,prevalence", weight:2.0, description:"The text contrasts peace and violence, arguing that true peace cannot emerge from violent means.<SEP>Peace is fragile due to the pervasive presence of violence in society.", created_at:1779193196, source_id:"chunk-9d6f79b5d9addaa1bb7ed5a41e6ca13e<SEP>chunk-638abb6fbdf727a0284e50fe14e82b1f"}}, {start: {_id:3292}, end: {_id:3297}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"cultural transmission,social conditioning", weight:1.0, description:"Discriminatory behaviors are perpetuated through stories passed down by parents and grandparents.", created_at:1779192111, source_id:"chunk-9d6f79b5d9addaa1bb7ed5a41e6ca13e"}}, {start: {_id:3295}, end: {_id:3298}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"collective action,social change", weight:1.0, description:"Demonstrations are proposed to advocate for ending violence and promoting peace.", created_at:1779192111, source_id:"chunk-9d6f79b5d9addaa1bb7ed5a41e6ca13e"}}, {start: {_id:3302}, end: {_id:123}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"evolution,peaceful transition", weight:1.0, description:"Humanity transitions from violent revolutions to peaceful methods for societal change.", created_at:1779192139, source_id:"chunk-6e3da3d5c67b838008777970dd3f104c"}}, {start: {_id:3303}, end: {_id:3300}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"combat,education,unity", weight:2.0, description:"Teachers actively route out division and discrimination, educating young minds on interconnectedness.<SEP>Teachers must consciously route out ideas of division and discrimination from young minds.", created_at:1779192795, source_id:"chunk-6e3da3d5c67b838008777970dd3f104c<SEP>chunk-a466e41ebd2dd29a05776a329c8e9dec"}}, {start: {_id:3304}, end: {_id:218}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", keywords:"intergenerational,storytelling", truncate:"", weight:1.0, description:"Parents transmit values of connection and oneness to children through narratives and conversations.", created_at:1779192139, source_id:"chunk-6e3da3d5c67b838008777970dd3f104c"}}, {start: {_id:1490}, end: {_id:3305}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"inner evolution,peaceful change", weight:1.0, description:"Human consciousness must evolve to use peaceful methods as triggers for external revolution, moving beyond violent approaches.", created_at:1779192139, source_id:"chunk-6e3da3d5c67b838008777970dd3f104c"}}, {start: {_id:3304}, end: {_id:3299}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", keywords:"intergenerational,storytelling", truncate:"", weight:1.0, description:"Grandparents transmit values of connection and oneness to children and grandchildren through stories and conversations.", created_at:1779192139, source_id:"chunk-6e3da3d5c67b838008777970dd3f104c"}}, {start: {_id:533}, end: {_id:3301}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", keywords:"compassion,governance", truncate:"", weight:1.0, description:"Leaders must nurture compassion in consciousness to promote peaceful societal evolution.", created_at:1779192139, source_id:"chunk-6e3da3d5c67b838008777970dd3f104c"}}, {start: {_id:3294}, end: {_id:3306}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"discrimination,interconnected biases,social hierarchy", weight:2.0, description:"Racial and social discrimination are linked through shared mechanisms of generational transmission.<SEP>Racial discrimination is a form of social discrimination.", created_at:1779193411, source_id:"chunk-7d81041aa6a8c1ffd7fa363d2179e32d<SEP>chunk-4be5f58baaab4360b84499e4e9c8f89b"}}, {start: {_id:3307}, end: {_id:3306}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"discriminatory hierarchy,societal norms,subcategory relationship", weight:2.0, description:"Gender discrimination is a subset of social discrimination, rooted in societal norms.<SEP>Social and gender discrimination reinforce each other through societal structures and norms.`", created_at:1779192613, source_id:"chunk-7d81041aa6a8c1ffd7fa363d2179e32d<SEP>chunk-08f2f333c27085728d7608b7e47baa48"}}, {start: {_id:3090}, end: {_id:3308}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"cultural legacy,transmission", weight:1.0, description:"Discrimination is transmitted across generations through family narratives and behaviors.", created_at:1779192416, source_id:"chunk-7d81041aa6a8c1ffd7fa363d2179e32d"}}, {start: {_id:292}, end: {_id:3271}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)<SEP>unknown_source", truncate:"", keywords:"cause,destructive cycle,emotional consequence,escalation,retaliation,transformation", weight:3.0, description:"Hate often culminates in violence, creating a destructive cycle of pain.`<SEP>Violence, as a form of punishment, leads to retaliation and escalation of hate.<SEP>Hate is a cause that transforms into violence.", created_at:1779675542, source_id:"chunk-08f2f333c27085728d7608b7e47baa48<SEP>chunk-97a582a6bc26174c8bc3002eb473cbb9"}}] AS row
