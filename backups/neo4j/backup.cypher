UNWIND [{start: {_id:730}, end: {_id:348}, properties:{file_path:"YouTube Video: w2qbJB6ie9Y (URL: https://www.youtube.com/watch?v=w2qbJB6ie9Y)", truncate:"", keywords:"content source,educational material", weight:1.0, description:"The video presents the transformative experience through ancient wisdom and spiritual teachings.", created_at:1779519037, source_id:"chunk-c5e7d3c06c118f2330521cd61c1462d6"}}, {start: {_id:3518}, end: {_id:1679}, properties:{file_path:"unknown_source<SEP>YouTube Video: nQpRoOOu5Yc (URL: https://www.youtube.com/watch?v=nQpRoOOu5Yc)", truncate:"", keywords:"calendar date,calendar significance,celebration,temporal alignment,temporal association,timing", weight:3.0, description:"Ugadi is celebrated on the first day of the Chaitra Masa lunar month.<SEP>Chaitra Masa is the time period during which Ugadi is celebrated.<SEP>Ugadi is celebrated on the first day of Chaitra Masa, aligning with lunar cycle transitions.", created_at:1779519051, source_id:"chunk-6af3220a340f626ce621832ca3542da1<SEP>chunk-f34e8e10dbf92b5936295383ee0c7f10"}}, {start: {_id:5539}, end: {_id:1679}, properties:{file_path:"unknown_source", truncate:"", keywords:"divine presence,spiritual transcendence", weight:1.0, description:"Ugadi is linked to the state of Astitva, achieved through spiritual awakening.", created_at:1779519040, source_id:"chunk-6af3220a340f626ce621832ca3542da1"}}, {start: {_id:5540}, end: {_id:1679}, properties:{file_path:"unknown_source", keywords:"liberating power,spiritual freedom", truncate:"", weight:1.0, description:"The divine, which liberates from Maya, is associated with the celebration of Ugadi.", created_at:1779519041, source_id:"chunk-6af3220a340f626ce621832ca3542da1"}}, {start: {_id:5539}, end: {_id:5540}, properties:{file_path:"unknown_source", truncate:"", keywords:"liberating power,liberation,spiritual freedom,spiritual transcendence", weight:2.0, description:"Astitva is a state of being that is unperturbed by Maya, representing liberation.<SEP>Maya is the power that liberates, leading to the state of Astitva.", created_at:1779519041, source_id:"chunk-6af3220a340f626ce621832ca3542da1"}}, {start: {_id:5541}, end: {_id:1679}, properties:{file_path:"YouTube Video: nQpRoOOu5Yc (URL: https://www.youtube.com/watch?v=nQpRoOOu5Yc)", truncate:"", keywords:"cultural equivalence,synonyms", weight:1.0, description:"Ugadi and Gudi Padwa are interchangeable terms for the same festival marking new beginnings in the Chaitra lunar month.", created_at:1779519051, source_id:"chunk-f34e8e10dbf92b5936295383ee0c7f10"}}, {start: {_id:5539}, end: {_id:3540}, properties:{file_path:"YouTube Video: nQpRoOOu5Yc (URL: https://www.youtube.com/watch?v=nQpRoOOu5Yc)", truncate:"", keywords:"cosmic harmony,spiritual acceptance", weight:1.0, description:"Astitva embodies acceptance of the universe's cyclical nature and life's transient dualities.", created_at:1779519051, source_id:"chunk-f34e8e10dbf92b5936295383ee0c7f10"}}, {start: {_id:3540}, end: {_id:591}, properties:{file_path:"YouTube Video: nQpRoOOu5Yc (URL: https://www.youtube.com/watch?v=nQpRoOOu5Yc)", truncate:"", keywords:"biological rhythms,existential reflection", weight:1.0, description:"The universe's cyclicality mirrors human physiological and psychological cycles, as described in the text.", created_at:1779519052, source_id:"chunk-f34e8e10dbf92b5936295383ee0c7f10"}}, {start: {_id:1679}, end: {_id:5542}, properties:{file_path:"YouTube Video: nQpRoOOu5Yc (URL: https://www.youtube.com/watch?v=nQpRoOOu5Yc)", truncate:"", keywords:"cultural tradition,festival food", weight:1.0, description:"Ugadi Pachadi is prepared and consumed during the Ugadi festival as part of its traditions.", created_at:1779519113, source_id:"chunk-6a05be89bdb9093be2522608eb8c0a87"}}, {start: {_id:5543}, end: {_id:5542}, properties:{file_path:"YouTube Video: nQpRoOOu5Yc (URL: https://www.youtube.com/watch?v=nQpRoOOu5Yc)", truncate:"", keywords:"cultural heritage,regional cuisine", weight:1.0, description:"Ugadi Pachadi is a traditional dish originating from and celebrated in South India.", created_at:1779519113, source_id:"chunk-6a05be89bdb9093be2522608eb8c0a87"}}, {start: {_id:108}, end: {_id:1679}, properties:{file_path:"YouTube Video: nQpRoOOu5Yc (URL: https://www.youtube.com/watch?v=nQpRoOOu5Yc)", truncate:"", keywords:"renewal,spiritual significance", weight:1.0, description:"The divine is invoked during Ugadi to signify liberation and new beginnings.", created_at:1779519113, source_id:"chunk-6a05be89bdb9093be2522608eb8c0a87"}}, {start: {_id:2448}, end: {_id:5542}, properties:{file_path:"YouTube Video: nQpRoOOu5Yc (URL: https://www.youtube.com/watch?v=nQpRoOOu5Yc)", truncate:"", keywords:"life experiences,symbolism", weight:1.0, description:"Ugadi Pachadi embodies the concept of Loka by representing all tastes of life.", created_at:1779519113, source_id:"chunk-6a05be89bdb9093be2522608eb8c0a87"}}, {start: {_id:179}, end: {_id:2448}, properties:{file_path:"YouTube Video: nQpRoOOu5Yc (URL: https://www.youtube.com/watch?v=nQpRoOOu5Yc)", truncate:"", keywords:"aspect,experience", weight:1.0, description:"Loka encompasses the experience of all life aspects, including the beautiful inner state.", created_at:1779519113, source_id:"chunk-6a05be89bdb9093be2522608eb8c0a87"}}, {start: {_id:108}, end: {_id:2448}, properties:{file_path:"YouTube Video: nQpRoOOu5Yc (URL: https://www.youtube.com/watch?v=nQpRoOOu5Yc)", truncate:"", keywords:"cosmic order,cyclical nature", weight:1.0, description:"The divine governs the cyclical nature of life and the balance within Loka.", created_at:1779519114, source_id:"chunk-6a05be89bdb9093be2522608eb8c0a87"}}, {start: {_id:108}, end: {_id:1974}, properties:{file_path:"YouTube Video: nQpRoOOu5Yc (URL: https://www.youtube.com/watch?v=nQpRoOOu5Yc)", keywords:"blessings,prosperity", truncate:"", weight:1.0, description:"The divine is associated with granting abundance in both external and inner worlds during Ugadi.", created_at:1779519114, source_id:"chunk-6a05be89bdb9093be2522608eb8c0a87"}}, {start: {_id:108}, end: {_id:5540}, properties:{file_path:"YouTube Video: nQpRoOOu5Yc (URL: https://www.youtube.com/watch?v=nQpRoOOu5Yc)", keywords:"bondage,liberation", truncate:"", weight:1.0, description:"The divine liberates individuals from the bondage of Maya (illusion).", created_at:1779519114, source_id:"chunk-6a05be89bdb9093be2522608eb8c0a87"}}, {start: {_id:5545}, end: {_id:4899}, properties:{file_path:"unknown_source", truncate:"", keywords:"mythological conflict,spiritual allegory", weight:2.0, description:"Durga's defeat of Mahishasura represents the dissolution of ignorance and ego in the spiritual seeker.`<SEP>...` -> Correct", created_at:1779519117, source_id:"chunk-672a64891a721958057240b2cc83a897"}}, {start: {_id:4203}, end: {_id:4201}, properties:{file_path:"unknown_source", keywords:"celebration,spiritual symbolism", truncate:"", weight:2.0, description:"Navratri is a celebration of the Mother Goddess, symbolizing the journey of spiritual awakening and the dissolution of negative states.`<SEP>...` -> Correct.", created_at:1779519117, source_id:"chunk-672a64891a721958057240b2cc83a897"}}, {start: {_id:5545}, end: {_id:5548}, properties:{file_path:"unknown_source", truncate:"", keywords:"mythological synergy,spiritual process", weight:1.0, description:"Durga awakens Maha Vishnu's Yoga Maya (illusion) to dissolve demons representing anger and greed in the spiritual seeker.`", created_at:1779519117, source_id:"chunk-672a64891a721958057240b2cc83a897"}}, {start: {_id:5546}, end: {_id:4201}, properties:{file_path:"unknown_source", truncate:"", keywords:"cultural equivalence,symbolic continuity", weight:1.0, description:"Navratri is also called Dussehra, reflecting the shared theme of overcoming darkness through divine feminine energy.`", created_at:1779519117, source_id:"chunk-672a64891a721958057240b2cc83a897"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
