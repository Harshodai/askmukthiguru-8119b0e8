UNWIND [{_id:2935, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"An authentic friendship between Clark and Doris.", created_at:1779186986, source_id:"chunk-f01f7886f64dcda0228048269c532fa0", entity_id:"Authentic Friendship"}}, {_id:2936, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A romantic partnership between Clark and Doris.", created_at:1779186986, source_id:"chunk-f01f7886f64dcda0228048269c532fa0", entity_id:"Romantic Partnership"}}, {_id:2937, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The Three Stages of Disconnection describe the progressive deterioration of relationships through hurt, judgment, and eventual emotional separation.", created_at:1779186988, source_id:"chunk-b19b2a822951a545ded34a82295b89dc", entity_id:"Three Stages of Disconnection"}}, {_id:2938, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A metaphor for disconnection, where visible small issues hide deep, destructive roots.`", created_at:1779186989, source_id:"chunk-b19b2a822951a545ded34a82295b89dc", entity_id:"Invasive Plant"}}, {_id:2939, properties:{file_path:"unknown_source<SEP>YouTube Video: HZIuHUGmnGY (URL: https://www.youtube.com/watch?v=HZIuHUGmnGY)<SEP>YouTube Video: R0bGNxoJ4sM (URL: https://www.youtube.com/watch?v=R0bGNxoJ4sM)", entity_type:"concept", truncate:"", description:"Internal state leads to a dull sensory experience.<SEP>Sensory experience describes how individuals perceive the world through their senses, which can become dull in stagnant relationships.<SEP>Sensory experiences are all physical perceptions contributing to the enlightened state of bliss.<SEP>Sensory Experience refers to perceptions through the senses, which contribute to the experience of bliss in the enlightened state.<SEP>Sensory Experience involves paying attention to minute details of hearing and seeing, enhancing awareness.<SEP>Sensory experience involves heightened attention to minute details of hearing and intricate visual perception during the state of Ananda.", created_at:1779512108, source_id:"chunk-f01f7886f64dcda0228048269c532fa0<SEP>chunk-b37ece05c6dd07c4fd1c02e2cefb7912<SEP>chunk-c195d5abc160d6408ccad089d03fdf8f<SEP>chunk-5da4be811aa540e35dbc3127e30549e4<SEP>chunk-16505689511452878f9de53f0eb16c6e<SEP>chunk-b898618f68efd08df9f5924199c43f87", entity_id:"Sensory Experience"}}, {_id:2940, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Sunil's daughter is his child with whom his relationship transforms after his spiritual awakening.", created_at:1779187070, source_id:"chunk-9a28e4054912d7c9812d1628ee5acb4a", entity_id:"Sunil's Daughter"}}, {_id:2941, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Sunil's wife is his former romantic partner who divorced him due to his inability to connect emotionally.", created_at:1779187070, source_id:"chunk-9a28e4054912d7c9812d1628ee5acb4a", entity_id:"Sunil's Wife"}}, {_id:2942, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Sunil's father is his parent with whom he had a strained relationship marked by financial transactions and emotional distance.", created_at:1779187070, source_id:"chunk-9a28e4054912d7c9812d1628ee5acb4a", entity_id:"Sunil's Father"}}, {_id:2943, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A mental state characterized by the absence of emotional hurt and self-absorption, enabling connection with others and life.", created_at:1779187071, source_id:"chunk-924b77c112ecc0d58074213d49a1a3d2", entity_id:"State of Emotional Freedom"}}, {_id:2944, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The act of being fully engaged with others' emotions, fostering nourishment and healing in relationships.", created_at:1779187072, source_id:"chunk-924b77c112ecc0d58074213d49a1a3d2", entity_id:"Human Presence"}}, {_id:2946, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=gMrOMT4mfno)", entity_type:"person", truncate:"", description:"Shri Preethaji is a Mukthi Guru participating in a global tour to promote enlightenment and inaugurate their book in Patna.<SEP>Shri Preethaji is a spiritual leader associated with Ekam and involved in inaugurating Chaar Param Rahasya.", created_at:1779226259, source_id:"chunk-77d6f5a3144b96f2147a4737563dbfb7<SEP>chunk-5ce3bc6c0c74a0d11ac1dfb141fbb291", entity_id:"Shri Preethaji"}}, {_id:2947, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"A man in an ancient Chinese story who fears his shadow and footsteps, symbolizing self-obsession.", created_at:1779187088, source_id:"chunk-b37ece05c6dd07c4fd1c02e2cefb7912", entity_id:"Man in the Story"}}, {_id:2948, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The labyrinth symbolizes the cycle of self-obsession and negative mental states like anxiety and regret.", created_at:1779187088, source_id:"chunk-b37ece05c6dd07c4fd1c02e2cefb7912", entity_id:"Labyrinth of Self-Obsession"}}, {_id:2949, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"States of hurt and staleness are self-obsessive conditions where individuals focus solely on themselves, leading to disconnection.", created_at:1779187088, source_id:"chunk-b37ece05c6dd07c4fd1c02e2cefb7912", entity_id:"States of Hurt and Staleness"}}, {_id:2950, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=gMrOMT4mfno)", entity_type:"person", truncate:"", description:"Shri Krishnaji is a Mukthi Guru collaborating with Shri Preethaji on a global journey for spiritual awakening and book promotion.<SEP>Shri Krishnaji is a spiritual leader associated with Ekam and involved in inaugurating Chaar Param Rahasya.<SEP>Shri Krishnaji is a person referenced in the text, associated with discussions on forgiveness and societal reconciliation.<SEP>Shri Krishnaji is a person referenced in the text, associated with discussions on forgiveness and societal reconciliation.<SEP>Shri Krishnaji is a person referenced in the text, associated with discussions on forgiveness and societal reconciliation.<SEP>Shri Krishnaji is a person referenced in the text, associated with discussions on forgiveness and societal reconciliation.<SEP>Shri Krishnaji is a person referenced in the text, associated with discussions on forgiveness and societal reconciliation.", created_at:1779752898, source_id:"chunk-77d6f5a3144b96f2147a4737563dbfb7<SEP>chunk-5ce3bc6c0c74a0d11ac1dfb141fbb291<SEP>chunk-9bafe94fc3b8386a6692c9d466cef05c", entity_id:"Shri Krishnaji"}}, {_id:2951, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A state where living and relating are experienced as joyful due to connection.", created_at:1779187089, source_id:"chunk-21d71f186fdeb1dfcf5eb219529f54f0", entity_id:"Joyful Experience"}}, {_id:2952, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A flawed perception of connection rooted in cultural and societal norms, leading to unfulfilled longing for authentic connection.", created_at:1779187090, source_id:"chunk-21d71f186fdeb1dfcf5eb219529f54f0", entity_id:"Connection Misunderstanding"}}, {_id:2953, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Shri Preethaji and Shri Krishnaji authored and are promoting their book during the Patna event.", created_at:1779226102, source_id:"chunk-77d6f5a3144b96f2147a4737563dbfb7", entity_id:"Shri Preethaji and Shri Krishnaji"}}, {_id:2954, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Four Sacred Secrets is available in Hindi as Chaar Param Rahasya, adapting the content for wider reach.", created_at:1779226102, source_id:"chunk-77d6f5a3144b96f2147a4737563dbfb7", entity_id:"Hindi (Chaar Param Rahasya)"}}, {_id:2955, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The interconnected, universal consciousness that underlies all existence, with which spiritual right action aligns.", created_at:1779187170, source_id:"chunk-37c881d41553a8a7658ca326a33a2864", entity_id:"Unitary Fabric of Consciousness"}}] AS row
