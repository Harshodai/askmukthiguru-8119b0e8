UNWIND [{start: {_id:1615}, end: {_id:4389}, properties:{file_path:"unknown_source", keywords:"breath alignment,harmony state", truncate:"", weight:1.0, description:"Swasa emphasizes alignment with breath as a key aspect of its state.", created_at:1779346706, source_id:"chunk-6ceaf029b184877ef7237e73de7e90eb"}}, {start: {_id:4390}, end: {_id:4389}, properties:{file_path:"unknown_source", keywords:"bodily alignment,harmony state", truncate:"", weight:1.0, description:"Swasa emphasizes harmony at the bodily level as part of its holistic definition.", created_at:1779346706, source_id:"chunk-6ceaf029b184877ef7237e73de7e90eb"}}, {start: {_id:4393}, end: {_id:4389}, properties:{file_path:"unknown_source", keywords:"divine unity,harmony state", truncate:"", weight:1.0, description:"Swasa includes harmony with the inner divine as part of its complete state.", created_at:1779346706, source_id:"chunk-6ceaf029b184877ef7237e73de7e90eb"}}, {start: {_id:4397}, end: {_id:4402}, properties:{file_path:"unknown_source", keywords:"existence,interconnectedness", truncate:"", weight:1.0, description:"The reality of connection is rooted in the inseparable link to the world and all its components.", created_at:1779347427, source_id:"chunk-d2b88d2b3bf551cfbcb60d2a9d77ae9c"}}, {start: {_id:4399}, end: {_id:123}, properties:{file_path:"unknown_source", keywords:"contribution,interconnectedness", truncate:"", weight:1.0, description:"Humanity's historical and collective existence contributes to the realization of interconnectedness.", created_at:1779347427, source_id:"chunk-d2b88d2b3bf551cfbcb60d2a9d77ae9c"}}, {start: {_id:4394}, end: {_id:4400}, properties:{file_path:"unknown_source", keywords:"interdependence,unity", truncate:"", weight:1.0, description:"Interconnectedness and interdependence are inseparable aspects of the same universal principle.", created_at:1779347427, source_id:"chunk-d2b88d2b3bf551cfbcb60d2a9d77ae9c"}}, {start: {_id:4399}, end: {_id:4398}, properties:{file_path:"unknown_source", keywords:"contribution,interconnectedness", truncate:"", weight:1.0, description:"Nature and Earth provide the material and spiritual foundation for awakening to interconnectedness.", created_at:1779347427, source_id:"chunk-d2b88d2b3bf551cfbcb60d2a9d77ae9c"}}, {start: {_id:4399}, end: {_id:4396}, properties:{file_path:"unknown_source", keywords:"contribution,interconnectedness", truncate:"", weight:1.0, description:"All life forms collectively create the conditions for recognizing universal interdependence.", created_at:1779347428, source_id:"chunk-d2b88d2b3bf551cfbcb60d2a9d77ae9c"}}, {start: {_id:4399}, end: {_id:4395}, properties:{file_path:"unknown_source", keywords:"foundation,purpose", truncate:"", weight:1.0, description:"Awakening in consciousness is the foundation for living a purposeful, interconnected life.", created_at:1779347428, source_id:"chunk-d2b88d2b3bf551cfbcb60d2a9d77ae9c"}}, {start: {_id:4399}, end: {_id:4401}, properties:{file_path:"unknown_source", keywords:"awareness,unity", truncate:"", weight:1.0, description:"Awakening in consciousness leads to recognizing the undivided field of consciousness encompassing all existence.", created_at:1779347428, source_id:"chunk-d2b88d2b3bf551cfbcb60d2a9d77ae9c"}}, {start: {_id:4405}, end: {_id:4404}, properties:{file_path:"unknown_source", truncate:"", keywords:"conceptual relationship,inherent aspect", weight:1.0, description:"Awakened consciousness involves realizing one's eternal nature.", created_at:1779390808, source_id:"chunk-40b40d077b6b6ad2e3eb8995f7aa43cd"}}, {start: {_id:1335}, end: {_id:4408}, properties:{file_path:"unknown_source<SEP>YouTube Video: UNdwPjyLGn0 (URL: https://www.youtube.com/watch?v=UNdwPjyLGn0)", keywords:"negation,philosophical teaching,self-perception,spiritual teaching", truncate:"", weight:2.0, description:"Buddha teaches that the permanent self is an illusion to be realized through awakening.<SEP>Buddha taught that the permanent self is an illusion to be realized.", created_at:1779390935, source_id:"chunk-40b40d077b6b6ad2e3eb8995f7aa43cd<SEP>chunk-52d567ecc552b96b146755df515ac0bd"}}, {start: {_id:1335}, end: {_id:4403}, properties:{file_path:"unknown_source", keywords:"negation,spiritual teaching", truncate:"", weight:1.0, description:"Buddha emphasizes the isolated self as a false perception to be overcome.", created_at:1779390808, source_id:"chunk-40b40d077b6b6ad2e3eb8995f7aa43cd"}}, {start: {_id:4405}, end: {_id:4406}, properties:{file_path:"unknown_source", truncate:"", keywords:"conceptual relationship,inherent aspect", weight:1.0, description:"Awakened consciousness encompasses the understanding of interconnectedness.", created_at:1779390808, source_id:"chunk-40b40d077b6b6ad2e3eb8995f7aa43cd"}}, {start: {_id:1335}, end: {_id:4404}, properties:{file_path:"unknown_source", keywords:"realization,spiritual teaching", truncate:"", weight:1.0, description:"Buddha asserts that awakening leads to the realization of one's eternal nature.", created_at:1779390808, source_id:"chunk-40b40d077b6b6ad2e3eb8995f7aa43cd"}}, {start: {_id:1335}, end: {_id:4406}, properties:{file_path:"unknown_source", keywords:"realization,spiritual teaching", truncate:"", weight:1.0, description:"Buddha highlights interconnectedness as a key aspect of awakened consciousness.", created_at:1779390809, source_id:"chunk-40b40d077b6b6ad2e3eb8995f7aa43cd"}}, {start: {_id:1474}, end: {_id:1335}, properties:{file_path:"unknown_source<SEP>YouTube Video: UNdwPjyLGn0 (URL: https://www.youtube.com/watch?v=UNdwPjyLGn0)", truncate:"", keywords:"awakening,exclusivity,spiritual concept,spiritual teaching,teaching,universal application", weight:3.0, created_at:1779391138, description:"Buddha asserts that awakening is not exclusive to him and is achievable by all.<SEP>The Buddha maintained that awakening is not exclusive to him, emphasizing its universal availability.<SEP>The Buddha taught that awakening is not exclusive to him.", source_id:"chunk-40b40d077b6b6ad2e3eb899