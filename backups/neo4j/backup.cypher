UNWIND [{start: {_id:6253}, end: {_id:6236}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"neurochemical dependency,psychological response", weight:1.0, description:"Dopamine dependency creates a cycle of craving more euphoric experiences.", created_at:1779557000, source_id:"chunk-9a7c58d7cc886bef4c4d232cf5fffc42"}}, {start: {_id:6236}, end: {_id:6247}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"emotional state,neurochemical basis", weight:1.0, description:"Euphoric love is driven by dopamine release, which later subsides.", created_at:1779557000, source_id:"chunk-9a7c58d7cc886bef4c4d232cf5fffc42"}}, {start: {_id:6255}, end: {_id:6254}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"consciousness sensitivity,emotional impact", weight:1.0, description:"Abandonment at birth negatively impacts the newborn's consciousness, making them sensitive to rejection from birth.", created_at:1779557018, source_id:"chunk-1c0d240a13e1e4d9ab6e3ad8bbc9337e"}}, {start: {_id:6256}, end: {_id:6227}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"enlightenment,personal transformation", weight:1.0, description:"Tulsidas achieved a breakthrough in consciousness, illustrating the potential for transformation despite early trauma.", created_at:1779557018, source_id:"chunk-1c0d240a13e1e4d9ab6e3ad8bbc9337e"}}, {start: {_id:6255}, end: {_id:6227}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"life story,personal history", weight:1.0, description:"Tulsidas's life story includes being abandoned at birth, which influenced his path to enlightenment.", created_at:1779557019, source_id:"chunk-1c0d240a13e1e4d9ab6e3ad8bbc9337e"}}, {start: {_id:6227}, end: {_id:6260}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"emotional impact,psychological imprint", weight:1.0, description:"Tulsidas develops destructive samskara due to early abandonment, creating lifelong longing for love.", created_at:1779557032, source_id:"chunk-9c98dc777cc549809cb267c54df4e36b"}}, {start: {_id:6227}, end: {_id:6258}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"emotional experience,neurochemical response", weight:1.0, description:"Tulsidas's brain is charged with romance-related chemicals (e.g., dopamine) during romantic experiences.", created_at:1779557032, source_id:"chunk-9c98dc777cc549809cb267c54df4e36b"}}, {start: {_id:6260}, end: {_id:6261}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"causes,psychological development", weight:1.0, description:"The absence of love in infancy leads to the formation of destructive samskara in Tulsidas's consciousness.", created_at:1779557032, source_id:"chunk-9c98dc777cc549809cb267c54df4e36b"}}, {start: {_id:6227}, end: {_id:6259}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"emotional attachment,physical response", weight:1.0, description:"Tulsidas associates the chemistry of pleasure with his attachment to his wife and romantic love.", created_at:1779557033, source_id:"chunk-9c98dc777cc549809cb267c54df4e36b"}}, {start: {_id:6257}, end: {_id:6227}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", keywords:"adoption,upbringing", truncate:"", weight:1.0, description:"Kind woman raises Tulsidas after his abandonment, though his early trauma persists.", created_at:1779557033, source_id:"chunk-9c98dc777cc549809cb267c54df4e36b"}}, {start: {_id:788}, end: {_id:6236}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"euphoria,neurotransmitter release", weight:1.0, description:"The brain releases dopamine during romantic love, causing euphoric effects.", created_at:1779557055, source_id:"chunk-463088ccb7af0ca596d7f4a288f68a78"}}, {start: {_id:5614}, end: {_id:6246}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"emotional state,inhibition removal", weight:1.0, description:"Romantic love eliminates social judgment, creating uninhibited connection.", created_at:1779557055, source_id:"chunk-463088ccb7af0ca596d7f4a288f68a78"}}, {start: {_id:2753}, end: {_id:5617}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"sensory enhancement,temporary state", weight:1.0, description:"The romantic high amplifies pleasure through dopamine-driven sensory perception.", created_at:1779557055, source_id:"chunk-463088ccb7af0ca596d7f4a288f68a78"}}, {start: {_id:852}, end: {_id:5614}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"emotional state,inhibition removal", weight:1.0, description:"Romantic love removes fear, fostering open-hearted engagement.", created_at:1779557055, source_id:"chunk-463088ccb7af0ca596d7f4a288f68a78"}}, {start: {_id:6236}, end: {_id:5617}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"subsiding impact,temporary effect", weight:1.0, description:"The romantic high's euphoria is temporary as dopamine levels subside, leading to the dissipation of pleasure-driven states.", created_at:1779557056, source_id:"chunk-463088ccb7af0ca596d7f4a288f68a78"}}, {start: {_id:4399}, end: {_id:299}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"consciousness shift,spiritual transformation", weight:1.0, description:"Awakening to love signifies a profound consciousness transformation beyond transient pleasure, emphasizing universal connection and selflessness.", created_at:1779557056, source_id:"chunk-463088ccb7af0ca596d7f4a288f68a78"}}, {start: {_id:1318}, end: {_id:6234}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"misconception,symbolic interaction", weight:1.0, description:"He mistakes the python for a creeper, reflecting his distorted perception of reality.", created_at:1779557129, source_id:"chunk-98e0115fe065f5dab78321b7c772863d"}}, {start: {_id:497}, end: {_id:6265}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", keywords:"critique,truth-telling", truncate:"", weight:1.0, description:"She challenges his dependence, exposing it as unsustainable and self-destructive.", created_at:1779557129, source_id:"chunk-98e0115fe065f5dab78321b7c772863d"}}, {start: {_id:6268}, end: {_id:6269}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"symbolic contrast", weight:1.0, description:"The clash between his intense emotions and the clarity brought by her words.", created_at:1779557129, source_id:"chunk-98e0115fe065f5dab78321b7c772863d"}}, {start: {_id:1318}, end: {_id:6265}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"conflict,emotional tension", weight:1.0, description:"Their confrontation over his obsession and her critique of his behavior.", created_at:1779557129, source_id:"chunk-98e0115fe065f5dab78321b7c772863d"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
UNWIND [{start: {_id:1318}, end: {_id:6263}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", keywords:"danger,risk-taking", truncate:"", weight:1.0, description:"He crosses the torrential river for her, symbolizing his reckless actions driven by obsession.", created_at:1779557129, source_id:"chunk-98e0115fe065f5dab78321b7c772863d"}}, {start: {_id:2391}, end: {_id:1318}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"self-realization,transformation", weight:1.0, description:"His journey from obsession to self-awareness and the pursuit of inner healing.", created_at:1779557129, source_id:"chunk-98e0115fe065f5dab78321b7c772863d"}}, {start: {_id:1318}, end: {_id:6270}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"confrontation setting,emotional climax", weight:1.0, description:"The house serves as the backdrop for their pivotal argument and his eventual realization.", created_at:1779557129, source_id:"chunk-98e0115fe065f5dab78321b7c772863d"}}, {start: {_id:1318}, end: {_id:5729}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", keywords:"cure,self-discovery", truncate:"", weight:1.0, description:"His realization leads him to seek healing through introspection and personal growth.", created_at:1779557129, source_id:"chunk-98e0115fe065f5dab78321b7c772863d"}}, {start: {_id:6272}, end: {_id:6273}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"access,spiritual experience", weight:1.0, description:"Transformed heart states enable access to the internal paradise of self-realized love.", created_at:1779557205, source_id:"chunk-1d477f5607ac5cfb56e2b711bd58f1aa"}}, {start: {_id:6239}, end: {_id:299}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", keywords:"opposition,transcendence", truncate:"", weight:1.0, description:"Love exists beyond the hunger for love, which is described as a state of longing.", created_at:1779557206, source_id:"chunk-1d477f5607ac5cfb56e2b711bd58f1aa"}}, {start: {_id:6275}, end: {_id:299}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", keywords:"independence,self-reliance", truncate:"", weight:1.0, description:"Love is independent of external factors, relying solely on internal consciousness.", created_at:1779557206, source_id:"chunk-1d477f5607ac5cfb56e2b711bd58f1aa"}}, {start: {_id:6278}, end: {_id:6277}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"philosophical theme,spiritual concept", weight:1.0, description:"The video discusses the unsullied experience of love as an internal spiritual phenomenon.", created_at:1779557258, source_id:"chunk-91d9f7cb805ef23f08d79985435c1fe6"}}, {start: {_id:6272}, end: {_id:6277}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"metaphysical idea,spiritual concept", weight:1.0, description:"The video presents the internal paradise as a metaphor for self-realized transcendence.", created_at:1779557258, source_id:"chunk-91d9f7cb805ef23f08d79985435c1fe6"}}, {start: {_id:3720}, end: {_id:6277}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"liberation,spiritual practice", weight:1.0, description:"The video frames Mukthi as a path to transcendence through self-awakening.", created_at:1779557258, source_id:"chunk-91d9f7cb805ef23f08d79985435c1fe6"}}, {start: {_id:4559}, end: {_id:6277}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"philosophical concept,self-realization", weight:1.0, description:"The video links liberation to overcoming mental and emotional dependencies.", created_at:1779557258, source_id:"chunk-91d9f7cb805ef23f08d79985435c1fe6"}}, {start: {_id:2391}, end: {_id:6277}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"spiritual goal,ultimate truth", weight:1.0, description:"The video positions enlightenment as the culmination of self-discovery and liberation.", created_at:1779557258, source_id:"chunk-91d9f7cb805ef23f08d79985435c1fe6"}}, {start: {_id:6300}, end: {_id:6299}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"behavioral consequence,disease manifestation", weight:1.0, description:"Suppressed anger can evolve into chronic disease due to its destructive energy over time.", created_at:1779557439, source_id:"chunk-bd994984ac776d12f863ed3100d9ce68"}}, {start: {_id:497}, end: {_id:6299}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"behavioral transformation,psychological impact", weight:1.0, description:"Suppressed anger often morphs into addictive behaviors like substance abuse or compulsive actions.", created_at:1779557439, source_id:"chunk-bd994984ac776d12f863ed3100d9ce68"}}, {start: {_id:2217}, end: {_id:6299}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"manifestation,transformation", truncate:"", weight:1.0, description:"Suppressed anger can manifest as an anger outburst, which is the third form of its expression.", created_at:1779557439, source_id:"chunk-bd994984ac776d12f863ed3100d9ce68"}}, {start: {_id:6298}, end: {_id:6299}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"behavioral manifestation,examples", weight:1.0, description:"Outward anger expressions like picking fights or road rage are examples of suppressed anger's visible forms.", created_at:1779557439, source_id:"chunk-bd994984ac776d12f863ed3100d9ce68"}}, {start: {_id:6301}, end: {_id:6299}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"internalization,metaphor", truncate:"", weight:1.0, description:"The pressure cooker metaphor illustrates suppressed anger as internalized pressure that builds up before bursting out.", created_at:1779557439, source_id:"chunk-bd994984ac776d12f863ed3100d9ce68"}}, {start: {_id:5972}, end: {_id:785}, properties:{file_path:"unknown_source", keywords:"guidance,spiritual activation", truncate:"", weight:1.0, description:"Activating the pineal gland allows access to universal intelligence for ethical and emotional clarity.", created_at:1779557441, source_id:"chunk-30bdabdce129add775eb3da51d3ffd8d"}}, {start: {_id:6302}, end: {_id:6303}, properties:{file_path:"unknown_source", keywords:"cultural norms,gender bias", truncate:"", weight:1.0, description:"Societal norms historically suppressed women's spiritual potential, equating enlightenment with masculinity.", created_at:1779557442, source_id:"chunk-30bdabdce129add775eb3da51d3ffd8d"}}, {start: {_id:2021}, end: {_id:2006}, properties:{file_path:"unknown_source", keywords:"respect,societal roles", truncate:"", weight:1.0, description:"Men must respect women to receive abundance, while women must self-respect to achieve wholeness and love.", created_at:1779557442, source_id:"chunk-30bdabdce129add775eb3da51d3ffd8d"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
UNWIND [{start: {_id:453}, end: {_id:108}, properties:{file_path:"unknown_source", keywords:"prosperity,spiritual alignment", truncate:"", weight:1.0, description:"The Divine grants blessings of abundance when mutual respect and emotional harmony are present in relationships.", created_at:1779557442, source_id:"chunk-30bdabdce129add775eb3da51d3ffd8d"}}, {start: {_id:962}, end: {_id:2006}, properties:{file_path:"unknown_source", keywords:"emotional balance,self-awareness", truncate:"", weight:1.0, description:"Women must cultivate self-respect to transcend societal judgments and connect authentically with others.", created_at:1779557443, source_id:"chunk-30bdabdce129add775eb3da51d3ffd8d"}}, {start: {_id:6304}, end: {_id:2006}, properties:{file_path:"unknown_source", keywords:"intuition,neural pathways", truncate:"", weight:1.0, description:"Women's brain structure enables rapid transitions from logic to mystical states, enhancing intuitive decision-making.", created_at:1779557443, source_id:"chunk-30bdabdce129add775eb3da51d3ffd8d"}}, {start: {_id:89}, end: {_id:957}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"biochemical changes,neurological impact", weight:1.0, description:"Anger alters brain chemistry and neurology, leading to negative perception of others.", created_at:1779557490, source_id:"chunk-fdbf9aca2a79a0d5bef7d0b7c7804d67"}}, {start: {_id:89}, end: {_id:6312}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"historical consequences,violent outcomes", weight:1.0, description:"Anger-based revolutions result in violent outcomes and negative endings.", created_at:1779557490, source_id:"chunk-fdbf9aca2a79a0d5bef7d0b7c7804d67"}}, {start: {_id:89}, end: {_id:6313}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"performative,superficial", truncate:"", weight:1.0, description:"Anger energy is used in a performative manner, creating temporary and superficial changes.", created_at:1779557490, source_id:"chunk-fdbf9aca2a79a0d5bef7d0b7c7804d67"}}, {start: {_id:89}, end: {_id:169}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"motivation,personal growth", weight:1.0, description:"Anger can motivate overcoming poverty but with negative personal consequences.", created_at:1779557490, source_id:"chunk-fdbf9aca2a79a0d5bef7d0b7c7804d67"}}, {start: {_id:89}, end: {_id:6315}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"moral cost,transformation", truncate:"", weight:1.0, description:"Sustained anger transforms the individual into a destructive entity.", created_at:1779557490, source_id:"chunk-fdbf9aca2a79a0d5bef7d0b7c7804d67"}}, {start: {_id:89}, end: {_id:1335}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"consequence,emotional complexity,historical examples,teaching", weight:2.0, description:"Anger is a natural emotion even in revered figures like Buddha.<SEP>The Buddha teaches that anger harms the individual first, like burning coal in one's hand.", created_at:1779558095, source_id:"chunk-fdbf9aca2a79a0d5bef7d0b7c7804d67<SEP>chunk-a9818a0388e6c7fbe12a262f4b70178a"}}, {start: {_id:89}, end: {_id:6317}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"emotional experience,historical examples", weight:1.0, description:"Anger is a universal human emotion, as seen in Sri Krishna's experiences.", created_at:1779557491, source_id:"chunk-fdbf9aca2a79a0d5bef7d0b7c7804d67"}}, {start: {_id:6308}, end: {_id:6311}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"immune response,research", truncate:"", weight:2.0, description:"Harvard University studies link anger to temporary immunoglobulin A level drops.<SEP>Harvard University studies link anger to temporary immunoglobulin A level drops.", created_at:1779558070, source_id:"chunk-19097bf7d5cd386b3cd384082e7f375d"}}, {start: {_id:497}, end: {_id:6305}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"behavior manifestation,emotional escape", weight:2.0, description:"Destructive energy morphs into addiction as individuals seek escape from repressed anger.<SEP>Destructive energy morphs into addiction as individuals seek escape from repressed anger.", created_at:1779558070, source_id:"chunk-19097bf7d5cd386b3cd384082e7f375d"}}, {start: {_id:6318}, end: {_id:6309}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"emotional transformation,psychological effect", weight:2.0, description:"Repressed anger transforms into crying and depression as an emotional outlet.<SEP>Repressed anger transforms into crying and depression as an emotional outlet.", created_at:1779558070, source_id:"chunk-19097bf7d5cd386b3cd384082e7f375d"}}, {start: {_id:6305}, end: {_id:6306}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"health risk,physiological impact", weight:2.0, description:"Destructive energy increases heart attack risk post-anger outburst.<SEP>Destructive energy increases heart attack risk post-anger outburst.", created_at:1779558070, source_id:"chunk-19097bf7d5cd386b3cd384082e7f375d"}}, {start: {_id:497}, end: {_id:6309}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"behavioral response,emotional trigger", weight:2.0, description:"Repressed anger drives addiction as a coping mechanism for unbearable emotions.<SEP>Repressed anger drives addiction as a coping mechanism for unbearable emotions.", created_at:1779558070, source_id:"chunk-19097bf7d5cd386b3cd384082e7f375d"}}, {start: {_id:6305}, end: {_id:6310}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"health risk,neurological impact", weight:2.0, description:"Destructive energy elevates stroke risk through brain-related complications.<SEP>Destructive energy elevates stroke risk through brain-related complications.", created_at:1779558070, source_id:"chunk-19097bf7d5cd386b3cd384082e7f375d"}}, {start: {_id:6305}, end: {_id:348}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"content focus,educational material", weight:2.0, description:"The video discusses destructive energy's effects on health and behavior.<SEP>The video discusses destructive energy's effects on health and behavior.", created_at:1779558070, source_id:"chunk-19097bf7d5cd386b3cd384082e7f375d"}}, {start: {_id:6305}, end: {_id:178}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"FAQ topic,applied context", truncate:"", weight:2.0, description:"FAQs question anger's utility in driving societal change.<SEP>FAQs question anger's utility in driving societal change.", created_at:1779558071, source_id:"chunk-19097bf7d5cd386b3cd384082e7f375d"}}, {start: {_id:6305}, end: {_id:739}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"FAQ topic,applied context", truncate:"", weight:2.0, description:"FAQs explore anger's role in familial dynamics and change.<SEP>FAQs explore anger's role in familial dynamics and change.", created_at:1779558071, source_id:"chunk-19097bf7d5cd386b3cd384082e7f375d"}}, {start: {_id:6305}, end: {_id:6316}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"FAQ topic,applied context", truncate:"", weight:2.0, description:"FAQs debate anger's effectiveness for constructive action and progress.<SEP>FAQs debate anger's effectiveness for constructive action and progress.", created_at:1779558071, source_id:"chunk-19097bf7d5cd386b3cd384082e7f375d"}}] AS row
