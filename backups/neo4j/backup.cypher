UNWIND [{start: {_id:8021}, end: {_id:1500}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"metaphor,philosophical concept", weight:1.0, description:"The Limitless Field symbolizes the boundless reality of Ekam Sat, transcending physical forms.", created_at:1779724382, source_id:"chunk-3a0be5644a79b5c40bdef9be1640aecb"}}, {start: {_id:8021}, end: {_id:1594}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"philosophical concept,practice", weight:1.0, description:"Sadhana denotes spiritual practices aligned with the realization of Ekam Sat.", created_at:1779724382, source_id:"chunk-3a0be5644a79b5c40bdef9be1640aecb"}}, {start: {_id:8040}, end: {_id:8041}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"linguistic correction,transcription error", weight:1.0, description:"perpetrating is identified as a likely misheard/misread term, with \"pertaining\" proposed as the corrected form in the context of language analysis.", created_at:1779724445, source_id:"chunk-8b19a5bd3b3ffedf815babd6eb52e62b"}}, {start: {_id:1638}, end: {_id:8040}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"content analysis,linguistic discussion", weight:1.0, description:"The video contains a discussion about the term \"perpetrating\" and its potential correction to \"pertaining\".", created_at:1779724445, source_id:"chunk-8b19a5bd3b3ffedf815babd6eb52e62b"}}, {start: {_id:8043}, end: {_id:8042}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"concept combination,phrase simplification", weight:1.0, description:"The original phrase combines \"proactive\" and \"anti-racist\", and the correction simplifies it to \"proactive anti-racists\".", created_at:1779724466, source_id:"chunk-c32bf7fcfe6dd8d2fa78dd2f0cb30726"}}, {start: {_id:8044}, end: {_id:8017}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"grammar fix,phrase correction", weight:1.0, description:"The phrase \"anti-making\" is incorrect and needs to be fixed in the context of \"anti-plastic\".", created_at:1779724466, source_id:"chunk-c32bf7fcfe6dd8d2fa78dd2f0cb30726"}}, {start: {_id:348}, end: {_id:8045}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"content,source", weight:2.0, description:"The YouTube Video contains the phrase \"anti-plastic, anti-making sure\" as part of its content.", created_at:1779724498, source_id:"chunk-ace5dae3a207a35dd7f89667f66d0674"}}, {start: {_id:8045}, end: {_id:8046}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", keywords:"correction,proposal", truncate:"", weight:1.0, description:"The phrase \"anti-plastic, anti-pollution\" is", created_at:1779724498, source_id:"chunk-ace5dae3a207a35dd7f89667f66d0674"}}, {start: {_id:8049}, end: {_id:8048}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", keywords:"correction,typo fix", truncate:"", weight:2.0, description:"The phrase \"anti-making\" was corrected to \"anti-pollution\" in the text.", created_at:1779724599, source_id:"chunk-237a562741a94e83863123a91f5ccf01"}}, {start: {_id:8035}, end: {_id:8048}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"environmental initiatives,shared goal", weight:2.0, description:"anti-plastic and anti-pollution are related concepts aimed at environmental protection.", created_at:1779724599, source_id:"chunk-237a562741a94e83863123a91f5ccf01"}}, {start: {_id:8048}, end: {_id:8047}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"environmental goal,outcome", weight:2.0, description:"anti-pollution efforts contribute to maintaining clean waterways.", created_at:1779724599, source_id:"chunk-237a562741a94e83863123a91f5ccf01"}}, {start: {_id:8052}, end: {_id:8025}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"proactive response,social justice", weight:1.0, description:"Lobbying and calling out are both proactive methods to address issues like racism and derogatory comments.", created_at:1779724620, source_id:"chunk-ab6b594ae56e39d2a27d9720bf296186"}}, {start: {_id:6222}, end: {_id:8015}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"environmental concern,product", weight:1.0, description:"Supermarkets sell plastic, which is a product of concern for environmental reduction.", created_at:1779724620, source_id:"chunk-ab6b594ae56e39d2a27d9720bf296186"}}, {start: {_id:8016}, end: {_id:8013}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"proactive response,social justice", weight:1.0, description:"Racism is addressed by calling out derogatory comments, which are a form of racism.", created_at:1779724620, source_id:"chunk-ab6b594ae56e39d2a27d9720bf296186"}}, {start: {_id:8051}, end: {_id:8050}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"combined initiatives,environmental advocacy", weight:1.0, description:"The Anti-Plastic Campaign and Anti-Waste are combined in the phrase \"anti-plastic, anti-waste, making sure...\"", created_at:1779724620, source_id:"chunk-ab6b594ae56e39d2a27d9720bf296186"}}, {start: {_id:8051}, end: {_id:8015}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"environmental advocacy,plastic reduction", weight:1.0, description:"The Anti-Plastic Campaign aims to reduce plastic in supermarkets through lobbying.", created_at:1779724620, source_id:"chunk-ab6b594ae56e39d2a27d9720bf296186"}}, {start: {_id:8058}, end: {_id:8022}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", keywords:"correction,mishearing", truncate:"", weight:1.0, description:"Vipraha Bahuda Vadhanthi is corrected to Vipra due to a mishearing.", created_at:1779725116, source_id:"chunk-51ae5339edf74f5e2c9959f6a0626653"}}, {start: {_id:1638}, end: {_id:8048}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"environmental advocacy,text edits", weight:1.0, description:"The video contains text edits discussing anti-pollution initiatives to protect waterways.", created_at:1779725285, source_id:"chunk-3ff8c8f8711e5fea8b4b03b134c17305"}}, {start: {_id:1638}, end: {_id:8035}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"consumer choices,text edits", weight:1.0, description:"The video includes edits addressing anti-plastic sentiment and purchasing decisions.", created_at:1779725285, source_id:"chunk-3ff8c8f8711e5fea8b4b03b134c17305"}}, {start: {_id:1638}, end: {_id:8038}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", keywords:"social justice,text edits", truncate:"", weight:1.0, description:"The video features edits related to calling out racism and social justice advocacy.", created_at:1779725285, source_id:"chunk-3ff8c8f8711e5fea8b4b03b134c17305"}}] AS row
