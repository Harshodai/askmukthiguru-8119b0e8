UNWIND [{_id:3857, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"concept", truncate:"", description:"Refers to the text's structural elements, including repetitions and question placement.", created_at:1779242200, source_id:"chunk-565f31c778a5c7a7dca6ba7639c9783c", entity_id:"Structure"}}, {_id:3858, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"concept", truncate:"", description:"Rigid ideas and opinions are inflexible beliefs that lead to intolerance, judgmental behavior, and insensitivity towards others.", created_at:1779242306, source_id:"chunk-082ee41f700ea9a8a29b83bfbf36abec", entity_id:"Rigid Ideas and Opinions"}}, {_id:3859, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)<SEP>YouTube Video: 38-NgBAet1c (URL: https://www.youtube.com/watch?v=38-NgBAet1c)", entity_type:"concept", truncate:"", description:"Absence of love is linked to rigid adherence to one's views and the inability to accept others' perspectives.<SEP>The absence of love is portrayed as a root cause leading to cruelty and violence.", created_at:1779445475, source_id:"chunk-082ee41f700ea9a8a29b83bfbf36abec<SEP>chunk-7f34b765e8eccb327fac73e52a1c873a", entity_id:"Absence of Love"}}, {_id:3860, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"concept", truncate:"", description:"Rigid ideas lead to intolerance and judgmental attitudes towards others.<SEP>Intolerance emerges from rigid adherence to one's own views, leading to judgmental behavior.", created_at:1779242468, source_id:"chunk-082ee41f700ea9a8a29b83bfbf36abec<SEP>chunk-8b1cb9338748404cabaa24ac4be68f56", entity_id:"Intolerance"}}, {_id:3861, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"UNKNOWN", truncate:"", description:"Lack of love fosters rigid and unyielding opinions.", created_at:1779242307, source_id:"chunk-082ee41f700ea9a8a29b83bfbf36abec", entity_id:"Rigid Opinions"}}, {_id:3862, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"UNKNOWN", truncate:"", description:"Rigid opinions result in insensitivity to a partner's feelings.", created_at:1779242307, source_id:"chunk-082ee41f700ea9a8a29b83bfbf36abec", entity_id:"Insensitive to Partner"}}, {_id:3863, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"UNKNOWN", truncate:"", description:"Inflexible views cause disregard for others' emotions.", created_at:1779242307, source_id:"chunk-082ee41f700ea9a8a29b83bfbf36abec", entity_id:"Don't Care for Feelings"}}, {_id:3864, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"UNKNOWN", truncate:"", description:"Rigid opinions reinforce the belief in one's own correctness.", created_at:1779242308, source_id:"chunk-082ee41f700ea9a8a29b83bfbf36abec", entity_id:"Reinforce Own View"}}, {_id:3865, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"UNKNOWN", truncate:"", description:"There is a desire to force others to accept one's rigid opinions.", created_at:1779242308, source_id:"chunk-082ee41f700ea9a8a29b83bfbf36abec", entity_id:"Want Partner to Accept"}}, {_id:3866, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"UNKNOWN", truncate:"", description:"Rigid views demand global acceptance of one's perspective.", created_at:1779242308, source_id:"chunk-082ee41f700ea9a8a29b83bfbf36abec", entity_id:"Want World to Accept"}}, {_id:3867, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=4ytgjpow498)", entity_type:"method", truncate:"", description:"Breathing technique involving seven deep inhalations through the nose and slow exhalations through the mouth in awareness, with a noted error in the instruction text where 'seven times.UP Thank you.' should be 'seven times. Up, thank you.'<SEP>Breathing exercise involves slow inhalations and exhalations while counting breaths via thumb-fingertip touch, aimed at activating the parasympathetic nervous system and immune system.", created_at:1779734201, source_id:"chunk-78de7fe55b577c559d0a376641b24b1d<SEP>chunk-190acc93a27012825956522182c7d1a4", entity_id:"Breathing Exercise"}}, {_id:3869, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"concept", truncate:"", description:"Views and opinions are subjective perspectives shaped by life experiences, often held rigidly.", created_at:1779242468, source_id:"chunk-8b1cb9338748404cabaa24ac4be68f56", entity_id:"Views and Opinions"}}, {_id:3870, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"concept", truncate:"", description:"A judgmental attitude reflects insensitivity to a partner's feelings and emotions.", created_at:1779242468, source_id:"chunk-8b1cb9338748404cabaa24ac4be68f56", entity_id:"Judgmental Attitude"}}, {_id:3871, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"concept", truncate:"", description:"Insensitivity manifests as disregard for a partner's emotional needs and perspectives.", created_at:1779242469, source_id:"chunk-8b1cb9338748404cabaa24ac4be68f56", entity_id:"Insensitivity"}}, {_id:3872, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"concept", truncate:"", description:"Feelings represent emotional experiences that require mutual understanding in relationships.", created_at:1779242469, source_id:"chunk-8b1cb9338748404cabaa24ac4be68f56", entity_id:"Feelings"}}, {_id:3873, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"naturalobject", truncate:"", description:"Represents the natural world and existential contemplation, invoked as a focal point of reflection.`<SEP>...`**: The name is \"The Earth\". The description is \"Represents the natural world...\". Okay.<SEP>The Earth is the planet that requires protection and sustainable practices as per the initiative.", created_at:1779251276, source_id:"chunk-8256cf976ad8a037f8f35eebe2780b5a<SEP>chunk-82a35dd1f46df5834f79d95a05339385", entity_id:"The Earth"}}, {_id:3874, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A thematic phrase emphasizing release or surrender, repeated as a central motif in the text.`<SEP>...`**: The name is \"Leave It\". The description is \"A thematic phrase...\". This seems okay.", created_at:1779242998, source_id:"chunk-8256cf976ad8a037f8f35eebe2780b5a", entity_id:"Leave It"}}, {_id:3875, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A recurring directive highlighting the text's focus on bodily awareness and existential inquiry.`<SEP>...`**: The name is \"Think of a Body\". The description is \"A recurring directive...\". Okay.", created_at:1779242998, source_id:"chunk-8256cf976ad8a037f8f35eebe2780b5a", entity_id:"Think of a Body"}}, {_id:3876, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Symbolizes physical existence and embodiment, repeatedly emphasized as a subject of meditation.`<SEP>...`**: The name is \"A Body\". The description is \"Symbolizes physical existence...\". Okay.", created_at:1779242998, source_id:"chunk-8256cf976ad8a037f8f35eebe2780b5a", entity_id:"A Body"}}, {_id:3877, properties:{file_path:"unknown_source<SEP>YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", entity_type:"event", truncate:"", description:"International World Peace Day is an event mentioned in the text analysis.<SEP>International World Peace Day is a global event observed on September 21st, focusing on the four pillars of peace.", created_at:1779520446, source_id:"chunk-50f259044416b29784cc45b625bee372<SEP>chunk-2225477f1ce6601f366c9da4b0d0f105", entity_id:"International World Peace Day"}}] AS row
