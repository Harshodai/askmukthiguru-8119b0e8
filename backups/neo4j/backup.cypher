UNWIND [{_id:2661, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A subscription service providing updates on Simon & Schuster's new releases, deals, and recommended reads.", created_at:1779174326, source_id:"chunk-e25c39bb1e659f873118af19e0e15068", entity_id:"mailing list"}}, {_id:2662, properties:{file_path:"unknown_source", entity_type:"artifact", truncate:"", description:"An interactive button enabling users to subscribe to Simon & Schuster's mailing list.", created_at:1779174326, source_id:"chunk-e25c39bb1e659f873118af19e0e15068", entity_id:"CLICK HERE TO SIGN UP"}}, {_id:2663, properties:{file_path:"unknown_source", entity_type:"artifact", truncate:"", description:"A digital book published by Simon & Schuster, offered as part of a promotional mailing list subscription.", created_at:1779174326, source_id:"chunk-e25c39bb1e659f873118af19e0e15068", entity_id:"Simon & Schuster ebook"}}, {_id:2664, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Promotional offers or discounts available through Simon & Schuster.", created_at:1779174326, source_id:"chunk-e25c39bb1e659f873118af19e0e15068", entity_id:"deals"}}, {_id:2665, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Books suggested by Simon & Schuster based on reader preferences.", created_at:1779174326, source_id:"chunk-e25c39bb1e659f873118af19e0e15068", entity_id:"recommended reads"}}, {_id:2666, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A philosophical concept central to the book's dedication, emphasizing unity with life.", created_at:1779174326, source_id:"chunk-e25c39bb1e659f873118af19e0e15068", entity_id:"transformation of human consciousness toward oneness with all life"}}, {_id:2667, properties:{file_path:"unknown_source", entity_type:"artifact", truncate:"", description:"Legal guidelines governing the mailing list subscription and ebook registration.", created_at:1779174327, source_id:"chunk-e25c39bb1e659f873118af19e0e15068", entity_id:"terms and conditions"}}, {_id:2668, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", created_at:1779654040, description:"Willpower alone is portrayed as insufficient to combat addiction, emphasizing its limitations in addressing deeper issues.<SEP>Willpower is noted as insufficient alone to combat addiction, highlighting its limitations.<SEP>Willpower is described as the ability to maintain focus and effort despite challenges.<SEP>Willpower is the mental strength needed to persevere through difficulties and maintain commitment.<SEP>The ability to persist in the face of challenges, dependent on a beautiful state of consciousness.<SEP>Willpower is the mental strength required to maintain decisions in the face of difficulties.<SEP>Willpower refers to the mental strength required to maintain decisions despite challenges and uncertainties.", source_id:"chunk-954c4e66e25d390d543a0361e6284f30<SEP>chunk-afded1563688b8ea6c18ff58fee20328<SEP>chunk-f911f447e8921c9205ec53996cfbe423<SEP>chunk-56da25e7d132b4ecea54c551b7809f75<SEP>chunk-e5d8a73bfe09b1e5fab115705dfa0fe7<SEP>chunk-87ae4401ec344e0f145a40afa02041af<SEP>chunk-20d895bd21d3a068503f3d99fc9f225c<SEP>chunk-46d6abd520d390d99cea37e408f7a403", entity_id:"Willpower"}}, {_id:2669, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"person", truncate:"", created_at:1779225543, description:"Eldest son of the coach was a source of public shame but connected during the festival.<SEP>A 34-year-old chronic alcoholic struggling with career and relationships, who considers quitting alcohol after a transformative festival experience with his father.", source_id:"chunk-f3c9a2b1053591399fd7351098da3627<SEP>chunk-6924307324d5ba84e533d49dbdf29d98<SEP>chunk-eae1f6658ba1fd4f52f2452752071fc4", entity_id:"Eldest Son"}}, {_id:2670, properties:{file_path:"unknown_source", entity_type:"data", truncate:"", description:"User-provided email addresses used for mailing list subscriptions and ebook delivery.", created_at:1779174327, source_id:"chunk-e25c39bb1e659f873118af19e0e15068", entity_id:"email"}}, {_id:2671, properties:{file_path:"unknown_source", entity_type:"location", truncate:"", description:"A digital space where subscribers receive exclusive offers and ebooks.", created_at:1779174327, source_id:"chunk-e25c39bb1e659f873118af19e0e15068", entity_id:"inbox"}}, {_id:2672, properties:{file_path:"unknown_source", entity_type:"method", truncate:"", description:"Process of recording a subscriber's ebook access for future delivery.", created_at:1779174327, source_id:"chunk-e25c39bb1e659f873118af19e0e15068", entity_id:"ebook registration"}}, {_id:2673, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"An individual who subscribes to Simon & Schuster's mailing list.", created_at:1779174327, source_id:"chunk-e25c39bb1e659f873118af19e0e15068", entity_id:"subscriber"}}, {_id:2674, properties:{file_path:"unknown_source", entity_type:"artifact", truncate:"", description:"The digital book being offered as part of the promotional campaign.", created_at:1779174327, source_id:"chunk-e25c39bb1e659f873118af19e0e15068", entity_id:"ebook"}}, {_id:2675, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The book is dedicated to exploring the transformation of human consciousness.", created_at:1779174327, source_id:"chunk-e25c39bb1e659f873118af19e0e15068", entity_id:"book"}}, {_id:2676, properties:{file_path:"unknown_source<SEP>YouTube Video: qJxGtSDiayM (URL: https://www.youtube.com/watch?v=qJxGtSDiayM)", entity_type:"concept", truncate:"", created_at:1779408029, description:"A group targeted by O&O Academy's courses for integrating consciousness into wealth-building practices.<SEP>Conscious wealth creators are individuals who harmonize spiritual awareness with material prosperity to benefit society.<SEP>Conscious wealth creators pursue success through connection, purpose, and positive impact rather than disconnection and anxiety.<SEP>Conscious wealth creators pursue wealth and success from connection rather than disconnection, focusing on purpose and ecosystem impact.<SEP>Individuals who pursue wealth and success through connection, purpose, and ecosystem impact as discussed in the video.", source_id:"chunk-d83a359a3b08bc2ee4dd9304ff1558fc<SEP>chunk-50804a0cd2fabf8122814121f088fb8d<SEP>chunk-006aa99cab24a3e6956661a971e44e52<SEP>chunk-5df4284d1aa76cb89d7850ba8ee300b9<SEP>chunk-f3b8314c49f1c4cc362d4a1e403ac6d8", entity_id:"Conscious Wealth Creators"}}, {_id:2677, properties:{file_path:"unknown_source", entity_type:"other", truncate:"", description:"A group targeted by O&O Academy's courses for deepening spiritual understanding and transformation.", created_at:1779174406, source_id:"chunk-d83a359a3b08bc2ee4dd9304ff1558fc", entity_id:"Spiritual Seekers"}}, {_id:2678, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"concept", truncate:"", description:"Addiction to binge eating is associated with feelings of being unloved and unwanted.", created_at:1779224867, source_id:"chunk-f3c9a2b1053591399fd7351098da3627", entity_id:"Addiction to Binge Eating"}}, {_id:2679, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"location", truncate:"", description:"Latin America is the region from which the personality development coach originates.", created_at:1779224867, source_id:"chunk-f3c9a2b1053591399fd7351098da3627<SEP>chunk-6924307324d5ba84e533d49dbdf29d98", entity_id:"Latin America"}}, {_id:2680, properties:{file_path:"unknown_source", entity_type:"content", truncate:"", created_at:1779183431, description:"The First Sacred Secret is a spiritual guide emphasizing living with a beautiful state of consciousness, based on teachings from Krishnaji and Preethaji.` - Looks correct.<SEP>The First Sacred Secret is a fable illustrating the contrast between suering and beautiful states, emphasizing their impact on human experience.<SEP>A written guide detailing the Soul Sync practice and its application in life.", source_id:"chunk-23f4ae85323a27ae180ceca7fa33c13a<SEP>chunk-bd28b1a048122e44541304a8505b07db<SEP>chunk-3c49e28407e5138bcf1195c71da21835", entity_id:"The First Sacred Secret"}}] AS row
