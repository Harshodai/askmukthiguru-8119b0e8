UNWIND [{start: {_id:5821}, end: {_id:2316}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)", truncate:"", keywords:"advocacy,dialogue", weight:1.0, description:"Gaharaman participates in a conversation advocating for peace and the eradication of divisiveness.", created_at:1779536321, source_id:"chunk-3f3bafe6f6c90c708d53427b40b9a1a7"}}, {start: {_id:5826}, end: {_id:5830}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)", keywords:"cause,perpetuation", truncate:"", weight:1.0, description:"Injustice perpetuates divisiveness through cycles of power imbalances and unacknowledged grievances.", created_at:1779536321, source_id:"chunk-3f3bafe6f6c90c708d53427b40b9a1a7"}}, {start: {_id:5827}, end: {_id:5825}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)", truncate:"", keywords:"equality,reform", weight:1.0, description:"The justice system is called to treat women as equals to address gender-based injustices.", created_at:1779536321, source_id:"chunk-3f3bafe6f6c90c708d53427b40b9a1a7"}}, {start: {_id:5821}, end: {_id:5826}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)", truncate:"", keywords:"awareness,systemic analysis", weight:1.0, description:"Gaharaman analyzes divisiveness as stemming from unaddressed injustice and power dynamics.", created_at:1779536321, source_id:"chunk-3f3bafe6f6c90c708d53427b40b9a1a7"}}, {start: {_id:5831}, end: {_id:5827}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)", truncate:"", keywords:"accountability,systemic reform", weight:1.0, description:"Addressing historic inequalities requires justice systems to hold power accountable.", created_at:1779536321, source_id:"chunk-3f3bafe6f6c90c708d53427b40b9a1a7"}}, {start: {_id:5828}, end: {_id:5825}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)", keywords:"focus,gender equity", truncate:"", weight:1.0, description:"Health care systems are advised to prioritize women's issues to address disparities.", created_at:1779536321, source_id:"chunk-3f3bafe6f6c90c708d53427b40b9a1a7"}}, {start: {_id:5828}, end: {_id:5831}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)", keywords:"equity,targeted solutions", truncate:"", weight:1.0, description:"Health care systems must implement practical solutions to address gender-based historic inequalities.", created_at:1779536321, source_id:"chunk-3f3bafe6f6c90c708d53427b40b9a1a7"}}, {start: {_id:5832}, end: {_id:5834}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)", keywords:"implementation,solutions", truncate:"", weight:1.0, description:"Practical approaches are suggested to resolve historic gender-based inequalities.", created_at:1779536386, source_id:"chunk-41b4e9e0abfc963f768997931ec90fe9"}}, {start: {_id:2273}, end: {_id:5833}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)", keywords:"content,dissemination", truncate:"", weight:1.0, description:"The video disseminates a message advocating for systemic changes to address gender inequalities.", created_at:1779536386, source_id:"chunk-41b4e9e0abfc963f768997931ec90fe9"}}, {start: {_id:5824}, end: {_id:2006}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)<SEP>unknown_source", keywords:"equality,policy focus,reform", truncate:"", weight:2.0, description:"The justice system must treat women as equals to address gender inequalities.<SEP>Women's treatment in the justice system requires equality to ensure fairness.", created_at:1779536466, source_id:"chunk-41b4e9e0abfc963f768997931ec90fe9<SEP>chunk-122b26a4cc30222007d37133d11cda63"}}, {start: {_id:5823}, end: {_id:2006}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)<SEP>unknown_source", keywords:"equity,health focus,policy", truncate:"", weight:2.0, description:"The health care system should prioritize women's health issues to address systemic gaps.<SEP>Women's inclusion in health care systems addresses historic inequalities.", created_at:1779536466, source_id:"chunk-41b4e9e0abfc963f768997931ec90fe9<SEP>chunk-122b26a4cc30222007d37133d11cda63"}}, {start: {_id:695}, end: {_id:5822}, properties:{file_path:"unknown_source", keywords:"emotional response,systemic issue", truncate:"", weight:1.0, description:"Injustice fuels sadness and anger among marginalized groups.", created_at:1779536466, source_id:"chunk-122b26a4cc30222007d37133d11cda63"}}, {start: {_id:1509}, end: {_id:755}, properties:{file_path:"unknown_source", keywords:"foundation,outcome", truncate:"", weight:1.0, description:"Awakened consciousness enables the realization of peace and unity.", created_at:1779536466, source_id:"chunk-122b26a4cc30222007d37133d11cda63"}}, {start: {_id:2128}, end: {_id:5312}, properties:{file_path:"unknown_source", keywords:"goal,mechanism", truncate:"", weight:1.0, description:"Justice serves as a mechanism to drive societal change and progress.", created_at:1779536466, source_id:"chunk-122b26a4cc30222007d37133d11cda63"}}, {start: {_id:5821}, end: {_id:755}, properties:{file_path:"unknown_source", keywords:"dialogue,participation", truncate:"", weight:1.0, description:"Gaharaman's presence contributes to discussions on peace and divisiveness eradication.", created_at:1779536466, source_id:"chunk-122b26a4cc30222007d37133d11cda63"}}, {start: {_id:5837}, end: {_id:2232}, properties:{file_path:"unknown_source<SEP>YouTube Video: yJoWk10CSjg (URL: https://www.youtube.com/watch?v=yJoWk10CSjg)", keywords:"ecological ethics,greed,greed vs. need,impact", truncate:"", weight:2.0, description:"Gandhiji's quote highlights the issue of greed in relation to Mother Earth.<SEP>Gandhiji's quote critiques human greed as a threat to Earth's resources, advocating mindful consumption.", created_at:1779537013, source_id:"chunk-2c155ca915a56ff1bf0ef30ef075e557<SEP>chunk-c09aade9dbfd355fb478c083ce9dcbcd"}}, {start: {_id:5838}, end: {_id:5544}, properties:{file_path:"unknown_source", keywords:"connection,deity", truncate:"", weight:1.0, description:"Ganesha is a great god in Hinduism who brings nature and life together.", created_at:1779536518, source_id:"chunk-2c155ca915a56ff1bf0ef30ef075e557"}}, {start: {_id:5839}, end: {_id:2232}, properties:{file_path:"unknown_source<SEP>YouTube Video: yJoWk10CSjg (URL: https://www.youtube.com/watch?v=yJoWk10CSjg)", keywords:"non-violence,protection,religious,sustainability", truncate:"", weight:2.0, description:"Jainism prohibits killing living animals to protect Mother Earth.<SEP>Jainism's prohibition of harming living beings underscores its commitment to protecting Earth's ecosystems.", created_at:1779537013, source_id:"chunk-2c155ca915a56ff1bf0ef30ef075e557<SEP>chunk-c09aade9dbfd355fb478c083ce9dcbcd"}}, {start: {_id:5841}, end: {_id:4392}, properties:{file_path:"unknown_source", keywords:"dullness,effect", truncate:"", weight:1.0, description:"Self-engrossment causes senses to become dull.", created_at:1779536519, source_id:"chunk-2c155ca915a56ff1bf0ef30ef075e557"}}, {start: {_id:5840}, end: {_id:2232}, properties:{file_path:"unknown_source<SEP>YouTube Video: yJoWk10CSjg (URL: https://www.youtube.com/watch?v=yJoWk10CSjg)", keywords:"desert survival,protection,religious,sustainability symbolism", truncate:"", weight:2.0, description:"Islam's association with green and its legions tell us to protect Mother Earth.<SEP>Islam's association with green reflects its historical connection to arid environments and resource conservation.", created_at:1779537013, source_id:"chunk-2c155ca915a56ff1bf0ef30ef075e557<SEP>chunk-c09aade9dbfd355fb478c083ce9dcbcd"}}] AS row
