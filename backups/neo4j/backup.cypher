UNWIND [{start: {_id:251}, end: {_id:2468}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", truncate:"", keywords:"synonyms,universal concepts", weight:1.0, description:"Both fields represent interconnected universal principles with multiple cultural designations.", created_at:1779404050, source_id:"chunk-e41aa29188359857d686593b398cb57d"}}, {start: {_id:4656}, end: {_id:4672}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", keywords:"consciousness,transformation", truncate:"", weight:1.0, description:"The Field is integral to human evolution, particularly in the evolution of consciousness that drives creation in the world.", created_at:1779404100, source_id:"chunk-427a40a0dca2cdf8c20478622efb52a5"}}, {start: {_id:4658}, end: {_id:4672}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", keywords:"influence,intention", truncate:"", weight:1.0, description:"The Global Family infuses the Field with collective dreams, desires, and the pursuit of peace.", created_at:1779404100, source_id:"chunk-427a40a0dca2cdf8c20478622efb52a5"}}, {start: {_id:4673}, end: {_id:4672}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", truncate:"", keywords:"harmony,response", weight:1.0, description:"The Field aligns with peace and coherence, suggesting it responds positively to these states.", created_at:1779404100, source_id:"chunk-427a40a0dca2cdf8c20478622efb52a5"}}, {start: {_id:4674}, end: {_id:4672}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", keywords:"disharmony,resistance", truncate:"", weight:1.0, description:"The Field does not respond favorably to attempts at change driven by anger or chaos.", created_at:1779404101, source_id:"chunk-427a40a0dca2cdf8c20478622efb52a5"}}, {start: {_id:4657}, end: {_id:1799}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", keywords:"consciousness,mirroring", truncate:"", weight:1.0, description:"The field mirrors what humans become in their hearts and minds.", created_at:1779404149, source_id:"chunk-a20fa03637522df32905bf3e04315780"}}, {start: {_id:1799}, end: {_id:1798}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", keywords:"interconnectedness,unity", truncate:"", weight:1.0, description:"Humans are inseparable from trees as part of the interconnected web of life.", created_at:1779404149, source_id:"chunk-a20fa03637522df32905bf3e04315780"}}, {start: {_id:1696}, end: {_id:1799}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)", truncate:"", keywords:"behavior contrast,destination,human vs. animal behavior,interconnectedness,unity", weight:3.0, created_at:1779678612, description:"Humans are inseparable from animals as part of the interconnected web of life.<SEP>Human beings are compared to animals in terms of having a destination.<SEP>Human beings lack inherent destinations, while animals exhibit instinctual behaviors with clear survival-driven purposes.", source_id:"chunk-a20fa03637522df32905bf3e04315780<SEP>chunk-4dea19a1ca3602539d80b6f5c46066c4<SEP>chunk-5637d12f2e1eaf0419e502601bcb1c15"}}, {start: {_id:1799}, end: {_id:2232}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)<SEP>unknown_source", truncate:"", keywords:"environmental harm,ethical conflict,interconnectedness,unity", weight:2.0, description:"Humans are inseparable from Mother Earth, representing the planet.<SEP>Human actions contradict the principle of seeking blessings for all living beings, harming Mother Earth.", created_at:1779668723, source_id:"chunk-a20fa03637522df32905bf3e04315780<SEP>chunk-22e861448de43c78f776c4d84f1409bd"}}, {start: {_id:4676}, end: {_id:4675}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", truncate:"", keywords:"reference,source", weight:1.0, description:"The YouTube video is accessible via the provided URL, serving as the primary source for the discussed content.", created_at:1779404168, source_id:"chunk-b737d792c2b87275c077f4a64c8f5999"}}, {start: {_id:1787}, end: {_id:4676}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", truncate:"", keywords:"content focus,linguistic analysis", weight:1.0, description:"The video discusses homophones and misheard words as part of its exploration of language and consciousness.", created_at:1779404216, source_id:"chunk-a8b37aaaba467c66383f6b5970db43de"}}, {start: {_id:4664}, end: {_id:4676}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", truncate:"", keywords:"crisis discussion,global challenges", weight:1.0, description:"The video lists global mental health crisis among the crises facing humanity.", created_at:1779404216, source_id:"chunk-a8b37aaaba467c66383f6b5970db43de"}}, {start: {_id:4665}, end: {_id:4676}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", truncate:"", keywords:"crisis discussion,global challenges", weight:1.0, description:"The video includes global economic crisis as part of humanity's current struggles.", created_at:1779404216, source_id:"chunk-a8b37aaaba467c66383f6b5970db43de"}}, {start: {_id:4666}, end: {_id:4676}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", truncate:"", keywords:"crisis discussion,global challenges", weight:1.0, description:"Global relationship crisis is cited as a societal challenge in the video.", created_at:1779404216, source_id:"chunk-a8b37aaaba467c66383f6b5970db