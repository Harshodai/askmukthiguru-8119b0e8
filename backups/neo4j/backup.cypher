UNWIND [{start: {_id:2397}, end: {_id:39}, properties:{file_path:"unknown_source", keywords:"ethics,peace", truncate:"", weight:1.0, description:"Joy emerges from inner peace as a manifestation of ethical human responsibility.>", created_at:1779173785, source_id:"chunk-cb2b247e069cff8e39d34db433289983"}}, {start: {_id:2403}, end: {_id:2404}, properties:{file_path:"unknown_source", keywords:"consciousness,reality", truncate:"", weight:1.0, description:"The beautiful world emerges through individual adoption of peaceful consciousness.>", created_at:1779173786, source_id:"chunk-cb2b247e069cff8e39d34db433289983"}}, {start: {_id:2399}, end: {_id:2395}, properties:{file_path:"unknown_source", keywords:"outcome,practice", truncate:"", weight:1.0, description:"Bliss is the profound outcome of diligent spiritual practice and connection.>", created_at:1779173786, source_id:"chunk-cb2b247e069cff8e39d34db433289983"}}, {start: {_id:1245}, end: {_id:2479}, properties:{file_path:"unknown_source", keywords:"craving,obsession", truncate:"", weight:1.0, description:"Desire can lead to obsessive craving when fixated on achieving an object of desire.", created_at:1779173786, source_id:"chunk-4d59e72aadbbf0c922fc8ed13db1693a"}}, {start: {_id:1335}, end: {_id:2391}, properties:{file_path:"unknown_source<SEP>YouTube Video: UNdwPjyLGn0 (URL: https://www.youtube.com/watch?v=UNdwPjyLGn0)", keywords:"enlightenment,spiritual achievement,spiritual concept", truncate:"", weight:2.0, description:"The concept of Buddha is linked to achieving enlightenment through liberation from desire and ego.<SEP>Buddha achieved enlightenment, which is central to his teachings and identity.", created_at:1779390934, source_id:"chunk-4d59e72aadbbf0c922fc8ed13db1693a<SEP>chunk-52d567ecc552b96b146755df515ac0bd"}}, {start: {_id:2481}, end: {_id:2482}, properties:{file_path:"unknown_source", keywords:"cultural reference,enlightenment", truncate:"", weight:1.0, description:"An ancient Thai story about flushing mud to experience the true Buddha is referenced as similar to the teachings on enlightenment.", created_at:1779173788, source_id:"chunk-4d59e72aadbbf0c922fc8ed13db1693a"}}, {start: {_id:2427}, end: {_id:2428}, properties:{file_path:"unknown_source", keywords:"mental dichotomy,opposing states", truncate:"", weight:1.0, description:"The two states are mutually exclusive and represent the only possible internal experiences.", created_at:1779173788, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde"}}, {start: {_id:2429}, end: {_id:1808}, properties:{file_path:"unknown_source", keywords:"brain chemistry,chemical addiction", truncate:"", weight:1.0, description:"Neurons become addicted to neuropeptides released during anxiety, reinforcing the state.", created_at:1779173788, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde"}}, {start: {_id:2430}, end: {_id:2484}, properties:{file_path:"unknown_source", keywords:"habit formation,metaphor", truncate:"", weight:1.0, description:"The garden analogy explains how repeated mental states create ingrained neural pathways.", created_at:1779173788, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde"}}, {start: {_id:2432}, end: {_id:2485}, properties:{file_path:"unknown_source", keywords:"causality,interconnectedness", truncate:"", weight:1.0, description:"The individual's mental state directly influences the life situations they encounter.", created_at:1779173789, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde"}}, {start: {_id:2404}, end: {_id:116}, properties:{file_path:"unknown_source", keywords:"unconscious signals,universal impact", truncate:"", weight:1.0, description:"The individual's mental state sends unconscious signals affecting the universe.", created_at:1779173789, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde"}}, {start: {_id:496}, end: {_id:788}, properties:{file_path:"unknown_source", keywords:"addiction,neural pathways", truncate:"", weight:1.0, description:"Anxiety creates strong neural pathways in the brain through repeated neuropeptide release.", created_at:1779173789, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde"}}, {start: {_id:2431}, end: {_id:2486}, properties:{file_path:"unknown_source", truncate:"", keywords:"bidirectional influence,interdependence", weight:1.0, description:"The external environment and internal mental state mutually affect each other.", created_at:1779173789, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde"}}, {start: {_id:2487}, end: {_id:2433}, properties:{file_path:"unknown_source", keywords:"collective impact,universal signals", truncate:"", weight:1.0, description:"Individual mental states contribute to collective unconscious signals affecting the universe.", created_at:1779173790, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde"}}, {start: {_id:2081}, end: {_id:2485}, properties:{file_path:"unknown_source", keywords:"life outcomes,state dependency", truncate:"", weight:1.0, description:"Decisions made from a suffering state perpetuate similar life outcomes.", created_at:1779173790, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde"}}, {start: {_id:788}, end: {_id:1617}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oalnb5-fHjY)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=k5RDNv-CH9M)<SEP>YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", keywords:"analogy,biological basis,comparison,consciousness,correlation,electrical activity,mental states,neurological impact,thought", truncate:"", weight:6.0, description:"The mind and brain are components of the broader concept of consciousness.<SEP>The mind's state directly influences the brain's condition in depression.<SEP>The brain is compared to hardware, while the mind is likened to software in the mind-brain analogy.<SEP>The brain's electrical impulses correlate with mental processes, linking brain function to the mind.<SEP>The brain and mind are correlated, with brainwave patterns influencing mental states like focus or distraction.<SEP>The brain and mind are correlated, with brainwave patterns influencing mental states like focus or distraction.", created_at:1779555039, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde<SEP>chunk-f02b83f12f802c289fd8c9176c6dc8a9<SEP>chunk-f1b4fdaeda1ac88655f980287b031a38<SEP>chunk-1da2512b00580b9e23c48d26a05dd048<SEP>chunk-4c105f1c2d83f8107fb4042d9f1771a7"}}, {start: {_id:2082}, end: {_id:344}, properties:{file_path:"unknown_source", keywords:"conflict,distraction", truncate:"", weight:1.0, description:"Ego distracts individuals from being fully present with loved ones, hindering connection and love.`", created_at:1779173790, source_id:"chunk-02f292000f544446b15f0519998d1dbc"}}, {start: {_id:2488}, end: {_id:2434}, properties:{file_path:"unknown_source", keywords:"outcome,practice", truncate:"", weight:6.0, description:"Soul Sync Meditation leads to a calm, quiet consciousness and dissolution of stress.` This is also a duplicate/rephrasing of the first `Soul Sync Meditation` relationship. It's redundant.<SEP>Soul Sync Meditation leads to a calm, quiet consciousness and dissolution of stress.`", created_at:1779173790, source_id:"chunk-02f292000f544446b15f0519998d1dbc"}}, {start: {_id:1454}, end: {_id:499}, properties:{file_path:"unknown_source", keywords:"dissolution,transformation", truncate:"", weight:1.0, description:"Consistent spiritual practices dissolve stress and suffering, fostering inner transformation.`", created_at:1779173790, source_id:"chunk-02f292000f544446b15f0519998d1dbc"}}, {start: {_id:32}, end: {_id:2390}, properties:{file_path:"unknown_source", keywords:"fulfillment,purpose discovery", truncate:"", weight:1.0, description:"Spirituality provides a framework to discover purpose through connection rather than external validation.", created_at:1779173790, source_id:"chunk-39ae671b46577f26845d7bb862a61c36"}}] AS row
