UNWIND [{start: {name:"Beautiful State"}, end: {_id:302}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"manifestation,mechanism", truncate:"", weight:1.0, description:"A beautiful state enables impact on consciousness to manifest aspirations through heightened presence and connection.", created_at:1779136853, source_id:"chunk-3a296ec9ad2af5d46dab6c458e4a48dd"}}, {start: {name:"Consciousness"}, end: {_id:151}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional harm,negative effect", truncate:"", weight:1.0, description:"Prolonging suering damages consciousness and obstructs spiritual evolution.", created_at:1779136854, source_id:"chunk-3a296ec9ad2af5d46dab6c458e4a48dd"}}, {start: {name:"Beautiful State"}, end: {_id:151}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"insight,prerequisite", truncate:"", weight:1.0, description:"A beautiful state requires penetrating insight into suering to transcend emotional suffering and achieve freedom.", created_at:1779136854, source_id:"chunk-3a296ec9ad2af5d46dab6c458e4a48dd"}}, {start: {name:"Consciousness"}, end: {_id:674}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"awareness,foundation", truncate:"", weight:1.0, description:"True transformation requires conscious acknowledgment of deeper internal conflicts.", created_at:1779139122, source_id:"chunk-48d38d40b501a5ac9741fdde5e643c26"}}, {start: {name:"Consciousness"}, end: {_id:115}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"awareness,liberation,realization", truncate:"", weight:2.0, description:"Consciousness leads to the realization of freedom by moving beyond internal and external commentaries.<SEP>Consciousness enables freedom from mental constructs, leading to joy.", created_at:1779522100, source_id:"chunk-6a2ca3b4a00fd65d72ac5932a227e2a8<SEP>chunk-97418c51f26c4090e6f6b986b0a848a6"}}, {start: {name:"Consciousness"}, end: {_id:287}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)<SEP>YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"acceptance,chaos,definition,equivalence,mindfulness,realization", truncate:"", weight:3.0, created_at:1779560499, description:"Consciousness allows for the acceptance of life as it is, without judgment.<SEP>Consciousness is equated with life in the discussed philosophy.<SEP>Applying conscious practices like pausing and emotional reflection mitigates life's chaos and fosters balance.", source_id:"chunk-6a2ca3b4a00fd65d72ac5932a227e2a8<SEP>chunk-29839d6d7d0e5b2cd1270aaf6c732c38<SEP>chunk-24179c364db0fb884a0fd4e2f2818e29"}}, {start: {name:"Consciousness"}, end: {_id:739}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"acceptance,realization", truncate:"", weight:1.0, description:"Consciousness allows for the acceptance of family as it is, without judgment.", created_at:1779139430, source_id:"chunk-6a2ca3b4a00fd65d72ac5932a227e2a8"}}, {start: {name:"Consciousness"}, end: {_id:741}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"acceptance,realization", truncate:"", weight:1.0, description:"Consciousness allows for the acceptance of home as it is, without judgment.", created_at:1779139430, source_id:"chunk-6a2ca3b4a00fd65d72ac5932a227e2a8"}}, {start: {name:"Mantra"}, end: {_id:827}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"ritual component,verbalization", truncate:"", weight:1.0, description:"The practice incorporates repeating the mantra to release ego and invoke universal intelligence.", created_at:1779139925, source_id:"chunk-0f71ee987f163ec7e16a16625977c53b"}}, {start: {name:"Mantra"}, end: {_id:785}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"activation,conceptual alignment,invocation,symbolic expression", truncate:"", weight:2.0, description:"The mantra serves as a linguistic tool to manifest engagement with universal intelligence.<SEP>The mantra is used to invoke and align with the concept of universal intelligence.", created_at:1779184411, source_id:"chunk-0f71ee987f163ec7e16a16625977c53b<SEP>chunk-0f072682ae3f44593523bf73ac3ea68d"}}, {start: {name:"Ekam"}, end: {_id:17}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"construction,creation,domain-specific term,enlightened states,founder,mystic philosophy,non-duality,spiritual concept,teachings,vision", truncate:"", weight:5.0, created_at:1779257012, description:"Krishnaji founded Ekam as a meditation space to fulfill his parents? vision.<SEP>Krishnaji and the author share the ability to enter Ekam, a state of non-duality.<SEP>Krishnaji emphasizes Ekam as a transformative force in O&O Academy's teachings.<SEP>Krishnaji had a vision for Ekam, which he built to fulfill his parents' vision, transforming it into a mystical powerhouse.<SEP>Krishnaji is associated with the domain-specific term Ekam, which is correctly used.", source_id:"chunk-0e2f9a055fb112218647413f8ddc6ac5<SEP>chunk-ffbd16a80a3f36425c182278e7bb273d<SEP>chunk-8539e53b3407e35921fe5963280d3207<SEP>chunk-d46158568d6d67d2d4fe51b282a138b1<SEP>chunk-87a42eb6572d13c3b49d24da9eb84c9b"}}, {start: {name:"Ekam"}, end: {_id:785}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"connection,source of power,spiritual access", truncate:"", weight:2.0, description:"Ekam is described as a mystical powerhouse connected to universal intelligence, facilitating transcendence.<SEP>Ekam serves as a space to connect with universal intelligence for life decisions.", created_at:1779145124, source_id:"chunk-0e2f9a055fb112218647413f8ddc6ac5<SEP>chunk-7e637a18b58bf595a06a2db9ad36bf77"}}, {start: {name:"Ekam"}, end: {_id:832}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"insight,spiritual awakening,transcendental experience,transformation", truncate:"", weight:2.0, description:"Julie's time at Ekam leads to profound insights about pain and relationships.<SEP>Julie connected to Ekam through a transformative experience of compassion that reshaped her worldview.", created_at:1779140010, source_id:"chunk-39c43682e6cddb97cee86565eb8e431d<SEP>chunk-0b07a36cd1f063043e90acfc38fefaef"}}, {start: {name:"Consciousness"}, end: {_id:900}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"relational breakdown,self-obsession", truncate:"", weight:1.0, description:"Self-obsessed consciousness leads to disconnection and relationship breakdowns.", created_at:1779140475, source_id:"chunk-a813939f321629f8537b01c0cc6653ae"}}, {start: {name:"Consciousness"}, end: {_id:449}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"enduring love,transformation", truncate:"", weight:1.0, description:"Transforming consciousness from separation to connection enables relationships to evolve into enduring love.", created_at:1779140475, source_id:"chunk-a813939f321629f8537b01c0cc6653ae"}}, {start: {name:"Consciousness"}, end: {_id:901}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"connection,mutual understanding", truncate:"", weight:1.0, description:"Consciousness transformation fosters enduring love through mutual understanding and connection.", created_at:1779140475, source_id:"chunk-a813939f321629f8537b01c0cc6653ae"}}, {start: {name:"Beautiful State"}, end: {_id:176}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"achievement,goal,involves living in,self-awareness", truncate:"", weight:2.0, description:"Spiritual Vision enables people to live in a beautiful state of joy and fulfillment.<SEP>A spiritual vision centers on living in a beautiful state of being.", created_at:1779141216, source_id:"chunk-25a61dd1a643342f5252980f3c78e37e<SEP>chunk-9126b7168266feeb5c044ddb65ae0392"}}, {start: {name:"Beautiful State"}, end: {_id:311}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: U23yKxWbIcI (URL: