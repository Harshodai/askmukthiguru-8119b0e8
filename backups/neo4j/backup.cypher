runcate:"", created_at:1779722026, description:"Action, work, or deed; also refers to the spiritual principle of cause and effect.", source_id:"chunk-3ba320b05f330dd38ee53d270146e432<SEP>chunk-161257a3b15bcafcf939769dfff5e967<SEP>chunk-8828f50e6038efd15058fd650efc925a<SEP>chunk-f736079de24478bec6cb37255e7aac1e<SEP>chunk-43647d3a6ff9b1049b42faa7da2a7b2c<SEP>chunk-83abb98046d1159250c7575ec257ce14<SEP>chunk-fb861a7ad5968de00a0781413686a72d<SEP>chunk-d489685c096e08c1d7c865c1d88afb77<SEP>chunk-ad8cd9c49a16ec95450897f747dabecf<SEP>chunk-cee82b1a7026fdd1406998388ea35c61<SEP>chunk-e346b8f3e13471227b92c08380bf14d1<SEP>chunk-295ff82e6931c82451b6f00c8154605e<SEP>chunk-ed6b93b857d66f4aba7388c8d2b20ca9<SEP>chunk-e6bccf95254b72b0d63718f7708bb634<SEP>chunk-3252cf650a481bf3542ef91ee7acaae1", entity_id:"Karma"}}, {name:"Jeevan Mukta", properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"concept", truncate:"", description:"Jeevan Mukta refers to an awakened state of being liberated from worldly attachments, leading to union with Universal Consciousness.<SEP>Jeevan Mukta refers to a state of liberation in Indian philosophy where an individual is free from rebirth and worldly attachments.<SEP>Jeevan Mukta refers to a state of liberation where the afterlife is experienced as progressive blissfulness until union with Universal Consciousness or Brahman.", created_at:1779229186, source_id:"chunk-6995806c11a29b44fc7094ee22938f78<SEP>chunk-484efc8f94e4787f4bc0cc8762ad9476<SEP>chunk-7fd3191dae6c1c66321a24ecdfc2f30a<SEP>chunk-dd4f29607e86446996b5a0f4d31130d7", entity_id:"Jeevan Mukta"}}, {name:"Sankalpa", properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UbCEX5KBbPw)<SEP>YouTube Video: nQpRoOOu5Yc (URL: https://www.youtube.com/watch?v=nQpRoOOu5Yc)", entity_type:"concept", truncate:"", description:"Sankalpa refers to a spiritual resolution or vow made with intention and focus, central to the practice.<SEP>Sankalpa refers to a sacred resolution made during Ugadi to live harmoniously with life's cyclical nature.<SEP>Sankalpa is a sacred vow or resolution made to create a new inner universe.<SEP>Sankalpa refers to a sacred vow or intention to live harmoniously through life's cyclical seasons, embodying gratitude and adaptability.", created_at:1779519051, source_id:"chunk-6b7fcb0be46e5dc8bc514960fa89b8be<SEP>chunk-61d286a10ba0271970a579e1cf354cf5<SEP>chunk-6af3220a340f626ce621832ca3542da1<SEP>chunk-f34e8e10dbf92b5936295383ee0c7f10", entity_id:"Sankalpa"}}, {name:"Guru", properties:{file_path:"unknown_source<SEP>YouTube Video: Qu5IQo0ghbs (URL: https://www.youtube.com/watch?v=Qu5IQo0ghbs)<SEP>YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", entity_type:"concept", truncate:"", created_at:1779665876, description:"<think>
