UNWIND [{start: {_id:8246}, end: {_id:8218}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", truncate:"", keywords:"effectiveness,meditation practice,results", weight:2.0, description:"Guided meditations yield great results on distracted days.<SEP>Guided meditations yield results on days when the meditator is distracted, as explicitly stated in the content.", created_at:1779734696, source_id:"chunk-a10e920484b4b5f03e118c89aee5a8de<SEP>chunk-619f3a9b9f1a9a2f69d32ef07fbabf7c"}}, {start: {_id:8245}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", truncate:"", keywords:"content analysis,discussion", weight:1.0, description:"The YouTube video discusses Rule 3, which addresses punctuation and capitalization for readability.", created_at:1779734647, source_id:"chunk-a10e920484b4b5f03e118c89aee5a8de"}}, {start: {_id:1790}, end: {_id:8245}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", keywords:"grammar,readability", truncate:"", weight:1.0, description:"Rule 3 is related to the rules of punctuation and capitalization for readability.", created_at:1779734648, source_id:"chunk-a10e920484b4b5f03e118c89aee5a8de"}}, {start: {_id:8247}, end: {_id:8245}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", truncate:"", keywords:"content,examples", weight:1.0, description:"Rule 3 contains list items as examples of its application.", created_at:1779734648, source_id:"chunk-a10e920484b4b5f03e118c89aee5a8de"}}, {start: {_id:8219}, end: {_id:8220}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", keywords:"mental state,navigation", truncate:"", weight:1.0, description:"Navigating conflicting thoughts through meditation leads to mental clarity represented by open clearings.", created_at:1779734683, source_id:"chunk-a6282514b611392194d87cce5b2c4ab4"}}, {start: {_id:8216}, end: {_id:8238}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", keywords:"disappointment,expectation", truncate:"", weight:1.0, description:"Beginners give up due to unmet expectations of instant results from meditation.", created_at:1779734684, source_id:"chunk-a6282514b611392194d87cce5b2c4ab4"}}, {start: {_id:8249}, end: {_id:8218}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", keywords:"effectiveness,support", truncate:"", weight:1.0, description:"Guided meditations are particularly effective on days when practitioners are distracted.", created_at:1779734684, source_id:"chunk-a6282514b611392194d87cce5b2c4ab4"}}, {start: {_id:8218}, end: {_id:8248}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", truncate:"", keywords:"metaphor,method", weight:1.0, description:"Hand-hold is a metaphorical method used in guided meditations to provide support.", created_at:1779734684, source_id:"chunk-a6282514b611392194d87cce5b2c4ab4"}}, {start: {_id:8218}, end: {_id:8233}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", keywords:"metaphor,technique", truncate:"", weight:1.0, description:"Hand-hold is used as a metaphorical technique in guided meditations to enhance clarity and engagement during practice.", created_at:1779734696, source_id:"chunk-619f3a9b9f1a9a2f69d32ef07fbabf7c"}}, {start: {_id:8251}, end: {_id:8252}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", truncate:"", keywords:"grammatical fix", weight:1.0, description:"The fragment \"Exploring the uncharted consciousness...\" should be integrated into the previous sentence as \"They explore the uncharted consciousness...\" to maintain flow and clarity.>", created_at:1779734937, source_id:"chunk-f0b4c182f4c7ce1f24b104d5170609f0"}}, {start: {_id:8221}, end: {_id:8222}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", truncate:"", keywords:"compound verb,grammatical correction,typo correction", weight:2.0, description:"The typo \"hand hold\" should be corrected to \"hand-hold\" by adding a hyphen for proper compound usage.><SEP>The phrase \"hand hold\" is corrected to the compound verb \"hand-hold\" to align with standard grammatical conventions.", created_at:1779734941, source_id:"chunk-f0b4c182f4c7ce1f24b104d5170609f0<SEP>chunk-02886e80b539cd7ee63b9c4f5a0af110"}}, {start: {_id:8250}, end: {_id:8253}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", truncate:"", keywords:"grammatical fix,list structure", weight:1.0, description:"The original list item should be revised to \"Beginners attempting meditation\" for parallelism and grammatical accuracy.", created_at:1779734938, source_id:"chunk-02886e80b539cd7ee63b9c4f5a0af110"}}, {start: {_id:8251}, end: {_id:8254}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", truncate:"", keywords:"integration,sentence fragment", weight:1.0, description:"The fragment \"Exploring the uncharted consciousness...\" needs to be connected to the preceding sentence for coherence.", created_at:1779734941, source_id:"chunk-02886e80b539cd7ee63b9c4f5a0af110"}}, {start: {_id:8235}, end: {_id:8243}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", truncate:"", keywords:"meditation leads to,method to outcome", weight:1.0, description:"Unguided meditation contributes to enduring results.", created_at:1779734961, source_id:"chunk-30d3f42efa9576e322e258b3d40a98fa"}}, {start: {_id:1742}, end: {_id:8248}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", keywords:"syntax,typo correction", truncate:"", weight:1.0, description:"Hand-hold is corrected from \"hand hold\" to adhere to compound adjective rules, resolving a grammatical inconsistency.", created_at:1779735012, source_id:"chunk-8e15fc85d32ce342ec9c480484b3580f"}}, {start: {_id:1742}, end: {_id:8255}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", truncate:"", keywords:"clarity,structure", weight:1.0, description:"List items require proper verb usage and punctuation for coherence, as seen in the correction of \"Beginners attempt...\".", created_at:1779735012, source_id:"chunk-8e15fc85d32ce342ec9c480484b3580f"}}, {start: {_id:1742}, end: {_id:4052}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", keywords:"completeness,syntax", truncate:"", weight:1.0, description:"Fragments like \"Exploring the uncharted consciousness...\" need full sentences for grammatical correctness.", created_at:1779735013, source_id:"chunk-8e15fc85d32ce342ec9c480484b3580f"}}, {start: {_id:8218}, end: {_id:8244}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", truncate:"", keywords:"appeal,relevance", weight:1.0, description:"Guided meditations are associated with the desire for instant results in meditation practice.", created_at:1779735013, source_id:"chunk-ea2c880e0817109d2e1724af65951447"}}, {start: {_id:8216}, end: {_id:289}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", keywords:"behavior,challenge", truncate:"", weight:1.0, description:"Beginners are prone to quitting due to frustration, as implied in the text's context.", created_at:1779735013, source_id:"chunk-8e15fc85d32ce342ec9c480484b3580f"}}, {start: {_id:8218}, end: {_id:1301}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", truncate:"", keywords:"appeal,relevance", weight:1.0, description:"Guided meditations are perceived as requiring or catering to specific intellectual engagement.", created_at:1779735013, source_id:"chunk-ea2c880e0817109d2e1724af65951447"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
