UNWIND [{start: {_id:28}, end: {_id:3665}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", keywords:"adaptation,resilience", truncate:"", weight:1.0, description:"Opportunities emerge from redefining human connection and emotional needs.", created_at:1779236454, source_id:"chunk-ad21c8251c43d2428c2c1fc6eaf57acc"}}, {start: {_id:1406}, end: {_id:449}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"emotional vulnerability,impermanence", weight:1.0, description:"Depression arises from transient nature of relationships and connections.", created_at:1779236454, source_id:"chunk-ad21c8251c43d2428c2c1fc6eaf57acc"}}, {start: {_id:3662}, end: {_id:1406}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"emotional collapse,failure impact", weight:1.0, description:"Business failures are connected to depressive responses through perceived finality.", created_at:1779236455, source_id:"chunk-ad21c8251c43d2428c2c1fc6eaf57acc"}}, {start: {_id:479}, end: {_id:3651}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"collective action,self-awareness", weight:1.0, description:"Mental disease is presented as addressable through conscious human connection.", created_at:1779236455, source_id:"chunk-ad21c8251c43d2428c2c1fc6eaf57acc"}}, {start: {_id:371}, end: {_id:116}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"cyclical nature,natural order", weight:1.0, description:"Loneliness is framed as an inherent universal condition requiring conscious management.", created_at:1779236456, source_id:"chunk-ad21c8251c43d2428c2c1fc6eaf57acc"}}, {start: {_id:3663}, end: {_id:371}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"emotional unity,transcendence", weight:1.0, description:"\"Feeling human beings\" is proposed as antidote to loneliness through shared humanity.", created_at:1779236456, source_id:"chunk-ad21c8251c43d2428c2c1fc6eaf57acc"}}, {start: {_id:3666}, end: {_id:2406}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"error resolution,language correction", weight:2.0, description:"The original phrase \"becoming feeling human beings\" was corrected to \"becoming a feeling human being\" to fix a grammatical error.", created_at:1779236511, source_id:"chunk-1e483a5aae3e722cbcbaae7e0a2f3d19"}}, {start: {_id:3656}, end: {_id:3668}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"relationship dynamics,sensitivity", weight:1.0, description:"Partners in a relationship can be sensitive to each other, showing mutual care.", created_at:1779236512, source_id:"chunk-1e483a5aae3e722cbcbaae7e0a2f3d19"}}, {start: {_id:852}, end: {_id:1799}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"emotional experience,mental state", weight:1.0, description:"Human Beings can experience fear, which parents can recognize in their children.", created_at:1779236512, source_id:"chunk-1e483a5aae3e722cbcbaae7e0a2f3d19"}}, {start: {_id:794}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"content,theme", weight:1.0, description:"YouTube Video contains content discussing Heart Intelligence as a key theme.", created_at:1779236555, source_id:"chunk-40bd05ead62aaeb01579393d5559a014"}}, {start: {_id:3654}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"content,theme", weight:1.0, description:"YouTube Video contains content discussing Artificial Intelligence as a key theme.", created_at:1779236555, source_id:"chunk-40bd05ead62aaeb01579393d5559a014"}}, {start: {_id:794}, end: {_id:3637}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"concealment,emotional understanding", weight:1.0, description:"Heart intelligence involves recognizing and addressing the emotions concealed by masks to foster healing and avoid judgment.", created_at:1779236602, source_id:"chunk-e8c3861302e4fee45689e6fb65d84e48"}}, {start: {_id:333}, end: {_id:1463}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"empathy,judgment avoidance", weight:1.0, description:"People are urged to feel and understand their loved ones' emotions before judging them as unsocial or arrogant.", created_at:1779236602, source_id:"chunk-e8c3861302e4fee45689e6fb65d84e48"}}, {start: {_id:3669}, end: {_id:794}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"emotional understanding,global healing", weight:1.0, description:"Heart intelligence is directly linked to emotional healing as the text states it is the only way for the world to be healed.", created_at:1779236602, source_id:"chunk-e8c3861302e4fee45689e6fb65d84e48"}}, {start: {_id:3671}, end: {_id:1463}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"empathy,judgment avoidance", weight:1.0, description:"The text advises feeling and understanding colleagues' emotions to prevent misjudgment based on superficial behavior.", created_at:1779236602, source_id:"chunk-e8c3861302e4fee45689e6fb65d84e48"}}, {start: {_id:3670}, end: {_id:1463}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"empathy,judgment avoidance", weight:1.0, description:"People should feel and understand their neighbors' emotions before making judgments about their actions or demeanor.", created_at:1779236602, source_id:"chunk-e8c3861302e4fee45689e6fb65d84e48"}}, {start: {_id:598}, end: {_id:3637}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"emotional concealment,misjudgment", weight:1.0, description:"Masks lead to misjudgment as people are perceived as unsocial or arrogant without understanding their hidden emotions.", created_at:1779236603, source_id:"chunk-e8c3861302e4fee45689e6fb65d84e48"}}, {start: {_id:1463}, end: {_id:3672}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"concealment,emotional trauma", weight:1.0, description:"Ridicule caused people to conceal their pains, illustrating the origin of masking behaviors.", created_at:1779236603, source_id:"chunk-e8c3861302e4fee45689e6fb65d84e48"}}, {start: {_id:496}, end: {_id:3674}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"neglect,ridicule", weight:1.0, description:"The friends were ridiculed for their anxiety instead of being consoled.", created_at:1779236648, source_id:"chunk-c2dfb10d73bb85ba3334f2281cc0afee"}}, {start: {_id:1406}, end: {_id:3640}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"emotional suppression,mental health", weight:1.0, description:"Emotions are dismissed as a waste of time, contributing to depression.", created_at:1779236648, source_id:"chunk-c2dfb10d73bb85ba3334f2281cc0afee"}}] AS row
