UNWIND [{start: {_id:2023}, end: {_id:7627}, properties:{file_path:"unknown_source", keywords:"conquering death,method", truncate:"", weight:2.0, description:"Genetic engineering is used as a method to conquer death.", created_at:1779669414, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400"}}, {start: {_id:2023}, end: {_id:7628}, properties:{file_path:"unknown_source", keywords:"conquering death,method", truncate:"", weight:2.0, description:"Stem cell research is used as a method to conquer death.", created_at:1779669414, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400"}}, {start: {_id:1799}, end: {_id:7631}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"gestation comparison,sensitivity", weight:1.0, description:"The text compares human and elephant gestation periods, highlighting sensitivity.", created_at:1779669460, source_id:"chunk-2e8cf037a481fa8f6c03056c638fd995"}}, {start: {_id:7581}, end: {_id:7579}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"discussion,environmental context", weight:1.0, description:"The World Environment Day is the context in which the discussion about the pregnant elephant's killing takes place.", created_at:1779669460, source_id:"chunk-2e8cf037a481fa8f6c03056c638fd995"}}, {start: {_id:7633}, end: {_id:7581}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"discussion,ethical concern", weight:1.0, description:"The text discusses the heartless killing of a pregnant elephant.", created_at:1779669460, source_id:"chunk-2e8cf037a481fa8f6c03056c638fd995"}}, {start: {_id:7632}, end: {_id:7631}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", keywords:"duration,nurturing", truncate:"", weight:1.0, description:"The text mentions the mother elephant holding her baby for 18-22 months.", created_at:1779669460, source_id:"chunk-2e8cf037a481fa8f6c03056c638fd995"}}, {start: {_id:3719}, end: {_id:7578}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", keywords:"maternal care,nurturing", truncate:"", weight:1.0, description:"An elephant mother provides care, grooming, and protection to her offspring over years of upbringing.", created_at:1779669497, source_id:"chunk-3f4d7d5f1ac5203240b389ee05d9fc5e"}}, {start: {_id:1799}, end: {_id:7635}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", keywords:"exploitation,theft", truncate:"", weight:1.0, description:"Human beings are described as stealing life, land, babies, bodies, and future from others through arrogance and entitlement.", created_at:1779669497, source_id:"chunk-3f4d7d5f1ac5203240b389ee05d9fc5e"}}, {start: {_id:4578}, end: {_id:7637}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"economic impact,health crisis", weight:1.0, description:"The virus disrupts", created_at:1779669575, source_id:"chunk-5f51161e463ac960fab8b2a50bc6505c"}}, {start: {_id:7641}, end: {_id:7579}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"environmental awareness,ethical consumption", weight:1.0, description:"The World Environment Day is associated with the decision to avoid purchasing objects that harm animals, promoting environmental and ethical responsibility.", created_at:1779669627, source_id:"chunk-b7f51f52125fd52ba3d4f9070154d664"}}, {start: {_id:7582}, end: {_id:7579}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"harmony,universal well-being", weight:1.0, description:"The World Environment Day involves chanting Sanskrit phrases to promote universal well-being and harmony among all beings.", created_at:1779669627, source_id:"chunk-b7f51f52125fd52ba3d4f9070154d664"}}, {start: {_id:7641}, end: {_id:7643}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"animal welfare,ethical consumption", weight:1.0, description:"The decision to not buy harmful objects is motivated by the suffering of animals, such as the Mother Elephant, to prevent further harm.", created_at:1779669627, source_id:"chunk-b7f51f52125fd52ba3d4f9070154d664"}}, {start: {_id:7639}, end: {_id:7582}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"Sanskrit phrases,inclusivity,universal well-being", weight:2.0, description:"These two Sanskrit phrases are part of the same chant, both promoting universal well-being and harmony.<SEP>Both mantras collectively emphasize compassion for all sentient beings and ecological balance.", created_at:1779670618, source_id:"chunk-b7f51f52125fd52ba3d4f9070154d664<SEP>chunk-427deb5cc43b417a4dd893f3e73a5d18"}}, {start: {_id:7644}, end: {_id:7645}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"creation context,ethical concern", weight:1.0, description:"The quoted text raises ethical questions about objects of beauty or prestige potentially being created through harm to animals.", created_at:1779669646, source_id:"chunk-809f983a7cfe15bffeec6a7d03608d1b"}}, {start: {_id:7579}, end: {_id:7648}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"conservation,environmental awareness", weight:1.0, description:"World Environment Day highlights environmental issues, contrasting with the text's discussion of elephant killings.", created_at:1779669650, source_id:"chunk-5c12b3ed0b19bd1ebb50b224bafcfb2e"}}, {start: {_id:7580}, end: {_id:7648}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"cultural practices,ethical conflict", weight:1.0, description:"The text references worship of Vinayaka alongside elephant killings, creating a moral tension.", created_at:1779669650, source_id:"chunk-5c12b3ed0b19bd1ebb50b224bafcfb2e"}}, {start: {_id:7648}, end: {_id:6730}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", keywords:"empathy,ethical treatment", truncate:"", weight:1.0, description:"The text contrasts human actions (killing elephants) with elephants' sensitivity and family-oriented nature.", created_at:1779669650, source_id:"chunk-5c12b3ed0b19bd1ebb50b224bafcfb2e"}}, {start: {_id:7649}, end: {_id:7637}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"cause-effect,economic collapse", weight:1.0, description:"The virus is portrayed as capable of crippling the global economy through mass mortality and disruption.", created_at:1779670597, source_id:"chunk-fbc362953fe784a8510b72471b749390"}}, {start: {_id:486}, end: {_id:7580}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"ethical conflict,religious contradiction", weight:1.0, description:"The text contrasts India's worship of Vinayaka with its actions against elephants, highlighting a moral paradox.", created_at:1779670597, source_id:"chunk-fbc362953fe784a8510b72471b749390"}}, {start: {_id:1220}, end: {_id:7640}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", keywords:"cruelty,exploitation", truncate:"", weight:1.0, description:"Human arrogance is linked to the unethical treatment and endangerment of elephants.", created_at:1779670597, source_id:"chunk-fbc362953fe784a8510b72471b749390"}}] AS row
