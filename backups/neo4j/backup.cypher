UNWIND [{_id:7303, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"content", truncate:"", description:"The textual content of the YouTube video, which includes a corrected version of a misheard phrase (\"A state of humanity is and fear\").", created_at:1779662638, source_id:"chunk-a532d15b45a354bea11d6dc57df813b2", entity_id:"Video Content"}}, {_id:7304, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"concept", truncate:"", description:"A philosophical or literary statement discussing the relationship between humanity and fear, repeated multiple times in the source text.", created_at:1779662692, source_id:"chunk-6a2dcd2eb95d21b4ee80f566c015729b", entity_id:"A state of humanity is, and fear."}}, {_id:7305, properties:{file_path:"YouTube Video: vch9C_hNjGs (URL: https://www.youtube.com/watch?v=vch9C_hNjGs)", entity_type:"concept", truncate:"", description:"The bliss of being is a state of pure existence from which achievements arise, nurturing individual and universal well-being.", created_at:1779662710, source_id:"chunk-c9bb5b4ae7e13a7674f385925b990906", entity_id:"Bliss of Being"}}, {_id:7306, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The difference between problem and suffering is a key understanding, where problems are external and suffering is internal.", created_at:1779662713, source_id:"chunk-9f51181a0a82fab99daeacb192359f2b", entity_id:"Difference between Problem and Suffering"}}, {_id:7307, properties:{file_path:"YouTube Video: k8iO5daXllM (URL: https://www.youtube.com/watch?v=k8iO5daXllM)", entity_type:"person", truncate:"", description:"A role responsible for correcting text errors on the Mukthi Guru platform, focusing on homophones, domain-specific terms, punctuation, and capitalization.", created_at:1779662741, source_id:"chunk-963de118dd8c42af405a0b9cfddcf2c4", entity_id:"Text Correction Expert for the 'Mukthi Guru' Spiritual Platform"}}, {_id:7308, properties:{file_path:"unknown_source<SEP>YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"person", truncate:"", description:"Bhishma is a revered warrior and character in the Mahabharata.<SEP>Bhishma is a revered warrior and character in the Mahabharata.<SEP>Bhishma is a revered warrior and character in the Mahabharata.<SEP>Bhishma is a key character in the Mahabharata, known for his vow of celibacy and role in the war.", created_at:1779663276, source_id:"chunk-d0968f5f92c9347abb58d844c3aec5da<SEP>chunk-5345dea91d4424a106a1b8dd1d7e28bc", entity_id:"Bhishma"}}, {_id:7309, properties:{file_path:"unknown_source<SEP>YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"artifact", truncate:"", description:"Panchajanya is the divine conch of Krishna, symbolizing power and authority.<SEP>Panchajanya is the divine conch of Krishna, symbolizing power and authority.<SEP>Panchajanya is the divine conch of Krishna, symbolizing power and authority.<SEP>Panchajanya is a mythological conch linked to Shri Krishna, symbolizing divine power.", created_at:1779663276, source_id:"chunk-d0968f5f92c9347abb58d844c3aec5da<SEP>chunk-5345dea91d4424a106a1b8dd1d7e28bc", entity_id:"Panchajanya"}}, {_id:7310, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"concept", truncate:"", created_at:1779663280, description:"Ahimsa is explicitly mentioned in the text as a correctly spelled term related to non-violence, retained for consistency.<SEP>A concept related to non-violence, being checked for correct spelling and usage in the text.<SEP>Ahimsa refers to non-violence and is emphasized in the Mahabharata.<SEP>Ahimsa is a principle of non-violence and courage, not cowardice, associated with non-violent consciousness.<SEP>Ahimsa is a principle of non-violence and courage, not cowardice, associated with non-violent consciousness.<SEP>Ahimsa is a philosophical concept representing non-violence, mentioned in the text and part of the required terminology list.", source_id:"chunk-56beafdcb3b1849d02261de108f9203d<SEP>chunk-b6b7965a92e6a9f97b92b09724af8152<SEP>chunk-4529c1884cd3f5e14f3ad9c161d86e76<SEP>chunk-31d0c1d0868a0433b37bd7b3d6982020<SEP>chunk-a86eca0b1f90f6c49a60c38f2bf9272a", entity_id:"Ahimsa"}}, {_id:7313, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"concept", truncate:"", description:"The reality of war involves human suffering, destruction, and long-term societal consequences beyond numerical data.", created_at:1779663108, source_id:"chunk-f0397f46fa5013a38f8a2900ffa6eef9", entity_id:"Reality of War"}}, {_id:7314, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"concept", truncate:"", description:"Human suffering encompasses physical pain, emotional trauma, and societal upheaval caused by warfare.", created_at:1779663108, source_id:"chunk-f0397f46fa5013a38f8a2900ffa6eef9", entity_id:"Human Suffering"}}, {_id:7315, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"concept", truncate:"", description:"Historical wars are conflicts documented in textbooks characterized by numerical data and dates, contrasting with the actual reality of war.", created_at:1779663108, source_id:"chunk-f0397f46fa5013a38f8a2900ffa6eef9", entity_id:"Historical Wars"}}, {_id:7316, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"other", truncate:"", description:"A violent neighbor is mentioned as a potential invader, prompting the need for self-defense through war.", created_at:1779663135, source_id:"chunk-0360e3d7478d7aa88e74b472aef4bc64", entity_id:"violent neighbor"}}, {_id:7317, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"concept", truncate:"", description:"Self-defense is emphasized as the ethical justification for war, positioning it as a last resort to safeguard innocent populations.", created_at:1779663135, source_id:"chunk-0360e3d7478d7aa88e74b472aef4bc64", entity_id:"Self-Defense"}}, {_id:7318, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"location", truncate:"", description:"Frontiers refer to the geographical boundaries where citizens stand to protect the country, symbolizing defense positions.", created_at:1779663135, source_id:"chunk-0360e3d7478d7aa88e74b472aef4bc64", entity_id:"frontiers"}}, {_id:7319, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"concept", truncate:"", description:"Paramo Dharma signifies the supreme righteousness and is discussed in the Mahabharata.", created_at:1779663147, source_id:"chunk-4529c1884cd3f5e14f3ad9c161d86e76", entity_id:"Paramo Dharma"}}, {_id:7320, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"person", truncate:"", created_at:1779663229, description:"Arjuna is a warrior guided by Shri Krishna in the Mahabharata.<SEP>Arjuna is a warrior in the Mahabharata who is encouraged by Shri Krishna to fulfill his duty amidst moral dilemmas.<SEP>Arjuna is a warrior in the Mahabharata who is encouraged by Shri Krishna to fulfill his duty amidst moral dilemmas.<SEP>Arjuna is a figure from the Mahabharata, mentioned in the analysis.", source_id:"chunk-35a211b7f3bf5a88de37f2e6c5d66a39<SEP>chunk-716f70c82340a863624fa47098e63ad3<SEP>chunk-270fcc29517d133cdb2e1b97b5e80e64<SEP>chunk-379dcbaa1fba64cd1d562fe797bdcf77<SEP>chunk-4529c1884cd3f5e14f3ad9c161d86e76<SEP>chunk-31d0c1d0868a0433b37bd7b3d6982020<SEP>chunk-9d3dc0d7e3d5f00409884918b93104a2", entity_id:"Arjuna"}}, {_id:7321, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"person", truncate:"", description:"Soldier's Dharma is to lay his life to protect the nation.", created_at:1779663147, source_id:"chunk-4529c1884cd3f5e14f3ad9c161d86e76", entity_id:"Soldier"}}, {_id:7322, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"concept", truncate:"", description:"Global violence is a result of individual consciousness filled with conflict.", created_at:1779663148, source_id:"chunk-4529c1884cd3f5e14f3ad9c161d86e76", entity_id:"Global Violence"}}, {_id:7325, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"concept", truncate:"", description:"Bharatavarsa refers to ancient India, characterized as an ancient nation with a history of non-violence except for the Cholas.<SEP>Bharatavarsa refers to ancient India, characterized as an ancient nation with a history of non-violence except for the Cholas.", created_at:1779663170, source_id:"chunk-31d0c1d0868a0433b37bd7b3d6982020", entity_id:"Bharatavarsa"}}, {_id:7326, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"organization", truncate:"", created_at:1779663276, description:"The Cholas were a historical dynasty in ancient India, representing an exception to the nation's non-warmongering history.<SEP>The Cholas were a historical dynasty in ancient India, representing an exception to the nation's non-warmongering history.<SEP>The Cholas are a historical dynasty, referenced in the analysis.<SEP>The Cholas refer to a historical South Indian dynasty, mentioned in the context of cultural references.", source_id:"chunk-31d0c1d0868a0433b37bd7b3d6982020<SEP>chunk-9d3dc0d7e3d5f00409884918b93104a2<SEP>chunk-5345dea91d4424a106a1b8dd1d7e28bc", entity_id:"Cholas"}}] AS row
