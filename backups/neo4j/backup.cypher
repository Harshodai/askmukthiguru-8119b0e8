UNWIND [{start: {_id:1766}, end: {name:"Mantra"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"linguistic accuracy,spiritual practice", weight:1.0, description:"Hamsa Soham is maintained as a correctly spelled mantra in the narrative.", created_at:1779217976, source_id:"chunk-cdb6ddc2b47b984a3a935456e27dbbae"}}, {start: {_id:2413}, end: {name:"Consciousness"}, properties:{file_path:"unknown_source", keywords:"life aspects,state impact", truncate:"", weight:1.0, description:"A bad state communicates with consciousness, leading to chaos in life aspects.", created_at:1779222880, source_id:"chunk-7969e4168ecd055a3fbcda3d1911b288"}}, {start: {_id:2356}, end: {name:"Consciousness"}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)", keywords:"communication,influence,life aspects,state impact", truncate:"", weight:2.0, description:"A connected state communicates with consciousness, leading to order in life aspects.<SEP>The connected state communicates with the vast field of consciousness, influencing life order.", created_at:1779223210, source_id:"chunk-7969e4168ecd055a3fbcda3d1911b288<SEP>chunk-534aa5b1bce760dde6fcebe7d2a8da54"}}, {start: {_id:2598}, end: {name:"Ekam"}, properties:{file_path:"unknown_source", keywords:"awareness,overcoming", truncate:"", weight:1.0, description:"Ekam facilitates overcoming addictions by fostering self-realization and peace.", created_at:1779224564, source_id:"chunk-e2bd3f4cf43dab42e9cb72ed41ed496d"}}, {start: {_id:2859}, end: {name:"Deeksha"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", keywords:"spiritual platform", truncate:"", weight:1.0, description:"Deeksha is the correct term in the context of the spiritual platform, contrasting with the incorrect term \"de-addiction\".", created_at:1779225479, source_id:"chunk-674ee76b3bca8182248c9dd21be326b4"}}, {start: {_id:497}, end: {name:"Ekam"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", truncate:"", keywords:"healing,spiritual resolution", weight:1.0, description:"Ekam's approach addresses addiction through heart healing rather than chemical dependency.", created_at:1779225625, source_id:"chunk-94adc3d4525b736bf33ffd5d5752ec38"}}, {start: {_id:2886}, end: {name:"Deeksha"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", truncate:"", keywords:"conceptual contrast,terminology correction", weight:1.0, description:"Deeksha (spiritual transformation) is contrasted with de-addiction (clinical treatment) to align with the platform's spiritual focus.", created_at:1779225694, source_id:"chunk-1cce98cd0aed40f77c27d3d6b1cb14b9"}}, {start: {_id:1517}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=OWMBvMlGWTA)", truncate:"", keywords:"resolution,state progression", weight:1.0, description:"First level of oneness eliminates internal conflict through calmness.", created_at:1779230028, source_id:"chunk-f75c5d6ff6cf90a0c79623ead0773fbc"}}, {start: {_id:900}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=OWMBvMlGWTA)", truncate:"", keywords:"empathy,unity", weight:1.0, description:"Second level of oneness dissolves disconnection, fostering empathy for others' emotions.", created_at:1779230028, source_id:"chunk-f75c5d6ff6cf90a0c79623ead0773fbc"}}, {start: {_id:3463}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"contrast,opposition", truncate:"", weight:1.0, description:"Suffering represents a negative state, while life free of suffering is the desired, enlightened state.", created_at:1779230277, source_id:"chunk-86019daf1852abb84546a1585e862173"}}, {start: {_id:3464}, end: {name:"Suffering State"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=MKOAMUmZ-RA)", keywords:"avoidance,symbolism", truncate:"", weight:1.0, description:"The Chhataka bird symbolizes refusing to live in a suffering state, waiting for ideal conditions (rainwater) instead of settling for imperfect ones (pond/lake water).", created_at:1779230345, source_id:"chunk-8ae7d2bf13d490cfea1a9347ee1a6a78"}}, {start: {_id:157}, end: {name:"Suffering State"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=MKOAMUmZ-RA)", truncate:"", keywords:"cause,origin", weight:1.0, description:"Challenges lead to suffering states, creating a cycle of struggle.", created_at:1779230345, source_id:"chunk-8ae7d2bf13d490cfea1a9347ee1a6a78"}}, {start: {_id:1791}, end: {name:"Deeksha"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"conceptual reference,thematic focus", weight:1.0, description:"The corrected text includes a quote referencing Deeksha and its role in global healing.", created_at:1779236793, source_id:"chunk-2b42ee8fd386f9e10963b4508c131024"}}, {start: {_id:3796}, end: {name:"Ekam"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)", truncate:"", keywords:"domain-specific terms,reference list", weight:1.0, description:"Ekam is included in the domain-specific terms list.", created_at:1779241219, source_id:"chunk-4aa2186804f084108c45c41993118d21"}}, {start: {_id:3898}, end: {name:"Consciousness"}, properties:{file_path:"unknown_source", keywords:"existence,universal presence", truncate:"", weight:1.0, description:"Consciousness is described as present in all entities from bacteria to humans.", created_at:1779243856, source_id:"chunk-2e434306df5b4f2083250fff41e8b701"}}, {start: {_id:3887}, end: {name:"Brahman"}, properties:{file_path:"unknown_source", keywords:"content,essence", truncate:"", weight:1.0, description:"The Brahma Sutras contain the essence of Brahman.", created_at:1779243856, source_id:"chunk-6c96fcf9dc4b3dd6ae02c9c745b85e2a"}}, {start: {_id:299}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"obstacle,transformation", truncate:"", weight:1.0, description:"Dissolving suffering states is framed as necessary to achieve and share love.", created_at:1779247285, source_id:"chunk-1049ffa49a880db4b5369cf84bcae432"}}, {start: {_id:1328}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"cause,effect", truncate:"", weight:1.0, description:"Inner disturbance directly causes suffering in individuals and society.", created_at:1779248745, source_id:"chunk-c9caee3e34754dd743fb5e0f90ac1a6b"}}, {start: {_id:739}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"consequences,impact", truncate:"", weight:1.0, description:"Suffering affects families through cycles of pain and negative interactions.", created_at:1779248746, source_id:"chunk-c9caee3e34754dd743fb5e0f90ac1a6b"}}, {start: {_id:287}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"consequences,impact", truncate:"", weight:1.0, description:"Suffering diminishes the quality of personal life and overall well-being.", created_at:1779248746, source_id:"chunk-c9caee3e34754dd743fb5e0f90ac1a6b"}}] AS row
