UNWIND [{_id:2414, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Battles in life aspects include problems in relationships, finances, health, and business, which arise from a bad state.", created_at:1779222862, source_id:"chunk-7969e4168ecd055a3fbcda3d1911b288", entity_id:"Battles in Life Aspects"}}, {_id:2415, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Diabetes is a disease that sets chaos in health, which can then spread to other aspects of life.<SEP>Diabetes is a medical condition that disrupts bodily communication, leading to chaos and multiple diseases.<SEP>Diabetes is a health condition that can lead to various complications such as heart disease, tumors, kidney failure, liver failure, and cancer.<SEP>A chronic disease caused by excessive eating and sedentary habits.", created_at:1779562483, source_id:"chunk-9d4d6de56ac10d5ab428310e3d4ea053<SEP>chunk-7969e4168ecd055a3fbcda3d1911b288<SEP>chunk-f1afa41b3519d740bacb88dad54ed44e<SEP>chunk-92de552ab3b343ec94bcf5b612359aba<SEP>chunk-458ec7ed8021b6846b23a3c0fa7e9821", entity_id:"Diabetes"}}, {_id:2416, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A self-centered life, focused only on oneself and disconnected from others, brings about battles in various aspects of life.", created_at:1779222862, source_id:"chunk-7969e4168ecd055a3fbcda3d1911b288", entity_id:"Self-Centered Life"}}, {_id:2417, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Heart disease is an example of chaos spreading from health to other aspects of life.<SEP>Heart disease is a condition caused by diabetes, resulting from disrupted bodily communication.<SEP>Heart disease is a health complication associated with diabetes.<SEP>Cardiovascular issues linked to excessive stress and unhealthy habits.", created_at:1779562483, source_id:"chunk-7969e4168ecd055a3fbcda3d1911b288<SEP>chunk-f1afa41b3519d740bacb88dad54ed44e<SEP>chunk-92de552ab3b343ec94bcf5b612359aba<SEP>chunk-458ec7ed8021b6846b23a3c0fa7e9821", entity_id:"Heart Disease"}}, {_id:2418, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)", entity_type:"concept", truncate:"", created_at:1779223478, description:"Tumors are an example of chaos spreading from health to other aspects of life.<SEP>Tumors are abnormal growths caused by diabetes, arising from disrupted bodily communication.<SEP>Tumors are a health complication linked to diabetes.", source_id:"chunk-7969e4168ecd055a3fbcda3d1911b288<SEP>chunk-f1afa41b3519d740bacb88dad54ed44e<SEP>chunk-92de552ab3b343ec94bcf5b612359aba", entity_id:"Tumors"}}, {_id:2419, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)", entity_type:"concept", truncate:"", created_at:1779223478, description:"Kidney failure is an example of chaos spreading from health to other aspects of life.<SEP>Kidney failure is a condition caused by diabetes, resulting from disrupted bodily communication.<SEP>Kidney failure is a health complication caused by diabetes.", source_id:"chunk-7969e4168ecd055a3fbcda3d1911b288<SEP>chunk-f1afa41b3519d740bacb88dad54ed44e<SEP>chunk-92de552ab3b343ec94bcf5b612359aba", entity_id:"Kidney Failure"}}, {_id:2420, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)", entity_type:"concept", truncate:"", created_at:1779223478, description:"Liver failure is an example of chaos spreading from health to other aspects of life.<SEP>Liver failure is a condition caused by diabetes, resulting from disrupted bodily communication.<SEP>Liver failure is a health complication resulting from diabetes.", source_id:"chunk-7969e4168ecd055a3fbcda3d1911b288<SEP>chunk-f1afa41b3519d740bacb88dad54ed44e<SEP>chunk-92de552ab3b343ec94bcf5b612359aba", entity_id:"Liver Failure"}}, {_id:2421, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)", entity_type:"concept", truncate:"", created_at:1779223478, description:"Cancer is an example of chaos spreading from health to other aspects of life.<SEP>Cancer is a condition caused by diabetes, resulting from disrupted bodily communication.<SEP>Cancer is a health complication that can be caused by diabetes.", source_id:"chunk-9d4d6de56ac10d5ab428310e3d4ea053<SEP>chunk-7969e4168ecd055a3fbcda3d1911b288<SEP>chunk-f1afa41b3519d740bacb88dad54ed44e<SEP>chunk-92de552ab3b343ec94bcf5b612359aba", entity_id:"Cancer"}}, {_id:2422, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Chaos in health (e.g., diabetes) spreads to other health issues like heart disease.", created_at:1779222880, source_id:"chunk-7969e4168ecd055a3fbcda3d1911b288", entity_id:"Chaos in Health"}}, {_id:2423, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Chaos in one aspect spreads to other aspects of life.", created_at:1779222881, source_id:"chunk-7969e4168ecd055a3fbcda3d1911b288", entity_id:"Chaos in One Aspect"}}, {_id:2424, properties:{file_path:"unknown_source<SEP>YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"Trillion cells in the body are part of the ecosystem affected by meditation, influencing communication and overall bodily functions.<SEP>A concept referring to the vast number of cells in the human body that are described as being in perfect communication with each other.", created_at:1779555342, source_id:"chunk-4d59e72aadbbf0c922fc8ed13db1693a<SEP>chunk-65663b0201354a6434222ff714a6bcfd", entity_id:"Trillion Cells"}}, {_id:2425, properties:{file_path:"unknown_source<SEP>YouTube Video: M_BYTcsLQuY (URL: https://www.youtube.com/watch?v=M_BYTcsLQuY)", entity_type:"concept", truncate:"", description:"Vibration refers to the energetic state or resonance within the body, which is altered by meditation.<SEP>Vibration refers to the energetic frequency associated with words and chants in meditation practices.<SEP>Vibration refers to the energetic frequency created by the mantra, central to the meditation practice.<SEP>Vibration refers to the energetic frequency created by the mantra, central to the meditation practice.", created_at:1779552684, source_id:"chunk-4d59e72aadbbf0c922fc8ed13db1693a<SEP>chunk-6aebd99b80a116244470eacf183c4202<SEP>chunk-61c0437442c1a79367c1612c9b022b8f", entity_id:"Vibration"}}, {_id:2426, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Sri Sri Krishnaji is a spiritual teacher who shares insights about human consciousness and states of mind.<SEP>Sri Sri Krishnaji is a guest on the Frankly Speaking show, co-creator of Ekam.<SEP>Sri Sri Krishnaji is a spiritual leader who participated in the Frankly Speaking show and discussed healing and connecting within.<SEP>Sri Sri Krishnaji is a co-founder of the ?kam movement, known for providing clarity and wisdom-based programs rooted in deep knowing rather than books.<SEP>Sri Sri Krishnaji is a spiritual leader and co-creator of the Breathing Room App, emphasizing love and connection.<SEP>Sri Sri Krishnaji is a spiritual leader and co-creator of Ekam, recognized for his teachings on divine energy and consciousness.`", created_at:1779174167, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde<SEP>chunk-1c3c80dce751d1f7b79cbb9a20a4e9ce<SEP>chunk-5c8f3b58191cd7eb20e97c7adfd8085c<SEP>chunk-5c61cf6a11b484a07796c6dda3777527<SEP>chunk-ee8405ae87a23d4c3cf8bfa26fd8efc8<SEP>chunk-9cc01d3ebb7c00cd64ce3517df7de5fd", entity_id:"Sri Sri Krishnaji"}}, {_id:2427, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The Beautiful State of mind represents a positive inner experience characterized by peace and clarity.", created_at:1779173396, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde", entity_id:"Beautiful State of mind"}}, {_id:2428, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The Suffering State of mind represents a negative inner experience marked by stress, anxiety, or unhappiness.", created_at:1779173396, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde", entity_id:"Suffering State of mind"}}, {_id:2429, properties:{file_path:"unknown_source<SEP>YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", entity_type:"naturalobject", truncate:"", description:"Neurons are nerve cells in the brain that form connections and release neuropeptides based on mental states.<SEP>Neurons are specialized cells in the brain involved in transmitting electrical impulses.<SEP>Neurons in the heart are affected during heartbreak, leading to physical damage and syndrome development.<SEP>Neurons in the heart and brain are responsible for intuition and decision-making processes.", created_at:1779558332, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde<SEP>chunk-1c4d31dfa44d01e98b11093ef31cbb04<SEP>chunk-f34fb6f27b6128e7888cfaefe712d84a<SEP>chunk-0e593bb50eabcacd46122f257190fe7f", entity_id:"Neurons"}}, {_id:2430, properties:{file_path:"unknown_source", entity_type:"location", truncate:"", description:"The garden serves as a metaphor for the brain's neural pathways and habit formation.", created_at:1779173397, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde", entity_id:"Garden"}}, {_id:2431, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The external environment interacts with and is influenced by the individual's mental state.<SEP>The physical world targeted for change in the culture's pursuit of happiness.", created_at:1779244222, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde<SEP>chunk-cdbfc6e200f4cd4487961cefed0a0954", entity_id:"External Environment"}}, {_id:2432, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Life situations are events and circumstances shaped by the individual's mental state.", created_at:1779173420, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde", entity_id:"Life Situations"}}, {_id:2433, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=U1qRvz3hnMA)", entity_type:"data", truncate:"", description:"The global population is referenced in the context of individual experiences and universal signals.<SEP>Population refers to the demographic scale (over a billion) in India, intensifying challenges like poverty and resource scarcity.`", created_at:1779672190, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde<SEP>chunk-4e900263f52a257effc9757bdfd34e24", entity_id:"Population"}}] AS row
