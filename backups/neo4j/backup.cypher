UNWIND [{start: {_id:4938}, end: {_id:4978}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"proposed solution,societal change", weight:1.0, description:"The video advocates inclusive thinking as a path to end exploitation and achieve harmony.", created_at:1779420719, source_id:"chunk-dcbde403840148f165365cfd6299b08f"}}, {start: {_id:2578}, end: {_id:4978}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"root cause,systemic issue", truncate:"", weight:1.0, description:"The video identifies economic unrest as requiring fundamental shifts in leadership approaches.", created_at:1779420719, source_id:"chunk-dcbde403840148f165365cfd6299b08f"}}, {start: {_id:4962}, end: {_id:4978}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"prerequisite,transformative process", weight:1.0, description:"The video positions awakening experiences as essential for paradigm shifts toward unity.", created_at:1779420720, source_id:"chunk-dcbde403840148f165365cfd6299b08f"}}, {start: {_id:4971}, end: {_id:4978}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"critical analysis,societal framework", weight:1.0, description:"The video critiques the \"nation of separation\" as a construct contrasting with humanity's origin in oneness.", created_at:1779420720, source_id:"chunk-dcbde403840148f165365cfd6299b08f"}}, {start: {_id:299}, end: {_id:904}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"opposition negation,philosophical concept", weight:1.0, description:"Separation is not the opposite of love but represents absence from it, as stated in the text.", created_at:1779420972, source_id:"chunk-af881796b97d19f020179697b9daf675