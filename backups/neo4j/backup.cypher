, {_id:8000, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vNj7OSHos1I)", entity_type:"concept", truncate:"", description:"Patriotism, Peace, and Superiority are themes in the monologue to be preserved during corrections.<SEP>Patriotism, Peace, and Superiority are themes in the monologue to be preserved during corrections.<SEP>Patriotism, Peace, and Superiority are themes in the monologue to be preserved during corrections.<SEP>Patriotism, Peace, and Superiority are themes in the monologue to be preserved during corrections.<SEP>Patriotism, Peace, and Superiority are themes in the monologue to be preserved during corrections.", created_at:1779723559, source_id:"chunk-25889c9ac840d16fb7ae03c1e584ad1b", entity_id:"Patriotism, Peace, and Superiority"}}, {_id:8001, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vNj7OSHos1I)", entity_type:"content", truncate:"", description:"A monologue discussing themes of patriotism, peace, and superiority, described as repetitive and having run-on sentences.<SEP>A monologue discussing themes of patriotism, peace, and superiority, described as repetitive and having run-on sentences.", created_at:1779722362, source_id:"chunk-93d9522c9ab38104a94e5ffe196677ac", entity_id:"Monologue"}}, {_id:8002, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vNj7OSHos1I)", entity_type:"concept", truncate:"", created_at:1779723367, description:"A concept discussed in the monologue, emphasizing themes of national pride and unity.<SEP>A concept discussed in the monologue, emphasizing themes of national pride and unity.<SEP>A political concept discussed in the video text, framed as a question about its problems.<SEP>Patriotism is mentioned as not being the root cause of the problem.", source_id:"chunk-93d9522c9ab38104a94e5ffe196677ac<SEP>chunk-3604f42cc9ad5b9575c539fb8353080f<SEP>chunk-bb8c7007984e1dbf803d7545148dee09", entity_id:"Patriotism"}}, {_