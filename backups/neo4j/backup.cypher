d58c3a45098cba0eac97acb3b39<SEP>chunk-40812a40d215948dcfd5e68f4034cb4b"}}, {start: {_id:6547}, end: {_id:6627}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"artifact presence,location feature", weight:1.0, description:"The long utensils are present in hell.", created_at:1779564225, source_id:"chunk-8bc65d58c3a45098cba0eac97acb3b39"}}, {start: {_id:6547}, end: {_id:6631}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"difficulty,eating challenge", weight:1.0, description:"In hell, people use long utensils which makes eating difficult.", created_at:1779564226, source_id:"chunk-8bc65d58c3a45098cba0eac97acb3b39"}}, {start: {_id:6546}, end: {_id:6632}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"eating,feed,feeding,serving,used for,used to", weight:16.0, description:"The spoon was used for serving Biryani to another person.<SEP>Biryani was used to feed another person with the spoon.<SEP>The spoon is used to feed Biryani to another person.<SEP>Biryani was served using a spoon.", created_at:1779564231, source_id:"chunk-40812a40d215948dcfd5e68f4034cb4b"}}, {start: {_id:234}, end: {_id:6632}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"feeding,serving,using", truncate:"", weight:9.0, description:"The person used the spoon to feed Biryani to another person.", created_at:1779564232, source_id:"chunk-40812a40d215948dcfd5e68f4034cb4b"}}, {start: {_id:6634}, end: {_id:2727}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"emotional conflict,psychological impact", weight:1.0, description:"Dasharatha's actions caused immense guilt, leading to his psychological torment and death.", created_at:1779564257, source_id:"chunk-c0b80dedb75ca2eb809b280546928f57"}}, {start: {_id:991}, end: {_id:6636}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"conceptual relationship,personal growth", weight:1.0, description:"Self-forgiveness is presented as a specific manifestation of forgiveness critical for inner peace.", created_at:1779564257, source_id:"chunk-c0b80dedb75ca2eb809b280546928f57"}}, {start: {_id:6637}, end: {_id:2444}, properties:{file_path:"unknown_source", truncate:"", keywords:"forgiveness impact,karmic cycle disruption", weight:2.0, description:"Authentic forgiving oneself breaks negative karmic cycles and enables harmony.<SEP>Authentic forgiving oneself breaks negative karmic cycles and enables harmony.", created_at:1779564353, source_id:"chunk-ea1f0fc5a4bd6b550f008cf8e4905da5"}}, {start: {_id:6638}, end: {_id:632}, properties:{file_path:"unknown_source<SEP>YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"example,mythological narrative,story,transformation story", weight:3.0, description:"The Ramayana narrates Ahalya's transformation and redemption.<SEP>The Ramayana narrates Ahalya's transformation and redemption.<SEP>Ahalya's story in the Ramayana serves as a classical example of forgiving oneself.", created_at:1779564440, source_id:"chunk-ea1f0fc5a4bd6b550f008cf8e4905da5<SEP>chunk-f35ecb38bfeca95ba27fabf08e8561a8"}}, {start: {_id:1335}, end: {_id:6641}, properties:{file_path:"unknown_source<SEP>YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"anger expression,compassion,forgiveness,forgiveness denial,forgiveness encounter,spiritual lesson", weight:5.0, description:"Buddha responded to the businessman's anger with a smile, teaching forgiveness.<SEP>Buddha denied forgiveness to the businessman, emphasizing self-awareness.<SEP>Buddha responded to the businessman's anger with a smile, teaching forgiveness.<SEP>Buddha denied forgiveness to the businessman, emphasizing self-awareness.<SEP>Buddha refuses to forgive the businessman, redirecting the act of forgiveness to the unknown victim, challenging conventional notions of forgiveness.", created_at:1779564552, source_id:"chunk-ea1f0fc5a4bd6b550f008cf8e4905da5<SEP>chunk-24b5f3611aa0088cf040177e4f897986"}}, {start: {_id:6638}, end: {_id:6639}, properties:{file_path:"unknown_source<SEP>YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"abandonment,betrayal,infidelity,marital relationship,marriage", truncate:"", weight:5.0, created_at:1779564444, description:"Sage Gautama abandoned Ahalya after discovering her infidelity with Indra.<SEP>Sage Gautama abandoned Ahalya after discovering her infidelity with Indra.<SEP>Sage Gautama and his son abandon Ahalya after discovering her infidelity.<SEP>Sage Gautama was married to Ahalya but abandoned her after her infidelity with Indra.<SEP>Ahalya was married to Sage Gautama, who abandoned her after her infidelity.", source_id:"chunk-ea1f0fc5a4bd6b550f008cf8e4905da5<SEP>chunk-f35ecb38bfeca95ba27fabf08e8561a8<SEP>chunk-6a0ae176234daa0b99856020306df342"}}, {start: {_id:6638}, end: {_id:6633}, properties:{file_path:"unknown_source<SEP>YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"compassion,compassion interaction,transformation,transformation catalyst", weight:3.0, description:"Sri Rama's compassion transformed Ahalya from stone back to human.<SEP>Sri Rama's compassion transformed Ahalya from stone back to human.<SEP>Ahalya's transformation was caused by Sri Rama's compassion and touch.", created_at:1779564445, source_id:"chunk-ea1f0fc5a4bd6b550f008cf8e4905da5<SEP>chunk-6a0ae176234daa0b99856020306df342"}}, {start: {_id:6646}, end: {_id:2378}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"game participation,played", truncate:"", weight:1.0, description:"The boy played the game Gilly with his cousins and friends.", created_at:1779564375, source_id:"chunk-8bc46e0d57c8aca69ad6ab17dc5cfd03"}}, {start: {_id:6646}, end: {_id:3041}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"mentioned,reference", truncate:"", weight:1.0, description:"The game Gilly is mentioned in the Mahabharata as an ancient game.", created_at:1779564375, source_id:"chunk-8bc46e0d57c8aca69ad6ab17dc5cfd03"}}, {start: {_id:6650}, end: {_id:2378}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"caused,incident", weight:1.0, description:"The boy's actions during the game led to the cousin's injury.", created_at:1779564375, source_id:"chunk-8bc46e0d57c8aca69ad6ab17dc5cfd03"}}, {start: {_id:2378}, end: {_id:6648}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"advice,impact", weight:1.0, description:"The uncle's words about hurting people affected the boy's decision to stop playing.", created_at:1779564375, source_id:"chunk-8bc46e0d57c8aca69ad6ab17dc5cfd03"}}] AS row
