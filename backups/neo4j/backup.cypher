UNWIND [{start: {_id:2832}, end: {_id:417}, properties:{file_path:"unknown_source", keywords:"coping mechanism,reinterpretation", truncate:"", weight:1.0, description:"Jaya reinterpreted her trauma as empowering to manage bitterness and maintain a facade of strength.", created_at:1779183782, source_id:"chunk-da0dcd44b642ae88bb5ae6bfa953a323"}}, {start: {_id:2833}, end: {_id:417}, properties:{file_path:"unknown_source", keywords:"facade,self-image", truncate:"", weight:1.0, description:"Jaya's self-image as an independent woman masked her true emotional state and need for love.", created_at:1779183782, source_id:"chunk-da0dcd44b642ae88bb5ae6bfa953a323"}}, {start: {_id:417}, end: {_id:2834}, properties:{file_path:"unknown_source", keywords:"emotional concealment,self-deception", truncate:"", weight:1.0, description:"Jaya's mask hid her vulnerability and unresolved trauma from herself and others.", created_at:1779183783, source_id:"chunk-da0dcd44b642ae88bb5ae6bfa953a323"}}, {start: {_id:2835}, end: {_id:417}, properties:{file_path:"unknown_source", keywords:"healing,self-realization", truncate:"", weight:1.0, description:"Jaya's realization of her injured sense of self during the retreat marked the beginning of her healing process.", created_at:1779183783, source_id:"chunk-da0dcd44b642ae88bb5ae6bfa953a323"}}, {start: {_id:2841}, end: {_id:916}, properties:{file_path:"unknown_source", keywords:"inheritance,transmission", truncate:"", weight:1.0, description:"Pain can be transmitted across generations through behavioral patterns.>", created_at:1779183840, source_id:"chunk-5d0f74c4239eabf7a6fea87da28be5d8"}}, {start: {_id:533}, end: {_id:470}, properties:{file_path:"unknown_source", truncate:"", keywords:"emotional release,therapeutic approach", weight:1.0, description:"Compassion is used to address and heal the wounded child state, promoting self-awareness and release from suffering.", created_at:1779183840, source_id:"chunk-5d0f74c4239eabf7a6fea87da28be5d8"}}, {start: {_id:684}, end: {_id:195}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"awareness,emotional recognition,emotional support,generational impact,parent-child relationship,role model enforcement,trauma transmission,values transmission", weight:4.0, description:"Parents unconsciously pass on hurt to their children, perpetuating cycles of pain and loneliness.<SEP>Parents can heal their children by recognizing and responding to their emotional states.<SEP>Parents can recognize their children's emotional states, including depression, fear, dullness, and sadness.<SEP>Parents perpetuate societal norms by teaching children to adopt external role models.", created_at:1779524873, source_id:"chunk-5d0f74c4239eabf7a6fea87da28be5d8<SEP>chunk-1f205cfd4f752f944e4f589c26e28701<SEP>chunk-1e483a5aae3e722cbcbaae7e0a2f3d19<SEP>chunk-3d3e1db7059b50ed67e675540955de81"}}, {start: {_id:449}, end: {_id:338}, properties:{file_path:"unknown_source", keywords:"emotional impact,influence", truncate:"", weight:1.0, description:"The wounded child's pain influences interpersonal relationships.>", created_at:1779183841, source_id:"chunk-5d0f74c4239eabf7a6fea87da28be5d8"}}, {start: {_id:451}, end: {_id:338}, properties:{file_path:"unknown_source", keywords:"emotional impact,influence", truncate:"", weight:1.0, description:"The wounded child's pain affects everyday interactions.>", created_at:1779183841, source_id:"chunk-5d0f74c4239eabf7a6fea87da28be5d8"}}, {start: {_id:354}, end: {_id:2845}, properties:{file_path:"unknown_source", keywords:"metaphor,self-realization", truncate:"", weight:1.0, description:"The story metaphorically represents the reader's potential transformation into the happy child state through self-awareness.", created_at:1779183866, source_id:"chunk-0c3de714c4e42df4c68c8fd79dfac5ad"}}, {start: {_id:505}, end: {_id:2849}, properties:{file_path:"unknown_source", keywords:"incident context,location", truncate:"", weight:1.0, description:"The dining hall was the setting where Christina was publicly insulted by Lee.", created_at:1779183899, source_id:"chunk-b66967ff647e15e2ccfdb242ffc22fb6"}}, {start: {_id:473}, end: {_id:151}, properties:{file_path:"unknown_source", keywords:"emotional regulation,liberation,mitigation,self-obsession", truncate:"", weight:2.0, description:"The text posits that suffering perpetuates itself through self-obsession, while inner truth offers freedom from this cycle.<SEP>Practicing inner truth helps manage and wear away the state of suffering.", created_at:1779183981, source_id:"chunk-54ab0057ebb9d14ac4c0eb525f843612<SEP>chunk-b08d62f86bbc31949dd35e6cc9e75def"}}, {start: {_id:505}, end: {_id:2850}, properties:{file_path:"unknown_source", keywords:"exploitation,generosity", truncate:"", weight:1.0, description:"Christina?s financial support to Lee?s daughter was later perceived as exploited, fueling her resentment.", created_at:1779183900, source_id:"chunk-b66967ff647e15e2ccfdb242ffc22fb6"}}, {start: {_id:2851}, end: {_id:544}, properties:{file_path:"unknown_source", keywords:"mutual understanding,self-obsession", truncate:"", weight:1.0, description:"The man's self-obsession initially strains the relationship, but observing his inner truth fosters mutual respect and shared goals.", created_at:1779183957, source_id:"chunk-21bacf187c7f2b778c240499081154ba"}}, {start: {_id:2726}, end: {_id:2160}, properties:{file_path:"unknown_source", keywords:"symbolism,totality", truncate:"", weight:1.0, description:"The temple's mix of sacred and ordinary images represents the entirety of human experience, including emotions and dualities.", created_at:1779183957, source_id:"chunk-21bacf187c7f2b778c240499081154ba"}}, {start: {_id:2852}, end: {_id:514}, properties:{file_path:"unknown_source", keywords:"emotional control,prevention", truncate:"", weight:1.0, description:"The sacred secret of inner truth prevents the escalation of habitual negative emotional states.", created_at:1779183957, source_id:"chunk-b08d62f86bbc31949dd35e6cc9e75def"}}, {start: {_id:534}, end: {_id:544}, properties:{file_path:"unknown_source", keywords:"dissolution,observation", truncate:"", weight:1.0, description:"The man learns to observe his emotions passively, leading to their dissolution and emergence of calmness.", created_at:1779183957, source_id:"chunk-21bacf187c7f2b778c240499081154ba"}}, {start: {_id:2852}, end: {_id:2853}, properties:{file_path:"unknown_source", keywords:"metaphor,negative impact", truncate:"", weight:1.0, description:"Negative emotions are compared to poisonous weeds that can choke and destroy life.", created_at:1779183957, source_id:"chunk-b08d62f86bbc31949dd35e6cc9e75def"}}, {start: {_id:17}, end: {_id:544}, properties:{file_path:"unknown_source", keywords:"guidance,teaching", truncate:"", weight:1.0, description:"Krishnaji guides the man to observe his inner truth, leading to his self-realization and relationship transformation.", created_at:1779183978, source_id:"chunk-21bacf187c7f2b778c240499081154ba"}}, {start: {_id:473}, end: {_id:506}, properties:{file_path:"unknown_source", keywords:"awareness,contrast", truncate:"", weight:1.0, description:"Inner truth involves observing the mind without judgment, contrasting with self-obsession's narrow focus on oneself.", created_at:1779183981, source_id:"chunk-21bacf187c7f2b778c240499081154ba"}}] AS row
