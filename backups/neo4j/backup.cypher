UNWIND [{start: {_id:5531}, end: {_id:5445}, properties:{file_path:"unknown_source<SEP>YouTube Video: c2oUDKf6ndo (URL: https://www.youtube.com/watch?v=c2oUDKf6ndo)", keywords:"dignity,impact,spiritual power", truncate:"", weight:2.0, description:"Recognizing women with total dignity and spiritual power impacts world consciousness, fostering peace and dissolving objectification.<SEP>Recognizing women's spiritual power impacts world consciousness towards peace.", created_at:1779518429, source_id:"chunk-8371bf8d7e493ffa27d258dec87d349a<SEP>chunk-1ae790eba9b81ee033f955299e2cd86b"}}, {start: {_id:5532}, end: {_id:2814}, properties:{file_path:"unknown_source", keywords:"contribution,dissolution", truncate:"", weight:1.0, description:"Dissolving violence towards women contributes to achieving world peace by addressing a critical source of global conflict.", created_at:1779518428, source_id:"chunk-8371bf8d7e493ffa27d258dec87d349a"}}, {start: {_id:5526}, end: {_id:1490}, properties:{file_path:"unknown_source<SEP>YouTube Video: c2oUDKf6ndo (URL: https://www.youtube.com/watch?v=c2oUDKf6ndo)", keywords:"connection,purpose,upliftment", truncate:"", weight:2.0, description:"Akin is built to connect and uplift human consciousness through global meditation and conscious awakening.<SEP>Akin is designed to connect and uplift human consciousness.", created_at:1779518429, source_id:"chunk-8371bf8d7e493ffa27d258dec87d349a<SEP>chunk-1ae790eba9b81ee033f955299e2cd86b"}}, {start: {_id:5527}, end: {_id:2814}, properties:{file_path:"YouTube Video: c2oUDKf6ndo (URL: https://www.youtube.com/watch?v=c2oUDKf6ndo)", keywords:"contribution,dissolution", truncate:"", weight:1.0, description:"Dissolving violence towards women is necessary to achieve world peace.", created_at:1779518428, source_id:"chunk-1ae790eba9b81ee033f955299e2cd86b"}}, {start: {_id:5445}, end: {_id:2814}, properties:{file_path:"unknown_source", keywords:"impact,transformation", truncate:"", weight:1.0, description:"Shifting world consciousness through meditation fosters harmony, contributing to global peace by dissolving conflict and violence.", created_at:1779518428, source_id:"chunk-8371bf8d7e493ffa27d258dec87d349a"}}, {start: {_id:1490}, end: {_id:5445}, properties:{file_path:"YouTube Video: c2oUDKf6ndo (URL: https://www.youtube.com/watch?v=c2oUDKf6ndo)", truncate:"", keywords:"connection,uplift", weight:1.0, description:"Uplifting human consciousness contributes to a shift in world consciousness.", created_at:1779518429, source_id:"chunk-1ae790eba9b81ee033f955299e2cd86b"}}, {start: {_id:5534}, end: {_id:2649}, properties:{file_path:"YouTube Video: w2qbJB6ie9Y (URL: https://www.youtube.com/watch?v=w2qbJB6ie9Y)", truncate:"", keywords:"emergence,vision", weight:1.0, description:"The program aims to lead to the emergence of wealth creators living from an enlightened state of consciousness.", created_at:1779518902, source_id:"chunk-97cc62cd33395d4327ecfafbda5320fa"}}, {start: {_id:5533}, end: {_id:5537}, properties:{file_path:"YouTube Video: w2qbJB6ie9Y (URL: https://www.youtube.com/watch?v=w2qbJB6ie9Y)", truncate:"", keywords:"program focus,transformation", weight:1.0, description:"O&O focuses on peak performance and related disciplines to drive transformative personal and professional experiences.", created_at:1779518902, source_id:"chunk-97cc62cd33395d4327ecfafbda5320fa"}}, {start: {_id:1487}, end: {_id:5534}, properties:{file_path:"YouTube Video: w2qbJB6ie9Y (URL: https://www.youtube.com/watch?v=w2qbJB6ie9Y)", keywords:"consciousness,fusion", truncate:"", weight:1.0, description:"The program emphasizes the fusion of truth and an enlightened state of consciousness to create a meaningful life.", created_at:1779518902, source_id:"chunk-97cc62cd33395d4327ecfafbda5320fa"}}, {start: {_id:5535}, end: {_id:5534}, properties:{file_path:"YouTube Video: w2qbJB6ie9Y (URL: https://www.youtube.com/watch?v=w2qbJB6ie9Y)", keywords:"audience,program focus", truncate:"", weight:1.0, description:"The program is designed for business owners, entrepreneurs, investors, and high performers aiming to elevate their lives and businesses.", created_at:1779518902, source_id:"chunk-97cc62cd33395d4327ecfafbda5320fa"}}, {start: {_id:5536}, end: {_id:5534}, properties:{file_path:"YouTube Video: w2qbJB6ie9Y (URL: https://www.youtube.com/watch?v=w2qbJB6ie9Y)", truncate:"", keywords:"introspection,program focus", weight:1.0, description:"The program facilitates self-discovery and living in accordance with one's truth.", created_at:1779518902, source_id:"chunk-97cc62cd33395d4327ecfafbda5320fa"}}, {start: {_id:5533}, end: {_id:5476}, properties:{file_path:"unknown_source", keywords:"affiliation,program offering", truncate:"", weight:1.0, description:"The One Consciousness Business Circle is associated with O&O as its transformative program for personal and professional growth.", created_at:1779518929, source_id:"chunk-d934a78e12e582c4cd7a16fc71609ccd"}}, {start: {_id:5533}, end: {_id:62}, properties:{file_path:"unknown_source<SEP>YouTube Video: w2qbJB6ie9Y (URL: https://www.youtube.com/watch?v=w2qbJB6ie9Y)", keywords:"founder,leadership,spiritual guidance", truncate:"", weight:2.0, description:"Preethaji co-founded O&O and contributes to its spiritual teachings and transformative methodology.<SEP>Preethaji co-founded O&O and contributes to its mission of fostering profound personal and professional integration.", created_at:1779518953, source_id:"chunk-d934a78e12e582c4cd7a16fc71609ccd<SEP>chunk-07d99cca71c6ec1bd01be96cb1ca22ec"}}, {start: {_id:1487}, end: {_id:5533}, properties:{file_path:"unknown_source", keywords:"self-discovery,teachings", truncate:"", weight:1.0, description:"O&O teaches participants to access and live from an enlightened state of consciousness for profound personal transformation.", created_at:1779518952, source_id:"chunk-d934a78e12e582c4cd7a16fc71609ccd"}}, {start: {_id:5533}, end: {_id:730}, properties:{file_path:"unknown_source", keywords:"personal growth,program focus", truncate:"", weight:1.0, description:"O&O facilitates transformative experiences through integrating ancient wisdom and modern high-performance strategies.", created_at:1779518952, source_id:"chunk-d934a78e12e582c4cd7a16fc71609ccd"}}, {start: {_id:1487}, end: {_id:2649}, properties:{file_path:"unknown_source", keywords:"consciousness application,success", truncate:"", weight:1.0, description:"Wealth creators emerge from O&O?s teachings by applying enlightened consciousness to achieve impactful success.", created_at:1779518952, source_id:"chunk-d934a78e12e582c4cd7a16fc71609ccd"}}, {start: {_id:17}, end: {_id:5533}, properties:{file_path:"unknown_source<SEP>YouTube Video: w2qbJB6ie9Y (URL: https://www.youtube.com/watch?v=w2qbJB6ie9Y)", keywords:"founder,leadership", truncate:"", weight:2.0, description:"Krishnaji co-founded O&O and exemplifies humble, heart-centered leadership despite his achievements.<SEP>Krishnaji co-founded O&O and embodies its principles of humility and transformative leadership through his direct, heartfelt approach.", created_at:1779518953, source_id:"chunk-d934a78e12e582c4cd7a16fc71609ccd<SEP>chunk-07d99cca71c6ec1bd01be96cb1ca22ec"}}, {start: {_id:544}, end: {_id:730}, properties:{file_path:"YouTube Video: w2qbJB6ie9Y (URL: https://www.youtube.com/watch?v=w2qbJB6ie9Y)", truncate:"", keywords:"humility,spiritual teachings", weight:1.0, description:"The Man's humble demeanor and achievements are central to the transformative experience described in the video.", created_at:1779519037, source_id:"chunk-c5e7d3c06c118f2330521cd61c1462d6"}}, {start: {_id:5538}, end: {_id:730}, properties:{file_path:"YouTube Video: w2qbJB6ie9Y (URL: https://www.youtube.com/watch?v=w2qbJB6ie9Y)", keywords:"consciousness,self-awareness", truncate:"", weight:1.0, description:"The experience involves transcending the self and awakening fearless consciousness.", created_at:1779519037, source_id:"chunk-c5e7d3c06c118f2330521cd61c1462d6"}}, {start: {_id:544}, end: {_id:348}, properties:{file_path:"YouTube Video: w2qbJB6ie9Y (URL: https://www.youtube.com/watch?v=w2qbJB6ie9Y)", truncate:"", keywords:"personal narrative,subject matter", weight:1.0, description:"The video features The Man's story and his humble, heartfelt persona.", created_at:1779519037, source_id:"chunk-c5e7d3c06c118f2330521cd61c1462d6"}}] AS row
