UNWIND [{start: {_id:742}, end: {_id:5384}, properties:{file_path:"YouTube Video: RGFI6v2Biq0 (URL: https://www.youtube.com/watch?v=RGFI6v2Biq0)<SEP>unknown_source", keywords:"comparison,metaphor", truncate:"", weight:2.0, description:"Awareness is compared to car headlights, both revealing potential dangers and guiding safe navigation through life's challenges.<SEP>Awareness is compared to car headlights, which illuminate the path ahead.", created_at:1779510900, source_id:"chunk-c2f772787ab946a352d0af09f5686d4b<SEP>chunk-edcb79b79435bcba9facfbb3e2e5ae09"}}, {start: {_id:742}, end: {_id:5385}, properties:{file_path:"YouTube Video: RGFI6v2Biq0 (URL: https://www.youtube.com/watch?v=RGFI6v2Biq0)", keywords:"attention,non-engagement", truncate:"", weight:1.0, description:"Awareness involves observing mind content without judgment or resistance, allowing natural transformation through conscious attention.", created_at:1779510881, source_id:"chunk-c2f772787ab946a352d0af09f5686d4b"}}, {start: {_id:2726}, end: {_id:1617}, properties:{file_path:"YouTube Video: RGFI6v2Biq0 (URL: https://www.youtube.com/watch?v=RGFI6v2Biq0)", keywords:"metaphor,representation", truncate:"", weight:1.0, description:"The Hindu temple metaphorically represents the mind's capacity to hold diverse human experiences, from the sacred to the mundane.", created_at:1779510881, source_id:"chunk-c2f772787ab946a352d0af09f5686d4b"}}, {start: {_id:3903}, end: {_id:5387}, properties:{file_path:"unknown_source", keywords:"cooperation,harmony", truncate:"", weight:1.0, description:"Quiet mind achieves through cooperation and harmony.", created_at:1779510900, source_id:"chunk-edcb79b79435bcba9facfbb3e2e5ae09"}}, {start: {_id:5387}, end: {_id:5386}, properties:{file_path:"unknown_source<SEP>YouTube Video: RGFI6v2Biq0 (URL: https://www.youtube.com/watch?v=RGFI6v2Biq0)", keywords:"characteristics,contrast,mind states,opposition", truncate:"", weight:2.0, description:"Quiet mind is associated with cooperation and harmony, while unquiet mind is linked to fear and aggression.<SEP>The quiet mind and unquiet mind are presented as opposing states of consciousness, with the former emphasizing presence and the latter driven by fear and superficiality.", created_at:1779510957, source_id:"chunk-edcb79b79435bcba9facfbb3e2e5ae09<SEP>chunk-222632c14fa6c017ed35de349b2ef6bb"}}, {start: {_id:2726}, end: {_id:2119}, properties:{file_path:"unknown_source", keywords:"representation,symbolism", truncate:"", weight:1.0, description:"The Hindu temple represents the human mind in its entirety.", created_at:1779510900, source_id:"chunk-edcb79b79435bcba9facfbb3e2e5ae09"}}, {start: {_id:742}, end: {_id:534}, properties:{file_path:"YouTube Video: RGFI6v2Biq0 (URL: https://www.youtube.com/watch?v=RGFI6v2Biq0)", keywords:"detachment,observation", truncate:"", weight:1.0, description:"Awareness involves observing emotions without engagement or resistance, allowing them to pass without clinging or becoming monstrous.", created_at:1779510957, source_id:"chunk-222632c14fa6c017ed35de349b2ef6bb"}}, {start: {_id:5389}, end: {_id:5386}, properties:{file_path:"YouTube Video: RGFI6v2Biq0 (URL: https://www.youtube.com/watch?v=RGFI6v2Biq0)", keywords:"desire,superficiality", truncate:"", weight:1.0, description:"The unquiet mind is consumed by self-importance and superficial desires for satisfaction.", created_at:1779510958, source_id:"chunk-222632c14fa6c017ed35de349b2ef6bb"}}, {start: {_id:2648}, end: {_id:5387}, properties:{file_path:"YouTube Video: RGFI6v2Biq0 (URL: https://www.youtube.com/watch?v=RGFI6v2Biq0)", keywords:"achievement,harmony", truncate:"", weight:1.0, description:"The quiet mind achieves through cooperation and harmony, contrasting with the unquiet mind's fear-driven achievements.", created_at:1779510958, source_id:"chunk-222632c14fa6c017ed35de349b2ef6bb"}}, {start: {_id:2604}, end: {_id:5387}, properties:{file_path:"YouTube Video: RGFI6v2Biq0 (URL: https://www.youtube.com/watch?v=RGFI6v2Biq0)", truncate:"", keywords:"awareness,neglect", weight:1.0, description:"Civilization's overvaluation of information and motivation neglects the power of a quiet mind, necessitating its cultivation.", created_at:1779510958, source_id:"chunk-222632c14fa6c017ed35de349b2ef6bb"}}, {start: {_id:5395}, end: {_id:5394}, properties:{file_path:"YouTube Video: leypd9opVSc (URL: https://www.youtube.com/watch?v=leypd9opVSc)", truncate:"", keywords:"mystical aspect,spiritual guidance", weight:1.0, description:"The intuitive process involves opening to the divine drama during conception and pregnancy.", created_at:1779511045, source_id:"chunk-d2e81452016e5b21657383d1ac296a64"}}, {start: {_id:5393}, end: {_id:2232}, properties:{file_path:"YouTube Video: leypd9opVSc (URL: https://www.youtube.com/watch?v=leypd9opVSc)", truncate:"", keywords:"necessity,purpose", weight:1.0, description:"Mother Earth requires a new generation of awakened children to fulfill its needs, as stated in the text.", created_at:1779511045, source_id:"chunk-d2e81452016e5b21657383d1ac296a64"}}, {start: {_id:5393}, end: {_id:5394}, properties:{file_path:"YouTube Video: leypd9opVSc (URL: https://www.youtube.com/watch?v=leypd9opVSc)", truncate:"", keywords:"awareness expansion,creation process", weight:1.0, description:"Birthing an awakened child involves an intuitive process to create expanded awareness.", created_at:1779511045, source_id:"chunk-d2e81452016e5b21657383d1ac296a64"}}, {start: {_id:5393}, end: {_id:5395}, properties:{file_path:"YouTube Video: leypd9opVSc (URL: https://www.youtube.com/watch?v=leypd9opVSc)", truncate:"", keywords:"mystical influence,spiritual potential", weight:1.0, description:"The divine drama influences the development of the child during conception and pregnancy.", created_at:1779511045, source_id:"chunk-d2e81452016e5b21657383d1ac296a64"}}, {start: {_id:5397}, end: {_id:5396}, properties:{file_path:"YouTube Video: leypd9opVSc (URL: https://www.youtube.com/watch?v=leypd9opVSc)", truncate:"", keywords:"content topic,spiritual journey", weight:1.0, description:"The video focuses on the Sacred Experience as a spiritual journey during conception and pregnancy.", created_at:1779511064, source_id:"chunk-255bf350d451faa2df8677aa580dc07b"}}, {start: {_id:1613}, end: {_id:5396}, properties:{file_path:"YouTube Video: leypd9opVSc (URL: https://www.youtube.com/watch?v=leypd9opVSc)", truncate:"", keywords:"includes,meditation techniques", weight:1.0, description:"The video incorporates meditations as tools for parents to connect with divine consciousness.", created_at:1779511064, source_id:"chunk-255bf350d451faa2df8677aa580dc07b"}}, {start: {_id:5398}, end: {_id:5397}, properties:{file_path:"YouTube Video: leypd9opVSc (URL: https://www.youtube.com/watch?v=leypd9opVSc)", keywords:"spiritual journey,subject", truncate:"", weight:1.0, description:"The Sacred Experience centers on the Future Child?s role in the spiritual journey of conception.", created_at:1779511064, source_id:"chunk-255bf350d451faa2df8677aa580dc07b"}}, {start: {_id:5400}, end: {_id:5398}, properties:{file_path:"YouTube Video: leypd9opVSc (URL: https://www.youtube.com/watch?v=leypd9opVSc)", keywords:"outcome,parental bonding", truncate:"", weight:1.0, description:"The Future Child?s presence fosters a Bonding Experience between parents.", created_at:1779511064, source_id:"chunk-255bf350d451faa2df8677aa580dc07b"}}, {start: {_id:5400}, end: {_id:5396}, properties:{file_path:"YouTube Video: leypd9opVSc (URL: https://www.youtube.com/watch?v=leypd9opVSc)", keywords:"family connection,theme", truncate:"", weight:1.0, description:"The video highlights the Bonding Experience as a key outcome for families.", created_at:1779511064, source_id:"chunk-255bf350d451faa2df8677aa580dc07b"}}, {start: {_id:5400}, end: {_id:5401}, properties:{file_path:"YouTube Video: leypd9opVSc (URL: https://www.youtube.com/watch?v=leypd9opVSc)", truncate:"", keywords:"family dynamics,inclusivity", weight:1.0, description:"The Bonding Experience is highlighted as equally relevant to single mothers, emphasizing inclusivity in the process.", created_at:1779511064, source_id:"chunk-255bf350d451faa2df8677aa580dc07b"}}] AS row
