UNWIND [{start: {name:"Beautiful State"}, end: {_id:21}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"philosophical basis,source", truncate:"", weight:1.0, description:"Document outlines the beautiful state as central to spiritual vision.", created_at:1779141171, source_id:"chunk-ad8061bbea71b4b58c920eb95c67cb44"}}, {start: {name:"Beautiful State"}, end: {_id:1020}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional alignment,spiritual connection", weight:1.0, description:"Living in a beautiful state is integral to spiritual vision and achieving desired love.", created_at:1779141171, source_id:"chunk-ad8061bbea71b4b58c920eb95c67cb44"}}, {start: {name:"Beautiful State"}, end: {_id:1009}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"dissolving,emotional impact", truncate:"", weight:1.0, description:"Embracing the beautiful state eliminates staleness and separation.", created_at:1779141216, source_id:"chunk-9126b7168266feeb5c044ddb65ae0392"}}, {start: {name:"Beautiful State"}, end: {_id:599}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"rejection of,relational dynamics", truncate:"", weight:1.0, description:"The beautiful state rejects obsessive fulfillment of another's expectations.", created_at:1779141216, source_id:"chunk-9126b7168266feeb5c044ddb65ae0392"}}, {start: {name:"Beautiful State"}, end: {_id:1025}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"balance with,mutual respect", truncate:"", weight:1.0, description:"It avoids mechanically prioritizing others' needs over one's own.", created_at:1779141216, source_id:"chunk-9126b7168266feeb5c044ddb65ae0392"}}, {start: {name:"Beautiful State"}, end: {_id:146}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"justification,reduction of", truncate:"", weight:1.0, description:"Embracing the beautiful state diminishes the justification for remaining in suffering states of hurt, judgment, or aversion.", created_at:1779141216, source_id:"chunk-9126b7168266feeb5c044ddb65ae0392"}}, {start: {name:"Beautiful State"}, end: {_id:449}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"harmony,positivity", truncate:"", weight:1.0, description:"Being in a beautiful state leads to more harmonious and joyful relationships.", created_at:1779141391, source_id:"chunk-6159dcadf48bbe1bd234217f23bacc7b"}}, {start: {name:"Beautiful State"}, end: {_id:1055}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"attraction,positive influence", truncate:"", weight:1.0, description:"A beautiful state attracts kind and loving people into one?s life.", created_at:1779141391, source_id:"chunk-6159dcadf48bbe1bd234217f23bacc7b"}}, {start: {name:"Beautiful State"}, end: {_id:1056}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"avoidance,conscious decision", truncate:"", weight:1.0, description:"A beautiful state involves not remaining in unhappy or dangerous situations.", created_at:1779141391, source_id:"chunk-6159dcadf48bbe1bd234217f23bacc7b"}}, {start: {name:"Beautiful State"}, end: {_id:9}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cultivation,emotional freedom", truncate:"", weight:1.0, description:"The beautiful state is achieved through cultivating inner stillness to transcend emotional hurt and connect with love.", created_at:1779141431, source_id:"chunk-3324f1848f747970d99d374e6a692e91"}}, {start: {name:"Beautiful State"}, end: {_id:1143}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: 1PlGMOAypCI (URL: https://www.youtube.com/watch?v=1PlGMOAypCI)", keywords:"action,cultivation,natural alignment,state,state of being", truncate:"", weight:3.0, created_at:1779655579, description:"Spiritual right action is performed from a beautiful state.<SEP>Cultivating a beautiful state makes spiritual right action more natural.<SEP>Spiritual right action is performed from a beautiful state.", source_id:"chunk-53db4a4895ca5dc8d4cc1183c39f2b74<SEP>chunk-37c881d41553a8a7658ca326a33a2864<SEP>chunk-8b53cedbcd4de86ef1b08281380f9428"}}, {start: {name:"Beautiful State"}, end: {_id:1175}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"state of being", truncate:"", weight:1.0, description:"From a beautiful state, one naturally considers well-being and avoids sacrificing.", created_at:1779142740, source_id:"chunk-53db4a4895ca5dc8d4cc1183c39f2b74"}}, {start: {name:"Consciousness"}, end: {_id:1219}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"philosophy,prerequisite", truncate:"", weight:1.0, description:"True wealth creation requires elevated consciousness beyond ego-driven pursuits.", created_at:1779143066, source_id:"chunk-7503a6ae65b185937e995c2f50e85b5c"}}, {start: {name:"Four Sacred Secrets"}, end: {_id:1318}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"guidance,wisdom", truncate:"", weight:1.0, description:"He applies the Four Sacred Secrets to achieve organizational success and personal fulfillment.", created_at:1779143699, source_id:"chunk-ce77326926352a7c47bb2a49044d5832"}}, {start: {name:"Four Sacred Secrets"}, end: {_id:1326}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"ancient wisdom,categorization", truncate:"", weight:1.0, description:"The Four Sacred Secrets categorizes Kama as a fundamental human motivation.", created_at:1779143742, source_id:"chunk-cf3bc78e02d58d61212dd4fe3b5c8715"}}, {start: {name:"Dharma"}, end: {_id:1327}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"mindset impact,responsibility performance", weight:1.0, description:"Performing Dharma from a stressed state turns duties into burdens.", created_at:1779143742, source_id:"chunk-cf3bc78e02d58d61212dd4fe3b5c8715"}}, {start: {name:"Four Sacred Secrets"}, end: {_id:1324}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"ancient wisdom,categorization", truncate:"", weight:1.0, description:"The Four Sacred Secrets defines Mukti as the pursuit of spiritual liberation.", created_at:1779143742, source_id:"chunk-cf3bc78e02d58d61212dd4fe3b5c8715"}}, {start: {name:"Four Sacred Secrets"}, end: {_id:14}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"curriculum foundation,educational application", weight:1.0, description:"The Four Sacred Secrets underpins O&O Academy?s curriculum development.", created_at:1779143742, source_id:"chunk-cf3bc78e02d58d61212dd4fe3b5c8715"}}, {start: {name:"Dharma"}, end: {_id:1205}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"destructive pursuit,duty nature,emotional impact,obligation", truncate:"", weight:3.0, description:"In the Nobody State, Dharma is performed as a chore or burden driven by obligation rather than passion.<SEP>Dharma becomes a burden...` -> The name is `Nobody State`. The target is `Dharma`. The keywords are `destructive pursuit, obligation`. The description is a full sentence. This is correct.<SEP>Dharma becomes a burden when approached from the Nobody State, driven by fear and obligation.` - Correct.", created_at:1779187668, source_id:"chunk-2cfb508b00ca21845f924f5069b94f9b<SEP>chunk-be5de8ed1db1e01f9ee5a260fb8d11ce"}}, {start: {name:"Beautiful State"}, end: {_id:1326}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"emotional impact,liberation,motivation,nurturing,positive transformation", truncate:"", weight:3.0, created_at:1779187668, description:"Kama in the Beautiful State fosters nurturing, uplifting, and liberating love.<SEP>Kama can be pursued from a beautiful state, leading to positive outcomes.<SEP>Kama evolves into uplifting love from the Beautiful State.` - Correct.", source_id:"chunk-2cfb508b00ca21845f924f5069b94f9b<SEP>chunk-dc9927460d19d840d6ca22cca3f93322<SEP>chunk-be5de8ed1db1e01f9ee5a260fb8d11ce"}}] AS row
