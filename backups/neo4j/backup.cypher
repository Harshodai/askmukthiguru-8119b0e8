9449752, source_id:"chunk-2bfc54003e79d44fa2a7ce956b569e44"}}, {start: {_id:5294}, end: {_id:371}, properties:{file_path:"YouTube Video: nen-DB_tz4M (URL: https://www.youtube.com/watch?v=nen-DB_tz4M)", truncate:"", keywords:"emotional disconnect,root cause", weight:1.0, description:"Loneliness stems from the inability to connect or feel connected to others.", created_at:1779449752, source_id:"chunk-2bfc54003e79d44fa2a7ce956b569e44"}}, {start: {_id:5298}, end: {_id:5294}, properties:{file_path:"YouTube Video: nen-DB_tz4M (URL: https://www.youtube.com/watch?v=nen-DB_tz4M)", truncate:"", keywords:"disconnection,emotional obstacle", weight:1.0, description:"Conflicting emotions create disconnection and distance from others, worsening the inability to connect.", created_at:1779449752, source_id:"chunk-2bfc54003e79d44fa2a7ce956b569e44"}}, {start: {_id:371}, end: {_id:5296}, properties:{file_path:"YouTube Video: nen-DB_tz4M (URL: https://www.youtube.com/watch?v=nen-DB_tz4M)", truncate:"", keywords:"contributing factor,emotional barrier", weight:1.0, description:"Unresolved mental processes exacerbate loneliness by disconnecting individuals from others.", created_at:1779449753, source_id:"chunk-2bfc54003e79d44fa2a7ce956b569e44"}}, {start: {_id:371}, end: {_id:5300}, properties:{file_path:"YouTube Video: nen-DB_tz4M (URL: https://www.youtube.com/watch?v=nen-DB_tz4M)", keywords:"meditation,self-awareness", truncate:"", weight:2.0, description:"The video addresses loneliness through meditation and self-awareness exercises.", created_at:1779449784, source_id:"chunk-710110c627104c0a94bd8c9545f51f89"}}, {start: {_id:1861}, end: {_id:5300}, properties:{file_path:"YouTube Video: nen-DB_tz4M (URL: https://www.youtube.com/watch?v=nen-DB_tz4M)", truncate:"", keywords:"connection,spiritual practice", weight:2.0, description:"The video suggests holding a sacred intention to foster connection.", created_at:1779449784, source_id:"chunk-710110c627104c0a94bd8c9545f51f89"}}] AS row
