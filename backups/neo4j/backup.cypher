UNWIND [{start: {_id:1216}, end: {_id:122}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"influence,insistence,motivation,participation", truncate:"", weight:2.0, description:"Mike's teenage daughter insisted he attend the four-day course, leading to his reluctant participation.<SEP>Mike's daughter's insistence prompts his participation in the transformative course.`", created_at:1779187442, source_id:"chunk-cd472120781d30f6deb417cdc30ee13c<SEP>chunk-d564739567a16e99326ecc627fbd4051"}}, {start: {_id:1223}, end: {_id:1216}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", truncate:"", keywords:"participation,reluctant participation,self-discovery,self-reflection", weight:4.0, created_at:1779187440, description:"Mike attended the four-day course reluctantly but experienced self-reflection and realization about his addiction.<SEP>Mike reluctantly attends the course at his daughter's insistence, leading to self-awareness.<SEP>Mike attends the course reluctantly at his daughter's insistence, leading to his confrontation with the \"Nobody State.\"`", source_id:"chunk-cd472120781d30f6deb417cdc30ee13c<SEP>chunk-2093a273636983f00fe7dc86ea163faa<SEP>chunk-d564739567a16e99326ecc627fbd4051"}}, {start: {_id:1216}, end: {_id:1205}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", truncate:"", keywords:"consciousness,existential crisis,existential discontent,existential fear,fear,self-perception,self-realization,self-reflection", weight:4.0, description:"Mike's fear of dying as a nobody stems from the Nobody State and leads to self-realization.<SEP>Mike's discontent stems from his experience of the Nobody State and his realization about material success.<SEP>Mike begins to understand his \"focus and drive\" as an addiction during the course.<SEP>Mike experiences the \"Nobody State\" during meditation, fearing a life devoid of significance.`", created_at:1779187441, source_id:"chunk-b8797891f91bec3ca8