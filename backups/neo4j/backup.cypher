UNWIND [{start: {_id:2324}, end: {_id:2326}, properties:{file_path:"unknown_source", keywords:"concept,overcoming", truncate:"", weight:1.0, description:"Dharma is associated with overcoming fears.", created_at:1779168414, source_id:"chunk-716f70c82340a863624fa47098e63ad3"}}, {start: {_id:2332}, end: {_id:2329}, properties:{file_path:"unknown_source", keywords:"factual correction,name change", truncate:"", weight:1.0, description:"Incorrect entity \"Malala Yusuf Sai\" should be replaced with \"Malala Yousafzai\" due to a factual error in the text.", created_at:1779168414, source_id:"chunk-270fcc29517d133cdb2e1b97b5e80e64"}}, {start: {_id:1619}, end: {_id:2322}, properties:{file_path:"unknown_source", keywords:"example,spiritual guidance", truncate:"", weight:1.0, description:"Mukthi Guru provides spiritual guidance through Swami Vivekananda's example.", created_at:1779168414, source_id:"chunk-716f70c82340a863624fa47098e63ad3"}}, {start: {_id:2322}, end: {_id:2325}, properties:{file_path:"unknown_source", keywords:"example,location,spiritual journey", truncate:"", weight:2.0, description:"Swami Vivekananda's encounter with the monkeys occurs in Varanasi, anchoring his story in a specific place.<SEP>Swami Vivekananda's story is set in Varanasi.", created_at:1779168414, source_id:"chunk-716f70c82340a863624fa47098e63ad3<SEP>chunk-379dcbaa1fba64cd1d562fe797bdcf77"}}, {start: {_id:2326}, end: {_id:2330}, properties:{file_path:"unknown_source", keywords:"overcome", truncate:"", weight:1.0, description:"Fear is overcome by facing the monkeys.", created_at:1779168414, source_id:"chunk-716f70c82340a863624fa47098e63ad3"}}, {start: {_id:2323}, end: {_id:1761}, properties:{file_path:"unknown_source", keywords:"concept,source", truncate:"", weight:1.0, description:"Courage is sourced from faith in the divine.", created_at:1779168414, source_id:"chunk-716f70c82340a863624fa47098e63ad3"}}, {start: {_id:2334}, end: {_id:2322}, properties:{file_path:"unknown_source", keywords:"guidance,wisdom", truncate:"", weight:1.0, description:"The sannyasi advises Swami Vivekananda to face the monkeys, guiding him toward courage.", created_at:1779168415, source_id:"chunk-379dcbaa1fba64cd1d562fe797bdcf77"}}, {start: {_id:975}, end: {_id:2322}, properties:{file_path:"unknown_source", keywords:"fear,resilience", truncate:"", weight:1.0, description:"Swami Vivekananda confronts the monkeys, symbolizing overcoming fear through stillness and awareness.", created_at:1779168415, source_id:"chunk-379dcbaa1fba64cd1d562fe797bdcf77"}}, {start: {_id:41}, end: {_id:2322}, properties:{file_path:"unknown_source", keywords:"embodiment,spiritual victory", truncate:"", weight:1.0, description:"Swami Vivekananda's actions exemplify courage and mastery over fear.", created_at:1779168415, source_id:"chunk-379dcbaa1fba64cd1d562fe797bdcf77"}}, {start: {_id:41}, end: {_id:2327}, properties:{file_path:"unknown_source", keywords:"mythological example", truncate:"", weight:1.0, description:"Shri Rama's retreat to the forest is cited", created_at:1779168415, source_id:"chunk-379dcbaa1fba64cd1d562fe797bdcf77"}}, {start: {_id:348}, end: {_id:2336}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=zp2w7DTmOwc)", truncate:"", keywords:"analytical framework,content source", weight:1.0, description:"The YouTube video serves as the source material for conducting error analysis on the text.", created_at:1779168747, source_id:"chunk-3a19e2b6dcc9df696732acc1d63e7a4d"}}, {start: {_id:2336}, end: {_id:2338}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=zp2w7DTmOwc)", truncate:"", keywords:"error categorization,linguistic check", weight:1.0, description:"Error analysis includes identifying homophones or misheard words as part of the error-checking process.", created_at:1779168747, source_id:"chunk-3a19e2b6dcc9df696732acc1d63e7a4d"}}, {start: {_id:2336}, end: {_id:2337}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=zp2w7DTmOwc)", truncate:"", keywords:"methodological approach,procedural step", weight:1.0, description:"Sentence analysis is employed as a procedural step within the broader error analysis framework.", created_at:1779168747, source_id:"chunk-3a19e2b6dcc9df696732acc1d63e7a4d"}}, {start: {_id:2331}, end: {_id:2336}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=zp2w7DTmOwc)", truncate:"", keywords:"frequency check,term consistency", weight:1.0, description:"The term \"dhira\" is analyzed for consistent spelling and usage across multiple sentences during error analysis.", created_at:1779168747, source_id:"chunk-3a19e2b6dcc9df696732acc1d63e7a4d"}}, {start: {_id:1619}, end: {_id:1788}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=zp2w7DTmOwc)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=gMrOMT4mfno)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", keywords:"error correction,platform,service provision,service requirement,task", truncate:"", weight:10.0, created_at:1779259271, description:"Mukthi Guru requires text correction services to address transcription errors in their content.<SEP>Mukthi Guru is the platform for the text correction task.<SEP>Mukthi Guru requires text correction services to fix transcription errors in their content.", source_id:"chunk-271085d12c313edac6a7a133c3463606<SEP>chunk-3facf3692bcb0f8ed274e373920e52f3<SEP>chunk-a348f3e70c609d0d7798352cd61a2781"}}, {start: {_id:2340}, end: {_id:2339}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=zp2w7DTmOwc)", keywords:"conceptual attributes", truncate:"", weight:1.0, description:"Dheera embodies courage and victory, key themes in Mukthi Guru's spiritual context.", created_at:1779168839, source_id:"chunk-271085d12c313edac6a7a133c3463606"}}, {start: {_id:2341}, end: {_id:1788}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=zp2w7DTmOwc)", keywords:"error types,focus areas", truncate:"", weight:1.0, description:"These elements are primary focus areas for correcting transcription errors in Mukthi Guru's content.", created_at:1779168839, source_id:"chunk-271085d12c313edac6a7a133c3463606"}}, {start: {_id:1789}, end: {_id:1788}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=zp2w7DTmOwc)<SEP>YouTube Video: qJxGtSDiayM (URL: https://www.youtube.com/watch?v=qJxGtSDiayM)", truncate:"", keywords:"guidelines,limitations,operational rules,requirements", weight:2.0, description:"Constraints define permissible actions and limitations during the correction process.<SEP>Text Correction operates under specified constraints for corrections.", created_at:1779407777, source_id:"chunk-271085d12c313edac6a7a133c3463606<SEP>chunk-e8122b558719002ee0dce799548c0a97"}}, {start: {_id:2339}, end: {_id:2333}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=zp2w7DTmOwc)", truncate:"", keywords:"correction,homophone resolution", weight:1.0, description:"Dhira is identified as an incorrect transcription requiring correction to dheera.", created_at:1779168840, source_id:"chunk-271085d12c313edac6a7a133c3463606"}}, {start: {_id:2344}, end: {_id:2342}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=zp2w7DTmOwc)", truncate:"", keywords:"conceptual linkage,rhetorical reinforcement", weight:1.0, description:"\"critical\" is used to highlight the necessity of attaining \"dheera\" and the associated transformative struggle.", created_at:1779168908, source_id:"chunk-62e25e090c1f38b8ad8fb3b011d0eb34"}}] AS row
