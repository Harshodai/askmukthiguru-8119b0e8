UNWIND [{start: {_id:3051}, end: {_id:3090}, properties:{file_path:"unknown_source", keywords:"inequality,social norms", truncate:"", weight:1.0, description:"Color-Based Families are criticized as a basis for discriminatory remarks and actions.", created_at:1779188426, source_id:"chunk-982f35660cd8beb5ada701f1b74f7110"}}, {start: {_id:934}, end: {_id:3052}, properties:{file_path:"unknown_source", keywords:"critique,diversity,individuality,societal expectations", truncate:"", weight:2.0, description:"Standardized Body Structure is deemed unrealistic and boring, contrasting with life's diversity.<SEP>Standardized body structures are critiqued as boring and unrealistic compared to natural human diversity.", created_at:1779188520, source_id:"chunk-982f35660cd8beb5ada701f1b74f7110<SEP>chunk-06d9eb4b9e32d7ec0c21f0adab1c6240"}}, {start: {_id:3091}, end: {_id:3046}, properties:{file_path:"unknown_source", keywords:"equality,respect", truncate:"", weight:1.0, description:"Husbands and in-laws must learn to respect darker-skinned women equally to fair-skinned women.", created_at:1779188426, source_id:"chunk-6a12fdf86752a3b47cf3eb0ac92a6887"}}, {start: {_id:3055}, end: {_id:3092}, properties:{file_path:"unknown_source", truncate:"", keywords:"discrimination,rude comments", created_at:1779188426, weight:1.0, description:"Adult colleagues and neighbors", source_id:"chunk-6a12fdf86752a3b47cf3eb0ac92a6887"}}, {start: {_id:3054}, end: {_id:3051}, properties:{file_path:"unknown_source", keywords:"discrimination,insensitive remarks", truncate:"", weight:1.0, description:"Aunts and uncles must stop making insensitive remarks about color-based families.", created_at:1779188426, source_id:"chunk-6a12fdf86752a3b47cf3eb0ac92a6887"}}, {start: {_id:3070}, end: {_id:3096}, properties:{file_path:"unknown_source", keywords:"discrimination,equity", truncate:"", weight:1.0, description:"Stopping rude comments is essential for societal progress toward equity and respect.", created_at:1779188520,