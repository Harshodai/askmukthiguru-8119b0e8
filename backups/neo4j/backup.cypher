ource_id:"chunk-e4c11128c169e1d5ce39555c52bb0d91"}}, {start: {_id:5955}, end: {_id:5953}, properties:{file_path:"YouTube Video: b6nQnYzo_bY (URL: https://www.youtube.com/watch?v=b6nQnYzo_bY)", keywords:"creativity,potential", truncate:"", weight:1.0, description:"Unearthing creativity is linked to discovering hidden potential.", created_at:1779553398, source_id:"chunk-71283d3fd5fc26f39a3118a107aca96c"}}, {start: {_id:5957}, end: {_id:5958}, properties:{file_path:"YouTube Video: b6nQnYzo_bY (URL: https://www.youtube.com/watch?v=b6nQnYzo_bY)", truncate:"", keywords:"breaking free from habits,purpose", weight:1.0, description:"The central purpose involves de-clutching from unconscious thinking habits.", created_at:1779553398, source_id:"chunk-71283d3fd5fc26f39a3118a107aca96c"}}, {start: {_id:5954}, end: {_id:5957}, properties:{file_path:"YouTube Video: b6nQnYzo_bY (URL: https://www.youtube.com/watch?v=b6nQnYzo_bY)", truncate:"", keywords:"awakening,purpose", weight:1.0, description:"The central purpose includes awakening to beautiful states of living.", created_at:1779553398, source_id:"chunk-71283d3fd5fc26f39a3118a107aca96c"}}, {start: {_id:5959}, end: {_id:5953}, properties:{file_path:"YouTube Video: b6nQnYzo_bY (URL: https://www.youtube.com/watch?v=b6nQnYzo_bY)", keywords:"connection,creativity", truncate:"", weight:1.0, description:"Unearthing creativity contributes to moving from isolation to connection.", created_at:1779553398, source_id:"chunk-71283d3fd5fc26f39a3118a107aca96c"}}, {start: {_id:5954}, end: {_id:5959}, properties:{file_path:"YouTube Video: b6nQnYzo_bY (URL: https://www.youtube.com/watch?v=b6nQnYzo_bY)", keywords:"connection,oneness", truncate:"", weight:1.0, description:"Awakening to beautiful states leads to moving from isolation to connection.", created_at:1779553399, source_id:"chunk-71283d3fd5fc26f39a3118a107aca96c"}}, {start: {_id:5958}, end: {_id:5953}, properties:{file_path:"YouTube Video: b6nQnYzo_bY (URL: https://www.youtube.com/watch?v=b6nQnYzo_bY)", keywords:"connection,creativity", truncate:"", weight:1.0, description:"Breaking free from habits helps in unearthing creativity.", created_at:1779553399, source_id:"chunk-71283d3fd5fc26f39a3118a107aca96c"}}, {start: {_id:5967}, end: {_id:3104}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"cosmic symbolism,divine embodiment", weight:1.0, description:"Shiva embodies the cosmic principle, representing the universal order and fundamental forces.", created_at:1779553580, source_id:"chunk-7d91771cf2490944963bfab1edba7973"}}, {start: {_id:5968}, end: {_id:3104}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)<SEP>unknown_source", truncate:"", keywords:"ego mastery,spiritual symbolism,symbolism", weight:2.0, description:"Shiva riding the bull signifies his dominance over ego and resistance, with the bull's presence in temples marking the surrender of ego before enlightenment.<SEP>The bull symbolizes ego, which Shiva subdues to demonstrate mastery over resistance to life's flow.", created_at:1779553627, source_id:"chunk-d84a2ad7d8a1b6191ff06ebd1365b495<SEP>chunk-3e6f8e85a056a83c6e414cc14c74ff99"}}, {start: {_id:5968}, end: {_id:2082}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"human struggle,resistance", truncate:"", weight:1.0, description:"The bull symbolizes human ego and the futile resistance to life's natural flow, which Shiva overcomes through enlightenment.", created_at:1779553607, source_id:"chunk-d84a2ad7d8a1b6191ff06ebd1365b495"}}, {start: {_id:5986}, end: {_id:3104}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"enlightenment,time mastery", weight:1.0, description:"The hourglass symbolizes Shiva's transcendence of temporal constraints, embodying eternal presence and control over time.", created_at:1779553607, source_id:"chunk-d84a2ad7d8a1b6191ff06ebd1365b495"}}, {start: {_id:5987}, end: {_id:3104}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"Vishuddhi,spiritual energy", weight:1.0, description:"The lotus represents Shiva's embodiment of Vishuddhi energy, reflecting harmony with life's flow and absence of resistance.", created_at:1779553607, source_id:"chunk-d84a2ad7d8a1b6191ff06ebd1365b495"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
UNWIND [{start: {_id:1820}, end: {_id:3104}, properties:{file_path:"unknown_source", keywords:"enlightenment,spiritual energy", truncate:"", weight:1.0, description:"Kundalini's flow from Shiva's crown signifies the awakening of divine consciousness in an enlightened being.", created_at:1779553627, source_id:"chunk-3e6f8e85a056a83c6e414cc14c74ff99"}}, {start: {_id:5970}, end: {_id:3104}, properties:{file_path:"unknown_source", keywords:"purification,spiritual symbolism", truncate:"", weight:1.0, description:"Ganga flowing from Shiva's head represents the cleansing and elevation of consciousness in enlightenment.", created_at:1779553627, source_id:"chunk-3e6f8e85a056a83c6e414cc14c74ff99"}}, {start: {_id:5971}, end: {_id:3104}, properties:{file_path:"unknown_source<SEP>YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"confrontation,desire destruction,destruction,liberation", truncate:"", weight:2.0, description:"Shiva burns Manmada to signify the annihilation of obsessive desires and the path to liberation.<SEP>Shiva burns Manmada, symbolizing the destruction of worldly desires.", created_at:1779553634, source_id:"chunk-3e6f8e85a056a83c6e414cc14c74ff99<SEP>chunk-54918f489339662d08104fe4bc09ec58"}}, {start: {_id:5972}, end: {_id:3104}, properties:{file_path:"unknown_source", keywords:"enlightenment,spiritual activation", truncate:"", weight:1.0, description:"The pineal gland's activation in Shiva symbolizes the burning of desires and the rise of enlightened awareness.", created_at:1779553628, source_id:"chunk-3e6f8e85a056a83c6e414cc14c74ff99"}}, {start: {_id:5973}, end: {_id:3104}, properties:{file_path:"unknown_source", keywords:"Kundalini,spiritual energy", truncate:"", weight:1.0, description:"The Brahmarandra is the channel through which Kundalini energy flows, enabling enlightenment.", created_at:1779553628, source_id:"chunk-3e6f8e85a056a83c6e414cc14c74ff99"}}, {start: {_id:5974}, end: {_id:3104}, properties:{file_path:"unknown_source", keywords:"cultural focus,spiritual inquiry", truncate:"", weight:1.0, description:"Shiva's symbolism aligns with ancient civilizations' existential questions about life, death, and transcendence.", created_at:1779553628, source_id:"chunk-3e6f8e85a056a83c6e414cc14c74ff99"}}, {start: {_id:5969}, end: {_id:5972}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"activation,biological link,energy vortex,spiritual activation", weight:2.0, description:"The Agnya Chakra (third-eye chakra) is activated through the pineal gland, a biological organ.<SEP>The Agnya Chakra activates the pineal gland, enabling intense awareness and equanimity through the dissolution of obsessions.", created_at:1779553673, source_id:"chunk-54918f489339662d08104fe4bc09ec58<SEP>chunk-4bd79f66852d1c2f19b39d0fa5b7850d"}}, {start: {_id:5988}, end: {_id:3104}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"confrontation,destruction", truncate:"", weight:1.0, description:"Shiva burns the God of Desire through third-eye activation, symbolizing victory over desire.", created_at:1779553634, source_id:"chunk-54918f489339662d08104fe4bc09ec58"}}, {start: {_id:3115}, end: {_id:3114}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"spiritual state,symbol", truncate:"", weight:1.0, description:"The poisonous cobra around Shiva's neck symbolizes the harmlessness of negative mental states in enlightened consciousness, reflecting mastery over emotions.", created_at:1779553673, source_id:"chunk-4bd79f66852d1c2f19b39d0fa5b7850d"}}, {start: {_id:5973}, end: {_id:1820}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"flow,spiritual energy", truncate:"", weight:1.0, description:"Kundalini energy flows from the Brahmarandra, triggering ecstatic bliss and unity with divine consciousness.", created_at:1779553673, source_id:"chunk-4bd79f66852d1c2f19b39d0fa5b7850d"}}, {start: {_id:5970}, end: {_id:1820}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"spiritual energy,symbolism", weight:1.0, description:"Ganga's flow from Shiva's head symbolizes Kundalini energy and the divine connection between the physical and spiritual realms.", created_at:1779553673, source_id:"chunk-4bd79f66852d1c2f19b39d0fa5b7850d"}}, {start: {_id:784}, end: {_id:1820}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"physical vessel,spiritual containment", weight:1.0, description:"Kundalini energy's ecstatic bliss is contained within the human body, symbolizing the union of spiritual and physical realms.", created_at:1779553673, source_id:"chunk-4bd79f66852d1c2f19b39d0fa5b7850d"}}, {start: {_id:5982}, end: {_id:5993}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"cyclical thinking,philosophical inquiry", weight:1.0, description:"Chinese Civilization explored questions about the cyclical nature of order and disorder in life.", created_at:1779554047, source_id:"chunk-2d73de251326fca4fb5294aa59b11bf8"}}, {start: {_id:5995}, end: {_id:5992}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"duality,symbolic representation", weight:1.0, description:"Yin and Yang conceptually models cyclical transformations through opposing forces containing seeds of each other.", created_at:1779554047, source_id:"chunk-2d73de251326fca4fb5294aa59b11bf8"}}, {start: {_id:5994}, end: {_id:3208}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"cultural identity,historical context", weight:1.0, description:"Ancient Egyptians are part of the Egyptian Civilization, which explored questions about death and the afterlife.", created_at:1779554047, source_id:"chunk-2d73de251326fca4fb5294aa59b11bf8"}}, {start: {_id:5982}, end: {_id:5992}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"duality,symbolism", weight:1.0, description:"Yin and Yang is a symbol developed by the Chinese Civilization to represent opposing forces and their interdependence.", created_at:1779554047, source_id:"chunk-2d73de251326fca4fb5294aa59b11bf8"}}, {start: {_id:5996}, end: {_id:3208}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"cultural practice,religious belief", weight:1.0, description:"Egyptian Civilization implemented burial practices to facilitate afterlife provisions through grave goods and human companions.", created_at:1779554047, source_id:"chunk-2d73de251326fca4fb5294aa59b11bf8"}}, {start: {_id:5994}, end: {_id:5991}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"philosophical inquiry,religious beliefs", weight:1.0, description:"Ancient Egyptians grappled with questions about the afterlife, influencing their burial practices.", created_at:1779554047, source_id:"chunk-2d73de251326fca4fb5294aa59b11bf8"}}, {start: {_id:5982}, end: {_id:5995}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"natural cycles,philosophical framework", weight:1.0, description:"Chinese Civilization analyzed cyclical transformations in societal and natural phenomena as central to their worldview.", created_at:1779554048, source_id:"chunk-2d73de251326fca4fb5294aa59b11bf8"}}, {start: {_id:5974}, end: {_id:1099}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"explored by,revolve around", weight:2.0, description:"Ancient civilizations revolve around fundamental questions, which have historically shaped their culture and laws.<SEP>Questions are explored by ancient civilizations, forming the basis of their cultural and intellectual life.", created_at:1779554061, source_id:"chunk-492e2a7d0bab4e9fd6187e7d33317fb3"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
UNWIND [{start: {_id:3104}, end: {_id:5990}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"enlightenment,mantra", truncate:"", weight:1.0, description:"Shiva is linked to the mantra Shivoham, which symbolizes the state of enlightenment and the potential to be Shiva.", created_at:1779554061, source_id:"chunk-492e2a7d0bab4e9fd6187e7d33317fb3"}}, {start: {_id:3104}, end: {_id:5989}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"celebration,potential", truncate:"", weight:1.0, description:"Shivratri is a celebration that highlights the potential for individuals to become enlightened, like Shiva.", created_at:1779554062, source_id:"chunk-492e2a7d0bab4e9fd6187e7d33317fb3"}}, {start: {_id:5997}, end: {_id:5998}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"core motivation,materialism", weight:1.0, description:"Modern civilization is driven by the pursuit of profit and pleasure maximization.", created_at:1779554065, source_id:"chunk-833c73287ea461916c12ac0516e36f74"}}, {start: {_id:6002}, end: {_id:5983}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"cyclical harmony,philosophical duality", weight:1.0, description:"The yin and yang sign illustrates the interdependence of opposing forces and cyclical transitions between them.", created_at:1779554065, source_id:"chunk-833c73287ea461916c12ac0516e36f74"}}, {start: {_id:5552}, end: {_id:5997}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"dominant force,societal impact", weight:1.0, description:"Greed is pervasive in modern civilization, overshadowing skill development and ethical decision-making.", created_at:1779554065, source_id:"chunk-833c73287ea461916c12ac0516e36f74"}}, {start: {_id:5999}, end: {_id:5998}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"consumerism,cultural reflection", weight:1.0, description:"Billboards symbolize modern civilization's profit-oriented mindset.", created_at:1779554065, source_id:"chunk-833c73287ea461916c12ac0516e36f74"}}, {start: {_id:6000}, end: {_id:5998}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"economic focus,media representation", weight:1.0, description:"Advertisements reinforce the prioritization of financial gain in modern society.", created_at:1779554065, source_id:"chunk-833c73287ea461916c12ac0516e36f74"}}, {start: {_id:2223}, end: {_id:5998}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"contrasting philosophy,holistic focus", weight:1.0, description:"Ancient Indians had a different philosophical focus compared to modern civilization's profit-driven approach.", created_at:1779554065, source_id:"chunk-833c73287ea461916c12ac0516e36f74"}}, {start: {_id:738}, end: {_id:2120}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"impermanence,inquiry", truncate:"", weight:1.0, description:"Sages inquired about the body's impermanence, dismissing it due to its changing nature.", created_at:1779554094, source_id:"chunk-b45f3a725ee597bc7f79c1f42e7fee1d"}}, {start: {_id:2223}, end: {_id:6009}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"cultural identity,philosophical inquiry", weight:1.0, description:"Ancient Indians are part of the Hindu civilization that explored self-identity questions.", created_at:1779554094, source_id:"chunk-b45f3a725ee597bc7f79c1f42e7fee1d"}}, {start: {_id:6017}, end: {_id:6010}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"lack of focus,priority", truncate:"", weight:1.0, description:"ung people and adults prioritize making money over skill development, learning, or correct decisions.", created_at:1779554094, source_id:"chunk-b45f3a725ee597bc7f79c1f42e7fee1d"}}, {start: {_id:2120}, end: {_id:6011}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"philosophical context,self-awareness", weight:1.0, description:"Sages questioned the \"I\" perceiving starlight, exploring self-awareness.", created_at:1779554094, source_id:"chunk-b45f3a725ee597bc7f79c1f42e7fee1d"}}, {start: {_id:6009}, end: {_id:5984}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"cultural heritage,geographical context", weight:1.0, description:"Hindu civilization flourished in the land between the Indus and Saraswati Rivers.", created_at:1779554094, source_id:"chunk-b45f3a725ee597bc7f79c1f42e7fee1d"}}, {start: {_id:738}, end: {_id:6006}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"definition,impermanence", truncate:"", weight:1.0, description:"Sharira refers to the body, which dissolves and changes shape over time.", created_at:1779554094, source_id:"chunk-b45f3a725ee597bc7f79c1f42e7fee1d"}}, {start: {_id:738}, end: {_id:6012}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"change,impermanence", truncate:"", weight:1.0, description:"The body of a child is noted as non-existent in the present, highlighting impermanence.", created_at:1779554095, source_id:"chunk-b45f3a725ee597bc7f79c1f42e7fee1d"}}, {start: {_id:738}, end: {_id:6013}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"decay,transience", weight:1.0, description:"The body of a young person is observed to change and not persist over time.", created_at:1779554095, source_id:"chunk-b45f3a725ee597bc7f79c1f42e7fee1d"}}, {start: {_id:738}, end: {_id:6014}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", truncate:"", keywords:"decay,transience", weight:1.0, description:"The body of a middle-aged person is described as transient and subject to decay.", created_at:1779554095, source_id:"chunk-b45f3a725ee597bc7f79c1f42e7fee1d"}}, {start: {_id:6015}, end: {_id:738}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"decay,impermanence", truncate:"", weight:1.0, description:"The aged body is noted as bound to decay, emphasizing impermanence.", created_at:1779554095, source_id:"chunk-b45f3a725ee597bc7f79c1f42e7fee1d"}}, {start: {_id:6015}, end: {_id:4033}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"mortality,natural process", truncate:"", weight:1.0, description:"The aged body is associated with decay, reflecting mortality and impermanence.", created_at:1779554095, source_id:"chunk-b45f3a725ee597bc7f79c1f42e7fee1d"}}, {start: {_id:4614}, end: {_id:6004}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"containment,experiencing", truncate:"", weight:1.0, description:"The higher states of consciousness are experienced and contained within the unchanging underlying consciousness.", created_at:1779554117, source_id:"chunk-6d556ad8b74e04409555169154f3886c"}}] AS row
