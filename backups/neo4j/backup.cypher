UNWIND [{start: {_id:3928}, end: {_id:3273}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"contrast,focus change,paradigm shift", weight:2.0, description:"Self-help is transitioning from motivation/inspiration to prioritizing authentic spiritual experiences over conventional personal improvement methods.<SEP>Self-help is contrasted with spiritual experience, which emphasizes transcending the self.", created_at:1779246120, source_id:"chunk-caa27124110ab8f48fb861e8a2ed482e<SEP>chunk-ec5154bb4ad96ae0dc3ba90ae132dc81"}}, {start: {_id:3931}, end: {_id:2390}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"cross-cultural relevance,global need,spirituality,universal demand", weight:2.0, description:"Spirituality is identified as a fundamental human need present globally, transcending geographical exceptions like Antarctica and Africa.<SEP>There is an immense need for spirituality worldwide, especially for coping with stress.", created_at:1779246171, source_id:"chunk-caa27124110ab8f48fb861e8a2ed482e<SEP>chunk-99430e4042493d6e8f0a7ec8dfcc1cb3"}}, {start: {_id:3930}, end: {_id:3273}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"barrier-pushing,self-transcendence", weight:1.0, description:"Spiritual experience involves moving beyond individual limitations and challenging personal boundaries through universal truth engagement.", created_at:1779245894, source_id:"chunk-caa27124110ab8f48fb861e8a2ed482e"}}, {start: {_id:3926}, end: {_id:2390}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"coping mechanism,wealth generation", weight:1.0, description:"Spirituality is adopted by Business People to cope with stress and generate wealth.", created_at:1779245963, source_id:"chunk-fc07b00b8be9ff28ca5f1fca3db2c5cb"}}, {start: {_id:3927}, end: {_id:2390}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"spiritual growth,wealth creation", weight:1.0, description:"Business Leaders recognize that spiritual growth is necessary for wealth creation.", created_at:1779245963, source_id:"chunk-fc07b00b8be9ff28ca5f1fca3db2c5cb"}}, {start: {_id:3926}, end: {_id:499}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"coping mechanism,stress relief", weight:1.0, description:"Business People use spirituality as a coping mechanism to manage stress.", created_at:1779245963, source_id:"chunk-fc07b00b8be9ff28ca5f1fca3db2c5cb"}}, {start: {_id:3928}, end: {_id:2390}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"holistic approach,integration,self-help,spirituality", weight:2.0, description:"Spirituality and self-help are now integrated, moving beyond traditional approaches to emphasize spiritual experiences.<SEP>Spirituality is contrasted with self-help, moving beyond motivation to spiritual experience.", created_at:1779246170, source_id:"chunk-726187f271aa2043554d659991d39748<SEP>chunk-99430e4042493d6e8f0a7ec8dfcc1cb3"}}, {start: {_id:3273}, end: {_id:499}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"coping mechanism,necessity", weight:1.0, description:"Spiritual experience is necessary to manage stress and handle life's challenges effectively.", created_at:1779246006, source_id:"chunk-726187f271aa2043554d659991d39748"}}, {start: {_id:3927}, end: {_id:3933}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"strategic planning,wealth creation", weight:1.0, description:"Business leaders are focusing on wealth creation methods to improve their organizations.", created_at:1779246027, source_id:"chunk-203b5a3ea5b85d8a381ff6db8958a7d3"}}, {start: {_id:3935}, end: {_id:477}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"innovation,intellectual enhancement", weight:1.0, description:"Spiritual growth enables the generation of breakthrough ideas.", created_at:1779246027, source_id:"chunk-203b5a3ea5b85d8a381ff6db8958a7d3"}}, {start: {_id:3926}, end: {_id:3933}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"societal relevance,wealth generation", weight:1.0, description:"Business people are integrating spirituality into their approach to wealth generation.", created_at:1779246028, source_id:"chunk-203b5a3ea5b85d8a381ff6db8958a7d3"}}, {start: {_id:2390}, end: {_id:3934}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"societal integration,wealth distribution", weight:1.0, description:"Spirituality is being absorbed into the mainstream, influencing wealth distribution.", created_at:1779246028, source_id:"chunk-203b5a3ea5b85d8a381ff6db8958a7d3"}}, {start: {_id:477}, end: {_id:499}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"coping mechanism,necessity,spiritual expansion,stress management", weight:2.0, description:"Spiritual growth helps manage stress and promotes expansion.<SEP>Spiritual growth is presented as essential for managing stress in modern life.", created_at:1779246121, source_id:"chunk-203b5a3ea5b85d8a381ff6db8958a7d3<SEP>chunk-ec5154bb4ad96ae0dc3ba90ae132dc81"}}, {start: {_id:3929}, end: {_id:1782}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"exclusion,travel limitations", weight:1.0, description:"Speaker deliberately avoided traveling to Antarctica during their spiritual journey.", created_at:1779246120, source_id:"chunk-ec5154bb4ad96ae0dc3ba90ae132dc81"}}, {start: {_id:3932}, end: {_id:1782}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"exclusion,travel limitations", weight:1.0, description:"Speaker excluded Africa from their travels, focusing on other continents for spiritual exploration.", created_at:1779246121, source_id:"chunk-ec5154bb4ad96ae0dc3ba90ae132dc81"}}, {start: {_id:449}, end: {_id:2390}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)<SEP>YouTube Video: KTlY-lHs_Ew (URL: https://www.youtube.com/watch?v=KTlY-lHs_Ew)", keywords:"beauty,harmony,interconnectedness", truncate:"", weight:2.0, description:"Relationships are described as naturally harmonizing with spirituality, not requiring separation.<SEP>Spirituality involves bringing beauty into relationships and enjoying interactions.", created_at:1779398287, source_id:"chunk-ec5154bb4ad96ae0dc3ba90ae132dc81<SEP>chunk-6a5c1cd3abe977e04aa0398546d911a7"}}, {start: {_id:1782}, end: {_id:2390}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)<SEP>YouTube Video: 5YJ6vynFWFc (URL: https://www.youtube.com/watch?v=5YJ6vynFWFc)", truncate:"", keywords:"global relevance,mission,observation,spirituality", weight:3.0, description:"Speaker observes universal demand for spirituality across continents despite travel exclusions.<SEP>Speaker's mission is spirituality, involving awakening people and achieving God realization.<SEP>Speaker's mission is spirituality, which involves awakening and God realization.", created_at:1779520829, source_id:"chunk-ec5154bb4ad96ae0dc3ba90ae132dc81<SEP>chunk-dd506a27566aa3b0948c2e961bb69dbf"}}, {start: {_id:3929}, end: {_id:2390}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"Antarctica,exclusion,global need,spirituality", weight:5.0, description:"Antarctica is a location where the speaker has not traveled, but spirituality is needed globally.<SEP>Antarctica is excluded from the global need for spirituality observed in other continents.<SEP>Spirituality is needed in all continents except Antarctica, as observed by the speaker.", created_at:1779246321, source_id:"chunk-99430e4042493d6e8f0a7ec8dfcc1cb3<SEP>chunk-008bbf59ba9b51b8a40d1545c90b6146"}}, {start: {_id:1301}, end: {_id:3928}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", keywords:"intelligence,self-help", truncate:"", weight:1.0, description:"Self-help is no longer about motivation and inspiration, but about spiritual experience, which is linked to intelligence.", created_at:1779246170, source_id:"chunk-99430e4042493d6e8f0a7ec8dfcc1cb3"}}, {start: {_id:3932}, end: {_id:2390}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", truncate:"", keywords:"Africa,exclusion,global need,spirituality", weight:2.0, description:"Africa is a location where the speaker has not traveled, but spirituality is needed globally.<SEP>Africa is excluded from the global need for spirituality observed in other continents.", created_at:1779246321, source_id:"chunk-99430e4042493d6e8f0a7ec8dfcc1cb3<SEP>chunk-008bbf59ba9b51b8a40d1545c90b6146"}}] AS row
