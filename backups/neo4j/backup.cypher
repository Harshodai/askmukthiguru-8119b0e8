504}, properties:{file_path:"unknown_source", keywords:"purpose,universal well-being", truncate:"", weight:1.0, description:"awakened wealth creators prioritize Lokathalyana, aligning wealth creation with universal well-being.", created_at:1779174260, source_id:"chunk-9d9744dacd10c03b653c5a3fe39dda9e"}}, {start: {_id:2520}, end: {_id:1866}, properties:{file_path:"unknown_source", keywords:"reduction,societal harmony", truncate:"", weight:1.0, description:"collective meditation reduces crime rates through heightened societal harmony.", created_at:1779174260, source_id:"chunk-9d9744dacd10c03b653c5a3fe39dda9e"}}, {start: {_id:2521}, end: {_id:1866}, properties:{file_path:"unknown_source", truncate:"", keywords:"economic prosperity,interconnectedness", weight:1.0, description:"meditation correlates with economic growth via conscious interconnectedness.", created_at:1779174261, source_id:"chunk-9d9744dacd10c03b653c5a3fe39dda9e"}}, {start: {_id:2525}, end: {_id:2526}, properties:{file_path:"unknown_source", keywords:"harmony,unity", truncate:"", weight:1.0, description:"The joyful song and peaceful embrace coexist, symbolizing unity and emotional harmony.", created_at:1779174261, source_id:"chunk-66c9d2b7ebbf4aa02386f608fa1ab6e8"}}, {start: {_id:2528}, end: {_id:2527}, properties:{file_path:"unknown_source", keywords:"symbolism,transcendence", truncate:"", weight:1.0, description:"The ocean of light embodies grace, representing spiritual transcendence and boundless connection.", created_at:1779174261, source_id:"chunk-66c9d2b7ebbf4aa02386f608fa1ab6e8"}}, {start: {_id:2522}, end: {_id:1866}, properties:{file_path:"unknown_source", keywords:"awareness,safety", truncate:"", weight:1.0, description:"meditation increases awareness, reducing car accidents through collective focus.", created_at:1779174261, source_id:"chunk-9d9744dacd10c03b653c5a3fe39dda9e"}}, {start: {_id:2529}, end: {_id:2530}, properties:{file_path:"unknown_source", keywords:"expression,illumination", truncate:"", weight:1.0, description:"Love in the air is expressed through the act of shining light, fostering illumination and collective energy.", created_at:1779174261, source_id:"chunk-66c9d2b7ebbf4aa02386f608fa1ab6e8"}}, {start: {_id:2504}, end: {_id:2643}, properties:{file_path:"unknown_source", keywords:"peace,sustainable economies", truncate:"", weight:1.0, description:"awakened wealth creators build wealth on sustainability and peace, not exploitation.", created_at:1779174261, source_id:"chunk-9d9744dacd10c03b653c5a3fe39dda9e"}}, {start: {_id:2531}, end: {_id:2525}, properties:{file_path:"unknown_source", keywords:"harmony,physical connection", truncate:"", weight:1.0, description:"The joyful song is paired with the act of holding hands, reinforcing emotional and physical unity.", created_at:1779174261, source_id:"chunk-66c9d2b7ebbf4aa02386f608fa1ab6e8"}}, {start: {_id:2532}, end: {_id:2527}, properties:{file_path:"unknown_source", keywords:"movement,transcendence", truncate:"", weight:1.0, description:"The ocean of light is mirrored in the act of dancing, symbolizing a release into collective energy.", created_at:1779174261, source_id:"chunk-66c9d2b7ebbf4aa02386f608fa1ab6e8"}}, {start: {_id:2523}, end: {_id:1866}, properties:{file_path:"unknown_source", keywords:"harmony,health", truncate:"", weight:1.0, description:"meditation lowers hospital admissions by fostering health and harmony.", created_at:1779174261, source_id:"chunk-9d9744dacd10c03b653c5a3fe39dda9e"}}, {start: {_id:2534}, end: {_id:2533}, properties:{file_path:"unknown_source", keywords:"synonymity,thematic emphasis", truncate:"", weight:1.0, description:"\"Unity\" and \"Collective Unity\" are synonymous concepts central to the text's message.", created_at:1779174261, source_id:"chunk-66c9d2b7ebbf4aa02386f608fa1ab6e8"}}, {start: {_id:2536}, end: {_id:2535}, properties:{file_path:"unknown_source", keywords:"founder,spiritual leadership", truncate:"", weight:1.0, description:"?kam was co-founded by Sri S