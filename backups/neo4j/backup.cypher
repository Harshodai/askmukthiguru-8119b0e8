UNWIND [{start: {_id:86}, end: {_id:17}, properties:{file_path:"unknown_source", keywords:"enlightenment,spiritual vision", truncate:"", weight:2.0, description:"Krishnaji experienced visions of the Golden Orb of Light, which became central to his spiritual teachings.<SEP>Krishnaji experienced visions of the Golden Orb of Light, which became central to his spiritual teachings.", created_at:1779183195, source_id:"chunk-50d6ad908c447f2c1930066f85129418"}}, {start: {_id:17}, end: {_id:276}, properties:{file_path:"unknown_source", keywords:"enlightenment,spiritual teachings", truncate:"", weight:2.0, description:"Krishnaji's teachings about Oneness and liberation from self-centeredness are encapsulated in the Sacred Secrets.<SEP>Krishnaji's teachings about Oneness and liberation from self-centeredness are encapsulated in the Sacred Secrets.", created_at:1779183196, source_id:"chunk-50d6ad908c447f2c1930066f85129418"}}, {start: {_id:893}, end: {_id:62}, properties:{file_path:"unknown_source", keywords:"existential crisis,trauma", truncate:"", weight:2.0, description:"Preethaji's experience during the Incident triggered deep existential questioning about suffering and meaning.<SEP>Preethaji's experience during the Incident triggered deep existential questioning about suffering and meaning.", created_at:1779183210, source_id:"chunk-50d6ad908c447f2c1930066f85129418"}}, {start: {_id:893}, end: {_id:61}, properties:{file_path:"unknown_source", keywords:"childhood trauma,resilience", truncate:"", weight:2.0, description:"Lokaa witnessed the Incident and its impact on her family, shaping her understanding of suffering.<SEP>Lokaa witnessed the Incident and its impact on her family, shaping her understanding of suffering.", created_at:1779183210, source_id:"chunk-50d6ad908c447f2c1930066f85129418"}}, {start: {_id:739}, end: {_id:893}, properties:{file_path:"unknown_source", keywords:"disillusionment,trauma", truncate:"", weight:2.0, description:"The Incident caused the family to question their spiritual beliefs and sense of peace.<SEP>The Incident caused the family to question their spiritual beliefs and sense of peace.", created_at:1779183210, source_id:"chunk-50d6ad908c447f2c1930066f85129418"}}, {start: {_id:893}, end: {_id:114}, properties:{file_path:"unknown_source", keywords:"rescue,safety", truncate:"", weight:2.0, description:"The Rescue Team saved Preethaji and her family after the Incident, ending their immediate danger.<SEP>The Rescue Team saved Preethaji and her family after the Incident, ending their immediate danger.", created_at:1779183210, source_id:"chunk-50d6ad908c447f2c1930066f85129418"}}, {start: {_id:2681}, end: {_id:864}, properties:{file_path:"unknown_source", keywords:"foundation,impact", truncate:"", weight:1.0, description:"The Academy founded charities that positively impacted villagers and students.`", created_at:1779183192, source_id:"chunk-1ba7f5be1d21e67ddd5d6d9988215271"}}, {start: {_id:2682}, end: {_id:864}, properties:{file_path:"unknown_source", keywords:"guidance,ownership", truncate:"", weight:1.0, description:"The Academy established and guides global businesses as visionaries.`", created_at:1779183193, source_id:"chunk-1ba7f5be1d21e67ddd5d6d9988215271"}}, {start: {_id:118}, end: {_id:864}, properties:{file_path:"unknown_source", keywords:"origin,teaching", truncate:"", weight:1.0, description:"The First Sacred Secret is derived from The Academy?s experiences and taught to others.`", created_at:1779183193, source_id:"chunk-1ba7f5be1d21e67ddd5d6d9988215271"}}, {start: {_id:2773}, end: {_id:50}, properties:{file_path:"unknown_source", truncate:"", keywords:"meaningful alignment,spiritual resonance", weight:1.0, description:"Synchronicities manifest as the universe aligns with one's heartfelt intentions and longing for support.", created_at:1779183235, source_id:"chunk-fee40675765ad977a79817e44542ea72"}}, {start: {_id:156}, end: {_id:2774}, properties:{file_path:"unknown_source", truncate:"", keywords:"analogy,documentary subject,natural challenge", weight:2.0, description:"The documentary features Machli?s territorial loss, paralleling human struggles with adversity.<SEP>Tiger Queen documents Machli?s challenges, used to illustrate universal problem responses.", created_at:1779183622, source_id:"chunk-ddc2a8c2bf46af1d243c4bae41044efd<SEP>chunk-98ebbba09ead01df2486b7e4f58bcc9b"}}, {start: {_id:2784}, end: {_id:176}, properties:{file_path:"unknown_source", keywords:"aspects of life,philosophy", truncate:"", weight:2.0, description:"The text defines spiritual vision as the two aspects of life: doing and being, contrasting external actions with internal experience.` This looks like a valid, missed relationship.<SEP>The text defines spiritual vision as the two aspects of life: doing and being, contrasting external actions with internal experience.`", created_at:1779183318, source_id:"chunk-ddc2a8c2bf46af1d243c4bae41044efd"}}, {start: {_id:2775}, end: {_id:188}, properties:{file_path:"unknown_source", keywords:"authorship,literary contribution", truncate:"", weight:1.0, description:"Jennifer Read Hawthorne coauthored the book, establishing her expertise in inspirational content.", created_at:1779183318, source_id:"chunk-7d4c8c26b3558bb963e2145eec96c28f"}}, {start: {_id:2777}, end: {_id:2785}, properties:{file_path:"unknown_source", truncate:"", keywords:"conceptual framework,self-improvement", weight:1.0, description:"Holding a spiritual vision enables individuals to reshape their mental and emotional states.", created_at:1779183318, source_id:"chunk-7d4c8c26b3558bb963e2145eec96c28f"}}, {start: {_id:2776}, end: {_id:188}, properties:{file_path:"unknown_source", keywords:"creation,spiritual initiative", truncate:"", weight:1.0, description:"Jennifer Read Hawthorne founded the center to support spiritual seekers.", created_at:1779183319, source_id:"chunk-7d4c8c26b3558bb963e2145eec96c28f"}}, {start: {_id:2778}, end: {_id:2779}, properties:{file_path:"unknown_source", keywords:"consciousness shift,implementation", truncate:"", weight:1.0, description:"The sacred secret advocates increasing time spent in the beautiful state for personal growth.", created_at:1779183319, source_id:"chunk-7d4c8c26b3558bb963e2145eec96c28f"}}, {start: {_id:2780}, end: {_id:2781}, properties:{file_path:"unknown_source", keywords:"coexistence,non-interference", truncate:"", weight:1.0, description:"The author?s spiritual experiences did not disrupt their playful and joyful demeanor.", created_at:1779183319, source_id:"chunk-7d4c8c26b3558bb963e2145eec96c28f"}}, {start: {_id:2776}, end: {_id:2647}, properties:{file_path:"unknown_source", keywords:"community support,purpose", truncate:"", weight:1.0, description:"The center serves as a hub for individuals seeking spiritual growth and guidance.", created_at:1779183319, source_id:"chunk-7d4c8c26b3558bb963e2145eec96c28f"}}, {start: {_id:188}, end: {_id:2780}, properties:{file_path:"unknown_source", truncate:"", keywords:"childhood spirituality,experiential history", weight:1.0, description:"The author experienced spontaneous elevated consciousness states since age eleven.", created_at:1779183319, source_id:"chunk-7d4c8c26b3558bb963e2145eec96c28f"}}, {start: {_id:2786}, end: {_id:176}, properties:{file_path:"unknown_source", truncate:"", keywords:"emotional regulation,neurological impact", weight:1.0, description:"Holding a spiritual vision increases blood flow to brain regions linked to emotional regulation and focus.", created_at:1779183417, source_id:"chunk-08a8bfd8ab34e14f6fb9afe4224d7966"}}] AS row
