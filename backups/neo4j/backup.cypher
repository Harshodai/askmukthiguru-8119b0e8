UNWIND [{start: {_id:7656}, end: {_id:7580}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", keywords:"error absence,terminology", truncate:"", weight:1.0, description:"The text avoids domain-specific terms like \"Vinayaka\" not present in the original content.", created_at:1779670815, source_id:"chunk-e67cebe345867bb957f951bf07725fa1"}}, {start: {_id:1617}, end: {_id:2364}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", keywords:"cognitive process,composition,daily average", truncate:"", weight:2.0, description:"The mind is composed of thoughts generated through cognitive processes.<SEP>Thoughts are described as constituting the mind's content, with a quantified daily average.", created_at:1779671847, source_id:"chunk-53e525d93caa11247db9588a7b9a8e7a<SEP>chunk-331ce489e777434104c9abde748a4203"}}, {start: {_id:305}, end: {_id:176}, properties:{file_path:"unknown_source", keywords:"emotional regulation,enhancement", truncate:"", weight:1.0, description:"Spiritual vision improves connection in the anterior cingulate, fostering better relationships.", created_at:1779670850, source_id:"chunk-53e525d93caa11247db9588a7b9a8e7a"}}, {start: {_id:2001}, end: {_id:2364}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", keywords:"cognitive function,impact,neural activity,neurological impact", truncate:"", weight:2.0, description:"Negative thoughts affect blood flow to the prefrontal cortex, influencing intelligence.<SEP>Negative thoughts reduce blood flow to the prefrontal cortex, affecting intelligence.", created_at:1779672345, source_id:"chunk-53e525d93caa11247db9588a7b9a8e7a<SEP>chunk-a806b7026395d82c6e1fe100191449c6"}}, {start: {_id:307}, end: {_id:2001}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", keywords:"causal,cognitive enhancement,cognitive function,intelligence,neurological effect,neuroscience,physiological", truncate:"", weight:4.0, description:"Increased blood flow to the prefrontal cortex enhances intelligence and decision-making.<SEP>Increased blood flow to the prefrontal cortex enhances intelligence.<SEP>Increased blood flow to the prefrontal cortex enhances intelligence.<SEP>Increased blood flow to the prefrontal cortex causes enhanced intelligence.", created_at:1779672444, source_id:"chunk-53e525d93caa11247db9588a7b9a8e7a<SEP>chunk-fb4ec1b021168c6010bcec1085967625<SEP>chunk-4e775b554bb52f0e7b422520123fe5a4<SEP>chunk-9174f4aac6278b492855cabdc7a615b1"}}, {start: {_id:496}, end: {_id:2365}, properties:{file_path:"unknown_source", keywords:"psychological impact,stress", truncate:"", weight:1.0, description:"Negative thoughts contribute to anxiety and stress, affecting mental and physical states.", created_at:1779670852, source_id:"chunk-53e525d93caa11247db9588a7b9a8e7a"}}, {start: {_id:7627}, end: {_id:7666}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", truncate:"", keywords:"death research,scientific methods", weight:1.0, description:"Modern science uses genetic engineering to address mortality.", created_at:1779671068, source_id:"chunk-8afdbda86ff5c184cd2f7d6fbf294ca1"}}, {start: {_id:7661}, end: {_id:287}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", keywords:"metaphor,philosophy", truncate:"", weight:1.0, description:"Life is equated with eternity in spiritual teachings.", created_at:1779671068, source_id:"chunk-8afdbda86ff5c184cd2f7d6fbf294ca1"}}, {start: {_id:2023}, end: {_id:17}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", keywords:"philosophy,spirituality", truncate:"", weight:1.0, description:"Krishnaji discusses death as a philosophical and spiritual challenge.", created_at:1779671068, source_id:"chunk-8afdbda86ff5c184cd2f7d6fbf294ca1"}}, {start: {_id:7666}, end: {_id:7628}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", truncate:"", keywords:"biological methods,death research", weight:1.0, description:"Modern science employs stem cell research to conquer death.", created_at:1779671068, source_id:"chunk-8afdbda86ff5c184cd2f7d6fbf294ca1"}}, {start: {_id:7665}, end: {_id:2023}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", truncate:"", keywords:"historical research,metallurgy", weight:1.0, description:"Ancient sciences researched death through metallurgy and health practices.", created_at:1779671068, source_id:"chunk-8afdbda86ff5c184cd2f7d6fbf294ca1"}}, {start: {_id:2391}, end: {_id:17}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", keywords:"spirituality,transcendence", truncate:"", weight:1.0, description:"Krishnaji presents enlightenment as the solution to fear of death.", created_at:1779671068, source_id:"chunk-8afdbda86ff5c184cd2f7d6fbf294ca1"}}, {start: {_id:2023}, end: {_id:7660}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", truncate:"", keywords:"human experience,psychological analysis", weight:1.0, description:"Death's fear is analyzed as a common human concern.", created_at:1779671068, source_id:"chunk-8afdbda86ff5c184cd2f7d6fbf294ca1"}}, {start: {_id:7663}, end: {_id:2023}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", keywords:"metaphor,philosophy", truncate:"", weight:1.0, description:"Death is metaphorically described as a comma, not a full stop.", created_at:1779671069, source_id:"chunk-8afdbda86ff5c184cd2f7d6fbf294ca1"}}, {start: {_id:2023}, end: {_id:449}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", truncate:"", keywords:"emotional impact,metaphorical association", weight:1.0, description:"The breaking of relationships is equated to experiencing death through loss of identity and securities.", created_at:1779671552, source_id:"chunk-4d4c85ceafd744808b1dcd571678ad02"}}, {start: {_id:7629}, end: {_id:2391}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", truncate:"", keywords:"conceptual framework,expanded scope", weight:1.0, description:"While enlightenment is traditionally associated with the classical seeker's questions, it is expanded to include anyone perceptive and disturbed by life.", created_at:1779671552, source_id:"chunk-4d4c85ceafd744808b1dcd571678ad02"}}, {start: {_id:2023}, end: {_id:7102}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", truncate:"", keywords:"metaphorical association,social death", weight:1.0, description:"Shame is linked to the \"death of respectability,\" illustrating death's metaphorical applications.", created_at:1779671552, source_id:"chunk-4d4c85ceafd744808b1dcd571678ad02"}}, {start: {_id:2391}, end: {_id:1638}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", truncate:"", keywords:"content topic,philosophical concept", weight:1.0, description:"The YouTube Video: Unknown discusses the concept of enlightenment and its accessibility to certain individuals.", created_at:1779671598, source_id:"chunk-0ede4404be661e946fda64c00777a009"}}, {start: {_id:1638}, end: {_id:7670}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", truncate:"", keywords:"content analysis,text pattern", weight:1.0, description:"The video contains repetitive textual content consisting of the phrase \"one can say can be\" repeated multiple times, forming a distinct textual pattern.", created_at:1779671677, source_id:"chunk-5fd31e5e068c23a80066f68aeee80366"}}, {start: {_id:348}, end: {_id:3963}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", truncate:"", keywords:"reference,source", weight:1.0, description:"The YouTube Video URL serves as the direct source and reference link for accessing the video content mentioned in the input.", created_at:1779671706, source_id:"chunk-b85eafbadd25f0acc5e9342bef6b6fb6"}}] AS row
