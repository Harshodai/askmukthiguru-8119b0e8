UNWIND [{start: {_id:6959}, end: {_id:6958}, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", truncate:"", keywords:"consumption timing,emotional state", weight:1.0, description:"The emotional state of the chef (happiness or unhappiness) influences the third stage of food, which is when and what to eat.", created_at:1779652311, source_id:"chunk-01a258778ec29d7cae94bc0be28d0cb3"}}, {start: {_id:6955}, end: {_id:6956}, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", keywords:"meal scheduling,time", truncate:"", weight:1.0, description:"The sun's position is related to the recommended 14-hour gap between meals.", created_at:1779652311, source_id:"chunk-01a258778ec29d7cae94bc0be28d0cb3"}}, {start: {_id:6957}, end: {_id:6958}, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", truncate:"", keywords:"food suitability,physical response", weight:1.0, description:"The third stage of food is evaluated based on the body's feelings after eating to determine if the food is right.", created_at:1779652311, source_id:"chunk-01a258778ec29d7cae94bc0be28d0cb3"}}, {start: {_id:742}, end: {_id:6957}, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", keywords:"decision-making,self-awareness", truncate:"", weight:1.0, description:"The body's feelings after eating should be guided by awareness rather than the tongue.", created_at:1779652311, source_id:"chunk-01a258778ec29d7cae94bc0be28d0cb3"}}, {start: {_id:742}, end: {_id:6956}, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", keywords:"decision-making,timing", truncate:"", weight:1.0, description:"Awareness is used to determine the best time to eat based on the sun's position.", created_at:1779652311, source_id:"chunk-01a258778ec29d7cae94bc0be28d0cb3"}}, {start: {_id:6955}, 