UNWIND [{start: {_id:6761}, end: {_id:5438}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UJM00IqGKtc)", keywords:"conceptual error,critique", truncate:"", weight:1.0, description:"The \"idea of leadership\" is challenged for oversimplifying leadership as merely position or authority.", created_at:1779647999, source_id:"chunk-550dc3fe2d86679425efdc1841d6bee3"}}, {start: {_id:6762}, end: {_id:6761}, properties:{file_path:"unknown_source", keywords:"conceptual error,flawed premise", truncate:"", weight:1.0, description:"The idea of leadership is deemed flawed due to its reductionist view of leadership as position or authority.", created_at:1779648002, source_id:"chunk-330c229b9775dad36da206ebfc157ab5"}}, {start: {_id:123}, end: {_id:3326}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"capitalization,terminology", truncate:"", weight:1.0, description:"The term \"Nation\" is corrected to lowercase \"nation\" and \"Humanity\" is corrected to lowercase \"humanity\" to reflect their general, non-specific nature.", created_at:1779648050, source_id:"chunk-89ab86758e55eda4e32bf5581a61d209"}}, {start: {_id:6763}, end: {_id:6764}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"correction,terminology", truncate:"", weight:1.0, description:"The original term \"broken glasses\" is corrected to \"glass\" to reflect a single mirror, indicating a change in terminology.", created_at:1779648050, source_id:"chunk-89ab86758e55eda4e32bf5581a61d209"}}, {start: {_id:6772}, end: {_id:6775}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"consequence,unhealthiness", truncate:"", weight:1.0, description:"Disharmony is explicitly equated to unhealthiness in the text.", created_at:1779648084, source_id:"chunk-09bf0a07734e74605b4d135353c1c8b6"}}, {start: {_id:6771}, end: {_id:2551}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"balance,state of unity", truncate:"", weight:1.0, description:"The state of oneness leads to harmony in the body and family.", created_at:1779648084, source_id:"chunk-09bf0a07734e74605b4d135353c1c8b6"}}, {start: {_id:1777}, end: {_id:6771}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"balance,family dynamics", truncate:"", weight:1.0, description:"Harmony is present in the family when in the state of oneness.", created_at:1779648084, source_id:"chunk-09bf0a07734e74605b4d135353c1c8b6"}}, {start: {_id:6774}, end: {_id:2551}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"interrelation,unity", truncate:"", weight:1.0, description:"The state of oneness fosters connection within the family.", created_at:1779648084, source_id:"chunk-09bf0a07734e74605b4d135353c1c8b6"}}, {start: {_id:6771}, end: {_id:6775}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"contradiction,health impact", weight:1.0, description:"Harmony is paradoxically stated to lead to health issues in the text.", created_at:1779648085, source_id:"chunk-09bf0a07734e74605b4d135353c1c8b6"}}, {start: {_id:6774}, end: {_id:1777}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"interrelation,unity", truncate:"", weight:1.0, description:"Connection exists within the family as a result of the state of oneness.", created_at:1779648085, source_id:"chunk-09bf0a07734e74605b4d135353c1c8b6"}}, {start: {_id:6773}, end: {_id:6771}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"communication,interaction", truncate:"", weight:1.0, description:"Harmony involves communication between individuals as described in the text.", created_at:1779648085, source_id:"chunk-09bf0a07734e74605b4d135353c1c8b6"}}, {start: {_id:6766}, end: {_id:6767}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"cause and effect,emotional response", weight:1.0, description:"Disintegration leads to increased stress.", created_at:1779648143, source_id:"chunk-b4ecf7e4c6ac98b4463f375b4140f36f"}}, {start: {_id:6707}, end: {_id:6769}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"achievement,transformation", truncate:"", weight:1.0, description:"Integration results in the state of Oneness.", created_at:1779648143, source_id:"chunk-b4ecf7e4c6ac98b4463f375b4140f36f"}}, {start: {_id:1799}, end: {_id:32}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"motivation,objective", truncate:"", weight:1.0, description:"Human beings possess a purpose to act.", created_at:1779648143, source_id:"chunk-b4ecf7e4c6ac98b4463f375b4140f36f"}}, {start: {_id:511}, end: {_id:6766}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"cause and effect,emotional response", created_at:1779648143, weight:1.0, description:"Disintegration results in anger.", source_id:"chunk-b4ecf7e4c6ac98b4463f375b4140f36f"}}, {start: {_id:6770}, end: {_id:32}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"aim,goal", weight:1.0, description:"The purpose aims", created_at:1779648143, source_id:"chunk-b4ecf7e4c6ac98b4463f375b4140f36f"}}, {start: {_id:6766}, end: {_id:6765}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"cause and effect,emotional response", created_at:1779648144, weight:1.0, description:"Disintegration causes frustration.", source_id:"chunk-b4ecf7e4c6ac98b4463f375b4140f36f"}}, {start: {_id:6766}, end: {_id:6768}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"cause and effect,emotional response", weight:1.0, description:"Disintegration leads to feeling lost.", created_at:1779648144, source_id:"chunk-b4ecf7e4c6ac98b4463f375b4140f36f"}}, {start: {_id:1619}, end: {_id:6740}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"platform,source", weight:1.0, description:"The YouTube video is the source of the text corrected for the 'Mukthi Guru' spiritual platform.", created_at:1779648169, source_id:"chunk-829692316cdc441972a3bef1cc6809ef"}}, {start: {_id:6783}, end: {_id:6784}, properties:{file_path:"YouTube Video: K-AFDVOkIoE (URL: https://www.youtube.com/watch?v=K-AFDVOkIoE)", truncate:"", keywords:"historical significance,photography", weight:1.0, description:"Apollo Eight astronauts captured the Earthrise photograph during their lunar mission, documenting Earth's fragility.", created_at:1779648323, source_id:"chunk-393e1029671c8cd325c8aaceacba56f1"}}] AS row
