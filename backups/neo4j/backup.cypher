UNWIND [{start: {_id:17}, end: {_id:61}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"charitable work,interconnectedness,parent-child,shared experience,spiritual upbringing,unity", truncate:"", weight:4.0, description:"Krishnaji is Lokaa's father and participates in her excitement during the retreat.<SEP>Krishnaji feels unity with Lokaa, reflecting a broader sense of universal interconnectedness.<SEP>Lokaa is the daughter of Krishnaji and involved in charitable foundations.<SEP>Krishnaji is the father of Lokaa, who grows up in a spiritually enriched household.` - This is correct.", created_at:1779187968, source_id:"chunk-2d7f2293587016371499185adff2fbdb<SEP>chunk-95d009c63a3449c63c28d254570391b6<SEP>chunk-8a3ef14b4ae6173889d682a026ec55c0<SEP>chunk-50804a0cd2fabf8122814121f088fb8d"}}, {start: {_id:67}, end: {_id:71}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"sinking risk,urgency", truncate:"", weight:1.0, description:"The Jet Ski's imminent sinking created urgency for the group to seek rescue.", created_at:1779135495, source_id:"chunk-0ef124c94bd0c01cb115a99182209cb1"}}, {start: {_id:68}, end: {_id:62}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"distress,fear", truncate:"", weight:1.0, description:"Preethaji panicked and inhaled water while underwater, with Kanna witnessing her struggle.", created_at:1779135495, source_id:"chunk-0ef124c94bd0c01cb115a99182209cb1"}}, {start: {_id:68}, end: {_id:61}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"rescue,survival", truncate:"", weight:1.0, description:"Lokaa recovered faster than Preethaji, aiding in the group's stabilization.", created_at:1779135495, source_id:"chunk-0ef124c94bd0c01cb115a99182209cb1"}}, {start: {_id:68}, end: {_id:70}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"anger,safety negligence", truncate:"", weight:1.0, description:"Kanna blamed the marina's inadequate safety instructions for the accident.", created_at:1779135495, source_id:"chunk-0ef124c94bd0c01cb115a99182209cb1"}}, {start: {_id:72}, end: {_id:68}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"distress,exposure", truncate:"", weight:1.0, description:"Kanna experienced icy water exposure, contributing to physical distress and urgency.", created_at:1779135495, source_id:"chunk-0ef124c94bd0c01cb115a99182209cb1"}}, {start: {_id:68}, end: {_id:69}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"possession,problem", truncate:"", weight:1.0, description:"Kanna observed the group's soaked phones, highlighting their inability to call for help.", created_at:1779135495, source_id:"chunk-0ef124c94bd0c01cb115a99182209cb1"}}, {start: {_id:68}, end: {_id:73}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"reliance,safety", truncate:"", weight:1.0, description:"Kanna noted the group's reliance on life jackets for survival during the incident.", created_at:1779135495, source_id:"chunk-0ef124c94bd0c01cb115a99182209cb1"}}, {start: {_id:67}, end: {_id:68}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"frustration,rescue dependency", truncate:"", weight:1.0, description:"Kanna struggled to right the Jet Ski and relied on external rescue due to its condition.", created_at:1779135495, source_id:"chunk-0ef124c94bd0c01cb115a99182209cb1"}}, {start: {_id:74}, end: {_id:75}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"curriculum development,education", truncate:"", weight:1.0, description:"Sri Bhagavan established the school and designed its curriculum.", created_at:1779135511, source_id:"chunk-c7663462a3304e2d98120c719432966f"}}, {start: {_id:76}, end: {_id:75}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"mystic experience,spiritual inspiration", weight:1.0, description:"The golden orb vision inspired Sri Bhagavan's spiritual teachings and practices.", created_at:1779135511, source_id:"chunk-c7663462a3304e2d98120c719432966f"}}, {start: {_id:78}, end: {_id:74}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"educational focus,teaching method", truncate:"", weight:1.0, description:"The school teaches joyful relationships as part of its educational approach.", created_at:1779135511, source_id:"chunk-c7663462a3304e2d98120c719432966f"}}, {start: {_id:80}, end: {_id:75}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"mission,spiritual goal", truncate:"", weight:1.0, description:"Sri Bhagavan's teachings aim to achieve the liberation of humankind.", created_at:1779135511, source_id:"chunk-c7663462a3304e2d98120c719432966f"}}, {start: {_id:79}, end: {_id:75}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"foundational event,spiritual experience", weight:1.0, description:"The mystic vision of the golden orb was a foundational event in Sri Bhagavan's spiritual journey.", created_at:1779135512, source_id:"chunk-c7663462a3304e2d98120c719432966f"}}, {start: {_id:82}, end: {_id:74}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"education,founder", truncate:"", weight:1.0, description:"Father established the school to teach unconventional educational methods.", created_at:1779135545, source_id:"chunk-e5fa2d640a5c60cb68e25b39b952c1d0"}}, {start: {_id:87}, end: {_id:91}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"instructional failure,negligence", truncate:"", weight:1.0, description:"The instructor failed to teach how to right the ski, causing frustration and anger in the narrator.", created_at:1779135545, source_id:"chunk-e5fa2d640a5c60cb68e25b39b952c1d0"}}, {start: {_id:83}, end: {_id:81}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"shared consciousness,vision transfer", truncate:"", weight:1.0, description:"The narrator transferred states of consciousness to friends, leading them to perceive the golden orb vision.", created_at:1779135545, source_id:"chunk-e5fa2d640a5c60cb68e25b39b952c1d0"}}, {start: {_id:89}, end: {_id:81}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional response,emotional state,frustration,self-directed", truncate:"", weight:2.0, description:"The narrator's anger stems from the instructor's failure to teach essential skills, leading to<SEP>The narrator's anger is directed inward, leading to self-realization about their role in their suffering.", created_at:1779135573, source_id:"chunk-e5fa2d640a5c60cb68e25b39b952c1d0<SEP>chunk-03f4910a466e54c3db3456e161f19c10"}}, {start: {_id:88}, end: {_id:74}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"curriculum,education", truncate:"", weight:1.0, description:"The", created_at:1779135545, source_id:"chunk-e5fa2d640a5c60cb68e25b39b952c1d0"}}, {start: {_id:81}, end: {_id:62}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"safety,urging", truncate:"", weight:1.0, description:"Preethaji urged the narrator to wear life jackets, which the narrator initially dismissed, highlighting a moment of negligence.", created_at:1779135573, source_id:"chunk-03f4910a466e54c3db3456e161f19c10"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
