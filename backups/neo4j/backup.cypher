UNWIND [{_id:6485, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"person", truncate:"", description:"Followers are individuals who regularly manifest synchronicities and experience their impact in daily life and on a larger scale.<SEP>Followers are individuals who regularly manifest synchronicities and experience their impact in daily life and on a larger scale.<SEP>Followers are individuals who regularly manifest synchronicities and experience their impact in daily life and on a larger scale.", created_at:1779562063, source_id:"chunk-1f2ebd75b5a73d8a2845b5a7f6f03a0e", entity_id:"Followers"}}, {_id:6486, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"Inner struggle refers to personal conflicts or challenges that synchronicities help alleviate, leading to peace.<SEP>Inner struggle refers to personal conflicts or challenges that synchronicities help alleviate, leading to peace.<SEP>Inner struggle refers to personal conflicts or challenges that synchronicities help alleviate, leading to peace.", created_at:1779562063, source_id:"chunk-1acfe53455f3d50d7655cd19bae06dae<SEP>chunk-1f2ebd75b5a73d8a2845b5a7f6f03a0e", entity_id:"Inner Struggle"}}, {_id:6489, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"Daily Routines describe repetitive behaviors (e.g., breakfast, commute) that may lack purpose, creating external order amid internal chaos.", created_at:1779562063, source_id:"chunk-a9f75e7b1831f124898c085ae0393e6e", entity_id:"Daily Routines"}}, {_id:6490, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"Lack of Purpose refers to the absence of a clear objective or meaning in life, leading to repetitive routines and internal chaos.", created_at:1779562063, source_id:"chunk-a9f75e7b1831f124898c085ae0393e6e", entity_id:"Lack of Purpose"}}, {_id:6494, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"person", truncate:"", description:"A successful professional who achieved a high managerial position by age 32, used as an example of crisis in purpose affecting even seemingly successful individuals.", created_at:1779562099, source_id:"chunk-795d6a47694e346b9ff7bde9c51e23ec", entity_id:"Young Manager"}}, {_id:6495, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"Metaphorical representation of self-imposed restrictions or societal pressures causing internal conflict.", created_at:1779562099, source_id:"chunk-795d6a47694e346b9ff7bde9c51e23ec", entity_id:"Y Equals Chains"}}, {_id:6497, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"A psychological state characterized by questioning life's meaning, goals, and continued engagement in responsibilities.", created_at:1779562100, source_id:"chunk-795d6a47694e346b9ff7bde9c51e23ec", entity_id:"Crisis in Purpose"}}, {_id:6498, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"Intense desire to abandon responsibilities, relationships, or life itself due to overwhelming disillusionment.", created_at:1779562100, source_id:"chunk-795d6a47694e346b9ff7bde9c51e23ec", entity_id:"Urge to Quit"}}, {_id:6499, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"Emotional hurts and disappointments accumulated over time, leading to reactive behavior and disconnection from others.", created_at:1779562102, source_id:"chunk-fa94329119384e436889db983f1732d8", entity_id:"Emotional Hurts"}}, {_id:6500, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"organization", truncate:"", description:"The team nurtured by the manager, which he initially felt had outgrown his need for involvement.", created_at:1779562102, source_id:"chunk-fa94329119384e436889db983f1732d8", entity_id:"The Team"}}, {_id:6501, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"organization", truncate:"", description:"the team represents a group of individuals with whom the person bonded over shared experiences and goals.", created_at:1779562130, source_id:"chunk-185920d43e0d12ff2d096215a58006e2", entity_id:"team"}}, {_id:6503, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"emotional hurt refers to the internal pain and distress experienced by the individual, stemming from past conflicts or unresolved issues.", created_at:1779562130, source_id:"chunk-185920d43e0d12ff2d096215a58006e2", entity_id:"emotional hurt"}}, {_id:6504, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"Inner lack describes a void driving career pursuits and achievements out of fear or external validation.", created_at:1779562135, source_id:"chunk-e28a16af170670aaf61d68da07b71294", entity_id:"Inner Lack"}}, {_id:6506, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"These ideals are practiced as substitutes for purpose, though critiqued as insufficient or noble but impractical.", created_at:1779562136, source_id:"chunk-e28a16af170670aaf61d68da07b71294", entity_id:"Honesty, Unconditional Love, Perfection, Generosity"}}, {_id:6510, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"Fearless state refers to a mental condition enabling flawless practice of ideals like honesty and generosity.", created_at:1779562203, source_id:"chunk-c0dc5060d878117d8549ed7941c43cb2", entity_id:"Fearless State"}}, {_id:6511, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"Past hurts and disappointments are psychological barriers to practicing unconditional love.", created_at:1779562203, source_id:"chunk-c0dc5060d878117d8549ed7941c43cb2", entity_id:"Past Hurts"}}, {_id:6512, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)<SEP>unknown_source", entity_type:"concept", truncate:"", description:"Perfection is an ideal that requires relentless effort to practice in daily life.<SEP>Perfection is an unattainable ideal that leads to self-contradiction and struggle when pursued relentlessly.<SEP>Perfection is presented as an unattainable goal, leading to a struggle against pressure.<SEP>Perfection is critiqued as an unattainable ideal that perpetuates imperfection and struggle when pursued relentlessly.`", created_at:1779666428, source_id:"chunk-d97614999399e6f5f1181bdaebd85f12<SEP>chunk-c0dc5060d878117d8549ed7941c43cb2<SEP>chunk-9de34e6e869087957a9232040a7b6bbb<SEP>chunk-c6481baa2ca6ec863ed7690cee69e3d0<SEP>chunk-ae2f2a9e144a0416a2b1367a6eab9be2", entity_id:"Perfection"}}, {_id:6513, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"Progressive systems are dynamic frameworks valued for adaptability and growth.<SEP>Progressive systems refer to frameworks or methodologies emphasizing forward-thinking approaches to social or organizational transformation.", created_at:1779562229, source_id:"chunk-c0dc5060d878117d8549ed7941c43cb2<SEP>chunk-6f53ead9b7c14c9d4c207b785760c5a8", entity_id:"Progressive Systems"}}, {_id:6514, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"Intelligent systems emphasize rational decision-making and efficiency in achieving goals.<SEP>Intelligent systems denote structured frameworks designed to optimize efficiency and functionality through advanced decision-making mechanisms.", created_at:1779562229, source_id:"chunk-c0dc5060d878117d8549ed7941c43cb2<SEP>chunk-6f53ead9b7c14c9d4c207b785760c5a8", entity_id:"Intelligent Systems"}}, {_id:6515, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"An untransformed mindset represents a state of resistance to change, often characterized by frustration and inertia that undermines systemic progress.", created_at:1779562229, source_id:"chunk-6f53ead9b7c14c9d4c207b785760c5a8", entity_id:"Untransformed Mindset"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6516, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"The second question focuses on discovering purpose through unconventional or non-rational methods, contrasting with traditional advice.", created_at:1779562229, source_id:"chunk-6f53ead9b7c14c9d4c207b785760c5a8", entity_id:"Second Question"}}, {_id:6517, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"The second advice proposes selecting purpose based on innate strengths and cultivating enduring passion for it.", created_at:1779562229, source_id:"chunk-6f53ead9b7c14c9d4c207b785760c5a8", entity_id:"Second Advice"}}, {_id:6518, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"method", truncate:"", description:"The children's method involves making arbitrary or spontaneous choices, such as selecting a \"catcher\" in a game by singing and stopping randomly.", created_at:1779562229, source_id:"chunk-6f53ead9b7c14c9d4c207b785760c5a8", entity_id:"Children's Method"}}, {_id:6519, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"The first advice suggests aligning purpose with personal fascinations and feasibility, emphasizing hard work and commitment.", created_at:1779562229, source_id:"chunk-6f53ead9b7c14c9d4c207b785760c5a8", entity_id:"First Advice"}}, {_id:6520, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"artifact", truncate:"", description:"YouTube Video: YkIBYppBtro is a digital content source containing a discussion on purpose discovery and leadership principles.<SEP>YouTube Video: YkIBYppBtro is a digital content source containing a discussion on purpose discovery and leadership principles.<SEP>YouTube Video: YkIBYppBtro is the source of the input text, containing a video discussing the state of connection and Claude Monet's art.<SEP>YouTube Video: YkIBYppBtro is a video containing Krishna Ji's teachings on enlightenment and overcoming the hungry mind.<SEP>YouTube Video: YkIBYppBtro is a video containing Krishna Ji's teachings on enlightenment and overcoming the hungry mind.", created_at:1779562426, source_id:"chunk-df8fc1ec5d1cc48e4ba2ac7fc6630477<SEP>chunk-409e3173dcf6a797c05e310fb242993c<SEP>chunk-f87f1002a8699b889bcce1050f8f041d", entity_id:"YouTube Video: YkIBYppBtro"}}, {_id:6521, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"person", truncate:"", description:"Shivaji is a historical leader referenced as an example of purpose discovery through enlightened connection.<SEP>Shivaji is a historical leader referenced as an example of purpose discovery through enlightened connection.", created_at:1779562245, source_id:"chunk-df8fc1ec5d1cc48e4ba2ac7fc6630477", entity_id:"Shivaji"}}, {_id:6522, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"person", truncate:"", description:"Picasso is a historical leader referenced as an example of purpose discovery through enlightened connection.<SEP>Picasso is a historical leader referenced as an example of purpose discovery through enlightened connection.", created_at:1779562245, source_id:"chunk-df8fc1ec5d1cc48e4ba2ac7fc6630477", entity_id:"Picasso"}}, {_id:6523, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"True greatness is described as achievable only through authentic connection rather than contrived purposes or windfalls.<SEP>True greatness is described as achievable only through authentic connection rather than contrived purposes or windfalls.", created_at:1779562245, source_id:"chunk-df8fc1ec5d1cc48e4ba2ac7fc6630477", entity_id:"True Greatness"}}, {_id:6524, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"The future path refers to life trajectories chosen through subconscious or non-rational processes rather than deliberate planning.", created_at:1779562230, source_id:"chunk-6f53ead9b7c14c9d4c207b785760c5a8", entity_id:"Future Path"}}, {_id:6525, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"system", truncate:"", description:"An external system designed to achieve organizational goals, which can be undermined by untransformed mindsets.", created_at:1779562230, source_id:"chunk-6f53ead9b7c14c9d4c207b785760c5a8", entity_id:"External System"}}, {_id:6526, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"A metaphor illustrating life's unpredictability and embracing uncertainty without conscious control, as referenced in the video's discussion of purpose discovery.<SEP>A metaphor illustrating life's unpredictability and embracing uncertainty without conscious control, as referenced in the video's discussion of purpose discovery.", created_at:1779562245, source_id:"chunk-df8fc1ec5d1cc48e4ba2ac7fc6630477", entity_id:"Catcher in a Game"}}, {_id:6527, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"UNKNOWN", truncate:"", description:"Connection includes inclusivity, balancing self-care with others' well-being as part of its nature.", created_at:1779562319, source_id:"chunk-ea7262ae497f1dc36bddbc40ddb97a59", entity_id:"Inclusivity"}}, {_id:6528, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"person", truncate:"", description:"Mr. Wongdu is an Indian scientist living in the Himalayas who addresses glacier melting by planting iron rods to form new glaciers.", created_at:1779562354, source_id:"chunk-e0bf909f8e5d3cf013125e64d70b8365", entity_id:"Mr. Wongdu"}}, {_id:6529, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"A career path shaped by spiritual connection and global awareness becomes one's unique purpose or Swadharma.", created_at:1779562354, source_id:"chunk-e0bf909f8e5d3cf013125e64d70b8365", entity_id:"Career Path"}}, {_id:6530, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"naturalobject", truncate:"", description:"The Himalayan glaciers are melting due to environmental changes, prompting Mr. Wongdu's intervention.", created_at:1779562354, source_id:"chunk-e0bf909f8e5d3cf013125e64d70b8365", entity_id:"Himalayan Glaciers"}}, {_id:6531, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"artifact", truncate:"", description:"Iron rods planted by Mr. Wongdu serve as structures to support ice formation and glacier regeneration.", created_at:1779562354, source_id:"chunk-e0bf909f8e5d3cf013125e64d70b8365", entity_id:"Iron Rods"}}, {_id:6532, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"artifact", truncate:"", description:"The Lily Pond Bridge is a subject of Monet's paintings, depicted 17 times from varying perspectives to emphasize nature's beauty.", created_at:1779562354, source_id:"chunk-409e3173dcf6a797c05e310fb242993c", entity_id:"Lily Pond Bridge"}}, {_id:6533, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"person", truncate:"", description:"Claude Monet is a French artist known for his enlightened connection with nature, repeatedly painting a bridge on a Lily Pond to awaken others to natural beauty.", created_at:1779562354, source_id:"chunk-409e3173dcf6a797c05e310fb242993c", entity_id:"Claude Monet"}}, {_id:6534, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"Masterpieces refer to the series of paintings created by Monet, each capturing the bridge from different angles and times to evoke new perspectives.", created_at:1779562354, source_id:"chunk-409e3173dcf6a797c05e310fb242993c", entity_id:"Masterpieces"}}, {_id:6535, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"location", truncate:"", description:"Lily Pond is the location of the bridge painted by Claude Monet, symbolizing his artistic focus on natural beauty.", created_at:1779562354, source_id:"chunk-409e3173dcf6a797c05e310fb242993c", entity_id:"Lily Pond"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6536, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"Gifts and genius represent latent human potential that surfaces when awakened by a state of connection, transcending ordinary limitations.", created_at:1779562354, source_id:"chunk-409e3173dcf6a797c05e310fb242993c", entity_id:"Gifts and Genius"}}, {_id:6537, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"The majority of people remain ordinary due to never awakening to the power of connection, often trapped in passive existence.", created_at:1779562354, source_id:"chunk-409e3173dcf6a797c05e310fb242993c", entity_id:"Majority Remaining Ordinary"}}, {_id:6538, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"person", truncate:"", description:"Pritaji is a spiritual teacher who contrasts spirituality with religion and emphasizes inner awakening and living in an awakened state.", created_at:1779562375, source_id:"chunk-cea13f2b86c9f827be31632c60cac574", entity_id:"Pritaji"}}, {_id:6539, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)<SEP>unknown_source", entity_type:"concept", truncate:"", description:"Spirituality centers on inner awakening as a key component.<SEP>Inner awakening involves self-realization and the recognition of one's true nature or purpose.`<SEP>Inner awakening involves self-realization and the recognition of one's true nature or purpose.`", created_at:1779650718, source_id:"chunk-cea13f2b86c9f827be31632c60cac574<SEP>chunk-6bd1265c66d1065be54810dd4e52f30a", entity_id:"Inner Awakening"}}, {_id:6540, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"UNKNOWN", truncate:"", description:"Spirituality involves living in a sustained awakened state.", created_at:1779562376, source_id:"chunk-cea13f2b86c9f827be31632c60cac574", entity_id:"Living in Awakened State"}}, {_id:6541, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"UNKNOWN", truncate:"", description:"Enlightenment and joy together lead to success.", created_at:1779562388, source_id:"chunk-278a8d67c1e61197e34fdca6005f5c42", entity_id:"Enlightenment and Joy"}}, {_id:6542, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"The hungry mind is characterized by constant wanting and dissatisfaction, which can never be appeased and obstructs the path to happiness.<SEP>The hungry mind is characterized by constant wanting and dissatisfaction, which can never be appeased and obstructs the path to happiness.", created_at:1779562426, source_id:"chunk-f87f1002a8699b889bcce1050f8f041d", entity_id:"Hungry Mind"}}, {_id:6543, properties:{file_path:"unknown_source<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", created_at:1779654022, description:"Heaven is portrayed in the story as a place of cooperation and fulfillment, symbolizing positive outcomes of self-awareness and inner peace.<SEP>Heaven is a conceptual realm representing reward or positive consequences in the afterlife, as discussed in the story.<SEP>Heaven is a conceptual realm representing reward or positive consequences in the afterlife, as discussed in the story.<SEP>Heaven is a location where people help each other eat.<SEP>Heaven symbolizes an initial state of harmony or perfection in a relationship, later contrasting with conflict.<SEP>Heaven symbolizes the ideal or perfect state of a relationship, which can deteriorate into hell.", source_id:"chunk-6ceb252506f04dd8db2d80559d756bc3<SEP>chunk-ab3c93f98db9784d720f1684c8d13dfb<SEP>chunk-8bc65d58c3a45098cba0eac97acb3b39<SEP>chunk-e5d8a73bfe09b1e5fab115705dfa0fe7<SEP>chunk-20d895bd21d3a068503f3d99fc9f225c", entity_id:"Heaven"}}, {_id:6544, properties:{file_path:"unknown_source<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"person", truncate:"", description:"Chitragupta is a figure in the story who judges individuals after death, determining their destination based on their life actions.<SEP>Chitragupta is a mythological figure responsible for maintaining records of human deeds and determining afterlife destinations.<SEP>Chitragupta is a mythological figure responsible for maintaining records of human deeds and determining afterlife destinations.", created_at:1779564133, source_id:"chunk-6ceb252506f04dd8db2d80559d756bc3<SEP>chunk-ab3c93f98db9784d720f1684c8d13dfb", entity_id:"Chitragupta"}}, {_id:6546, properties:{file_path:"unknown_source<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"content", truncate:"", description:"Biryani is a dish used in the story to symbolize the futility of material pursuits in hell and the fulfillment of shared happiness in heaven.<SEP>Biryani is the specific food mentioned in the story.", created_at:1779564224, source_id:"chunk-6ceb252506f04dd8db2d80559d756bc3<SEP>chunk-8bc65d58c3a45098cba0eac97acb3b39<SEP>chunk-40812a40d215948dcfd5e68f4034cb4b", entity_id:"Biryani"}}, {_id:6547, properties:{file_path:"unknown_source<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", entity_type:"concept", truncate:"", created_at:1779654022, description:"Hell is depicted in the story as a place where individuals face frustration and inability to satisfy their needs, symbolizing negative outcomes of external pursuits.<SEP>Hell is a conceptual realm representing punishment or negative consequences in the afterlife, as discussed in the story.<SEP>Hell is a conceptual realm representing punishment or negative consequences in the afterlife, as discussed in the story.<SEP>Hell is a location with a massive table and long utensils.<SEP>Hell metaphorically represents the deterioration of a relationship into conflict and dissatisfaction.<SEP>Hell represents the negative or difficult phase of a relationship, following the initial idealization.", source_id:"chunk-6ceb252506f04dd8db2d80559d756bc3<SEP>chunk-ab3c93f98db9784d720f1684c8d13dfb<SEP>chunk-8bc65d58c3a45098cba0eac97acb3b39<SEP>chunk-e5d8a73bfe09b1e5fab115705dfa0fe7<SEP>chunk-20d895bd21d3a068503f3d99fc9f225c", entity_id:"Hell"}}, {_id:6549, properties:{file_path:"unknown_source", entity_type:"method", truncate:"", description:"Breathing technique balancing Ida and Pingala Nadis to harmonize mind and energy.<SEP>A pranayama practice involving breath retention to impact the energy body and initiate spiritual growth.", created_at:1779562458, source_id:"chunk-7fd1a34e003778b212b04bd1c6c64ad5<SEP>chunk-3f9b4215b066d2d74445f8aa497138dc", entity_id:"Nadi Shodhana"}}, {_id:6553, properties:{file_path:"unknown_source<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Mechanical existence driven by external goals and lack of self-awareness, common in modern life.<SEP>An unconscious way of living characterized by mechanical, fast-paced routines where individuals lack awareness of their thoughts, feelings, breath, and actions, driven by constant motion and doing.", created_at:1779563366, source_id:"chunk-7fd1a34e003778b212b04bd1c6c64ad5<SEP>chunk-b49cabb6cbf6a92062b2c4decee8543b", entity_id:"Unconscious Way of Living"}}, {_id:6554, properties:{file_path:"unknown_source<SEP>YouTube Video: K-AFDVOkIoE (URL: https://www.youtube.com/watch?v=K-AFDVOkIoE)", entity_type:"concept", truncate:"", description:"A five-stage journey from unconscious living to enlightened being, emphasizing consciousness transformation.<SEP>Spiritual evolution refers to the process of heightened awareness and emotional perception during crises, framed as critical to avoiding planetary crises.", created_at:1779648349, source_id:"chunk-7fd1a34e003778b212b04bd1c6c64ad5<SEP>chunk-b1e9b7eb495ce02a274d514dffa406f5", entity_id:"Spiritual Evolution"}}, {_id:6556, properties:{file_path:"unknown_source<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"A civilization characterized by overconsumption and lifestyle excesses leading to health and societal imbalances.<SEP>A societal condition characterized by overconsumption and excessive stimuli, leading to negative impacts on human cognition and behavior.<SEP>A societal condition characterized by overconsumption and excessive stimuli, leading to negative impacts on human cognition and behavior.", created_at:1779563013, source_id:"chunk-3f9b4215b066d2d74445f8aa497138dc<SEP>chunk-10a63ebc48cb5367889fe83878ad4257", entity_id:"Civilization of Excess"}}, {_id:6557, properties:{file_path:"unknown_source<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Refers to the global population exceeding 8 billion, linked to overconsumption and environmental strain.<SEP>A population exceeding sustainable levels, leading to resource strain.", created_at:1779562483, source_id:"chunk-3f9b4215b066d2d74445f8aa497138dc<SEP>chunk-458ec7ed8021b6846b23a3c0fa7e9821", entity_id:"Excess Population"}}, {_id:6558, properties:{file_path:"unknown_source<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Diseases like diabetes, high blood pressure, stroke, heart disease, and obesity caused by lifestyle excesses.<SEP>Contemporary health issues linked to lifestyle excesses.", created_at:1779562483, source_id:"chunk-3f9b4215b066d2d74445f8aa497138dc<SEP>chunk-458ec7ed8021b6846b23a3c0fa7e9821", entity_id:"Modern Diseases"}}, {_id:6559, properties:{file_path:"unknown_source<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Latin term for breath, symbolizing divine connection and consciousness in ancient traditions.<SEP>Spirit is the Latin term for breath, symbolizing divine essence and God.", created_at:1779563121, source_id:"chunk-3f9b4215b066d2d74445f8aa497138dc<SEP>chunk-7234398961838f3894f5b3cb8bdb630b", entity_id:"Spirit"}}, {_id:6561, properties:{file_path:"unknown_source<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", created_at:1779563359, description:"Lunar energy channel influencing the left brain hemisphere, associated with relaxation and creativity.<SEP>The Ida Nadi is an energy channel associated with lunar energy, influencing the right hemisphere of the brain.<SEP>The Ida Nadi is an energy channel associated with lunar energy, influencing the right hemisphere of the brain.<SEP>Ida Nadi is an energy channel associated with lunar energy and influences the right hemisphere of the brain.", source_id:"chunk-3f9b4215b066d2d74445f8aa497138dc<SEP>chunk-ac91c3a51bfc466fbc02960659f7837d<SEP>chunk-3ed034bb1fbb1592baaabc5e71449be5", entity_id:"Ida Nadi"}}, {_id:6562, properties:{file_path:"unknown_source<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Solar energy channel influencing the right brain hemisphere, linked to alertness and logic.<SEP>Pingala Nadi is an energy channel associated with solar energy and influences the left hemisphere of the brain.", created_at:1779563359, source_id:"chunk-3f9b4215b066d2d74445f8aa497138dc<SEP>chunk-3ed034bb1fbb1592baaabc5e71449be5", entity_id:"Pingala Nadi"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6563, properties:{file_path:"unknown_source<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Hierarchical layers of existence (physical, energy, etc.) resembling Russian Matryoshka dolls, interconnected.<SEP>The six bodies, ranging from the physical to the Bliss body, are interconnected and influence each other.<SEP>The six bodies, ranging from the physical to the Bliss body, are interconnected and influence each other.", created_at:1779563195, source_id:"chunk-3f9b4215b066d2d74445f8aa497138dc<SEP>chunk-ac91c3a51bfc466fbc02960659f7837d", entity_id:"Six Bodies"}}, {_id:6564, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Analogy explaining the nested structure of human existence across six bodies.", created_at:1779562459, source_id:"chunk-3f9b4215b066d2d74445f8aa497138dc", entity_id:"Matryoshka Dolls"}}, {_id:6566, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"data", truncate:"", description:"Global population reaching 8 billion in approximately 230 years.", created_at:1779562483, source_id:"chunk-458ec7ed8021b6846b23a3c0fa7e9821", entity_id:"8 Billion People"}}, {_id:6567, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"A condition resulting from lifestyle factors like poor diet and stress.", created_at:1779562483, source_id:"chunk-458ec7ed8021b6846b23a3c0fa7e9821", entity_id:"High Blood Pressure"}}, {_id:6568, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"A civilization characterized by excessive consumption and lifestyle choices.", created_at:1779562483, source_id:"chunk-458ec7ed8021b6846b23a3c0fa7e9821", entity_id:"Civilization Of Excess"}}, {_id:6574, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Cognitive development issues in children due to excessive stimuli and lack of engagement.", created_at:1779562484, source_id:"chunk-458ec7ed8021b6846b23a3c0fa7e9821", entity_id:"Impoverished Brains"}}, {_id:6575, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"The general state of overconsumption and lifestyle imbalances.<SEP>Excess refers to overconsumption of stimuli, leading to negative cognitive and societal consequences.<SEP>Excess refers to overconsumption of stimuli, leading to negative cognitive and societal consequences.", created_at:1779563013, source_id:"chunk-458ec7ed8021b6846b23a3c0fa7e9821<SEP>chunk-10a63ebc48cb5367889fe83878ad4257", entity_id:"Excess"}}, {_id:6576, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Behaviors like excessive sitting, eating, and gaming.", created_at:1779562484, source_id:"chunk-458ec7ed8021b6846b23a3c0fa7e9821", entity_id:"Excessive Activities"}}, {_id:6577, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"creature", truncate:"", description:"Rogue elephants serve as a metaphor for humans acting in chaotic, unbalanced ways due to societal excesses.<SEP>Rogue elephants serve as a metaphor for humans acting in chaotic, unbalanced ways due to societal excesses.", created_at:1779563013, source_id:"chunk-10a63ebc48cb5367889fe83878ad4257", entity_id:"Rogue Elephants"}}, {_id:6579, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"A focus on individualistic gratification at the expense of collective well-being, criticized as part of the excess-driven imbalance.<SEP>A focus on individualistic gratification at the expense of collective well-being, criticized as part of the excess-driven imbalance.", created_at:1779563013, source_id:"chunk-10a63ebc48cb5367889fe83878ad4257", entity_id:"Worship of the Eye"}}, {_id:6580, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"person", truncate:"", description:"Enlightened individuals are proposed as agents of change who can restore balance through conscious living.<SEP>Enlightened individuals are proposed as agents of change who can restore balance through conscious living.", created_at:1779563014, source_id:"chunk-10a63ebc48cb5367889fe83878ad4257<SEP>chunk-aa435522f2e8968c2579690697fe5849", entity_id:"Enlightened People"}}, {_id:6581, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"naturalobject", truncate:"", description:"Molecules are described as flowing through all living beings, shared across dinosaurs, humans, and animals.<SEP>Molecules are inhaled and exhaled by the animal in East Africa, representing the physical basis of breath.<SEP>Molecules are inhaled and exhaled by the animal in East Africa, representing the physical basis of breath.", created_at:1779563195, source_id:"chunk-7234398961838f3894f5b3cb8bdb630b<SEP>chunk-369c95aae7fc4dbe0b27e0f7e8e427f7", entity_id:"Molecules"}}, {_id:6582, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Life force is equated with breath, representing the interconnectedness of all life.", created_at:1779563121, source_id:"chunk-7234398961838f3894f5b3cb8bdb630b", entity_id:"Life Force"}}, {_id:6583, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"creature", truncate:"", description:"Dinosaurs are referenced as historical beings that inhaled and exhaled the same molecules as modern life forms.", created_at:1779563121, source_id:"chunk-7234398961838f3894f5b3cb8bdb630b", entity_id:"Dinosaurs"}}, {_id:6584, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"creature", truncate:"", description:"An animal in East Africa is mentioned as sharing the same molecules inhaled by dinosaurs and humans.", created_at:1779563121, source_id:"chunk-7234398961838f3894f5b3cb8bdb630b", entity_id:"East African Animal"}}, {_id:6585, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"creature", truncate:"", description:"The animal in East Africa is mentioned as inhaling and exhaling molecules, illustrating the natural process of breath.<SEP>The animal in East Africa is mentioned as inhaling and exhaling molecules, illustrating the natural process of breath.", created_at:1779563195, source_id:"chunk-369c95aae7fc4dbe0b27e0f7e8e427f7", entity_id:"Animal in East Africa"}}, {_id:6586, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"artifact", truncate:"", description:"The kite is used as a metaphor by the sages of India to explain the relationship between breath and the mind.<SEP>The kite is used as a metaphor by the sages of India to explain the relationship between breath and the mind.", created_at:1779563195, source_id:"chunk-369c95aae7fc4dbe0b27e0f7e8e427f7", entity_id:"Kite"}}, {_id:6588, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"artifact", truncate:"", description:"Russian Matryoshka dolls are used as a metaphor to explain the hierarchical and nested nature of the six bodies.<SEP>Russian Matryoshka dolls are used as a metaphor to explain the hierarchical and nested nature of the six bodies.", created_at:1779563195, source_id:"chunk-ac91c3a51bfc466fbc02960659f7837d", entity_id:"Russian Matryoshka Dolls"}}, {_id:6590, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"The Pranamaya Kosha, or energy body, contains 72,000 energy channels and is central to breath practices.<SEP>The Pranamaya Kosha, or energy body, contains 72,000 energy channels and is central to breath practices.", created_at:1779563195, source_id:"chunk-ac91c3a51bfc466fbc02960659f7837d", entity_id:"Pranamaya Kosha"}}, {_id:6591, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"The Bliss body is described as the largest of the six bodies, encompassing the entire universe.<SEP>The Bliss body is described as the largest of the six bodies, encompassing the entire universe.", created_at:1779563195, source_id:"chunk-ac91c3a51bfc466fbc02960659f7837d", entity_id:"Bliss Body"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6592, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Lunar energy is carried by the Ida Nadi and affects the right hemisphere of the brain.<SEP>Lunar energy is carried by the Ida Nadi and affects the right hemisphere of the brain.<SEP>Lunar Energy is carried by the Ida Nadi and influences the right hemisphere.", created_at:1779563359, source_id:"chunk-ac91c3a51bfc466fbc02960659f7837d<SEP>chunk-3ed034bb1fbb1592baaabc5e71449be5", entity_id:"Lunar Energy"}}, {_id:6593, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"UNKNOWN", truncate:"", description:"Energy channels in the Pranamaya Kosha impact overall bodily and mental states.\" But in the entities list, \"Energy Channels\" isn't present. That's a mistake. The original output included a relationship with \"Energy Channels\" as the source entity, but it wasn't listed as an entity. That's an error. So \"Energy Channels\" should be an entity, but it's missing. Therefore, this is a missed entity.<SEP>Energy channels in the Pranamaya Kosha impact overall bodily and mental states.", created_at:1779563270, source_id:"chunk-ac91c3a51bfc466fbc02960659f7837d", entity_id:"Body Systems"}}, {_id:6594, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"UNKNOWN", truncate:"", description:"Breath has the power to cure asthma and enhance vitality.", created_at:1779563330, source_id:"chunk-369c95aae7fc4dbe0b27e0f7e8e427f7", entity_id:"curing asthma"}}, {_id:6595, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"UNKNOWN", truncate:"", description:"Breath has the power to cure asthma, heal heart problems, and enhance vitality.", created_at:1779563331, source_id:"chunk-369c95aae7fc4dbe0b27e0f7e8e427f7", entity_id:"health outcomes"}}, {_id:6596, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"UNKNOWN", truncate:"", description:"Breath is described as having the power to cure asthma, heal heart problems, and enhance vitality.", created_at:1779563331, source_id:"chunk-369c95aae7fc4dbe0b27e0f7e8e427f7", entity_id:"Health Outcomes"}}, {_id:6597, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"UNKNOWN", truncate:"", description:"Mastering breath is linked to calming the mind, building concentration, and achieving altered states of consciousness.", created_at:1779563331, source_id:"chunk-369c95aae7fc4dbe0b27e0f7e8e427f7", entity_id:"Mind and Consciousness"}}, {_id:6599, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"method", truncate:"", description:"Nadi Shodhana Pranayama is a breathing technique that impacts the energy body.", created_at:1779563359, source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5", entity_id:"Nadi Shodhana Pranayama"}}, {_id:6600, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"The Right Hemisphere is influenced by the Ida Nadi and is associated with lunar energy.", created_at:1779563359, source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5", entity_id:"Right Hemisphere"}}, {_id:6601, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Solar Energy is carried by the Pingala Nadi and influences the left hemisphere.", created_at:1779563359, source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5", entity_id:"Solar Energy"}}, {_id:6602, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"The Left Hemisphere is influenced by the Pingala Nadi and is associated with solar energy.", created_at:1779563359, source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5", entity_id:"Left Hemisphere"}}, {_id:6603, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"natural_object", truncate:"", description:"The Right Nostril is a body part through which the Ida Nadi is associated.", created_at:1779563360, source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5", entity_id:"Right Nostril"}}, {_id:6604, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"natural_object", truncate:"", description:"The Left Nostril is a body part through which the Pingala Nadi is associated.", created_at:1779563360, source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5", entity_id:"Left Nostril"}}, {_id:6605, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"UNKNOWN", truncate:"", description:"Pingala Nadi is associated with the Right Nostril.", created_at:1779563361, source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5", entity_id:"Nostril"}}, {_id:6606, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"A mechanical life refers to a repetitive, automated existence focused on relentless activity without conscious engagement or self-awareness.", created_at:1779563366, source_id:"chunk-b49cabb6cbf6a92062b2c4decee8543b", entity_id:"Mechanical Life"}}, {_id:6607, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"The first stage of spiritual evolution involves becoming conscious of one's breath, thoughts, feelings, relationships, and actions, fostering awareness and intentionality.", created_at:1779563366, source_id:"chunk-b49cabb6cbf6a92062b2c4decee8543b", entity_id:"Conscious"}}, {_id:6608, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"The second stage of spiritual evolution involves awareness of one's emotional and mental states in various life contexts, recognizing the origins of divisions and separations in unenlightened thinking.", created_at:1779563366, source_id:"chunk-b49cabb6cbf6a92062b2c4decee8543b", entity_id:"Aware"}}, {_id:6609, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"The state of interconnection refers to a perceived reality where divisions and separations dissolve, described as a higher consciousness state.", created_at:1779563397, source_id:"chunk-360f7674da2e91f036d52739a28095ed", entity_id:"State of Interconnection"}}, {_id:6610, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"event", truncate:"", description:"An audience question exploring alternative methods to traditional achievement paradigms through conscious state transformation.", created_at:1779563397, source_id:"chunk-360f7674da2e91f036d52739a28095ed", entity_id:"Question About Achieving Life Goals"}}, {_id:6611, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"The fifth stage of enlightenment represents a transformed state of consciousness where one seeks to exist in an enlightened state perpetually.", created_at:1779563397, source_id:"chunk-360f7674da2e91f036d52739a28095ed", entity_id:"Fifth Stage of Enlightenment"}}, {_id:6612, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Conceptual roles representing idealized states of being characterized by heightened awareness and compassion in various social contexts.", created_at:1779563397, source_id:"chunk-360f7674da2e91f036d52739a28095ed", entity_id:"Enlightened Parent/Leader/Child/Friend"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6615, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)<SEP>YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", entity_type:"concept", truncate:"", description:"Three principles governing human consciousness and its interaction with an intelligent universe.<SEP>The laws of consciousness are principles suggesting that effects can manifest before their causes in the realm of subjective experience.", created_at:1779650813, source_id:"chunk-088b2986c8580178cc7f54a0f65ceaa7<SEP>chunk-1e936532a5c53d8221f209a5d79cf8e0", entity_id:"Laws of Consciousness"}}, {_id:6617, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"The Third Law is defined as the cause and effect principle.", created_at:1779563471, source_id:"chunk-5ccc31c8e1d16623e7633752bbd5a9ab", entity_id:"Third Law"}}, {_id:6618, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Cause and Effect is a fundamental principle where in the subatomic world, the effect precedes the cause.", created_at:1779563471, source_id:"chunk-5ccc31c8e1d16623e7633752bbd5a9ab", entity_id:"Cause and Effect"}}, {_id:6619, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"The Subatomic World is where the effect (glass falling) precedes the cause (pushing).", created_at:1779563471, source_id:"chunk-5ccc31c8e1d16623e7633752bbd5a9ab", entity_id:"Subatomic World"}}, {_id:6620, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"organization", truncate:"", description:"Scientists are mentioned as observing the subatomic world and being confused by the reversed cause-effect relationship.", created_at:1779563471, source_id:"chunk-5ccc31c8e1d16623e7633752bbd5a9ab", entity_id:"Scientists"}}, {_id:6623, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Blind spots are shortcomings in oneself that are difficult to recognize, contrasting with the ability to see them in others.", created_at:1779563551, source_id:"chunk-a5a06fbb8006348a3ccd90b704dc666e", entity_id:"Blind Spots"}}, {_id:6624, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"The unenlightened state is presented as a cause for the mind's judgmental behavior.<SEP>The unenlightened state is presented as a cause for the mind's judgmental behavior.", created_at:1779564133, source_id:"chunk-855eeb4014bec08fbcd5dda2853ca446", entity_id:"Unenlightened State"}}, {_id:6625, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"Global is referenced in the context of judgment occurring throughout the world.<SEP>Global is referenced in the context of judgment occurring throughout the world.", created_at:1779564134, source_id:"chunk-855eeb4014bec08fbcd5dda2853ca446", entity_id:"Global"}}, {_id:6626, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"UNKNOWN", truncate:"", description:"Judgment in families is a result of being unenlightened.", created_at:1779563622, source_id:"chunk-855eeb4014bec08fbcd5dda2853ca446", entity_id:"Judgment in Families"}}, {_id:6627, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"artifact", truncate:"", description:"The long fork and spoon are used by people in hell to eat.", created_at:1779564224, source_id:"chunk-8bc65d58c3a45098cba0eac97acb3b39", entity_id:"Long Fork and Spoon"}}, {_id:6628, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"artifact", truncate:"", description:"The massive table is present in hell and is used for serving food.", created_at:1779564224, source_id:"chunk-8bc65d58c3a45098cba0eac97acb3b39", entity_id:"Massive Table"}}, {_id:6629, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"content", truncate:"", description:"The varieties of food are present in hell and are difficult to eat.", created_at:1779564224, source_id:"chunk-8bc65d58c3a45098cba0eac97acb3b39", entity_id:"Varieties of Food"}}, {_id:6630, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"UNKNOWN", truncate:"", description:"In heaven, people help each other eat the food.", created_at:1779564225, source_id:"chunk-8bc65d58c3a45098cba0eac97acb3b39", entity_id:"People helping each other"}}, {_id:6631, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"UNKNOWN", truncate:"", description:"In hell, people use long utensils which makes eating difficult.", created_at:1779564226, source_id:"chunk-8bc65d58c3a45098cba0eac97acb3b39", entity_id:"People using utensils"}}, {_id:6632, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"UNKNOWN", truncate:"", description:"The spoon was used for serving Biryani to another person.<SEP>Biryani was used to feed another person with the spoon.<SEP>The spoon is used to feed Biryani to another person.<SEP>Biryani was served using a spoon.", created_at:1779564231, source_id:"chunk-40812a40d215948dcfd5e68f4034cb4b", entity_id:"Spoon"}}, {_id:6633, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)<SEP>unknown_source", entity_type:"person", truncate:"", description:"Sri Rama is Dasharatha's beloved son, who was sent away and led to Dasharatha's death from heartache.<SEP>Sri Rama is a divine figure in the Ramayana who redeemed Ahalya through compassion.<SEP>Sri Rama is a figure whose presence Dasharatha consciously perceived, deepening his inner conflict.<SEP>Sri Rama is a divine figure in the Ramayana who redeemed Ahalya through compassion.<SEP>Sri Rama is the figure whose compassion and touch transformed Ahalya.", created_at:1779564418, source_id:"chunk-c0b80dedb75ca2eb809b280546928f57<SEP>chunk-ea1f0fc5a4bd6b550f008cf8e4905da5<SEP>chunk-48c6db0a5b206ddf4f5b6555c5408117<SEP>chunk-6a0ae176234daa0b99856020306df342", entity_id:"Sri Rama"}}, {_id:6634, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"person", truncate:"", description:"Dasharatha is a king who killed Shravana Kumara and his own son Sri Rama, leading to intense guilt and heartache.<SEP>Dasharatha is a king who unknowingly caused the death of his son Shravana, leading to self-punishment through guilt and remorse.", created_at:1779564287, source_id:"chunk-c0b80dedb75ca2eb809b280546928f57<SEP>chunk-48c6db0a5b206ddf4f5b6555c5408117", entity_id:"Dasharatha"}}, {_id:6636, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"Self-forgiveness is emphasized as a critical gateway to inner peace and overcoming guilt.", created_at:1779564256, source_id:"chunk-c0b80dedb75ca2eb809b280546928f57", entity_id:"Self-forgiveness"}}, {_id:6637, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Authentic forgiving oneself breaks the flow of negative karmic energy and allows harmonious life flow.<SEP>Authentic forgiving oneself breaks the flow of negative karmic energy and allows harmonious life flow.", created_at:1779564316, source_id:"chunk-ea1f0fc5a4bd6b550f008cf8e4905da5", entity_id:"Authentic Forgiving Oneself"}}, {_id:6638, properties:{file_path:"unknown_source<SEP>YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"person", truncate:"", description:"Ahalya is a character from the Ramayana who transformed into stone due to guilt and was redeemed by Sri Rama.<SEP>Ahalya is a character from the Ramayana who transformed into stone due to guilt and was redeemed by Sri Rama.<SEP>Ahalya is a character in the Ramayana who experiences betrayal and abandonment, leading to a karmic loop.", created_at:1779564399, source_id:"chunk-ea1f0fc5a4bd6b550f008cf8e4905da5<SEP>chunk-f35ecb38bfeca95ba27fabf08e8561a8<SEP>chunk-6a0ae176234daa0b99856020306df342", entity_id:"Ahalya"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6639, properties:{file_path:"unknown_source<SEP>YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"person", truncate:"", created_at:1779564418, description:"Sage Gautama is Ahalya's husband in the Ramayana, who abandoned her after discovering her infidelity.<SEP>Sage Gautama is Ahalya's husband in the Ramayana, who abandoned her after discovering her infidelity.<SEP>Sage Gautama is Ahalya's husband and son who abandon her after discovering her infidelity.<SEP>Sage Gautama is Ahalya's husband and the father of her child, who abandoned her after her infidelity.", source_id:"chunk-ea1f0fc5a4bd6b550f008cf8e4905da5<SEP>chunk-f35ecb38bfeca95ba27fabf08e8561a8<SEP>chunk-6a0ae176234daa0b99856020306df342", entity_id:"Sage Gautama"}}, {_id:6640, properties:{file_path:"unknown_source<SEP>YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"person", truncate:"", created_at:1779564418, description:"Indra is a deity in the Ramayana who tempted Ahalya, leading to her downfall.<SEP>Indra is a deity in the Ramayana who tempted Ahalya, leading to her downfall.<SEP>Indra is the god who tempts Ahalya, leading to her infidelity and subsequent abandonment.<SEP>Indra is the deity who tricked Ahalya into committing infidelity.", source_id:"chunk-ea1f0fc5a4bd6b550f008cf8e4905da5<SEP>chunk-f35ecb38bfeca95ba27fabf08e8561a8<SEP>chunk-6a0ae176234daa0b99856020306df342", entity_id:"Indra"}}, {_id:6641, properties:{file_path:"unknown_source<SEP>YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"person", truncate:"", description:"The businessman is a follower of Buddha who spat on him in anger but later sought forgiveness.<SEP>The businessman is a follower of Buddha who spat on him in anger but later sought forgiveness.<SEP>Businessman is a person who spat on Buddha's face in anger and seeks forgiveness.", created_at:1779564551, source_id:"chunk-ea1f0fc5a4bd6b550f008cf8e4905da5<SEP>chunk-24b5f3611aa0088cf040177e4f897986", entity_id:"Businessman"}}, {_id:6646, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"Gilly is a game (artifact) played by the boy.<SEP>An ancient game mentioned in the Mahabharata, considered a precursor to modern cricket.", created_at:1779564375, source_id:"chunk-96ee5b32030dd42df75feab094827373<SEP>chunk-8bc46e0d57c8aca69ad6ab17dc5cfd03", entity_id:"Gilly"}}, {_id:6648, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"person", truncate:"", description:"The uncle who provided the boy with love and later gave him critical advice.", created_at:1779564375, source_id:"chunk-8bc46e0d57c8aca69ad6ab17dc5cfd03", entity_id:"The Uncle"}}, {_id:6649, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"person", truncate:"", description:"The aunt whose disapproval led to the boy's parents reprimanding him.", created_at:1779564375, source_id:"chunk-8bc46e0d57c8aca69ad6ab17dc5cfd03", entity_id:"The Aunt"}}, {_id:6650, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"event", truncate:"", description:"An incident where the boy's cousin lost vision in one eye after being hit by the Gilly ball.", created_at:1779564375, source_id:"chunk-8bc46e0d57c8aca69ad6ab17dc5cfd03", entity_id:"Injury Incident"}}, {_id:6651, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"person", truncate:"", description:"ed is a character experiencing guilt, fear, and shame, undergoing an inner journey at Ekam and influenced by samskaras.", created_at:1779564385, source_id:"chunk-08331bfaac45fcb68867c11cb7fb41b4", entity_id:"ed"}}, {_id:6652, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"UNKNOWN", truncate:"", description:"samskaras cause repetitive life patterns throughout one's life.", created_at:1779564386, source_id:"chunk-08331bfaac45fcb68867c11cb7fb41b4", entity_id:"repetitive patterns"}}, {_id:6653, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"Forgiving oneself is a process that breaks the flow of negative karmic energy and allows for a more harmonious life.", created_at:1779564399, source_id:"chunk-f35ecb38bfeca95ba27fabf08e8561a8", entity_id:"Forgiving"}}, {_id:6654, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"Karmic flu is a metaphor for life as a cycle of negative energy that can be transformed through forgiveness.", created_at:1779564399, source_id:"chunk-f35ecb38bfeca95ba27fabf08e8561a8", entity_id:"Karmic Flu"}}, {_id:6655, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"event", truncate:"", description:"The Mystic process is a spiritual experience that involves revisiting past moments and healing, leading to a transformation in perspective.", created_at:1779564399, source_id:"chunk-f35ecb38bfeca95ba27fabf08e8561a8", entity_id:"Mystic Process"}}, {_id:6656, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"Karmic loop is a cycle of negative energy that can be broken through authentic self-forgiveness.", created_at:1779564400, source_id:"chunk-f35ecb38bfeca95ba27fabf08e8561a8", entity_id:"Karmic Loop"}}, {_id:6657, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"Authentic forgiving oneself is a powerful act that breaks the karmic loop and allows for a new, harmonious flow of life.", created_at:1779564400, source_id:"chunk-f35ecb38bfeca95ba27fabf08e8561a8", entity_id:"Authentic Forgiving"}}, {_id:6658, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"Negative karmic energy is a force that can be broken through the act of forgiving oneself.", created_at:1779564400, source_id:"chunk-f35ecb38bfeca95ba27fabf08e8561a8", entity_id:"Negative Karmic Energy"}}, {_id:6659, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"Harmonious flow of life is a state that emerges when negative karmic energy is broken.", created_at:1779564400, source_id:"chunk-f35ecb38bfeca95ba27fabf08e8561a8", entity_id:"Harmonious Flow of Life"}}, {_id:6660, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"The karmic cycle refers to the cycle of cause and effect that Ahalya experienced, which was ended by Rama's compassion.", created_at:1779564418, source_id:"chunk-6a0ae176234daa0b99856020306df342", entity_id:"Karmic Cycle"}}, {_id:6662, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"person", truncate:"", description:"Damayana is a sage who narrated the story of Ahalya and her transformation.", created_at:1779564418, source_id:"chunk-6a0ae176234daa0b99856020306df342", entity_id:"Damayana"}}, {_id:6665, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"Family Restoration refers to the reconciliation of Ahalya with her husband and son after her transformation.", created_at:1779564419, source_id:"chunk-6a0ae176234daa0b99856020306df342", entity_id:"Family Restoration"}}, {_id:6666, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"Self-Judgment is the negative state that Ahalya overcame through Rama's compassion.", created_at:1779564419, source_id:"chunk-6a0ae176234daa0b99856020306df342", entity_id:"Self-Judgment"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6667, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"Destructive Emotional States are the states that led to Ahalya's mistakes.", created_at:1779564419, source_id:"chunk-6a0ae176234daa0b99856020306df342", entity_id:"Destructive Emotional States"}}, {_id:6668, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"Wounds in the Heart are metaphorical wounds that need healing, as mentioned in the context of compassion.", created_at:1779564419, source_id:"chunk-6a0ae176234daa0b99856020306df342", entity_id:"Wounds in the Heart"}}, {_id:6669, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"Compassion for Oneself is emphasized as a crucial aspect of healing and transformation.", created_at:1779564419, source_id:"chunk-6a0ae176234daa0b99856020306df342", entity_id:"Compassion for Oneself"}}, {_id:6670, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"event", truncate:"", description:"An event where a restless businessman confronted Buddha in anger, leading to a discussion on emotional states and self-compassion.", created_at:1779564468, source_id:"chunk-3907dc38c0d0edd5d39a312bc7148a7e", entity_id:"Incident at Buddha's Assembly"}}, {_id:6671, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"person", truncate:"", description:"A businessman who approached Buddha in anger, concerned about his children's time spent with Buddha instead of business.", created_at:1779564468, source_id:"chunk-3907dc38c0d0edd5d39a312bc7148a7e", entity_id:"Restless Businessman"}}, {_id:6672, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"The practice of treating oneself with kindness and understanding, central to personal transformation and emotional regulation.", created_at:1779564468, source_id:"chunk-3907dc38c0d0edd5d39a312bc7148a7e", entity_id:"Self-Compassion"}}, {_id:6673, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"group", truncate:"", description:"Buddha's disciples are followers of Buddha who witnessed his interaction with the businessman and were shocked by his response.", created_at:1779564551, source_id:"chunk-24b5f3611aa0088cf040177e4f897986", entity_id:"Buddha's Disciples"}}, {_id:6675, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"Inner violence describes self-directed emotional harm resulting from intense animosity toward others.", created_at:1779564568, source_id:"chunk-dadf662841fb50b7a5b2c3f5fc8512f2", entity_id:"Inner Violence"}}, {_id:6676, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)<SEP>unknown_source", entity_type:"person", truncate:"", description:"Duryodhana is a character from the Mahabharata who harbored resentment and anger due to perceived injustice in inheritance.<SEP>Duryodhana is a character marked by childhood anger and jealousy, which evolved into resentment and hate towards his cousins, leading to a desire for revenge.<SEP>Duryodhana is associated with a faction that desired war, contributing to inevitable conflict alongside Dharma Raja's side.<SEP>Duryodhana is a key antagonist in the Mahabharata, associated with the refusal of Pandavas' rightful kingdom.`", created_at:1779667271, source_id:"chunk-dadf662841fb50b7a5b2c3f5fc8512f2<SEP>chunk-cdfac554a3f7f2ebcb638a60cb844514<SEP>chunk-d8c510c8750c7c378759ec2d9cfe2559<SEP>chunk-5139546d120bc87201fc62ee64d86e4c", entity_id:"Duryodhana"}}, {_id:6677, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"person", truncate:"", description:"Dharma Raja is a character from the Mahabharata who felt wronged, though less emphasized in the text.<SEP>Dharma Raja is a character who experienced injustice, including the loss of his kingdom and the humiliation of his wife, leading to exile.<SEP>Dharma Raja is the eldest cousin and competitor to the throne who chooses forgiveness over hate, promoting peace.<SEP>Dharma Raja is described as a figure who followed forgiveness, avoided war, and lived peacefully despite flaws, emphasizing inner peace over bitterness.", created_at:1779564610, source_id:"chunk-dadf662841fb50b7a5b2c3f5fc8512f2<SEP>chunk-cdfac554a3f7f2ebcb638a60cb844514<SEP>chunk-83bfe4562e334ed1af5a2a9b2d7a6f8d<SEP>chunk-d8c510c8750c7c378759ec2d9cfe2559", entity_id:"Dharma Raja"}}, {_id:6678, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"Revenge refers to a desire for retribution driven by perceived wrongs.", created_at:1779564569, source_id:"chunk-dadf662841fb50b7a5b2c3f5fc8512f2", entity_id:"Revenge"}}, {_id:6679, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"data", truncate:"", description:"The duration of 13 years that Dharma Raja and his wife endured in exile, marked by unimaginable hardships.", created_at:1779564579, source_id:"chunk-cdfac554a3f7f2ebcb638a60cb844514", entity_id:"13 Years in Exile"}}, {_id:6680, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"person", truncate:"", description:"Dharma Raja's wife is a character who was humiliated in front of the court and endured hardships alongside her husband during their exile.", created_at:1779564579, source_id:"chunk-cdfac554a3f7f2ebcb638a60cb844514", entity_id:"Dharma Raja's Wife"}}, {_id:6685, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"A state of conflict and bitterness in the woman's relationship with her husband, later resolved through forgiveness.", created_at:1779564610, source_id:"chunk-d8c510c8750c7c378759ec2d9cfe2559", entity_id:"Conflicting Relationship"}}, {_id:6686, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"An internal state of conflict leading to external turmoil, contrasted with peace.", created_at:1779564610, source_id:"chunk-d8c510c8750c7c378759ec2d9cfe2559", entity_id:"Inner State of War"}}, {_id:6687, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"person", truncate:"", description:"Her husband is a man who is deeply impacted by his wife's peace and evolution, and they maintain a joint business and friendship post-divorce.<SEP>Her husband is a man who is deeply impacted by his wife's peace and evolution, and they maintain a joint business and friendship post-divorce.", created_at:1779565369, source_id:"chunk-44d0cd04ae47a45e1a47b956b8446480", entity_id:"Her Husband"}}, {_id:6688, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"UNKNOWN", truncate:"", description:"The YouTube Video contains teachings attributed to Dharma Raja about forgiveness and inner peace.", created_at:1779564665, source_id:"chunk-d8c510c8750c7c378759ec2d9cfe2559", entity_id:"Dharma Raja's Teachings"}}, {_id:6689, properties:{file_path:"unknown_source<SEP>YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"event", truncate:"", description:"World Oneness Day is a global observance addressing divisiveness and promoting harmony among humanity and living beings.<SEP>World Oneness Day is an event addressing global problems by promoting unity and consciousness beyond human divisions.<SEP>An annual event focused on promoting global unity and addressing humanity's consciousness towards Oneness.<SEP>An annual event focused on promoting global unity and addressing humanity's consciousness towards Oneness.", created_at:1779648474, source_id:"chunk-3f2351d7bbf12ee7e6a879305b4fddf7<SEP>chunk-4c5c53ea662d003ac96f0faa52dfe234<SEP>chunk-5e293d2f56a82348c78f2cc08b14a7e1", entity_id:"World Oneness Day"}}, {_id:6690, properties:{file_path:"unknown_source<SEP>YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"concept", truncate:"", description:"Attitudes are judgments or perceptions that distort reality, often leading to obsession, separation, and inability to relate to others.<SEP>Attitudes are described as judgments or perspectives formed during personal development.", created_at:1779648523, source_id:"chunk-d97614999399e6f5f1181bdaebd85f12<SEP>chunk-3f2351d7bbf12ee7e6a879305b4fddf7<SEP>chunk-ff648886e29693de0f8c7afb7b4a9d7e", entity_id:"Attitudes"}}, {_id:6692, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Knowledge and wisdom are essential for transcending attitudes and achieving success.", created_at:1779565371, source_id:"chunk-3f2351d7bbf12ee7e6a879305b4fddf7<SEP>chunk-1de41cf0c7dd51f4c24f73f5f21d78fe", entity_id:"Knowledge"}}] AS row
