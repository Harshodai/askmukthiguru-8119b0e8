UNWIND [{start: {_id:1071}, end: {_id:5810}, properties:{file_path:"unknown_source", keywords:"biodiversity loss,extinction", truncate:"", weight:1.0, description:"The extinction of 59% of vertebrates is a loss of biodiversity on Earth.", created_at:1779531588, source_id:"chunk-aa80ceeb1e8b2dd7460f820d674a1d04"}}, {start: {_id:1071}, end: {_id:5809}, properties:{file_path:"unknown_source", keywords:"biomass proportion,human impact", truncate:"", weight:1.0, description:"Humanity's biomass is 0.01% of Earth's total biomass, indicating a small proportion.", created_at:1779531588, source_id:"chunk-aa80ceeb1e8b2dd7460f820d674a1d04"}}, {start: {_id:5812}, end: {_id:1071}, properties:{file_path:"unknown_source", keywords:"environmental harm,ethical violation", truncate:"", weight:1.0, description:"Adharma involves harming Earth's homes and taking excessively from the planet.", created_at:1779531588, source_id:"chunk-aa80ceeb1e8b2dd7460f820d674a1d04"}}, {start: {_id:123}, end: {_id:5819}, properties:{file_path:"YouTube Video: p2HecXyM3tE (URL: https://www.youtube.com/watch?v=p2HecXyM3tE)", truncate:"", keywords:"deforestation,ecological harm", weight:1.0, description:"Human activities caused 50% deforestation of rainforests through unsustainable practices.", created_at:1779532049, source_id:"chunk-41597711835923a77b9f33543aee1546"}}, {start: {_id:123}, end: {_id:5818}, properties:{file_path:"YouTube Video: p2HecXyM3tE (URL: https://www.youtube.com/watch?v=p2HecXyM3tE)", truncate:"", keywords:"biodiversity loss,extinction", weight:1.0, description:"Human actions led to 59% vertebrate extinction in three decades through habitat destruction.", created_at:1779532049, source_id:"chunk-41597711835923a77b9f33543aee1546"}}, {start: {_id:3255}, end: {_id:5792}, properties:{file_path:"YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)", truncate:"", keywords:"manifestations,societal issues", weight:1.0, description:"Violence and conflicts are depicted as symptoms of deeper societal divisions in the United States.", created_at:1779532049, source_id:"chunk-5eb1940c87be8a3cdd703c8147cf00f5"}}, {start: {_id:5793}, end: {_id:5778}, properties:{file_path:"YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)", truncate:"", keywords:"societal challenge,test of fire", weight:1.0, description:"Elections are framed as a pivotal moment testing citizens' ability to maintain unity amid political differences.", created_at:1779532049, source_id:"chunk-5eb1940c87be8a3cdd703c8147cf00f5"}}, {start: {_id:5795}, end: {_id:5794}, properties:{file_path:"YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)", truncate:"", keywords:"coexistence,unity", weight:1.0, description:"Differing views are urged to coexist without fostering anger, aligning with the national goal of oneness.", created_at:1779532049, source_id:"chunk-5eb1940c87be8a3cdd703c8147cf00f5"}}, {start: {_id:5815}, end: {_id:123}, properties:{file_path:"YouTube Video: p2HecXyM3tE (URL: https://www.youtube.com/watch?v=p2HecXyM3tE)", truncate:"", keywords:"biomass disparity,ecological imbalance", weight:1.0, description:"Despite minimal biomass share, humans disproportionately impact Earth's ecosystems.", created_at:1779532049, source_id:"chunk-41597711835923a77b9f33543aee1546"}}, {start: {_id:5793}, end: {_id:1395}, properties:{file_path:"YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)", truncate:"", keywords:"leadership transition,responsibility", weight:1.0, description:"Leaders' transient nature contrasts with the enduring impact of citizens' choices on relationships and national unity.", created_at:1779532049, source_id:"chunk-5eb1940c87be8a3cdd703c8147cf00f5"}}, {start: {_id:89}, end: {_id:5794}, properties:{file_path:"YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)", truncate:"", keywords:"conflict resolution,opposition", weight:1.0, description:"Anger is positioned as antithetical to peace, requiring conscious dissolution of divisiveness for societal healing.", created_at:1779532049, source_id:"chunk-5eb1940c87be8a3cdd703c8147cf00f5"}}, {start: {_id:123}, end: {_id:5817}, properties:{file_path:"YouTube Video: p2HecXyM3tE (URL: https://www.youtube.com/watch?v=p2HecXyM3tE)", truncate:"", keywords:"animal mortality,exploitation", weight:1.0, description:"72 billion land animals are killed annually through human consumption patterns.", created_at:1779532049, source_id:"chunk-41597711835923a77b9f33543aee1546"}}, {start: {_id:5796}, end: {_id:5794}, properties:{file_path:"YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)", truncate:"", keywords:"national identity,symbolic transition", weight:1.0, description:"The", created_at:1779532050, source_id:"chunk-5eb1940c87be8a3cdd703c8147cf00f5"}}, {start: {_id:89}, end: {_id:5778}, properties:{file_path:"YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)", truncate:"", keywords:"lasting impact,temporary event", weight:1.0, description:"Elections are a transient political event, but the resulting anger may persist beyond them.", created_at:1779532050, source_id:"chunk-5eb1940c87be8a3cdd703c8147cf00f5"}}, {start: {_id:5816}, end: {_id:123}, properties:{file_path:"YouTube Video: p2HecXyM3tE (URL: https://www.youtube.com/watch?v=p2HecXyM3tE)", truncate:"", keywords:"exploitation,marine mortality", weight:1.0, description:"1.2 trillion aquatic animals die yearly due to overfishing and pollution.", created_at:1779532050, source_id:"chunk-41597711835923a77b9f33543aee1546"}}, {start: {_id:123}, end: {_id:755}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)", keywords:"prevention,sensitivity", truncate:"", weight:2.0, description:"Collective peace prevents inhumanity and fosters sensitivity to the plight of others.<SEP>Collective peace prevents inhumanity and fosters sensitivity to the plight of others.", created_at:1779534743, source_id:"chunk-817243e49afe8b11df3c2d2ea2541519"}}, {start: {_id:5821}, end: {_id:1782}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)", keywords:"acknowledgment,gratitude", truncate:"", weight:2.0, description:"The speaker expresses gratitude toward Gaharaman for their presence.<SEP>The speaker expresses gratitude toward Gaharaman for their presence.", created_at:1779534743, source_id:"chunk-817243e49afe8b11df3c2d2ea2541519"}}, {start: {_id:5820}, end: {_id:2533}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)", keywords:"diversity,realization", truncate:"", weight:2.0, description:"Unity is realized through the acceptance and appreciation of diverse perceptions.<SEP>Unity is realized through the acceptance and appreciation of diverse perceptions.", created_at:1779534743, source_id:"chunk-817243e49afe8b11df3c2d2ea2541519"}}, {start: {_id:5820}, end: {_id:707}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)<SEP>unknown_source", truncate:"", keywords:"distortion,interpretation,multiplicity,reality", weight:3.0, description:"Truth is perceived through varied perspectives, illustrating the interplay between singular truth and diverse viewpoints.<SEP>Truth is perceived through varied perspectives, illustrating the interplay between singular truth and diverse viewpoints.<SEP>Stuck perceptions obscure truth, hindering accurate reality interpretation.", created_at:1779565492, source_id:"chunk-817243e49afe8b11df3c2d2ea2541519<SEP>chunk-3f2351d7bbf12ee7e6a879305b4fddf7"}}, {start: {_id:5829}, end: {_id:5825}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)", truncate:"", keywords:"equity,inclusion", weight:1.0, description:"Women are urged to be actively included in decision-making processes for societal progress.", created