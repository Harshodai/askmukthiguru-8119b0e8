UNWIND [{start: {_id:866}, end: {_id:867}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conceptual identity,metaphor", truncate:"", weight:1.0, description:"Shared Connection is metaphorically referred to as the Elixir of Life.", created_at:1779140274, source_id:"chunk-c219578ff4da1678ae1ff2890bf677ec"}}, {start: {_id:870}, end: {_id:466}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"conceptual relationship,emotional state", weight:1.0, description:"Self-Acceptance leads to acceptance in relationships, allowing for genuine connection and mutual respect.", created_at:1779140274, source_id:"chunk-c219578ff4da1678ae1ff2890bf677ec"}}, {start: {_id:866}, end: {_id:863}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional state,personal experience", truncate:"", weight:1.0, description:"Our Daughter's experience of the Elixir of Life involves feeling at home and having her heart opened by teachers' care.", created_at:1779140274, source_id:"chunk-c219578ff4da1678ae1ff2890bf677ec"}}, {start: {_id:875}, end: {_id:877}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"companionship,companionship exchange,quest,transformation", weight:2.0, description:"The frog agrees to retrieve the princess?s golden ball in exchange for her companionship, leading to his transformation into a prince.<SEP>The princess and talking frog form a pact where the frog helps her find her golden ball.", created_at:1779141731, source_id:"chunk-a6d5fb2d9a6f95d89ee353ec0e3d3252<SEP>chunk-828fe791bfee22158562b2e56c06c719"}}, {start: {_id:874}, end: {_id:872}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cultural symbolism,story inclusion", truncate:"", weight:1.0, description:"?The Frog Prince? is part of the Grimms? Fairy Tales and carries themes of hidden identity and love.", created_at:1779140304, source_id:"chunk-a6d5fb2d9a6f95d89ee353ec0e3d3252"}}, {start: {_id:878}, end: {_id:875}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"identity revelation,romantic tension", truncate:"", weight:1.0, description:"The princess initially dismisses the frog but later recognizes him as the prince after his transformation.", created_at:1779140304, source_id:"chunk-a6d5fb2d9a6f95d89ee353ec0e3d3252"}}, {start: {_id:873}, end: {_id:872}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"adaptation,media representation", truncate:"", weight:1.0, description:"Disney?s version popularized the tale with a modern cinematic interpretation.", created_at:1779140304, source_id:"chunk-a6d5fb2d9a6f95d89ee353ec0e3d3252"}}, {start: {_id:873}, end: {_id:880}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"adaptation,cast member,feature,media representation", truncate:"", weight:2.0, description:"Oprah Winfrey is featured in Disney's animated adaptation of \"The Frog Prince.\"<SEP>Oprah Winfrey was featured in Disney's adaptation of \"The Frog Prince.\"", created_at:1779141731, source_id:"chunk-a6d5fb2d9a6f95d89ee353ec0e3d3252<SEP>chunk-828fe791bfee22158562b2e56c06c719"}}, {start: {_id:871}, end: {_id:872}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"literary reinterpretation,thematic exploration", weight:1.0, description:"Sexton?s poetry reimagines the tale through a feminist and psychological lens.", created_at:1779140304, source_id:"chunk-a6d5fb2d9a6f95d89ee353ec0e3d3252"}}, {start: {_id:878}, end: {_id:877}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"identity shift,transformation", truncate:"", weight:1.0, description:"The frog?s physical and social transformation underscores the tale?s central theme of hidden nobility.", created_at:1779140304, source_id:"chunk-a6d5fb2d9a6f95d89ee353ec0e3d3252"}}, {start: {_id:879}, end: {_id:875}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"loss and recovery,narrative catalyst", truncate:"", weight:1.0, description:"The golden ball?s loss drives the story?s plot and the princess?s interaction with the frog.", created_at:1779140304, source_id:"chunk-a6d5fb2d9a6f95d89ee353ec0e3d3252"}}, {start: {_id:876}, end: {_id:872}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"analysis,mythological study,symbolism,symbolism analysis", weight:2.0, description:"Campbell examined the tale?s archetypal themes of transformation and self-discovery.<SEP>Joseph Campbell analyzed the symbolism and mythological themes in \"The Frog Prince.\"", created_at:1779141731, source_id:"chunk-a6d5fb2d9a6f95d89ee353ec0e3d3252<SEP>chunk-828fe791bfee22158562b2e56c06c719"}}, {start: {_id:888}, end: {_id:889}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"idealism,reality", truncate:"", weight:1.0, description:"The contrast between dreams of love and the nightmare of relationship failure is explored in the story.", created_at:1779140334, source_id:"chunk-bc8e5c6e2903c7efd30d7faf6ff8221b"}}, {start: {_id:225}, end: {_id:886}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"affiliation,education,mentorship,student", truncate:"", weight:2.0, description:"Moon is a student of the academy, which shapes her perspectives on relationships and self-reflection.<SEP>Moon is a student at the academy, where she reflects on her relationship struggles.", created_at:1779186082, source_id:"chunk-bc8e5c6e2903c7efd30d7faf6ff8221b<SEP>chunk-3371fee7dc2e5f20ad27eaf69ba00c32"}}, {start: {_id:380}, end: {_id:887}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"narrative,self-reflection", truncate:"", weight:1.0, description:"The story addresses the need to challenge old thought patterns and embrace deeper truths.", created_at:1779140334, source_id:"chunk-bc8e5c6e2903c7efd30d7faf6ff8221b"}}, {start: {_id:885}, end: {_id:882}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"stress,workload", truncate:"", weight:1.0, description:"The hectic week includes Moon's yoga classes, contributing to her stress and lack of respite.", created_at:1779140334, source_id:"chunk-bc8e5c6e2903c7efd30d7faf6ff8221b"}}, {start: {_id:885}, end: {_id:883}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"overwhelm,responsibilities", truncate:"", weight:1.0, description:"The hectic week includes personal work that Moon must catch up on, adding to her overwhelm.", created_at:1779140334, source_id:"chunk-bc8e5c6e2903c7efd30d7faf6ff8221b"}}, {start: {_id:380}, end: {_id:707}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"insight,transformation", truncate:"", weight:1.0, description:"The story serves as a vehicle to uncover deeper truths and transform perspectives on relationships.", created_at:1779140334, source_id:"chunk-bc8e5c6e2903c7efd30d7faf6ff8221b"}}, {start: {_id:886}, end: {_id:882}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"physical resilience,responsibility,routine,teaching", truncate:"", weight:2.0, description:"Moon teaches yoga classes as part of her professional commitments during the hectic week.<SEP>Moon's yoga practice helps her recover physically after the accident.", created_at:1779186083, source_id:"chunk-bc8e5c6e2903c7efd30d7faf6ff8221b<SEP>chunk-3371fee7dc2e5f20ad27eaf69ba00c32"}}, {start: {_id:886}, end: {_id:543}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"dissatisfaction,involvement", truncate:"", weight:1.0, description:"Moon is involved in a relationship with her boyfriend but becomes dissatisfied due to perceived flaws.", created_at:1779140334, source_id:"chunk-bc8e5c6e2903c7efd30d7faf6ff8221b"}}] AS row
