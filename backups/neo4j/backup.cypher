UNWIND [{start: {_id:5319}, end: {_id:1782}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"collaborative idealism,shared vision", weight:1.0, description:"Prithais and the speaker jointly envision human awakening and oneness.", created_at:1779453507, source_id:"chunk-1756c3e8d7e9eefbffb3f49a179b77fc"}}, {start: {_id:5328}, end: {_id:1782}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"existential purpose,philosophical framework", weight:1.0, description:"The speaker redefines human purpose through the concept of awakening.", created_at:1779453507, source_id:"chunk-1756c3e8d7e9eefbffb3f49a179b77fc"}}, {start: {_id:5341}, end: {_id:5330}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"conceptual correction,redundancy", weight:1.0, description:"The original mention of \"judgments\" was corrected to \"true state of oneness,\" creating redundancy in the final version.", created_at:1779453599, source_id:"chunk-063bbfb5769dde09e2cc6d99540be5c3"}}, {start: {_id:5330}, end: {_id:348}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"content focus,philosophical theme", weight:1.0, description:"The video discusses the philosophical concept of \"true state of oneness\" as its central theme.", created_at:1779453599, source_id:"chunk-063bbfb5769dde09e2cc6d99540be5c3"}}, {start: {_id:5342}, end: {_id:348}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"attribution,content source", weight:2.0, description:"The YouTube video hosts content attributed to the original author, which is being analyzed and corrected.<SEP>The YouTube video hosts content attributed to the original author, which is being analyzed and corrected.", created_at:1779453877, source_id:"chunk-bf775281b0e0ffbc9e43851a7fa22924"}}, {start: {_id:5343}, end: {_id:5330}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"conceptual alignment", truncate:"", weight:2.0, description:"The corrected sentence explicitly incorporates the concept of \"true state of oneness.\"<SEP>The corrected sentence explicitly incorporates the concept of \"true state of oneness.\"", created_at:1779453878, source_id:"chunk-bf775281b0e0ffbc9e43851a7fa22924"}}, {start: {_id:2144}, end: {_id:4655}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"contextual shift,lexical error", weight:2.0, description:"The original text mentions \"peace festival,\" later revised to \"peace\" in corrections.<SEP>The original text mentions \"peace festival,\" later revised to \"peace\" in corrections.", created_at:1779453878, source_id:"chunk-bf775281b0e0ffbc9e43851a7fa22924"}}, {start: {_id:1647}, end: {_id:1500}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"correction,replacement", truncate:"", weight:1.0, description:"Festival was replaced by Limitless Field in the text to correct terminology.", created_at:1779453841, source_id:"chunk-c7631ad5e3d35c705d34d256a37100ba"}}, {start: {_id:5329}, end: {_id:5315}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"achievement,state", weight:1.0, description:"Enlightened human beings achieve extraordinary peace.", created_at:1779454017, source_id:"chunk-d319e7ca1c821b8d3953f9189c7b08fd"}}, {start: {_id:5319}, end: {_id:348}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"Content,vision", weight:1.0, description:"The video content includes a vision shared by Prithais.", created_at:1779454017, source_id:"chunk-d319e7ca1c821b8d3953f9189c7b08fd"}}, {start: {_id:5315}, end: {_id:5344}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"addressing,solution", truncate:"", weight:1.0, description:"Extraordinary peace is presented as a solution to world's problems.", created_at:1779454017, source_id:"chunk-d319e7ca1c821b8d3953f9189c7b08fd"}}, {start: {_id:5329}, end: {_id:348}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"content,discussion", truncate:"", weight:1.0, description:"The video discusses enlightened human beings.", created_at:1779454017, source_id:"chunk-d319e7ca1c821b8d3953f9189c7b08fd"}}, {start: {_id:5344}, end: {_id:348}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"content,discussion", truncate:"", weight:1.0, description:"The video discusses world's problems.", created_at:1779454017, source_id:"chunk-d319e7ca1c821b8d3953f9189c7b08fd"}}, {start: {_id:5315}, end: {_id:348}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"content,discussion", truncate:"", weight:1.0, description:"The video discusses extraordinary peace.", created_at:1779454017, source_id:"chunk-d319e7ca1c821b8d3953f9189c7b08fd"}}, {start: {_id:5328}, end: {_id:348}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"content,discussion", truncate:"", weight:1.0, description:"The video discusses the concept of awakened human beings.", created_at:1779454018, source_id:"chunk-d319e7ca1c821b8d3953f9189c7b08fd"}}, {start: {_id:5347}, end: {_id:5350}, properties:{file_path:"unknown_source", truncate:"", keywords:"conflict resolution,prevention,social harmony,societal harmony", weight:2.0, description:"Collective peace prevents the emergence of egoistic leaders by fostering unity and understanding.<SEP>Collective peace prevents the emergence of egoistic leaders and fosters global harmony.`", created_at:1779455328, source_id:"chunk-4b54aa8a9252857e691b1304a2061fad<SEP>chunk-c31c96b585957b3d969c1f44467db292"}}, {start: {_id:2582}, end: {_id:1782}, properties:{file_path:"unknown_source", keywords:"contrast,mental vs. physical threat", truncate:"", weight:1.0, description:"The speaker contrasts hiding from COVID with confronting the more dangerous \"mental infection of violence.\"", created_at:1779455328, source_id:"chunk-c1d8dd3f6ee4794537974077b8f6d5c9"}}, {start: {_id:5346}, end: {_id:1782}, properties:{file_path:"unknown_source", keywords:"collective healing,violence", truncate:"", weight:1.0, description:"The speaker identifies the mental infection of violence as the root cause of global conflicts, urging spiritual awakening to heal it.", created_at:1779455328, source_id:"chunk-c1d8dd3f6ee4794537974077b8f6d5c9"}}, {start: {_id:430}, end: {_id:1782}, properties:{file_path:"unknown_source", keywords:"action,purity", truncate:"", weight:1.0, description:"Childhood is redefined as purity of soul, encouraging actions like making children smile to manifest inner solutions.", created_at:1779455329, source_id:"chunk-c1d8dd3f6ee4794537974077b8f6d5c9"}}, {start: {_id:2391}, end: {_id:3720}, properties:{file_path:"unknown_source", keywords:"guidance,liberation,spiritual goal,spiritual path", truncate:"", weight:2.0, description:"Mukthi is framed as the ultimate spiritual awakening to transcend individualism.`<SEP>Mukthi is the path leading to enlightenment through self-realization.", created_at:1779556412, source_id:"chunk-4b54aa8a9252857e691b1304a2061fad<SEP>chunk-5c1ed637dca2d0d131d85c8ff4dd33cb"}}] AS row
