UNWIND [{start: {_id:1688}, end: {_id:1692}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"detoxification,method classification", weight:1.0, description:"Water fasting aids purification and self-healing through complete dietary abstinence.", created_at:1779148037, source_id:"chunk-5f95b172448640801fae7c555ba54742"}}, {start: {_id:1688}, end: {_id:1690}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"method classification,nutritional balance", weight:1.0, description:"Soup fasting maintains minimal nutrition during fasting periods.", created_at:1779148037, source_id:"chunk-5f95b172448640801fae7c555ba54742"}}, {start: {_id:1696}, end: {_id:1688}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"biological instinct,biological response,instinctive behavior,self-healing", weight:2.0, description:"Fasting is a natural behavior in animals for recovery and health preservation.<SEP>Animals fast instinctively during illness.", created_at:1779148146, source_id:"chunk-5f95b172448640801fae7c555ba54742<SEP>chunk-8beba43872c2a4b73d69ad70815212d9"}}, {start: {_id:1695}, end: {_id:1700}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", keywords:"immunity,protein intake", truncate:"", weight:1.0, description:"Proper protein consumption supports antibody production (globulins) for enhanced immunity.", created_at:1779148063, source_id:"chunk-2a50761feb8fad8d98aa8399b70c426c"}}, {start: {_id:1699}, end: {_id:1681}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"manifestation,speech power", weight:1.0, description:"Avoiding negative speech enhances vak shakti, the power to manifest goals through conscious communication.", created_at:1779148063, source_id:"chunk-2a50761feb8fad8d98aa8399b70c426c"}}, {start: {_id:1701}, end: {_id:1698}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"cellular function,metaphor", weight:1.0, description:"The practice compares cellular energy consumption to an engine's heat and burn rate.", created_at:1779148063, source_id:"chunk-2a50761feb8fad8d98aa8399b70c426c"}}, {start: {_id:1697}, end: {_id:1702}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", keywords:"mindfulness,practice", truncate:"", weight:1.0, description:"Fasting movement involves sitting still to reduce physical and mental restlessness through focused observation.", created_at:1779148063, source_id:"chunk-2a50761feb8fad8d98aa8399b70c426c"}}, {start: {_id:1704}, end: {_id:1705}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"category,practice", weight:1.0, description:"Langanam of Fasting is one of the four langanas (plural form) outlined as a spiritual practice.", created_at:1779148083, source_id:"chunk-29914f29d90ea749173faf5f8e44e499"}}, {start: {_id:1703}, end: {_id:1681}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"conceptual link", weight:1.0, description:"Vak Shakti is acknowledged as a valid concept within the context of spiritual power cultivation.", created_at:1779148083, source_id:"chunk-29914f29d90ea749173faf5f8e44e499"}}, {start: {_id:1705}, end: {_id:1703}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"cause,effect", weight:1.0, description:"Practicing the four langanas leads to experiencing power in the body, mind, and consciousness.", created_at:1779148084, source_id:"chunk-29914f29d90ea749173faf5f8e44e499"}}, {start: {_id:1705}, end: {_id:1708}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"health practices,holistic well-being", weight:1.0, description:"Lankanas are practices aimed at achieving mental, emotional, spiritual, and physical health.", created_at:1779148103, source_id:"chunk-69914c3739a9945b1b33a3476b78c932"}}, {start: {_id:1709}, end: {_id:1705}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"health framework,structured practices", weight:1.0, description:"Four Langanams are part of the broader concept of langanas for holistic health.", created_at:1779148103, source_id:"chunk-69914c3739a9945b1b33a3476b78c932"}}, {start: {_id:1688}, end: {_id:1708}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"health intervention,holistic approach", weight:1.0, description:"Fasting is presented as a method to address all four aspects of health simultaneously.", created_at:1779148103, source_id:"chunk-69914c3739a9945b1b33a3476b78c932"}}, {start: {_id:1672}, end: {_id:1709}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"dietary component,health practice", weight:1.0, description:"Fasting food is a component of the four langanams health practices.", created_at:1779148124, source_id:"chunk-b7b52be74b8fe2742a9e4d6ec70ae0ec"}}, {start: {_id:1711}, end: {_id:1710}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"health risk,negative outcome", weight:1.0, description:"Infections are a negative outcome of improper eating.", created_at:1779148124, source_id:"chunk-b7b52be74b8fe2742a9e4d6ec70ae0ec"}}, {start: {_id:1694}, end: {_id:1672}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"dietary practice,eating timing", weight:1.0, description:"Fasting food is linked to eating when the digestive fire is active.", created_at:1779148124, source_id:"chunk-b7b52be74b8fe2742a9e4d6ec70ae0ec"}}, {start: {_id:1709}, end: {_id:1712}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"conceptual framework,health advice", weight:1.0, description:"The four langanams provide a framework for health guidelines.", created_at:1779148124, source_id:"chunk-b7b52be74b8fe2742a9e4d6ec70ae0ec"}}, {start: {_id:1694}, end: {_id:1712}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"eating rules,physiological basis", weight:1.0, description:"Digestive fire dictates the physiological basis for eating rules.", created_at:1779148124, source_id:"chunk-b7b52be74b8fe2742a9e4d6ec70ae0ec"}}, {start: {_id:1673}, end: {_id:1677}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"biological function,equivalence", weight:1.0, description:"Immunoglobulins are a type of antibodies.", created_at:1779148146, source_id:"chunk-8beba43872c2a4b73d69ad70815212d9"}}, {start: {_id:1674}, end: {_id:1713}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"definition,fasting practice", weight:1.0, description:"Langanam is a specific type of fasting breath practice.", created_at:1779148146, source_id:"chunk-8beba43872c2a4b73d69ad70815212d9"}}] AS row
