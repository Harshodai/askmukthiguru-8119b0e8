UNWIND [{start: {_id:3047}, end: {_id:287}, properties:{file_path:"unknown_source", keywords:"characteristics,variability", truncate:"", weight:1.0, description:"Life is described as a river with varying characteristics and experiences.", created_at:1779188522, source_id:"chunk-a3a9654c6c8f7858ec4d287082297caa"}}, {start: {_id:453}, end: {_id:3047}, properties:{file_path:"unknown_source", keywords:"consequence,effect", truncate:"", weight:1.0, description:"Bias leads to the door of abundance being shut.", created_at:1779188522, source_id:"chunk-a3a9654c6c8f7858ec4d287082297caa"}}, {start: {_id:3105}, end: {_id:3104}, properties:{file_path:"unknown_source", keywords:"interaction,relationship", truncate:"", weight:1.0, description:"Shiva calms his angry wife and causes her ecstasy.", created_at:1779188671, source_id:"chunk-b853208a5b22b10c406741d9e385f987"}}, {start: {_id:3107}, end: {_id:3104}, properties:{file_path:"unknown_source", keywords:"conflict,relationship,spiritual mastery,transcendence", truncate:"", weight:2.0, description:"Shiva can vanquish asuras, leading to him running from them to save his life.<SEP>Shiva's enlightenment neutralizes the chaotic energy of Asuras, representing the triumph of equanimity.", created_at:1779553627, source_id:"chunk-b853208a5b22b10c406741d9e385f987<SEP>chunk-3e6f8e85a056a83c6e414cc14c74ff99"}}, {start: {_id:3108}, end: {_id:3104}, properties:{file_path:"unknown_source", keywords:"location,relationship", truncate:"", weight:1.0, description:"Shiva is found wandering as a madman.", created_at:1779188671, source_id:"chunk-b853208a5b22b10c406741d9e385f987"}}, {start: {_id:3109}, end: {_id:3104}, properties:{file_path:"unknown_source", truncate:"", keywords:"location,relationship,spiritual presence", weight:2.0, description:"Shiva is associated with crematoriums, reflecting themes of detachment and transcendence.<SEP>Shiva is found in crematoriums.", created_at:1779188672, source_id:"chunk-b853208a5b22b10c406741d9e385f987<SEP>chunk-559ccba6f58d0c12370fddf8d40ee4db"}}, {start: {_id:3104}, end: {_id:3106}, properties:{file_path:"unknown_source", truncate:"", keywords:"location,relationship,spiritual manifestation", weight:2.0, description:"Snow Peaks are settings where Shiva's enlightened nature is symbolically represented.<SEP>Shiva is found in snow peaks.", created_at:1779188672, source_id:"chunk-b853208a5b22b10c406741d9e385f987<SEP>chunk-559ccba6f58d0c12370fddf8d40ee4db"}}, {start: {_id:3111}, end: {_id:3110}, properties:{file_path:"unknown_source", keywords:"celebration,divine embodiment", truncate:"", weight:1.0, description:"Shivaratri celebrates Shiva's cosmic divine nature and the potential for enlightenment in all beings.", created_at:1779188672, source_id:"chunk-559ccba6f58d0c12370fddf8d40ee4db"}}, {start: {_id:3104}, end: {_id:3110}, properties:{file_path:"unknown_source", keywords:"celebration,enlightenment,enlightenment potential", truncate:"", weight:3.0, description:"Shivaratri celebrates the potential for enlightenment and liberation, as embodied by Shiva.<SEP>Shivaratri is a celebration of Shiva.<SEP>Shivaratri commemorates Shiva's cosmic divinity and the potential for enlightenment in all beings.", created_at:1779553628, source_id:"chunk-b853208a5b22b10c406741d9e385f987<SEP>chunk-70130dcd7ab630cc78d7d9b5f69f4f36<SEP>chunk-3e6f8e85a056a83c6e414cc14c74ff99"}}, {start: {_id:3112}, end: {_id:3104}, properties:{file_path:"unknown_source", truncate:"", keywords:"deity,key deity,pantheon affiliation,pantheon membership", weight:2.0, description:"Shiva is a central deity in the Hindu Pantheon, representing cosmic principles and enlightenment.<SEP>Shiva is a central deity in the Hindu Pantheon, embodying cosmic principles.", created_at:1779188672, source_id:"chunk-559ccba6f58d0c12370fddf8d40ee4db<SEP>chunk-70130dcd7ab630cc78d7d9b5f69f4f36"}}, {start: {_id:3113}, end: {_id:3104}, properties:{file_path:"unknown_source<SEP>YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"cosmic balance,divine partnership,divine union,life and death,marriage,unity", truncate:"", weight:3.0, created_at:1779553627, description:"Shiva and Shakti are depicted as complementary forces representing consciousness and energy.<SEP>Shiva (death) and Shakti (life) symbolize the inseparable duality of existence, representing the eternal cycle of destruction and creation.<SEP>Shiva (destruction) and Shakti (creation) symbolize the inseparable duality of death and life in the universe.", source_id:"chunk-559ccba6f58d0c12370fddf8d40ee4db<SEP>chunk-d84a2ad7d8a1b6191ff06ebd1365b495<SEP>chunk-3e6f8e85a056a83c6e414cc14c74ff99"}}, {start: {_id:3114}, end: {_id:3104}, properties:{file_path:"unknown_source", truncate:"", keywords:"enlightened consciousness,spiritual mastery,symbol,symbolism", weight:2.0, description:"The poisonous cobra worn by Shiva symbolizes his enlightened state and mastery over mind states.<SEP>The cobra symbolizes Shiva's control over destructive mental states through enlightened awareness.", created_at:1779188672, source_id:"chunk-559ccba6f58d0c12370fddf8d40ee4db<SEP>chunk-70130dcd7ab630cc78d7d9b5f69f4f36"}}, {start: {_id:3115}, end: {_id:3104}, properties:{file_path:"unknown_source<SEP>YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"consciousness,divine embodiment,embodiment,enlightened state,equanimity,rejuvenation,spiritual state,transcendence", truncate:"", weight:4.0, description:"Shiva embodies the concept of enlightened consciousness, transcending worldly dualities.<SEP>Shiva represents an enlightened consciousness, symbolizing spiritual awakening and ultimate knowledge.<SEP>Shiva embodies the shedding of past attachments and the state of eternal present awareness.<SEP>Shiva represents enlightened consciousness, which is characterized by constant rejuvenation and the shedding of old emotional states.", created_at:1779554062, source_id:"chunk-559ccba6f58d0c12370fddf8d40ee4db<SEP>chunk-7d91771cf2490944963bfab1edba7973<SEP>chunk-3e6f8e85a056a83c6e414cc14c74ff99<SEP>chunk-492e2a7d0bab4e9fd6187e7d33317fb3"}}, {start: {_id:3104}, end: {_id:3116}, properties:{file_path:"unknown_source<SEP>YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"mastery,spiritual control,spiritual power", truncate:"", weight:2.0, description:"Shiva demonstrates mastery over vishuddhi, representing control over mental resistance.<SEP>Shiva achieves mastery over Vishuddhi, embodying total surrender to life's flow.", created_at:1779553634, source_id:"chunk-559ccba6f58d0c12370fddf8d40ee4db<SEP>chunk-54918f489339662d08104fe4bc09ec58"}}, {start: {_id:3111}, end: {_id:3104}, properties:{file_path:"unknown_source", keywords:"embodiment,universal presence", truncate:"", weight:1.0, description:"Shiva is depicted as the embodiment of the Cosmic Divine, unifying all existence.", created_at:1779188673, source_id:"chunk-559ccba6f58d0c12370fddf8d40ee4db"}}, {start: {_id:731}, end: {_id:544}, properties:{file_path:"unknown_source", keywords:"meditation,self-awareness", truncate:"", weight:1.0, description:"The man achieved heightened awareness and transformation through the Limitless Field Meditation.", created_at:1779188700, source_id:"chunk-890ca3741fc1ec113b793f3ce221523d"}}, {start: {_id:82}, end: {_id:544}, properties:{file_path:"unknown_source", keywords:"resentment,validation-seeking", truncate:"", weight:1.0, description:"The man's lifelong anger stemmed from his need to prove himself to his deceased father.", created_at:1779188700, source_id:"chunk-890ca3741fc1ec113b793f3ce221523d"}}, {start: {_id:1473}, end: {_id:544}, properties:{file_path:"unknown_source", keywords:"empowerment,self-realization", truncate:"", weight:1.0, description:"The man's transformation revolutionized his thinking and enabled him to create synchronicities.", created_at:1779188700, source_id:"chunk-890ca3741fc1ec113b793f3ce221523d"}}, {start: {_id:3117}, end: {_id:544}, properties:{file_path:"unknown_source", keywords:"financial resolution,reconciliation", truncate:"", weight:1.0, description:"The man's transformation led to the old friend's apology and offer to return money.", created_at:1779188700, source_id:"chunk-890ca3741fc1ec113b793f3ce221523d"}}, {start: {_id:1473}, end: {_id:50}, properties:{file_path:"unknown_source<SEP>YouTube Video: Fn62UQTIMEk (URL: https://www.youtube.com/watch?v=Fn62UQTIMEk)", keywords:"causation,impact,manifestation", truncate:"", weight:2.0, description:"The transformation allowed the man to manifest meaningful coincidences in his life.<SEP>Transformation in consciousness can manifest synchronicities.", created_at:1779522029, source_id:"chunk-890ca3741fc1ec113b793f3ce221523d<SEP>chunk-c7bf6f021740e165e861766b49fe6388"}}] AS row
