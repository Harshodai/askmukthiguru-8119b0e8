UNWIND [{start: {_id:6329}, end: {_id:409}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"emotional influence,generational transmission", weight:1.0, description:"The past includes destructive emotions that influence current emotional states and are transmitted across generations.", created_at:1779558218, source_id:"chunk-9dcd575f5f6aeb9b5b2721f919d303c4"}}, {start: {_id:1716}, end: {_id:6329}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"biological transmission,hereditary", weight:1.0, description:"Destructive emotions can be passed through cells to future generations, as supported by scientific evidence.", created_at:1779558218, source_id:"chunk-9dcd575f5f6aeb9b5b2721f919d303c4"}}, {start: {_id:1716}, end: {_id:409}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"ancestral influence,cellular inheritance", weight:1.0, description:"Ancestral and past-life experiences are biologically transmitted through cells, shaping present emotional states.", created_at:1779558218, source_id:"chunk-9dcd575f5f6aeb9b5b2721f919d303c4"}}, {start: {_id:6289}, end: {_id:6291}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"duality,primordial unity", truncate:"", weight:1.0, description:"Egyptian Culture represented creation through Nu and Now, embodying primordial balance.", created_at:1779558291, source_id:"chunk-15d974d0f7ea61a65c9e59608b247634"}}, {start: {_id:6287}, end: {_id:5992}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"harmony,philosophical duality", weight:1.0, description:"Chinese Culture conceptualized balance through Yin and Yang, rejecting domination hierarchies.", created_at:1779558291, source_id:"chunk-15d974d0f7ea61a65c9e59608b247634"}}, {start: {_id:6288}, end: {_id:6290}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"cosmic duality,equilibrium", weight:1.0, description:"Indian Culture framed existence through Prakriti and Purusha, symbolizing harmonious duality.", created_at:1779558291, source_id:"chunk-15d974d0f7ea61a65c9e59608b247634"}}, {start: {_id:6338}, end: {_id:138}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"existential significance,natural power", weight:1.0, description:"Woman is equated to the Earth and described as an unstoppable force of nature with inherent power and potential.", created_at:1779558291, source_id:"chunk-15d974d0f7ea61a65c9e59608b247634"}}, {start: {_id:123}, end: {_id:138}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"awakening,respect", weight:1.0, description:"Humanity is urged to honor women as essential to societal and spiritual balance, transcending historical hierarchies.", created_at:1779558291, source_id:"chunk-15d974d0f7ea61a65c9e59608b247634"}}, {start: {_id:2006}, end: {_id:6336}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"consciousness dimensions,spiritual", weight:1.0, description:"Women are described as having the potential to embody the Yogini dimension of consciousness.", created_at:1779558304, source_id:"chunk-3ad3e76611e4582ac90a89a367b415de"}}, {start: {_id:4361}, end: {_id:2006}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"consciousness dimensions,transcendental", weight:1.0, description:"Women are described as having the potential to access mystic consciousness through intuition and universal intelligence.", created_at:1779558304, source_id:"chunk-3ad3e76611e4582ac90a89a367b415de"}}, {start: {_id:4361}, end: {_id:5972}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"neurological,spiritual awakening", weight:1.0, description:"The pineal gland's awakening is linked to accessing mystic consciousness and transcendental states.", created_at:1779558304, source_id:"chunk-3ad3e76611e4582ac90a89a367b415de"}}, {start: {_id:6335}, end: {_id:2006}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"consciousness dimensions,maternal", weight:1.0, description:"Women are described as having the potential to embody the Janani (mother) dimension of consciousness.", created_at:1779558304, source_id:"chunk-3ad3e76611e4582ac90a89a367b415de"}}, {start: {_id:6337}, end: {_id:2006}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"consciousness dimensions,relational", weight:1.0, description:"Women are described as having the potential to embody the Dhangini (partner) dimension of consciousness.", created_at:1779558304, source_id:"chunk-3ad3e76611e4582ac90a89a367b415de"}}, {start: {_id:4745}, end: {_id:2006}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"authoritative,consciousness dimensions", weight:1.0, description:"Women are described as having the potential to embody the leader dimension of consciousness.", created_at:1779558304, source_id:"chunk-3ad3e76611e4582ac90a89a367b415de"}}, {start: {_id:5972}, end: {_id:706}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)<SEP>YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"activation,anatomical location,mystical significance,spiritual awakening,spiritual significance", weight:3.0, created_at:1779661875, description:"The pineal gland's activation is described as essential for third eye opening and spiritual guidance.<SEP>The pineal gland is located in the region of the third eye, which is central to mystical experiences.` - OK<SEP>The pineal gland is situated in the third eye region and plays a role in mystical activation.", source_id:"chunk-bdaca57c11a3d551259155ef196cf16d<SEP>chunk-9f245e3153d92a2c38134afd812338bf<SEP>chunk-b787fee503789ccf5420cfc0f4003e6b"}}, {start: {_id:5152}, end: {_id:6339}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"redefinition,suppression", truncate:"", weight:1.0, description:"Historical suppression of women's spiritual potential is challenged by Akam's teachings.", created_at:1779558313, source_id:"chunk-bdaca57c11a3d551259155ef196cf16d"}}, {start: {_id:1803}, end: {_id:3563}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"collaboration,spiritual innovation", weight:1.0, description:"Krishna Ji and Akam jointly disprove gender-based spiritual limitations.", created_at:1779558313, source_id:"chunk-bdaca57c11a3d551259155ef196cf16d"}}, {start: {_id:6335}, end: {_id:1748}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"biological basis,maternal love", weight:1.0, description:"Janani's concept connects to oxytocin's role in nurturing instincts.", created_at:1779558313, source_id:"chunk-bdaca57c11a3d551259155ef196cf16d"}}, {start: {_id:499}, end: {_id:6341}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"conflict,erosion", weight:1.0, description:"Stress and anxiety erode unconditional love, leading to parental judgment instead of nurturing.", created_at:1779558313, source_id:"chunk-bdaca57c11a3d551259155ef196cf16d"}}, {start: {_id:1803}, end: {_id:6340}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"creation,empowerment", truncate:"", weight:1.0, description:"Akam creates women masters who impact global spiritual consciousness.", created_at:1779558313, source_id:"chunk-bdaca57c11a3d551259155ef196cf16d"}}] AS row
