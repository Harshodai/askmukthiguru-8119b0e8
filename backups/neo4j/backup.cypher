UNWIND [{_id:3928, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", entity_type:"concept", truncate:"", description:"Self-help refers to practices aimed at personal improvement and motivation.<SEP>Self-help is framed as a traditional approach focused on motivation and personal improvement, now being redefined in the context of spiritual experiences.<SEP>Self-help is a concept that has evolved to incorporate spirituality, focusing on spiritual experiences rather than traditional motivation or inspiration.<SEP>Self-help is contrasted with spiritual experience, shifting focus from motivation to transcendent truth-seeking.<SEP>Self-Help is mentioned as a concept that has evolved from motivation and inspiration to a focus on spiritual experience.<SEP>Self-help is contrasted with spiritual experience, shifting focus from motivation to truth-seeking.", created_at:1779246208, source_id:"chunk-56f853a0a75bc670e443ac6d80941ce9<SEP>chunk-caa27124110ab8f48fb861e8a2ed482e<SEP>chunk-726187f271aa2043554d659991d39748<SEP>chunk-ec5154bb4ad96ae0dc3ba90ae132dc81<SEP>chunk-99430e4042493d6e8f0a7ec8dfcc1cb3<SEP>chunk-bd96767e11f046d35a62e0d27fa43bb7", entity_id:"Self-Help"}}, {_id:3929, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", entity_type:"location", truncate:"", created_at:1779246320, description:"Antarctica is a continent explicitly mentioned as an exception in the global need for spirituality, indicating its exclusion from the universal spiritual demand.<SEP>Antarctica is one of the continents the speaker excluded from their travels, highlighting its absence in their spiritual journey.<SEP>Antarctica is mentioned as a location the speaker has not traveled to, despite visiting other continents.<SEP>Antarctica is noted as one of the continents the speaker explicitly excluded from their travels.<SEP>Antarctica is a continent excluded from the global need for spirituality observed in other continents.", source_id:"chunk-caa27124110ab8f48fb861e8a2ed482e<SEP>chunk-ec5154bb4ad96ae0dc3ba90ae132dc81<SEP>chunk-99430e4042493d6e8f0a7ec8dfcc1cb3<SEP>chunk-bd96767e11f046d35a62e0d27fa43bb7<SEP>chunk-008bbf59ba9b51b8a40d1545c90b6146", entity_id:"Antarctica"}}, {_id:3930, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", entity_type:"concept", truncate:"", description:"Self-transcendence describes the process of moving beyond personal limitations, central to the definition of spiritual experience in the text.", created_at:1779245893, source_id:"chunk-caa27124110ab8f48fb861e8a2ed482e", entity_id:"Self-Transcendence"}}, {_id:3931, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", entity_type:"concept", truncate:"", description:"Global need signifies widespread demand for spiritual growth across continents, reflecting a universal human aspiration beyond material or geographical constraints.", created_at:1779245893, source_id:"chunk-caa27124110ab8f48fb861e8a2ed482e<SEP>chunk-99430e4042493d6e8f0a7ec8dfcc1cb3", entity_id:"Global Need"}}, {_id:3932, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", entity_type:"location", truncate:"", created_at:1779246320, description:"Africa is a continent noted as an exception in the global spiritual need context, highlighting regional variations in spiritual pursuit.<SEP>Africa is another continent the speaker avoided during their travels, reflecting a deliberate focus on other regions.<SEP>Africa is mentioned as a location the speaker has not traveled to, despite visiting other continents.<SEP>Africa is another continent the speaker avoided during their travels.<SEP>Africa is a continent excluded from the global need for spirituality observed in other continents.", source_id:"chunk-caa27124110ab8f48fb861e8a2ed482e<SEP>chunk-ec5154bb4ad96ae0dc3ba90ae132dc81<SEP>chunk-99430e4042493d6e8f0a7ec8dfcc1cb3<SEP>chunk-bd96767e11f046d35a62e0d27fa43bb7<SEP>chunk-008bbf59ba9b51b8a40d1545c90b6146", entity_id:"Africa"}}, {_id:3933, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", entity_type:"category", truncate:"", description:"Wealth Generation refers to the methods of creating wealth, which the text emphasizes as critically important.", created_at:1779246027, source_id:"chunk-203b5a3ea5b85d8a381ff6db8958a7d3<SEP>chunk-b10ebf50b04723581984202297711043", entity_id:"Wealth Generation"}}, {_id:3934, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", entity_type:"category", truncate:"", description:"Wealth Distribution involves the methods of sharing wealth, mentioned as a key factor in societal thriving.", created_at:1779246027, source_id:"chunk-203b5a3ea5b85d8a381ff6db8958a7d3", entity_id:"Wealth Distribution"}}, {_id:3935, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ZGvKY4mPfIc)", entity_type:"UNKNOWN", truncate:"", description:"Spiritual growth enables the generation of breakthrough ideas.", created_at:1779246027, source_id:"chunk-203b5a3ea5b85d8a381ff6db8958a7d3", entity_id:"Breakthrough Ideas"}}, {_id:3938, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Inclusive consciousness is a state humans must awaken to as part of an inclusive consciousness.", created_at:1779246617, source_id:"chunk-a20cdc5ec963420afa2e1d88b5539cdc<SEP>chunk-5be4ab3ffc3d58a2d8190326819f706c", entity_id:"Inclusive Consciousness"}}, {_id:3939, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=w1gF90_cBl4)", entity_type:"concept", truncate:"", description:"The infinite consciousness is the ocean in which every life form is but a wave of subjective awareness that rises and subsides.<SEP>Infinite consciousness is described as an eternal, all-encompassing entity where all life forms are transient manifestations of subjective awareness, manifesting as the universe through space, time, and energy.", created_at:1779246679, source_id:"chunk-5be4ab3ffc3d58a2d8190326819f706c<SEP>chunk-d55433c844408160c1f2461994f2e753", entity_id:"Infinite Consciousness"}}, {_id:3940, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=w1gF90_cBl4)", entity_type:"concept", truncate:"", description:"Life forms are waves of subjective awareness within the infinite consciousness.<SEP>Life forms are portrayed as transient expressions of subjective awareness within the infinite consciousness, destined to dissolve and re-emerge in different forms.", created_at:1779246679, source_id:"chunk-5be4ab3ffc3d58a2d8190326819f706c<SEP>chunk-d55433c844408160c1f2461994f2e753", entity_id:"Life Form"}}, {_id:3941, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Organizations can be led from either a stressful state or an awakened state.", created_at:1779246618, source_id:"chunk-5be4ab3ffc3d58a2d8190326819f706c", entity_id:"Stressful State, Awakened State"}}, {_id:3942, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=w1gF90_cBl4)", entity_type:"concept", truncate:"", description:"A wave represents the temporary manifestation of consciousness in the form of a life form, arising and subsiding within the eternal ocean of consciousness.", created_at:1779246679, source_id:"chunk-d55433c844408160c1f2461994f2e753", entity_id:"Wave of Subjective Awareness"}}, {_id:3943, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=w1gF90_cBl4)", entity_type:"concept", truncate:"", description:"These are fundamental aspects of consciousness, forming the framework through which the universe manifests and evolves.", created_at:1779246679, source_id:"chunk-d55433c844408160c1f2461994f2e753", entity_id:"Space, Time, and Energy"}}, {_id:3944, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=w1gF90_cBl4)", entity_type:"naturalobject", truncate:"", description:"All natural entities on Earth, including beetles, bees, trees, shrubs, and vines, are unified by a single underlying principle or \"tune.\"", created_at:1779246679, source_id:"chunk-d55433c844408160c1f2461994f2e753", entity_id:"Creations of the Earth"}}, {_id:3945, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=w1gF90_cBl4)<SEP>YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"location", truncate:"", description:"The ocean serves as a metaphor for the vast, eternal nature of infinite consciousness, with life forms likened to waves that arise and subside within it.<SEP>The ocean environment presents challenges such as movement difficulties and food scarcity for orcas.", created_at:1779656774, source_id:"chunk-00283c6d3847e844c97d2dea1db37c97<SEP>chunk-d55433c844408160c1f2461994f2e753<SEP>chunk-335fbb4571ba31c5e62057c887e19129", entity_id:"Ocean"}}, {_id:3946, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=w1gF90_cBl4)", entity_type:"concept", truncate:"", description:"The \"theme song\" symbolizes a universal principle of inclusivity and harmony permeating all creations of the Earth.", created_at:1779246680, source_id:"chunk-d55433c844408160c1f2461994f2e753", entity_id:"Theme Song"}}, {_id:3947, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=GfAMCHC6_ek)", entity_type:"concept", truncate:"", description:"Broken heart syndrome is referenced as a physiological manifestation of heartbreak, involving neural and cardiac effects.<SEP>Broken heart syndrome is a medical condition where heart neurons die and connections are lost due to betrayal.<SEP>A medical condition characterized by the death of neurons in the heart and loss of connections, leading to severe emotional and physiological distress.", created_at:1779247793, source_id:"chunk-f34fb6f27b6128e7888cfaefe712d84a<SEP>chunk-1049ffa49a880db4b5369cf84bcae432<SEP>chunk-4a6a915d04810354808f8de013c1de1f", entity_id:"Broken Heart Syndrome"}}, {_id:3948, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=GfAMCHC6_ek)", entity_type:"concept", truncate:"", description:"Euphoria is a physiological response to love, involving chemical release and brain activation.<SEP>Eu", created_at:1779247593, source_id:"chunk-f34fb6f27b6128e7888cfaefe712d84a<SEP>chunk-9ddc02204a9aadcf3798e7d91145533d", entity_id:"Euphoria"}}, {_id:3949, properties:{file_path:"unknown_source", entity_type:"naturalobject", truncate:"", description:"Chemicals are released in the body during love, contributing to euphoric sensations.", created_at:1779247226, source_id:"chunk-f34fb6f27b6128e7888cfaefe712d84a<SEP>chunk-9ddc02204a9aadcf3798e7d91145533d", entity_id:"Chemicals"}}] AS row
