UNWIND [{start: {_id:254}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"consequences,impact", truncate:"", weight:1.0, description:"Suffering disrupts organizational harmony and productivity.", created_at:1779248746, source_id:"chunk-c9caee3e34754dd743fb5e0f90ac1a6b"}}, {start: {_id:4043}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", truncate:"", keywords:"emotional state,philosophical truth", weight:1.0, description:"Fear contrasts with the truth of oneness.", created_at:1779250688, source_id:"chunk-337cc1942c0c467cad10296df37b0661"}}, {start: {_id:4008}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", truncate:"", keywords:"philosophical concept,unity", weight:1.0, description:"Oneness and interconnectedness are synonymous truths.", created_at:1779250688, source_id:"chunk-337cc1942c0c467cad10296df37b0661"}}, {start: {_id:4177}, end: {name:"Ekam"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", truncate:"", keywords:"affiliation,association", created_at:1779257302, weight:1.0, description:"Deeksha givers are part of Ekam.", source_id:"chunk-e89be378630661d2c676d9886934ef21"}}, {start: {_id:4257}, end: {name:"Mantra"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"ritual guidance,spiritual practice", weight:1.0, description:"The mantra includes the instructional directive to perform dharana as part of the meditative practice.", created_at:1779259855, source_id:"chunk-ff46b53ab89c597d3fb954e4982613d0"}}, {start: {_id:4350}, end: {name:"Suffering"}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", truncate:"", keywords:"cause and effect,causes,differentiation,external challenge,internal-external link,necessity", weight:3.0, created_at:1779264113, description:"The economic problem triggers suffering through anxiety and panic in individuals.<SEP>Economic problems can lead to suffering through anxiety and panic.<SEP>Problems are distinguished from suffering, emphasizing that problems need not lead to prolonged suffering.", source_id:"chunk-956d12a94e0e0bb6b9859844aca052b9<SEP>chunk-4a88b9900bf621d698b72b33414ac811<SEP>chunk-28a9278165fe13a505446b814c02e9dc"}}, {start: {_id:2376}, end: {name:"Suffering"}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", keywords:"alleviation,anxiety resolution,emotional regulation,practice,remedy,suffering dissolution", truncate:"", weight:3.0, created_at:1779264668, description:"The serene mind practice is recommended to dissolve suffering and find solutions.<SEP>The practice is recommended to dissolve suffering and cut through problems.<SEP>Serene mind practice dissolves suffering by addressing anxiety.", source_id:"chunk-956d12a94e0e0bb6b9859844aca052b9<SEP>chunk-0de990c9c98448c49e9565dc513c171a<SEP>chunk-e7c9f032dc546ceb8596a807018125ca"}}, {start: {_id:496}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)<SEP>unknown_source", truncate:"", keywords:"amplification,components,emotional cycle,internal experience,internal state,manifestation", created_at:1779524103, weight:7.0, description:"Anxiety is a component of suffering.<SEP>Anxiety is a manifestation of suffering, an internal experience.<SEP>Suffering creates heightened anxiety through cyclical negative reinforcement.", source_id:"chunk-4a88b9900bf621d698b72b33414ac811<SEP>chunk-f84d092d5f110856868650619246d106<SEP>chunk-e32359164f62f64b8a0367195694bf0f"}}, {start: {_id:174}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", truncate:"", keywords:"components,internal experience", created_at:1779263867, weight:1.0, description:"Panic is a component of suffering.", source_id:"chunk-4a88b9900bf621d698b72b33414ac811"}}, {start: {_id:4358}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", keywords:"resolution,transformation", truncate:"", weight:1.0, description:"Dissolving suffering leads to inner stillness.", created_at:1779263867, source_id:"chunk-4a88b9900bf621d698b72b33414ac811"}}, {start: {_id:4438}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"emotional state,foundational", truncate:"", weight:1.0, description:"Suffering is addressed through actions from a deep state of connection.", created_at:1779392911, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0"}}, {start: {_id:916}, end: {name:"Suffering"}, properties:{file_path:"unknown_source<SEP>YouTube Video: pTnZt0SqDFM (URL: https://www.youtube.com/watch?v=pTnZt0SqDFM)", keywords:"negative,state of being,symptoms", truncate:"", weight:2.0, description:"Pain is a form of suffering that can be mitigated.<SEP>Suffering includes symptoms like pain, hurt, or anger.", created_at:1779399657, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0<SEP>chunk-82a093ab08d9f314edca90dbf19072fc"}}, {start: {_id:1328}, end: {name:"Suffering State"}, properties:{file_path:"unknown_source<SEP>YouTube Video: zGOKGrTNlk4 (URL: https://www.youtube.com/watch?v=zGOKGrTNlk4)", keywords:"causes,emotional response,escalation,psychological process", truncate:"", weight:2.0, description:"Inner disturbance leads to suffering state if not addressed, causing unconscious buildup of emotional burden.<SEP>Inner disturbance can lead to suffering state if not addressed consciously.", created_at:1779396490, source_id:"chunk-0ddbd4446b0368311d8844f5869734c4<SEP>chunk-28084224d33efa95fcb7e18cd0d14748"}}, {start: {_id:2376}, end: {name:"Suffering State"}, properties:{file_path:"unknown_source<SEP>YouTube Video: zGOKGrTNlk4 (URL: https://www.youtube.com/watch?v=zGOKGrTNlk4)", keywords:"awareness,prevention", truncate:"", weight:2.0, description:"Serene mind practice prevents suffering buildup through conscious attention and awareness.<SEP>Serene mind practice helps prevent suffering buildup through conscious attention.", created_at:1779396490, source_id:"chunk-0ddbd4446b0368311d8844f5869734c4<SEP>chunk-28084224d33efa95fcb7e18cd0d14748"}}, {start: {_id:900}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"causation,social", truncate:"", weight:1.0, description:"Living in suffering results in disconnection from others and life.", created_at:1779399162, source_id:"chunk-8c47a43e466f805ea381f194db0fb072"}}, {start: {_id:4552}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"causation,psychological", truncate:"", weight:1.0, description:"Suffering leads to the development of a sense of separation in individuals.", created_at:1779399162, source_id:"chunk-8c47a43e466f805ea381f194db0fb072"}}, {start: {_id:3720}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: pTnZt0SqDFM (URL: https://www.youtube.com/watch?v=pTnZt0SqDFM)", truncate:"", keywords:"causal relationship,liberation", weight:1.0, description:"Suffering is a cause of separation, which in turn leads to division, and the text suggests that achieving Mukthi is a solution to this cycle.", created_at:1779399359, source_id:"chunk-77a2fc8481ea11ffad7cb8ddb5fb08aa"}}, {start: {_id:1193}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: pTnZt0SqDFM (URL: https://www.youtube.com/watch?v=pTnZt0SqDFM)", truncate:"", keywords:"health,opposing relationship", weight:1.0, description:"Suffering is contrasted with health, as the text discusses creating healthy entities by addressing suffering.", created_at:1779399359, source_id:"chunk-77a2fc8481ea11ffad7cb8ddb5fb08aa"}}, {start: {_id:2207}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: pTnZt0SqDFM (URL: https://www.youtube.com/watch?v=pTnZt0SqDFM)", keywords:"experience,experiencing,suffering", truncate:"", created_at:1779399656, weight:2.0, description:"A human being experiences suffering.<SEP>Human Being experiences suffering and inner disturbance.", source_id:"chunk-13115d12efdf6f06cb94255cf212ccfd<SEP>chunk-82a093ab08d9f314edca90dbf19072fc"}}, {start: {_id:1815}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: pTnZt0SqDFM (URL: https://www.youtube.com/watch?v=pTnZt0SqDFM)", truncate:"", keywords:"causation,suffering", weight:1.0, description:"Actions cause suffering.", created_at:1779399551, source_id:"chunk-13115d12efdf6f06cb94255cf212ccfd"}}] AS row
