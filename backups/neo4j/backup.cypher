f0aea49283824eb9980842a005e9"}}, {start: {_id:5146}, end: {_id:7263}, properties:{file_path:"unknown_source", keywords:"alignment,transcendence", truncate:"", weight:1.0, description:"Consciousness shifts motivation from personal gain to serving universal evolution.", created_at:1779661954, source_id:"chunk-8570f0aea49283824eb9980842a005e9"}}, {start: {_id:7261}, end: {_id:1616}, properties:{file_path:"unknown_source<SEP>YouTube Video: vch9C_hNjGs (URL: https://www.youtube.com/watch?v=vch9C_hNjGs)", keywords:"identity shift,transcendence,transformation", truncate:"", weight:2.0, description:"The egoic self evolves into universal consciousness through awareness.<SEP>The limited self evolves into the cosmic self (Aham Brahman) through conscious awareness, dissolving ego boundaries.", created_at:1779662712, source_id:"chunk-8570f0aea49283824eb9980842a005e9<SEP>chunk-c9bb5b4ae7e13a7674f385925b990906"}}, {start: {_id:2917}, end: {_id:4020}, properties:{file_path:"unknown_source", keywords:"nurturing,sustainability", truncate:"", weight:1.0, description:"Achievements aim to support planetary well-being and ecological balance.", created_at:1779661955, source_id:"chunk-8570f0aea49283824eb9980842a005e9"}}, {start: {_id:7252}, end: {_id:7256}, properties:{file_path:"unknown_source", keywords:"harmony,observation", truncate:"", weight:1.0, description:"Awareness perceives the natural rhythm of existence without resistance or judgment.", created_at:1779661955, source_id:"chunk-8570f0aea49283824eb9980842a005e9"}}, {start: {_id:2100}, end: {_id:7256}, properties:{file_path:"unknown_source", keywords:"metaphor,symbolism", truncate:"", weight:1.0, description:"The eagle soaring above wind currents and gliding effortlessly symbolizes the state of awareness, representing transcendent, effortless action beyond egoic compulsions.", created_at:1779661955, source_id:"chunk-8570f0aea49283824eb9980842a005e9"}}, {start: {_id:2917}, end: {_id:1329}, properties:{file_path:"unknown_source", keywords:"impact,interconnectedness", truncate:"", weight:1.0, description:"Actions ripple through the web, creating cascading effects on all existence.", created_at:1779661955, source_id:"chunk-8570f0aea49283824eb9980842a005e9"}}, {start: {_id:7264}, end: {_id:7260}, properties:{file_path:"unknown_source", keywords:"enabling,surveillance", truncate:"", weight:1.0, description:"Smartphones enable cameras to capture visual data without consent, eroding", created_at:1779661959, source_id:"chunk-ecff7e1995c8cfd62a765753318d7dab"}}, {start: {_id:1654}, end: {_id:7276}, properties:{file_path:"unknown_source<SEP>YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", truncate:"", keywords:"contextual meaning,domain-specific correction,linguistic error,transcription error", weight:2.0, description:"\"Pyram\" is corrected to \"Prana\" based on spiritual context.<SEP>\"Pyram\" is a mishearing of \"Prana\" in the video.", created_at:1779662138, source_id:"chunk-b32e50c1e5924b6f3ca08fb982fe71de<SEP>chunk-ccf8c615204507c39f3ca144b897ce7d"}}, {start: {_id:410}, end: {_id:7266}, properties:{file_path:"unknown_source<SEP>YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", keywords:"erosion,loss,privacy loss,surveillance", truncate:"", weight:2.0, description:"Using Facebook is associated with losing privacy due to constant monitoring and data collection.<SEP>Using Facebook leads to a loss of privacy for its users.", created_at:1779662224, source_id:"chunk-f7a7b6ec5216cd073aa9baeaf426fc77<SEP>chunk-f3cc07a478604197eefad4556e973256"}}] AS row
