d:5939, properties:{file_path:"YouTube Video: utRatnFr-S8 (URL: https://www.youtube.com/watch?v=utRatnFr-S8)<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=4ytgjpow498)", entity_type:"event", truncate:"", description:"The Soul Sync Meditation Challenge is an event that includes stages like Day Three, focusing on mind and breath.<SEP>The Soul Sync Meditation Challenge is a structured program with multiple stages focused on breath and mind awareness.<SEP>The Soul Sync Meditation Challenge is a seven-day program encouraging participants to practice meditation for five minutes daily, with each day focusing on mastering a stage of the Soul Sync technique.<SEP>The Soul Sync Meditation Challenge is a seven-day program encouraging participants to practice meditation for five minutes daily, with each day focusing on mastering a stage of the Soul Sync technique.", created_at:1779734159, source_id:"chunk-6bf0d9823e7e66e0af90c71f7791b765<SEP>chunk-58a607380e83d993d819574f258cb8d8<SEP>chunk-553cd7a1612ef0be55af8c2a1d0c2ae4", entity_id:"Soul Sync Meditation Challenge"}}, {_id:5940, properties:{file_path:"unknown_source", entity_type:"event", truncate:"", description:"The third stage of the Soul Sync Meditation Challenge emphasizes observing breath pauses to enhance thought coherence.", created_at:1779552841, source_id:"chunk-58a607380e83d993d819574f258cb8d8", entity_id:"Third Stage of the Soul Sync"}}, {_id:5941, properties:{file_path:"unknown_source<SEP>YouTube Video: utRatnFr-S8 (URL: https://www.youtube.com/watch?v=utRatnFr-S8)", entity_type:"concept", truncate:"", description:"Counting eight breath cycles during the practice, focusing on the pause between breaths.<SEP>Breath cycles involve eight repetitions of inhaling, observing the breath pause, and exhaling, forming the core of the meditation exercise.<SEP>Breath cycles involve eight repetitions of inhaling, observing the breath pause, and exhaling, forming the core of the meditation exercise.", created_at:1779553350, source_id:"chunk-58a607380e83d993d819574f258cb8d8<SEP>chunk-9e16050d1d7a218aab478a93f783bdbb", entity_id:"Breath Cycles"}}, {_id:5943, properties:{file_path:"YouTube Video: utRatnFr-S8 (URL: https://www.youtube.com/watch?v=utRatnFr-S8)", entity_type:"UNKNOWN", truncate:"", description:"Breath pause is a natural physiological process occurring between inhalation and exhalation.", created_at:1779552843, source_id:"chunk-6bf0d9823e7e66e0af90c71f7791b765", entity_id:"NaturalObject"}}] AS row
