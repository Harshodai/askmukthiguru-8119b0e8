UNWIND [{start: {_id:833}, end: {_id:832}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"connection,experience", truncate:"", weight:1.0, description:"Julie experiences physical pain similar to her boyfriend's chronic pain, leading to empathy and insights.", created_at:1779139990, source_id:"chunk-39c43682e6cddb97cee86565eb8e431d"}}, {start: {_id:832}, end: {_id:834}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"conflict,despair,relationship dynamics,separation,tension", truncate:"", weight:3.0, description:"Hidden issues from Julie and her boyfriend's past surface, creating tension and emotional distance.<SEP>The growing gap between Julie and her boyfriend leads to despair and consideration of breaking up.<SEP>Julie's relationship with her boyfriend deteriorates after her experience at Ekam, revealing hidden issues and leading to a crisis.", created_at:1779186361, source_id:"chunk-39c43682e6cddb97cee86565eb8e431d<SEP>chunk-d46158568d6d67d2d4fe51b282a138b1"}}, {start: {_id:835}, end: {_id:832}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"compassion,partnership,sacrifice,shared future", truncate:"", weight:2.0, description:"Julie resolves to prioritize her boyfriend's well-being over personal pain, challenging her perception of love as inherently sacrificial.<SEP>Julie envisions a future with her boyfriend, emphasizing harmony and mutual growth in their relationship.", created_at:1779140052, source_id:"chunk-0b07a36cd1f063043e90acfc38fefaef<SEP>chunk-e5a28c3bc026d600e209a66303560b8e"}}, {start: {_id:832}, end: {_id:838}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conditioning,realization", truncate:"", weight:1.0, description:"Julie attributes her earlier beliefs about a punishing universe to the sacred secret's revelation of historical conditioning.", created_at:1779140010, source_id:"chunk-0b07a36cd1f063043e90acfc38fefaef"}}, {start: {_id:837}, end: {_id:832}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"belief formation,influence", truncate:"", weight:1.0, description:"Julie's childhood narratives shaped her initial understanding of love as requiring sacrifice and cosmic bargaining.", created_at:1779140010, source_id:"chunk-0b07a36cd1f063043e90acfc38fefaef"}}, {start: {_id:832}, end: {_id:836}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"compassion,spiritual awakening", truncate:"", weight:1.0, description:"Julie connected to the transcendental state of compassion at Ekam, which fundamentally altered her worldview and resolve to avoid cruelty.", created_at:1779140010, source_id:"chunk-0b07a36cd1f063043e90acfc38fefaef"}}, {start: {_id:832}, end: {_id:785}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"compassion,realization,spiritual awakening,understanding", truncate:"", weight:2.0, description:"Julie realizes the benevolence of the universe through the sacred secret of Universal Intelligence.<SEP>Julie connects with universal intelligence at Ekam, leading to a transformation in her perspective and actions.", created_at:1779186361, source_id:"chunk-e5a28c3bc026d600e209a66303560b8e<SEP>chunk-d46158568d6d67d2d4fe51b282a138b1"}}, {start: {_id:179}, end: {_id:832}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"nurturing,self-awareness", truncate:"", weight:1.0, description:"Julie nurtures a deep relationship with her own Inner State, moving beyond superficial positivity.", created_at:1779140052, source_id:"chunk-e5a28c3bc026d600e209a66303560b8e"}}, {start: {_id:839}, end: {_id:785}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"realization,understanding", truncate:"", weight:1.0, description:"Universal Intelligence enables the realization of the universe's Benevolence through self-awareness.", created_at:1779140052, source_id:"chunk-e5a28c3bc026d600e209a66303560b8e"}}, {start: {_id:832}, end: {_id:840}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"application,recourse", truncate:"", weight:1.0, description:"Julie applies the Third Sacred Secret to seek universe support, receiving warmth and connection during insecurity.", created_at:1779140052, source_id:"chunk-e5a28c3bc026d600e209a66303560b8e"}}, {start: {_id:839}, end: {_id:832}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"belief,realization", truncate:"", weight:1.0, description:"Julie internalizes the benevolence of the universe as a result of her self-awareness and understanding of universal intelligence.", created_at:1779140052, source_id:"chunk-e5a28c3bc026d600e209a66303560b8e"}}, {start: {_id:784}, end: {_id:785}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"distribution,presence", truncate:"", weight:1.0, description:"Universal intelligence is present within the human body and distributed across physiological systems like the heart, gut, and spinal cord.", created_at:1779140101, source_id:"chunk-7e2d719adb7748553f200eb42b7b4c3e"}}, {start: {_id:842}, end: {_id:785}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"access,connection", truncate:"", weight:1.0, description:"Letting go of negative states enables connection to universal intelligence and access to its problem-solving power.", created_at:1779140101, source_id:"chunk-7e2d719adb7748553f200eb42b7b4c3e"}}, {start: {_id:784}, end: {_id:844}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"composition,structure", truncate:"", weight:1.0, description:"The human body is composed of sixty elements that form complex biological structures like cells and DNA.", created_at:1779140101, source_id:"chunk-7e2d719adb7748553f200eb42b7b4c3e"}}, {start: {_id:784}, end: {_id:843}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional impact,physiological effect", weight:1.0, description:"Suering states manifest in the human body as desperation and fear, disrupting harmony with universal intelligence.", created_at:1779140101, source_id:"chunk-7e2d719adb7748553f200eb42b7b4c3e"}}, {start: {_id:845}, end: {_id:785}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"alleviation,solutions", truncate:"", weight:1.0, description:"Accessing universal intelligence alleviates feelings of disconnection and provides solutions to life's challenges.", created_at:1779140101, source_id:"chunk-7e2d719adb7748553f200eb42b7b4c3e"}}, {start: {_id:785}, end: {_id:843}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"disconnection,interference", truncate:"", weight:1.0, description:"Suering states disconnect individuals from universal intelligence, preventing access to its problem-solving capabilities.", created_at:1779140101, source_id:"chunk-7e2d719adb7748553f200eb42b7b4c3e"}}, {start: {_id:847}, end: {_id:848}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"historical parallels,spiritual connection", weight:1.0, description:"The text draws parallels between humanity's relationship with universal consciousness and historical cultural expressions of transcendence.", created_at:1779140137, source_id:"chunk-9adf0c9fc04ec5f278c69f868ef4b504"}}, {start: {_id:299}, end: {_id:855}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional connection,relationship guidance", weight:1.0, description:"The book discusses love as a foundation for attracting and maintaining life partners.", created_at:1779140137, source_id:"chunk-9adf0c9fc04ec5f278c69f868ef4b504"}}, {start: {_id:854}, end: {_id:851}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional relief,problem-solving", truncate:"", weight:1.0, description:"The text states that accessing universal intelligence alleviates disconnection and provides solutions to life challenges.", created_at:1779140137, source_id:"chunk-9adf0c9fc04ec5f278c69f868ef4b504"}}] AS row
