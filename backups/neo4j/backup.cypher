UNWIND [{start: {_id:6464}, end: {_id:6462}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"beauty standard,physical suffering", weight:1.0, description:"Girls underwent foot binding to conform to beauty ideals, resulting in immobility and torture.", created_at:1779561539, source_id:"chunk-8809e9b9df76b16743d670ee1736d8d9"}}, {start: {_id:6458}, end: {_id:348}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"source,subject matter", truncate:"", weight:1.0, description:"The video addresses the physical suffering endured by girls during the foot-binding practice.", created_at:1779561539, source_id:"chunk-8809e9b9df76b16743d670ee1736d8d9"}}, {start: {_id:6462}, end: {_id:6458}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"cultural practice,physical cruelty", weight:1.0, description:"Foot binding involved breaking bones and binding feet, causing lifelong torture.", created_at:1779561539, source_id:"chunk-8809e9b9df76b16743d670ee1736d8d9"}}, {start: {_id:6459}, end: {_id:6462}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"body modification,cultural obsession", weight:1.0, description:"The pursuit of the Lotus Foot reflected societal obsession with idealized beauty standards.", created_at:1779561540, source_id:"chunk-8809e9b9df76b16743d670ee1736d8d9"}}, {start: {_id:6463}, end: {_id:6459}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"artistic representation,naturalism", weight:1.0, description:"Da Vinci's paintings depicted women with fuller figures, contrasting extreme beauty norms.", created_at:1779561540, source_id:"chunk-8809e9b9df76b16743d670ee1736d8d9"}}, {start: {_id:6462}, end: {_id:348}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"discussion topic,source", truncate:"", weight:1.0, description:"The YouTube Video provides commentary on the historical practice of foot binding and its cultural implications.", created_at:1779561540, source_id:"chunk-8809e9b9df76b16743d670ee1736d8d9"}}, {start: {_id:6459}, end: {_id:6460}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"artistic portrayal,realism", weight:1.0, description:"Rembrandt's works showed women with rounded features, challenging narrow beauty ideals.", created_at:1779561540, source_id:"chunk-8809e9b9df76b16743d670ee1736d8d9"}}, {start: {_id:6465}, end: {_id:6459}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"body positivity,cultural diversity", weight:1.0, description:"Ajanta paintings depicted diverse, full-bodied representations of beauty, contrasting with restrictive standards.", created_at:1779561540, source_id:"chunk-8809e9b9df76b16743d670ee1736d8d9"}}, {start: {_id:6459}, end: {_id:6466}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"artistic representation,beauty representation,contrast,cultural influence", weight:2.0, description:"The Mona Lisa portrays a more natural, fuller body type compared to the extreme beauty ideals of the era.<SEP>The Mona Lisa symbolizes historical beauty ideals that contrast with modern diversity.", created_at:1779561545, source_id:"chunk-8809e9b9df76b16743d670ee1736d8d9<SEP>chunk-9687f9221e8ea7d2650809521e33cd96"}}, {start: {_id:301}, end: {_id:6472}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"emotional well-being,self-acceptance", weight:1.0, description:"Smiling fosters joy and reduces stress linked to beauty anxiety.", created_at:1779561546, source_id:"chunk-9687f9221e8ea7d2650809521e33cd96"}}, {start: {_id:486}, end: {_id:6473}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"cultural shift,societal change", weight:1.0, description:"India's historical embrace of diverse beauty contrasts with current homogenized standards.", created_at:1779561546, source_id:"chunk-9687f9221e8ea7d2650809521e33cd96"}}, {start: {_id:6468}, end: {_id:6471}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"artistic representation,cultural heritage", weight:1.0, description:"Ajanta's murals celebrate diverse human beauty through ancient art.", created_at:1779561546, source_id:"chunk-9687f9221e8ea7d2650809521e33cd96"}}, {start: {_id:6470}, end: {_id:610}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"mental health,self-perception", weight:1.0, description:"Dissolving body concerns leads to self-awareness and inner peace.", created_at:1779561546, source_id:"chunk-9687f9221e8ea7d2650809521e33cd96"}}, {start: {_id:6467}, end: {_id:6459}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"beauty modifications,societal pressure", weight:1.0, description:"Botox use reflects pressure to conform to narrow beauty ideals.", created_at:1779561546, source_id:"chunk-9687f9221e8ea7d2650809521e33cd96"}}, {start: {_id:1406}, end: {_id:6459}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"mental health impact,psychological effects", weight:1.0, description:"Obsession with ideal beauty correlates with rising depression rates.", created_at:1779561546, source_id:"chunk-9687f9221e8ea7d2650809521e33cd96"}}, {start: {_id:6474}, end: {_id:6476}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"cognitive expansion,playground", weight:1.0, description:"The transformed self is depicted as a space where intelligence can flow freely and creatively.", created_at:1779561560, source_id:"chunk-543b676160d9abe4d6b5b39e255b3f9d"}}, {start: {_id:6470}, end: {_id:6475}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"content focus,self-awareness", weight:1.0, description:"The video addresses body issues as a central theme to explore self-awareness and intellectual awakening.", created_at:1779561560, source_id:"chunk-543b676160d9abe4d6b5b39e255b3f9d"}}, {start: {_id:6429}, end: {_id:6476}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"creative expression,energy flow", weight:1.0, description:"The new self is described as a conduit for creative energy to manifest in life.", created_at:1779561560, source_id:"chunk-543b676160d9abe4d6b5b39e255b3f9d"}}, {start: {_id:6470}, end: {_id:6474}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"awakening,dissolution", truncate:"", weight:1.0, description:"Dissolving body-related resistance is presented as a pathway to accessing great intelligence.", created_at:1779561560, source_id:"chunk-543b676160d9abe4d6b5b39e255b3f9d"}}, {start: {_id:6476}, end: {_id:6477}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"initiation,self-discovery", truncate:"", weight:1.0, description:"The journey begins with confronting body issues to reach the new sense of self.", created_at:1779561560, source_id:"chunk-543b676160d9abe4d6b5b39e255b3f9d"}}] AS row
