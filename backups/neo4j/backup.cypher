 keywords:"contrast,opposition", truncate:"", weight:1.0, description:"Spiritual vision counteracts the shadow of hurt by fostering emotional healing and connection.", created_at:1779142057, source_id:"chunk-dfd063e448fde077331ddbd4cc16008f"}}] AS row
