UNWIND [{start: {_id:646}, end: {_id:506}, properties:{file_path:"unknown_source", keywords:"emotional imbalance,inner conflict", truncate:"", weight:1.0, description:"The destructive self arises from self-obsession, manifesting as hostility toward others.", created_at:1779184161, source_id:"chunk-813e5d6774fbe0673f530d4b67ec6629"}}, {start: {_id:662}, end: {_id:506}, properties:{file_path:"unknown_source", keywords:"apathy,self-sabotage", truncate:"", weight:1.0, description:"The inert self results from self-obsession, leading to passive acceptance of negative circumstances.", created_at:1779184161, source_id:"chunk-813e5d6774fbe0673f530d4b67ec6629"}}, {start: {_id:2866}, end: {_id:506}, properties:{file_path:"unknown_source", keywords:"deflection,denial", truncate:"", weight:1.0, description:"Individuals often deflect self-obsession by blaming external factors for their unhappiness.", created_at:1779184161, source_id:"chunk-813e5d6774fbe0673f530d4b67ec6629"}}, {start: {_id:2864}, end: {_id:713}, properties:{file_path:"unknown_source", keywords:"guidance,mentorship", truncate:"", weight:1.0, description:"Maureen mentors employees at her organization.", created_at:1779184163, source_id:"chunk-246826c01e25761bf87cb37c0f82bbb8"}}, {start: {_id:2865}, end: {_id:732}, properties:{file_path:"unknown_source", keywords:"conflict,division", truncate:"", weight:1.0, description:"Commentary leads to inner critics, which divide and conflict.", created_at:1779184163, source_id:"chunk-246826c01e25761bf87cb37c0f82bbb8"}}, {start: {_id:732}, end: {_id:39}, properties:{file_path:"unknown_source", keywords:"impact,theft", truncate:"", weight:1.0, description:"Inner critics steal joy from individuals.", created_at:1779184163, source_id:"chunk-246826c01e25761bf87cb37c0f82bbb8"}}, {start: {_id:2865}, end: {_id:39}, properties:{file_path:"unknown_source", keywords:"impact,theft", truncate:"", weight:1.0, description:"Commentary steals joy from individuals.", created_at:1779184163, source_id:"chunk-246826c01e25761bf87cb37c0f82bbb8"}}, {start: {_id:753}, end: {_id:732}, properties:{file_path:"unknown_source", keywords:"loss,theft", truncate:"", weight:1.0, description:"Inner critics prevent harmony by stealing joy.", created_at:1779184163, source_id:"chunk-246826c01e25761bf87cb37c0f82bbb8"}}, {start: {_id:2865}, end: {_id:612}, properties:{file_path:"unknown_source", truncate:"", keywords:"conflict,division", weight:1.0, created_at:1779184164, description:"Commentary drives inner war.", source_id:"chunk-246826c01e25761bf87cb37c0f82bbb8"}}, {start: {_id:2865}, end: {_id:753}, properties:{file_path:"unknown_source", keywords:"absence,result", truncate:"", weight:1.0, description:"When commentary is absent, harmony results.", created_at:1779184164, source_id:"chunk-246826c01e25761bf87cb37c0f82bbb8"}}, {start: {_id:2861}, end: {_id:776}, properties:{file_path:"unknown_source", truncate:"", keywords:"character example,destructive behavior", weight:1.0, description:"King Ravana's internal conflict led to destructive behavior despite his virtues, illustrating the impact of self-war.`", created_at:1779184233, source_id:"chunk-3bc441c03c9cd5688b0f20314b1b1b3b"}}, {start: {_id:464}, end: {_id:785}, properties:{file_path:"unknown_source", keywords:"self-awareness,transformation", truncate:"", weight:1.0, description:"The Soul Sync Exercise aims to connect practitioners with universal intelligence for inner harmony.`", created_at:1779184234, source_id:"chunk-3bc441c03c9cd5688b0f20314b1b1b3b"}}, {start: {_id:14}, end: {_id:785}, properties:{file_path:"unknown_source", keywords:"education,liberation", truncate:"", weight:1.0, description:"O&O Academy facilitates liberation through processes that access universal intelligence and release stored memories.`", created_at:1779184234, source_id:"chunk-3bc441c03c9cd5688b0f20314b1b1b3b"}}, {start: {_id:2867}, end: {_id:785}, properties:{file_path:"unknown_source", keywords:"origin,source", truncate:"", weight:1.0, descri