UNWIND [{start: {_id:4163}, end: {_id:4191}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", truncate:"", keywords:"appreciation,joy", weight:1.0, description:"Frontliners are acknowledged for saving lives, and the speaker expresses joy in their actions.", created_at:1779257545, source_id:"chunk-dabe196345271fa16afe7578c3084aea"}}, {start: {_id:4193}, end: {_id:4161}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", keywords:"crisis response,necessity", truncate:"", weight:1.0, description:"The disaster necessitates staying home as a response to the crisis.", created_at:1779257675, source_id:"chunk-4b6ce3c62d77ee2a30eede60a7aa63ac"}}, {start: {_id:4192}, end: {_id:4161}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", truncate:"", keywords:"action,method", weight:1.0, description:"Staying home is the method of helping, involving actions from home.", created_at:1779257675, source_id:"chunk-4b6ce3c62d77ee2a30eede60a7aa63ac"}}, {start: {_id:4192}, end: {_id:4194}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", truncate:"", keywords:"outcome,result", weight:1.0, description:"Helping from home leads to a positive impact, making a world of difference.", created_at:1779257675, source_id:"chunk-4b6ce3c62d77ee2a30eede60a7aa63ac"}}, {start: {_id:4166}, end: {_id:1782}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", keywords:"empathy,encouragement", truncate:"", weight:1.0, description:"The speaker emphasizes supporting healthcare workers and their families emotionally.", created_at:1779257821, source_id:"chunk-50f9429535917e274bee7a3453149639"}}, {start: {_id:4163}, end: {_id:4166}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", truncate:"", keywords:"collective recognition,shared purpose", weight:1.0, description:"Healthcare professionals and frontliners are grouped as essential workers deserving gratitude.", created_at:1779257821, source_id:"chunk-50f9429535917e274bee7a3453149639"}}, {start: {_id:4196}, end: {_id:1782}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", keywords:"advocacy,gratitude", truncate:"", weight:1.0, description:"The speaker advocates thanking doctors and their families for their service.", created_at:1779257821, source_id:"chunk-50f9429535917e274bee7a3453149639"}}, {start: {_id:4195}, end: {_id:1782}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", keywords:"appreciation,solidarity", truncate:"", weight:1.0, description:"Nurses are highlighted as critical workers requiring acknowledgment and support.", created_at:1779257821, source_id:"chunk-50f9429535917e274bee7a3453149639"}}, {start: {_id:4197}, end: {_id:1782}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", truncate:"", keywords:"community outreach,solidarity", weight:1.0, description:"The speaker urges reaching out to hospital staff and their families in the community.", created_at:1779257821, source_id:"chunk-50f9429535917e274bee7a3453149639"}}, {start: {_id:3637}, end: {_id:3512}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", keywords:"discomfort,health impact", truncate:"", weight:1.0, description:"Masks are linked to health issues like sickness and fatigue among medical workers.", created_at:1779257882, source_id:"chunk-1c356513974368f71d2bdbafe2a1f92d"}}, {start: {_id:108}, end: {_id:300}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", truncate:"", keywords:"appreciation,spiritual connection", weight:1.0, description:"Feeling the divine enhances gratitude toward medical workers' efforts.", created_at:1779257882, source_id:"chunk-1c356513974368f71d2bdbafe2a1f92d"}}, {start: {_id:4179}, end: {_id:4178}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", truncate:"", keywords:"exhaustion,work conditions", weight:1.0, description:"Prolonged 18-hour shifts directly contribute to fatigue in healthcare professionals.", created_at:1779257882, source_id:"chunk-1c356513974368f71d2bdbafe2a1f92d"}}, {start: {_id:4182}, end: {_id:4183}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", keywords:"dedication,service", truncate:"", weight:1.0, description:"The medical fraternity is recognized for their selfless service in critical roles.", created_at:1779257883, source_id:"chunk-1c356513974368f71d2bdbafe2a1f92d"}}, {start: {_id:333}, end: {_id:4182}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", keywords:"longing,separation", truncate:"", weight:1.0, description:"Medical workers are separated from their loved ones due to demanding duties.", created_at:1779257883, source_id:"chunk-1c356513974368f71d2bdbafe2a1f92d"}}, {start: {_id:4201}, end: {_id:3753}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"event association,festival association,festival practice,ritual timing", weight:4.0, description:"Upasana is performed during the first three days of Navratri.<SEP>Upasana is performed during the first three days of Navratri.<SEP>Upasana is performed during the first three days of Navratri.<SEP>Upasana is performed during the first three days of Navratri as a spiritual practice.", created_at:1779260128, source_id:"chunk-a348f3e70c609d0d7798352cd61a2781<SEP>chunk-35b63d2ee19735d06397a5b887beddb0<SEP>chunk-5a811ca674072f39c34abb4651e492c5<SEP>chunk-8d66f25e14fdb745367662bcfd5df1bf"}}, {start: {_id:4202}, end: {_id:4203}, properties:{file_path:"YouTube Video: Un