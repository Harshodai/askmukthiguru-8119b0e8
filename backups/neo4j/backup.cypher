UNWIND [{start: {_id:115}, end: {name:"Meditation"}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=uGosHULQQk0)", keywords:"purpose,spiritual growth,transformation", truncate:"", weight:2.0, description:"Meditation is framed as a practice designed to lead practitioners toward the definitive end goal of freedom.<SEP>Meditation is framed as a means to achieve freedom, emphasizing its role in guiding individuals toward liberation.", created_at:1779728543, source_id:"chunk-07cef1cacdb43780b9533bba3a4b7ad2<SEP>chunk-e5a191d0b4c345edce809b4d1989b5be"}}, {start: {_id:5902}, end: {name:"Meditation"}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=uGosHULQQk0)", keywords:"connection,consciousness expansion,interconnectedness,self-awareness", truncate:"", weight:2.0, description:"Meditation expands consciousness to deepen the sense of connection and awareness of life's richness.<SEP>Meditation expands consciousness to enhance feelings of connection and awareness.", created_at:1779728544, source_id:"chunk-07cef1cacdb43780b9533bba3a4b7ad2<SEP>chunk-e5a191d0b4c345edce809b4d1989b5be"}}, {start: {_id:5843}, end: {name:"Meditation"}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=uGosHULQQk0)", truncate:"", keywords:"heart opening,spiritual alignment,universal harmony,universal intelligence", weight:2.0, description:"Meditation helps practitioners tune into the greater intelligence of the universe for universal harmony.<SEP>Meditation opens the heart to tune into the universe's greater intelligence and wisdom.", created_at:1779728544, source_id:"chunk-07cef1cacdb43780b9533bba3a4b7ad2<SEP>chunk-e5a191d0b4c345edce809b4d1989b5be"}}, {start: {_id:8124}, end: {name:"Meditation"}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=uGosHULQQk0)", keywords:"awakening,exist