UNWIND [{start: {_id:1427}, end: {_id:25}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"learning,self-creation", truncate:"", weight:1.0, description:"The curriculum empowers individuals to overcome randomness and create their destiny.", created_at:1779144698, source_id:"chunk-35a211b7f3bf5a88de37f2e6c5d66a39"}}, {start: {_id:1454}, end: {_id:864}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"teaching,transformation", truncate:"", weight:1.0, description:"The Academy employs transformative practices to guide students toward self-discovery and destiny creation.", created_at:1779144720, source_id:"chunk-7769be7ae0544b9b85386becf7e58bed"}}, {start: {_id:1453}, end: {_id:172}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"diversity,origin", truncate:"", weight:1.0, description:"Students come from diverse locations, including South Korea, to seek transformation.", created_at:1779144720, source_id:"chunk-7769be7ae0544b9b85386becf7e58bed"}}, {start: {_id:1452}, end: {_id:172}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"diversity,origin", truncate:"", weight:1.0, description:"Students also originate from Northern California, reflecting the academy's global reach.", created_at:1779144721, source_id:"chunk-7769be7ae0544b9b85386becf7e58bed"}}, {start: {_id:1454}, end: {_id:172}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"empowerment,learning", truncate:"", weight:1.0, description:"The Practices empower students to reframe their perspectives and overcome life challenges.", created_at:1779144721, source_id:"chunk-7769be7ae0544b9b85386becf7e58bed"}}, {start: {_id:1459}, end: {_id:1454}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"exploration,understanding", truncate:"", weight:1.0, description:"The Practices help students explore and understand fundamental life questions.", created_at:1779144721, source_id:"chunk-7769be7ae0544b9b85386becf7e58bed"}}, {start: {_id:1460}, end: {_id:1454}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"clarity,guidance", truncate:"", weight:1.0, description:"The Practices provide clarity for making critical life decisions.", created_at:1779144721, source_id:"chunk-7769be7ae0544b9b85386becf7e58bed"}}, {start: {_id:1458}, end: {_id:1454}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"seeking,transcendence", truncate:"", weight:1.0, description:"The Practices aim to facilitate a direct experience of universal intelligence and the source.", created_at:1779144721, source_id:"chunk-7769be7ae0544b9b85386becf7e58bed"}}, {start: {_id:1454}, end: {_id:1455}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"achievement,fulfillment", truncate:"", weight:1.0, description:"The Practices enable students to attain elusive goals and deeper understanding.", created_at:1779144721, source_id:"chunk-7769be7ae0544b9b85386becf7e58bed"}}, {start: {_id:1463}, end: {_id:1461}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"seeking,spiritual inquiry", truncate:"", weight:1.0, description:"People seek answers from the universal intelligence or the source, which is the subject of their spiritual inquiry.", created_at:1779144760, source_id:"chunk-b82acee7d3be480cf3951b301cba9fd2"}}, {start: {_id:1462}, end: {_id:1461}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"personal perception,subjective experience", weight:1.0, description:"God is a subjective experience, which is a personal perception of the universal intelligence.", created_at:1779144760, source_id:"chunk-b82acee7d3be480cf3951b301cba9fd2"}}, {start: {_id:225}, end: {_id:1461}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"education,spiritual processes", truncate:"", weight:1.0, description:"The Academy provides educational and spiritual processes to help people connect with the universal intelligence.", created_at:1779144760, source_id:"chunk-b82acee7d3be480cf3951b301cba9fd2"}}, {start: {_id:1305}, end: {_id:1466}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional consequences,emotional states,self-engrossment,self-perception", weight:2.0, description:"I-consciousness fosters destructive emotions like anger and fear through self-obsessed thinking.<SEP>I-consciousness manifests through destructive emotional states that narrow self-perception and drive harmful behavior.", created_at:1779144824, source_id:"chunk-35e48385a0a3608b5da5a16afae83eaa<SEP>chunk-c6d1ac7b77c644cdbe0e473d070e10a0"}}, {start: {_id:1468}, end: {_id:1469}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"internal conflict,symbolism", truncate:"", weight:1.0, description:"Mythical wars metaphorically represent the internal consciousness struggle between self and unity.", created_at:1779144810, source_id:"chunk-35e48385a0a3608b5da5a16afae83eaa"}}, {start: {_id:1466}, end: {_id:1470}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"definitional aspect,emotional impact", truncate:"", weight:1.0, description:"Self-obsessed state is synonymous with I-consciousness and its associated destructive tendencies.", created_at:1779144810, source_id:"chunk-35e48385a0a3608b5da5a16afae83eaa"}}, {start: {_id:1466}, end: {_id:25}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"process,transition", truncate:"", weight:1.0, description:"Transformation involves moving from I-consciousness to One-consciousness.", created_at:1779144810, source_id:"chunk-35e48385a0a3608b5da5a16afae83eaa"}}, {start: {_id:1467}, end: {_id:25}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"process,transition", truncate:"", weight:1.0, description:"Transformation results in achieving One-consciousness through internal change.", created_at:1779144810, source_id:"chunk-35e48385a0a3608b5da5a16afae83eaa"}}, {start: {_id:1305}, end: {_id:1467}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"awareness,transcendence", truncate:"", weight:1.0, description:"One-consciousness dissolves destructive states through expanded awareness and interconnectedness.", created_at:1779144824, source_id:"chunk-c6d1ac7b77c644cdbe0e473d070e10a0"}}, {start: {_id:1466}, end: {_id:1472}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"consequences,impulsive actions", truncate:"", weight:1.0, description:"I-consciousness leads to unconscious actions causing pain/loss for self and others.", created_at:1779144824, source_id:"chunk-c6d1ac7b77c644cdbe0e473d070e10a0"}}, {start: {_id:1466}, end: {_id:1467}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"consciousness expansion,enlightenment,evolution,liberation,transformation", truncate:"", weight:3.0, created_at:1779188048, description:"Transitioning from I-consciousness to One-consciousness enables revolutionary consciousness expansion and holistic awareness.<SEP>Moving beyond I-consciousness to One-consciousness liberates individuals from self-centered limitations.<SEP>I-consciousness represents self-obsessed suffering, while One-consciousness signifies liberation and unity. The relationship involves a transformative leap from ego-driven existence to universal connection.", source_id:"chunk-c6d1ac7b77c644cdbe0e473d070e10a0<SEP>chunk-18fa3a7d8837c4f0b21f7ce5e53f50b2<SEP>chunk-07bbbe415fc6ff4eb6e48c047d81efd5"}}] AS row
