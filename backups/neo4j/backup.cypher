UNWIND [{start: {_id:4442}, end: {_id:4443}, properties:{file_path:"unknown_source", keywords:"mutual", truncate:"", weight:2.0, description:"Actions from a state of connection contribute to both the people around and the world.<SEP>Contribution from you to the world benefits the people around you.", created_at:1779392912, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0"}}, {start: {_id:1970}, end: {_id:1329}, properties:{file_path:"unknown_source", keywords:"impact", truncate:"", weight:1.0, description:"Abundance consciousness positively impacts the web of life through actions performed with passion and connection.", created_at:1779392912, source_id:"chunk-9146e187edbee9cdbc50b048c433c6f9"}}, {start: {_id:4444}, end: {_id:4345}, properties:{file_path:"unknown_source", keywords:"negative,state of mind", truncate:"", weight:1.0, description:"Scavenging for love is a negative behavior from a state of scarcity.", created_at:1779392912, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0"}}, {start: {_id:4446}, end: {_id:4445}, properties:{file_path:"unknown_source", keywords:"redundant", truncate:"", weight:2.0, description:"Scavenging for money is a subset of scavenging for wealth.<SEP>Scavenging for wealth and money are redundant actions.", created_at:1779392912, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0"}}, {start: {_id:4440}, end: {_id:4441}, properties:{file_path:"unknown_source", keywords:"comparative", truncate:"", weight:1.0, description:"State of connection is easier when one is in a state of connection.", created_at:1779392912, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0"}}, {start: {_id:3904}, end: {_id:4345}, properties:{file_path:"unknown_source", keywords:"negative,state of mind", truncate:"", weight:1.0, description:"Sense of lack is a result of a space of scarcity.", created_at:1779392912, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0"}}, {start: {_id:1970}, end: {_id:50}, properties:{file_path:"unknown_source<SEP>YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)", keywords:"state and phenomenon,synchronicities", truncate:"", weight:2.0, description:"Abundance consciousness results in experiencing synchronicities, which are meaningful coincidences.<SEP>Abundance consciousness attracts synchronicities, creating a life filled with meaningful coincidences.", created_at:1779393028, source_id:"chunk-9146e187edbee9cdbc50b048c433c6f9<SEP>chunk-407afcc34149e3cdc533c3a522a0ac53"}}, {start: {_id:3904}, end: {_id:4447}, properties:{file_path:"unknown_source", keywords:"negative,state of mind", truncate:"", weight:1.0, description:"Sense of lack prevents thinking about the world at large.", created_at:1779392912, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0"}}, {start: {_id:1970}, end: {_id:4435}, properties:{file_path:"unknown_source<SEP>YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)", keywords:"magic,state and experience", truncate:"", weight:2.0, description:"Abundance consciousness leads to magic, characterized by positive and transformative experiences.<SEP>Abundance consciousness fosters a life imbued with wonder and magical experiences.", created_at:1779393028, source_id:"chunk-9146e187edbee9cdbc50b048c433c6f9<SEP>chunk-407afcc34149e3cdc533c3a522a0ac53"}}, {start: {_id:3904}, end: {_id:4448}, properties:{file_path:"unknown_source", keywords:"negative,state of being", truncate:"", weight:1.0, description:"Void is a state of lack within oneself.", created_at:1779392912, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0"}}, {start: {_id:4435}, end: {_id:50}, properties:{file_path:"unknown_source", keywords:"concept,positive", truncate:"", weight:2.0, description:"Synchronicities are manifestations of magic.<SEP>Magic is found in synchronicities.", created_at:1779392912, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0"}}, {start: {_id:1970}, end: {_id:4448}, properties:{file_path:"unknown_source", keywords:"positive,state of being", trunca