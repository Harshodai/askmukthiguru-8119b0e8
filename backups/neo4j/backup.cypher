source_id:"chunk-edc51a29631077e242d8d4d37a955e71"}}, {start: {_id:4984}, end: {_id:2452}, properties:{file_path:"unknown_source", keywords:"dependence,environmental reliance", truncate:"", weight:1.0, description:"Farmers' harvests depend on natural factors like rainfall and sunshine, which are beyond their control.", created_at:1779422511, source_id:"chunk-edc51a29631077e242d8d4d37a955e71"}}, {start: {_id:4984}, end: {_id:2649}, properties:{file_path:"unknown_source", keywords:"analogy,interdependence", truncate:"", weight:1.0, description:"Wealth creators are compared to farmers, both relying on external forces beyond their control for success.", created_at:1779422511, source_id:"chunk-edc51a29631077e242d8d4d37a955e71"}}, {start: {_id:4986}, end: {_id:4991}, properties:{file_path:"YouTube Video: smrj15-QOAI (URL: https://www.youtube.com/watch?v=smrj15-QOAI)", truncate:"", keywords:"natural process,soil enrichment", weight:1.0, description:"Lightning in the sky generates nitrogen in rhizomes, which enriches the soil.", created_at:1779422630, source_id:"chunk-df99b1aeb565857761c4016fbe632a54"}}, {start: {_id:4990}, end: {_id:4989}, properties:{file_path:"YouTube Video: smrj15-QOAI (URL: https://www.youtube.com/watch?v=smrj15-QOAI)", truncate:"", keywords:"thematic focus,video content", weight:1.0, description:"The video smrj15-QOAI discusses themes of wealth creation, consciousness, and manifesting abundance with a conversational tone.", created_at:1779422630, source_id:"chunk-df99b1aeb565857761c4016fbe632a54"}}, {start: {_id:4988}, end: {_id:2649}, properties:{file_path:"YouTube Video: smrj15-QOAI (URL: https://www.youtube.com/watch?v=smrj15-QOAI)", keywords:"comparison,metaphor", truncate:"", weight:1.0, description:"Wealth creators are metaphorically compared to farmers in India to illustrate wealth generation processes.", created_at:1779422630, source_id:"chunk-df99b1aeb565857761c4016fbe632a54"}}, {start: {_id:4991}, end: {_id:4992}, properties:{file_path:"YouTube Video: smrj15-QOAI (URL: https://www.youtube.com/watch?v=smrj15-QOAI)", truncate:"", keywords:"agricultural benefit,soil enrichment", weight:1.0, description:"Nitrogen in rhizomes leads to soil enrichment, benefiting agriculture.", created_at:1779422630, source_id:"chunk-df99b1aeb565857761c4016fbe632a54"}}, {start: {_id:4988}, end: {_id:4987}, properties:{file_path:"YouTube Video: smrj15-QOAI (URL: https://www.youtube.com/watch?v=smrj15-QOAI)", truncate:"", keywords:"agricultural practice,farming process", weight:1.0, description:"Farmers in India practice selecting seeds, plowing soil, sowing seeds, and waiting for clouds as part of their farming process.", created_at:1779422630, source_id:"chunk-df99b1aeb565857761c4016fbe632a54"}}, {start: {_id:4996}, end: {_id:2452}, properties:{file_path:"YouTube Video: smrj15-QOAI (URL: https://www.youtube.com/watch?v=smrj15-QOAI)", keywords:"dependence,reliance", truncate:"", weight:1.0, description:"The farmer's harvest success depends on natural factors like rain and sun, which are beyond their control.", created_at:1779422652, source_id:"chunk-82e976c6fd6806c5dcffe951e84efd83"}}, {start: {_id:4996}, end: {_id:4993}, properties:{file_path:"YouTube Video: smrj15-QOAI (URL: https://www.youtube.com/watch?v=smrj15-QOAI)", keywords:"comparison,similarity", truncate:"", weight:1.0, description:"Both the farmer and investor face external factors (nature/market conditions) impacting outcomes.", created_at:1779422652, source_id:"chunk-82e976c6fd6806c5dcffe951e84efd83"}}] AS row
