UNWIND [{start: {_id:4205}, end: {_id:3753}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"posture instruction,practice component", weight:1.0, description:"The Upasana involves sitting cross-legged as part of the ritual.", created_at:1779259271, source_id:"chunk-a348f3e70c609d0d7798352cd61a2781"}}, {start: {_id:4200}, end: {_id:4204}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"festival days,timeframe specification", weight:1.0, description:"The first three days of Dashera are also the period for Upasana performance.", created_at:1779259271, source_id:"chunk-a348f3e70c609d0d7798352cd61a2781"}}, {start: {_id:3473}, end: {_id:3753}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"inner space,meditation technique", weight:1.0, description:"The practice involves focusing on the chidakasha (dark space) in front of closed eyes.", created_at:1779259307, source_id:"chunk-35b63d2ee19735d06397a5b887beddb0"}}, {start: {_id:4207}, end: {_id:3753}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"blissful state,spiritual outcome", weight:1.0, description:"The ritual aims to fill practitioners with peace and generosity (sadhananda).", created_at:1779259307, source_id:"chunk-35b63d2ee19735d06397a5b887beddb0"}}, {start: {_id:4208}, end: {_id:3753}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"cosmic role,divine invocation", weight:1.0, description:"The Mother Goddess is invoked as Jagattharini, the nurturer of the universe.", created_at:1779259307, source_id:"chunk-35b63d2ee19735d06397a5b887beddb0"}}, {start: {_id:4210}, end: {_id:3753}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"reverence,ritual invocation", weight:1.0, description:"Trahidu is used to address the divine during the ritual.", created_at:1779259307, source_id:"chunk-35b63d2ee19735d06397a5b887beddb0"}}, {start: {_id:4209}, end: {_id:3753}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"mantra recitation,spiritual sound", weight:1.0, description:"Pree Pree is repeated to enhance spiritual connection during the practice.", created_at:1779259307, source_id:"chunk-35b63d2ee19735d06397a5b887beddb0"}}, {start: {_id:4210}, end: {_id:4235}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", keywords:"mantra,spiritual practice", truncate:"", weight:1.0, description:"Trahidu is used as a mantra in spiritual traditions for its sacred significance.", created_at:1779259538, source_id:"chunk-5a811ca674072f39c34abb4651e492c5"}}, {start: {_id:4234}, end: {_id:4210}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"mantra components,spiritual terms", weight:1.0, description:"Bhakta... terms are part of the mantra or spiritual vocabulary associated with Trahidu.", created_at:1779259539, source_id:"chunk-5a811ca674072f39c34abb4651e492c5"}}, {start: {_id:4236}, end: {_id:3753}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"posture,ritual instruction", weight:1.0, description:"Sit Cross-Legled is part of the Upasana practice as a physical guideline.", created_at:1779259539, source_id:"chunk-5a811ca674072f39c34abb4651e492c5"}}, {start: {_id:4237}, end: {_id:4238}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", keywords:"punctuation correction", truncate:"", weight:1.0, description:"Corrected punctuation in the sentence.", created_at:1779259733, source_id:"chunk-c072e5291bc196493af69ebd61f4717e"}}, {start: {_id:4238}, end: {_id:4239}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", keywords:"punctuation correction", truncate:"", weight:1.0, description:"Corrected punctuation in the sentence.", created_at:1779259733, source_id:"chunk-c072e5291bc196493af69ebd61f4717e"}}, {start: {_id:1993}, end: {_id:4238}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", keywords:"punctuation correction", truncate:"", weight:1.0, description:"Corrected punctuation in the sentence.", created_at:1779259733, source_id:"chunk-c072e5291bc196493af69ebd61f4717e"}}, {start: {_id:2409}, end: {_id:4240}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", keywords:"capitalization fix", truncate:"", weight:1.0, description:"Corrections made to the repetition to ensure consistent capitalization.", created_at:1779259733, source_id:"chunk-c072e5291bc196493af69ebd61f4717e"}}, {start: {_id:4241}, end: {_id:3753}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", keywords:"chanting,ritual component", truncate:"", weight:1.0, description:"Mantra phrases are integral to the Upasana ritual, used for chanting and visualization.", created_at:1779259763, source_id:"chunk-c87bd389c5c5a0aa7ee00af0f32f42e6"}}, {start: {_id:3473}, end: {_id:4241}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"meditation,mental imagery,spiritual practice,visualization focus", weight:2.0, description:"Mantra phrases guide the practitioner to focus on the chidakasha for visualizing the Mother Goddess.<SEP>The mantra phrases are recited to focus the mind on the chidakasha (inner space) during meditation.", created_at:1779259797, source_id:"chunk-c87bd389c5c5a0aa7ee00af0f32f42e6<SEP>chunk-8b24420a54f14344af97a060057521ed"}}, {start: {_id:3473}, end: {_id:4203}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"divine form,visualization target", weight:1.0, description:"The chidakasha serves as the mental space where the practitioner visualizes the Mother Goddess in the form of Mahadurka.", created_at:1779259763, source_id:"chunk-c87bd389c5c5a0aa7ee00af0f32f42e6"}}, {start: {_id:4217}, end: {_id:4216}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"compassion,nourishment", weight:1.0, description:"Annapurnam and Bhakta", created_at:1779259797, source_id:"chunk-8b24420a54f14344af97a060057521ed"}}, {start: {_id:4214}, end: {_id:4222}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"devotion,divine intervention", weight:1.0, description:"Bhakta Priyam embodies the concept of seeking divine removal of afflictions through devotion.", created_at:1779259797, source_id:"chunk-8b24420a54f14344af97a060057521ed"}}, {start: {_id:4256}, end: {_id:4241}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", keywords:"contemplation,visualization", truncate:"", weight:1.0, description:"The mantra guides the practitioner to visualize the dark space before closed eyes as a locus of spiritual connection.", created_at:1779259797, source_id:"chunk-8b24420a54f14344af97a060057521ed"}}] AS row
