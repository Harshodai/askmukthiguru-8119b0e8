UNWIND [{_id:4384, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", entity_type:"UNKNOWN", truncate:"", description:"The speaker identifies as a philosopher reflecting on economic systems.", created_at:1779264788, source_id:"chunk-1858c31999fe39fe76b1a067f13f934d", entity_id:"philosopher"}}, {_id:4385, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", entity_type:"UNKNOWN", truncate:"", description:"Economic systems are built on real wealth but criticized as fragile.", created_at:1779264788, source_id:"chunk-1858c31999fe39fe76b1a067f13f934d", entity_id:"real wealth"}}, {_id:4386, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=zGhlBQ8iWl4)<SEP>unknown_source", entity_type:"concept", truncate:"", description:"Virus infestation led to significant economic decline in nations.<SEP>Nations without precedent where certain professions were previously exclusive to men are now opening up to women.<SEP>Nations are referenced in the context of applying forgiveness on a national level.<SEP>Nations are referenced in the context of applying forgiveness on a national level.<SEP>Nations are referenced in the context of applying forgiveness on a national level.<SEP>Nations are referenced in the context of applying forgiveness on a national level.<SEP>Nations are referenced in the context of applying forgiveness on a national level.", created_at:1779751699, source_id:"chunk-1858c31999fe39fe76b1a067f13f934d<SEP>chunk-cbdab8b8a66000622cbde940d7277d78<SEP>chunk-d26a33b7890276490920b92132c786db", entity_id:"nations"}}, {_id:4387, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", entity_type:"UNKNOWN", truncate:"", description:"The crisis illustrates the fragility of financial structures.", created_at:1779264788, source_id:"chunk-1858c31999fe39fe76b1a067f13f934d", entity_id:"financial structures"}}, {_id:4388, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", entity_type:"UNKNOWN", truncate:"", description:"Speaker expresses faith in world leaders to develop sustainable solutions.", created_at:1779264789, source_id:"chunk-1858c31999fe39fe76b1a067f13f934d", entity_id:"world leaders"}}, {_id:4389, properties:{file_path:"unknown_source<SEP>YouTube Video: j7EZJwH8uCM (URL: https://www.youtube.com/watch?v=j7EZJwH8uCM)", entity_type:"concept", truncate:"", description:"Swasa refers to a state of self-established harmony across the body, mind, and consciousness, characterized by bliss and completeness.<SEP>Swasa refers to a state of self-established ease and bliss, representing harmony across bodily, mental, and conscious levels.<SEP>Swasa refers to a state of self-established ease and bliss, representing harmony across bodily, mental, and conscious levels.<SEP>Swasa refers to a state of self-established ease and bliss, representing harmony across bodily, mental, and conscious levels.", created_at:1779347351, source_id:"chunk-6ceaf029b184877ef7237e73de7e90eb<SEP>chunk-84fd7b14281eebe067a21784a7a955d0", entity_id:"Swasa"}}, {_id:4390, properties:{file_path:"unknown_source<SEP>YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", entity_type:"concept", truncate:"", description:"The physical body is described as the most important aspect of life, encompassing health as a state of harmony at the bodily level.<SEP>The tangible vessel or vehicle through which human evolution manifests, including bodily strengthening.", created_at:1779404505, source_id:"chunk-6ceaf029b184877ef7237e73de7e90eb<SEP>chunk-e0280d57f075227c7dc8487c44357147<SEP>chunk-ac91c3a51bfc466fbc02960659f7837d", entity_id:"Physical Body"}}, {_id:4391, properties:{file_path:"unknown_source<SEP>YouTube Video: j7EZJwH8uCM (URL: https://www.youtube.com/watch?v=j7EZJwH8uCM)", entity_type:"organization", truncate:"", description:"Ayurvedic doctors are mentioned as practitioners who historically use the term \"Swasa\" but lack full understanding of its implications.<SEP>Ayurvedic doctors are mentioned as practitioners who historically use the term \"health\" but may lack full understanding of its deeper meaning.<SEP>Ayurvedic doctors are mentioned as practitioners who historically use the term \"health\" but may lack full understanding of its deeper meaning.<SEP>Ayurvedic doctors are mentioned as practitioners who historically use the term \"health\" but may lack full understanding of its deeper meaning.", created_at:1779347351, source_id:"chunk-6ceaf029b184877ef7237e73de7e90eb<SEP>chunk-84fd7b14281eebe067a21784a7a955d0", entity_id:"Ayurvedic Doctors"}}, {_id:4392, properties:{file_path:"unknown_source<SEP>YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", entity_type:"concept", truncate:"", created_at:1779420877, description:"Senses are mentioned as a component that needs alignment with the self for achieving the state of Swasa.<SEP>Senses are described as a state of being fooled by, which leads to separation from pure love.<SEP>Senses are described as instruments that create the illusion of separation through perceptual limitations.", source_id:"chunk-6ceaf029b184877ef7237e73de7e90eb<SEP>chunk-7a50476fe3717f3e56d4d65eb5669d3f<SEP>chunk-af881796b97d19f020179697b9daf675<SEP>chunk-2c155ca915a56ff1bf0ef30ef075e557", entity_id:"Senses"}}, {_id:4393, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The inner divine refers to a higher spiritual state that contributes to the holistic harmony required for health.", created_at:1779346640, source_id:"chunk-6ceaf029b184877ef7237e73de7e90eb", entity_id:"Inner Divine"}}, {_id:4394, properties:{file_path:"unknown_source<SEP>YouTube Video: PFNP4c1cOSI (URL: https://www.youtube.com/watch?v=PFNP4c1cOSI)<SEP>YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"The state of being interconnected, emphasizing mutual reliance and shared existence among all entities.<SEP>The state of being interconnected, emphasizing mutual reliance and shared existence among all entities.<SEP>Interconnectedness is the state of being connected to or related to other things or people.<SEP>The concept of interconnectedness suggests that all beings in the universe are deeply linked and interdependent.<SEP>Interconnectedness signifies the perceived unity or connection between individuals and their shared consciousness.", created_at:1779669234, source_id:"chunk-d2b88d2b3bf551cfbcb60d2a9d77ae9c<SEP>chunk-1756c3e8d7e9eefbffb3f49a179b77fc<SEP>chunk-149f1fa94cc8d81b9d634c9e418c534a", entity_id:"Interconnectedness"}}, {_id:4395, properties:{file_path:"unknown_source<SEP>YouTube Video: PFNP4c1cOSI (URL: https://www.youtube.com/watch?v=PFNP4c1cOSI)", entity_type:"concept", truncate:"", description:"Living with intentionality rooted in the awareness of interconnectedness and shared existence.<SEP>Living with intentionality rooted in the awareness of interconnectedness and shared existence.<SEP>Purposeful Life is a state of living with intention and awareness of one's connection to the broader existence.", created_at:1779347488, source_id:"chunk-d2b88d2b3bf551cfbcb60d2a9d77ae9c<SEP>chunk-ac599df176221b3c1e3e9b33cb62fa37", entity_id:"Purposeful Life"}}, {_id:4396, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"All living organisms, whose existence creates the conditions necessary for planetary sustenance.<SEP>All living organisms, whose existence creates the conditions necessary for planetary sustenance.", created_at:1779347426, source_id:"chunk-d2b88d2b3bf551cfbcb60d2a9d77ae9c", entity_id:"Forms of Life"}}, {_id:4397, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The understanding that all existence is inseparably linked, transcending individuality.<SEP>The understanding that all existence is inseparably linked, transcending individuality.", created_at:1779347426, source_id:"chunk-d2b88d2b3bf551cfbcb60d2a9d77ae9c", entity_id:"Reality of Connection"}}, {_id:4398, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The natural world and planet Earth, providing the foundation for all life and sustenance.<SEP>The natural world and planet Earth, providing the foundation for all life and sustenance.", created_at:1779347426, source_id:"chunk-d2b88d2b3bf551cfbcb60d2a9d77ae9c", entity_id:"Nature and Earth"}}, {_id:4399, properties:{file_path:"unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"concept", truncate:"", created_at:1779653254, description:"The process of realizing one's interconnectedness with all life and the world, leading to a unified perspective.<SEP>The process of realizing one's interconnectedness with all life and the world, leading to a unified perspective.<SEP>Awakening to love represents a revolutionary shift in consciousness, transcending fleeting pleasure and romantic infatuation to embrace universal empathy and selflessness.<SEP>Awakening to love represents a revolutionary shift in consciousness, transcending fleeting pleasure and romantic infatuation to embrace universal empathy and selflessness.<SEP>An inner state required to activate latent decision-making potential and achieve extraordinary life outcomes.", source_id:"chunk-d2b88d2b3bf551cfbcb60d2a9d77ae9c<SEP>chunk-463088ccb7af0ca596d7f4a288f68a78<SEP>chunk-e91a27787e30cafec7220a14b1dcbe86", entity_id:"Awakening in Consciousness"}}, {_id:4400, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The mutual dependence between entities, highlighting that existence and sustenance are collective rather than isolated.<SEP>The mutual dependence between entities, highlighting that existence and sustenance are collective rather than isolated.", created_at:1779347426, source_id:"chunk-d2b88d2b3bf551cfbcb60d2a9d77ae9c", entity_id:"Interdependence"}}, {_id:4401, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A unified, all-encompassing consciousness encompassing all existence, transcending separation.<SEP>A unified, all-encompassing consciousness encompassing all existence, transcending separation.", created_at:1779347427, source_id:"chunk-d2b88d2b3bf551cfbcb60d2a9d77ae9c", entity_id:"Undivided Field of Consciousness"}}, {_id:4402, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The concept of the world as a holistic entity encompassing all existence and interconnectedness.<SEP>The concept of the world as a holistic entity encompassing all existence and interconnectedness.", created_at:1779347427, source_id:"chunk-d2b88d2b3bf551cfbcb60d2a9d77ae9c", entity_id:"The World"}}, {_id:4403, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The idea of an isolated self, considered an illusion according to Buddha's teachings on awakening.", created_at:1779390799, source_id:"chunk-40b40d077b6b6ad2e3eb8995f7aa43cd", entity_id:"Isolated Self"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:4404, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The state of being eternal, emphasized as a realization in awakened consciousness.", created_at:1779390799, source_id:"chunk-40b40d077b6b6ad2e3eb8995f7aa43cd", entity_id:"Eternal"}}, {_id:4405, properties:{file_path:"unknown_source<SEP>YouTube Video: UNdwPjyLGn0 (URL: https://www.youtube.com/watch?v=UNdwPjyLGn0)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hqre34QIMZg)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)", entity_type:"concept", truncate:"", description:"We need to produce a comprehensive, cohesive summary of the entity \"Awakened State of Consciousness\". The input is a list of descriptions (JSON objects). We need to merge them into a single summary, multiple paragraphs, plain text, no extra formatting. Must be objective, third-person, mention full name at beginning. Must be within 600 tokens. Must include all key info.

