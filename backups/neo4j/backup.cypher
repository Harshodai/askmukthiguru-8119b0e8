UNWIND [{start: {_id:8067}, end: {_id:8062}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bh_kjn-1CAY)", truncate:"", keywords:"content coverage,educational framework", weight:1.0, description:"The video elaborates on the dimension of physical health and vitality as critical for young people.", created_at:1779725314, source_id:"chunk-6faa466daa8198f4d13bcd56772915de"}}, {start: {_id:8063}, end: {_id:8062}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bh_kjn-1CAY)", truncate:"", keywords:"content coverage,relational focus", weight:1.0, description:"The video discusses non-judgmental and nurturing relationships as a key dimension for personal and professional growth.", created_at:1779725314, source_id:"chunk-6faa466daa8198f4d13bcd56772915de"}}, {start: {_id:8066}, end: {_id:8062}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bh_kjn-1CAY)", truncate:"", keywords:"content coverage,workplace philosophy", weight:1.0, description:"The video presents creativity and joy at work as an essential dimension for young professionals.", created_at:1779725314, source_id:"chunk-6faa466daa8198f4d13bcd56772915de"}}, {start: {_id:8064}, end: {_id:8062}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bh_kjn-1CAY)", truncate:"", keywords:"content coverage,social responsibility", weight:1.0, description:"The video highlights social impact as a dimension guiding young people's community engagement.", created_at:1779725314, source_id:"chunk-6faa466daa8198f4d13bcd56772915de"}}, {start: {_id:8065}, end: {_id:8062}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bh_kjn-1CAY)", truncate:"", keywords:"content coverage,spiritual philosophy", weight:1.0, description:"The video frames universal connection as a dimension for holistic well-being.", created_at:1779725314, source_id:"chunk-6faa466daa8198f4d13bcd5677