UNWIND [{start: {_id:309}, end: {_id:1809}, properties:{file_path:"unknown_source", keywords:"component,emotional foundation", truncate:"", weight:1.0, description:"Passion is part of the state of consciousness that grounds decisions.", created_at:1779653474, source_id:"chunk-f911f447e8921c9205ec53996cfbe423"}}, {start: {_id:7040}, end: {_id:1932}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", keywords:"dependence,necessity,stability,strength,structural necessity,symbolism", truncate:"", weight:3.0, created_at:1779654075, description:"The tree's ability to weather storms relies on roots, not just trunk and branches.<SEP>The tree's strength comes from its roots, not just the trunk and branches.<SEP>The tree's ability to withstand challenges relies on roots firmly adhered to the earth.", source_id:"chunk-f911f447e8921c9205ec53996cfbe423<SEP>chunk-56da25e7d132b4ecea54c551b7809f75<SEP>chunk-46d6abd520d390d99cea37e408f7a403"}}, {start: {_id:7040}, end: {_id:1809}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", keywords:"foundation,metaphor", truncate:"", weight:1.0, description:"Consciousness acts as the roots, providing the necessary foundation for drive and willpower.", created_at:1779653558, source_id:"chunk-56da25e7d132b4ecea54c551b7809f75"}}, {start: {_id:7042}, end: {_id:7047}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", keywords:"collapse,weak will", truncate:"", weight:1.0, description:"Weak willpower and absence of a beautiful state lead to quitting and collapse of drive.", created_at:1779653612, source_id:"chunk-37eeb06653208eee260f3881daf51f3a"}}, {start: {_id:7050}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"editing suggestion,grammatical correction", weight:1.0, description:"The YouTube Video contains the informal phrase \"es with\" requiring revision.", created_at:1779653784, source_id:"chunk-37a347510a58c57299357a9871f2208b"}}, {start: {_id:7048}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"editing suggestion,grammatical correction", weight:1.0, description:"The YouTube Video incorrectly uses \"you'd\" instead of \"you have.\"", created_at:1779653784, source_id:"chunk-37a347510a58c57299357a9871f2208b"}}, {start: {_id:7049}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"editing suggestion,grammatical correction", weight:1.0, description:"The YouTube Video uses \"that\" instead of \"the\" in a rhetorical question.", created_at:1779653785, source_id:"chunk-37a347510a58c57299357a9871f2208b"}}, {start: {_id:7053}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"editing suggestion,punctuation", weight:1.0, description:"The YouTube Video's rhetorical question lacks a question mark.", created_at:1779653785, source_id:"chunk-37a347510a58c57299357a9871f2208b"}}, {start: {_id:7051}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"editing suggestion,grammatical correction", weight:1.0, description:"The YouTube Video has a subject-verb agreement error (\"are\" instead of \"is\").", created_at:1779653785, source_id:"chunk-37a347510a58c57299357a9871f2208b"}}, {start: {_id:7052}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"editing suggestion,readability", weight:1.0, description:"The YouTube Video includes an overly long sentence that could be split for clarity.", created_at:1779653785, source_id:"chunk-37a347510a58c57299357a9871f2208b"}}, {start: {_id:7054}, end: {_id:1883}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"analysis,content issue,related issue", weight:2.0, description:"The problems and challenges are analyzed in relation to the transcription errors in the content.<SEP>The transcription errors are related to the problems and challenges discussed.", created_at:1779653800, source_id:"chunk-ac365deba67716da64cdb0c640371200"}}, {start: {_id:1642}, end: {_id:1638}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"data,reference,source", weight:2.0, description:"The YouTube video is the source of the URL data.<SEP>The YouTube video is sourced from the provided URL (https://www.youtube.com/watch?v=Tc8f9ZasRRM).", created_at:1779673255, source_id:"chunk-ac365deba67716da64cdb0c640371200<SEP>chunk-1625d2a99ff17f15ce8a139663adfc1b"}}, {start: {_id:7054}, end: {_id:1638}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"content source", weight:1.0, description:"The YouTube video contains the content about problems and challenges.", created_at:1779653800, source_id:"chunk-ac365deba67716da64cdb0c640371200"}}, {start: {_id:7054}, end: {_id:1642}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"data source", weight:1.0, description:"The URL is a data source for the content about problems and challenges.", created_at:1779653800, source_id:"chunk-ac365deba67716da64cdb0c640371200"}}, {start: {_id:7057}, end: {_id:7058}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"emotional state,supporting concept", weight:1.0, description:"This relationship shows that the first quote's idea of a beautiful state is reinforced by the third quote's emphasis on learning to live in that state.", created_at:1779653806, source_id:"chunk-e95ff9d14447fc65612b05aac22a6049"}}, {start: {_id:7060}, end: {_id:7056}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"overcoming challenges,problem-solution", weight:1.0, description:"This relationship indicates that having strength to hold on (fourth quote) is the solution to the problem of a weak will (second quote).", created_at:1779653806, source_id:"chunk-e95ff9d14447fc65612b05aac22a6049"}}, {start: {_id:7058}, end: {_id:7056}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"contrasting state,willpower", weight:1.0, description:"This relationship contrasts the weakness in will (second quote) with the strength from a beautiful state (first quote), highlighting the importance of emotional state on willpower.", created_at:1779653807, source_id:"chunk-e95ff9d14447fc65612b05aac22a6049"}}, {start: {_id:7057}, end: {_id:7060}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"causal relationship,perseverance", weight:1.0, description:"This relationship shows that learning to live in a beautiful state (third quote) leads to having the strength to persevere through challenges (fourth quote).", created_at:1779653807, source_id:"chunk-e95ff9d14447fc65612b05aac22a6049"}}, {start: {_id:7055}, end: {_id:7058}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"closing remark", weight:1.0, description:"This relationship connects the closing expression of gratitude to the main theme of the text, which is about maintaining a positive state to achieve goals.", created_at:1779653807, source_id:"chunk-e95ff9d14447fc65612b05aac22a6049"}}, {start: {_id:4579}, end: {_id:7035}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", truncate:"", keywords:"enables,sustains", weight:1.0, description:"The beautiful state enables and sustains the drive.", created_at:1779653882, source_id:"chunk-87ae4401ec344e0f145a40afa02041af"}}] AS row
