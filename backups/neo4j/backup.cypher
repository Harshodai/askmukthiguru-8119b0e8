UNWIND [{start: {_id:292}, end: {_id:7790}, properties:{file_path:"unknown_source", keywords:"countermeasure,solution", truncate:"", weight:1.0, description:"Self-awareness and compassion are a countermeasure to hate.", created_at:1779675542, source_id:"chunk-97a582a6bc26174c8bc3002eb473cbb9"}}, {start: {_id:7790}, end: {_id:7796}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=XMzZe5aEmTo)", truncate:"", keywords:"preventive measure,societal healing", weight:1.0, description:"Global cultivation of self-awareness and compassion is framed as the only way to avert violence and war.", created_at:1779675556, source_id:"chunk-8d609fe5e217d48045ea6baa411a7cde"}}, {start: {_id:7797}, end: {_id:7798}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=XMzZe5aEmTo)", truncate:"", keywords:"ethical responsibility,training requirement", weight:1.0, description:"Those in power must undergo training in consciousness, education, and meditation to avoid misuse of authority.", created_at:1779675556, source_id:"chunk-8d609fe5e217d48045ea6baa411a7cde"}}, {start: {_id:7795}, end: {_id:7800}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=XMzZe5aEmTo)", truncate:"", keywords:"harmful behavior,root cause", weight:1.0, description:"Bias and prejudice drive negative reactions to differences in appearance, culture, or beliefs, perpetuating violence.", created_at:1779675556, source_id:"chunk-8d609fe5e217d48045ea6baa411a7cde"}}, {start: {_id:7799}, end: {_id:3271}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=XMzZe5aEmTo)", truncate:"", keywords:"cyclical harm,emotional response", weight:1.0, description:"Expressing anger or hate provides momentary relief but reinforces violent tendencies in the mind.", created_at:1779675556, source_id:"chunk-8d609fe5e217d48045ea6baa411a7cde"}}, {start: {_id:7808}, end: {_id:3602}, properties:{file_path:"unknown_source", truncate:"", keywords:"lack of genuine friendship,mutual profit", weight:1.0, description:"Business associates engage in relationships primarily driven by financial gain rather than authentic friendship bonds.", created_at:1779675584, source_id:"chunk-00a19ff47058297a371a169b18ef727a"}}, {start: {_id:7809}, end: {_id:7807}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=RvgN5Mfbd5A)", keywords:"commitment depth,temporary vs. true friendship,transience", truncate:"", weight:2.0, description:"Roller coaster buddies engage in transient relationships based on shared fun, contrasting with true friends who maintain loyal, selfless bonds.<SEP>True friends exhibit deeper commitment than temporary buddies.", created_at:1779675645, source_id:"chunk-00a19ff47058297a371a169b18ef727a<SEP>chunk-f9137367b6fc0c1e310ef8df615fc408"}}, {start: {_id:6214}, end: {_id:3602}, properties:{file_path:"unknown_source", keywords:"aggression,rivalry", truncate:"", weight:1.0, description:"Competitors prioritize dominance over cooperation, leading to adversarial dynamics that undermine genuine friendship.", created_at:1779675584, source_id:"chunk-00a19ff47058297a371a169b18ef727a"}}, {start: {_id:3308}, end: {_id:3050}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=XMzZe5aEmTo)", truncate:"", keywords:"generational transmission,societal impact", weight:1.0, description:"Prejudice flows through generations, perpetuating societal issues and requiring conscious realization to end.", created_at:1779675598, source_id:"chunk-719340217eb366fadb6e6dd8b5dbf568"}}, {start: {_id:7801}, end: {_id:3050}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=XMzZe5aEmTo)", truncate:"", keywords:"perceived inequality,societal attitudes", weight:1.0, description:"Prejudice arises from perceived natural differences in skin color and blessings, influencing societal attitudes.", created_at:1779675598, source_id:"chunk-719340217eb366fadb6e6dd8b5dbf568"}}, {start: {_id:3050}, end: {_id:7804}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=XMzZe5aEmTo)", truncate:"", keywords:"perceived inequality,societal attitudes", weight:1.0, description:"Prejudice arises from perceived differences in skin color and natural blessings, influencing societal attitudes.", created_at:1779675598, source_id:"chunk-719340217eb366fadb6e6dd8b5dbf568"}}, {start: {_id:668}, end: {_id:7807}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=RvgN5Mfbd5A)", keywords:"mutual support,protection", truncate:"", weight:1.0, description:"True friends protect each other from danger.", created_at:1779675644, source_id:"chunk-f9137367b6fc0c1e310ef8df615fc408"}}, {start: {_id:5293}, end: {_id:2647}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=RvgN5Mfbd5A)", truncate:"", keywords:"dialogue,inquiry", weight:1.0, description:"The conversation with seekers explored the concept of true friendship.", created_at:1779675644, source_id:"chunk-f9137367b6fc0c1e310ef8df615fc408"}}, {start: {_id:3649}, end: {_id:7807}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=RvgN5Mfbd5A)", truncate:"", keywords:"resource distribution,sharing", weight:1.0, description:"True friends share food and resources.", created_at:1779675644, source_id:"chunk-f9137367b6fc0c1e310ef8df615fc408"}}, {start: {_id:2647}, end: {_id:7813}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=RvgN5Mfbd5A)", truncate:"", keywords:"collective questioning,demographic diversity", weight:1.0, description:"The seekers represented diverse ages engaging in shared inquiry.", created_at:1779675644, source_id:"chunk-f9137367b6fc0c1e310ef8df615fc408"}}, {start: {_id:1446}, end: {_id:7807}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=RvgN5Mfbd5A)", truncate:"", keywords:"bonding,narrative exchange", weight:1.0, description:"True friends tell stories and engage in shared experiences.", created_at:1779675644, source_id:"chunk-f9137367b6fc0c1e310ef8df615fc408"}}, {start: {_id:3602}, end: {_id:1064}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=RvgN5Mfbd5A)", truncate:"", keywords:"evolutionary necessity,mutual dependence", weight:1.0, description:"Friendship was essential for survival in historical human societies.", created_at:1779675644, source_id:"chunk-f9137367b6fc0c1e310ef8df615fc408"}}, {start: {_id:4019}, end: {_id:7807}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=RvgN5Mfbd5A)", keywords:"connection,shared wonder", truncate:"", weight:1.0, description:"True friends contemplate stars and the sky together.", created_at:1779675644, source_id:"chunk-f9137367b6fc0c1e310ef8df615fc408"}}, {start: {_id:6214}, end: {_id:7807}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=RvgN5Mfbd5A)", truncate:"", keywords:"contrast,rivalry", weight:1.0, description:"True friends lack the competition inherent in rivalries.", created_at:1779675644, source_id:"chunk-f9137367b6fc0c1e310ef8df615fc408"}}, {start: {_id:7808}, end: {_id:7807}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=RvgN5Mfbd5A)", keywords:"mutual benefit vs. friendship", truncate:"", weight:1.0, description:"True friends prioritize connection over profit.", created_at:1779675645, source_id:"chunk-f9137367b6fc0c1e310ef8df615fc408"}}] AS row
