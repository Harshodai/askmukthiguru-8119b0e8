chunk-ceb359127e8a043974d8be0d50ff7d93<SEP>chunk-dec047b5cab8e88110c88f8cc2cfcd7d", entity_id:"Nonviolent Resistance Movement"}}, {_id:490, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Emotional states like stress, worry, anger, and fear often mistaken for positive motivators.", created_at:1779138112, source_id:"chunk-37e9823f1b7627730cb977ca684bcc4a", entity_id:"Stressful Emotions"}}, {_id:491, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Traditional approaches to greatness emphasizing strategic planning and outmaneuvering opponents.", created_at:1779138112, source_id:"chunk-37e9823f1b7627730cb977ca684bcc4a", entity_id:"Strategies and Plans"}}, {_id:492, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"organization", truncate:"", description:"The British were the colonial rulers of India, against whom Gandhi led a non-violent struggle for independence.<SEP>The British were foreign invaders who destroyed the ancient education system and caused economic decline.", created_at:1779555885, source_id:"chunk-37e9823f1b7627730cb977ca684bcc4a<SEP>chunk-2033f09bf8213ddf39a0e5521e23bdef", entity_id:"British"}}, {_id:493, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"organization", truncate:"", description:"The nation of over 390 million Indians was led by Gandhi to achieve independence without violence.", created_at:1779138112, source_id:"chunk-37e9823f1b7627730cb977ca684bcc4a", entity_id:"Nation of 390 Million Indians"}}, {_id:494, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"method", truncate:"", description:"Gandhi's philosophy of peaceful resistance as a means of social and political change.", created_at:1779138112, source_id:"chunk-37e9823f1b7627730cb977ca684bcc4a", entity_id:"Non-Violent Resistance"}}, {_id:495, properti