UNWIND [{_id:7179, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"concept", truncate:"", description:"The spirit of Earth is a central concept, embodying the essence of nature and its connection to human existence.", created_at:1779659337, source_id:"chunk-492f527e534c0851925d26b6a1dafb40", entity_id:"Spirit of Earth"}}, {_id:7180, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"UNKNOWN", truncate:"", description:"The soil of the Earth is equated to human flesh.", created_at:1779659337, source_id:"chunk-492f527e534c0851925d26b6a1dafb40", entity_id:"Flesh"}}, {_id:7181, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"UNKNOWN", truncate:"", description:"The waters of the Earth are equated to human blood and tears.", created_at:1779659337, source_id:"chunk-492f527e534c0851925d26b6a1dafb40", entity_id:"Blood"}}, {_id:7182, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"UNKNOWN", truncate:"", description:"The waters of the Earth are equated to human tears.", created_at:1779659337, source_id:"chunk-492f527e534c0851925d26b6a1dafb40", entity_id:"Tears"}}, {_id:7183, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"UNKNOWN", truncate:"", description:"The soil of the Earth is equated to human bones.", created_at:1779659338, source_id:"chunk-492f527e534c0851925d26b6a1dafb40", entity_id:"Bones"}}, {_id:7184, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"natural_object", truncate:"", description:"Rocks are natural objects mentioned as part of Mother Earth's essence.", created_at:1779659819, source_id:"chunk-831e414d3c516304d3109f8ff76d5f01", entity_id:"Rocks"}}, {_id:7185, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"concept", truncate:"", description:"Life Celebration refers to the philosophical concept discussed in the text about celebrating life.", created_at:1779659819, source_id:"chunk-456304668c2993662550f7a84adc904b", entity_id:"Life Celebration"}}, {_id:7186, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"concept", truncate:"", description:"Linguistic Correction is the process of identifying and fixing errors in language, as discussed in the text.", created_at:1779659819, source_id:"chunk-456304668c2993662550f7a84adc904b", entity_id:"Linguistic Correction"}}, {_id:7187, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"natural_object", truncate:"", description:"Colors of changing seasons are natural objects through which the spirit of Earth manifests.", created_at:1779659821, source_id:"chunk-831e414d3c516304d3109f8ff76d5f01", entity_id:"Colors of changing seasons"}}, {_id:7188, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"concept", truncate:"", description:"The spirit of Earth is a concept that permeates all natural objects.", created_at:1779659821, source_id:"chunk-831e414d3c516304d3109f8ff76d5f01", entity_id:"Spirit of our great Earth"}}, {_id:7189, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"category", truncate:"", description:"These colors symbolize different human groups or cultural identities in the poetic context.", created_at:1779659866, source_id:"chunk-a28c71d3080d41b1e18683441ac8c1c6", entity_id:"Black, Yellow, White, Brown"}}, {_id:7190, properties:{file_path:"unknown_source<SEP>YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", created_at:1779661690, description:"Transcendental experiences are transformative consciousness shifts that reveal dimensions beyond the mind, including mystical, transformational, and enlightenment experiences.<SEP>Three kinds of transcendental experiences that reveal dimensions beyond the mind, including mystical and conversion experiences.<SEP>Transcendental Experiences are three kinds of experiences that reveal a dimension beyond the mind.`", source_id:"chunk-888705ac7721cd21ad67f22ea71eac64<SEP>chunk-663a44cd945f80e872d83f9201071419<SEP>chunk-71c647fd13898f185a71091bf9fbd510", entity_id:"Transcendental Experiences"}}, {_id:7191, properties:{file_path:"unknown_source<SEP>YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"organization", truncate:"", description:"Aecom is a mystic powerhouse designed to facilitate transcendental experiences and elevate human consciousness.` - Looks correct.<SEP>Domain-specific term interpreted as a mystical or organizational entity facilitating consciousness expansion.<SEP>An organization designed as a mystic powerhouse to facilitate transcendence into higher consciousness dimensions.<SEP>Aecom is an organization created to be a mystic powerhouse that can", created_at:1779661775, source_id:"chunk-888705ac7721cd21ad67f22ea71eac64<SEP>chunk-3589746193d218d51479dd14e70466b0<SEP>chunk-9f245e3153d92a2c38134afd812338bf<SEP>chunk-84fe7edeb817f0143052c09f97b672fc", entity_id:"Aecom"}}, {_id:7193, properties:{file_path:"unknown_source<SEP>YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"event", truncate:"", created_at:1779661704, description:"Transformation experience activates heart neurons, fostering compassion and transcending self-centricity.<SEP>A type of transcendental experience involving activation of heart neurons and movement beyond self-centricity.<SEP>A transcendental experience leading to neuronal activation in the heart and transcendence of self-centricity.", source_id:"chunk-888705ac7721cd21ad67f22ea71eac64<SEP>chunk-355c42e8aaaf893df441489ff3a44b86<SEP>chunk-9f245e3153d92a2c38134afd812338bf", entity_id:"Transformation Experience"}}, {_id:7194, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Awakened roles include parents, leaders, teachers, and researchers transformed through enlightenment experiences.", created_at:1779659916, source_id:"chunk-888705ac7721cd21ad67f22ea71eac64", entity_id:"Awakened Roles"}}, {_id:7195, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"data", truncate:"", description:"The output text is identical to the input text because no corrections were needed.", created_at:1779659919, source_id:"chunk-25c321e128bae2ec1d82719bef8c6996", entity_id:"Output Text"}}, {_id:7196, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"artifact", truncate:"", description:"YouTube Video (HELtP96Dd4w) is the source material containing text requiring corrections.<SEP>YouTube Video (HELtP96Dd4w) is the source material containing text requiring corrections.", created_at:1779661405, source_id:"chunk-cffb9eac72e7a5a6fe069d5ec4bb333b", entity_id:"YouTube Video (HELtP96Dd4w)"}}, {_id:7198, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"artifact", truncate:"", created_at:1779661862, description:"A YouTube video titled \"atapult you to higher states of consciousness\" hosted at the specified URL.<SEP>YouTube Video: HELtP96Dd4w is a video source discussing grammatical analysis and mystical concepts.<SEP>YouTube Video titled \"HELtP96Dd4w\" hosted on YouTube, containing content that underwent text corrections.", source_id:"chunk-663a44cd945f80e872d83f9201071419<SEP>chunk-b787fee503789ccf5420cfc0f4003e6b<SEP>chunk-b858b90d8f02642a76bbfb16df311343", entity_id:"YouTube Video: HELtP96Dd4w"}}, {_id:7199, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", description:"Another type of transcendental experience described as a mystical or conversion experience.<SEP>Conversion Experience is a type of mystical experience that converts a person from a state of belief to a state of discovery.`", created_at:1779661690, source_id:"chunk-663a44cd945f80e872d83f9201071419<SEP>chunk-71c647fd13898f185a71091bf9fbd510", entity_id:"Conversion Experience"}}, {_id:7200, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", description:"Destructive addictions are harmful behaviors that seekers relinquish after experiencing mystical or spiritual transformation.<SEP>Destructive habits or dependencies that seekers relinquish after transcendental experiences.", created_at:1779661704, source_id:"chunk-2fad0fbe65ec4abc3eb5db49059e7a50<SEP>chunk-9f245e3153d92a2c38134afd812338bf", entity_id:"Destructive Addictions"}}] AS row
