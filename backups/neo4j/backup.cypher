UNWIND [{start: {_id:354}, end: {_id:464}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"achievement,manifestation,transformation", truncate:"", weight:2.0, description:"The exercise aims to achieve the happy child state by addressing the wounded child state?s pain.<SEP>The practice enables the emergence of the happy child state by dissolving inner agitation and fostering self-trust.", created_at:1779183866, source_id:"chunk-da4a30723d6bfb88a08e73a51a9a3d62<SEP>chunk-0c3de714c4e42df4c68c8fd79dfac5ad"}}, {start: {_id:462}, end: {_id:464}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"methodology,technique", truncate:"", weight:1.0, description:"Conscious Breaths are integral techniques within the Soul Sync Exercise, including humming and visualization.", created_at:1779137928, source_id:"chunk-da4a30723d6bfb88a08e73a51a9a3d62"}}, {start: {_id:464}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"documentation,source", truncate:"", weight:1.0, description:"The PDF document contains detailed instructions for the Soul Sync Exercise and related practices.", created_at:1779137929, source_id:"chunk-da4a30723d6bfb88a08e73a51a9a3d62"}}, {start: {_id:461}, end: {_id:464}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"metaphor,purpose", truncate:"", weight:1.0, description:"The lion?s roar metaphor illustrates the exercise?s goal of silencing inner chaos through realization.", created_at:1779137929, source_id:"chunk-da4a30723d6bfb88a08e73a51a9a3d62"}}, {start: {_id:17}, end: {_id:465}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"author,discussion topic", truncate:"", weight:1.0, description:"Krishnaji authored the section discussing trauma healing and self-acceptance.", created_at:1779137978, source_id:"chunk-8b9c1604faa1ea45879aac48740ef02f"}}, {start: {_id:360}, end: {_id:338}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cause,manifestation", truncate:"", weight:1.0, description:"The wounded child embodies inner conflict caused by past traumas.", created_at:1779137978, source_id:"chunk-8b9c1604faa1ea45879aac48740ef02f"}}, {start: {_id:350}, end: {_id:466}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"outcome,symbol", truncate:"", weight:1.0, description:"The happy child represents the outcome of self-acceptance and healing.", created_at:1779137978, source_id:"chunk-8b9c1604faa1ea45879aac48740ef02f"}}, {start: {_id:287}, end: {_id:467}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"description,movement", truncate:"", weight:1.0, description:"The river metaphor describes life's forward flow and need to overcome past constraints.", created_at:1779137978, source_id:"chunk-8b9c1604faa1ea45879aac48740ef02f"}}, {start: {_id:468}, end: {_id:469}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"illustration,obstruction", truncate:"", weight:1.0, description:"The party metaphor illustrates how past traumas obstruct authentic living.", created_at:1779137979, source_id:"chunk-8b9c1604faa1ea45879aac48740ef02f"}}, {start: {_id:470}, end: {_id:466}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"process,result", truncate:"", weight:1.0, description:"Healing the wounded child leads to self-acceptance and joyful living.", created_at:1779137979, source_id:"chunk-8b9c1604faa1ea45879aac48740ef02f"}}, {start: {_id:472}, end: {_id:476}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"identity shift,nonviolence,transformation", truncate:"", weight:3.0, created_at:1779183866, description:"Gandhi's transformation into Mahatma Gandhi occurred through embracing nonviolence as a path of resistance.<SEP>Gandhi transformed from Mohandas K. Gandhi to Mahatma Gandhi, becoming a key influencer in human history.<SEP>Gandhi's evolution into Mahatma Gandhi symbolizes the triumph of inner truth over external identity.", source_id:"chunk-42e3465bd48ea87621d94e9d33063209<SEP>chunk-dec047b5cab8e88110c88f8cc2cfcd7d<SEP>chunk-0c3de714c4e42df4c68c8fd79dfac5ad"}}, {start: {_id:473}, end: {_id:477}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"authenticity,essence,foundation,necessity", truncate:"", weight:2.0, description:"Inner truth provides the radiant essence sustaining spiritual growth beyond empty ideals.<SEP>Authentic spiritual growth requires alignment with inner truth to manifest greatness and self-acceptance.", created_at:1779183898, source_id:"chunk-42e3465bd48ea87621d94e9d33063209<SEP>chunk-0c3de714c4e42df4c68c8fd79dfac5ad"}}, {start: {_id:62}, end: {_id:471}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"authorship,teaching", truncate:"", weight:1.0, description:"Preethaji authored the text to teach the Second Sacred Secret's principles.", created_at:1779138022, source_id:"chunk-42e3465bd48ea87621d94e9d33063209"}}, {start: {_id:479}, end: {_id:338}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"healing,liberation", truncate:"", weight:1.0, description:"Healing the \"wounded child\" releases past burdens, enabling freedom and joy akin to childhood innocence.", created_at:1779138022, source_id:"chunk-42e3465bd48ea87621d94e9d33063209"}}, {start: {_id:472}, end: {_id:474}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"activism,catalyst,consideration,context,exile,experience,immigration,legal challenge,location,stay option", truncate:"", weight:5.0, description:"Gandhi moved to South Africa in 1893, where his early activism began.<SEP>Gandhi considered continuing his legal career in South Africa despite humiliation.<SEP>Gandhi moved to South Africa to work as a lawyer and faced racial discrimination.<SEP>South Africa was the context for Gandhi's transformation and the nonviolent resistance movement.<SEP>Gandhi's challenges in South Africa catalyzed his spiritual journey toward nonviolence and self-realization.", created_at:1779183866, source_id:"chunk-42e3465bd48ea87621d94e9d33063209<SEP>chunk-51b5d128cc55be8ec4b28c0575f1cf41<SEP>chunk-dec047b5cab8e88110c88f8cc2cfcd7d<SEP>chunk-0c3de714c4e42df4c68c8fd79dfac5ad"}}, {start: {_id:476}, end: {_id:475}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"philosophy,resistance", truncate:"", weight:1.0, description:"Nonviolence became the cornerstone of Mahatma Gandhi's philosophy and resistance against oppression.", created_at:1779138022, source_id:"chunk-42e3465bd48ea87621d94e9d33063209"}}, {start: {_id:473}, end: {_id:471}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"discovery,foundation", truncate:"", weight:1.0, description:"The Second Sacred Secret centers on discovering inner truth as the foundation for authentic greatness.", created_at:1779138022, source_id:"chunk-42e3465bd48ea87621d94e9d33063209"}}, {start: {_id:476}, end: {_id:478}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"embodiment,symbolism", truncate:"", weight:1.0, description:"Mahatma Gandhi symbolizes the weak's victory over oppressors through nonviolent resistance.", created_at:1779138022, source_id:"chunk-42e3465bd48ea87621d94e9d33063209"}}, {start: {_id:480}, end: {_id:472}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"departure point,travel origin", truncate:"", weight:1.0, description:"Gandhi traveled from Durban to Pretoria for a court case.", created_at:1779138072, source_id:"chunk-51b5d128cc55be8ec4b28c0575f1cf41"}}, {start: {_id:472}, end: {_id:483}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conflict location,travel destination", truncate:"", weight:1.0, description:"Gandhi was forced off the train in Pretoria due to racial segregation.", created_at:1779138072, source_id:"chunk-51b5d128cc55be8ec4b28c0575f1cf41"}}] AS row
