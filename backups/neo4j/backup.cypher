UNWIND [{start: {_id:709}, end: {_id:713}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"acceptance,self-transformation", truncate:"", weight:1.0, description:"Maureen's journey involved embracing her comparisons to achieve connection.", created_at:1779139301, source_id:"chunk-468fc234a44cb0396e4202675d40e771"}}, {start: {_id:696}, end: {_id:506}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"contrast,transformation", truncate:"", weight:1.0, description:"Authentic self-love requires moving from self-obsession to observation.", created_at:1779139301, source_id:"chunk-468fc234a44cb0396e4202675d40e771"}}, {start: {_id:606}, end: {_id:707}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"liberation,self-awareness", truncate:"", weight:1.0, description:"Truth enables freedom from self-warped perceptions and inner conflict.", created_at:1779139301, source_id:"chunk-468fc234a44cb0396e4202675d40e771"}}, {start: {_id:715}, end: {_id:706}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"mystical symbolism,spiritual activation", weight:1.0, description:"The third eye represents mystical awareness, linked to Eastern deities' imagery.", created_at:1779139301, source_id:"chunk-468fc234a44cb0396e4202675d40e771"}}, {start: {_id:40}, end: {_id:699}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional state,neurological shift", truncate:"", weight:1.0, description:"Observation leads to calmness through reduced amygdala activity.", created_at:1779139301, source_id:"chunk-468fc234a44cb0396e4202675d40e771"}}, {start: {_id:713}, end: {_id:717}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"self-discovery,transformation", truncate:"", weight:2.0, description:"Maureen participates in the retreat, leading to a profound personal transformation and self-awareness.<SEP>Maureen's participation in the retreat led to her transformation and self-discovery.", created_at:1779179454, source_id:"chunk-473520b864e4054af2c84c9215077c94<SEP>chunk-7146bcb62c68c22b68c6b0cc9e8d3a09"}}, {start: {_id:713}, end: {_id:719}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"disrespect,trauma", truncate:"", weight:1.0, description:"The stranger's abuse caused lasting trauma and self-disrespect in Maureen, influencing her life journey.", created_at:1779139328, source_id:"chunk-473520b864e4054af2c84c9215077c94"}}, {start: {_id:721}, end: {_id:717}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"healing,meditative practice", truncate:"", weight:1.0, description:"The retreat incorporates Limitless Field meditation to facilitate healing and wholeness among participants.", created_at:1779139328, source_id:"chunk-473520b864e4054af2c84c9215077c94"}}, {start: {_id:713}, end: {_id:716}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional healing,therapy", truncate:"", weight:1.0, description:"Maureen seeks therapy to address rage and self-disrespect from her traumatic past.", created_at:1779139328, source_id:"chunk-473520b864e4054af2c84c9215077c94"}}, {start: {_id:723}, end: {_id:717}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"detachment,self-observation", truncate:"", weight:1.0, description:"The retreat enables participants to enter a meditative state for observing life without emotional reactivity.", created_at:1779139328, source_id:"chunk-473520b864e4054af2c84c9215077c94"}}, {start: {_id:718}, end: {_id:713}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"efficiency,professional role", truncate:"", weight:1.0, description:"Maureen's corporate job involved a major portfolio and was characterized by ruthlessness and efficiency.", created_at:1779139328, source_id:"chunk-473520b864e4054af2c84c9215077c94"}}, {start: {_id:713}, end: {_id:720}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"healing,self-perception", truncate:"", weight:1.0, description:"Maureen confronts and transcends her wounded self during the retreat's meditative practices.", created_at:1779139328, source_id:"chunk-473520b864e4054af2c84c9215077c94"}}, {start: {_id:713}, end: {_id:116}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"acceptance,connection,healing,spiritual connection", truncate:"", weight:2.0, description:"Maureen feels embraced by the universe during meditation, fostering acceptance and unity.<SEP>Maureen felt connected to the universe during her meditation, which helped heal her.", created_at:1779179454, source_id:"chunk-473520b864e4054af2c84c9215077c94<SEP>chunk-7146bcb62c68c22b68c6b0cc9e8d3a09"}}, {start: {_id:713}, end: {_id:726}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"transcendence,unity", truncate:"", weight:1.0, description:"Maureen's uncommon meditative experience leads to a sense of unity with the universe and self-acceptance.", created_at:1779139328, source_id:"chunk-473520b864e4054af2c84c9215077c94"}}, {start: {_id:731}, end: {_id:713}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"healing,meditation practice,self-discovery,transcendental experience", truncate:"", weight:2.0, description:"Maureen engaged in Limitless Field Meditation, which facilitated her transformative experience and self-healing.<SEP>Maureen's experience in the Limitless Field meditation allowed for a transcendental embrace and healing of her wounded self.", created_at:1779179454, source_id:"chunk-f850af926a91f1ef0f0f13f7bd908f06<SEP>chunk-7146bcb62c68c22b68c6b0cc9e8d3a09"}}, {start: {_id:713}, end: {_id:730}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"experience,personal growth", truncate:"", weight:1.0, description:"Maureen experienced a life-changing moment during meditation that altered her emotional state and priorities.", created_at:1779139355, source_id:"chunk-f850af926a91f1ef0f0f13f7bd908f06"}}, {start: {_id:713}, end: {_id:297}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"healing,metaphorical embrace", truncate:"", weight:1.0, description:"Maureen felt metaphorically embraced by the universe, which symbolized a process of healing her inner wounds.", created_at:1779139355, source_id:"chunk-f850af926a91f1ef0f0f13f7bd908f06"}}, {start: {_id:729}, end: {_id:713}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"metaphorical healing,self-compassion", truncate:"", weight:1.0, description:"The metaphor of a broken heart being pieced together reflects Maureen's journey toward self-acceptance and healing.", created_at:1779139355, source_id:"chunk-f850af926a91f1ef0f0f13f7bd908f06"}}, {start: {_id:713}, end: {_id:728}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"career decision,self-prioritization", truncate:"", weight:1.0, description:"Maureen declined a promotion to focus on personal growth and mentoring others, reflecting her transformed priorities.", created_at:1779139355, source_id:"chunk-f850af926a91f1ef0f0f13f7bd908f06"}}, {start: {_id:713}, end: {_id:727}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"employment,mentorship", truncate:"", weight:1.0, description:"Maureen is employed by and mentors young entry-level employees at her organization.", created_at:1779139355, source_id:"chunk-f850af926a91f1ef0f0f13f7bd908f06"}}] AS row
