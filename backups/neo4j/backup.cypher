UNWIND [{start: {_id:3537}, end: {_id:3536}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UbCEX5KBbPw)", truncate:"", keywords:"cultural symbolism,sensory experience", weight:1.0, description:"Ugadi Pachadi is consumed during the festival to represent life's cyclical and diverse experiences.", created_at:1779232717, source_id:"chunk-61d286a10ba0271970a579e1cf354cf5"}}, {start: {_id:3538}, end: {_id:3536}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UbCEX5KBbPw)", truncate:"", keywords:"cyclical acceptance,spiritual awakening", weight:1.0, description:"Ugadi's philosophy aligns with the state of sthita prajna tava, emphasizing acceptance of life's cyclical nature.", created_at:1779232717, source_id:"chunk-61d286a10ba0271970a579e1cf354cf5"}}, {start: {_id:3542}, end: {_id:1679}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UbCEX5KBbPw)", truncate:"", keywords:"cultural tradition,spiritual significance", weight:1.0, description:"The shloka is recited during Ugadi to reflect on life's cyclical nature and divine liberation.", created_at:1779232770, source_id:"chunk-61c739c46e4f6213506db20ff0e52508"}}, {start: {_id:2174}, end: {_id:3542}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UbCEX5KBbPw)", truncate:"", keywords:"inner connection,spiritual philosophy", weight:1.0, description:"The shloka references Antaryamin as the divine power within, guiding liberation from bondage.", created_at:1779232770, source_id:"chunk-61c739c46e4f6213506db20ff0e52508"}}, {start: {_id:1679}, end: {_id:3522}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UbCEX5KBbPw)<SEP>unknown_source", truncate:"", keywords:"cultural symbolism,life experiences,ritual consumption,symbolic representation", weight:2.0, description:"Ugadi Pachadi is traditionally consumed during Ugadi to embody life's diverse experiences.<SEP>Ugadi is associated with Ugadi Pachadi, which symbolizes the various tastes and experiences of life.", created_at:1779519040, source_id:"chunk-61c739c46e4f6213506db20ff0e52508<SEP>chunk-6af3220a340f626ce621832ca3542da1"}}, {start: {_id:3542}, end: {_id:3543}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UbCEX5KBbPw)", truncate:"", keywords:"divine power,spiritual philosophy", weight:1.0, description:"The shloka emphasizes the divine as the cyclical and liberating power in life.", created_at:1779232770, source_id:"chunk-61c739c46e4f6213506db20ff0e52508"}}, {start: {_id:2174}, end: {_id:1832}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UbCEX5KBbPw)", truncate:"", keywords:"connection,divine connection,mantra recitation,spiritual", weight:2.0, description:"The mantra Hamsa Soham Ekam is chanted to connect with the divine presence (Antaryamin).<SEP>The mantra connects the user to Antaryamin.", created_at:1779232816, source_id:"chunk-61c739c46e4f6213506db20ff0e52508<SEP>chunk-ad4544e5cec6ee250e4823e5b924afdf"}}, {start: {_id:3520}, end: {_id:1679}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UbCEX5KBbPw)", truncate:"", keywords:"culinary tradition,regional terminology", weight:1.0, description:"Bevubella is the South Indian term for Ugadi Pachadi, prepared during the festival.", created_at:1779232770, source_id:"chunk-61c739c46e4f6213506db20ff0e52508"}}, {start: {_id:2174}, end: {_id:3543}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UbCEX5KBbPw)", truncate:"", keywords:"divine manifestation,inner presence", weight:1.0, description:"Antaryamin is the divine presence within oneself, as described in the text.", created_at:1779232770, source_id:"chunk-61c739c46e4f6213506db20ff0e52508"}}, {start: {_id:3541}, end: {_id:1679}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Ub