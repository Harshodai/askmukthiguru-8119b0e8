UNWIND [{start: {_id:686}, end: {_id:685}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"concept differentiation", truncate:"", weight:1.0, description:"The text clarifies the distinction between self-obsession and selfishness, emphasizing their unique roles in personal behavior.", created_at:1779139194, source_id:"chunk-bfc9ac02b4b45204e93a15d51a959bb6"}}, {start: {_id:127}, end: {_id:682}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"betrayal,infidelity", truncate:"", weight:1.0, description:"The author references their partner?s infidelity as a source of pain and conflict.", created_at:1779139194, source_id:"chunk-bfc9ac02b4b45204e93a15d51a959bb6"}}, {start: {_id:127}, end: {_id:684}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"neglect,parental stress", truncate:"", weight:1.0, description:"The author expresses frustration with their children?s behavior and the stress of caregiving responsibilities.", created_at:1779139194, source_id:"chunk-bfc9ac02b4b45204e93a15d51a959bb6"}}, {start: {_id:127}, end: {_id:683}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"credit theft,workplace conflict", truncate:"", weight:1.0, description:"The author resents their boss for taking credit for their work, highlighting a power imbalance.", created_at:1779139194, source_id:"chunk-bfc9ac02b4b45204e93a15d51a959bb6"}}, {start: {_id:127}, end: {_id:681}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"metaphor,self-reflection", truncate:"", weight:1.0, description:"The author uses Birbal?s story to metaphorically explain the challenge of addressing self-obsession.", created_at:1779139194, source_id:"chunk-bfc9ac02b4b45204e93a15d51a959bb6"}}, {start: {_id:691}, end: {_id:690}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"internal vs. external factors", truncate:"", weight:1.0, description:"Conict (inner conflict) arises independently of external circumstances like height or success comparisons.", created_at:1779139220, source_id:"chunk-c756fff1f643175625bc8f48eb702151"}}, {start: {_id:506}, end: {_id:689}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"emotional cause,emotional consequences,mental health,psychological impact", truncate:"", weight:2.0, description:"Self-obsession directly fuels unhappiness by fostering dissatisfaction and inner conflict.<SEP>Self-obsession directly contributes to unhappiness and inner dissatisfaction.", created_at:1779184160, source_id:"chunk-c756fff1f643175625bc8f48eb702151<SEP>chunk-5c02e046d7832f0655166e3f716f3e10"}}, {start: {_id:612}, end: {_id:688}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conflict generation,mental state", truncate:"", weight:1.0, description:"Self-preoccupation creates and sustains inner war through constant self-measurement.", created_at:1779139220, source_id:"chunk-c756fff1f643175625bc8f48eb702151"}}, {start: {_id:410}, end: {_id:506}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", truncate:"", keywords:"behavioral manifestation,reactive actions,social behavior,social interaction", weight:2.0, description:"Self-obsession leads to reactive social media behavior, such as anticipating negative reactions.<SEP>Self-obsession manifests in Facebook posts driven by imagined reactions and self-centered concerns.", created_at:1779184160, source_id:"chunk-c756fff1f643175625bc8f48eb702151<SEP>chunk-5c02e046d7832f0655166e3f716f3e10"}}, {start: {_id:506}, end: {_id:687}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"privilege perception,social comparison", weight:1.0, description:"Self-obsession contrasts internal self-perception with external privileges like the \"silver spoon.\"", created_at:1779139220, source_id:"chunk-c756fff1f643175625bc8f48eb702151"}}, {start: {_id:695}, end: {_id:506}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"perception,psychological impact", truncate:"", weight:2.0, description:"Self-obsession leads to an exaggerated sense of injustice, perceiving the universe as unfair.", created_at:1779139249, source_id:"chunk-1acfe53455f3d50d7655cd19bae06dae"}}, {start: {_id:693}, end: {_id:506}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"causation,negative consequences", truncate:"", weight:2.0, description:"Self-obsession causes problems and chaos to mount in life due to preoccupation with unfairness.", created_at:1779139249, source_id:"chunk-1acfe53455f3d50d7655cd19bae06dae"}}, {start: {_id:701}, end: {_id:698}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"cognitive distortion,psychological pattern", weight:1.0, description:"The perpetually insecure mind fosters obsessive self-preoccupation through constant self-criticism.", created_at:1779139275, source_id:"chunk-bed95c3be04f868de9c27e6537e903ca"}}, {start: {_id:145}, end: {_id:702}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"avoidance,distraction", truncate:"", weight:1.0, description:"Superficial self-care fails to address underlying \"suering states\" of the inner self.", created_at:1779139275, source_id:"chunk-bed95c3be04f868de9c27e6537e903ca"}}, {start: {_id:701}, end: {_id:702}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"avoidance,distraction", truncate:"", weight:1.0, description:"Superficial self-care serves as a distraction from addressing core obsessive tendencies.", created_at:1779139275, source_id:"chunk-bed95c3be04f868de9c27e6537e903ca"}}, {start: {_id:696}, end: {_id:701}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"antithesis,transformation", truncate:"", weight:1.0, description:"Authentic self-love requires transcending obsessive self-preoccupation.", created_at:1779139275, source_id:"chunk-bed95c3be04f868de9c27e6537e903ca"}}, {start: {_id:696}, end: {_id:699}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"mindfulness,self-awareness", truncate:"", weight:1.0, description:"Gentle observation enables authentic self-love by fostering mindfulness and self-awareness, replacing self-obsession.", created_at:1779139275, source_id:"chunk-bed95c3be04f868de9c27e6537e903ca"}}, {start: {_id:29}, end: {_id:712}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emergence,transformation", truncate:"", weight:1.0, description:"Witnessing chaos leads to the emergence of a new personal order.", created_at:1779139301, source_id:"chunk-468fc234a44cb0396e4202675d40e771"}}, {start: {_id:705}, end: {_id:699}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"neurological basis,scientific perspective", weight:1.0, description:"Dr. Siegel explains that observation shifts neural activity from the amygdala to the mid-prefrontal cortex.", created_at:1779139301, source_id:"chunk-468fc234a44cb0396e4202675d40e771"}}, {start: {_id:704}, end: {_id:708}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cognitive shift,neural activity", truncate:"", weight:1.0, description:"Observation reduces amygdala activity and enhances mid-prefrontal engagement.", created_at:1779139301, source_id:"chunk-468fc234a44cb0396e4202675d40e771"}}] AS row
