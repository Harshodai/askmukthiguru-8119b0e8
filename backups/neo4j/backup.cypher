UNWIND [{start: {_id:2221}, end: {_id:2228}, properties:{file_path:"unknown_source", keywords:"empowerment,vision alignment", truncate:"", weight:1.0, description:"Ekam Youth Changemakers aims to empower youth to overcome challenges and live transformed lives.", created_at:1779221494, source_id:"chunk-a7619f77eafbc391703609d89706c93c"}}, {start: {_id:2234}, end: {_id:2233}, properties:{file_path:"unknown_source", keywords:"outcome,societal impact", truncate:"", weight:1.0, description:"living a stress-free life enables individuals to create meaningful differences in the world.", created_at:1779221494, source_id:"chunk-a7619f77eafbc391703609d89706c93c"}}, {start: {_id:2369}, end: {_id:1638}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=_X5jRvqxEEo)", truncate:"", keywords:"content analysis,discussion", weight:1.0, description:"The YouTube video discusses the problem of pressure faced by the youth.", created_at:1779221574, source_id:"chunk-f6de882ef63b995a9da5918fd43ea741"}}, {start: {_id:2369}, end: {_id:2249}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=_X5jRvqxEEo)", truncate:"", keywords:"experience,impact", weight:1.0, description:"The youth of the world are experiencing various pressures affecting their lives.", created_at:1779221574, source_id:"chunk-f6de882ef63b995a9da5918fd43ea741"}}, {start: {_id:2369}, end: {_id:2242}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=_X5jRvqxEEo)", keywords:"mental health,subtype", truncate:"", weight:1.0, description:"Psychological pressure is a type of pressure related to mental stress.", created_at:1779221574, source_id:"chunk-f6de882ef63b995a9da5918fd43ea741"}}, {start: {_id:2237}, end: {_id:2369}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=_X5jRvqxEEo)", truncate:"", keywords:"experience,impact", weight:1.0, description:"The current generation is experiencing various pressures affecting their lives.", created_at:1779221575, source_id:"chunk-f6de882ef63b995a9da5918fd43ea741"}}, {start: {_id:2265}, end: {_id:2250}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=_X5jRvqxEEo)", truncate:"", keywords:"pressure handling,pressure manifestation", weight:1.0, description:"Adults who cannot handle pressure may show it on kids, impacting their lives.", created_at:1779221617, source_id:"chunk-ec30e8bcff38a8016afa767698da187c"}}, {start: {_id:2250}, end: {_id:195}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=_X5jRvqxEEo)", truncate:"", keywords:"family dynamics,pressure transfer", weight:1.0, description:"Parents may transfer their inability to handle pressure to their kids.", created_at:1779221617, source_id:"chunk-ec30e8bcff38a8016afa767698da187c"}}, {start: {_id:2250}, end: {_id:2264}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=_X5jRvqxEEo)", truncate:"", keywords:"family dynamics,pressure transfer", weight:1.0, description:"Relatives may transfer their inability to handle pressure to kids.", created_at:1779221617, source_id:"chunk-ec30e8bcff38a8016afa767698da187c"}}, {start: {_id:741}, end: {_id:2250}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=_X5jRvqxEEo)", truncate:"", keywords:"environment,pressure exposure", weight:1.0, description:"Home is where kids experience the effects of adults' pressure mishandling.", created_at:1779221617, source_id:"chunk-ec30e8bcff38a8016afa767698da187c"}}, {start: {_id:2267}, end: {_id:1193}, properties:{file_path:"unknown_source", keywords:"health components,intelligences", truncate:"", weight:1.0, description:"Health is manifested through the presence of body intelligence.", created_at:1779221841, source_id:"chunk-3372e5d9566c081ee06a41f5a3cb4448"}}, {start: {_id:784}, end: {_id:2268}, properties:{file_path:"unknown_source", keywords:"body state,experience", truncate:"", weight:1.0, description:"The human body experiences survival state when in survival mode.", created_at:1779221841, source_id:"chunk-3372e5d9566c081ee06a41f5a3cb4448"}}, {start: {_id:1193}, end: {_id:794}, properties:{file_path:"unknown_source", keywords:"health components,intelligences", truncate:"", weight:1.0, description:"Health includes heart intelligence as one of its components.", created_at:1779221841, source_id:"chunk-3372e5d9566c081ee06a41f5a3cb4448"}}, {start: {_id:784}, end: {_id:2266}, properties:{file_path:"unknown_source", keywords:"body state,experience", truncate:"", weight:1.0, description:"The human body experiences thriving state when in thriving mode.", created_at:1779221841, source_id:"chunk-3372e5d9566c081ee06a41f5a3cb4448"}}, {start: {_id:755}, end: {_id:2268}, properties:{file_path:"unknown_source", keywords:"absence,consciousness state", truncate:"", weight:1.0, description:"Survival state occurs when there is no peace in consciousness.", created_at:1779221841, source_id:"chunk-3372e5d9566c081ee06a41f5a3cb4448"}}, {start: {_id:2277}, end: {_id:1193}, properties:{file_path:"unknown_source", keywords:"health components,intelligences", truncate:"", weight:1.0, description:"Health comprises consciousness intelligence as one of its components.", created_at:1779221841, source_id:"chunk-3372e5d9566c081ee06a41f5a3cb4448"}}, {start: {_id:479}, end: {_id:784}, properties:{file_path:"unknown_source", keywords:"cellular activity,self-healing", truncate:"", weight:1.0, description:"The human body's cells work to achieve equilibrium, which is linked to healing.", created_at:1779221841, source_id:"chunk-3372e5d9566c081ee06a41f5a3cb4448"}}, {start: {_id:2267}, end: {_id:755}, properties:{file_path:"unknown_source", keywords:"connection,intelligence access", truncate:"", weight:1.0, description:"Peace allows connection to body intelligence.", created_at:1779221841, source_id:"chunk-3372e5d9566c081ee06a41f5a3cb4448"}}, {start: {_id:755}, end: {_id:2266}, properties:{file_path:"unknown_source", keywords:"consciousness state,presence", truncate:"", weight:1.0, description:"Thriving state occurs when there is peace in consciousness.", created_at:1779221842, source_id:"chunk-3372e5d9566c081ee06a41f5a3cb4448"}}, {start: {_id:1193}, end: {_id:755}, properties:{file_path:"unknown_source", keywords:"connection,manifestation", truncate:"", weight:1.0, description:"Peace is necessary to manifest health by connecting with body intelligence.", created_at:1779221842, source_id:"chunk-3372e5d9566c081ee06a41f5a3cb4448"}}] AS row
