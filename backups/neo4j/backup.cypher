UNWIND [{start: {name:"Meditation"}, end: {_id:6427}, properties:{file_path:"unknown_source", keywords:"neurological rewiring,positivity", truncate:"", weight:1.0, description:"Regular meditation practice reduces negative bias by strengthening positive neural pathways and weakening amygdala dominance.", created_at:1779560659, source_id:"chunk-1b0c6f6cf5b3451d482de925f92b2a15"}}, {start: {name:"Meditation"}, end: {_id:348}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"content source,philosophical discussion", weight:1.0, description:"The YouTube video serves as the platform for discussing meditation's role in addressing judgments and life challenges.", created_at:1779650749, source_id:"chunk-15d5c49dad57bbf0bfa887044a164738"}}, {start: {name:"Meditation"}, end: {_id:7724}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=U1qRvz3hnMA)", truncate:"", keywords:"curriculum reform,integrates", weight:1.0, description:"National education incorporates meditation to address emotional and social challenges.`", created_at:1779672227, source_id:"chunk-4e900263f52a257effc9757bdfd34e24"}}, {start: {name:"Meditation"}, end: {_id:50}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=uGosHULQQk0)", keywords:"access,life richness,meaningful connections", truncate:"", weight:2.0, description:"Meditation opens practitioners to synchronicities, enhancing their ability to perceive life's meaningful patterns.<SEP>Meditation enables access to synchronicities, fostering deeper engagement with life's opportunities.", created_at:1779728543, source_id:"chunk-07cef1cacdb43780b9533bba3a4b7ad2<SEP>chunk-e5a191d0b4c345edce809b4d1989b5be"}}, {start: {name:"Soul Sync"}, end: {_id:8129}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=X3LKG0Ycl3A)", truncate:"", keywords:"power,source", weight:1.0,