UNWIND [{_id:4056, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"UNKNOWN", truncate:"", description:"Home sustainability involves minimizing the usage of fossil fuels.", created_at:1779251016, source_id:"chunk-72b375aeb11b7bdde0823bfbfcfc6334", entity_id:"home sustainability"}}, {_id:4057, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"UNKNOWN", truncate:"", description:"The gasoline station's fuel is manufactured by Mother Earth.", created_at:1779251017, source_id:"chunk-72b375aeb11b7bdde0823bfbfcfc6334", entity_id:"gasoline station"}}, {_id:4058, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"UNKNOWN", truncate:"", description:"The state grid's electricity is manufactured by Mother Earth.", created_at:1779251017, source_id:"chunk-72b375aeb11b7bdde0823bfbfcfc6334", entity_id:"state grid"}}, {_id:4059, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"data", truncate:"", created_at:1779251881, description:"Daily fossil fuel consumption encompasses energy usage from activities like cooking, commuting, and lawnmowing.<SEP>Daily fossil fuel consumption includes activities like cooking, commuting, and lawn maintenance, tracked for reduction.<SEP>Daily fossil fuel consumption refers to the tracking of fossil fuel usage in activities like cooking, commuting, and lawn maintenance.<SEP>Daily fossil fuel consumption refers to individual usage from activities like cooking, commuting, and lawn maintenance.<SEP>Daily fossil fuel consumption includes energy used for cooking, commuting, lawn maintenance, and digital activities.", source_id:"chunk-323533a8c8c6c9eda38d56c56d637777<SEP>chunk-7c57553df2850654b5a35e1ee26c7149<SEP>chunk-69f7a386fbc619738707246584cb8e2a<SEP>chunk-b83c8b00df8935f2c00062b416bf9b2c<SEP>chunk-e1984cc91b0da578d9648e1604a3db60", entity_id:"Daily Fossil Fuel Consumption"}}, {_id:4060, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"Replenish refers to the process of restoring or regenerating natural resources like fossil fuels.", created_at:1779251035, source_id:"chunk-323533a8c8c6c9eda38d56c56d637777", entity_id:"Replenish"}}, {_id:4061, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"method", truncate:"", description:"Commuting involves transportation-related fossil fuel consumption during travel.", created_at:1779251035, source_id:"chunk-323533a8c8c6c9eda38d56c56d637777", entity_id:"Commuting"}}, {_id:4062, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", created_at:1779251620, description:"Social media groups are online communities where discussions about reducing fuel consumption occur.<SEP>Social media groups are suggested as a corrected term replacing \"social media bodies\" for better clarity and context.<SEP>Groups associated with social media, previously referred to as \"bodies\".<SEP>Social media groups are platforms used to spread awareness about sustainability and one-Earth citizen initiatives.<SEP>Social media groups are online communities where discussions about sustainability and fuel reduction strategies occur.", source_id:"chunk-323533a8c8c6c9eda38d56c56d637777<SEP>chunk-c34e4656907297cb14fbbd5e53c8e4c7<SEP>chunk-6f3e5e132510b3ae3b819a0ab2aeb318<SEP>chunk-82a35dd1f46df5834f79d95a05339385<SEP>chunk-69f7a386fbc619738707246584cb8e2a", entity_id:"Social Media Groups"}}, {_id:4063, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"artifact", truncate:"", description:"Lawnmowers are tools used for maintaining gardens, associated with fossil fuel consumption.", created_at:1779251035, source_id:"chunk-323533a8c8c6c9eda38d56c56d637777", entity_id:"Lawnmowers"}}, {_id:4064, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)<SEP>unknown_source<SEP>YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"Cooking is a daily activity contributing to fossil fuel consumption through energy use.<SEP>Cooking practices impact fossil fuel consumption through energy-efficient methods.<SEP>Cooking is viewed as a conscious act requiring emotional awareness, with joyful states producing positive outcomes for consumers.<SEP>The second stage of food involving culinary preparation influenced by emotional states.<SEP>The second stage of food involving culinary preparation influenced by emotional states.", created_at:1779652416, source_id:"chunk-323533a8c8c6c9eda38d56c56d637777<SEP>chunk-e1984cc91b0da578d9648e1604a3db60<SEP>chunk-cd2b7f6d90a6185f05822cdaaff1892f<SEP>chunk-295ece324351da0c7194c4e2d4f58e99", entity_id:"Cooking"}}, {_id:4065, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"data", truncate:"", description:"Log refers to a record or documentation of daily fossil fuel usage patterns.", created_at:1779251036, source_id:"chunk-323533a8c8c6c9eda38d56c56d637777", entity_id:"Log"}}, {_id:4066, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"Reduce fuel consumption involves strategies to minimize energy usage and dependency on fossil fuels.<SEP>Reducing fuel consumption is a key goal supported by alternatives like carpooling and public transport.", created_at:1779251084, source_id:"chunk-323533a8c8c6c9eda38d56c56d637777<SEP>chunk-c34e4656907297cb14fbbd5e53c8e4c7", entity_id:"Reduce Fuel Consumption"}}, {_id:4067, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"method", truncate:"", description:"Bikes for short distance commuting are suggested as an eco-friendly alternative inspired by Dutch practices.", created_at:1779251083, source_id:"chunk-c34e4656907297cb14fbbd5e53c8e4c7", entity_id:"Bikes for Short Distance Commuting"}}, {_id:4068, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"Sustainable living encompasses practices aimed at minimizing environmental impact and supporting planetary sustainability.<SEP>Sustainable living involves adopting practices to reduce fossil fuel dependency and promote environmental replenishment.<SEP>Sustainable living involves adopting eco-conscious habits to preserve Earth's resources.<SEP>Sustainable Living refers to practices that meet current needs without compromising future generations, emphasized in the video's message.", created_at:1779252051, source_id:"chunk-c34e4656907297cb14fbbd5e53c8e4c7<SEP>chunk-b83c8b00df8935f2c00062b416bf9b2c<SEP>chunk-e1984cc91b0da578d9648e1604a3db60<SEP>chunk-de9bbf67da91036286c4d2bcad673eb7", entity_id:"Sustainable Living"}}, {_id:4069, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"method", truncate:"", description:"Using the metro is a public transportation method recommended for reducing fuel consumption and promoting sustainability.", created_at:1779251083, source_id:"chunk-c34e4656907297cb14fbbd5e53c8e4c7", entity_id:"Using the Metro"}}, {_id:4070, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"method", truncate:"", created_at:1779251679, description:"Efficient cooking methods are listed as a way to reduce energy consumption and promote sustainability.<SEP>Efficient cooking methods are suggested to minimize energy use in household activities.<SEP>Efficient cooking practices are proposed to lower household fossil fuel consumption.", source_id:"chunk-c34e4656907297cb14fbbd5e53c8e4c7<SEP>chunk-7c57553df2850654b5a35e1ee26c7149<SEP>chunk-b83c8b00df8935f2c00062b416bf9b2c", entity_id:"Efficient Cooking Methods"}}, {_id:4071, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"method", truncate:"", description:"Carpooling is a sustainable transportation method involving shared vehicle use to reduce fuel consumption.<SEP>Carpooling is a transportation method promoting shared rides to reduce fuel consumption.<SEP>Carpooling is a transportation method suggested as an alternative to reduce fuel consumption.<SEP>Carpooling is a transportation method where multiple people share a single vehicle to reduce fuel usage.", created_at:1779251881, source_id:"chunk-c34e4656907297cb14fbbd5e53c8e4c7<SEP>chunk-7c57553df2850654b5a35e1ee26c7149<SEP>chunk-b83c8b00df8935f2c00062b416bf9b2c<SEP>chunk-e1984cc91b0da578d9648e1604a3db60", entity_id:"Carpooling"}}, {_id:4072, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"Crisis management situation refers to a hypothetical scenario contrasted with current sustainability-focused choices.<SEP>Crisis management situation describes scenarios requiring coordinated action to address emergencies or challenges.", created_at:1779251103, source_id:"chunk-c34e4656907297cb14fbbd5e53c8e4c7<SEP>chunk-9332e7a3f9bcce1d2eddd640a5990242", entity_id:"Crisis Management Situation"}}, {_id:4073, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"method", truncate:"", description:"Public transport refers to shared transportation systems like buses, trains, and metros to minimize individual fuel usage.<SEP>Public transport systems (e.g., metro) are alternatives to private vehicles for lowering emissions.<SEP>Public transport systems like the metro are recommended for minimizing individual fuel usage.<SEP>Public transport systems (e.g., metro) provide shared mobility options to minimize individual fuel consumption.", created_at:1779251881, source_id:"chunk-c34e4656907297cb14fbbd5e53c8e4c7<SEP>chunk-7c57553df2850654b5a35e1ee26c7149<SEP>chunk-b83c8b00df8935f2c00062b416bf9b2c<SEP>chunk-e1984cc91b0da578d9648e1604a3db60", entity_id:"Public Transport"}}, {_id:4074, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"method", truncate:"", description:"Browsing the net is acknowledged as a correct phrase related to internet usage.", created_at:1779251084, source_id:"chunk-c34e4656907297cb14fbbd5e53c8e4c7", entity_id:"Browse the Net"}}, {_id:4075, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"Sustainability of our planet is the collective objective driving choices for reduced environmental impact.<SEP>Sustainability of Our Planet is the overarching goal of collective efforts to ensure environmental health and resource preservation.", created_at:1779252051, source_id:"chunk-c34e4656907297cb14fbbd5e53c8e4c7<SEP>chunk-de9bbf67da91036286c4d2bcad673eb7", entity_id:"Sustainability of Our Planet"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:4076, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)<SEP>YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)<SEP>YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)<SEP>YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"concept", truncate:"", description:"Progress refers to measurable advancements in sustainable practices and initiatives.<SEP>Progress is obstructed by fear, insecurity, and lack of trust, leading to faster failure in endeavors.<SEP>Progress is debated as a potential outcome of anger-driven motivation.<SEP>Progress is debated as a potential outcome of anger-driven motivation.<SEP>Progress in life is stunted when individuals are trapped in attitudes or judgments.`", created_at:1779648935, source_id:"chunk-9332e7a3f9bcce1d2eddd640a5990242<SEP>chunk-10375887a7aa4a1c7205e37d5e7b18dc<SEP>chunk-19097bf7d5cd386b3cd384082e7f375d<SEP>chunk-9deb1452ed9eae4ab1315fc2eb8f47d0", entity_id:"Progress"}}, {_id:4077, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"UNKNOWN", truncate:"", description:"Groups facilitate inspiration for collective action toward sustainability.", created_at:1779251186, source_id:"chunk-9332e7a3f9bcce1d2eddd640a5990242", entity_id:"Inspire"}}, {_id:4078, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"A concept promoted in the video, referring to being a citizen of the planet.<SEP>One-Earth citizen is a philosophy advocating global responsibility and sustainable living.", created_at:1779251276, source_id:"chunk-6f3e5e132510b3ae3b819a0ab2aeb318<SEP>chunk-82a35dd1f46df5834f79d95a05339385", entity_id:"One-Earth Citizen"}}, {_id:4079, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"A corrected phrase from the video's content, adding \"the\" before \"Earth a chance\".", created_at:1779251211, source_id:"chunk-6f3e5e132510b3ae3b819a0ab2aeb318", entity_id:"Give the Earth a Chance"}}, {_id:4080, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"A corrected phrase from the video's content, changing \"up your heart\" to \"lift your heart\".", created_at:1779251211, source_id:"chunk-6f3e5e132510b3ae3b819a0ab2aeb318", entity_id:"Lift Your Heart"}}, {_id:4081, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"location", truncate:"", description:"A physical location where commuting is mentioned in the context of environmental impact.", created_at:1779251211, source_id:"chunk-6f3e5e132510b3ae3b819a0ab2aeb318", entity_id:"Office"}}, {_id:4082, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", created_at:1779251881, description:"Home sustainability refers to minimizing fossil fuel usage through practices like efficient cooking and reduced consumption.<SEP>Home sustainability involves practices like reducing fossil fuel usage to promote environmental replenishment.<SEP>Home sustainability refers to practices aimed at reducing fossil fuel consumption through conscious lifestyle choices.", source_id:"chunk-7c57553df2850654b5a35e1ee26c7149<SEP>chunk-c3c5777bd0aa108885f3e118f2c5486c<SEP>chunk-e1984cc91b0da578d9648e1604a3db60", entity_id:"Home Sustainability"}}, {_id:4083, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"culturaladoption", truncate:"", created_at:1779251881, description:"Bikes are recommended for short-distance commuting as a low-fuel transportation option.<SEP>Using bicycles for short-distance commuting is highlighted as an eco-friendly alternative.<SEP>The Dutch are cited as a model for integrating bikes into daily commuting.`. This is actually a correct relationship. The entity `Dutch` is classified as `location` (incorrectly) and the relationship is correct. So, the main error is the classification of `Dutch`.<SEP>The Dutch are cited as a model for integrating bikes into daily commuting.` is fine. The entity `Dutch` is the problem.", source_id:"chunk-7c57553df2850654b5a35e1ee26c7149<SEP>chunk-b83c8b00df8935f2c00062b416bf9b2c<SEP>chunk-e1984cc91b0da578d9648e1604a3db60", entity_id:"Bikes"}}, {_id:4084, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"method", truncate:"", description:"Carpooling is a transportation method involving shared rides to reduce fuel consumption and emissions.>", created_at:1779251464, source_id:"chunk-e1c71694c59d71403e858a784da45eb8", entity_id:"carpooling"}}, {_id:4085, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"uel consumption refers to the use of fuel and its environmental impact, with alternatives proposed to reduce reliance.>", created_at:1779251464, source_id:"chunk-e1c71694c59d71403e858a784da45eb8", entity_id:"uel consumption"}}, {_id:4086, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"method", truncate:"", description:"Public transport includes buses, trains, and other shared transit systems to minimize individual fuel use.>", created_at:1779251464, source_id:"chunk-e1c71694c59d71403e858a784da45eb8", entity_id:"public transport"}}, {_id:4087, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"method", truncate:"", description:"Metro systems are public transportation networks used as an alternative to private vehicles.>", created_at:1779251464, source_id:"chunk-e1c71694c59d71403e858a784da45eb8", entity_id:"metro"}}, {_id:4088, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"method", truncate:"", description:"Biking is promoted for short-distance commuting as a sustainable and fuel-efficient option.>", created_at:1779251464, source_id:"chunk-e1c71694c59d71403e858a784da45eb8", entity_id:"bikes"}}, {_id:4090, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"location", truncate:"", description:"The Dutch are referenced as a cultural example for adopting biking as a common commuting practice.><SEP>The Dutch are cited as a cultural example for adopting bike-based short-distance commuting.`. This is incorrect. `Dutch` refers to people, so it should be `Person`.<SEP>The Dutch are cited as a cultural example for adopting bike-based short-distance commuting.`<SEP>The Dutch are cited as a cultural example for adopting bike-based short-distance commuting.", created_at:1779251881, source_id:"chunk-e1c71694c59d71403e858a784da45eb8<SEP>chunk-e1984cc91b0da578d9648e1604a3db60", entity_id:"Dutch"}}, {_id:4091, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"Primary manufacturing refers to industrial processes occurring within the Earth's natural systems.>", created_at:1779251464, source_id:"chunk-e1c71694c59d71403e858a784da45eb8", entity_id:"Primary manufacturing"}}, {_id:4092, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"naturalobject", truncate:"", description:"Decomposed creatures are implied to contribute to ecological balance and seamless human living.><SEP>decomposed creatures are described as enabling seamless everyday living through their role in Earth's processes.", created_at:1779251815, source_id:"chunk-e1c71694c59d71403e858a784da45eb8<SEP>chunk-6cb316992e142f7415790af61a324272", entity_id:"decomposed creatures"}}, {_id:4093, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"UNKNOWN", truncate:"", description:"Decomposed creatures are implied to enable seamless living through ecological processes.>", created_at:1779251537, source_id:"chunk-e1c71694c59d71403e858a784da45eb8", entity_id:"seamless living"}}, {_id:4094, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"Coffee energy represents the mechanical and thermal energy required to brew coffee, derived from natural resources.", created_at:1779251564, source_id:"chunk-c3c5777bd0aa108885f3e118f2c5486c", entity_id:"Coffee Energy"}}, {_id:4095, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"Entertainment energy signifies the energy consumed by entertainment technologies, derived from natural reserves.", created_at:1779251564, source_id:"chunk-c3c5777bd0aa108885f3e118f2c5486c", entity_id:"Entertainment Energy"}}, {_id:4096, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"naturalobject", truncate:"", description:"Gasoline is a fossil fuel extracted from natural reserves, used as a transportation energy source.", created_at:1779251564, source_id:"chunk-c3c5777bd0aa108885f3e118f2c5486c", entity_id:"Gasoline"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:4097, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"Communication energy denotes the energy required for digital communication systems, originating from natural resources.", created_at:1779251564, source_id:"chunk-c3c5777bd0aa108885f3e118f2c5486c", entity_id:"Communication Energy"}}, {_id:4098, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"Chain represents a process or system integral to manufacturing and energy production, symbolizing interconnected processes in natural systems.", created_at:1779251564, source_id:"chunk-c3c5777bd0aa108885f3e118f2c5486c", entity_id:"Chain"}}, {_id:4099, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"Commuting energy refers to the energy used for transportation during daily commutes, sourced from natural processes.", created_at:1779251564, source_id:"chunk-c3c5777bd0aa108885f3e118f2c5486c", entity_id:"Commuting Energy"}}, {_id:4100, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AviNwtN1luo)", entity_type:"product", truncate:"", description:"Electricity refers to electrical power generated from natural resources and distributed via grids.<SEP>Electricity generated from fossil fuels powers household appliances and infrastructure.<SEP>Electricity is noted as a resource consumed during washing, negatively affecting Mother Earth's systems.<SEP>Electricity is noted as a resource consumed during washing, negatively affecting Mother Earth's systems.", created_at:1779666020, source_id:"chunk-c3c5777bd0aa108885f3e118f2c5486c<SEP>chunk-e1984cc91b0da578d9648e1604a3db60<SEP>chunk-3d98a7ecb8a0eae8eb12c9d7525576d1", entity_id:"Electricity"}}, {_id:4101, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"organization", truncate:"", created_at:1779251882, description:"The State Grid is the infrastructure and organization responsible for electricity distribution and management.<SEP>The state grid is the infrastructure responsible for distributing electricity, linked to energy sources from Mother Earth.<SEP>The state grid distributes electricity, relying on fossil fuels for energy supply.", source_id:"chunk-c3c5777bd0aa108885f3e118f2c5486c<SEP>chunk-69f7a386fbc619738707246584cb8e2a<SEP>chunk-e1984cc91b0da578d9648e1604a3db60", entity_id:"State Grid"}}, {_id:4102, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"location", truncate:"", description:"Gasoline stations are retail locations where fossil fuels are dispensed, sourced from Earth's manufacturing processes.<SEP>Gasoline stations are fuel distribution points linked to fossil fuel dependency.", created_at:1779251882, source_id:"chunk-69f7a386fbc619738707246584cb8e2a<SEP>chunk-e1984cc91b0da578d9648e1604a3db60", entity_id:"Gasoline Station"}}, {_id:4103, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"being a one-Earth citizen involves practicing sustainability and contributing to Earth's replenishment.", created_at:1779251815, source_id:"chunk-6cb316992e142f7415790af61a324272", entity_id:"one-Earth citizen"}}, {_id:4104, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"organization", truncate:"", description:"social media groups are platforms where individuals document and share their sustainability progress to inspire others.", created_at:1779251815, source_id:"chunk-6cb316992e142f7415790af61a324272", entity_id:"social media groups"}}, {_id:4105, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"person", truncate:"", description:"Individuals are people who practice sustainability and document their progress in social media groups to inspire others.", created_at:1779251815, source_id:"chunk-6cb316992e142f7415790af61a324272", entity_id:"individuals"}}, {_id:4106, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"method", truncate:"", description:"Commuting to the office is suggested as a sustainable living practice to reduce environmental impact.", created_at:1779251815, source_id:"chunk-6cb316992e142f7415790af61a324272", entity_id:"commute to the office"}}, {_id:4107, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"everyday living is made seamless through the contributions of decomposed creatures from Earth's processes.", created_at:1779251815, source_id:"chunk-6cb316992e142f7415790af61a324272", entity_id:"everyday living"}}, {_id:4109, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"Commute refers to daily travel between home and work, a key area for reducing fuel usage.", created_at:1779251882, source_id:"chunk-e1984cc91b0da578d9648e1604a3db60", entity_id:"Commute"}}, {_id:4110, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"Digital activities like social media and browsing contribute to energy consumption.", created_at:1779251882, source_id:"chunk-e1984cc91b0da578d9648e1604a3db60", entity_id:"Communication and Entertainment"}}, {_id:4112, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", entity_type:"concept", truncate:"", description:"Collective Choice refers to the shared decision-making process among individuals towards planetary sustainability, as emphasized in the video's message.", created_at:1779252051, source_id:"chunk-de9bbf67da91036286c4d2bcad673eb7", entity_id:"Collective Choice"}}, {_id:4115, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Our current global crisis is a phrase requiring proper punctuation when combined with \"Namaste\" to ensure clarity and grammatical correctness.", created_at:1779253312, source_id:"chunk-6621e22e95953fd207176f306376a217", entity_id:"Our current global crisis"}}, {_id:4116, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Our current is a phrase that needs punctuation when used with \"Namaste\" to maintain proper sentence structure.", created_at:1779253312, source_id:"chunk-6621e22e95953fd207176f306376a217", entity_id:"Our current"}}, {_id:4117, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Vt_CjAdzebM)", entity_type:"concept", truncate:"", description:"Text Correction Rules outline guidelines for fixing errors without altering intended meaning.<SEP>Strict guidelines for fixing text errors without altering original meaning, summarization, or style changes.<SEP>Strict guidelines for fixing text errors without altering original meaning, summarization, or style changes.", created_at:1779736616, source_id:"chunk-d57e9e7661b8c29c289bb2a8bcb7d92d<SEP>chunk-18cbd171bb5b60b25e9939f225a974d3", entity_id:"Text Correction Rules"}}, {_id:4119, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"event", truncate:"", description:"Lockdown refers to the period of quarantine that increased domestic violence due to men being at home and unable to engage in addictive behaviors.", created_at:1779254179, source_id:"chunk-4043681cb90e5032a1d66db36f936a98", entity_id:"Lockdown"}}, {_id:4120, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", entity_type:"concept", truncate:"", description:"Emotional fires that perpetrators allow to grow, contributing to violent behavior and family dysfunction.", created_at:1779254179, source_id:"chunk-4043681cb90e5032a1d66db36f936a98", entity_id:"Anger, Suspicion, Jealousy"}}, {_id:4121, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)<SEP>unknown_source<SEP>YouTube Video: 38-NgBAet1c (URL: https://www.youtube.com/watch?v=38-NgBAet1c)", entity_type:"concept", truncate:"", created_at:1779445475, description:"Domestic violence refers to the rise in abuse within families, particularly during lockdowns, perpetrated by men and affecting women and children.<SEP>Domestic violence is a form of abuse experienced by individuals and families, characterized by physical, emotional, or psychological harm.<SEP>Domestic violence is a form of abuse experienced by individuals in various demographics across all countries.", source_id:"chunk-4043681cb90e5032a1d66db36f936a98<SEP>chunk-1904f983c50eda6d8dfd79dd7f0b88ea<SEP>chunk-7f34b765e8eccb327fac73e52a1c873a", entity_id:"Domestic Violence"}}] AS row
