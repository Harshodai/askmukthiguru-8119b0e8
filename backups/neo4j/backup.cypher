UNWIND [{_id:5253, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"The thirty-third paragraph has the first word \"What\" which should be capitalized.", created_at:1779444451, source_id:"chunk-8efd1503e6ba9f556d5b29e6aef648c7", entity_id:"thirty-third paragraph"}}, {_id:5254, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"The thirty-fifth paragraph has the first word \"What\" which should be capitalized.", created_at:1779444451, source_id:"chunk-8efd1503e6ba9f556d5b29e6aef648c7", entity_id:"thirty-fifth paragraph"}}, {_id:5255, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"The thirty-fourth paragraph has the first word \"All\" which should be capitalized.", created_at:1779444451, source_id:"chunk-8efd1503e6ba9f556d5b29e6aef648c7", entity_id:"thirty-fourth paragraph"}}, {_id:5256, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"The thirty-sixth paragraph has the first word \"All\" which should be capitalized.", created_at:1779444451, source_id:"chunk-8efd1503e6ba9f556d5b29e6aef648c7", entity_id:"thirty-sixth paragraph"}}, {_id:5257, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"The thirty-seventh paragraph has the first word \"What\" which should be capitalized.", created_at:1779444451, source_id:"chunk-8efd1503e6ba9f556d5b29e6aef648c7", entity_id:"thirty-seventh paragraph"}}, {_id:5258, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"The thirty-eighth paragraph has the first word \"All\" which should be capitalized.", created_at:1779444451, source_id:"chunk-8efd1503e6ba9f556d5b29e6aef648c7", entity_id:"thirty-eighth paragraph"}}, {_id:5259, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"The thirty-ninth paragraph has the first word \"What\" which should be capitalized.", created_at:1779444451, source_id:"chunk-8efd1503e6ba9f556d5b29e6aef648c7", entity_id:"thirty-ninth paragraph"}}, {_id:5260, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"UNKNOWN", truncate:"", description:"The twenty-fifth paragraph's first word \"What\" needs to be capitalized as per the instruction.", created_at:1779444452, source_id:"chunk-8efd1503e6ba9f556d5b29e6aef648c7", entity_id:"capitalization requirement"}}, {_id:5262, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"person", truncate:"", description:"raph is a person mentioned in the video's content.", created_at:1779444535, source_id:"chunk-99755b19290cfa78847869e819a08dcc", entity_id:"raph"}}, {_id:5264, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Agony is a consequence of domestic violence within families.", created_at:1779445416, source_id:"chunk-1904f983c50eda6d8dfd79dd7f0b88ea", entity_id:"Agony"}}, {_id:5265, properties:{file_path:"unknown_source<SEP>YouTube Video: 38-NgBAet1c (URL: https://www.youtube.com/watch?v=38-NgBAet1c)", entity_type:"concept", truncate:"", description:"Cruelty results from the absence of love and manifests as domestic violence.<SEP>Cruelty is depicted as a manifestation of the absence of love and a driving force behind domestic violence.", created_at:1779445475, source_id:"chunk-1904f983c50eda6d8dfd79dd7f0b88ea<SEP>chunk-7f34b765e8eccb327fac73e52a1c873a", entity_id:"Cruelty"}}, {_id:5266, properties:{file_path:"unknown_source<SEP>YouTube Video: 38-NgBAet1c (URL: https://www.youtube.com/watch?v=38-NgBAet1c)", entity_type:"naturalobject", truncate:"", description:"The human heart is symbolically linked to the impact of domestic violence and emotional disease.<SEP>The human heart is metaphorically described as being invaded by the disease of cruelty and absence of love, leading to domestic violence.", created_at:1779445476, source_id:"chunk-1904f983c50eda6d8dfd79dd7f0b88ea<SEP>chunk-7f34b765e8eccb327fac73e52a1c873a", entity_id:"Human Heart"}}, {_id:5267, properties:{file_path:"unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"concept", truncate:"", description:"True love is idealized as a potential solution to domestic violence, associated with nurture and security.<SEP>True love is described as nourishing both partners and contrasting with the hunger for euphoric experiences.", created_at:1779556997, source_id:"chunk-1904f983c50eda6d8dfd79dd7f0b88ea<SEP>chunk-9a7c58d7cc886bef4c4d232cf5fffc42", entity_id:"True Love"}}, {_id:5269, properties:{file_path:"unknown_source<SEP>YouTube Video: 38-NgBAet1c (URL: https://www.youtube.com/watch?v=38-NgBAet1c)", entity_type:"concept", truncate:"", description:"Peaceful World represents an idealized state of harmony and security achieved through true love, contrasting with the reality of domestic violence.<SEP>A peaceful world is imagined as an ideal state where nurturing and true love prevail.", created_at:1779445476, source_id:"chunk-1904f983c50eda6d8dfd79dd7f0b88ea<SEP>chunk-7f34b765e8eccb327fac73e52a1c873a", entity_id:"Peaceful World"}}, {_id:5270, properties:{file_path:"YouTube Video: 38-NgBAet1c (URL: https://www.youtube.com/watch?v=38-NgBAet1c)", entity_type:"concept", truncate:"", description:"Pain and agony characterize the state of families experiencing domestic violence.", created_at:1779445475, source_id:"chunk-7f34b765e8eccb327fac73e52a1c873a", entity_id:"Pain and Agony"}}, {_id:5271, properties:{file_path:"YouTube Video: 38-NgBAet1c (URL: https://www.youtube.com/watch?v=38-NgBAet1c)", entity_type:"person", truncate:"", description:"Elderly individuals are among the demographic groups affected by domestic violence.", created_at:1779445475, source_id:"chunk-7f34b765e8eccb327fac73e52a1c873a", entity_id:"Elderly"}}, {_id:5272, properties:{file_path:"unknown_source<SEP>YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", description:"Purpose in life is linked to awakening consciousness and greater goals, representing a core objective.<SEP>Purpose in Life refers to the philosophical concept of having a meaningful objective or reason for existence, as discussed in the text.", created_at:1779562063, source_id:"chunk-30142fb409cd6113794311c0e52cc0fc<SEP>chunk-a9f75e7b1831f124898c085ae0393e6e", entity_id:"Purpose in Life"}}, {_id:5273, properties:{file_path:"unknown_source<SEP>YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", entity_type:"concept", truncate:"", description:"Dissatisfaction state refers to a mental condition characterized by anger and frustration, which initially provides energy but eventually consumes and destroys the individual.<SEP>Dissatisfaction state describes a psychological condition marked by anger and frustration with circumstances.<SEP>Dissatisfaction state is described as leading to self-destruction through disconnected consciousness.<SEP>Dissatisfaction state leads to destructive behavior and eventual consumption of the individual.<SEP>Dissatisfaction state described in the video transcript as detrimental to achieving goals.", created_at:1779447897, source_id:"chunk-fd0cf329c3a40648553339d60f0ac0b7<SEP>chunk-e53aa20908f0e3dc300b2226e52897f3<SEP>chunk-390580a8c4bf54c69179d629a432021f<SEP>chunk-e27c90d3f030c932363441c1ed78bf62<SEP>chunk-c20a2f436d20bbb7182961653d101544", entity_id:"Dissatisfaction State"}}, {_id:5274, properties:{file_path:"unknown_source<SEP>YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", entity_type:"concept", truncate:"", description:"Future leaders are individuals destined to lead in politics, business, spirituality, and social work, requiring awakened consciousness to drive positive change.<SEP>Future leaders are individuals destined to guide societal aspects like politics, business, and spirituality.<SEP>Future leaders are positioned to influence politics, business, spirituality, and social work through awakened consciousness.", created_at:1779447400, source_id:"chunk-fd0cf329c3a40648553339d60f0ac0b7<SEP>chunk-e53aa20908f0e3dc300b2226e52897f3<SEP>chunk-e27c90d3f030c932363441c1ed78bf62", entity_id:"Future Leaders"}}, {_id:5275, properties:{file_path:"unknown_source<SEP>YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", entity_type:"concept", truncate:"", created_at:1779447675, description:"Greater purpose in life refers to a higher existential mission driving meaningful leadership.<SEP>A greater purpose in life is the motivating force driving future leaders to create positive change.<SEP>A concept emphasizing a higher calling or mission beyond individual interests.", source_id:"chunk-fd0cf329c3a40648553339d60f0ac0b7<SEP>chunk-e27c90d3f030c932363441c1ed78bf62<SEP>chunk-18bc78e6744f00b7477a42dba8a8367d", entity_id:"Greater Purpose in Life"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:5276, properties:{file_path:"unknown_source<SEP>YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", entity_type:"concept", truncate:"", description:"Social work encompasses community service and societal welfare initiatives.<SEP>Social work is a domain where future leaders apply awakened consciousness to address societal needs.<SEP>Social Work is a domain where the leaders of this world are instructed to lead.<SEP>A field focused on community service and social justice mentioned in the speech.", created_at:1779447676, source_id:"chunk-fd0cf329c3a40648553339d60f0ac0b7<SEP>chunk-e27c90d3f030c932363441c1ed78bf62<SEP>chunk-19ac6161864512557b2b640d349a424f<SEP>chunk-18bc78e6744f00b7477a42dba8a8367d", entity_id:"Social Work"}}, {_id:5277, properties:{file_path:"unknown_source<SEP>YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", entity_type:"person", truncate:"", description:"A disconnected person takes a path of destruction and hurt, leading to self-destructive behavior due to anger or frustration with their circumstances.<SEP>A disconnected person is characterized by pursuing destructive paths and being consumed by dissatisfaction.", created_at:1779447400, source_id:"chunk-e53aa20908f0e3dc300b2226e52897f3<SEP>chunk-e27c90d3f030c932363441c1ed78bf62", entity_id:"Disconnected Person"}}, {_id:5278, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The vicious cycle prevents finding meaning or purpose in life.", created_at:1779447130, source_id:"chunk-30142fb409cd6113794311c0e52cc0fc", entity_id:"Meaning in Life"}}, {_id:5279, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)<SEP>unknown_source", entity_type:"concept", truncate:"", description:"Disconnected consciousness is linked to destructive behavioral paths in the analyzed text.<SEP>A state of disconnection from thoughts, loved ones, and the world, leading to life problems.", created_at:1779518200, source_id:"chunk-390580a8c4bf54c69179d629a432021f<SEP>chunk-99901f0ad74048b182a8c4faaaf9f4dd", entity_id:"Disconnected Consciousness"}}, {_id:5280, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", entity_type:"content", truncate:"", description:"YouTube Video titled \"odNtpKqbCQo\" contains text requiring correction for homophones, domain terms, and punctuation.", created_at:1779447232, source_id:"chunk-390580a8c4bf54c69179d629a432021f", entity_id:"YouTube Video (odNtpKqbCQo)"}}, {_id:5282, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", entity_type:"concept", truncate:"", description:"Connected people are those whose consciousness is awakened to peace, love, and greater purpose in life.", created_at:1779447400, source_id:"chunk-e27c90d3f030c932363441c1ed78bf62", entity_id:"Connected People"}}, {_id:5283, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", entity_type:"concept", truncate:"", description:"The next generation leaders are the same as the leaders of this world, who are called to lead in politics, business, spirituality, and social work.<SEP>Future leaders who are expected to shape the world through awakened consciousness and purpose.", created_at:1779447675, source_id:"chunk-19ac6161864512557b2b640d349a424f<SEP>chunk-18bc78e6744f00b7477a42dba8a8367d", entity_id:"Next Generation Leaders"}}, {_id:5284, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", entity_type:"concept", truncate:"", description:"The leaders of this world are identified as the next generation leaders, addressed in a message about leadership in various domains.", created_at:1779447507, source_id:"chunk-19ac6161864512557b2b640d349a424f", entity_id:"Leaders of This World"}}, {_id:5285, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", entity_type:"UNKNOWN", truncate:"", description:"The vicious cycle of addictions results in the loss of meaning and purpose in life for the individual.", created_at:1779447637, source_id:"chunk-fafff025e01a29bbcee9969fc4559382", entity_id:"Meaning/Purpose"}}, {_id:5286, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", entity_type:"concept", truncate:"", description:"Hypothetical scenarios where the user might assume errors or intended content in the text despite its grammatical correctness.", created_at:1779447767, source_id:"chunk-270244bc8f269958a2c5fc40e2746175", entity_id:"User Assumptions"}}, {_id:5287, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", entity_type:"data", truncate:"", description:"A list of words including \"dissatisfied,\" \"disconnected,\" \"destruction,\" and others, all verified as correct in the text.", created_at:1779447815, source_id:"chunk-365597a058331421bbb5ea9019f3c055", entity_id:"Listed Words"}}, {_id:5288, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", entity_type:"data", truncate:"", description:"Video ID \"odNtpKqbCQo\" associated with the YouTube Video.", created_at:1779447897, source_id:"chunk-c20a2f436d20bbb7182961653d101544", entity_id:"odNtpKqbCQo"}}, {_id:5289, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", entity_type:"concept", truncate:"", description:"User argument about the prompt's scope regarding fixing transcription errors versus enhancing text with domain terms.", created_at:1779447897, source_id:"chunk-c20a2f436d20bbb7182961653d101544", entity_id:"Prompt Scope"}}, {_id:5290, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", entity_type:"content", truncate:"", description:"A TED prompt discussing concepts like consciousness, purpose, and spiritual practices.", created_at:1779448004, source_id:"chunk-67c71335838e7d9c72ee9c00d04337d4", entity_id:"TED Prompt"}}, {_id:5293, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=RvgN5Mfbd5A)", entity_type:"event", truncate:"", description:"Feeling lonely in the middle of a conversation is discussed.<SEP>A conversation with seekers of varied ages led to reflections on true friendship.", created_at:1779675622, source_id:"chunk-5a1740daf11f031bb2f4e4877b90a316<SEP>chunk-f9137367b6fc0c1e310ef8df615fc408", entity_id:"Conversation"}}, {_id:5294, properties:{file_path:"YouTube Video: nen-DB_tz4M (URL: https://www.youtube.com/watch?v=nen-DB_tz4M)", entity_type:"concept", truncate:"", description:"Inability to connect is identified as the root cause of loneliness, stemming from unresolved emotions or preoccupation with thought-created miseries.", created_at:1779449718, source_id:"chunk-2bfc54003e79d44fa2a7ce956b569e44", entity_id:"Inability to Connect"}}, {_id:5295, properties:{file_path:"YouTube Video: nen-DB_tz4M (URL: https://www.youtube.com/watch?v=nen-DB_tz4M)", entity_type:"concept", truncate:"", description:"Confinement in thinking refers to mental self-absorption that alienates individuals from others and perpetuates loneliness.", created_at:1779449718, source_id:"chunk-2bfc54003e79d44fa2a7ce956b569e44", entity_id:"Confinement in Thinking"}}, {_id:5296, properties:{file_path:"YouTube Video: nen-DB_tz4M (URL: https://www.youtube.com/watch?v=nen-DB_tz4M)", entity_type:"concept", truncate:"", description:"Unresolved mental processes like hurt, insecurity, fear, or anger are described as barriers to present-moment connection.", created_at:1779449718, source_id:"chunk-2bfc54003e79d44fa2a7ce956b569e44", entity_id:"Unresolved Mental Processes"}}, {_id:5297, properties:{file_path:"YouTube Video: nen-DB_tz4M (URL: https://www.youtube.com/watch?v=nen-DB_tz4M)", entity_type:"artifac