UNWIND [{start: {_id:5426}, end: {_id:5424}, properties:{file_path:"unknown_source", keywords:"spiritual journey,transcendence", truncate:"", weight:1.0, description:"Mothers seek to become true mystics by moving beyond limited perspectives.", created_at:1779512062, source_id:"chunk-c195d5abc160d6408ccad089d03fdf8f"}}, {start: {_id:2399}, end: {_id:2454}, properties:{file_path:"unknown_source", keywords:"integration,omnipresence", truncate:"", weight:1.0, description:"The enlightened state integrates bliss into all aspects of consciousness.", created_at:1779512062, source_id:"chunk-c195d5abc160d6408ccad089d03fdf8f"}}, {start: {_id:5423}, end: {_id:5424}, properties:{file_path:"unknown_source<SEP>YouTube Video: HZIuHUGmnGY (URL: https://www.youtube.com/watch?v=HZIuHUGmnGY)", keywords:"blissful experience,enlightened awareness,spiritual transformation,state of being", truncate:"", weight:2.0, description:"True mystic exists in the state of Ananda, which is pure bliss.<SEP>Ananda is the defining experience that transforms one into a true mystic by transcending mental limitations.", created_at:1779512075, source_id:"chunk-c195d5abc160d6408ccad089d03fdf8f<SEP>chunk-5da4be811aa540e35dbc3127e30549e4"}}, {start: {_id:2454}, end: {_id:2939}, properties:{file_path:"unknown_source<SEP>YouTube Video: HZIuHUGmnGY (URL: https://www.youtube.com/watch?v=HZIuHUGmnGY)", keywords:"holistic experience,integration,permeation,unity", truncate:"", weight:2.0, description:"Bliss permeates every sensory experience in the enlightened state.<SEP>The enlightened state integrates sensory experiences into the experience of universal bliss.", created_at:1779512075, source_id:"chunk-c195d5abc160d6408ccad089d03fdf8f<SEP>chunk-5da4be811aa540e35dbc3127e30549e4"}}, {start: {_id:5423}, end: {_id:2399}, properties:{file_path:"unknown_source", keywords:"aliveness,bliss,experience,reasonlessness", truncate:"", weight:2.0, description:"Ananda is the experience of bliss without any reason or future projection.<SEP>Ananda is filled with bliss, where every cell feels alive and blissful.", created_at:1779512095, source_id:"chunk-c195d5abc160d6408ccad089d03fdf8f<SEP>chunk-16505689511452878f9de53f0eb16c6e"}}, {start: {_id:2454}, end: {_id:5425}, properties:{file_path:"unknown_source<SEP>YouTube Video: HZIuHUGmnGY (URL: https://www.youtube.com/watch?v=HZIuHUGmnGY)", keywords:"holistic experience,integration,permeation,unity", truncate:"", weight:2.0, description:"Bliss permeates every mental experience in the enlightened state.<SEP>The enlightened state integrates mental experiences into the experience of universal bliss.", created_at:1779512075, source_id:"chunk-c195d5abc160d6408ccad089d03fdf8f<SEP>chunk-5da4be811aa540e35dbc3127e30549e4"}}, {start: {_id:5423}, end: {_id:5428}, properties:{file_path:"YouTube Video: HZIuHUGmnGY (URL: https://www.youtube.com/watch?v=HZIuHUGmnGY)", truncate:"", keywords:"defining characteristic,philosophical concept", weight:1.0, description:"Ananda is characterized by bliss experienced without reason, conclusions, or future projections.", created_at:1779512075, source_id:"chunk-5da4be811aa540e35dbc3127e30549e4"}}, {start: {_id:5423}, end: {_id:2939}, properties:{file_path:"unknown_source<SEP>YouTube Video: R0bGNxoJ4sM (URL: https://www.youtube.com/watch?v=R0bGNxoJ4sM)", keywords:"blissful awareness,mindfulness,sensory attention,sensory perception", truncate:"", weight:2.0, description:"Ananda involves bringing attention to sensory details, enhancing mindfulness.<SEP>The state of Ananda includes heightened attention to sensory details like hearing and intricate visual perception.", created_at:1779512136, source_id:"chunk-16505689511452878f9de53f0eb16c6e<SEP>chunk-b898618f68efd08df9f5924199c43f87"}}, {start: {_id:5423}, end: {_id:5429}, properties:{file_path:"YouTube Video: R0bGNxoJ4sM (URL: https://www.youtube.com/watch?v=R0bGNxoJ4sM)", truncate:"", keywords:"conceptual framework,spiritual practice", weight:1.0, description:"Early Neodo Harnam is mentioned as part of the teachings related to the state of Ananda.", created_at:1779512137, source_id:"chunk-b898618f68efd08df9f5924199c43f87"}}, {start: {_id:5423}, end: {_id:348}, properties:{file_path:"YouTube Video: R0bGNxoJ4sM (URL: https://www.youtube.com/watch?v=R0bGNxoJ4sM)", truncate:"", keywords:"content source,spiritual teachings", weight:1.0, description:"The YouTube Video discusses the state of Ananda and its characteristics as a spiritual experience.", created_at:1779512137, source_id:"chunk-b898618f68efd08df9f5924199c43f87"}}, {start: {_id:1474}, end: {_id:234}, properties:{file_path:"unknown_source", keywords:"experiences,spiritual realization", truncate:"", weight:1.0, description:"The narrator describes awakening as a foundational spiritual experience.", created_at:1779512383, source_id:"chunk-a0c2f5841754cfed02a33d6f3e39905a"}}, {start: {_id:234}, end: {_id:5431}, properties:{file_path:"unknown_source", keywords:"experiences,transcendent states", truncate:"", weight:1.0, description:"The narrator reports spontaneous experiences of timeless awareness.", created_at:1779512383, source_id:"chunk-a0c2f5841754cfed02a33d6f3e39905a"}}, {start: {_id:234}, end: {_id:5432}, properties:{file_path:"unknown_source", truncate:"", keywords:"experiences,non-judgmental perception", weight:1.0, description:"The narrator describes observing reality without mental commentary.", created_at:1779512383, source_id:"chunk-a0c2f5841754cfed02a33d6f3e39905a"}}, {start: {_id:5430}, end: {_id:234}, properties:{file_path:"unknown_source", keywords:"ego dissolution,experiences", truncate:"", weight:1.0, description:"The narrator recounts losing personal identity in certain states.", created_at:1779512383, source_id:"chunk-a0c2f5841754cfed02a33d6f3e39905a"}}, {start: {_id:5433}, end: {_id:234}, properties:{file_path:"unknown_source", keywords:"cosmic unity,identifies with", truncate:"", weight:1.0, description:"The narrator claims to embody universal energy beyond boundaries.", created_at:1779512383, source_id:"chunk-a0c2f5841754cfed02a33d6f3e39905a"}}, {start: {_id:5434}, end: {_id:5433}, properties:{file_path:"unknown_source<SEP>YouTube Video: ds6FM6QEDWM (URL: https://www.youtube.com/watch?v=ds6FM6QEDWM)", keywords:"origin,spiritual framework,spiritual teachings,universal consciousness", truncate:"", weight:2.0, description:"The journeys emerge from the narrator's transcendent states of consciousness.<SEP>The Journeys are rooted in experiences of the universe as an undivided, eternal flow of awareness.", created_at:1779512403, source_id:"chunk-a0c2f5841754cfed02a33d6f3e39905a<SEP>chunk-ef58d1ac43cade418f738ee9bfcca18c"}}, {start: {_id:5434}, end: {_id:81}, properties:{file_path:"YouTube Video: ds6FM6QEDWM (URL: https://www.youtube.com/watch?v=ds6FM6QEDWM)", truncate:"", keywords:"consciousness exploration,spiritual experience", weight:1.0, description:"The Narrator's awakening experiences directly inform and generate the Five Awakenings Journeys framework.", created_at:1779512403, source_id:"chunk-ef58d1ac43cade418f738ee9bfcca18c"}}, {start: {_id:81}, end: {_id:5435}, properties:{file_path:"YouTube Video: ds6FM6QEDWM (URL: https://www.youtube.com/watch?v=ds6FM6QEDWM)", truncate:"", keywords:"spiritual experience,transcendence", weight:1.0, description:"The Narrator describes experiencing timeless, boundless states of awareness.", created_at:1779512403, source_id:"chunk-ef58d1ac43cade418f738ee9bfcca18c"}}, {start: {_id:5430}, end: {_id:81}, properties:{file_path:"YouTube Video: ds6FM6QEDWM (URL: https://www.youtube.com/watch?v=ds6FM6QEDWM)", keywords:"self-realization,unity", truncate:"", weight:1.0, description:"The Narrator recounts dissolving self-identity during heightened states of consciousness.", created_at:1779512403, source_id:"chunk-ef58d1ac43cade418f738ee9bfcca18c"}}, {start: {_id:5434}, end: {_id:5435}, properties:{file_path:"YouTube Video: ds6FM6QEDWM (URL: https://www.youtube.com/watch?v=ds6FM6QEDWM)", truncate:"", keywor