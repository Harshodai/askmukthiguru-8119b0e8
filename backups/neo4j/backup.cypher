UNWIND [{_id:3173, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=y4ZR5U8VuQY)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=AviNwtN1luo)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=zGhlBQ8iWl4)", entity_type:"concept", truncate:"", description:"New World is a concept mentioned alongside Old World History in the text.<SEP>New World is a concept mentioned alongside Old World in the opening data.<SEP>Represents a modern or evolving paradigm mentioned in the video, juxtaposed with the Old World.<SEP>The new world represents a transformative societal and environmental era requiring innovative approaches and collective consciousness.<SEP>The new world represents a transformative societal and environmental era requiring innovative approaches and collective consciousness.<SEP>New world refers to a future society built on equality and progressive values.<SEP>New world refers to a future society built on equality and progressive values.", created_at:1779701484, source_id:"chunk-c095541368132f0551b7c47961463ae4<SEP>chunk-c16f5f4b48ff6b98d252679350bc5712<SEP>chunk-64d54b3366d8ca0b06a5cb55c9bd5e59<SEP>chunk-3d98a7ecb8a0eae8eb12c9d7525576d1<SEP>chunk-c2a3583743d6818c48f0ebcba32019d3", entity_id:"New World"}}, {_id:3174, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=y4ZR5U8VuQY)", entity_type:"concept", truncate:"", description:"Job market is referenced in the context of career-related content in the speech.", created_at:1779190090, source_id:"chunk-c095541368132f0551b7c47961463ae4", entity_id:"Job Market"}}, {_id:3175, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=y4ZR5U8VuQY)", entity_type:"method", truncate:"", description:"Speech writing is the process of creating the transcript content.", created_at:1779190090, source_id:"chunk-c095541368132f0551b7c47961463ae4", entity_id:"Speech Writing"}}, {_id:3176, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=y4ZR5U8VuQY)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jW3JDLY0cDA)<SEP>YouTube Video: LYm7oczfWEk (URL: https://www.youtube.com/watch?v=LYm7oczfWEk)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"content", truncate:"", description:"Transcript refers to the corrected written version of the speech.<SEP>The textual content of the YouTube video, including corrections and annotations from multiple passes.<SEP>The YouTube video's transcript discussing the Oneness Yoga Challenge and containing stylistic critiques like repetition and informal phrasing.<SEP>Transcript includes phrases such as \"But it did not happen then; you couldn't change that person,\" \"But now, with your consciousness being transformed, you would be able to create the change in that person,\" and others, which are being revised for clarity and readability.", created_at:1779669157, source_id:"chunk-c095541368132f0551b7c47961463ae4<SEP>chunk-d0497b4532233dee8d4d35231ced73d4<SEP>chunk-1c57270923c0b9f6969285d11c29b4d9<SEP>chunk-b56929fa3724f6c3aa9b138899e446f7", entity_id:"Transcript"}}, {_id:3177, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=y4ZR5U8VuQY)", entity_type:"event", truncate:"", description:"Spiritual/career talk is the event type for which the transcript is prepared.", created_at:1779190090, source_id:"chunk-c095541368132f0551b7c47961463ae4", entity_id:"Spiritual/Career Talk"}}, {_id:3178, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"event", truncate:"", description:"Obon is a Japanese Buddhist festival honoring ancestors, previously misheard as \"Born\" in the text.<SEP>Obon is a Japanese Buddhist festival honoring ancestors, involving rituals to connect with the departed.<SEP>Obon is a Japanese festival to honor and revere ancestors, refle