UNWIND [{start: {_id:417}, end: {_id:434}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"employer-employee,management", truncate:"", weight:1.0, description:"Jaya is the leader of her organization with problematic management style.", created_at:1779137692, source_id:"chunk-c0eee090a2741e82903b80d77573da86"}}, {start: {_id:417}, end: {_id:431}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional state,motivation", truncate:"", weight:1.0, description:"Rage drives Jaya's behavior and isolation.", created_at:1779137693, source_id:"chunk-c0eee090a2741e82903b80d77573da86"}}, {start: {_id:417}, end: {_id:436}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"interpersonal conflict,legacy", truncate:"", weight:1.0, description:"Resentment toward her mother affects all her relationships.", created_at:1779137693, source_id:"chunk-c0eee090a2741e82903b80d77573da86"}}, {start: {_id:432}, end: {_id:417}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"introspection,self-discovery,transformation", truncate:"", weight:2.0, description:"Meditation triggers Jaya's metamorphosis and self-awareness.<SEP>During deep meditation, Jaya realizes her emotional disconnect and inability to form meaningful connections.", created_at:1779183782, source_id:"chunk-c0eee090a2741e82903b80d77573da86<SEP>chunk-0e5b03097ca1fd70284be6d33317832d"}}, {start: {_id:430}, end: {_id:417}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional impact,metaphorical burden", truncate:"", weight:1.0, description:"Childhood trauma metaphorically described as harmful \"radioactive waste.\"", created_at:1779137693, source_id:"chunk-c0eee090a2741e82903b80d77573da86"}}, {start: {_id:417}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"literary work,narrative source", truncate:"", weight:1.0, description:"Jaya's story is presented through the source document \"The_Four_Sacred_Secrets.pdf.\"", created_at:1779137693, source_id:"chunk-c0eee090a2741e82903b80d77573da86"}}, {start: {_id:417}, end: {_id:437}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"self-discovery,transformation", truncate:"", weight:1.0, description:"Jaya undergoes metamorphosis through deep meditation, leading to self-discovery.", created_at:1779137693, source_id:"chunk-c0eee090a2741e82903b80d77573da86"}}, {start: {_id:438}, end: {_id:439}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional choice,family conflict,hatred,potential reconciliation", truncate:"", weight:2.0, description:"Andrew harbors deep hatred toward his father due to past hurts, which affects his relationships.<SEP>Andrew considers reconciliation with his father as a future option after healing, prioritizing mental health and family well-being.", created_at:1779137735, source_id:"chunk-dd609ab9c79e0fc5514db3c901de7f50<SEP>chunk-faa97c15f888df1c3373e6c7826983c8"}}, {start: {_id:438}, end: {_id:440}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional impact,marital relationship", weight:1.0, description:"Andrew's anger toward his father bleeds into his relationship with his wife, as seen in his behavior like ordering lunch.", created_at:1779137719, source_id:"chunk-dd609ab9c79e0fc5514db3c901de7f50"}}, {start: {_id:438}, end: {_id:442}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conflict,emotional distress", truncate:"", weight:1.0, description:"Andrew's anger and frustration with his wife's choices create a strained relationship, as seen in his reactions to her decisions.", created_at:1779137735, source_id:"chunk-faa97c15f888df1c3373e6c7826983c8"}}, {start: {_id:438}, end: {_id:377}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"denial,emotional impact,self-destruction,trauma", truncate:"", weight:2.0, description:"Andrew's unresolved emotional wounds manifest as self-sabotage in his career and family life.<SEP>Andrew?s anger and resistance to vulnerability are rooted in a wounded child state fueled by unprocessed pain.", created_at:1779179147, source_id:"chunk-faa97c15f888df1c3373e6c7826983c8<SEP>chunk-25634a7e16db511e9e5b4a8597da99fd"}}, {start: {_id:438}, end: {_id:441}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional healing,self-liberation", truncate:"", weight:1.0, description:"Andrew resolves to confront and overcome his inner pain to achieve emotional freedom.", created_at:1779137735, source_id:"chunk-faa97c15f888df1c3373e6c7826983c8"}}, {start: {_id:438}, end: {_id:443}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"meditation practice,mental clarity", truncate:"", weight:4.0, description:"Andrew engaged in silent meditation to achieve mental clarity and clarity of memories.\"<SEP>Andrew engaged in silent meditation to achieve mental clarity and clarity of memories.", created_at:1779137763, source_id:"chunk-7b7a166e2f9193b1ff8c08a022ddcedc"}}, {start: {_id:438}, end: {_id:444}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional healing,spiritual presence", truncate:"", weight:1.0, description:"Andrew felt a sacred presence permeating his life, leading to emotional healing and forgiveness.", created_at:1779137784, source_id:"chunk-a9d020dcb738c9a9aed8990751ac8667"}}, {start: {_id:438}, end: {_id:446}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"childhood trauma,emotional core", truncate:"", weight:1.0, description:"Andrew's behaviors stemmed from his inner child's wounded state, driven by a need for love and acceptance.", created_at:1779137784, source_id:"chunk-a9d020dcb738c9a9aed8990751ac8667"}}, {start: {_id:438}, end: {_id:445}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"business success,personal growth", truncate:"", weight:1.0, description:"Andrew's business prospered after his emotional healing, indicating a connection between personal growth and professional success.", created_at:1779137784, source_id:"chunk-a9d020dcb738c9a9aed8990751ac8667"}}, {start: {_id:438}, end: {_id:82}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"abuse,injustice,trauma", truncate:"", weight:1.0, description:"Andrew's anger and resistance stem from his father's injustices and abuse, which he initially associated with condoning the wrongdoings.", created_at:1779137784, source_id:"chunk-a9d020dcb738c9a9aed8990751ac8667"}}, {start: {_id:438}, end: {_id:417}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"comparison,contrasting lives,contrasting paths,emotional states", truncate:"", weight:2.0, description:"Andrew and Jaya represent two different approaches to dealing with emotional wounds and love.<SEP>Jaya?s masked success contrasts with Andrew?s overt emotional struggles, highlighting different responses to childhood wounds.", created_at:1779179148, source_id:"chunk-ba4ba0d6f181ef0bbd4fc17f6bc9ea4d<SEP>chunk-25634a7e16db511e9e5b4a8597da99fd"}}, {start: {_id:417}, end: {_id:4}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"narrative subject,source", truncate:"", weight:1.0, description:"Jaya's story is featured in The Four Sacred Secrets.pdf as an example of emotional disconnection.", created_at:1779137809, source_id:"chunk-ba4ba0d6f181ef0bbd4fc17f6bc9ea4d"}}, {start: {_id:438}, end: {_id:447}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"business growth,personal growth", truncate:"", weight:1.0, description:"Andrew's healing led to the growth of his spare-auto-parts business and reduced anxiety.", created_at:1779137809, source_id:"chunk-ba4ba0d6f181ef0bbd4fc17f6bc9ea4d"}}] AS row
