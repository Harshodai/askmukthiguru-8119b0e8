UNWIND [{start: {_id:5882}, end: {_id:5885}, properties:{file_path:"unknown_source", keywords:"breath regulation,mindfulness", truncate:"", weight:1.0, description:"Conscious breathing is a foundational technique for achieving the serene mind state.", created_at:1779552036, source_id:"chunk-48f438418db1330dddb1b4a3303306e1"}}, {start: {_id:5883}, end: {_id:5886}, properties:{file_path:"unknown_source", keywords:"focus,visualization", truncate:"", weight:1.0, description:"The flame is initially visualized at the eyebrow center to concentrate attention.", created_at:1779552036, source_id:"chunk-48f438418db1330dddb1b4a3303306e1"}}, {start: {_id:1843}, end: {_id:5887}, properties:{file_path:"unknown_source", keywords:"non-judgment,observation", truncate:"", weight:1.0, description:"Emotions are recognized and observed without attachment during the practice.", created_at:1779552036, source_id:"chunk-48f438418db1330dddb1b4a3303306e1"}}, {start: {_id:5883}, end: {_id:5888}, properties:{file_path:"unknown_source", keywords:"inner stillness,mental focus", truncate:"", weight:1.0, description:"The flame is mentally moved to the brain's center to deepen meditative absorption.", created_at:1779552037, source_id:"chunk-48f438418db1330dddb1b4a3303306e1"}}, {start: {_id:5882}, end: {_id:5884}, properties:{file_path:"YouTube Video: igSp4H0OWLE (URL: https://www.youtube.com/watch?v=igSp4H0OWLE)", truncate:"", keywords:"breathing technique,duration", weight:1.0, description:"Conscious breathing involves three cycles of breath to enhance the serene state.", created_at:1779552070, source_id:"chunk-511a319a40b03fc2d48c14b1ec8da740"}}, {start: {_id:2003}, end: {_id:5883}, properties:{file_path:"YouTube Video: igSp4H0OWLE (URL: https://www.youtube.com/watch?v=igSp4H0OWLE)", keywords:"concentration,visualization", truncate:"", weight:1.0, description:"The Eyebrow Center is where the practitioner visualizes a flame to enhance focus.", created_at:1779552070, source_id:"chunk-511a319a40b03fc2d48c14b1ec8da740"}}, {start: {_id:5895}, end: {_id:1329}, properties:{file_path:"unknown_source", keywords:"emotional connection,gratitude", truncate:"", weight:2.0, description:"Focusing on the heart center facilitates connection with people who impacted the practitioner.<SEP>Focusing on the heart center facilitates connection with people who impacted the practitioner.", created_at:1779552282, source_id:"chunk-43e5b5923e8d509b9e9edf60b61ff56b"}}, {start: {_id:2003}, end: {_id:5894}, properties:{file_path:"unknown_source<SEP>YouTube Video: k0GsZxWhjSE (URL: https://www.youtube.com/watch?v=k0GsZxWhjSE)", truncate:"", keywords:"abundance,abundance manifestation,symbolic visualization,visualization", weight:3.0, description:"The golden lotus in the eyebrow center symbolizes the creation of abundance and life enrichment.<SEP>The golden lotus in the eyebrow center symbolizes the creation of abundance and life enrichment.<SEP>The golden lotus at the eyebrow center represents the creation of abundance and enrichment.", created_at:1779552365, source_id:"chunk-43e5b5923e8d509b9e9edf60b61ff56b<SEP>chunk-4c6054ccc3bee7f9d86c600fc50b5dc7"}}, {start: {_id:5894}, end: {_id:1329}, properties:{file_path:"unknown_source", keywords:"energy flow,interconnectedness", truncate:"", weight:2.0, description:"The lotus visualization channels abundance through the Web of Life to others.<SEP>The lotus visualization channels abundance through the Web of Life to others.", created_at:1779552283, source_id:"chunk-43e5b5923e8d509b9e9edf60b61ff56b"}}, {start: {_id:3760}, end: {_id:731}, properties:{file_path:"unknown_source<SEP>YouTube Video: k0GsZxWhjSE (URL: https://www.youtube.com/watch?v=k0GsZxWhjSE)", truncate:"", keywords:"awakening,consciousness,consciousness foundation,spiritual legacy", weight:3.0, description:"Brahma is awakened through seeds planted during the Limitless Field Meditation.<SEP>Brahma is the seat of awakening, which is cultivated during the Limitless Field Meditation.<SEP>Brahma is awakened through seeds planted during the Limitless Field Meditation.", created_at:1779552283, source_id:"chunk-43e5b5923e8d509b9e9edf60b61ff56b<SEP>chunk-e0dd55dc92949c274e0507097e274123"}}, {start: {_id:5893}, end: {_id:3760}, properties:{file_path:"unknown_source<SEP>YouTube Video: k0GsZxWhjSE (URL: https://www.youtube.com/watch?v=k0GsZxWhjSE)", keywords:"awakening,consciousness expansion,nurturing,practice", truncate:"", weight:4.0, description:"The practice activates Brahma as the seat of awakening for higher consciousness realms.<SEP>The Abundant Life Practice involves awakening the mystical Brahma and nurturing the seeds in consciousness.<SEP>The Abundant Life Practice is a method used to nurture Brahma and access higher realms.<SEP>The practice activates Brahma as the seat of awakening for higher consciousness realms.", created_at:1779552285, source_id:"chunk-43e5b5923e8d509b9e9edf60b61ff56b<SEP>chunk-e0dd55dc92949c274e0507097e274123"}}, {start: {_id:5895}, end: {_id:5896}, properties:{file_path:"YouTube Video: k0GsZxWhjSE (URL: https://www.youtube.com/watch?v=k0GsZxWhjSE)", truncate:"", keywords:"connection,light", weight:1.0, description:"The Heart Center is connected to people through rays of light.", created_at:1779552257, source_id:"chunk-e0dd55dc92949c274e0507097e274123"}}, {start: {_id:5893}, end: {_id:5895}, properties:{file_path:"YouTube Video: k0GsZxWhjSE (URL: https://www.youtube.com/watch?v=k0GsZxWhjSE)", keywords:"connection,observation", truncate:"", weight:1.0, description:"The Abundant Life Practice includes observing the heart center and connecting to people via rays of light.", created_at:1779552283, source_id:"chunk-e0dd55dc92949c274e0507097e274123"}}, {start: {_id:5893}, end: {_id:731}, properties:{file_path:"YouTube Video: k0GsZxWhjSE (URL: https://www.youtube.com/watch?v=k0GsZxWhjSE)", keywords:"meditation,practice", truncate:"", weight:1.0, description:"The Abundant Life Practice is a practice that follows the Limitless Field Meditation.", created_at:1779552283, source_id:"chunk-e0dd55dc92949c274e0507097e274123"}}, {start: {_id:5899}, end: {_id:233}, properties:{file_path:"unknown_source", keywords:"language,origin", truncate:"", weight:1.0, description:"The chant \"Aham Brahmasmi\" originates from Sanskrit, the language of the sages of India.", created_at:1779552346, source_id:"chunk-6aebd99b80a116244470eacf183c4202"}}, {start: {_id:786}, end: {_id:1329}, properties:{file_path:"YouTube Video: k0GsZxWhjSE (URL: https://www.youtube.com/watch?v=k0GsZxWhjSE)", keywords:"connection,energy flow", truncate:"", weight:1.0, description:"The heart is connected to the web of life through rays of light, symbolizing universal interconnectedness.", created_at:1779552365, source_id:"chunk-4c6054ccc3bee7f9d86c600fc50b5dc7"}}, {start: {_id:453}, end: {_id:1843}, properties:{file_path:"YouTube Video: k0GsZxWhjSE (URL: https://www.youtube.com/watch?v=k0GsZxWhjSE)", keywords:"intention,visualization", truncate:"", weight:1.0, description:"The practitioner uses the golden lotus to visualize and manifest abundance in the world.", created_at:1779552365, source_id:"chunk-4c6054ccc3bee7f9d86c600fc50b5dc7"}}, {start: {_id:5897}, end: {_id:1329}, properties:{file_path:"YouTube Video: k0GsZxWhjSE (URL: https://www.youtube.com/watch?v=k0GsZxWhjSE)", keywords:"gratitude,interconnectedness", truncate:"", weight:1.0, description:"The people who impacted the practitioner are part of the web of life, fostering gratitude and connection.", created_at:1779552366, source_id:"chunk-4c6054ccc3bee7f9d86c600fc50b5dc7"}}, {start: {_id:5898}, end: {_id:1329}, properties:{file_path:"YouTube Video: k0GsZxWhjSE (URL: https://www.youtube.com/watch?v=k0GsZxWhjSE)", keywords:"inner light,transition", truncate:"", weight:1.0, description:"The flame signifies the practitioner's inner light merging with the web of life, marking the end of meditation.", created_at:1779552366, source_id:"chunk-4c6054ccc3bee7f9d86c600fc50b5dc7"}}, {start: {_