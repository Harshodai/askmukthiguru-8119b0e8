UNWIND [{start: {_id:5540}, end: {_id:7782}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jy4hcpUSBms)", truncate:"", keywords:"spiritual guidance,transcendence", weight:1.0, description:"The Universal Mother's wisdom is invoked to transcend the illusion of Maya and separation.", created_at:1779675455, source_id:"chunk-05cc795d538216c463ac6d6e2524a3ee"}}, {start: {_id:2553}, end: {_id:2316}, properties:{file_path:"unknown_source", keywords:"cultivates,generates", truncate:"", weight:1.0, description:"Awareness generates peace, clarity, and intelligence through conscious observation.", created_at:1779675473, source_id:"chunk-69ad193b229bafe28becd7a15ba050a2"}}, {start: {_id:7784}, end: {_id:391}, properties:{file_path:"unknown_source", keywords:"alters,impacts", truncate:"", weight:1.0, description:"An awakened state impacts and alters neural connections in the brain.", created_at:1779675473, source_id:"chunk-69ad193b229bafe28becd7a15ba050a2"}}, {start: {_id:7783}, end: {_id:7785}, properties:{file_path:"unknown_source", keywords:"represents,synonymous with", truncate:"", weight:1.0, description:"An ordinary mind is synonymous with repetitive thinking patterns.", created_at:1779675473, source_id:"chunk-69ad193b229bafe28becd7a15ba050a2"}}, {start: {_id:7786}, end: {_id:7787}, properties:{file_path:"unknown_source", keywords:"emerges from,requires", truncate:"", weight:1.0, description:"Creativity emerges from and requires new perception and worldview.", created_at:1779675473, source_id:"chunk-69ad193b229bafe28becd7a15ba050a2"}}, {start: {_id:755}, end: {_id:2553}, properties:{file_path:"unknown_source", keywords:"cultivates,generates", truncate:"", weight:1.0, description:"Awareness generates peace and calmness.", created_at:1779675473, source_id:"chunk-69ad193b229bafe28becd7a15ba050a2"}}, {start: {_id:7784}, end: {_id:1250}, properties:{file_path:"unknown_source", keywords:"alters,transforms", truncate:"", weight:1.0, description:"Awakened consciousness transforms and alters one's state of being.", created_at:1779675473, source_id:"chunk-69ad193b229bafe28becd7a15ba050a2"}}, {start: {_id:1611}, end: {_id:2553}, properties:{file_path:"unknown_source", keywords:"cultivates,generates", truncate:"", weight:1.0, description:"Awareness generates clarity and mental lucidity.", created_at:1779675474, source_id:"chunk-69ad193b229bafe28becd7a15ba050a2"}}, {start: {_id:2703}, end: {_id:7788}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hqre34QIMZg)", keywords:"contrast,transformation", truncate:"", weight:1.0, description:"Creativity emerges as a departure from the repetitive nature of the ordinary mind, enabling new perspectives.", created_at:1779675474, source_id:"chunk-811f7f6fb4de9a85b774d5d90a726b13"}}, {start: {_id:4405}, end: {_id:401}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hqre34QIMZg)", truncate:"", keywords:"cognitive change,neurobiological impact", weight:1.0, description:"An awakened state alters neural connections, affecting cognitive functioning and perception.", created_at:1779675474, source_id:"chunk-811f7f6fb4de9a85b774d5d90a726b13"}}, {start: {_id:1301}, end: {_id:2553}, properties:{file_path:"unknown_source", keywords:"cultivates,generates", truncate:"", weight:1.0, description:"Awareness generates intelligence and cognitive insight.", created_at:1779675474, source_id:"chunk-69ad193b229bafe28becd7a15ba050a2"}}, {start: {_id:742}, end: {_id:2829}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hqre34QIMZg)", keywords:"non-judgment,observation", truncate:"", weight:1.0, description:"Awareness involves observing thoughts and emotions without indulgence, escaping, or justification.", created_at:1779675474, source_id:"chunk-811f7f6fb4de9a85b774d5d90a726b13"}}, {start: {_id:1771}, end: {_id:2553}, properties:{file_path:"unknown_source", keywords:"cultivates,generates", truncate:"", weight:1.0, description:"Awareness generates stillness and quietude.", created_at:1779675474, source_id:"chunk-69ad193b229bafe28becd7a15ba050a2"}}, {start: {_id:4405}, end: {_id:2703}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hqre34QIMZg)", truncate:"", keywords:"enabling factor,transformative potential", weight:1.0, description:"An awakened state of consciousness enables creativity by fostering new perceptions and worldviews.", created_at:1779675474, source_id:"chunk-811f7f6fb4de9a85b774d5d90a726b13"}}, {start: {_id:742}, end: {_id:7789}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hqre34QIMZg)", truncate:"", keywords:"cognitive benefits,inner state", weight:1.0, description:"Awareness leads to peace, clarity, intelligence, and stillness within oneself.", created_at:1779675475, source_id:"chunk-811f7f6fb4de9a85b774d5d90a726b13"}}, {start: {_id:152}, end: {_id:6098}, properties:{file_path:"unknown_source", keywords:"creation,transformation", truncate:"", weight:1.0, description:"Destiny can be created through a transformed or awakened state of consciousness and clear intention.", created_at:1779675521, source_id:"chunk-c221b35beb5903b6212b49e01a938f47"}}, {start: {_id:7784}, end: {_id:6098}, properties:{file_path:"unknown_source", keywords:"prerequisite,transformation", truncate:"", weight:1.0, description:"Creating destiny requires an awakened state of consciousness, which serves as the foundation for manifestation.", created_at:1779675521, source_id:"chunk-c221b35beb5903b6212b49e01a938f47"}}, {start: {_id:605}, end: {_id:7791}, properties:{file_path:"unknown_source", keywords:"conflict,contradiction", truncate:"", weight:1.0, description:"The pursuit of harmony and equal dignity is in conflict with the current path that causes division.", created_at:1779675542, source_id:"chunk-97a582a6bc26174c8bc3002eb473cbb9"}}, {start: {_id:3047}, end: {_id:3050}, properties:{file_path:"unknown_source", keywords:"inheritance,manifestation,perpetuation", truncate:"", weight:2.0, description:"Prejudice and bias are inherited and perpetuated from one generation to the next.<SEP>Prejudice manifests as bias in reactions to differences.", created_at:1779675542, source_id:"chunk-97a582a6bc26174c8bc3002eb473cbb9"}}, {start: {_id:7790}, end: {_id:3271}, properties:{file_path:"unknown_source", keywords:"countermeasure,solution", truncate:"", weight:1.0, description:"Self-awareness and compassion are a countermeasure to violence.", created_at:1779675542, source_id:"chunk-97a582a6bc26174c8bc3002eb473cbb9"}}] AS row
