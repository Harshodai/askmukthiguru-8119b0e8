UNWIND [{start: {_id:8218}, end: {name:"Meditation"}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", keywords:"Method,Practice,guidance,method,practice,practice type,technique", truncate:"", weight:4.0, description:"Guided Meditations are a method of meditation that yields great results.<SEP>Meditation is practiced using guided meditations as a technique.<SEP>Meditation includes guided meditations as a specific practice.<SEP>Guided meditations are a specific type of meditation offering structured guidance.", created_at:1779734683, source_id:"chunk-4ffd283bc238983d474b77fd2c547d1f<SEP>chunk-9dc502f9eccca1fa3646d12dc84a20b5<SEP>chunk-59826b76f9c0df8dac3d55bfd1895e81<SEP>chunk-a6282514b611392194d87cce5b2c4ab4"}}, {start: {_id:8219}, end: {name:"Meditation"}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", keywords:"Metaphor,Process,outcome,process", truncate:"", weight:2.0, description:"Conflicting thoughts are part of the meditation process metaphor.<SEP>Meditation involves navigating conflicting thoughts towards open clearings.", created_at:1779734567, source_id:"chunk-4ffd283bc238983d474b77fd2c547d1f<SEP>chunk-9dc502f9eccca1fa3646d12dc84a20b5"}}, {start: {_id:3952}, end: {name:"Meditation"}, properties:{file_path:"unknown_source", keywords:"Practice,Spiritual Activity", truncate:"", weight:1.0, description:"Meditation is a practice that requires intelligence and has enduring results.", created_at:1779734456, source_id:"chunk-4ffd283bc238983d474b77fd2c547d1f"}}, {start: {_id:8240}, end: {name:"Meditation"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", keywords:"context,factor,method,process", truncate:"", weight:2.0, description:"Guidance is a factor in the effectiveness of meditation.<SEP>Meditation can be practiced with or without guidance.", created_at:1779734567, source_i