UNWIND [{start: {_id:287}, end: {_id:1893}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", keywords:"acceptance,metaphor", truncate:"", weight:1.0, description:"Life's diverse \"tastes\" (experiences) are to be accepted as part of existence.", created_at:1779218178, source_id:"chunk-27a4dfd2bd2512da5799c450f509330b"}}, {start: {_id:287}, end: {_id:2452}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", keywords:"guidance,reflection", truncate:"", weight:1.0, description:"Nature's message to \"be still\" relates to life's overwhelming pace and need for balance.", created_at:1779218178, source_id:"chunk-27a4dfd2bd2512da5799c450f509330b"}}, {start: {_id:1908}, end: {_id:1917}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", keywords:"population,public health", truncate:"", weight:1.0, description:"Indians' collective action in containing the epidemic is highlighted as a global contribution.", created_at:1779218225, source_id:"chunk-52ad42f8f8d7bf6cdf3a96f95c014a7c"}}, {start: {_id:1683}, end: {_id:1758}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"consistency,correction,term correction", weight:2.0, description:"Original \"Gudi Padma\" is corrected to \"Gudi Bhadva\" for consistency with prior usage in the text.<SEP>\"Gudi Padma\" is corrected to \"Gudi Bhadva\" for uniformity with prior usage in the text.", created_at:1779218270, source_id:"chunk-52ad42f8f8d7bf6cdf3a96f95c014a7c<SEP>chunk-5c9875e9473ebfe7d72af1ccccd742de"}}, {start: {_id:108}, end: {_id:1923}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"meditation,spiritual guidance", weight:1.0, description:"The Divine is invoked to help accept and celebrate stillness and togetherness with family.", created_at:1779218270, source_id:"chunk-5c9875e9473ebfe7d72af1ccccd742de"}}, {start: {_id:1759}, end: {_id:1936}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"common usage,transliteration choice", weight:1.0, description:"\"Antriy?min\" is simplified to \"Antriyamin\" to align with common transliteration practices.", created_at:1779218270, source_id:"chunk-5c9875e9473ebfe7d72af1ccccd742de"}}, {start: {_id:108}, end: {_id:1918}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", keywords:"balance,future acceptance", truncate:"", weight:1.0, description:"The Divine is asked to aid in embracing future movement and rush alongside present stillness.", created_at:1779218270, source_id:"chunk-5c9875e9473ebfe7d72af1ccccd742de"}}, {start: {_id:108}, end: {_id:1924}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"future acceptance,spiritual guidance", weight:1.0, description:"The Divine is invoked to help embrace happiness in the future amidst present stillness and family togetherness.", created_at:1779218271, source_id:"chunk-5c9875e9473ebfe7d72af1ccccd742de"}}, {start: {_id:1759}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"content source,theological concept", weight:1.0, description:"The YouTube video addresses the concept of \"Antriyamin\" in its content.", created_at:1779218271, source_id:"chunk-5c9875e9473ebfe7d72af1ccccd742de"}}, {start: {_id:1683}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"content source,cultural context", weight:1.0, description:"The YouTube video discusses or references the term \"Gudi Bhadva\" in its content.", created_at:1779218271, source_id:"chunk-5c9875e9473ebfe7d72af1ccccd742de"}}, {start: {_id:1832}, end: {_id:1940}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", keywords:"error,transcription", truncate:"", weight:1.0, description:"Identified as a transcription error in the text.", created_at:1779218293, source_id:"chunk-ad83a42d4454f2529f372618bda5e249"}}, {start: {_id:2176}, end: {_id:1941}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", keywords:"capitalization,correction", truncate:"", weight:1.0, description:"Corrected to \"Happy again.\" with proper capitalization.", created_at:1779218294, source_id:"chunk-ad83a42d4454f2529f372618bda5e249"}}, {start: {_id:1766}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"content,content source,source,video content", weight:2.0, description:"YouTube Video hosts the transcript containing repeated mentions of \"Hamsa Soham\".<SEP>The YouTube Video includes the phrase \"Hamsa Soham\" as part of its discussed content.", created_at:1779255462, source_id:"chunk-caa85f32ffc0c3a29fe33b1e490f121c<SEP>chunk-41070a47242b017794bd4b01d9403428"}}, {start: {_id:2021}, end: {_id:1955}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", keywords:"gender disparity,mortality,mortality rate,statistics", truncate:"", weight:2.0, description:"Men have three times higher self-harm mortality rates than women annually.<SEP>Men exhibit three times higher self-harm mortality rates than women annually.", created_at:1779219036, source_id:"chunk-959b75d8730e8069b5cdeee7b801f17f<SEP>chunk-0390556d788c91f6a96de617dfba0674"}}, {start: {_id:284}, end: {_id:371}, properties:{file_path:"unknown_source", keywords:"crisis response,emotional support", truncate:"", weight:1.0, description:"Connection acts as a balm for loneliness during health, emotional, and financial crises.", created_at:1779218918, source_id:"chunk-959b75d8730e8069b5cdeee7b801f17f"}}, {start: {_id:284}, end: {_id:108}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", truncate:"", keywords:"connection to the divine,grace,metaphysical,spiritual alignment,spiritual transcendence", weight:3.0, description:"Connection channels divine grace and opens pathways to spiritual transformation.<SEP>Connection connects to the divine.<SEP>Connection to the divine enables access to grace and higher purpose.", created_at:1779219037, source_id:"chunk-959b75d8730e8069b5cdeee7b801f17f<SEP>chunk-1638eab96ec57bc1b768b7d70d8ef77f<SEP>chunk-0390556d788c91f6a96de617dfba0674"}}, {start: {_id:284}, end: {_id:344}, properties:{file_path:"unknown_source", keywords:"active listening,mindfulness", truncate:"", weight:1.0, description:"Connection requires presence, listening, and sensitivity to others' emotions.", created_at:1779218920, source_id:"chunk-959b75d8730e8069b5cdeee7b801f17f"}}, {start: {_id:284}, end: {_id:39}, properties:{file_path:"unknown_source", keywords:"empathy,shared celebration", truncate:"", weight:1.0, description:"Connection involves celebrating others' joy and understanding their happiness.", created_at:1779218920, source_id:"chunk-959b75d8730e8069b5cdeee7b801f17f"}}, {start: {_id:284}, end: {_id:689}, properties:{file_path:"unknown_source", keywords:"empathy,support", truncate:"", weight:1.0, description:"Connection requires sensitivity to others' unhappiness and inner conflicts.", created_at:1779218920, source_id:"chunk-959b75d8730e8069b5cdeee7b801f17f"}}, {start: {_id:284}, end: {_id:360}, properties:{file_path:"unknown_source", truncate:"", keywords:"conscious effort,disturbance alleviation", weight:1.0, description:"Connection involves helping others overcome inner disturbances.", created_at:1779218920, source_id:"chunk-959b75d8730e8069b5cdeee7b801f17f"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
UNWIND [{start: {_id:284}, end: {_id:2160}, properties:{file_path:"unknown_source", truncate:"", keywords:"fundamental essence,gender neutrality", weight:1.0, description:"Connection is framed as the essence of being human, transcending gender.", created_at:1779218920, source_id:"chunk-959b75d8730e8069b5cdeee7b801f17f"}}, {start: {_id:284}, end: {_id:2038}, properties:{file_path:"unknown_source", keywords:"contrast,depth", truncate:"", weight:1.0, description:"Superficial friendships lack the depth and mutual appreciation of true connection.", created_at:1779218920, source_id:"chunk-959b75d8730e8069b5cdeee7b801f17f"}}, {start: {_id:2039}, end: {_id:284}, properties:{file_path:"unknown_source", keywords:"essence,human nature", truncate:"", weight:1.0, description:"Connection is the essence of being human, representing the fundamental nature of human existence.", created_at:1779218920, source_id:"chunk-1638eab96ec57bc1b768b7d70d8ef77f"}}, {start: {_id:284}, end: {_id:8}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", keywords:"crisis,divine channel,soothe,soothing,strength", truncate:"", weight:2.0, description:"Connection soothes hearts during health crisis.<SEP>Connection is portrayed as a remedy for crises, offering emotional soothing and resilience.", created_at:1779219036, source_id:"chunk-1638eab96ec57bc1b768b7d70d8ef77f<SEP>chunk-0390556d788c91f6a96de617dfba0674"}}, {start: {_id:284}, end: {_id:1961}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", keywords:"crisis,divine channel,soothe,soothing,strength", truncate:"", weight:2.0, description:"Connection soothes hearts during emotional crisis.<SEP>Connection helps individuals navigate emotional turmoil through deeper bonds.", created_at:1779219036, source_id:"chunk-1638eab96ec57bc1b768b7d70d8ef77f<SEP>chunk-0390556d788c91f6a96de617dfba0674"}}, {start: {_id:284}, end: {_id:7}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", keywords:"crisis,divine channel,soothe,soothing,strength", truncate:"", weight:2.0, description:"Connection soothes hearts during financial crisis.<SEP>Connection provides stability during financial hardships by fostering collective support.", created_at:1779219036, source_id:"chunk-1638eab96ec57bc1b768b7d70d8ef77f<SEP>chunk-0390556d788c91f6a96de617dfba0674"}}, {start: {_id:1997}, end: {_id:284}, properties:{file_path:"unknown_source", truncate:"", keywords:"metaphor,soothing", weight:1.0, created_at:1779218921, description:"Connection is described as a balm.", source_id:"chunk-1638eab96ec57bc1b768b7d70d8ef77f"}}, {start: {_id:2046}, end: {_id:1955}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", truncate:"", keywords:"mortality,statistical prevalence", weight:1.0, description:"Self-harm is highlighted as the leading cause of death for this age group.", created_at:1779219036, source_id:"chunk-0390556d788c91f6a96de617dfba0674"}}, {start: {_id:1339}, end: {_id:371}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", truncate:"", keywords:"emotional impact,societal trend", weight:1.0, description:"Loneliness stems from superficial relationships and digital isolation.", created_at:1779219036, source_id:"chunk-0390556d788c91f6a96de617dfba0674"}}, {start: {_id:1956}, end: {_id:371}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", truncate:"", keywords:"emotional void,superficiality", weight:1.0, description:"Modern friendships are described as shallow, exacerbating loneliness.", created_at:1779219036, source_id:"chunk-0390556d788c91f6a96de617dfba0674"}}, {start: {_id:2066}, end: {_id:745}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", truncate:"", keywords:"emotional dissatisfaction,linguistic limitations", weight:1.0, description:"Words alone fail to fulfill human needs for authentic connection.", created_at:1779219036, source_id:"chunk-0390556d788c91f6a96de617dfba0674"}}, {start: {_id:284}, end: {_id:1957}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", truncate:"", keywords:"depth,depth vs. superficiality,difference in meaning", weight:2.0, description:"Connection transcends mere interaction, addressing existential emptiness.<SEP>Connection transcends interaction by emphasizing spiritual or emotional depth over mere physical engagement.", created_at:1779219072, source_id:"chunk-0390556d788c91f6a96de617dfba0674<SEP>chunk-efcb91e5fdaab3bfd47bb92c605956fe"}}, {start: {_id:284}, end: {_id:2452}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", truncate:"", keywords:"emotional fulfillment,spiritual grounding", weight:1.0, description:"Connecting with nature is emphasized as vital for holistic well-being.", created_at:1779219037, source_id:"chunk-0390556d788c91f6a96de617dfba0674"}}, {start: {_id:1998}, end: {_id:284}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", truncate:"", keywords:"activism,purpose", weight:1.0, description:"Engaging with causes fosters collective strength and meaning.", created_at:1779219037, source_id:"chunk-0390556d788c91f6a96de617dfba0674"}}, {start: {_id:2069}, end: {_id:2528}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", truncate:"", keywords:"divine energy,spiritual practice", weight:1.0, description:"Connecting to the divine involves channeling grace as a transformative spiritual force.", created_at:1779219072, source_id:"chunk-efcb91e5fdaab3bfd47bb92c605956fe"}}, {start: {_id:1061}, end: {_id:2068}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", truncate:"", keywords:"fundamental aspect,gender dynamics", weight:1.0, description:"Gender experiences are intrinsic to understanding the essence of human existence.", created_at:1779219072, source_id:"chunk-efcb91e5fdaab3bfd47bb92c605956fe"}}, {start: {_id:2079}, end: {_id:2073}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", truncate:"", keywords:"interdisciplinary concept,metaphorical use", weight:1.0, description:"\"Chemistry of chemistry\" employs scientific terminology to describe spiritual or philosophical ideas.", created_at:1779219072, source_id:"chunk-efcb91e5fdaab3bfd47bb92c605956fe"}}, {start: {_id:2084}, end: {_id:1294}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", truncate:"", keywords:"content,philosophical theme", weight:1.0, description:"The video contains discussions on masculine or feminine experiences as part of its content.", created_at:1779219096, source_id:"chunk-a0bfcd7158587f7aa70a148fe1dcdffb"}}, {start: {_id:2086}, end: {_id:2084}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", truncate:"", keywords:"component,philosophical concept", weight:1.0, description:"The masculine or feminine experience is presented as a component of the essence of being human.", created_at:1779219096, source_id:"chunk-a0bfcd7158587f7aa70a148fe1dcdffb"}}, {start: {_id:2083}, end: {_id:2086}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", keywords:"conceptual link,metaphor", truncate:"", weight:1.0, description:"The phrase \"chemistry of chemistry\" metaphorically connects to the essence of being human.", created_at:1779219096, source_id:"chunk-a0bfcd7158587f7aa70a148fe1dcdffb"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
