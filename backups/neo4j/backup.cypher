UNWIND [{start: {_id:1311}, end: {_id:4921}, properties:{file_path:"unknown_source", keywords:"consciousness,transformation", truncate:"", weight:2.0, description:"Transition from challenging wealth creation to effortless creation through conscious alignment.<SEP>Transition from challenging wealth creation to effortless creation through conscious alignment.", created_at:1779418315, source_id:"chunk-87c7719422a9d8333cc199f60bc9b163"}}, {start: {_id:2018}, end: {_id:1684}, properties:{file_path:"unknown_source<SEP>YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", keywords:"analysis,correction,focus area,task component", truncate:"", weight:3.0, description:"The correction process includes analyzing and fixing homophones and misheard words.<SEP>The correction process includes analyzing and fixing homophones and misheard words.<SEP>Homophones and misheard words are a focus area for the task of fixing transcription errors.", created_at:1779455474, source_id:"chunk-8b875733f77c698a06c289ab42079023<SEP>chunk-40386efc054d2a63eab72a4be3e3ca8d"}}, {start: {_id:4922}, end: {_id:1256}, properties:{file_path:"unknown_source", keywords:"creation capacity,energy dynamics", truncate:"", weight:2.0, description:"Power shifts enable heightened wealth creation through expanded personal influence.<SEP>Power shifts enable heightened wealth creation through expanded personal influence.", created_at:1779418306, source_id:"chunk-87c7719422a9d8333cc199f60bc9b163"}}, {start: {_id:1311}, end: {_id:4923}, properties:{file_path:"unknown_source<SEP>YouTube Video: 7lggUuJtZXY (URL: https://www.youtube.com/watch?v=7lggUuJtZXY)", keywords:"consciousness,creation process,mindset transformation,opportunity recognition", truncate:"", weight:3.0, description:"Awakening to the creation dimension facilitates effortless wealth manifestation.<SEP>Awakening to the creation dimension facilitates effortless wealth manifestation.<SEP>The conscious wealth creator operates within the creation dimension, perceiving opportunities.", created_at:1779418316, source_id:"chunk-87c7719422a9d8333cc199f60bc9b163<SEP>chunk-c89b8cdd64ac1b6adbb6cecedd0bf3f0"}}, {start: {_id:4925}, end: {_id:1422}, properties:{file_path:"unknown_source", keywords:"collaboration,creative process", truncate:"", weight:2.0, description:"Innovation enables formation of collaborative teams through expanded capacities.<SEP>Innovation enables formation of collaborative teams through expanded capacities.", created_at:1779418307, source_id:"chunk-87c7719422a9d8333cc199f60bc9b163"}}, {start: {_id:4924}, end: {_id:3372}, properties:{file_path:"unknown_source", truncate:"", keywords:"grammatical errors,sentence structure", weight:2.0, description:"Comma splice exemplifies improper sentence construction within run-on sentences.<SEP>Comma splice exemplifies improper sentence construction within run-on sentences.", created_at:1779418307, source_id:"chunk-87c7719422a9d8333cc199f60bc9b163"}}, {start: {_id:1685}, end: {_id:2018}, properties:{file_path:"unknown_source", keywords:"analysis,correction", truncate:"", weight:2.0, description:"The correction process includes analyzing and fixing domain-specific terms.<SEP>The correction process includes analyzing and fixing domain-specific terms.", created_at:1779418307, source_id:"chunk-8b875733f77c698a06c289ab42079023"}}, {start: {_id:4935}, end: {_id:4936}, properties:{file_path:"unknown_source", keywords:"manifestation,obstacle,type", truncate:"", weight:2.0, description:"Problems and chaos are presented as a type or manifestation of roadblocks.`<SEP>Problems and chaos are presented as a type or manifestation of roadblocks.`", created_at:1779418307, source_id:"chunk-d097880e58e4b221fa91dccc5ac053c2"}}, {start: {_id:2018}, end: {_id:1760}, properties:{file_path:"unknown_source", keywords:"analysis,correction", truncate:"", weight:2.0, description:"The correction process includes analyzing and fixing punctuation and capitalization.<SEP>The correction process includes analyzing and fixing punctuation and capitalization.", created_at:1779418307, source_id:"chunk-8b875733f77c698a06c289ab42079023"}}, {start: {_id:3372}, end: {_id:1256}, properties:{file_path:"unknown_source", keywords:"contextual focus,text style", truncate:"", weight:2.0, description:"Grammatical discussion contextualizes wealth creation concepts without altering style.<SEP>Grammatical discussion contextualizes wealth creation concepts without altering style.", created_at:1779418307, source_id:"chunk-87c7719422a9d8333cc199f60bc9b163"}}, {start: {_id:4933}, end: {_id:4936}, properties:{file_path:"unknown_source", keywords:"lead to,overcome,result in", truncate:"", weight:2.0, description:"Overcoming roadblocks leads to the perception of opportunities.`<SEP>Overcoming roadblocks leads to the perception of opportunities.`", created_at:1779418307, source_id:"chunk-d097880e58e4b221fa91dccc5ac053c2"}}, {start: {_id:1789}, end: {_id:2018}, properties:{file_path:"unknown_source", keywords:"method,rules", truncate:"", weight:2.0, description:"The correction process must adhere to specific constraints and rules.<SEP>The correction process must adhere to specific constraints and rules.", created_at:1779418307, source_id:"chunk-8b875733f77c698a06c289ab42079023"}}, {start: {_id:4920}, end: {_id:2018}, properties:{file_path:"unknown_source", keywords:"output,result", truncate:"", weight:2.0, description:"The correction process results in corrected text.<SEP>The correction process results in corrected text.", created_at:1779418307, source_id:"chunk-8b875733f77c698a06c289ab42079023"}}, {start: {_id:4921}, end: {_id:4937}, properties:{file_path:"YouTube Video: 7lggUuJtZXY (URL: https://www.youtube.com/watch?v=7lggUuJtZXY)", truncate:"", keywords:"conceptual framework,content contrast", weight:1.0, description:"The video contrasts the struggling wealth creator mindset with conscious wealth creation.", created_at:1779418315, source_id:"chunk-c89b8cdd64ac1b6adbb6cecedd0bf3f0"}}, {start: {_id:4921}, end: {_id:1256}, properties:{file_path:"YouTube Video: 7lggUuJtZXY (URL: https://www.youtube.com/watch?v=7lggUuJtZXY)", keywords:"fear-based,struggle", truncate:"", weight:1.0, description:"Struggling wealth creators approach wealth creation with fear and anxiety, leading to challenges.", created_at:1779418316, source_id:"chunk-c89b8cdd64ac1b6adbb6cecedd0bf3f0"}}, {start: {_id:1311}, end: {_id:4937}, properties:{file_path:"YouTube Video: 7lggUuJtZXY (URL: https://www.youtube.com/watch?v=7lggUuJtZXY)", truncate:"", keywords:"conceptual framework,content discussion", weight:1.0, description:"The video discusses the concept of a conscious wealth creator and its characteristics.", created_at:1779418316, source_id:"chunk-c89b8cdd64ac1b6adbb6cecedd0bf3f0"}}, {start: {_id:1311}, end: {_id:4922}, properties:{file_path:"YouTube Video: 7lggUuJtZXY (URL: https://www.youtube.com/watch?v=7lggUuJtZXY)", truncate:"", keywords:"empowerment,mindset transformation", weight:1.0, description:"The conscious wealth creator experiences a power shift through expanded consciousness, enabling effortless wealth creation and innovation.", created_at:1779418316, source_id:"chunk-c89b8cdd64ac1b6adbb6cecedd0bf3f0"}}, {start: {_id:4939}, end: {_id:2232}, properties:{file_path:"unknown_source<SEP>YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"ecological stewardship,familial unity,family analogy,global unity,perception", truncate:"", weight:3.0, created_at:1779420521, description:"The world leader sees Mother Earth and its inhabitants as an interconnected family.<SEP>World leaders perceive Earth and its inhabitants as family, advocating oneness.<SEP>Conscious world leader views planetary ecosystems as an extended familial network requiring collective care.", source_id:"chunk-38046723cd74f27b125edb0953caff31<SEP>chunk-2e64ecd5baa03b517e5215b8fbc577e4<SEP>chunk-7abf3d6ec3bef4fcb00fff43b8f7e2bf"}}, {start: {_id:4941}, end: {_id:2707}, properties:{file_path:"unknown_source<SEP>YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"family analogy,perception", truncate:"", weight:2.0, description:"The business leader views the organization as a family, prioritizing collective welfare.<SEP>Conscious business leader equates organizational management with familial interdependence.", created_at:1779420521, source_id:"chunk-38046723cd74f27b125edb0953caff31<SEP>chunk-7abf3d6ec3bef4fcb00fff43b8f7e2bf"}}, {start: {_id:4938}, end: {_id:4946}, properties:{file_path:"unknown_source<SEP>YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"ethical framework,solution,systemic change", truncate:"", weight:2.0, description:"Inclusive thinking is presented as a solution to end exploitation and economic unrest.<SEP>Inclusive thinking is presented as the mechanism to dismantle exploitative systems through paradigm shift.", created_at:1779420522, source_id:"chunk-38046723cd74f27b125edb0953caff31<SEP>chunk-7abf3d6ec3bef4fcb00fff43b8f7e2bf"}}] AS row
