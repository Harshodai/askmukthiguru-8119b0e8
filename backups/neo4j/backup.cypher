MATCH (end:Concept{name: row.end.name})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
UNWIND [{start: {_id:5711}, end: {name:"Oneness"}, properties:{file_path:"unknown_source<SEP>YouTube Video: MJYpyUlwxg0 (URL: https://www.youtube.com/watch?v=MJYpyUlwxg0)", keywords:"meditation,spiritual practice,spiritual unity,unity", truncate:"", weight:2.0, description:"Maha Shivaratri is a night dedicated to meditating on oneness, enabling participants to merge with Mahadeva and experience cosmic unity.<SEP>Maha Shivaratri provides the context for meditating inward to become one with Mahadeva and experience oneness.", created_at:1779521248, source_id:"chunk-a4ec9b97a69f62614437c5e1621469d7<SEP>chunk-2440e826e4f3cf50974cdd2445cd5354"}}, {start: {_id:5709}, end: {name:"Oneness"}, properties:{file_path:"unknown_source", truncate:"", keywords:"spiritual realization,transcendent state", weight:1.0, description:"The experience of oneness leads to the realization of Bliss Sachitananda, a state of unified consciousness and divine joy.", created_at:1779521247, source_id:"chunk-a4ec9b97a69f62614437c5e1621469d7"}}, {start: {_id:5712}, end: {name:"Oneness"}, properties:{file_path:"unknown_source", keywords:"source and expression", truncate:"", weight:1.0, description:"The diversified universe emerges from oneness as its external manifestation, maintaining an intrinsic connection to its unified origin.", created_at:1779521247, source_id:"chunk-a4ec9b97a69f62614437c5e1621469d7"}}, {start: {_id:5728}, end: {name:"Consciousness"}, properties:{file_path:"YouTube Video: PnvNqgTyIFI (URL: https://www.youtube.com/watch?v=PnvNqgTyIFI)", keywords:"awareness,transcendence", truncate:"", weight:1.0, description:"Awakening reveals consciousness as the ultimate witness beyond the mind.>", created_at:1779522134, source_id:"chunk-bebed8e390bd16e43f908369216b9343"}}, {start: {_id:2760}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", truncate:"", keywords:"dissatisfaction,narrative expectation", weight:1.0, description:"The book?s story was deemed incomplete due to insufficient emphasis on suffering elements.", created_at:1779524102, source_id:"chunk-e32359164f62f64b8a0367195694bf0f"}}, {start: {_id:1474}, end: {name:"Suffering"}, properties:{file_path:"unknown_source<SEP>YouTube Video: LFTx6ZYMZ1g (URL: https://www.youtube.com/watch?v=LFTx6ZYMZ1g)", keywords:"incompleteness,narrative contrast,narrative progression,suffering", truncate:"", weight:2.0, description:"The story focused on awakening but lacked the expected depth of suffering, causing audience disappointment.<SEP>Suffering leads to awakening but does not resolve the narrative in the expected way, creating an incomplete transformation.", created_at:1779524150, source_id:"chunk-e32359164f62f64b8a0367195694bf0f<SEP>chunk-c00a21b2b4928fd2c922f070f0bbfadd"}}, {start: {_id:1949}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"imposition,societal formula", truncate:"", weight:1.0, description:"The generation developed and enforced the idea that suffering is a necessary lesson, imposing it on others.", created_at:1779524102, source_id:"chunk-e32359164f62f64b8a0367195694bf0f"}}, {start: {_id:2028}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"emotional cycle,perpetuation", truncate:"", weight:1.0, description:"Suffering leads to perpetuating sadness through self-reinforcing emotional states.", created_at:1779524103, source_id:"chunk-e32359164f62f64b8a0367195694bf0f"}}, {start: {_id:499}, end: {name:"Suffering"}, properties:{file_path:"unknown_source<SEP>YouTube Video: k8iO5daXllM (URL: https://www.youtube.com/watch?v=k8iO5daXllM)", keywords:"compounding,emotional cycle,internal state,prolonged effect", truncate:"", weight:2.0, description:"Suffering generates additional stress via feedback loops.<SEP>Stress, when persistent, can evolve into suffering as an internal state of distress.", created_at:1779663875, source_id:"chunk-e32359164f62f64b8a0367195694bf0f<SEP>chunk-539d32cffeac32af158844b70b3aafe4"}}, {start: {_id:355}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"disconnection,emotional impact", truncate:"", weight:1.0, description:"Suffering disconnects individuals from their loved ones, exemplified by the child reference.", created_at:1779524104, source_id:"chunk-e32359164f62f64b8a0367195694bf0f"}}, {start: {_id:5741}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: LFTx6ZYMZ1g (URL: https://www.youtube.com/watch?v=LFTx6ZYMZ1g)", truncate:"", keywords:"emotional impact,narrative progression", weight:1.0, description:"The Story of Awakening is framed as emerging from suffering but not resolving it in the way audiences expected.", created_at:1779524151, source_id:"chunk-c00a21b2b4928fd2c922f070f0bbfadd"}}, {start: {_id:5743}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: LFTx6ZYMZ1g (URL: https://www.youtube.com/watch?v=LFTx6ZYMZ1g)", keywords:"consequences,rejection", truncate:"", weight:1.0, description:"The speaker argues that philosophical justifications for suffering are misguided, emphasizing suffering's negative cyclical nature.", created_at:1779524151, source_id:"chunk-c00a21b2b4928fd2c922f070f0bbfadd"}}, {start: {_id:27}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: LFTx6ZYMZ1g (URL: https://www.youtube.com/watch?v=LFTx6ZYMZ1g)", keywords:"discussion focus,theme", truncate:"", weight:1.0, description:"The content focuses on the theme of suffering and its impact.", created_at:1779524203, source_id:"chunk-5df41a8775a9f9e045f9f017cbfd63e0"}}, {start: {_id:5788}, end: {name:"Consciousness"}, properties:{file_path:"unknown_source<SEP>YouTube Video: TQ0TGyaByhs (URL: https://www.youtube.com/watch?v=TQ0TGyaByhs)", keywords:"digestion,metaphysical unity,philosophical equivalence", truncate:"", weight:2.0, description:"Brahmarpanam identifies consciousness as the digestive fire that both offers and consumes itself.<SEP>Brahmarpanam is the concept that everything is one indivisible consciousness, which is Brahman.", created_at:1779531118, source_id:"chunk-e5bc7202d0a09227aeb490c17e163a8e<SEP>chunk-ce2308cda5fca23d965042def4191e27"}}, {start: {_id:5812}, end: {name:"Dharma"}, properties:{file_path:"YouTube Video: p2HecXyM3tE (URL: https://www.youtube.com/watch?v=p2HecXyM3tE)", truncate:"", keywords:"ethical contrast,sustainability", weight:1.0, description:"Dharma promotes conscious living while Adharma represents destructive exploitation of nature.", created_at:1779532048, source_id:"chunk-41597711835923a77b9f33543aee1546"}}, {start: {_id:5852}, end: {name:"Suffering"}, properties:{file_path:"unknown_source<SEP>YouTube Video: uvhEf3ToMHI (URL: https://www.youtube.com/watch?v=uvhEf3ToMHI)", keywords:"causes,inherent connection,leads to,life reality", truncate:"", weight:2.0, description:"Ignorance perpetuates suffering by fostering misguided beliefs about existence.<SEP>Ignorance is linked to suffering, as one cannot be free of suffering without overcoming ignorance.", created_at:1779551476, source_id:"chunk-0b3b9413e3a4acbecc07f577488e54e4<SEP>chunk-8f956406c1498a0f42494ef30d6087a0"}}, {start: {_id:5853}, end: {name:"Suffering"}, properties:{file_path:"unknown_source<SEP>YouTube Video: uvhEf3ToMHI (URL: https://www.youtube.com/watch?v=uvhEf3ToMHI)", keywords:"form of,manifestation,symbolic link,type of", truncate:"", weight:2.0, description:"Darkness represents the broader context of suffering experienced by humanity.<SEP>Suffering is described as a form of darkness that must be left behind.", created_at:1779551476, source_id:"chunk-0b3b9413e3a4acbecc07f577488e54e4<SEP>chunk-8f956406c1498a0f42494ef30d6087a0"}}, {start: {_id:5893}, end: {name:"Beautiful State"}, properties:{file_path:"unknown_source", keywords:"practice dimensions,spiritual growth", truncate:"", weight:2.0, description:"The practice systematically nurtures the three dimensions (calm, connected, creative) of the Beautiful State.<SEP>The practice systematically nurtures the three dimensions (calm, connected, creative) of the Beautiful State.", created_at:1779552285, source_id:"chunk-43e5b5923e8d509b9e9edf60b61ff56b"}}, {start: {_id:6212}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"emotional shift,temporary state", weight:1.0, description:"Initial thrill is followed by suffering, indicating a temporary state of happiness.", created_at:1779556061, source_id:"chunk-9c1aa39a1d495c6095f631b7613571fb"}}, {start: {_id:6211}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"negative emotions,temporal sequence", weight:1.0, description:"The initial euphoria is followed by suffering, showing a temporal sequence of emotional states.", created_at:1779556061, source_id:"chunk-9c1aa39a1d495c6095f631b7613571fb"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:Concept{name: row.end.name})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
UNWIND [{start: {_id:1615}, end: {name:"Consciousness"}, properties:{file_path:"unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", keywords:"consciousness,consciousness expansion,energy flow,influence,physiological response", truncate:"", weight:4.0, created_at:1779556960, description:"Breath practices influence consciousness by channeling Prana and altering mental states.<SEP>Breath influences consciousness through regulation.<SEP>Breath influences consciousness through regulation.<SEP>As consciousness expands, breath slows down and becomes less erratic, reflecting inner calm.", source_id:"chunk-e2d0ff9dea6a5334fbc3569bce6e4413<SEP>chunk-d887f374fce140e42345a26a703cd352<SEP>chunk-3198061b7d9cb7c891cdfe291494700c"}}, {start: {_id:453}, end: {name:"Beautiful State"}, properties:{file_path:"unknown_source", keywords:"alignment,prosperity", truncate:"", weight:1.0, description:"The beautiful state enables manifestation of abundance and success through universal support.", created_at:1779559844, source_id:"chunk-d18ebd8ed5109a40c69cb7a69ecd8f61"}}, {start: {_id:6411}, end: {name:"Beautiful State"}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"behavioral influence,driving force", weight:1.0, description:"Beautiful consciousness drives proactive, harmonious, and collaborative human actions.", created_at:1779560387, source_id:"chunk-a6934bb5f3e6b9a7dbc975f40692be35"}}, {start: {_id:6415}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"cellular harmony,healing", truncate:"", weight:1.0, description:"Oneness enables the body to enter a healing zone through synchronized cellular activity.", created_at:1779560529, source_id:"chunk-ffdd34b0438c947d32b8b2d304f135c4"}}, {start: {_id:6420}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"emotional connection,love", truncate:"", weight:1.0, description:"Oneness fosters enduring love by dissolving distances and opening hearts in relationships.", created_at:1779560529, source_id:"chunk-ffdd34b0438c947d32b8b2d304f135c4"}}, {start: {_id:6422}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"barrier removal,emotional release", weight:1.0, description:"Oneness helps the heart emerge from its defensive shell, fostering openness and connection.", created_at:1779560530, source_id:"chunk-ffdd34b0438c947d32b8b2d304f135c4"}}, {start: {_id:6428}, end: {name:"Consciousness"}, properties:{file_path:"unknown_source<SEP>YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"clarity,conceptual link,emotional state,equanimity", truncate:"", weight:2.0, description:"Enlightened consciousness enables profound states of bliss and equanimity, transcending negativity and enhancing life experiences.<SEP>Consciousness can manifest as bliss, flowing into interactions, solitude, and relationships.", created_at:1779561380, source_id:"chunk-1b0c6f6cf5b3451d482de925f92b2a15<SEP>chunk-9645fe2118f4e6de1b034351a972ae59"}}, {start: {_id:753}, end: {name:"Oneness"}, properties:{file_path:"unknown_source<SEP>YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"connection,family unity,love,transformation,unity", truncate:"", weight:2.0, description:"Oneness enables harmony in families, communities, and humanity through unity.<SEP>Oneness fosters harmony in families, promoting love and connection among members.", created_at:1779647060, source_id:"chunk-3f2351d7bbf12ee7e6a879305b4fddf7<SEP>chunk-00591c268a7fa36d70f44ba9311e9bba"}}, {start: {_id:2232}, end: {name:"Oneness"}, properties:{file_path:"unknown_source<SEP>YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"blessings,connection,consciousness,environmental healing,gratitude,healing,planetary connection", truncate:"", weight:6.0, created_at:1779648440, description:"Oneness fosters healing of Mother Earth and mutual love between humanity and Earth.<SEP>In the state of Oneness, healing occurs towards Mother Earth, accompanied by gratitude and the receipt of blessings.<SEP>Oneness leads to healing Mother Earth and recognizing the deep connection between humans and the planet.<SEP>Mother Earth is connected to the concept of Oneness, emphasizing the need to feel a profound connection with her for global harmony.<SEP>Oneness enables the healing of Mother Earth and establishes a profound connection between the individual and the planet.", source_id:"chunk-3f2351d7bbf12ee7e6a879305b4fddf7<SEP>chunk-04194c7a50041fcd44dfdf1f76e27a47<SEP>chunk-00591c268a7fa36d70f44ba9311e9bba<SEP>chunk-4c5c53ea662d003ac96f0faa52dfe234<SEP>chunk-eac7e627d7c0ee92a60f4bbbfb0776c3"}}, {start: {_id:6357}, end: {name:"Oneness"}, properties:{file_path:"unknown_source", keywords:"enlightenment,transformation", truncate:"", weight:1.0, description:"Oneness dissolves the divided state of eye consciousness, replacing separation with unity and harmony.", created_at:1779565493, source_id:"chunk-1d104bf7b587259887bc9a25750b3a02"}}, {start: {_id:6706}, end: {name:"Oneness"}, properties:{file_path:"unknown_source", keywords:"healing,integration", truncate:"", weight:1.0, description:"The state of oneness integrates fragmented self-identity (broken mirror) into wholeness, eliminating internal conflict.", created_at:1779565493, source_id:"chunk-1d104bf7b587259887bc9a25750b3a02"}}, {start: {_id:739}, end: {name:"Oneness"}, properties:{file_path:"unknown_source", keywords:"compassion,love", truncate:"", weight:1.0, description:"Oneness transforms family dynamics from division to connection and mutual understanding.", created_at:1779565495, source_id:"chunk-1d104bf7b587259887bc9a25750b3a02"}}, {start: {_id:123}, end: {name:"Oneness"}, properties:{file_path:"unknown_source<SEP>YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"collective healing,consciousness shift,global harmony,spiritual impact", truncate:"", weight:3.0, description:"Individual awakening to oneness triggers societal and planetary integration.<SEP>Oneness drives a shift in humanity's consciousness towards unity and collective responsibility.", created_at:1779647060, source_id:"chunk-1d104bf7b587259887bc9a25750b3a02<SEP>chunk-00591c268a7fa36d70f44ba9311e9bba"}}, {start: {_id:6713}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"bodily alignment,harmony", truncate:"", weight:2.0, description:"In Oneness, all cells in the body achieve harmony, symbolizing internal and external balance.<SEP>In Oneness, all cells in the body achieve harmony, symbolizing internal and external balance.", created_at:1779646710, source_id:"chunk-c2d71d77d8cb4da3ae9b2dde12795713"}}, {start: {_id:6725}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"integration,resolution", truncate:"", weight:1.0, description:"Achieving Oneness integrates the broken pieces, resolving internal conflicts.", created_at:1779647006, source_id:"chunk-abcd9205e6cb81b428a3257c9dbf7dc6"}}, {start: {_id:1179}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"identity,philosophical conflict", weight:1.0, description:"Oneness contrasts with conflicting parental ideals shaping individual identity.", created_at:1779647320, source_id:"chunk-fb20367827f31cb284dc2e32ba2e1bb0"}}, {start: {_id:1063}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"resolution,synthesis", truncate:"", weight:1.0, description:"Oneness is presented as the resolution where fragmented pieces like ambition coalesce", created_at:1779647442, source_id:"chunk-7acdb8dcc103d74a206701373f78fcb9"}}, {start: {_id:6748}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"resolution,synthesis", truncate:"", weight:1.0, description:"Hurts are included in the synthesis process leading to Oneness.", created_at:1779647442, source_id:"chunk-7acdb8dcc103d74a206701373f78fcb9"}}, {start: {_id:89}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"resolution,synthesis", truncate:"", weight:1.0, description:"Anger is listed as part of the internal conflicts resolved through Oneness.", created_at:1779647442, source_id:"chunk-7acdb8dcc103d74a206701373f78fcb9"}}, {start: {_id:1283}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"resolution,synthesis", truncate:"", weight:1.0, description:"Insecurity is mentioned as a contributing factor to the fragmentation resolved by Oneness.", created_at:1779647442, source_id:"chunk-7acdb8dcc103d74a206701373f78fcb9"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:Concept{name: row.end.name})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
UNWIND [{start: {_id:5781}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"address,solution", weight:1.0, description:"Oneness is presented as the solution to divisiveness caused by the human mind.", created_at:1779648506, source_id:"chunk-5e293d2f56a82348c78f2cc08b14a7e1"}}, {start: {_id:6843}, end: {name:"Consciousness"}, properties:{file_path:"YouTube Video: 1nhXsnx5--Y (URL: https://www.youtube.com/watch?v=1nhXsnx5--Y)", truncate:"", keywords:"relational foundation,unified awareness", weight:1.0, description:"Deep connections emerge from shared and interconnected consciousness.", created_at:1779651358, source_id:"chunk-1eb764bde7f7f1e1e97d8931c7b9875e"}}, {start: {_id:7063}, end: {name:"Consciousness"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", keywords:"adaptation,resilience", truncate:"", weight:1.0, description:"Consciousness provides the grounding needed to navigate challenges and uncertainties, similar to roots sustaining a tree during storms.", created_at:1779653847, source_id:"chunk-e5d8a73bfe09b1e5fab115705dfa0fe7"}}, {start: {_id:6421}, end: {name:"Consciousness"}, properties:{file_path:"YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", truncate:"", keywords:"correction,mishearing,transcription error", weight:2.0, description:"\"Circumference\" is likely a mishearing of \"consciousness\" in the transcript, given the context of spiritual or philosophical discussion.<SEP>Circumference is corrected to Consciousness.", created_at:1779656910, source_id:"chunk-5df138751f09bcc9c4d02f158a5b7e22<SEP>chunk-c95a104d9da85092c5bc85a30cbd4162"}}, {start: {_id:7113}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: 1PlGMOAypCI (URL: https://www.youtube.com/watch?v=1PlGMOAypCI)", truncate:"", keywords:"suffering", weight:1.0, description:"Idol leads to suffering.", created_at:1779655579, source_id:"chunk-8b53cedbcd4de86ef1b08281380f9428"}}, {start: {_id:1179}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: 1PlGMOAypCI (URL: https://www.youtube.com/watch?v=1PlGMOAypCI)", truncate:"", keywords:"suffering", weight:1.0, description:"Ideals cause suffering.", created_at:1779655579, source_id:"chunk-8b53cedbcd4de86ef1b08281380f9428"}}, {start: {_id:4963}, end: {name:"Oneness"}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"transcendence,universal unity", weight:1.0, description:"Enlightenment leads to experiencing oneness with universal consciousness.` - OK", created_at:1779661753, source_id:"chunk-9f245e3153d92a2c38134afd812338bf"}}, {start: {_id:7305}, end: {name:"Consciousness"}, properties:{file_path:"YouTube Video: vch9C_hNjGs (URL: https://www.youtube.com/watch?v=vch9C_hNjGs)", truncate:"", keywords:"origin,source", weight:1.0, description:"Consciousness originates from the bliss of being, serving as its foundation for action.", created_at:1779662712, source_id:"chunk-c9bb5b4ae7e13a7674f385925b990906"}}, {start: {_id:1815}, end: {name:"Karma"}, properties:{file_path:"unknown_source", keywords:"cause-effect,manifestation", truncate:"", weight:4.0, description:"Actions directly influence karma, as the text emphasizes that spreading negative states like hurt or anger results in corresponding problems.<SEP>Actions directly influence karma, as the text emphasizes that spreading negative states like hurt or anger results in corresponding problems.<SEP>Actions directly influence karma, as the text emphasizes that spreading negative states like hurt or anger results in corresponding problems.<SEP>Actions directly influence karma, as the text emphasizes that spreading negative states like hurt or anger results in corresponding problems.", created_at:1779667928, source_id:"chunk-e346b8f3e13471227b92c08380bf14d1"}}, {start: {_id:3455}, end: {name:"Dharma"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", truncate:"", keywords:"positive outcome,positive result,spiritual guidance,spiritual outcome", weight:2.0, description:"Blessings are a result of the process and support the discovery of dharma.", created_at:1779668464, source_id:"chunk-6625339a0a2d51687157190393908f25"}}, {start: {_id:2128}, end: {name:"Consciousness"}, properties:{file_path:"unknown_source", keywords:"enabling,overcoming past limitations", truncate:"", weight:1.0, description:"Consciousness transformation enables change in others, overcoming past limitations.", created_at:1779668711, source_id:"chunk-c088c9de5db4ddb6d01a048401214aef"}}, {start: {_id:430}, end: {name:"Consciousness"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"contrast,reflection", truncate:"", weight:1.0, description:"Childhood experiences of unmet kindness contrast with present consciousness enabling positive change.", created_at:1779669036, source_id:"chunk-313c3c4bd3fa26c1b3b5e358022a1e6b"}}, {start: {_id:7623}, end: {name:"Consciousness"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"influence,transformation", truncate:"", weight:1.0, description:"Transformed consciousness enables creating change in others by shifting from judgment to support.", created_at:1779669355, source_id:"chunk-fb3062b3d6881522fcc2387d435da879"}}, {start: {_id:7692}, end: {name:"Consciousness"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"context,metaphorical association", weight:1.0, description:"Consciousness is also associated with \"a huge baggage of thoughts.\"", created_at:1779671942, source_id:"chunk-c47a850c80a21ed6c67cbed2bc4b8ec0"}}, {start: {_id:1707}, end: {name:"Karma"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Ji-hdW1t30g)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=FP5O9F9JiOk)", truncate:"", keywords:"concept origin,cultural context,observation,philosophical discussion", weight:2.0, description:"The ancients in India formulated the concept of Karma through agricultural observations, linking planting actions to natural outcomes.<SEP>The ancients in India articulated and discussed the concept of karma, particularly its role in shaping human experience and destiny.", created_at:1779722029, source_id:"chunk-ed6b93b857d66f4aba7388c8d2b20ca9<SEP>chunk-e6bccf95254b72b0d63718f7708bb634"}}, {start: {_id:7700}, end: {name:"Karma"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Ji-hdW1t30g)", truncate:"", keywords:"analogy,example", weight:1.0, description:"The falling apple serves as an analogy to explain Karma's agency-less, law-like nature.", created_at:1779671953, source_id:"chunk-ed6b93b857d66f4aba7388c8d2b20ca9"}}, {start: {_id:7731}, end: {name:"Suffering State"}, properties:{file_path:"unknown_source", keywords:"conflict generation,obstruction", truncate:"", weight:1.0, description:"A suffering state within family members obstructs harmony and generates friction, undermining collective well-being.", created_at:1779672445, source_id:"chunk-836e578c5eddb352fd28d56ce3144bde"}}, {start: {_id:1696}, end: {name:"Consciousness"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)", truncate:"", keywords:"comparison,human vs. animal behavior,purpose", weight:2.0, description:"Consciousness is contrasted between humans and animals regarding the concept of having a destination.<SEP>Consciousness is compared to animals to highlight the importance of having a destination or purpose in life.", created_at:1779677952, source_id:"chunk-4dea19a1ca3602539d80b6f5c46066c4<SEP>chunk-47e8f33a6c085de5c83afa558a11cf07"}}, {start: {_id:1449}, end: {name:"Ekam"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)", truncate:"", keywords:"manifestation,philosophical concept,philosophy,spiritual term", weight:2.0, description:"Ekam is a spiritual term used in the context of discussing destiny.<SEP>Ekam provides a framework for creating magical destinies through conscious intention and spiritual transformation.", created_at:1779678540, source_id:"chunk-60b9693eb51ffe4e2e8a3252b647cd9b<SEP>chunk-e42bf74a0fbf1f4b3957648d5d4ff42d"}}, {start: {_id:7830}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=E8N04l1Lptk)", truncate:"", keywords:"category,cause", weight:2.0, description:"Psychological suffering is identified as a subset of suffering linked to personal hurts.<SEP>Psychological suffering is identified as a subset of suffering linked to personal hurts.", created_at:1779676221, source_id:"chunk-20d55a95f1cbc94a40998bcd62b8a62f"}}] AS row
