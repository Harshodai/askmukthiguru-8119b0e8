UNWIND [{start: {_id:1475}, end: {_id:1467}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"energy generation,harmony", truncate:"", weight:1.0, description:"One-consciousness creates an energy field of harmony and power.", created_at:1779144867, source_id:"chunk-386e51b3b7144cbed3517afa02fbb181"}}, {start: {_id:1301}, end: {_id:1467}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"intelligence generation", truncate:"", weight:1.0, description:"One-consciousness generates intelligence to overcome challenges.", created_at:1779144867, source_id:"chunk-386e51b3b7144cbed3517afa02fbb181"}}, {start: {_id:299}, end: {_id:1467}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"love generation", truncate:"", weight:1.0, description:"One-consciousness generates love to heal hurt.", created_at:1779144867, source_id:"chunk-386e51b3b7144cbed3517afa02fbb181"}}, {start: {_id:1467}, end: {_id:933}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"wealth generation", truncate:"", weight:1.0, description:"One-consciousness generates wealth to support more people.", created_at:1779144867, source_id:"chunk-386e51b3b7144cbed3517afa02fbb181"}}, {start: {_id:1474}, end: {_id:1467}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"enlightenment,journey process,progressive planes", truncate:"", weight:2.0, description:"Awakening is the journey into One-consciousness.<SEP>Awakening involves transitioning through planes of One-consciousness (beautiful, transcendental, enlightened) to achieve higher states of being.", created_at:1779188049, source_id:"chunk-386e51b3b7144cbed3517afa02fbb181<SEP>chunk-07bbbe415fc6ff4eb6e48c047d81efd5"}}, {start: {_id:1474}, end: {_id:1476}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"realization", truncate:"", weight:1.0, description:"Awakening leads to realizing that suffering states are nightmares.", created_at:1779144867, source_id:"chunk-386e51b3b7144cbed3517afa02fbb181"}}, {start: {_id:1479}, end: {_id:145}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"interpretation,philosophical view", truncate:"", weight:1.0, description:"The ancients interpreted suffering and separation-driven states as daymares from which humanity must awaken.", created_at:1779144921, source_id:"chunk-a6edb23148812a00c784704ababdb3ee"}}, {start: {_id:144}, end: {_id:1467}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"hierarchical structure,spiritual progression", weight:1.0, description:"Beautiful states are the first plane within the framework of One-Consciousness.", created_at:1779144921, source_id:"chunk-a6edb23148812a00c784704ababdb3ee"}}, {start: {_id:1467}, end: {_id:149}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"hierarchical structure,spiritual progression", weight:1.0, description:"Transcendental states represent the second plane of One-Consciousness.", created_at:1779144921, source_id:"chunk-a6edb23148812a00c784704ababdb3ee"}}, {start: {_id:1477}, end: {_id:145}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"existence,philosophical dichotomy", truncate:"", weight:1.0, description:"The text asserts that only suffering and no-suffering states exist, with no third state.", created_at:1779144921, source_id:"chunk-a6edb23148812a00c784704ababdb3ee"}}, {start: {_id:1480}, end: {_id:1467}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"hierarchical structure,spiritual progression", weight:1.0, description:"Enlightened states constitute the third and final plane of One-Consciousness.", created_at:1779144921, source_id:"chunk-a6edb23148812a00c784704ababdb3ee"}}, {start: {_id:1482}, end: {_id:145}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"intensification,progression", truncate:"", weight:1.0, description:"Suering can manifest as mild states like boredom or escalate into severe conditions like existential despair.", created_at:1779144921, source_id:"chunk-a6edb23148812a00c784704ababdb3ee"}}, {start: {_id:1479}, end: {_id:1467}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"enlightenment,spiritual framework", truncate:"", weight:1.0, description:"The ancients framed awakening as a transition from I-Consciousness to One-Consciousness through three planes of consciousness.", created_at:1779144921, source_id:"chunk-a6edb23148812a00c784704ababdb3ee"}}, {start: {_id:1479}, end: {_id:1481}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"interpretation,philosophical view", truncate:"", weight:2.0, description:"The ancients interpreted separation-driven states as daymares from which humanity must awaken.", created_at:1779144921, source_id:"chunk-a6edb23148812a00c784704ababdb3ee"}}, {start: {_id:1467}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conceptual origin,source", truncate:"", weight:1.0, description:"The text introduces One-Consciousness as a central theme in the document.", created_at:1779144921, source_id:"chunk-a6edb23148812a00c784704ababdb3ee"}}, {start: {_id:1479}, end: {_id:146}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"interpretation,philosophical view", truncate:"", weight:1.0, description:"The ancients interpreted suffering and separation-driven states as daymares from which humanity must awaken.", created_at:1779144921, source_id:"chunk-a6edb23148812a00c784704ababdb3ee"}}, {start: {_id:1483}, end: {_id:145}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"intensification,progression", truncate:"", weight:2.0, description:"Suering can manifest as mild states like boredom or escalate into severe conditions like existential despair.\" But the entity for suffering states is named \"Suering States\" with a typo (should be \"Suffering States\"). That's a formatting error. Also, the entity name has a typo in \"Suering\" instead of \"Suffering\".<SEP>Suering can manifest as mild states like boredom or escalate into severe conditions like existential despair.\" The entity name here is misspelled as \"Suering States\" instead of \"Suffering States\".", created_at:1779144922, source_id:"chunk-a6edb23148812a00c784704ababdb3ee"}}, {start: {_id:1486}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"conceptual framework,document discussion", weight:1.0, description:"The document discusses beautiful states of consciousness as part of its framework for understanding consciousness.", created_at:1779144958, source_id:"chunk-3cb8947ae1a7d163a44b8090dbb139a7"}}, {start: {_id:60}, end: {_id:149}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"conceptual framework,document discussion", weight:1.0, description:"The document categorizes transcendental states as part of the spectrum of conscious experience.", created_at:1779144958, source_id:"chunk-3cb8947ae1a7d163a44b8090dbb139a7"}}, {start: {_id:1485}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"conceptual framework,document discussion", weight:1.0, description:"The document mentions enlightened states as one of three planes of consciousness but does not elaborate further.", created_at:1779144958, source_id:"chunk-3cb8947ae1a7d163a44b8090dbb139a7"}}] AS row
