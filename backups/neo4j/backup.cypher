UNWIND [{start: {_id:1638}, end: {_id:3686}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", keywords:"content theme,repetition", truncate:"", weight:1.0, description:"The video contains the word \"immune\" repeatedly, forming its primary textual content and suggesting a possible thematic emphasis or technical anomaly.", created_at:1779236978, source_id:"chunk-3a18818ffd13339f2444819ee3a71fc2"}}, {start: {_id:1642}, end: {_id:1643}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", keywords:"data link,source", truncate:"", weight:1.0, description:"The URL is provided as a data link associated with the video.", created_at:1779237174, source_id:"chunk-f997d1d6ade7b75bc9ca2374e995779e"}}, {start: {_id:975}, end: {_id:968}, properties:{file_path:"unknown_source", keywords:"bait,trapping", truncate:"", weight:1.0, description:"Villagers catch monkeys by leaving desserts in a tree hole, exploiting the monkeys' attraction to the desserts.", created_at:1779237901, source_id:"chunk-f0801bcd006400c8824a3d4098716493"}}, {start: {_id:3688}, end: {_id:3689}, properties:{file_path:"unknown_source", keywords:"correction,typo", truncate:"", weight:1.0, description:"The user identified \"desert\" as a typo and corrected it to \"dessert\" to fix the", created_at:1779237901, source_id:"chunk-61865db1533922fc67b59d104261e28a"}}, {start: {_id:89}, end: {_id:975}, properties:{file_path:"unknown_source", keywords:"analogy,metaphor", truncate:"", weight:1.0, description:"Anger is likened to the monkey's inability to release the dessert, illustrating self-imposed limitations.", created_at:1779237901, source_id:"chunk-f0801bcd006400c8824a3d4098716493"}}, {start: {_id:3694}, end: {_id:1120}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=O1VkNuEChD4)", keywords:"attraction,entrapment", truncate:"", weight:1.0, description:"The monkey is attracted to the aromatic desserts in the hole but gets trapped due to the hole's size.", created_at:1779237972, source_id:"chunk-7bf65c644663a49c4d568dfba9827fc5"}}, {start: {_id:3690}, end: {_id:968}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=O1VkNuEChD4)", keywords:"luring,trapping method", truncate:"", weight:1.0, description:"Villagers use the tiny hole in a tree as part of their method to trap monkeys by placing aromatic desserts inside it.", created_at:1779237972, source_id:"chunk-7bf65c644663a49c4d568dfba9827fc5"}}, {start: {_id:1120}, end: {_id:968}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=O1VkNuEChD4)", truncate:"", keywords:"capture,release", weight:1.0, description:"Villagers capture the trapped monkey and release it into nearby forests to deter future mischief.", created_at:1779237973, source_id:"chunk-7bf65c644663a49c4d568dfba9827fc5"}}, {start: {_id:89}, end: {_id:3692}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=O1VkNuEChD4)", truncate:"", keywords:"clinging,metaphor", weight:1.0, description:"The angry mind is metaphorically compared to a monkey clinging to a dessert despite life's hardships.", created_at:1779237973, source_id:"chunk-7bf65c644663a49c4d568dfba9827fc5"}}, {start: {_id:3692}, end: {_id:3697}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=O1VkNuEChD4)", truncate:"", keywords:"behavior,misplaced responsibility", weight:1.0, description:"The angry mind blames others for personal problems, reflecting a refusal to take responsibility.", created_at:1779237973, source_id:"chunk-7bf65c644663a49c4d568dfba9827fc5"}}, {start: {_id:89}, end: {_id:3691}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=O1VkNuEChD4)", keywords:"consequence,intensification", truncate:"", weight:1.0, description:"Life's blows like loss of respect or job intensify anger and lead to wrong actions and words.", created_at:1779237973, source_id:"chunk-7bf65c644663a49c4d568dfba9827fc5"}}, {start: {_id:89}, end: {_id:3693}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=O1VkNuEChD4)", keywords:"consequence,escalation", truncate:"", weight:1.0, description:"Clinging to anger results in wrong actions and words, escalating personal and interpersonal conflicts.", created_at:1779237973, source_id:"chunk-7bf65c644663a49c4d568dfba9827fc5"}}, {start: {_id:115}, end: {_id:1120}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=O1VkNuEChD4)", keywords:"liberation,metaphor", truncate:"", weight:1.0, description:"The monkey's inability to let go illustrates the lack of freedom from anger.", created_at:1779238025, source_id:"chunk-339fa6ee789d0451cedd5e2548222d96"}}, {start: {_id:89}, end: {_id:3698}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=O1VkNuEChD4)", truncate:"", keywords:"emotional consequences,self-harm", weight:1.0, description:"Anger causes self-harm through negative thoughts and actions.", created_at:1779238025, source_id:"chunk-339fa6ee789d0451cedd5e2548222d96"}}, {start: {_id:3699}, end: {_id:3700}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=O1VkNuEChD4)", keywords:"consequences,self-harm", truncate:"", weight:1.0, description:"Angry thoughts, words, and actions directly cause personal loss and self-harm.", created_at:1779238025, source_id:"chunk-339fa6ee789d0451cedd5e2548222d96"}}, {start: {_id:115}, end: {_id:1618}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=O1VkNuEChD4)", truncate:"", keywords:"peace,resolution", weight:1.0, description:"Namaste signifies the achievement of freedom through reflection.", created_at:1779238025, source_id:"chunk-339fa6ee789d0451cedd5e2548222d96"}}, {start: {_id:89}, end: {_id:3697}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=O1VkNuEChD4)<SEP>YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"attribution,blame,cyclical behavior,externalization", weight:2.0, description:"Anger results in blaming others for one's problems.<SEP>Anger drives the tendency to blame others for personal struggles, perpetuating the cycle of resentment.", created_at:1779558181, source_id:"chunk-339fa6ee789d0451cedd5e2548222d96<SEP>chunk-04a5cce20e9ca029b1d885a9ee7c4ec6"}}, {start: {_id:89}, end: {_id:115}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=O1VkNuEChD4)", keywords:"conflict,liberation", truncate:"", weight:1.0, description:"Anger prevents freedom, which is achieved by letting go.", created_at:1779238025, source_id:"chunk-339fa6ee789d0451cedd5e2548222d96"}}, {start: {_id:89}, end: {_id:3699}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=O1VkNuEChD4)", keywords:"cause,manifestation", truncate:"", weight:1.0, description:"Anger manifests as angry thoughts, words, and actions that harm the individual.", created_at:1779238025, source_id:"chunk-339fa6ee789d0451cedd5e2548222d96"}}, {start: {_id:89}, end: {_id:3700}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=O1VkNuEChD4)", keywords:"conflict,consequence", truncate:"", weight:1.0, description:"Anger leads to loss through self-destructive behaviors and external blame.", created_at:1779238026, source_id:"chunk-339fa6ee789d0451cedd5e2548222d96"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
