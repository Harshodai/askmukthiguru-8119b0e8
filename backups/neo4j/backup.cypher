UNWIND [{start: {_id:4306}, end: {_id:4309}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"familial relationship,presence", weight:1.0, description:"The sentence explicitly states the presence of a biological father even without meeting them.", created_at:1779261550, source_id:"chunk-1d975f0d94f46d7a04c2a2a43677deb7"}}, {start: {_id:4286}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"concept discussion,cultural context", weight:1.0, description:"The YouTube Video discusses samskaras as a domain-specific term related to inherited tendencies and karmic concepts.", created_at:1779261602, source_id:"chunk-accdc31e9607c3940aed49cc5de73ff1"}}, {start: {_id:4278}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"psychological analysis,spiritual concepts", weight:1.0, description:"The YouTube Video explores karmic evolution as a process of personal and spiritual development.", created_at:1779261603, source_id:"chunk-accdc31e9607c3940aed49cc5de73ff1"}}, {start: {_id:4274}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)<SEP>YouTube Video: idoWVpnJz-Y (URL: https://www.youtube.com/watch?v=idoWVpnJz-Y)", truncate:"", keywords:"celebration,content source,social commentary,tradition", weight:2.0, description:"The YouTube Video references Father's Day as a modern tradition promoting familial healing and connection.<SEP>The YouTube Video contains a message celebrating Father's Day and encouraging gratitude towards fathers.", created_at:1779401986, source_id:"chunk-accdc31e9607c3940aed49cc5de73ff1<SEP>chunk-c1b8715ddbbe0589011d5273af6804ce"}}, {start: {_id:4274}, end: {_id:4312}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"celebration,philosophical expansion", weight:1.0, description:"Father's Day is framed as an occasion to celebrate not just biological fathers but also other fatherly figures, reflecting the speaker's expanded perspective on fatherhood.", created_at:1779261627, source_id:"chunk-dc87b4124e027c8ceb12ac0f766b4f97"}}, {start: {_id:4310}, end: {_id:4311}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"cultural reference,textual interpretation", weight:1.0, description:"The verse is presented as part of the ancient Hindu chant, with the speaker providing a contextual explanation of its meaning.", created_at:1779261627, source_id:"chunk-dc87b4124e027c8ceb12ac0f766b4f97"}}, {start: {_id:4312}, end: {_id:4311}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"conceptual alignment,philosophical basis", weight:1.0, description:"The verse serves as a scriptural foundation for the concept of honoring five types of father figures.", created_at:1779261627, source_id:"chunk-dc87b4124e027c8ceb12ac0f766b4f97"}}, {start: {_id:4314}, end: {_id:4315}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"domain-specific error,textual reference", weight:1.0, description:"The garbled verse is cited as part of the Bhagavad Gita's content with transcription inaccuracies.", created_at:1779261650, source_id:"chunk-11e9e2ed6005eca5a1fae0e5e949a2a9"}}, {start: {_id:4315}, end: {_id:4313}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"contextual definition,explanation", weight:1.0, description:"The meaning explanation clarifies the intended interpretation of the garbled verse despite its flawed transcription.", created_at:1779261650, source_id:"chunk-11e9e2ed6005eca5a1fae0e5e949a2a9"}}, {start: {_id:4317}, end: {_id:2279}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"error location,text segment", weight:1.0, description:"The transcription contains the garbled chant segment requiring correction.", created_at:1779261668, source_id:"chunk-c93ac533cca8925d75aa65176000c35b"}}, {start: {_id:4316}, end: {_id:2279}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"contextual separation,text components", weight:1.0, description:"The definition is part of the text's content separate from the garbled transcription.", created_at:1779261668, source_id:"chunk-c93ac533cca8925d75aa65176000c35b"}}, {start: {_id:4318}, end: {_id:4317}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"analysis focus,error correction", weight:1.0, description:"The author discusses the garbled chant's potential correction.", created_at:1779261668, source_id:"chunk-c93ac533cca8925d75aa65176000c35b"}}, {start: {_id:4316}, end: {_id:4321}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"contextual separation,text hierarchy", weight:1.0, description:"The list of definitions is part of the text's structure following the garbled chant transcription.", created_at:1779261668, source_id:"chunk-c93ac533cca8925d75aa65176000c35b"}}, {start: {_id:4320}, end: {_id:2279}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"output requirement,task directive", weight:1.0, description:"The prompt mandates fixing transcription errors in the provided text.", created_at:1779261669, source_id:"chunk-c93ac533cca8925d75aa65176000c35b"}}, {start: {_id:4317}, end: {_id:4319}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"linguistic plausibility,replacement option", weight:1.0, description:"Proposed as a corrected version for the garbled segment.", created_at:1779261669, source_id:"chunk-c93ac533cca8925d75aa65176000c35b"}}, {start: {_id:4318}, end: {_id:4316}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"conceptual link,interpretive framework", weight:1.0, description:"The explanation connects the definition to the transcription's structure.", created_at:1779261669, source_id:"chunk-c93ac533cca8925d75aa65176000c35b"}}, {start: {_id:127}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", keywords:"analysis,content creator", truncate:"", weight:1.0, description:"The author created the video to analyze and correct errors in the text.", created_at:1779261730, source_id:"chunk-609eba9953b128ee5842ae83faafcdb9"}}, {start: {_id:4326}, end: {_id:4325}, properties:{file_path:"YouTube Video: 4_Fqfew1PRk (URL: https://www.youtube.com/watch?v=4_Fqfew1PRk)", truncate:"", keywords:"educational focus,ineffectiveness,practical application,time management", weight:2.0, description:"Coachings and lessons are ineffective without a state, making time management unmanageable.<SEP>Coachings include managing time as a strategy, though effectiveness depends on the individual's state.", created_at:1779393709, source_id:"chunk-6c4e90f0f66c98634e4d4ac55a3fa81b<SEP>chunk-858bc08530c3ab537fc81f04b5fef0be"}}, {start: {_id:127}, end: {_id:4323}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"error correction,methodology", weight:1.0, description:"The author's intent to correct errors without altering original content aligns with their methodology for preserving authorial intent.", created_at:1779261730, source_id:"chunk-609eba9953b128ee5842ae83faafcdb9"}}, {start: {_id:4322}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"analysis focus,textual content", weight:1.0, description:"The list of phrases is analyzed within the video as part of the text's content.", created_at:1779261733, source_id:"chunk-609eba9953b128ee5842ae83faafcdb9"}}] AS row
