UNWIND [{start: {_id:6649}, end: {_id:2378}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"disapproval,reprimand", truncate:"", weight:1.0, description:"The boy's parents reprimanded him because of the aunt's disapproval.", created_at:1779564376, source_id:"chunk-8bc46e0d57c8aca69ad6ab17dc5cfd03"}}, {start: {_id:4286}, end: {_id:6651}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"psychological impact,unconscious influence", weight:1.0, description:"ed's samskaras from childhood experiences influence his behavior and judgments.", created_at:1779564385, source_id:"chunk-08331bfaac45fcb68867c11cb7fb41b4"}}, {start: {_id:4286}, end: {_id:6652}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"cause and effect,psychological impact", weight:1.0, description:"samskaras cause repetitive life patterns throughout one's life.", created_at:1779564386, source_id:"chunk-08331bfaac45fcb68867c11cb7fb41b4"}}, {start: {_id:108}, end: {_id:6655}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"healing,spiritual guidance", weight:1.0, description:"The Mystic process involves the Divine providing healing and guidance to the individual.", created_at:1779564440, source_id:"chunk-f35ecb38bfeca95ba27fabf08e8561a8"}}, {start: {_id:6653}, end: {_id:2444}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"breaking the flow,positive change", weight:1.0, description:"Forgiving oneself breaks the flow of negative karmic energy and allows for positive change.", created_at:1779564440, source_id:"chunk-f35ecb38bfeca95ba27fabf08e8561a8"}}, {start: {_id:6657}, end: {_id:6656}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"breaking the loop,transformation", weight:1.0, description:"Authentic forgiving oneself breaks the karmic loop and leads to transformation.", created_at:1779564440, source_id:"chunk-f35ecb38bfeca95ba27fabf08e8561a8"}}, {start: {_id:6659}, end: {_id:6658}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"new beginning,positive change", weight:1.0, description:"Breaking negative karmic energy allows for a new, harmonious flow of life.", created_at:1779564440, source_id:"chunk-f35ecb38bfeca95ba27fabf08e8561a8"}}, {start: {_id:6654}, end: {_id:6655}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"life perspective,transformation", weight:1.0, description:"The Karmic flu represents the individual's life perspective and the transformation that occurs during the Mystic process.", created_at:1779564440, source_id:"chunk-f35ecb38bfeca95ba27fabf08e8561a8"}}, {start: {_id:6638}, end: {_id:6640}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"guilt,infidelity,temptation", weight:2.0, description:"Indra tempts Ahalya, leading to her infidelity.<SEP>Ahalya committed infidelity with Indra, leading to guilt and shame.", created_at:1779564445, source_id:"chunk-f35ecb38bfeca95ba27fabf08e8561a8<SEP>chunk-6a0ae176234daa0b99856020306df342"}}, {start: {_id:6638}, end: {_id:6662}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"narration,story", weight:1.0, description:"Damayana narrated the story of Ahalya, which involved her transformation.", created_at:1779564445, source_id:"chunk-6a0ae176234daa0b99856020306df342"}}, {start: {_id:6638}, end: {_id:6660}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"ending,transformation", truncate:"", weight:1.0, description:"Ahalya's transformation ended the karmic cycle.", created_at:1779564445, source_id:"chunk-6a0ae176234daa0b99856020306df342"}}, {start: {_id:6638}, end: {_id:6665}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"reconciliation", weight:1.0, description:"Ahalya's transformation led to the restoration of her family.", created_at:1779564445, source_id:"chunk-6a0ae176234daa0b99856020306df342"}}, {start: {_id:6638}, end: {_id:6666}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"forgiveness,overcoming", truncate:"", weight:1.0, description:"Ahalya overcame self-judgment through Rama's compassion.", created_at:1779564445, source_id:"chunk-6a0ae176234daa0b99856020306df342"}}, {start: {_id:6638}, end: {_id:2584}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"ending", weight:1.0, description:"Ahalya's transformation ended the negative karma in her life.", created_at:1779564445, source_id:"chunk-6a0ae176234daa0b99856020306df342"}}, {start: {_id:6638}, end: {_id:25}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"compassion,transformation", truncate:"", weight:1.0, description:"Ahalya's transformation was a result of compassion and led to peace.", created_at:1779564445, source_id:"chunk-6a0ae176234daa0b99856020306df342"}}, {start: {_id:6638}, end: {_id:991}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"healing,milestone", weight:1.0, description:"Forgiveness is a crucial milestone for Ahalya's healing.", created_at:1779564445, source_id:"chunk-6a0ae176234daa0b99856020306df342"}}, {start: {_id:6638}, end: {_id:2816}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"emotional states,unknowingly", weight:1.0, description:"Ahalya's mistakes occurred unknowingly or due to emotional states.", created_at:1779564446, source_id:"chunk-6a0ae176234daa0b99856020306df342"}}, {start: {_id:6638}, end: {_id:6667}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"causing,self-judgment", truncate:"", weight:1.0, description:"Destructive emotional states caused Ahalya's mistakes and self-judgment.", created_at:1779564446, source_id:"chunk-6a0ae176234daa0b99856020306df342"}}, {start: {_id:6638}, end: {_id:6668}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"compassion,healing", truncate:"", weight:1.0, description:"Ahalya's wounds in the heart must be healed through compassion.", created_at:1779564446, source_id:"chunk-6a0ae176234daa0b99856020306df342"}}, {start: {_id:6638}, end: {_id:6669}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"crucial,healing", weight:1.0, description:"Compassion for oneself is crucial for healing Ahalya's heart.", created_at:1779564446, source_id:"chunk-6a0ae176234daa0b99856020306df342"}}] AS row
