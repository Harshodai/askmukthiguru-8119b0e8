UNWIND [{_id:7329, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"concept", truncate:"", description:"The act of conquering other people's lands or riches, which is contrasted with the principle of Ahimsa.<SEP>The act of conquering other people's lands or riches, which is contrasted with the principle of Ahimsa.", created_at:1779663171, source_id:"chunk-31d0c1d0868a0433b37bd7b3d6982020", entity_id:"Conquer Other People's Lands or Riches"}}, {_id:7330, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"concept", truncate:"", description:"Offensive War is a concept that Indian Armed Forces avoid.", created_at:1779663181, source_id:"chunk-f165625f110b68853dd8f62e86067abc", entity_id:"Offensive War"}}, {_id:7331, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"organization", truncate:"", created_at:1779663277, description:"Indian Armed Forces are a military organization that avoids offensive war.<SEP>The Indian Armed Forces are mentioned in the context of the analysis.<SEP>The Indian Armed Forces are referenced as a modern military entity in the discussion.", source_id:"chunk-f165625f110b68853dd8f62e86067abc<SEP>chunk-9d3dc0d7e3d5f00409884918b93104a2<SEP>chunk-5345dea91d4424a106a1b8dd1d7e28bc", entity_id:"Indian Armed Forces"}}, {_id:7332, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"person", truncate:"", description:"Indian soldiers are a collective group known for dedication and fearlessness.", created_at:1779663181, source_id:"chunk-f165625f110b68853dd8f62e86067abc", entity_id:"Indian soldiers"}}, {_id:7333, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", entity_type:"UNKNOWN", truncate:"", description:"Indian soldiers exhibit dedication and fea