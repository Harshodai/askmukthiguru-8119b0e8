UNWIND [{start: {name:"Consciousness"}, end: {_id:299}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)<SEP>YouTube Video: 3WnNyhhB_4w (URL: https://www.youtube.com/watch?v=3WnNyhhB_4w)", truncate:"", keywords:"aspect,awakening,connection,consciousness,emotion,emotional state,love", weight:3.0, created_at:1779519835, description:"Awakened consciousness includes embracing love for meaningful connections.<SEP>The speech emphasizes that awakened consciousness must embrace love as a core value.<SEP>Awakening to love is a revolution in consciousness.", source_id:"chunk-e27c90d3f030c932363441c1ed78bf62<SEP>chunk-18bc78e6744f00b7477a42dba8a8367d<SEP>chunk-811e6c42c9ccf4bfac70459d1ccf2336"}}, {start: {name:"Consciousness"}, end: {_id:5275}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", keywords:"aspect,awakening,mission,motivation,purpose", truncate:"", weight:2.0, description:"Awakened consciousness includes embracing purpose for driving societal progress.<SEP>The speech links the awakening of consciousness to a greater purpose in life for future leaders.", created_at:1779447742, source_id:"chunk-e27c90d3f030c932363441c1ed78bf62<SEP>chunk-18bc78e6744f00b7477a42dba8a8367d"}}, {start: {name:"Consciousness"}, end: {_id:5283}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", keywords:"awakening,future,leadership", truncate:"", weight:1.0, description:"The speech identifies next generation leaders as those who will awaken consciousness to peace, love, and purpose.", created_at:1779447743, source_id:"chunk-18bc78e6744f00b7477a42dba8a8367d"}}, {start: {name:"Consciousness"}, end: {_id:2892}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", truncate:"", keywords:"focus,teaching", weight:1.0, description:"The Spiritual Platform emphasizes the concept of consciousness in its teachings.", created_at:1779447877, source_id:"chunk-19de200e362a0af16f232c1f956ad32c"}}, {start: {name:"Ekam"}, end: {_id:5290}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", truncate:"", keywords:"conceptual fit,contextual relevance", weight:1.0, description:"Ekam is considered a plausible missing term due to its alignment with themes of oneness and consciousness.", created_at:1779448123, source_id:"chunk-67c71335838e7d9c72ee9c00d04337d4"}}, {start: {name:"Consciousness"}, end: {_id:32}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", truncate:"", keywords:"awakening,spiritual growth", weight:1.0, description:"Consciousness must awaken to a greater purpose in life, driving leadership in diverse fields.", created_at:1779448280, source_id:"chunk-08f19d081ba1db71567273cb28ac6446"}}, {start: {name:"Consciousness"}, end: {_id:1594}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"contribution,influence,path to enlightenment,practice,self-realization,spiritual practice", weight:5.0, description:"Sadhana (spiritual practice) facilitates the awakening of consciousness to higher purpose.<SEP>Consciousness contributes to sadhana, which is part of the path to enlightenment.<SEP>Consciousness is a key factor in sadhana, influencing the path to enlightenment.<SEP>Consciousness contributes to sadhana, which is part of the path to enlightenment.<SEP>Consciousness is a key factor in sadhana, influencing the path to enlightenment.", created_at:1779556866, source_id:"chunk-08f19d081ba1db71567273cb28ac6446<SEP>chunk-d887f374fce140e42345a26a703cd352"}}, {start: {name:"Consciousness"}, end: {_id:1619}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", truncate:"", keywords:"content context,spiritual platform", weight:1.0, description:"Mukthi Guru provides the framework for discussing consciousness and purpose in spiritual leadership.", created_at:1779448281, source_id:"chunk-08f19d081ba1db71567273cb28ac6446"}}, {start: {name:"Consciousness"}, end: {_id:1500}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"awakening,meditation", truncate:"", weight:1.0, description:"The Limitless Field is where meditation occurs, leading to the awakening of consciousness to true oneness.", created_at:1779453042, source_id:"chunk-789bf2d75055e2793929c4fd3bb0d56b"}}, {start: {name:"Consciousness"}, end: {_id:5314}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"awareness,teaching", truncate:"", weight:1.0, description:"Peace of mind is taught as part of achieving higher consciousness and awareness.", created_at:1779453042, source_id:"chunk-789bf2d75055e2793929c4fd3bb0d56b"}}, {start: {name:"Consciousness"}, end: {_id:5322}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"meditation,spiritual awakening", weight:1.0, description:"Consciousness is described as awakening to \"true oneness\" through meditative practice in the peace/Limitless Field context.", created_at:1779453162, source_id:"chunk-f1f81e864da7b8ec0ed93a28a3397730"}}, {start: {name:"Dharma"}, end: {_id:5352}, properties:{file_path:"unknown_source", keywords:"guardianship,moral duty", truncate:"", weight:1.0, description:"Dharma involves protecting the innocence and future of children through righteous actions.", created_at:1779455349, source_id:"chunk-c31c96b585957b3d969c1f44467db292"}}, {start: {name:"Dharma"}, end: {_id:5374}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", truncate:"", keywords:"purpose,spiritual awakening", weight:1.0, description:"The gathering's purpose is to fulfill the Dharma of protecting the innocence and future of the world's children.", created_at:1779455817, source_id:"chunk-00b63395d5ef5274c1baeb0f4e99541f"}}, {start: {name:"Consciousness"}, end: {_id:2390}, properties:{file_path:"unknown_source", keywords:"consciousness study,mystic science", truncate:"", weight:1.0, description:"Spirituality is framed as the mystic science of consciousness and its awakening, forming its foundational study.", created_at:1779511101, source_id:"chunk-eb1bcec2ec4775f87f2a9dcf795a907a"}}, {start: {name:"Guru"}, end: {_id:1782}, properties:{file_path:"YouTube Video: Qu5IQo0ghbs (URL: https://www.youtube.com/watch?v=Qu5IQo0ghbs)", keywords:"admiration,respect", truncate:"", weight:1.0, description:"Speaker expresses deep respect for Krishnaji as a compassionate and powerful Guru.", created_at:1779518181, source_id:"chunk-79727c38a2ca8d63adfca02ee83cd218"}}, {start: {name:"Consciousness"}, end: {_id:5476}, properties:{file_path:"YouTube Video: WOKBogNTmPI (URL: https://www.youtube.com/watch?v=WOKBogNTmPI)", truncate:"", keywords:"consciousness application,life achievements", weight:1.0, description:"The One Consciousness Business Circle uses consciousness principles to drive personal and professional success.", created_at:1779518234, source_id:"chunk-6988c802643ab5986cfc41940a6f6b44"}}, {start: {name:"Consciousness"}, end: {_id:5482}, properties:{file_path:"YouTube Video: WOKBogNTmPI (URL: https://www.youtube.com/watch?v=WOKBogNTmPI)", truncate:"", keywords:"life guidance,spiritual alignment", weight:1.0, description:"Synchronicities occur as manifestations of aligned consciousness during life journeys.", created_at:1779518234, source_id:"chunk-6988c802643ab5986cfc41940a6f6b44"}}, {start: {name:"Consciousness"}, end: {_id:120}, properties:{file_path:"YouTube Video: WOKBogNTmPI (URL: https://www.youtube.com/watch?v=WOKBogNTmPI)", keywords:"disconnection,manifestation", truncate:"", weight:1.0, description:"Life problems stem from disconnected consciousness affecting health, relationships, and society.", created_at:1779518234, source_id:"chunk-6988c802643ab5986cfc41940a6f6b44"}}, {start: {name:"Consciousness"}, end: {_id:4327}, properties:{file_path:"YouTube Video: YguId6pF5KI (URL: https://www.youtube.com/watch?v=YguId6pF5KI)", truncate:"", keywords:"education,philosophical foundation", weight:1.0, description:"The teachings are based on consciousness philosophy and aim to educate leaders.", created_at:1779518308, source_id:"chunk-f66651ee848911049e03ee6f58135f0a"}}, {start: {name:"Sankalpa"}, end: {_id:3522}, properties:{file_path:"unknown_source", truncate:"", keywords:"spiritual practice,symbolic representation", weight:1.0, description:"Ugadi Pachadi symbolizes the practice of Sankalpa in creating a new inner universe.", created_at:1779519040, source_id:"chunk-6af3220a340f626ce621832ca3542da1"}}] AS row
