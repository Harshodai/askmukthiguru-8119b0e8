, {_id:5909, properties:{file_path:"YouTube Video: M_BYTcsLQuY (URL: https://www.youtube.com/watch?v=M_BYTcsLQuY)<SEP>unknown_source", entity_type:"event", truncate:"", created_at:1779732038, description:"The Soul Sync Challenge is a multi-day event where participants engage in daily mantra practice to expand consciousness.<SEP>The Soul Sync Challenge is a meditation program designed to help participants master synchronization with Universal Consciousness through guided practices.<SEP>The Soul Sync Challenge is a meditation program designed to help participants master synchronization with Universal Consciousness through guided practices.<SEP>The Soul Sync Challenge is a meditation event that occurs on Day Two and involves multiple stages, including the second stage which aims to achieve relaxation.", source_id:"chunk-8aa416f4b92bde5e908126e0e7ad0000<SEP>chunk-bcc3c744d91ef9d256a5b7e4cc0ab412<SEP>chunk-e7c18228609ac51ebd48c9c0f7da32d4", entity_id:"Soul Sync Challenge"}}, {_id:5910, properties:{file_path:"YouTube Video: M_BYTcsLQuY (URL: https://www.youtube.com/watch?v=M_BYTcsLQuY)", entity_type:"category", truncate:"", description:"The number of days left in the Soul Sync Challenge, currently two, indicating proximity to completion.", created_at:1779552683, source_id:"chunk-8aa416f4b92bde5e908126e0e7ad0000", entity_id:"Days Remaining"}}, {_id:5911, properties:{file_path:"YouTube Video: M_BYTcsLQuY (URL: https://www.youtube.com/watch?v=M_BYTcsLQuY)", entity_type:"content", truncate:"", description:"A YouTube video titled \"M_BYTcsLQuY\" serves as the source of guidance and updates for the Soul Sync Challenge participants.", created_at:1779552683, source_id:"chunk-8aa416f4b92bde5e908126e0e7ad0000", entity_id:"M_BYTcsLQuY"}}, {_id:5912, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Mystical potential refers to the innate capacity for transcending physical limitations and accessing higher states of awareness.", created_at:1779552791, source_id:"chunk-14f9aad35378ea842ed9adc84e1e533e<SEP>chunk-63b506b1313a8519582cddd6663d331d", entity_id:"Mystical Potential"}}, {_id:5913, properties:{file_path:"unknown_source", entity_type:"event", truncate:"", description:"Day 7 is the final day of the Sourcing Challenge, marking the culmination of the participant's journey.", created_at:1779552791, source_id:"chunk-14f9aad35378ea842ed9adc84e1e533e", entity_id:"Day 7"}}, {_id:5914, properties:{file_path:"unknown_source", entity_type:"event", truncate:"", description:"Day 60 is part of the Sourcing Challenge, emphasizing discipline and preparation for the final stages of the program.", created_at:1779552791, source_id:"chunk-14f9aad35378ea842ed9adc84e1e533e", entity_id:"Day 60"}}, {_id:5915, properties:{file_path:"unknown_source<SEP>YouTube Video: co9vrSiN8ak (URL: https://www.youtube.com/watch?v=co9vrSiN8ak)", entity_type:"event", truncate:"", description:"The Soul Sink Meditation is a guided practice aimed at transcending limiting self-identity and accessing limitless consciousness.<SEP>The Soul Sink Meditation is a stage in the Sourcing Challenge that aims to transcend thought and action to access deeper consciousness.", created_at:1779552797, source_id:"chunk-14f9aad35378ea842ed9adc84e1e533e<SEP>chunk-63b506b1313a8519582cddd6663d331d", entity_id:"Soul Sink Meditation"}}, {_id:5916, properties:{file_path:"unknown_source<SEP>YouTube Video: co9vrSiN8ak (URL: https://www.youtube.com/watch?v=co9vrSiN8ak)", entity_type:"concept", truncate:"", description:"Limiting self-identity is the perception of being confined to a physical body, contrasting with the expansive nature of consciousness.<SEP>Limiting self-identity is described as a restrictive perception of oneself tied to the physical body, which must be transcended for spiritual growth.", created_at:1779552797, source_id:"chunk-14f9aad35378ea842ed9adc84e1e533e<SEP>chunk-63b506b1313a8519582cddd6663d331d", entity_id:"Limiting Self-Identity"}}, {_id:5917, properties:{file_path:"unknown_source<SEP>YouTube Video: co9vrSiN8ak (URL: https://www.youtube.com/watch?v=co9vrSiN8ak)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=X3LKG0Ycl3A)", entity_type:"concept", truncate:"", created_at:1779728696, description:"Limitless consciousness is an expansive state of awareness beyond physical boundaries, associated with energy, light, and infinite possibilities.<SEP>State of awareness transcending physical and mental limitations.<SEP>Limitless Consciousness is a state", source_id:"chunk-14f9aad35378ea842ed9adc84e1e533e<SEP>chunk-095655c628157e4cc94eedb07a0968a6<SEP>chunk-1562804ee3c24ef170ff1410baf6ad2d", entity_id:"Limitless Consciousness"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:5918, properties:{file_path:"unknown_source<SEP>YouTube Video: co9vrSiN8ak (URL: https://www.youtube.com/watch?v=co9vrSiN8ak)", entity_type:"concept", truncate:"", description:"Heartfelt intention represents a genuine desire or goal that participants learn to manifest through meditation.<SEP>Heartfelt intention refers to personal desires or goals that participants aim to manifest through advanced meditation techniques.", created_at:1779552797, source_id:"chunk-14f9aad35378ea842ed9adc84e1e533e<SEP>chunk-63b506b1313a8519582cddd6663d331d", entity_id:"Heartfelt Intention"}}, {_id:5919, properties:{file_path:"unknown_source<SEP>YouTube Video: co9vrSiN8ak (URL: https://www.youtube.com/watch?v=co9vrSiN8ak)", entity_type:"concept", truncate:"", description:"The infinite field of consciousness is a metaphysical space representing endless possibilities and universal awareness.<SEP>Philosophical concept representing all-encompassing awareness beyond individual limits.", created_at:1779552819, source_id:"chunk-14f9aad35378ea842ed9adc84e1e533e<SEP>chunk-095655c628157e4cc94eedb07a0968a6", entity_id:"Infinite Field of Consciousness"}}, {_id:5923, properties:{file_path:"YouTube Video: co9vrSiN8ak (URL: https://www.youtube.com/watch?v=co9vrSiN8ak)", entity_type:"concept", truncate:"", description:"The limitless ocean of light symbolizes the expansive, boundless nature of consciousness and energy during advanced meditation states.", created_at:1779552797, source_id:"chunk-63b506b1313a8519582cddd6663d331d", entity_id:"Limitless Ocean of Light"}}, {_id:5924, properties:{file_path:"YouTube Video: co9vrSiN8ak (URL: https://www.youtube.com/watch?v=co9vrSiN8ak)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"The concept represents the expansive state of consciousness achieved during advanced meditation.<SEP>Consciousness expansion refers to the process of broadening one's awareness to include others and transcend individual boundaries.", created_at:1779669234, source_id:"chunk-63b506b1313a8519582cddd6663d331d<SEP>chunk-149f1fa94cc8d81b9d634c9e418c534a", entity_id:"Consciousness Expansion"}}, {_id:5925, properties:{file_path:"YouTube Video: co9vrSiN8ak (URL: https://www.youtube.com/watch?v=co9vrSiN8ak)", entity_type:"UNKNOWN", truncate:"", description:"The meditation transcends reliance on thought and action to access deeper consciousness.", created_at:1779552798, source_id:"chunk-63b506b1313a8519582cddd6663d331d", entity_id:"Thought and Action"}}, {_id:5927, properties:{file_path:"YouTube Video: co9vrSiN8ak (URL: https://www.youtube.com/watch?v=co9vrSiN8ak)", entity_type:"content", truncate:"", description:"Source material containing the meditation guide content.", created_at:1779552819, source_id:"chunk-095655c628157e4cc94eedb07a0968a6", entity_id:"YouTube Video (co9vrSiN8ak)"}}, {_id:5929, properties:{file_path:"YouTube Video: co9vrSiN8ak (URL: https://www.youtube.com/watch?v=co9vrSiN8ak)", entity_type:"method", truncate:"", description:"Technique involving mental imagery to expand self-perception beyond physical boundaries.", created_at:1779552819, source_id:"chunk-095655c628157e4cc94eedb07a0968a6", entity_id:"Visualization of Expansion"}}, {_id:5930, properties:{file_path:"YouTube Video: co9vrSiN8ak (URL: https://www.youtube.com/watch?v=co9vrSiN8ak)", entity_type:"event", truncate:"", description:"Final meditation challenge in a series emphasizing limitless consciousness awareness.", created_at:1779552819, source_id:"chunk-095655c628157e4cc94eedb07a0968a6", entity_id:"Seventh Day Challenge"}}, {_id:5931, properties:{file_path:"YouTube Video: co9vrSiN8ak (URL: https://www.youtube.com/watch?v=co9vrSiN8ak)", entity_type:"content", truncate:"", description:"Meditation guide providing instructions for expanding self-awareness through visualization and breathwork.", created_at:1779552819, source_id:"chunk-095655c628157e4cc94eedb07a0968a6", entity_id:"Meditatio