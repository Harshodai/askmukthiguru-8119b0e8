UNWIND [{_id:2850, properties:{file_path:"unknown_source", entity_type:"content", truncate:"", description:"Financial assistance provided by Christina to Lee?s daughter, later perceived as exploited.", created_at:1779183861, source_id:"chunk-b66967ff647e15e2ccfdb242ffc22fb6", entity_id:"Financial Support"}}, {_id:2851, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"The Girlfriend is the man's partner, whose relationship with him transforms after his self-realization.", created_at:1779183920, source_id:"chunk-21bacf187c7f2b778c240499081154ba", entity_id:"The Girlfriend"}}, {_id:2852, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Habitual States of Suering are recurring negative emotional patterns, such as anxiety, stress, anger, disappointment, and jealousy, that can be mitigated by practicing inner truth.", created_at:1779183921, source_id:"chunk-b08d62f86bbc31949dd35e6cc9e75def", entity_id:"Habitual States of Suering"}}, {_id:2853, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Poisonous Weeds is a metaphor for negative emotions that, like weeds, can choke and destroy beautiful aspects of life.", created_at:1779183922, source_id:"chunk-b08d62f86bbc31949dd35e6cc9e75def", entity_id:"Poisonous Weeds"}}, {_id:2855, properties:{file_path:"unknown_source", entity_type:"method", truncate:"", description:"The process designed by Krishnaji is aimed at helping individuals like Diego disengage from self-obsession and suffering.", created_at:1779183929, source_id:"chunk-999192b96103e7c498639cfadd062722", entity_id:"The Process"}}, {_id:2856, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"concept", truncate:"", description:"loneliness is the emotional state of Ekam's son, which he became conscious of through the divine intervention.", created_at:1779225388, source_id:"chunk-60c3c70200e066b81d62b44f1233373d<SEP>chunk-a00a616ea914a3f9cb6efa32114cd948", entity_id:"loneliness"}}, {_id:2857, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)<SEP>YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)<SEP>unknown_source", entity_type:"person", truncate:"", created_at:1779665593, description:"The son is the child of the father, who feels a sense of oneness with him.<SEP>The son is an 8-year-old child who inherited fears from the speaker and later secured a job.<SEP>The son is a person who has a chronic problem of bed wetting and changes his habits after a spiritual experience.", source_id:"chunk-515bf0b5cfe42238ac690c925c5cdba7<SEP>chunk-3a0add62a70895b5ac3db1f7977a8549<SEP>chunk-5318d0efb35dd682803e91090103f4f5", entity_id:"son"}}, {_id:2858, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Teenagers apply the practice to handle stress and emotional challenges in daily life.", created_at:1779183982, source_id:"chunk-5b0bc29474343c900abfcb530ac6bf39", entity_id:"Teenagers"}}, {_id:2859, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"UNKNOWN", truncate:"", description:"Deeksha is the correct term in the context of the spiritual platform, contrasting with the incorrect term \"de-addiction\".", created_at:1779225478, source_id:"chunk-674ee76b3bca8182248c9dd21be326b4", entity_id:"Context"}}, {_id:2860, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Indecision is the inability to make a clear or confident decision, often due to conflicting thoughts or emotions.", created_at:1779184018, source_id:"chunk-2cc93fe7ed8db16f45e89fcd38b3ac24<SEP>chunk-035b6c44730bb7cdf05bfef04ef27b03", entity_id:"Indecision"}}, {_id:2861, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Internal conflict refers to a state of psychological struggle or divided thoughts within oneself.", created_at:1779184018, source_id:"chunk-2cc93fe7ed8db16f45e89fcd38b3ac24<SEP>chunk-3bc441c03c9cd5688b0f20314b1b1b3b", entity_id:"Internal Conflict"}}, {_id:2862, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Being in a suering state reduces the energy available to enjoy relationships, wealth, leisure, or success.", created_at:1779184075, source_id:"chunk-2cc93fe7ed8db16f45e89fcd38b3ac24", entity_id:"Energy for Relationships, Wealth, Leisure, Success"}}, {_id:2863, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Akbar was a historical emperor known for intellectual debates and challenges with his ministers.", created_at:1779184128, source_id:"chunk-813e5d6774fbe0673f530d4b67ec6629", entity_id:"Mughal Emperor Akbar"}}, {_id:2864, properties:{file_path:"unknown_source", entity_type:"organization", truncate:"", description:"Maureen's organization where she mentors entry-level employees.", created_at:1779184130, source_id:"chunk-246826c01e25761bf87cb37c0f82bbb8", entity_id:"Her Organization"}}, {_id:2865, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Commentary is a habit that divides experiences into \"should be\" and \"should not be\", leading to comparison and inner war.", created_at:1779184130, source_id:"chunk-246826c01e25761bf87cb37c0f82bbb8", entity_id:"Commentary"}}, {_id:2866, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Individuals often deflect self-obsession by blaming external factors for their unhappiness.", created_at:1779184161, source_id:"chunk-813e5d6774fbe0673f530d4b67ec6629", entity_id:"External Blame"}}, {_id:2867, properties:{file_path:"unknown_source", entity_type:"content", truncate:"", description:"Complex mathematical formulas and solutions revealed to Ramanujan through universal intelligence, later used to understand black holes.", created_at:1779184192, source_id:"chunk-8946651a237a4492067703c00a7fa226", entity_id:"Mathematical Formulas and Solutions"}}, {_id:2868, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Lack of enjoyment due to internal discord.", created_at:1779184194, source_id:"chunk-035b6c44730bb7cdf05bfef04ef27b03", entity_id:"Leisure"}}, {_id:2869, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A children's game symbolizing avoidance of responsibility in decision-making.", created_at:1779184194, source_id:"chunk-035b6c44730bb7cdf05bfef04ef27b03", entity_id:"Tag"}}, {_id:2870, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"concept", truncate:"", created_at:1779225892, description:"de-addiction is mentioned as a term retained per content rules, though not explicitly defined in the text.<SEP>de-addiction is a term present in the text, noted as potentially misplaced or inconsistent with the spiritual context.<SEP>de-addiction is a clinical term that might be a transcription error for the spiritual term Deeksha.<SEP>de-addiction is a term present in the text that does not align with the spiritual context and appears to be an incorrect or jarring inclusion.<SEP>de-addiction is a term explicitly distinguished from transcription errors, retained as-is per correction guidelines.", source_id:"chunk-fe2346fa14faa0c7de81fae68776a0fd<SEP>chunk-8563cc552e34b2ab4c93b1a1ee66f406<SEP>chunk-c1ab541b2cf5308d3b299d7516e3021f<SEP>chunk-437aa718018411e1f3f26388805d3883<SEP>chunk-fd29211eaa388c14b9d3c59363eea8da", entity_id:"de-addiction"}}] AS row
