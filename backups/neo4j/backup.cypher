UNWIND [{start: {_id:3953}, end: {_id:7487}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"error analysis,linguistic focus", weight:1.0, description:"The video's text is checked for misheard words that could lead to errors.", created_at:1779666359, source_id:"chunk-db7d5a106bdc58ffca9bc17f8723f7e5"}}, {start: {_id:7486}, end: {_id:7487}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"error analysis,terminology", weight:1.0, description:"Domain-specific terms", created_at:1779666359, source_id:"chunk-db7d5a106bdc58ffca9bc17f8723f7e5"}}, {start: {_id:7491}, end: {_id:7493}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"class/religious conflict,social hostility", weight:1.0, description:"Hostility between different social classes and religions stems from perceived threats from differences.", created_at:1779666379, source_id:"chunk-df19535ba38680d9457682cc02135690"}}, {start: {_id:7474}, end: {_id:7494}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"organizational behavior,stress impact", weight:1.0, description:"Competitive organizations exhibit increased social alienation under stress as per scientific findings.", created_at:1779666379, source_id:"chunk-df19535ba38680d9457682cc02135690"}}, {start: {_id:7489}, end: {_id:7490}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"age hierarchy,familial alienation", weight:1.0, description:"Age-based alienation occurs within sibling relationships due to developmental disparities.", created_at:1779666379, source_id:"chunk-df19535ba38680d9457682cc02135690"}}, {start: {_id:7469}, end: {_id:7492}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"cognitive bias,threat perception", weight:1.0, description:"Primitive cognitive frameworks interpret differences as inherent threats requiring alienation.", created_at:1779666379, source_id:"chunk-df19535ba38680d9457682cc02135690"}}, {start: {_id:7495}, end: {_id:7497}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"collective behavior,societal anxiety", weight:1.0, description:"Both violence types emerge concurrently during periods of widespread anxiety and uncertainty.", created_at:1779666379, source_id:"chunk-df19535ba38680d9457682cc02135690"}}, {start: {_id:3698}, end: {_id:1812}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"evolutionary paradox,self-destructive behavior", weight:1.0, description:"Humans uniquely inflict harm on their own species based on superficial characteristics despite shared evolution.", created_at:1779666380, source_id:"chunk-df19535ba38680d9457682cc02135690"}}, {start: {_id:252}, end: {_id:7494}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"behavioral manifestation,competitive pressure", weight:1.0, description:"Highly competitive work environments foster social alienation practices.", created_at:1779666380, source_id:"chunk-df19535ba38680d9457682cc02135690"}}, {start: {_id:788}, end: {_id:7469}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"neurological response,threat processing", weight:1.0, description:"Stress activates brain mechanisms that prioritize threat responses to unfamiliar stimuli.", created_at:1779666380, source_id:"chunk-df19535ba38680d9457682cc02135690"}}, {start: {_id:3050}, end: {_id:7488}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"psychological basis,social behavior", weight:1.0, description:"Primitive minds are portrayed as the root cause of prejudice, framing differences as threats.", created_at:1779666397, source_id:"chunk-10bef6757e8808291f38e464343bf8be"}}, {start: {_id:7498}, end: {_id:123}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"internal contradiction,social critique", weight:1.0, description:"Humanity's shared unity contrasts with its self-inflicted divisions through discrimination and separation.", created_at:1779666431, source_id:"chunk-8ef9c50f626a2c5bf33ddd61c9795988"}}, {start: {_id:4435}, end: {_id:7504}, properties:{file_path:"unknown_source", keywords:"metaphor,relationship", truncate:"", weight:1.0, description:"Magic is used metaphorically in relation to the mountain to describe challenges.", created_at:1779666464, source_id:"chunk-c6481baa2ca6ec863ed7690cee69e3d0"}}, {start: {_id:2369}, end: {_id:7502}, properties:{file_path:"unknown_source", keywords:"learning,managing", truncate:"", weight:1.0, description:"Learning to free oneself from pressure involves practice and mindset shifts to manage its inevitability effectively.", created_at:1779666464, source_id:"chunk-9de34e6e869087957a9232040a7b6bbb"}}, {start: {_id:7501}, end: {_id:6512}, properties:{file_path:"unknown_source", keywords:"contradiction,struggle", truncate:"", weight:1.0, description:"The pursuit of perfection leads to the realization of imperfection and the struggle to reconcile ideals with reality.", created_at:1779666464, source_id:"chunk-9de34e6e869087957a9232040a7b6bbb"}}, {start: {_id:7500}, end: {_id:7499}, properties:{file_path:"unknown_source", keywords:"causing pressure,finding faults", truncate:"", weight:1.0, description:"Family and friends create pressure through constant criticism and expectations, perpetuating stress.", created_at:1779666464, source_id:"chunk-9de34e6e869087957a9232040a7b6bbb"}}, {start: {_id:2369}, end: {_id:7503}, properties:{file_path:"unknown_source", keywords:"endurance,inevitability", truncate:"", weight:1.0, description:"The struggle arises from the enduring presence of pressure and the challenge of reconciling its inevitability.", created_at:1779666464, source_id:"chunk-9de34e6e869087957a9232040a7b6bbb"}}, {start: {_id:1619}, end: {_id:7499}, properties:{file_path:"unknown_source", keywords:"platform purpose,spiritual guidance", truncate:"", weight:1.0, description:"Mukthi Guru serves as the platform for correcting the text on stress and pressure.", created_at:1779666464, source_id:"chunk-c6481baa2ca6ec863ed7690cee69e3d0"}}, {start: {_id:739}, end: {_id:7499}, properties:{file_path:"unknown_source", keywords:"internal conflict,relationship", truncate:"", weight:1.0, description:"Stress and pressure are linked to family dynamics, where family members contribute to the pressure.", created_at:1779666464, source_id:"chunk-c6481baa2ca6ec863ed7690cee69e3d0"}}, {start: {_id:860}, end: {_id:2369}, properties:{file_path:"unknown_source", keywords:"external sources,inevitability", truncate:"", weight:1.0, description:"Friends contribute to pressure through their tendency to judge and highlight shortcomings.`", created_at:1779666464, source_id:"chunk-ae2f2a9e144a0416a2b1367a6eab9be2"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
UNWIND [{start: {_id:7505}, end: {_id:6850}, properties:{file_path:"unknown_source", keywords:"methodology,practice", truncate:"", weight:1.0, description:"The system involves repetitive practice (like climbing a mountain) to develop mastery over pressure.`", created_at:1779666464, source_id:"chunk-ae2f2a9e144a0416a2b1367a6eab9be2"}}, {start: {_id:2369}, end: {_id:4327}, properties:{file_path:"unknown_source", keywords:"acceptance,management", truncate:"", weight:1.0, description:"The teachings advocate accepting pressure as inevitable and learning to master it through practice.`", created_at:1779666464, source_id:"chunk-ae2f2a9e144a0416a2b1367a6eab9be2"}}, {start: {_id:4435}, end: {_id:7499}, properties:{file_path:"unknown_source", keywords:"relationship,rhetorical device", truncate:"", weight:1.0, description:"Magic is used as a rhetorical device to highlight the repetitive and abstract nature of the struggle.", created_at:1779666464, source_id:"chunk-c6481baa2ca6ec863ed7690cee69e3d0"}}, {start: {_id:7505}, end: {_id:4327}, properties:{file_path:"unknown_source", keywords:"application,metaphor", truncate:"", weight:2.0, description:"The mountain metaphor illustrates the teachings' emphasis on persistence and gradual mastery.` The keyword `application` is a bit generic. A better keyword might be `metaphor` or `illustration`. The description is okay.<SEP>The mountain metaphor illustrates the teachings' emphasis on persistence and gradual mastery.`", created_at:1779666464, source_id:"chunk-ae2f2a9e144a0416a2b1367a6eab9be2"}}, {start: {_id:3903}, end: {_id:2369}, properties:{file_path:"unknown_source", keywords:"escalation,paradox", truncate:"", weight:1.0, description:"Achieving goals paradoxically intensifies pressure rather than alleviating it.`", created_at:1779666464, source_id:"chunk-ae2f2a9e144a0416a2b1367a6eab9be2"}}, {start: {_id:6512}, end: {_id:7499}, properties:{file_path:"unknown_source", keywords:"relationship,struggle", truncate:"", weight:1.0, description:"Perfection is portrayed as a struggle against the pressure of expectations.", created_at:1779666464, source_id:"chunk-c6481baa2ca6ec863ed7690cee69e3d0"}}, {start: {_id:739}, end: {_id:2369}, properties:{file_path:"unknown_source", keywords:"external sources,inevitability", truncate:"", weight:2.0, description:"Pressure is perpetually present due to family members finding faults and offering constant criticism.` This is a good relationship.<SEP>Pressure is perpetually present due to family members finding faults and offering constant criticism.`", created_at:1779666464, source_id:"chunk-ae2f2a9e144a0416a2b1367a6eab9be2"}}, {start: {_id:6512}, end: {_id:2369}, properties:{file_path:"unknown_source", keywords:"imperfection,paradox", truncate:"", weight:1.0, description:"The pursuit of perfection creates a cycle of pressure and perceived imperfection.`", created_at:1779666465, source_id:"chunk-ae2f2a9e144a0416a2b1367a6eab9be2"}}, {start: {_id:7498}, end: {_id:7506}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"compound subject,grammatical analysis,grammatical error,grammatical rule,linguistic structure,pluralization", weight:3.0, created_at:1779667170, description:"The compound subject \"Discrimination and separation\" requires plural verb agreement (\"are\") per grammatical rules.<SEP>Discrimination and separation as a compound subject requires plural verb agreement (\"are\") rather than singular (\"is\"), though colloquial usage sometimes employs singular verb forms.<SEP>The compound subject \"Discrimination and separation\" incorrectly uses singular verb \"is\" instead of plural \"are.\"", source_id:"chunk-82910be7ab066a3e5e12d9a354ef4d9a<SEP>chunk-2668d66263a2b6505795cf0f77b429d1<SEP>chunk-8bd898ca539c78d8b6ef24c1d5246fd3"}}, {start: {_id:5223}, end: {_id:7508}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"grammatical standards,language usage", weight:1.0, description:"Formal correction aims to replace colloquial phrasing (\"is\") with grammatically accurate language (\"are\").", created_at:1779666515, source_id:"chunk-82910be7ab066a3e5e12d9a354ef4d9a"}}, {start: {_id:4782}, end: {_id:7498}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"grammatical structure,linguistic analysis", weight:1.0, description:"The phrase exemplifies a compound subject requiring plural verb agreement (\"are\") for grammatical correctness.", created_at:1779666515, source_id:"chunk-82910be7ab066a3e5e12d9a354ef4d9a"}}, {start: {_id:5223}, end: {_id:4782}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"grammatical accuracy,language usage", weight:1.0, description:"The colloquial use of \"is\" instead of \"are\" conflicts with standard grammar rules for compound subjects.", created_at:1779666515, source_id:"chunk-82910be7ab066a3e5e12d9a354ef4d9a"}}, {start: {_id:7507}, end: {_id:348}, properties:{file_path:"YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"content analysis,linguistic example", weight:1.0, description:"The video presents the phrase \"how you show it\" as a key example for linguistic discussion.", created_at:1779666553, source_id:"chunk-82910be7ab066a3e5e12d9a354ef4d9a"}}, {start: {_id:2369}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Qr_pw4E-REk)", truncate:"", keywords:"content discussion,psychological concept", weight:1.0, description:"The video addresses pressure as an inescapable element of life.", created_at:1779666630, source_id:"chunk-00da1afa0adf0cfcf3ae2d5ef072e1fa"}}, {start: {_id:3300}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Qr_pw4E-REk)", keywords:"content creation,subject", truncate:"", weight:1.0, description:"The teacher is the subject of the YouTube video.", created_at:1779666687, source_id:"chunk-2993029c625df32f843cfee8124d0621"}}, {start: {_id:7499}, end: {_id:3300}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Qr_pw4E-REk)", keywords:"analysis,discussion", truncate:"", weight:1.0, description:"The teacher discusses the inevitability of stress and pressure, mentioning family as a source.", created_at:1779666687, source_id:"chunk-2993029c625df32f843cfee8124d0621"}}, {start: {_id:7505}, end: {_id:3300}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Qr_pw4E-REk)", truncate:"", keywords:"metaphor,teaching", weight:1.0, description:"The metaphor is used to explain overcoming challenges in teaching.", created_at:1779666688, source_id:"chunk-2993029c625df32f843cfee8124d0621"}}, {start: {_id:3300}, end: {_id:7509}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Qr_pw4E-REk)", truncate:"", keywords:"correction,teaching philosophy", weight:1.0, description:"The teacher corrects a transcription error and explains passing on knowledge.", created_at:1779666688, source_id:"chunk-2993029c625df32f843cfee8124d0621"}}, {start: {_id:7512}, end: {_id:7510}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Qr_pw4E-REk)", truncate:"", keywords:"metaphorical instruction,progressive learning", weight:1.0, description:"The mountain climbing metaphor is used in the teaching process to illustrate overcoming challenges through repetition.", created_at:1779666710, source_id:"chunk-9e5acd479fd09231c065ea87c13da654"}}, {start: {_id:7511}, end: {_id:7514}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Qr_pw4E-REk)", truncate:"", keywords:"mindset,pressure management", weight:1.0, description:"Top performers utilize the pressure management system to handle stress and maintain a unique mindset for success.", created_at:1779666710, source_id:"chunk-9e5acd479fd09231c065ea87c13da654"}}] AS row
