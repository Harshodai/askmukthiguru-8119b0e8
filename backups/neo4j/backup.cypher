UNWIND [{start: {_id:1326}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"philosophical concepts,textual focus", truncate:"", weight:1.0, description:"The document discusses Kama as a quest for love influenced by one?s state of being.", created_at:1779143792, source_id:"chunk-2cfb508b00ca21845f924f5069b94f9b"}}, {start: {_id:1205}, end: {_id:1329}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"consequences,impact", truncate:"", weight:1.0, description:"In the Nobody State, actions have wide-reaching effects on the web of life, though often negative or burdensome.", created_at:1779143792, source_id:"chunk-2cfb508b00ca21845f924f5069b94f9b"}}, {start: {_id:1324}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"philosophical concepts,textual focus", truncate:"", weight:1.0, description:"The document contrasts Mukti?s expression in the Nobody State and evolves into knowledge for genuine liberation in the Beautiful State.", created_at:1779143792, source_id:"chunk-2cfb508b00ca21845f924f5069b94f9b"}}, {start: {_id:1337}, end: {_id:1336}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conflict,escape", truncate:"", weight:1.0, description:"Self-Image leads to the escape from real-life challenges, resulting in conflict and despair.", created_at:1779143822, source_id:"chunk-c300bba2ee34914195fc13be0187277e"}}, {start: {_id:1331}, end: {_id:1332}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"arbitration,decision", truncate:"", weight:1.0, description:"The Elders arbitrated the dispute over the swan, deciding to give it to the Buddha due to his role in healing it.", created_at:1779143822, source_id:"chunk-c300bba2ee34914195fc13be0187277e"}}, {start: {_id:1335}, end: {_id:1333}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"conflict,jealousy,rivalry", truncate:"", weight:3.0, description:"The incident over the swan led to a conflict between Devadatta and the Buddha, illustrating their rivalry and differing spiritual paths.<SEP>Devadatta?s rivalry with the Buddha...` -> The name is `Devadatta`. The target is `Buddha`. The keywords are `jealousy, conflict`. The description is<SEP>Devadatta?s rivalry with the Buddha stems from the Nobody State, leading to his downfall.` - Correct.", created_at:1779187668, source_id:"chunk-c300bba2ee34914195fc13be0187277e<SEP>chunk-be5de8ed1db1e01f9ee5a260fb8d11ce"}}, {start: {_id:1205}, end: {_id:380}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"example,illustration", truncate:"", weight:1.0, description:"The story of the swan incident illustrates the beginning of the Nobody State in Devadatta, characterized by ambitious accumulation of knowledge and spiritual skills.", created_at:1779143822, source_id:"chunk-c300bba2ee34914195fc13be0187277e"}}, {start: {_id:1333}, end: {_id:1332}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"dispute,ownership claim", truncate:"", weight:1.0, description:"Devadatta claimed ownership of the swan after shooting it, leading to a dispute with the Buddha and the Elders.", created_at:1779143822, source_id:"chunk-c300bba2ee34914195fc13be0187277e"}}, {start: {_id:1334}, end: {_id:1342}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"ambition,pursuit,skills", truncate:"", weight:9.0, description:"The spiritual path from a state of spiritual seeking is driven by ambition, leading to the accumulation of knowledge and skills for display.<SEP>Spiritual seeking is a pursuit of skills and knowledge, which is part of the spiritual path.<SEP>The spiritual path is driven by the pursuit of ambition and skills.<SEP>The spiritual path is driven by ambition and the pursuit of skills.<SEP>The spiritual path involves the pursuit of skills and knowledge.", created_at:1779143822, source_id:"chunk-c300bba2ee34914195fc13be0187277e"}}, {start: {_id:1336}, end: {_id:1338}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"identity,skill", truncate:"", weight:1.0, description:"Speech is a skill that, when acknowledged, contributes to Devadatta's identity and self-image.", created_at:1779143822, source_id:"chunk-c300bba2ee34914195fc13be0187277e"}}, {start: {_id:1337}, end: {_id:1339}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conflict,state", truncate:"", weight:1.0, description:"Isolation is a state of despair that often results from conflict and spiritual ambition.", created_at:1779143822, source_id:"chunk-c300bba2ee34914195fc13be0187277e"}}, {start: {_id:691}, end: {_id:1334}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"ambition,conflict", truncate:"", weight:2.0, description:"Conflict arises from the spiritual path when ambition and self-image lead to isolation and conflict.<SEP>The spiritual path, when driven by ambition, can lead to conflict.", created_at:1779143822, source_id:"chunk-c300bba2ee34914195fc13be0187277e"}}, {start: {_id:1335}, end: {_id:1332}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"healing,medical care", truncate:"", weight:1.0, description:"The Buddha provided medical care to the swan, tending to its wounds and nursing it back to health.", created_at:1779143822, source_id:"chunk-c300bba2ee34914195fc13be0187277e"}}, {start: {_id:1343}, end: {_id:1336}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"escape,identity", truncate:"", weight:1.0, description:"Otherworldliness is a form of self-image that involves escaping real-life challenges.", created_at:1779143822, source_id:"chunk-c300bba2ee34914195fc13be0187277e"}}, {start: {_id:1333}, end: {_id:1205}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"motivation,spiritual state", truncate:"", weight:1.0, description:"Devadatta's actions, such as claiming the swan, exemplify the spiritual state and motivation of the Nobody State, which involves accumulating skills for display.", created_at:1779143822, source_id:"chunk-c300bba2ee34914195fc13be0187277e"}}, {start: {_id:691}, end: {_id:1340}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conflict,path", truncate:"", weight:1.0, description:"Wandering is a path of conflict, isolation, and despair, often associated with the Nobody State.", created_at:1779143822, source_id:"chunk-c300bba2ee34914195fc13be0187277e"}}, {start: {_id:1334}, end: {_id:1344}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"ambition,conflict,isolation,pursuit,state", truncate:"", weight:6.0, description:"The spiritual state is characterized by ambition and the accumulation of skills.<SEP>The spiritual path leads to a spiritual state, such as the Nobody State.<SEP>The spiritual state can lead to conflict and isolation.<SEP>The spiritual state can lead to isolation and despair.", created_at:1779143822, source_id:"chunk-c300bba2ee34914195fc13be0187277e"}}, {start: {_id:691}, end: {_id:1341}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"doubt,questioning", truncate:"", weight:1.0, description:"The Little Voice represents doubt and questioning, which can lead to conflict and despair.", created_at:1779143822, source_id:"chunk-c300bba2ee34914195fc13be0187277e"}}, {start: {_id:1336}, end: {_id:1334}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"ambition,escape", truncate:"", weight:1.0, description:"Self-image influences the spiritual path by providing escape from challenges and fostering ambition.", created_at:1779143822, source_id:"chunk-c300bba2ee34914195fc13be0187277e"}}, {start: {_id:691}, end: {_id:1342}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"ambition,pursuit", truncate:"", weight:1.0, description:"Spiritual seeking, when driven by ambition, can lead to conflict and despair.", created_at:1779143822, source_id:"chunk-c300bba2ee34914195fc13be0187277e"}}] AS row
