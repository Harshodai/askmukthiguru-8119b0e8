UNWIND [{start: {_id:7210}, end: {_id:7206}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"consciousness states,transformation", weight:1.0, description:"The video discusses \"extraordinary consciousness\" as a transformative state.", created_at:1779661519, source_id:"chunk-3589746193d218d51479dd14e70466b0"}}, {start: {_id:7200}, end: {_id:982}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"behavioral change,elimination", weight:1.0, description:"Mystical experiences lead to the abandonment of destructive addictions through spiritual transformation.", created_at:1779661519, source_id:"chunk-2fad0fbe65ec4abc3eb5db49059e7a50"}}, {start: {_id:7206}, end: {_id:1401}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", keywords:"contrast,transcendence", truncate:"", weight:1.0, description:"\"Rise above mediocrity\" contrasts with uninspired existence.", created_at:1779661519, source_id:"chunk-3589746193d218d51479dd14e70466b0"}}, {start: {_id:7201}, end: {_id:982}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"spiritual shift,transformation", weight:1.0, description:"Mystical experiences result in seekers becoming faith-driven and spiritually aligned.", created_at:1779661519, source_id:"chunk-2fad0fbe65ec4abc3eb5db49059e7a50"}}, {start: {_id:7191}, end: {_id:7206}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"mystical framework,organizational symbolism", weight:1.0, description:"\"Aecom\" is framed as a mystical powerhouse enabling consciousness expansion.", created_at:1779661519, source_id:"chunk-3589746193d218d51479dd14e70466b0"}}, {start: {_id:7212}, end: {_id:3971}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"activation description,grammatical structure", weight:1.0, description:"The neurons in the heart are described as getting activated in a massive manner.", created_at:1779661654, source_id:"chunk-c0e4fdfc7ee5eb3e5b9c6befee06c664"}}, {start: {_id:7210}, end: {_id:4464}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", keywords:"association,naming", truncate:"", weight:1.0, description:"Prieta G is associated with the concept of extraordinary consciousness.", created_at:1779661654, source_id:"chunk-6a8eb45ded9794e4df68146dcf6df106"}}, {start: {_id:7215}, end: {_id:7216}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"grammatical correction,punctuation,punctuation fix,readability improvement", weight:3.0, description:"The original punctuation in \"Prieta G, and I believe\" is corrected to \"Prieta G and I believe\" for better readability.<SEP>The corrected phrase \"Prieta G and I believe\" is derived from the original \"Prieta G, and I believe\" by removing the comma.<SEP>The original phrase \"Prieta G, and I believe\" is corrected to \"Prieta G and I believe\" by removing the comma.", created_at:1779661823, source_id:"chunk-c0e4fdfc7ee5eb3e5b9c6befee06c664<SEP>chunk-2513ead52ad2bbf56e47a3233d1a61cb"}}, {start: {_id:7210}, end: {_id:706}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"anatomical relation,location", weight:1.0, description:"The concept of extraordinary consciousness is related to the third eye, which is anatomically located in the middle of the eyebrows.", created_at:1779661655, source_id:"chunk-6a8eb45ded9794e4df68146dcf6df106"}}, {start: {_id:7212}, end: {_id:7213}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"adverb usage,grammar correction", weight:1.0, description:"The phrase \"in a massive manner\" is corrected to \"massively\" for grammatical accuracy and natural expression.", created_at:1779661655, source_id:"chunk-c0e4fdfc7ee5eb3e5b9c6befee06c664"}}, {start: {_id:7210}, end: {_id:7214}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", keywords:"context,discussion", truncate:"", weight:2.0, description:"The transformational experience is a context in which extraordinary consciousness is discussed.<SEP>Extraordinary consciousness is discussed in the context of a transformational experience.", created_at:1779661655, source_id:"chunk-6a8eb45ded9794e4df68146dcf6df106"}}, {start: {_id:3971}, end: {_id:706}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"activation,anatomical relation", weight:1.0, description:"The third eye is related to the activation of neurons in the heart during a transformational experience.", created_at:1779661655, source_id:"chunk-6a8eb45ded9794e4df68146dcf6df106"}}, {start: {_id:7212}, end: {_id:7214}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"grammatical correction,word choice", weight:1.0, description:"The term \"massive manner\" is corrected to \"massively\" for better grammatical flow in the context of a transformational experience.", created_at:1779661657, source_id:"chunk-6a8eb45ded9794e4df68146dcf6df106"}}, {start: {_id:7220}, end: {_id:7213}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"adverb,form", weight:1.0, description:"The correction changes the phrase to the proper adverbial form \"massively\".", created_at:1779661677, source_id:"chunk-bb98fef15e9b88e4048dd1b159bc2a6c"}}, {start: {_id:7219}, end: {_id:7217}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", keywords:"anatomical,clarity", truncate:"", weight:1.0, description:"The correction specifies the exact location to avoid ambiguity in the anatomical reference.", created_at:1779661677, source_id:"chunk-bb98fef15e9b88e4048dd1b159bc2a6c"}}, {start: {_id:4464}, end: {_id:7215}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", keywords:"punctuation,readability", truncate:"", weight:1.0, description:"The correction removes a comma to improve readability and flow in the phrase.", created_at:1779661677, source_id:"chunk-bb98fef15e9b88e4048dd1b159bc2a6c"}}, {start: {_id:7218}, end: {_id:3730}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"grammar", weight:1.0, description:"The correction changes \"every one\" to \"everyone\" to fix a grammatical error.", created_at:1779661677, source_id:"chunk-bb98fef15e9b88e4048dd1b159bc2a6c"}}, {start: {_id:99}, end: {_id:4464}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"collaboration,shared beliefs", weight:1.0, description:"Prieta G and the user believe in a journey beyond mediocrity through transcendental experiences.`", created_at:1779661732, source_id:"chunk-71c647fd13898f185a71091bf9fbd510"}}, {start: {_id:982}, end: {_id:4464}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"belief system,co-authorship", weight:1.0, description:"Prieta G co-authored the video and believes in the power of mystical experiences.`", created_at:1779661732, source_id:"chunk-71c647fd13898f185a71091bf9fbd510"}}, {start: {_id:7200}, end: {_id:7193}, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", truncate:"", keywords:"behavioral change,transcendence", weight:1.0, description:"Transformation experiences lead to relinquishing destructive addictions and becoming faith-driven.` - OK", created_at:1779661752, source_id:"chunk-9f245e3153d92a2c38134afd812338bf"}}] AS row
