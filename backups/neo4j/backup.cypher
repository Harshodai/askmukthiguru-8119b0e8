UNWIND [{_id:3807, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)", entity_type:"concept", truncate:"", created_at:1779241552, description:"A phrase interpreted as \"Asn?ta Apam Ayatanam\" (water was contained) in the context of a spiritual or mantra-related discussion.<SEP>A phrase from the mantra, possibly a mishearing of \"Asn?ta Apam Ayatanam\".<SEP>Asnerva Apam Ayatanam represents a structured knowledge system or philosophical framework within Vedic traditions.", source_id:"chunk-237725492b688a0663257df076c15f50<SEP>chunk-87dc7b0b39d46eecd77547e39d627b07<SEP>chunk-4cdf810548d4dae5601c27d4b38fbda7", entity_id:"Asnerva Apam Ayatanam"}}, {_id:3808, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)", entity_type:"UNKNOWN", truncate:"", description:"\"Chandra\" (moon) is a recognizable component of the phrase \"Chandra Mabha Apam Kushpam\".", created_at:1779241376, source_id:"chunk-237725492b688a0663257df076c15f50", entity_id:"Chandra"}}, {_id:3809, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)", entity_type:"UNKNOWN", truncate:"", description:"\"Apam\" (water) is a recognizable component of the phrase \"Chandra Mabha Apam Kushpam\".", created_at:1779241376, source_id:"chunk-237725492b688a0663257df076c15f50", entity_id:"Apam"}}, {_id:3810, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)", entity_type:"concept", truncate:"", description:"Asn?ta is a term derived from the Sanskrit root 'as' (to be), interpreted as a past tense form in the context of \"Apam Ayatanam\".", created_at:1779241398, source_id:"chunk-51d24772aea221a9529d1f96e1f4ddd4", entity_id:"Asn?ta"}}, {_id:3811, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)", entity_type:"concept", truncate:"", description:"Asnerva is a term possibly misheard or misspelled, considered a variant of \"Asn?ta\" in the given context.<SEP>Misheard term in the original text, later corrected to \"Asn?ta.\"", created_at:1779241615, source_id:"chunk-51d24772aea221a9529d1f96e1f4ddd4<SEP>chunk-a3a01134e5fd712137a4b2e01dd9cd28", entity_id:"Asnerva"}}, {_id:3812, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)", entity_type:"concept", truncate:"", created_at:1779241615, description:"Ahoga Asnerayatanam is a term appearing in the list with unclear grammatical structure.<SEP>Ahoga Asnerayatanam symbolizes the dissolution of limitations through immersive awareness.<SEP>Misheard phrase corrected to \"Asn?ta Ayatanam\" in the analysis.", source_id:"chunk-51d24772aea221a9529d1f96e1f4ddd4<SEP>chunk-4cdf810548d4dae5601c27d4b38fbda7<SEP>chunk-a3a01134e5fd712137a4b2e01dd9cd28", entity_id:"Ahoga Asnerayatanam"}}, {_id:3814, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)", entity_type:"concept", truncate:"", description:"Corrected term from \"Asnerva Apam Ayatanam\" and \"Ahoga Asnerayatanam\", following the \"Name + Bhavati\" structural pattern.<SEP>Corrected Sanskrit phrase derived from the misheard \"Asnerva Apam Ayatanam.\"", created_at:1779241615, source_id:"chunk-a633167866ad146cb5cfd5c5cf98f9a0<SEP>chunk-a3a01134e5fd712137a4b2e01dd9cd28", entity_id:"Asn?ta Ayatanam"}}, {_id:3815, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)", entity_type:"UNKNOWN", truncate:"", description:"Mabha was corrected to Maha to form a valid mantra.", created_at:1779241485, source_id:"chunk-0cdc1c750ba44fc214a277ad3f32e7cc", entity_id:"Mabha"}}, {_id:3816, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)", entity_type:"UNKNOWN", truncate:"", description:"Mabha was corrected to Maha to form a valid mantra.", created_at:1779241485, source_id:"chunk-0cdc1c750ba44fc214a277ad3f32e7cc", entity_id:"Maha"}}, {_id:3817, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)", entity_type:"concept", truncate:"", description:"A corrected version of \"Asnerva Apam Ayatanam\", interpreted as \"was\" in the context of the mantra.", created_at:1779241508, source_id:"chunk-87dc7b0b39d46eecd77547e39d627b07", entity_id:"Asn?ta Apam Ayatanam"}}, {_id:3819, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)", entity_type:"concept", truncate:"", description:"Misheard phrase corrected to \"Asn?ta Ayatanam.\"", created_at:1779241615, source_id:"chunk-a3a01134e5fd712137a4b2e01dd9cd28", entity_id:"Asnerayatanam"}}, {_id:3820, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Rigid views are inflexible perceptions that reject alternative perspectives, fostering intolerance.", created_at:1779241777, source_id:"chunk-4d246f0bbbd6194a476f340fc1b4843e<SEP>chunk-9ce1c80b4cf41412d36baabed73cd0a7", entity_id:"Rigid Views"}}, {_id:3821, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"concept", truncate:"", created_at:1779242468, description:"Egoic supremacy refers to the prioritization of one's own desires and perceptions over relational harmony, leading to conflict.<SEP>Egoic supremacy refers to a battle for dominance driven by rigid beliefs and the imposition of one's opinions.<SEP>Egoic supremacy refers to the prioritization of personal desires over relational harmony, creating conflict.", source_id:"chunk-4d246f0bbbd6194a476f340fc1b4843e<SEP>chunk-082ee41f700ea9a8a29b83bfbf36abec<SEP>chunk-8b1cb9338748404cabaa24ac4be68f56", entity_id:"Egoic Supremacy"}}, {_id:3822, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"concept", truncate:"", description:"Kupastha manduka (frog in a well) symbolizes limited perspective and rejection of broader truths.<SEP>Kupastha manduka is a metaphor for narrow-mindedness, symbolizing the limitations of rigid thinking.", created_at:1779242306, source_id:"chunk-4d246f0bbbd6194a476f340fc1b4843e<SEP>chunk-082ee41f700ea9a8a29b83bfbf36abec", entity_id:"Kupastha Manduka"}}, {_id:3823, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"method", truncate:"", description:"Reflection exercise is a guided practice to dissolve egoic barriers and foster mutual understanding.<SEP>Guided reflection exercise involving inviting a partner, sitting together, closing eyes, and performing a breathing technique.", created_at:1779242328, source_id:"chunk-4d246f0bbbd6194a476f340fc1b4843e<SEP>chunk-78de7fe55b577c559d0a376641b24b1d", entity_id:"Reflection Exercise"}}, {_id:3824, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"UNKNOWN", truncate:"", description:"Multiple \"ekam\" variations need standardization to capitalized \"Ekam\".", created_at:1779241916, source_id:"chunk-821c3bab77b0da45d408ce80c80c9144", entity_id:"Ekam variations"}}, {_id:3825, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"concept", truncate:"", created_at:1779242116, description:"kupastha manduka (frog in a well) is a metaphor representing limited perspective or narrow worldview.<SEP>kupastha manduka refers to a frog that was born and raised in a well, derived from the Sanskrit terms \"kupastha\" (frog) and \"manduka\" (frog).<SEP>Sanskrit term meaning \"frog born and raised in a well,\" analyzed for linguistic accuracy and cultural interpretation.` - This is correct.", source_id:"chunk-6dcca6a19001c05e809233dafe613e17<SEP>chunk-1fed5f5d5a60fdd3201f9ce6b7a60c39<SEP>chunk-38d459f7517c4d43d87f88ce27859776", entity_id:"kupastha manduka"}}, {_id:3826, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"creature", truncate:"", description:"frog symbolizes a being with restricted understanding, confined to its immediate environment.", created_at:1779241935, source_id:"chunk-6dcca6a19001c05e809233dafe613e17", entity_id:"frog"}}, {_id:3827, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"location", truncate:"", description:"well represents the confined space in which the frog lives, metaphorically signifying limited exposure to broader realities.", created_at:1779241935, source_id:"chunk-6dcca6a19001c05e809233dafe613e17", entity_id:"well"}}, {_id:3828, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"naturalobject", truncate:"", description:"lake signifies an alternative reality the frog dismisses as untruthful, reflecting limited understanding.", created_at:1779241935, source_id:"chunk-6dcca6a19001c05e809233dafe613e17", entity_id:"lake"}}] AS row
