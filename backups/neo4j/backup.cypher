d_at:1779664288, source_id:"chunk-5ad87d01b925f7db7d300ff617025fd6", entity_id:"Comma Errors"}}, {_id:7383, properties:{file_path:"YouTube Video: pPHQMD3w9-s (URL: https://www.youtube.com/watch?v=pPHQMD3w9-s)", entity_type:"content", truncate:"", description:"The sentence \"ves the people we know are falling sick\" is the text being discussed and corrected in the input.", created_at:1779664303, source_id:"chunk-f8f7438650b29d19ed411292230a7353", entity_id:"The Sentence"}}, {_id:7384, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A recollection of past events, particularly those involving love and sacrifice.", created_at:1779665479, source_id:"chunk-c93698531b3dac1e84db04c1babfa638", entity_id:"Memory"}}, {_id:7385, properties:{file_path:"unknown_source", entity_type:"method", truncate:"", description:"A method involving focused intention or spiritual practice to promote well-being and health.", created_at:1779665479, source_id:"chunk-c93698531b3dac1e84db04c1babfa638", entity_id:"Prayer/Meditation"}}, {_id:7386, properties:{file_path:"unknown_source<SEP>YouTube Video: Fbd7ln2i9dw (URL: https://www.youtube.com/watch?v=Fbd7ln2i9dw)", entity_type:"concept", truncate:"", description:"A physiological and emotional healing process triggered by emotional connection and empathy.<SEP>The healing response refers to the physiological or emotional improvement triggered by heartfelt connection.", created_at:1779665492, source_id:"chunk-c93698531b3dac1e84db04c1babfa638<SEP>chunk-2356c92f9a3ba0c0acd302b505ca62a8", entity_id:"Healing Response"}}, {_id:7387, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"States of physical, mental, and spiritual wellness, which can be promoted through prayer or meditation.", created_at:1779665479, source_id:"chunk-c93698531b3dac1e84db04c1babfa638", entity_id:"Health, Peace, Well-being"}}, {_id:7388, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"An act of giving up something for the benefit of another, associated with moments of love.", created_at:1779665479, source_id:"chunk-c93698531b3dac1e84db04c1babfa638", entity_id:"Sacrifice"}}, {_id:7389, properties:{file_path:"YouTube Video: Fbd7ln2i9dw (URL: https://www.youtube.com/watch?v=Fbd7ln2i9dw)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=4ytgjpow498)", entity_type:"person", truncate:"", description:"You are the person performing the suggested actions to honor your father on Father's Day.<SEP>The viewer or listener addressed in the guided meditation, instructed to focus on breath and relaxation.", created_at:1779734214, source_id:"chunk-2356c92f9a3ba0c0acd302b505ca62a8<SEP>chunk-5bf3950956a6b9404d15a3583f147386", entity_id:"You"}}, {_id:7390, properties:{file_path:"YouTube Video: Fbd7ln2i9dw (URL: https://www.youtube.com/watch?v=Fbd7ln2i9dw)", entity_type:"person", truncate:"", description:"Your dad is the recipient of the suggested Father's Day activities aimed at fostering connection and healing.", created_at:1779665492, source_id:"chunk-2356c92f9a3ba0c0acd302b505ca62a8", entity_id:"Your Dad"}}, {_id:7391, properties:{file_path:"YouTube Video: Fbd7ln2i9dw (URL: https://www.youtube.com/watch?v=Fbd7ln2i9dw)", entity_type:"method", truncate:"", description:"This method involves gentle physical touch and sharing memories of sacrifice or love to affirm your father's importance.", created_at:1779665492, source_id:"chunk-2356c92f9a3ba0c0acd302b505ca62a8", entity_id:"Two: Touch and Share Memories"}}, {_id:7392, properties:{file_path:"YouTube Video: Fbd7ln2i9dw (URL: https://www.youtube.com/watch?v=Fbd7ln2i9dw)", entity_type:"method", truncate:"", description:"This method involves making eye contact with your father to sense his emotional state and initiate a healing response.", created_at:1779665492, source_id:"chunk-2356c92f9a3ba0c0acd302b505ca62a8", entity_id:"One: Look into Your Dad's Eyes"}}] AS row
