UNWIND [{start: {_id:6497}, end: {_id:6494}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"existential void,success paradox", weight:1.0, description:"The young manager's story illustrates how crisis in purpose can affect even successful individuals, revealing an underlying void despite external achievements.", created_at:1779562101, source_id:"chunk-795d6a47694e346b9ff7bde9c51e23ec"}}, {start: {_id:6480}, end: {_id:6481}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"self-discovery,spiritual retreat", weight:1.0, description:"The manager attends a spiritual journey at Isha to address feelings of being lost and reconnect with his humanity.", created_at:1779562103, source_id:"chunk-fa94329119384e436889db983f1732d8"}}, {start: {_id:6481}, end: {_id:6500}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"bond,detachment,leadership,reconciliation", weight:2.0, description:"The manager initially feels his nurtured team no longer needs him, reflecting his emotional disconnection.<SEP>The manager ultimately chooses to prioritize his bond with the team over lingering emotional hurt.", created_at:1779562103, source_id:"chunk-fa94329119384e436889db983f1732d8"}}, {start: {_id:6499}, end: {_id:6481}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"self-awareness,transformation", truncate:"", weight:1.0, description:"The manager recognizes how emotional hurts made him reactive and chooses to release them for personal growth.", created_at:1779562103, source_id:"chunk-fa94329119384e436889db983f1732d8"}}, {start: {_id:6481}, end: {_id:1347}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"catalyst,realization", truncate:"", weight:1.0, description:"The spiritual journey forces the manager to confront his existential questions and redefine his priorities.", created_at:1779562104, source_id:"chunk-fa94329119384e436889db983f1732d8"}}, {start: {_id:1386}, end: {_id:6481}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"material possessions,self-reliance", weight:1.0, description:"The manager relies on his favorite car as part of his self-reliance and emotional detachment from people.", created_at:1779562104, source_id:"chunk-fa94329119384e436889db983f1732d8"}}, {start: {_id:6481}, end: {_id:3008}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"material possessions,self-reliance", weight:1.0, description:"The manager connects with a table, reflecting his preference for inanimate objects over human interaction.", created_at:1779562104, source_id:"chunk-fa94329119384e436889db983f1732d8"}}, {start: {_id:6481}, end: {_id:3010}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"emotional detachment,self-reliance", weight:1.0, description:"The manager prioritizes his personal skills and abilities, avoiding dependence on others.", created_at:1779562104, source_id:"chunk-fa94329119384e436889db983f1732d8"}}, {start: {_id:6503}, end: {_id:6501}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"bonding,resolution", truncate:"", weight:1.0, description:"the individual's emotional hurt is connected to their bond with the team, which plays a role in their journey toward healing and reconnection.", created_at:1779562156, source_id:"chunk-185920d43e0d12ff2d096215a58006e2"}}, {start: {_id:234}, end: {_id:50}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"experiencing,perception", truncate:"", weight:1.0, description:"The individual experiences synchronicities that impact their perception and creativity.", created_at:1779562156, source_id:"chunk-185920d43e0d12ff2d096215a58006e2"}}, {start: {_id:2707}, end: {_id:6501}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"affiliation,support", truncate:"", weight:1.0, description:"the team is part of the organization, which provides ongoing support and context for the individual's experiences.", created_at:1779562156, source_id:"chunk-185920d43e0d12ff2d096215a58006e2"}}, {start: {_id:6510}, end: {_id:1192}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"ideal application,practice challenge", weight:1.0, description:"Practicing honesty without a fearless state leads to exhaustion and disconnection from ideals.", created_at:1779562205, source_id:"chunk-c0dc5060d878117d8549ed7941c43cb2"}}, {start: {_id:6511}, end: {_id:6341}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"conflict,psychological barrier", weight:1.0, description:"Past hurts hinder the practice of unconditional love due to lingering emotional attachments.", created_at:1779562205, source_id:"chunk-c0dc5060d878117d8549ed7941c43cb2"}}, {start: {_id:32}, end: {_id:1099}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"existential inquiry,exploration focus", weight:1.0, description:"The four questions directly explore the concept of purpose and its implications.", created_at:1779562205, source_id:"chunk-c0dc5060d878117d8549ed7941c43cb2"}}, {start: {_id:252}, end: {_id:6513}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"leadership perspective,structural frameworks,system alignment,system design", weight:2.0, description:"Organizations are recognized as progressive systems requiring purposeful direction.<SEP>Organizations operate through progressive systems aimed at achieving collective goals.", created_at:1779562230, source_id:"chunk-c0dc5060d878117d8549ed7941c43cb2<SEP>chunk-6f53ead9b7c14c9d4c207b785760c5a8"}}, {start: {_id:6514}, end: {_id:252}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"leadership perspective,structural frameworks,system alignment,system design", weight:2.0, description:"Organizations are also associated with intelligent systems for effective problem-solving.<SEP>Organizations also rely on intelligent systems to enforce rules and maintain order.", created_at:1779562231, source_id:"chunk-c0dc5060d878117d8549ed7941c43cb2<SEP>chunk-6f53ead9b7c14c9d4c207b785760c5a8"}}, {start: {_id:309}, end: {_id:32}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"absence,consequence", truncate:"", weight:1.0, description:"Without purpose, passion diminishes, leading to loss of drive and emotional desolation.", created_at:1779562206, source_id:"chunk-e28a16af170670aaf61d68da07b71294"}}, {start: {_id:852}, end: {_id:6504}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"fear-driven achievement", truncate:"", weight:1.0, description:"Inner lack fuels fear of irrelevance, pushing achievements for recognition.", created_at:1779562206, source_id:"chunk-e28a16af170670aaf61d68da07b71294"}}, {start: {_id:299}, end: {_id:32}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"challenges,dissolution", truncate:"", weight:1.0, description:"Purpose absence causes love to dissolve under challenges, leaving emotional dryness.", created_at:1779562206, source_id:"chunk-e28a16af170670aaf61d68da07b71294"}}, {start: {_id:6506}, end: {_id:32}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"critique,ideals", weight:1.0, description:"Practicing ideals without purpose is critiqued as noble but impractical or insufficient.", created_at:1779562206, source_id:"chunk-e28a16af170670aaf61d68da07b71294"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
UNWIND [{start: {_id:6525}, end: {_id:6515}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"human factor,system undermining", weight:1.0, description:"An untransformed mindset can overpower even the most efficient external system, preventing it from achieving its vision.", created_at:1779562230, source_id:"chunk-6f53ead9b7c14c9d4c207b785760c5a8"}}, {start: {_id:6519}, end: {_id:6516}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"conventional approaches,purpose discovery", weight:1.0, description:"The second question contrasts with the first advice, which advocates aligning purpose with fascinations.", created_at:1779562230, source_id:"chunk-6f53ead9b7c14c9d4c207b785760c5a8"}}, {start: {_id:6518}, end: {_id:6524}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"choice process,non-rationality", weight:1.0, description:"The children's method exemplifies how future paths can be chosen through arbitrary or subconscious processes.", created_at:1779562230, source_id:"chunk-6f53ead9b7c14c9d4c207b785760c5a8"}}, {start: {_id:6517}, end: {_id:6516}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"conventional approaches,purpose discovery", weight:1.0, description:"The second question also contrasts with the second advice, which emphasizes leveraging innate strengths.", created_at:1779562231, source_id:"chunk-6f53ead9b7c14c9d4c207b785760c5a8"}}, {start: {_id:6513}, end: {_id:6515}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"human factor,system failure", weight:1.0, description:"An untransformed mindset can undermine even the most efficient external systems.", created_at:1779562231, source_id:"chunk-6f53ead9b7c14c9d4c207b785760c5a8"}}, {start: {_id:6523}, end: {_id:6520}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"content dissemination,philosophical discussion", weight:1.0, description:"The video presents concepts about true greatness and purpose discovery through connection.", created_at:1779562289, source_id:"chunk-df8fc1ec5d1cc48e4ba2ac7fc6630477"}}, {start: {_id:284}, end: {_id:6523}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"enlightenment,foundational principle", weight:1.0, description:"True greatness arises from an expanded state of connection rather than self-centered planning.", created_at:1779562289, source_id:"chunk-df8fc1ec5d1cc48e4ba2ac7fc6630477"}}, {start: {_id:472}, end: {_id:6520}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"historical reference,illustrative example", weight:1.0, description:"Gandhi is cited as an example of purpose discovered through connection.", created_at:1779562289, source_id:"chunk-df8fc1ec5d1cc48e4ba2ac7fc6630477"}}, {start: {_id:32}, end: {_id:2186}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"philosophical alignment,self-realization", weight:1.0, description:"Purpose transforms into Swadharma when perceived as inherently unreal and interconnected.", created_at:1779562289, source_id:"chunk-df8fc1ec5d1cc48e4ba2ac7fc6630477"}}, {start: {_id:6521}, end: {_id:6520}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"historical reference,illustrative example", weight:1.0, description:"Shivaji is cited as an example of purpose discovered through connection.", created_at:1779562289, source_id:"chunk-df8fc1ec5d1cc48e4ba2ac7fc6630477"}}, {start: {_id:6455}, end: {_id:6520}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"historical reference,illustrative example", weight:1.0, description:"Einstein is cited as an example of purpose discovered through connection.", created_at:1779562289, source_id:"chunk-df8fc1ec5d1cc48e4ba2ac7fc6630477"}}, {start: {_id:6522}, end: {_id:6520}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"historical reference,illustrative example", weight:1.0, description:"Picasso is cited as an example of purpose discovered through connection.", created_at:1779562289, source_id:"chunk-df8fc1ec5d1cc48e4ba2ac7fc6630477"}}, {start: {_id:6526}, end: {_id:6520}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"life philosophy,metaphor", truncate:"", weight:1.0, description:"The video uses the \"catcher in a game\" metaphor to explain embracing life's unpredictability in discovering purpose.", created_at:1779562289, source_id:"chunk-df8fc1ec5d1cc48e4ba2ac7fc6630477"}}, {start: {_id:284}, end: {_id:300}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"core component,reciprocal motivation", weight:1.0, description:"Gratitude operationalizes connection by inspiring reciprocal action toward others.", created_at:1779562317, source_id:"chunk-df8fc1ec5d1cc48e4ba2ac7fc6630477"}}, {start: {_id:533}, end: {_id:284}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"definition,human experience", weight:1.0, description:"Connection is defined as compassion, an awareness of shared human suffering and the drive to act.", created_at:1779562319, source_id:"chunk-ea7262ae497f1dc36bddbc40ddb97a59"}}, {start: {_id:284}, end: {_id:6527}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"aspect,component", weight:1.0, description:"Connection includes inclusivity, balancing self-care with others' well-being as part of its nature.", created_at:1779562319, source_id:"chunk-ea7262ae497f1dc36bddbc40ddb97a59"}}, {start: {_id:284}, end: {_id:5845}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"definition,human experience", weight:1.0, description:"Connection involves sensitivity, feeling others' emotions as one's own and responding with empathy.", created_at:1779562319, source_id:"chunk-ea7262ae497f1dc36bddbc40ddb97a59"}}, {start: {_id:6530}, end: {_id:6528}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"environmental observation,scientific intervention", weight:1.0, description:"Mr. Wongdu observes the melting of Himalayan glaciers and devises a solution using iron rods.", created_at:1779562355, source_id:"chunk-e0bf909f8e5d3cf013125e64d70b8365"}}, {start: {_id:6531}, end: {_id:6528}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"environmental engineering,glacier regeneration", weight:1.0, description:"Mr. Wongdu plants iron rods to create structures for ice accumulation and glacier formation.", created_at:1779562355, source_id:"chunk-e0bf909f8e5d3cf013125e64d70b8365"}}, {start: {_id:2232}, end: {_id:6528}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"environmental stewardship,love", weight:1.0, description:"Mr. Wongdu's actions stem from his love for Earth and desire to address its ecological crises.", created_at:1779562356, source_id:"chunk-e0bf909f8e5d3cf013125e64d70b8365"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
