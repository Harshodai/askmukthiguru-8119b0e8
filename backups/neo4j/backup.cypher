.youtube.com/watch?v=obK5uqYXOJU)", keywords:"action,sustainability", truncate:"", weight:1.0, description:"Intelligent action is emphasized as necessary to address decay and prolong life.", created_at:1779250630, source_id:"chunk-82b4b0dbb1bf7ada138b9c4293afb2ad"}}, {start: {_id:2232}, end: {_id:4039}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", truncate:"", keywords:"environmental sustainability,resource management", weight:1.0, description:"Mother Earth's health is intrinsically tied to oxygen supply stability.", created_at:1779250688, source_id:"chunk-337cc1942c0c467cad10296df37b0661"}}, {start: {_id:4040}, end: {_id:4008}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", truncate:"", keywords:"spiritual realization,transformative power", weight:1.0, description:"Understanding interconnectedness unlocks great power.", created_at:1779250688, source_id:"chunk-337cc1942c0c467cad10296df37b0661"}}, {start: {_id:4035}, end: {_id:2232}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", truncate:"", keywords:"ecological balance,natural systems", weight:1.0, description:"Forests are part of Earth's natural systems requiring preservation.", created_at:1779250688, source_id:"chunk-337cc1942c0c467cad10296df37b0661"}}, {start: {_id:4040}, end: {_id:4042}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", truncate:"", keywords:"cultural reference,responsibility", weight:1.0, description:"Movie buffs reference the responsibility associated with power.", created_at:1779250688, source_id:"chunk-337cc1942c0c467cad10296df37b0661"}}] AS row
