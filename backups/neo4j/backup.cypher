UNWIND [{start: {_id:157}, end: {_id:5496}, properties:{file_path:"YouTube Video: WOKBogNTmPI (URL: https://www.youtube.com/watch?v=WOKBogNTmPI)", truncate:"", keywords:"creates,dissolves", weight:1.0, description:"This consciousness dissolves challenges and creates success/abundance through awakened connection.", created_at:1779518233, source_id:"chunk-8b7b22cfd463021890139fccede91731"}}, {start: {_id:2201}, end: {_id:5483}, properties:{file_path:"YouTube Video: WOKBogNTmPI (URL: https://www.youtube.com/watch?v=WOKBogNTmPI)", truncate:"", keywords:"cellular communication,medical research", weight:1.0, description:"Dr. Rosedale attributes disease to poor cellular communication, linking it to broader health principles.", created_at:1779518234, source_id:"chunk-6988c802643ab5986cfc41940a6f6b44"}}, {start: {_id:5483}, end: {_id:5494}, properties:{file_path:"YouTube Video: WOKBogNTmPI (URL: https://www.youtube.com/watch?v=WOKBogNTmPI)", truncate:"", keywords:"disease origins,expert insights", weight:1.0, description:"Dr. Rosedale's work provides foundational insights into disease mechanisms within medical science.", created_at:1779518234, source_id:"chunk-6988c802643ab5986cfc41940a6f6b44"}}, {start: {_id:5492}, end: {_id:5497}, properties:{file_path:"YouTube Video: WOKBogNTmPI (URL: https://www.youtube.com/watch?v=WOKBogNTmPI)", truncate:"", keywords:"content theme,philosophical concept", weight:2.0, description:"The video discusses overcoming fear to achieve a prana-filled life and fearless outcomes.<SEP>The video discusses overcoming fear to achieve a prana-filled life and fearless outcomes.", created_at:1779518260, source_id:"chunk-79db2134238652230b07da08d8f6f290"}}, {start: {_id:5503}, end: {_id:5500}, properties:{file_path:"YouTube Video: WOKBogNTmPI (URL: https://www.youtube.com/watch?v=WOKBogNTmPI)", truncate:"", keywords:"conceptual illustration,metaphor", weight:2.0, description:"The analogy illustrates the dynamic power of awakened consciousness as silent yet immense energy.<SEP>The analogy illustrates the dynamic power of awakened consciousness as silent yet immense energy.", created_at:1779518260, source_id:"chunk-79db2134238652230b07da08d8f6f290"}}, {start: {_id:3439}, end: {_id:5498}, properties:{file_path:"YouTube Video: WOKBogNTmPI (URL: https://www.youtube.com/watch?v=WOKBogNTmPI)", truncate:"", keywords:"life outcome,spiritual goal", weight:2.0, description:"A prana-filled life emerges from fearless living and alignment with life's true purpose.<SEP>A prana-filled life emerges from fearless living and alignment with life's true purpose.", created_at:1779518260, source_id:"chunk-79db2134238652230b07da08d8f6f290"}}, {start: {_id:5479}, end: {_id:5501}, properties:{file_path:"YouTube Video: WOKBogNTmPI (URL: https://www.youtube.com/watch?v=WOKBogNTmPI)", truncate:"", keywords:"philosophical idea,spiritual practice", weight:2.0, description:"Dynamic entrepreneurship unlocks the transcendental nature of consciousness through awakened awareness.<SEP>Dynamic entrepreneurship unlocks the transcendental nature of consciousness through awakened awareness.", created_at:1779518261, source_id:"chunk-79db2134238652230b07da08d8f6f290"}}, {start: {_id:5479}, end: {_id:5499}, properties:{file_path:"YouTube Video: WOKBogNTmPI (URL: https://www.youtube.com/watch?v=WOKBogNTmPI)", truncate:"", keywords:"consciousness state,life philosophy", weight:2.0, description:"Dynamic entrepreneurship involves living in timelessness with effortless ease and full attention.<SEP>Dynamic entrepreneurship involves living in timelessness with effortless ease and full attention.", created_at:1779518261, source_id:"chunk-79db2134238652230b07da08d8f6f290"}}, {start: {_id:5479}, end: {_id:5502}, properties:{file_path:"YouTube Video: WOKBogNTmPI (URL: https://www.youtube.com/watch?v=WOKBogNTmPI)", truncate:"", keywords:"existential alignment,philosophical foundation", weight:2.0, description:"Dynamic entrepreneurship is rooted in awakening to and living according to life's true purpose.<SEP>Dynamic entrepreneurship is rooted in awakening to and living according to life's true purpose.", created_at:1779518261, source_id:"chunk-79db2134238652230b07da08d8f6f290"}}, {start: {_id:3115}, end: {_id:5501}, properties:{file_path:"YouTube Video: WOKBogNTmPI (URL: https://www.youtube.com/watch?v=WOKBogNTmPI)", truncate:"", keywords:"consciousness evolution,spiritual harmony", weight:1.0, description:"The transcendental nature of consciousness dissolves matter-consciousness divides, forming the foundation for enlightened consciousness and dynamic life flow.", created_at:1779518260, source_id:"chunk-b10ebf50b04723581984202297711043"}}, {start: {_id:5484}, end: {_id:3115}, properties:{file_path:"YouTube Video: WOKBogNTmPI (URL: https://www.youtube.com/watch?v=WOKBogNTmPI)", truncate:"", keywords:"societal impact,spiritual practice", weight:1.0, description:"Enlightened consciousness manifests as a Buddha-driven life, enabling global impact through conscious wealth generation and planetary well-being.", created_at:1779518260, source_id:"chunk-b10ebf50b04723581984202297711043"}}, {start: {_id:5481}, end: {_id:3933}, properties:{file_path:"YouTube Video: WOKBogNTmPI (URL: https://www.youtube.com/watch?v=WOKBogNTmPI)", truncate:"", keywords:"conscious leadership,economic transformation", weight:1.0, description:"Enlightened entrepreneurs reshape wealth generation and circulation through conscious business practices, impacting global markets.", created_at:1779518260, source_id:"chunk-b10ebf50b04723581984202297711043"}}, {start: {_id:486}, end: {_id:3255}, properties:{file_path:"unknown_source<SEP>YouTube Video: YguId6pF5KI (URL: https://www.youtube.com/watch?v=YguId6pF5KI)", keywords:"energy,energy contrast,teaching environment,teaching reception", truncate:"", weight:3.0, description:"India is noted for having a unique energy conducive to the One Consciousness teachings compared to the United States.<SEP>India has a unique energy for this teaching not found in the US, which is reflected in the concept of joy in their heart.<SEP>India's energy for this teaching is distinct from the US, emphasizing joy in their heart.", created_at:1779518363, source_id:"chunk-d078b842a118a3665da45a82508e955c<SEP>chunk-7ca551e43031a753f46fc5d256a3cf82"}}, {start: {_id:3563}, end: {_id:5507}, properties:{file_path:"unknown_source", keywords:"leadership,teachings", truncate:"", weight:1.0, description:"Krishna Ji is the founder and teacher of the One Consciousness Leader Circle, embodying and delivering its core principles.", created_at:1779518283, source_id:"chunk-d078b842a118a3665da45a82508e955c"}}, {start: {_id:5443}, end: {_id:5507}, properties:{file_path:"unknown_source", keywords:"global impact,philosophy", truncate:"", weight:1.0, description:"The One Consciousness Leader Circle aims to shift global consciousness toward unity and connection through its teachings.", created_at:1779518284, source_id:"chunk-d078b842a118a3665da45a82508e955c"}}, {start: {_id:5506}, end: {_id:5507}, properties:{file_path:"unknown_source<SEP>YouTube Video: YguId6pF5KI (URL: https://www.youtube.com/watch?v=YguId6pF5KI)", truncate:"", keywords:"global impact,organization alignment,program offering,shared mission", weight:3.0, description:"One Consciousness Leader Circle operates under the umbrella of OCLC, offering its transformational teachings and programs.<SEP>The One Consciousness Leader Circle's goals align with OCLC's mission to make a global impact.<SEP>The circle's goals align with OCLC's mission for global impact.", created_at:1779518308, source_id:"chunk-d078b842a118a3665da45a82508e955c<SEP>chunk-f66651ee848911049e03ee6f58135f0a"}}, {start: {_id:3563}, end: {_id:234}, properties:{file_path:"unknown_source", keywords:"mentorship,teachings", truncate:"", weight:1.0, description:"The person directly engaged with Krishna Ji's teachings, gaining insights into living connected principles and impacting others.", created_at:1779518