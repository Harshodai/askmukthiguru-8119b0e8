d:1076, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"A principle where love and connection are experienced without constraints, enabling partners to support each other freely.", created_at:1779141542, source_id:"chunk-a982ea596b48b390924063ff39da67f6", entity_id:"Connection Without Expectations"}}, {_id:1077, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"A state of inner calm emphasized in the text, supported by self-acceptance and unconditional acceptance.", created_at:1779141542, source_id:"chunk-a982ea596b48b390924063ff39da67f6", entity_id:"Present Peace"}}, {_id:1078, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Grumpiness is met with Krishnaji's patient understanding and emotional connection.", created_at:1779141632, source_id:"chunk-c85036006eb9517f84fbb3ee7717030e", entity_id:"Grumpiness"}}, {_id:1079, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The original garbled phrase \"Yatha Manaha Tatho Bhavaha\" is corrected to \"Yatha Manah Tattah Bhavah Tattah\" to align with established Sanskrit teachings.", created_at:1779213761, source_id:"chunk-84231a38981e55784ff03ce5211e679e", entity_id:"Yatha Manaha Tatho Bhavaha"}}, {_id:1080, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The phrase \"Yatha Rasaha Tatho Karmaha\" is corrected to \"Yatha Rasah Tattah Karmakah\" to illustrate the connection between expressions and subsequent actions.", created_at:1779213762, source_id:"chunk-84231a38981e55784ff03ce5211e679e", entity_id:"Yatha Rasaha Tatho Karmaha"}}] AS row
