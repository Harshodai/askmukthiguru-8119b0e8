UNWIND [{start: {_id:2434}, end: {_id:2435}, properties:{file_path:"unknown_source", keywords:"accessibility,adaptation", truncate:"", weight:1.0, description:"Villages implement Soul Sync Meditation despite poverty, demonstrating its universal applicability.`", created_at:1779173790, source_id:"chunk-02f292000f544446b15f0519998d1dbc"}}, {start: {_id:284}, end: {_id:32}, properties:{file_path:"unknown_source<SEP>YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"authentic motivation,impact creation,interdependent concepts,self-transcendence", truncate:"", weight:2.0, description:"Purpose emerges organically from meaningful connections, driving genuine desires to create impact.<SEP>Purpose becomes apparent only when one moves beyond self-preoccupation into connection.", created_at:1779562289, source_id:"chunk-39ae671b46577f26845d7bb862a61c36<SEP>chunk-df8fc1ec5d1cc48e4ba2ac7fc6630477"}}, {start: {_id:178}, end: {_id:930}, properties:{file_path:"unknown_source", keywords:"comparison,societal pressure", truncate:"", weight:1.0, description:"Youth face pressure from societal expectations to achieve external markers of success.", created_at:1779173791, source_id:"chunk-39ae671b46577f26845d7bb862a61c36"}}, {start: {_id:2436}, end: {_id:284}, properties:{file_path:"unknown_source", keywords:"exhaustion,lack of fulfillment", truncate:"", weight:1.0, description:"Burnout results from disconnection and unmet longing for fulfillment.", created_at:1779173791, source_id:"chunk-39ae671b46577f26845d7bb862a61c36"}}, {start: {_id:752}, end: {_id:930}, properties:{file_path:"unknown_source", truncate:"", keywords:"cultural norms,generational expectations", weight:1.0, description:"Youth experience tension between familial/community expectations and personal fulfillment.", created_at:1779173791, source_id:"chunk-39ae671b46577f26845d7bb862a61c36"}}, {start: {_id:2489}, end: {_id:2434}, properties:{file_path:"unknown_source", keywords:"method", truncate:"", weight:1.0, description:"Soul Sync Meditation is a structured practice for cultivating inner calm and dissolving ego-driven patterns.` The first one is more about the outcome, the second is about the method. The first one seems more distinct. The second one is a bit circular.", created_at:1779173791, source_id:"chunk-02f292000f544446b15f0519998d1dbc"}}, {start: {_id:2376}, end: {_id:519}, properties:{file_path:"unknown_source", keywords:"awareness,intervention", truncate:"", weight:1.0, description:"The practice enables conscious observation of stressful states, fostering gradual replacement with beautiful states through brain training.", created_at:1779173791, source_id:"chunk-0b9ac55d2cab188fc69b15917905c7be"}}, {start: {_id:2395}, end: {_id:930}, properties:{file_path:"unknown_source", keywords:"resilience,self-discovery", truncate:"", weight:1.0, description:"Youth can use soul-sync practice to navigate dark moments and rediscover purpose through connection.", created_at:1779173791, source_id:"chunk-39ae671b46577f26845d7bb862a61c36"}}, {start: {_id:2440}, end: {_id:176}, properties:{file_path:"unknown_source", keywords:"neurobiological change", truncate:"", weight:1.0, description:"A clear spiritual vision drives lasting changes in neural connections and biological processes to sustain beautiful states.", created_at:1779173791, source_id:"chunk-0b9ac55d2cab188fc69b15917905c7be"}}, {start: {_id:2436}, end: {_id:2395}, properties:{file_path:"unknown_source", keywords:"coping mechanism,mind training", truncate:"", weight:1.0, description:"Soul-sync practice helps mitigate burnout by fostering connection and reducing reliance on external validation.", created_at:1779173791, source_id:"chunk-39ae671b46577f26845d7bb862a61c36"}}, {start: {_id:2438}, end: {_id:2376}, properties:{file_path:"unknown_source", keywords:"activation,neuroplasticity", truncate:"", weight:1.0, description:"The practice activates specific brain regions to rewire neural pathways and sustain awareness of beautiful states.", created_at:1779173791, source_id:"chunk-0b9ac55d2cab188fc69b15917905c7be"}}, {start: {_id:2437}, end: {_id:2490}, properties:{file_path:"unknown_source", keywords:"conflation,confusion", truncate:"", weight:1.0, description:"Lack of clarity leads to merging external challenges with internal experiences, perpetuating suffering.", created_at:1779173791, source_id:"chunk-0b9ac55d2cab188fc69b15917905c7be"}}, {start: {_id:401}, end: {_id:519}, properties:{file_path:"unknown_source", keywords:"dysfunction,resistance", truncate:"", weight:1.0, description:"Prolonged stressful states reinforce harmful neural pathways, resisting transformation without deliberate practice.", created_at:1779173791, source_id:"chunk-0b9ac55d2cab188fc69b15917905c7be"}}, {start: {_id:2438}, end: {_id:1617}, properties:{file_path:"unknown_source", truncate:"", keywords:"mindfulness practice,neurological activation", weight:2.0, description:"The mind activates different brain regions through practices like mindfulness, altering mental states.` -> `neurological activation, mindfulness practice`. This looks correct.<SEP>The mind activates different brain regions through practices like mindfulness, altering mental states.` -> Good.", created_at:1779173791, source_id:"chunk-63d06faace0f1b4702a02e3e0e580ab7"}}, {start: {_id:2442}, end: {_id:2445}, properties:{file_path:"unknown_source", truncate:"", keywords:"inherited experiences,karmic transfer", weight:2.0, description:"Trauma and states from previous generations flow into the present through generations.` -> `inherited experiences, karmic transfer`. This looks correct.<SEP>Trauma and states from previous generations flow into the present through generations.` -> Good.", created_at:1779173791, source_id:"chunk-63d06faace0f1b4702a02e3e0e580ab7"}}, {start: {_id:32}, end: {_id:930}, properties:{file_path:"unknown_source", truncate:"", keywords:"existential questioning,modern challenges", weight:1.0, description:"Youth in modern times ask questions about life's purpose previously asked by older generations.", created_at:1779173792, source_id:"chunk-63d06faace0f1b4702a02e3e0e580ab7"}}, {start: {_id:2442}, end: {_id:2444}, properties:{file_path:"unknown_source", truncate:"", keywords:"behavioral patterns,spiritual inheritance", weight:1.0, description:"Karmic energy transfers states across generations, perpetuating family patterns.", created_at:1779173792, source_id:"chunk-63d06faace0f1b4702a02e3e0e580ab7"}}, {start: {_id:2445}, end: {_id:930}, properties:{file_path:"unknown_source", truncate:"", keywords:"contrasting experiences,generational context", weight:1.0, description:"Youth face different external challenges than previous generations but experience similar internal struggles.", created_at:1779173792, source_id:"chunk-63d06faace0f1b4702a02e3e0e580ab7"}}, {start: {_id:287}, end: {_id:32}, properties:{file_path:"unknown_source", truncate:"", keywords:"fundamental existence,philosophical inquiry", weight:1.0, description:"Life is the ultimate purpose, with purpose discussions rooted in the experience of being alive.", created_at:1779173792, source_id:"chunk-63d06faace0f1b4702a02e3e0e580ab7"}}, {start: {_id:1617}, end: {_id:519}, properties:{file_path:"unknown_source", truncate:"", keywords:"mental state modulation,present awareness", weight:1.0, description:"Mindfulness practices help transition from stressful to present states.", created_at:1779173792, source_id:"chunk-63d06faace0f1b4702a02e3e0e580ab7"}}] AS row
