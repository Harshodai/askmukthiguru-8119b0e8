UNWIND [{start: {_id:1791}, end: {_id:1083}, properties:{file_path:"YouTube Video: k8iO5daXllM (URL: https://www.youtube.com/watch?v=k8iO5daXllM)", keywords:"output,transformation", truncate:"", weight:1.0, description:"The provided text is transformed into corrected text through the role's processing.", created_at:1779662775, source_id:"chunk-963de118dd8c42af405a0b9cfddcf2c4"}}, {start: {_id:5306}, end: {_id:7309}, properties:{file_path:"unknown_source", keywords:"divine use,symbolism", truncate:"", weight:4.0, description:"Krishna uses the Panchajanya, a conch symbolizing divine power and authority.<SEP>Krishna uses the Panchajanya, a conch symbolizing divine power and authority.", created_at:1779663050, source_id:"chunk-d0968f5f92c9347abb58d844c3aec5da"}}, {start: {_id:2272}, end: {_id:1883}, properties:{file_path:"unknown_source", keywords:"error type,focus area", truncate:"", weight:2.0, description:"Domain-specific terms are a focus area for the correction task.<SEP>Domain-specific terms are a focus area for the correction task.", created_at:1779663052, source_id:"chunk-b5740e78ef9d639abf29c23f66c49a23"}}, {start: {_id:7308}, end: {_id:3041}, properties:{file_path:"unknown_source", keywords:"conflict,key warrior", truncate:"", weight:4.0, description:"Bhishma is a significant warrior in the Mahabharata, involved in key conflicts.<SEP>Bhishma is a significant warrior in the Mahabharata, involved in key conflicts.", created_at:1779663050, source_id:"chunk-d0968f5f92c9347abb58d844c3aec5da"}}, {start: {_id:3041}, end: {_id:7309}, properties:{file_path:"unknown_source", keywords:"event connection,narrative", truncate:"", weight:2.0, description:"The Mahabharata is the event where Krishna's conch, Panchajanya, is used.<SEP>The Mahabharata is the event where Krishna's conch, Panchajanya, is used.", created_at:1779663051, source_id:"chunk-d0968f5f92c9347abb58d844c3aec5da"}}, {start: {_id:5306}, end: {_id:3041}, properties:{file_path:"unknown_source", keywords:"central character,divine role", truncate:"", weight:4.0, description:"Krishna is a central figure in the Mahabharata, playing a pivotal role in the war.<SEP>Krishna is a central figure in the Mahabharata, playing a pivotal role in the war.", created_at:1779663052, source_id:"chunk-d0968f5f92c9347abb58d844c3aec5da"}}, {start: {_id:7313}, end: {_id:348}, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", truncate:"", keywords:"educational content,media analysis", weight:1.0, description:"The video analyzes the reality of war through historical and emotional perspectives.", created_at:1779663109, source_id:"chunk-f0397f46fa5013a38f8a2900ffa6eef9"}}, {start: {_id:7315}, end: {_id:2004}, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", keywords:"contrast,portrayal", truncate:"", weight:1.0, description:"Historical wars are portrayed in textbooks with numbers and dates, while video games simulate warfare in a controlled fictional environment.", created_at:1779663109, source_id:"chunk-f0397f46fa5013a38f8a2900ffa6eef9"}}, {start: {_id:7313}, end: {_id:2004}, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", keywords:"contrast,simulation", truncate:"", weight:1.0, description:"The video contrasts the actual horrors of war with its sanitized portrayal in video games.", created_at:1779663109, source_id:"chunk-f0397f46fa5013a38f8a2900ffa6eef9"}}, {start: {_id:7314}, end: {_id:7313}, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", keywords:"causation,consequences", truncate:"", weight:1.0, description:"The video emphasizes human suffering as a direct consequence of warfare.", created_at:1779663109, source_id:"chunk-f0397f46fa5013a38f8a2900ffa6eef9"}}, {start: {_id:4959}, end: {_id:7318}, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", truncate:"", keywords:"geographical boundary,location", weight:1.0, description:"Frontiers are part of the country's borders, where citizens stand to defend against threats.", created_at:1779663137, source_id:"chunk-0360e3d7478d7aa88e74b472aef4bc64"}}, {start: {_id:7317}, end: {_id:1469}, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", truncate:"", keywords:"final act,moral justification", weight:1.0, description:"War is framed as the ultimate act of self-defense, morally permissible only to protect innocent lives and uphold societal survival.", created_at:1779663137, source_id:"chunk-0360e3d7478d7aa88e74b472aef4bc64"}}, {start: {_id:5793}, end: {_id:1469}, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", keywords:"protection,societal duty", truncate:"", weight:1.0, description:"War is depicted as a means to protect citizens, with society expected to honor those who engage in conflict for collective safety.", created_at:1779663137, source_id:"chunk-0360e3d7478d7aa88e74b472aef4bc64"}}, {start: {_id:5793}, end: {_id:4959}, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", truncate:"", keywords:"loyalty,respect", weight:1.0, description:"Citizens are called to respect and support those defending the country, reinforcing national unity and shared sacrifice.", created_at:1779663137, source_id:"chunk-0360e3d7478d7aa88e74b472aef4bc64"}}, {start: {_id:1469}, end: {_id:7316}, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", keywords:"cause,invasion,threat", truncate:"", weight:1.0, description:"The violent neighbor's potential invasion is a reason for engaging in war as self-defense.", created_at:1779663137, source_id:"chunk-0360e3d7478d7aa88e74b472aef4bc64"}}, {start: {_id:7322}, end: {_id:1526}, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", truncate:"", keywords:"cause,effect", weight:1.0, description:"Individual consciousness in conflict leads to global violence.", created_at:1779663149, source_id:"chunk-4529c1884cd3f5e14f3ad9c161d86e76"}}, {start: {_id:5793}, end: {_id:7321}, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", keywords:"Dharma,moral duty", truncate:"", weight:1.0, description:"Soldier and citizens have distinct Dharma (duties) related to protection and non-violence.", created_at:1779663149, source_id:"chunk-4529c1884cd3f5e14f3ad9c161d86e76"}}, {start: {_id:7320}, end: {_id:2642}, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", keywords:"encouragement,guidance", truncate:"", weight:1.0, description:"Shri Krishna encourages Arjuna to fight in the Mahabharata.", created_at:1779663149, source_id:"chunk-4529c1884cd3f5e14f3ad9c161d86e76"}}, {start: {_id:7310}, end: {_id:2642}, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", keywords:"philosophy,teachings", truncate:"", weight:1.0, description:"Shri Krishna speaks of Ahimsa as Paramo Dharma in the Mahabharata.", created_at:1779663149, source_id:"chunk-4529c1884cd3f5e14f3ad9c161d86e76"}}, {start: {_id:7319}, end: {_id:2642}, properties:{file_path:"YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", keywords:"philosophy,teachings", truncate:"", weight:1.0, description:"Shri Krishna emphasizes Paramo Dharma in the Mahabharata.", created_at:1779663149, source_id:"chunk-4529c1884cd3f5e14f3ad9c161d86e76"}}] AS row
