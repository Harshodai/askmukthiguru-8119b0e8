UNWIND [{start: {_id:430}, end: {_id:5696}, properties:{file_path:"YouTube Video: s6B81c2uTGg (URL: https://www.youtube.com/watch?v=s6B81c2uTGg)", keywords:"concept,relationship", truncate:"", weight:1.0, description:"Childhood is linked to the concept of an unknown child, emphasizing the need to protect and nurture.", created_at:1779520977, source_id:"chunk-5775fa967c3333ec10bee1ba6077c7ce"}}, {start: {_id:5707}, end: {_id:5695}, properties:{file_path:"YouTube Video: s6B81c2uTGg (URL: https://www.youtube.com/watch?v=s6B81c2uTGg)", truncate:"", keywords:"collective impact,suffering", weight:1.0, description:"The suffering of children and young people becomes part of humanity's shared thought sphere.", created_at:1779520991, source_id:"chunk-523915ad473a2e9b1024913a693f94bb"}}, {start: {_id:755}, end: {_id:5695}, properties:{file_path:"YouTube Video: s6B81c2uTGg (URL: https://www.youtube.com/watch?v=s6B81c2uTGg)", keywords:"meditation,transformation", truncate:"", weight:1.0, description:"Meditating for peace transforms the thought sphere into a force of peacefulness.", created_at:1779520991, source_id:"chunk-523915ad473a2e9b1024913a693f94bb"}}, {start: {_id:17}, end: {_id:5702}, properties:{file_path:"YouTube Video: s6B81c2uTGg (URL: https://www.youtube.com/watch?v=s6B81c2uTGg)", keywords:"champion,compassion", truncate:"", weight:1.0, description:"Krishnaji is recognized as a champion for peace and humanity, actively working to protect children.", created_at:1779521017, source_id:"chunk-37d0d91f60cf0c0cf3f8569ec5103472"}}, {start: {_id:2295}, end: {_id:5702}, properties:{file_path:"YouTube Video: s6B81c2uTGg (URL: https://www.youtube.com/watch?v=s6B81c2uTGg)", keywords:"champion,compassion", truncate:"", weight:1.0, description:"Prithaji is acknowledged for her efforts in promoting love, compassion, and peace, particularly in protecting children.", created_at:1779521017, source_id:"chunk-37d0d91f60cf0c0cf3f8569ec5103472"}}, {start: {_id:5702}, end: {_id:348}, properties:{file_path:"YouTube Video: s6B81c2uTGg (URL: https://www.youtube.com/watch?v=s6B81c2uTGg)", keywords:"content,discussion", truncate:"", weight:1.0, description:"The YouTube Video serves as the platform where the speaker discusses the importance of protecting children.", created_at:1779521017, source_id:"chunk-37d0d91f60cf0c0cf3f8569ec5103472"}}, {start: {_id:5701}, end: {_id:5702}, properties:{file_path:"YouTube Video: s6B81c2uTGg (URL: https://www.youtube.com/watch?v=s6B81c2uTGg)", truncate:"", keywords:"collective responsibility,global impact", weight:1.0, description:"Protecting Children is a collective responsibility aimed at safeguarding the global group of children.", created_at:1779521018, source_id:"chunk-37d0d91f60cf0c0cf3f8569ec5103472"}}, {start: {_id:5712}, end: {_id:5710}, properties:{file_path:"unknown_source", keywords:"manifestation,unified source", truncate:"", weight:1.0, description:"Mahadeva symbolizes the unified source of the diversified universe, bridging the principle of oneness with its visible diversity.", created_at:1779521247, source_id:"chunk-a4ec9b97a69f62614437c5e1621469d7"}}, {start: {_id:5713}, end: {_id:5710}, properties:{file_path:"YouTube Video: MJYpyUlwxg0 (URL: https://www.youtube.com/watch?v=MJYpyUlwxg0)", truncate:"", keywords:"symbolism,unified expression", weight:1.0, description:"Mahadeva's dance is a dynamic symphony symbolizing the waves of oneness and its unified expression.", created_at:1779521247, source_id:"chunk-2440e826e4f3cf50974cdd2445cd5354"}}, {start: {_id:5711}, end: {_id:5710}, properties:{file_path:"unknown_source", truncate:"", keywords:"divine embodiment,ritual significance", weight:1.0, description:"Mahadeva is venerated during Maha Shivaratri as the embodiment of oneness, with his dance symbolizing the cosmic rhythms of existence.", created_at:1779521247, source_id:"chunk-a4ec9b97a69f62614437c5e1621469d7"}}, {start: {_id:5709}, end: {_id:5710}, properties:{file_path:"YouTube Video: MJYpyUlwxg0 (URL: https://www.youtube.com/watch?v=MJYpyUlwxg0)", keywords:"experience,realization", truncate:"", weight:1.0, description:"Through union with Mahadeva, one experiences Bliss Sachitananda as the realization of unified consciousness.", created_at:1779521248, source_id:"chunk-2440e826e4f3cf50974cdd2445cd5354"}}, {start: {_id:1071}, end: {_id:123}, properties:{file_path:"unknown_source<SEP>YouTube Video: p2HecXyM3tE (URL: https://www.youtube.com/watch?v=p2HecXyM3tE)<SEP>YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", truncate:"", keywords:"conflict,consumption,environmental degradation,environmental impact,harm,shared responsibility", weight:4.0, created_at:1779666431, description:"Humanity's actions directly affect Earth's stability and must align with coexistence principles.<SEP>Humanity's actions directly affect Earth's stability and must align with coexistence principles.<SEP>Humanity's excessive resource extraction harms Earth's ecological balance.<SEP>Earth is depicted as harming humanity through discrimination and separation based on superficial differences.", source_id:"chunk-d459696e63e5250812e4b59a48640c43<SEP>chunk-41597711835923a77b9f33543aee1546<SEP>chunk-8ef9c50f626a2c5bf33ddd61c9795988"}}, {start: {_id:123}, end: {_id:5714}, properties:{file_path:"YouTube Video: Xk1KsO3efP4 (URL: https://www.youtube.com/watch?v=Xk1KsO3efP4)", keywords:"boundaries,respect", truncate:"", weight:1.0, description:"Millions of species ask humanity to respect their living spaces and boundaries.", created_at:1779521746, source_id:"chunk-8b2fbaa3ebe33f5b431669abfbee9a40"}}, {start: {_id:1071}, end: {_id:5714}, properties:{file_path:"YouTube Video: Xk1KsO3efP4 (URL: https://www.youtube.com/watch?v=Xk1KsO3efP4)", truncate:"", keywords:"coexistence,shared habitat", weight:1.0, description:"Earth is shared between humanity and millions of other species, emphasizing interdependence.", created_at:1779521746, source_id:"chunk-8b2fbaa3ebe33f5b431669abfbee9a40"}}, {start: {_id:5717}, end: {_id:5718}, properties:{file_path:"unknown_source", keywords:"causation,energy flow", truncate:"", weight:1.0, description:"Releasing a roadblock in consciousness allows divine power to flow.", created_at:1779522027, source_id:"chunk-57d13edf70fda1b7b5635305ebadfc8d"}}, {start: {_id:5723}, end: {_id:3126}, properties:{file_path:"unknown_source", keywords:"impact,interconnectedness", truncate:"", weight:1.0, description:"Transformation in consciousness impacts someone else's heart and desires, even at a distance.", created_at:1779522028, source_id:"chunk-57d13edf70fda1b7b5635305ebadfc8d"}}, {start: {_id:5724}, end: {_id:5719}, properties:{file_path:"unknown_source", keywords:"interconnectedness,liberation", truncate:"", weight:1.0, description:"Freedom in one area impacts unrelated life areas like business or career.", created_at:1779522028, source_id:"chunk-57d13edf70fda1b7b5635305ebadfc8d"}}, {start: {_id:5720}, end: {_id:5721}, properties:{file_path:"YouTube Video: Fn62UQTIMEk (URL: https://www.youtube.com/watch?v=Fn62UQTIMEk)", truncate:"", keywords:"impact,influence", weight:1.0, description:"Liberation in consciousness impacts business.", created_at:1779522028, source_id:"chunk-c7bf6f021740e165e861766b49fe6388"}}, {start: {_id:50}, end: {_id:3126}, properties:{file_path:"unknown_source", keywords:"causation,manifestation", truncate:"", weight:1.0, description:"Consciousness transformation manifests synchronicities to bring people together.", created_at:1779522028, source_id:"chunk-57d13edf70fda1b7b5635305ebadfc8d"}}, {start: {_id:1473}, end: {_id:234}, properties:{file_path:"YouTube Video: Fn62UQTIMEk (URL: https://www.youtube.com/watch?v=Fn62UQTIMEk)", keywords:"impact,manifestation", truncate:"", weight:1.0, description:"Transformation in consciousness can impact someone else, even thousands of miles away, manifesting synchronicities.", created_at:1779522029, source_id:"chunk-c7bf6f021740e165e861766b49fe6388"}}] AS row
