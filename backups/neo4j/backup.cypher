UNWIND [{start: {_id:6782}, end: {_id:2232}, properties:{file_path:"YouTube Video: K-AFDVOkIoE (URL: https://www.youtube.com/watch?v=K-AFDVOkIoE)", truncate:"", keywords:"celebration,environmental advocacy", weight:1.0, description:"Earth Day is dedicated to honoring and protecting Mother Earth through global sustainability efforts.", created_at:1779648323, source_id:"chunk-393e1029671c8cd325c8aaceacba56f1"}}, {start: {_id:6701}, end: {_id:348}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"analysis,behavioral analysis,concept,content,content focus,discusses,discussion,discussion topic,textual analysis", weight:6.0, created_at:1779652126, description:"The video discusses the nature and management of attitudes as a central theme.<SEP>The video discusses the concept of attitude and its negative impact on human behavior.<SEP>The video discusses different types of attitudes and their implications in human behavior.<SEP>The video's transcript focuses on analyzing the phrase in the context of an attitude-related discussion.<SEP>The YouTube Video analyzes the concept of attitude and includes a transcription error affecting the discussion.<SEP>The YouTube Video discusses the concept of attitude and potential transcription errors related to it.", source_id:"chunk-3df6d7e17b29056ecebd37bab054ca0d<SEP>chunk-557efbfbf9c9ce831df3d12449f77fc2<SEP>chunk-57b00092944096f4ab4f32bdf20fe4b7<SEP>chunk-b8d7dcfd08180c8f4ffab15da2093e12<SEP>chunk-f5593ece4d6fefc307d1c996f846a8c5"}}, {start: {_id:2232}, end: {_id:6785}, properties:{file_path:"YouTube Video: K-AFDVOkIoE (URL: https://www.youtube.com/watch?v=K-AFDVOkIoE)", truncate:"", keywords:"collective action,metaphorical connection", weight:1.0, description:"Mother Earth is metaphorically linked to \"sustainability at home,\" encouraging individual environmental responsibility.", created_at:1779648324, source_id:"chunk-393e1029671c8cd325c8aaceacba56f1"}}, {start: {_id:6784}, end: {_id:6786}, properties:{file_path:"YouTube Video: K-AFDVOkIoE (URL: https://www.youtube.com/watch?v=K-AFDVOkIoE)", keywords:"catalyst,cultural impact", truncate:"", weight:1.0, description:"The Earthrise photograph inspired the global environmental movement and contributed to ending the Vietnam War.", created_at:1779648324, source_id:"chunk-393e1029671c8cd325c8aaceacba56f1"}}, {start: {_id:6701}, end: {_id:598}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"behavioral impact,categorization,causal relationship,co-occurrence,cognitive basis,definition,limitation", weight:4.0, created_at:1779648983, description:"Attitudes are explicitly defined as manifestations of continuous judgment processes.<SEP>Excessive judgment leads to the formation of obsessive attitudes affecting behavior.<SEP>Attitudes are categorized as judgments, highlighting their role in shaping perspectives and behaviors.<SEP>Attitude and judgment reinforce each other, limiting one's worldview.`", source_id:"chunk-3df6d7e17b29056ecebd37bab054ca0d<SEP>chunk-64ea4734b29c6f7afa27243c21ffc049<SEP>chunk-9deb1452ed9eae4ab1315fc2eb8f47d0"}}, {start: {_id:348}, end: {_id:930}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"audience,relevance", truncate:"", weight:1.0, description:"The video addresses youth as the primary audience experiencing and navigating attitudes.", created_at:1779648324, source_id:"chunk-3df6d7e17b29056ecebd37bab054ca0d"}}, {start: {_id:2232}, end: {_id:6781}, properties:{file_path:"YouTube Video: K-AFDVOkIoE (URL: https://www.youtube.com/watch?v=K-AFDVOkIoE)", truncate:"", keywords:"collective action,metaphorical connection", weight:1.0, description:"Mother Earth is metaphorically linked to \"practicing sustainability at home,\" encouraging individual environmental responsibility.", created_at:1779648325, source_id:"chunk-393e1029671c8cd325c8aaceacba56f1"}}, {start: {_id:6701}, end: {_id:961}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"attitude type,perspective", truncate:"", weight:1.0, description:"Negative Light is presented as a specific example of an attitude characterized by negativity.", created_at:1779648325, source_id:"chunk-3df6d7e17b29056ecebd37bab054ca0d"}}, {start: {_id:6784}, end: {_id:6787}, properties:{file_path:"YouTube Video: K-AFDVOkIoE (URL: https://www.youtube.com/watch?v=K-AFDVOkIoE)", truncate:"", keywords:"historical influence,peace advocacy", weight:1.0, description:"The Earthrise photograph's emotional impact helped halt the Vietnam War and fostered international cooperation.", created_at:1779648325, source_id:"chunk-393e1029671c8cd325c8aaceacba56f1"}}, {start: {_id:6780}, end: {_id:6701}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"attitude type,example", truncate:"", weight:1.0, description:"Arrogant Attitude is presented as a specific manifestation of attitude characterized by overconfidence.", created_at:1779648325, source_id:"chunk-3df6d7e17b29056ecebd37bab054ca0d"}}, {start: {_id:6701}, end: {_id:6779}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"attitude type,example", truncate:"", weight:1.0, description:"Inferior/Superior Attitude is another example of attitude where individuals feel either inferior or superior, affecting their behavior.", created_at:1779648332, source_id:"chunk-3df6d7e17b29056ecebd37bab054ca0d"}}, {start: {_id:1071}, end: {_id:6782}, properties:{file_path:"YouTube Video: K-AFDVOkIoE (URL: https://www.youtube.com/watch?v=K-AFDVOkIoE)", truncate:"", keywords:"environmental advocacy,symbolic association", weight:1.0, description:"Earth is central to Earth Day's purpose of fostering planetary protection and ecological responsibility.", created_at:1779648366, source_id:"chunk-b1e9b7eb495ce02a274d514dffa406f5"}}, {start: {_id:1947}, end: {_id:6554}, properties:{file_path:"YouTube Video: K-AFDVOkIoE (URL: https://www.youtube.com/watch?v=K-AFDVOkIoE)", truncate:"", keywords:"awareness response,contextual framework", weight:1.0, description:"Spiritual evolution is framed as a necessary response to crisis through heightened perception and emotion.", created_at:1779648366, source_id:"chunk-b1e9b7eb495ce02a274d514dffa406f5"}}, {start: {_id:6788}, end: {_id:6554}, properties:{file_path:"YouTube Video: K-AFDVOkIoE (URL: https://www.youtube.com/watch?v=K-AFDVOkIoE)", truncate:"", keywords:"awareness application,preventive measure", weight:1.0, description:"Advancing spiritual evolution is proposed to mitigate the risk of planetary crisis through conscious action.", created_at:1779648366, source_id:"chunk-b1e9b7eb495ce02a274d514dffa406f5"}}, {start: {_id:5341}, end: {_id:348}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"concept,discusses", weight:1.0, description:"The video explores the role of judgments in hindering human relationships and truth perception.", created_at:1779648422, source_id:"chunk-557efbfbf9c9ce831df3d12449f77fc2"}}, {start: {_id:6701}, end: {_id:5341}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"concept,related", weight:1.0, description:"Attitudes and judgments are interconnected concepts discussed in the context of human behavior.", created_at:1779648422, source_id:"chunk-557efbfbf9c9ce831df3d12449f77fc2"}}, {start: {_id:1799}, end: {_id:348}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"discusses,subject", weight:1.0, description:"The video addresses human beings' tendency to form judgments and its consequences.", created_at:1779648422, source_id:"chunk-557efbfbf9c9ce831df3d12449f77fc2"}}, {start: {_id:1799}, end: {_id:5341}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"affects,behavior", weight:1.0, description:"Judgments negatively impact human beings' ability to relate and perceive truth.", created_at:1779648422, source_id:"chunk-557efbfbf9c9ce831df3d12449f77fc2"}}, {start: {_id:6789}, end: {_id:123}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"global challenge,solution approach", weight:1.0, description:"Humanity addresses the global problem through living in a state of love, connection, and compassion.", created_at:1779648508, source_id:"chunk-64ea4734b29c6f7afa27243c21ffc049"}}, {start: {_id:6791}, end: {_id:6789}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"collective action,global challenge", weight:4.0, description:"Every form of living being is part of the global problem that needs to be addressed through collective action.<SEP>The global problem affects every form of living being, requiring collective action.", created_at:1779648508, source_id:"chunk-64ea4734b29c6f7afa27243c21ffc049"}}] AS row
