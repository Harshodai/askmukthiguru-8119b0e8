UNWIND [{start: {_id:900}, end: {_id:1009}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional state,relational impact", truncate:"", weight:1.0, description:"Staleness results in disconnection, preventing genuine presence with others.", created_at:1779141086, source_id:"chunk-fa73522aa96594208b9f43ea66a6493e"}}, {start: {_id:176}, end: {_id:1016}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"framework,type", truncate:"", weight:1.0, description:"The Light of Spiritual Vision is presented as a specific type of spiritual vision focused on relationships.", created_at:1779141125, source_id:"chunk-25a61dd1a643342f5252980f3c78e37e"}}, {start: {_id:1016}, end: {_id:628}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"application,framework", truncate:"", weight:1.0, description:"The Light of Spiritual Vision provides a framework for nurturing relationships through spiritual connection, directly addressing the concept of relationships.", created_at:1779141126, source_id:"chunk-25a61dd1a643342f5252980f3c78e37e"}}, {start: {_id:176}, end: {_id:311}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"avoidance,contrast", truncate:"", weight:1.0, description:"Spiritual Vision aims to transition individuals from a stressful state to a beautiful state.", created_at:1779141126, source_id:"chunk-25a61dd1a643342f5252980f3c78e37e"}}, {start: {_id:176}, end: {_id:4}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"content,source", truncate:"", weight:1.0, description:"The Four Sacred Secrets.pdf discusses spiritual vision as a core concept.", created_at:1779141126, source_id:"chunk-25a61dd1a643342f5252980f3c78e37e"}}, {start: {_id:543}, end: {_id:1020}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"aspiration,intentionality", truncate:"", weight:1.0, description:"Relationships require a shared vision of desired love and joy.", created_at:1779141171, source_id:"chunk-ad8061bbea71b4b58c920eb95c67cb44"}}, {start: {_id:1019}, end: {_id:1018}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"linguistic emphasis,relational quality", weight:1.0, description:"Prioritizing adjectives (e.g., \"loving\") enhances the depth of relational roles.", created_at:1779141171, source_id:"chunk-ad8061bbea71b4b58c920eb95c67cb44"}}, {start: {_id:284}, end: {_id:1023}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"cultural influence,misunderstanding,societal perception", truncate:"", weight:2.0, description:"Modern society's flawed understanding of connection is culturally reinforced.<SEP>Modern society misunderstands connection due to cultural conditioning, creating a defect in their conceptual framework.", created_at:1779187234, source_id:"chunk-9126b7168266feeb5c044ddb65ae0392<SEP>chunk-21d71f186fdeb1dfcf5eb219529f54f0"}}, {start: {_id:17}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"emotional conflict,interaction,mentoring,personal interaction,spiritual guidance,strained relationship", truncate:"", weight:4.0, description:"Sunil participated in a mentoring session with Krishnaji at the campus.<SEP>Sunil attended a mentoring session conducted by Krishnaji.<SEP>Sunil resents his father for pressuring him to stay in school and later feels abandoned, fostering bitterness.<SEP>Sunil attended a mentoring session with Krishnaji at the campus, initiating his journey toward self-discovery.", created_at:1779187117, source_id:"chunk-c4f9e407e113bf4f292d2bfecfb8c361<SEP>chunk-5f6e567050111ca1e6e0891a182bd7b3<SEP>chunk-7f41805cd78c323a0c0383328a52c327<SEP>chunk-9a28e4054912d7c9812d1628ee5acb4a"}}, {start: {_id:1027}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"location,mentoring,personal visit,visit", truncate:"", weight:2.0, description:"Sunil visited the campus for a mentoring session with Krishnaji.<SEP>Sunil visited the campus for a personal mentoring session with Krishnaji.", created_at:1779141293, source_id:"chunk-c4f9e407e113bf4f292d2bfecfb8c361<SEP>chunk-5f6e567050111ca1e6e0891a182bd7b3"}}, {start: {_id:284}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"philosophical discussion,source", truncate:"", weight:1.0, description:"The document discusses connection as a fundamental philosophical concept.", created_at:1779141250, source_id:"chunk-c4f9e407e113bf4f292d2bfecfb8c361"}}, {start: {_id:1029}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"emotional growth,experience,experiential suffering,work", truncate:"", weight:2.0, description:"Sunil worked in Mumbai and faced unkindness there.<SEP>Sunil's time in Mumbai was marked by pain but ultimately led to his transformative self-realization.", created_at:1779187118, source_id:"chunk-5f6e567050111ca1e6e0891a182bd7b3<SEP>chunk-9a28e4054912d7c9812d1628ee5acb4a"}}, {start: {_id:82}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conflict,financial obligation", truncate:"", weight:1.0, description:"Sunil sent money home per agreement but resented his father's refusal to help him return.", created_at:1779141293, source_id:"chunk-5f6e567050111ca1e6e0891a182bd7b3"}}, {start: {_id:1028}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional response,rejection", truncate:"", weight:1.0, description:"Sunil rejected the check from his father as a symbol of bitterness.", created_at:1779141293, source_id:"chunk-5f6e567050111ca1e6e0891a182bd7b3"}}, {start: {_id:82}, end: {_id:1031}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"financial management,reinvestment", truncate:"", weight:1.0, description:"Father reinvested the money Sunil sent home over the years.", created_at:1779141293, source_id:"chunk-5f6e567050111ca1e6e0891a182bd7b3"}}, {start: {_id:82}, end: {_id:1032}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"financial action,secrecy", truncate:"", weight:1.0, description:"Father secretly reinvested Sunil's money without his knowledge.", created_at:1779141293, source_id:"chunk-5f6e567050111ca1e6e0891a182bd7b3"}}, {start: {_id:1026}, end: {_id:1030}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"environment,experience", truncate:"", weight:1.0, description:"Sunil endured unkindness in Mumbai, affecting his well-being.", created_at:1779141293, source_id:"chunk-5f6e567050111ca1e6e0891a182bd7b3"}}, {start: {_id:900}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional separation,state of being", truncate:"", weight:1.0, description:"Sunil realized his state of being was one of disconnection, affecting his relationship with his father.", created_at:1779141293, source_id:"chunk-5f6e567050111ca1e6e0891a182bd7b3"}}, {start: {_id:195}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"family relation,proximity", truncate:"", weight:1.0, description:"Sunil's parents live next door to him.", created_at:1779141293, source_id:"chunk-5f6e567050111ca1e6e0891a182bd7b3"}}, {start: {_id:1026}, end: {_id:1035}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"financial conflict,reconciliation attempt", weight:1.0, description:"Sunil's father offers him a check representing reinvested money, but Sunil refuses it, symbolizing unresolved tensions.", created_at:1779141312, source_id:"chunk-562a8cc0548c2eafa4b1166a020d46a2"}}] AS row
