UNWIND [{start: {_id:788}, end: {_id:6433}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"non-critical memory,selective retention", weight:1.0, description:"The brain was less likely to retain memories of fruit-bearing trees as non-life-threatening.", created_at:1779560715, source_id:"chunk-729a868fcc915b32e3804866576c1ee4"}}, {start: {_id:788}, end: {_id:6434}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"maladaptive response,negativity bias", weight:1.0, description:"The brain's survival mechanisms become detrimental in modern stress-free environments.", created_at:1779560715, source_id:"chunk-729a868fcc915b32e3804866576c1ee4"}}, {start: {_id:6435}, end: {_id:788}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"cognitive loop,mental replay", weight:1.0, description:"The brain perpetuates anxiety through repetitive negative scenario simulations.", created_at:1779560715, source_id:"chunk-729a868fcc915b32e3804866576c1ee4"}}, {start: {_id:6435}, end: {_id:1193}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"health impact,physiological effects", weight:1.0, description:"Anxiety and stress negatively affect physical and mental health.", created_at:1779560715, source_id:"chunk-729a868fcc915b32e3804866576c1ee4"}}, {start: {_id:6435}, end: {_id:738}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"somatic manifestation,stress response", weight:1.0, description:"Stress triggers physical bodily reactions through the brain-body connection.", created_at:1779560716, source_id:"chunk-729a868fcc915b32e3804866576c1ee4"}}, {start: {_id:6436}, end: {_id:6437}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"emotional impact,perceived self-worth", weight:1.0, description:"Negative thoughts about workplace value lead to diminished performance and emotional hurt.", created_at:1779560718, source_id:"chunk-3c35c8046e4068fa71b3df5521e81022"}}, {start: {_id:6436}, end: {_id:4766}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"communication,relational strain", weight:1.0, description:"Unfounded predictions about a partner's lack of appreciation strain interactions through frustration.", created_at:1779560719, source_id:"chunk-3c35c8046e4068fa71b3df5521e81022"}}, {start: {_id:496}, end: {_id:738}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"physical response,stress reaction", weight:1.0, description:"Anxiety triggers the body's alert mechanism, leading to physical tension and harmful responses.", created_at:1779560719, source_id:"chunk-3c35c8046e4068fa71b3df5521e81022"}}, {start: {_id:742}, end: {_id:6439}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"mental regulation,opposition", weight:1.0, description:"Awareness counteracts chaotic imaginations by fostering present-moment focus and reducing amygdala-driven negativity.", created_at:1779561311, source_id:"chunk-2c9bcdcac30e6029287eee4161a0477b"}}, {start: {_id:742}, end: {_id:6427}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"mitigation,neuroplasticity", truncate:"", weight:1.0, description:"Awareness diminishes negative bias by promoting observation over reactive thinking, strengthening prefrontal cortex activity.", created_at:1779561311, source_id:"chunk-2c9bcdcac30e6029287eee4161a0477b"}}, {start: {_id:704}, end: {_id:6438}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"causation,emotional response", weight:1.0, description:"Amygdala activation triggers anxiety, fear, and anger, mitigated through awareness and prefrontal regulation.", created_at:1779561311, source_id:"chunk-2c9bcdcac30e6029287eee4161a0477b"}}, {start: {_id:742}, end: {_id:2483}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"activation,cognitive control", weight:1.0, description:"Awareness strengthens the medial prefrontal cortex, enabling deliberate, non-reactive responses to thoughts.", created_at:1779561312, source_id:"chunk-2c9bcdcac30e6029287eee4161a0477b"}}, {start: {_id:704}, end: {_id:2483}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"neural balance,regulation", truncate:"", weight:1.0, description:"The medial prefrontal cortex modulates amygdala activity during awareness, restoring emotional equilibrium.", created_at:1779561312, source_id:"chunk-2c9bcdcac30e6029287eee4161a0477b"}}, {start: {_id:788}, end: {_id:2175}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"neuroplasticity,structural change", weight:1.0, description:"Meditation rewires the brain by reducing amygdala reactivity and enhancing prefrontal connectivity over time.", created_at:1779561333, source_id:"chunk-2c9bcdcac30e6029287eee4161a0477b"}}, {start: {_id:6426}, end: {_id:1351}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"component,practice", truncate:"", weight:1.0, description:"Loving conversation requires the speaker to operate from a space of great self-awareness.", created_at:1779561333, source_id:"chunk-a35e19231d7bd0423fa3c980dbea5e47"}}, {start: {_id:788}, end: {_id:6427}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"inherent trait,mental aspect", weight:1.0, description:"The brain's negative bias is a natural tendency that can be addressed through practices like meditation.", created_at:1779561335, source_id:"chunk-a35e19231d7bd0423fa3c980dbea5e47"}}, {start: {_id:533}, end: {_id:6426}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"component,emotion", weight:1.0, description:"Loving conversation involves holding others in a space of compassion for their inner stress.", created_at:1779561335, source_id:"chunk-a35e19231d7bd0423fa3c980dbea5e47"}}, {start: {_id:6426}, end: {_id:449}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"impact,outcome", weight:1.0, description:"Loving conversation brings true love into relationships and helps solve actual problems.", created_at:1779561335, source_id:"chunk-a35e19231d7bd0423fa3c980dbea5e47"}}, {start: {_id:788}, end: {_id:6426}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"interaction,mitigation", truncate:"", weight:1.0, description:"Engaging in loving conversation helps mitigate the brain's negative bias and fosters emotional balance.", created_at:1779561336, source_id:"chunk-a35e19231d7bd0423fa3c980dbea5e47"}}, {start: {_id:788}, end: {_id:6440}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"conceptual expansion,redefinition", weight:1.0, description:"The brain is redefined as more than a survival mechanism, emphasizing its capacity for profound consciousness and growth.", created_at:1779561336, source_id:"chunk-a35e19231d7bd0423fa3c980dbea5e47"}}] AS row
