UNWIND [{_id:3356, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"These elements collectively symbolize natural phenomena and existential themes in the text, including transformation and unity with nature.", created_at:1779195405, source_id:"chunk-43459d897215a195e9d66640656ec4e7", entity_id:"Worlds, Trees, Stream, Flower, Become, Bird, Butterfly"}}, {_id:3357, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The colors of the changing seasons experienced a decline in the text.<SEP>The colors of the changing seasons are a concept related to nature.", created_at:1779195405, source_id:"chunk-7e6d82818a6960a49a05c3ce444036ee", entity_id:"Colors of the changing seasons"}}, {_id:3358, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The spirit of our great earth is a concept related to the soul of the earth.", created_at:1779195405, source_id:"chunk-7e6d82818a6960a49a05c3ce444036ee", entity_id:"Spirit of our great earth"}}, {_id:3359, properties:{file_path:"unknown_source", entity_type:"natural_object", truncate:"", description:"Roses are flowers that are mentioned in the text.", created_at:1779195405, source_id:"chunk-7e6d82818a6960a49a05c3ce444036ee", entity_id:"Roses"}}, {_id:3360, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)<SEP>YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"naturalobject", truncate:"", description:"Waters are mentioned as being our blood and tears.<SEP>Waters are depicted as the blood and tears of the earth, representing life and emotional expression in the chant.<SEP>Waters symbolize life, blood, and emotional flow in the poetic context.`<SEP>Waters are described as part of Earth's elements.<SEP>Waters are natural objects equated to human blood and tears.<SEP>Waters symbolize blood and tears in the text, representing life-sustaining and emotional elements.", created_at:1779659866, source_id:"chunk-7e6d82818a6960a49a05c3ce444036ee<SEP>chunk-093dc8f3e4a0df5f961253a49ed85614<SEP>chunk-a1db67931b8b2b2ca86238a361b1b4df<SEP>chunk-d1869a7dd8cd366f77b083e8e452d625<SEP>chunk-492f527e534c0851925d26b6a1dafb40<SEP>chunk-831e414d3c516304d3109f8ff76d5f01<SEP>chunk-a28c71d3080d41b1e18683441ac8c1c6", entity_id:"Waters"}}, {_id:3361, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)<SEP>YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"natural_object", truncate:"", created_at:1779659821, description:"Breeze is a natural phenomenon that flows into us.<SEP>Breeze is a natural phenomenon symbolizing the flow of life and connection to the earth, mentioned in the chant as flowing into humans as breath.<SEP>Breeze represents the movement of air, metaphorically linked to breath and life force.`<SEP>Breeze is mentioned as part of the natural environment.<SEP>Breeze is a natural object connected to Mother Earth via breath.", source_id:"chunk-7e6d82818a6960a49a05c3ce444036ee<SEP>chunk-093dc8f3e4a0df5f961253a49ed85614<SEP>chunk-a1db67931b8b2b2ca86238a361b1b4df<SEP>chunk-d1869a7dd8cd366f77b083e8e452d625<SEP>chunk-831e414d3c516304d3109f8ff76d5f01", entity_id:"Breeze"}}, {_id:3362, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)<SEP>YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"naturalobject", truncate:"", description:"Soil is mentioned as flesh and roots.<SEP>Soil is described as the earth's flesh and boots, symbolizing sustenance and foundation.<SEP>Soil is described as flesh and boots, representing the earth's physicality and sustenance.`<SEP>Soil is referenced as a component of Earth's composition.<SEP>Soil is a natural object equated to human flesh and bones.<SEP>Soil is metaphorically linked to flesh and bones, emphasizing physical and bodily connection to the Earth.", created_at:1779659866, source_id:"chunk-7e6d82818a6960a49a05c3ce444036ee<SEP>chunk-093dc8f3e4a0df5f961253a49ed85614<SEP>chunk-a1db67931b8b2b2ca86238a361b1b4df<SEP>chunk-d1869a7dd8cd366f77b083e8e452d625<SEP>chunk-492f527e534c0851925d26b6a1dafb40<SEP>chunk-831e414d3c516304d3109f8ff76d5f01<SEP>chunk-a28c71d3080d41b1e18683441ac8c1c6", entity_id:"Soil"}}, {_id:3363, properties:{file_path:"unknown_source", entity_type:"natural_object", truncate:"", description:"Fruit is mentioned as part of the earth's offerings.", created_at:1779195405, source_id:"chunk-7e6d82818a6960a49a05c3ce444036ee", entity_id:"Fruit"}}, {_id:3364, properties:{file_path:"unknown_source", entity_type:"natural_object", truncate:"", description:"Grains are mentioned as part of the earth's offerings.", created_at:1779195405, source_id:"chunk-7e6d82818a6960a49a05c3ce444036ee", entity_id:"Grains"}}, {_id:3365, properties:{file_path:"unknown_source", entity_type:"organization", truncate:"", description:"Kings and beggars are mentioned as part of the collective.", created_at:1779195405, source_id:"chunk-7e6d82818a6960a49a05c3ce444036ee", entity_id:"Kings and beggars"}}, {_id:3366, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)<SEP>YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"concept", truncate:"", description:"Friend symbolizes one form of aspirational love (\"a friend\") within the poetic framework of Mother Earth as a universal beloved.<SEP>Friend represents a type of love characterized by companionship and support, as part of the multifaceted nature of love described in the text.", created_at:1779659276, source_id:"chunk-cec92864ceba0183e88b102364109da0<SEP>chunk-b0aa1897202602a9be2a7516d39d5400", entity_id:"Friend"}}, {_id:3367, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"creature", truncate:"", description:"Parrot symbolizes one form of aspirational love mentioned in the poetic imagery.<SEP>Parrot is mentioned as part of the aspirational love forms associated with Mother Earth.`", created_at:1779196410, source_id:"chunk-cec92864ceba0183e88b102364109da0<SEP>chunk-a1db67931b8b2b2ca86238a361b1b4df", entity_id:"Parrot"}}, {_id:3368, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"concept", truncate:"", description:"ther earth is personified as a good soul embodying all forms of love, including friendship, romance, and companionship (parrot). Wait, but the text says \"a friend, a beloved, and a parrot.\" So \"romance\" is inferred from \"beloved,\" but the text doesn't use the word \"romance.\" So the description should be more accurate.<SEP>ther earth is personified as a", created_at:1779195817, source_id:"chunk-9ce9a484e7e568c0c1a5e4c63e0e631c", entity_id:"ther earth"}}, {_id:3369, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"creature", truncate:"", description:"parrot symbolizes companionship or a specific form of love in the metaphorical representation of the earth.", created_at:1779195817, source_id:"chunk-9ce9a484e7e568c0c1a5e4c63e0e631c", entity_id:"parrot"}}, {_id:3370, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"UNKNOWN", truncate:"", description:"ther earth includes the concept of friendship as a form of love.", created_at:1779195818, source_id:"chunk-9ce9a484e7e568c0c1a5e4c63e0e631c", entity_id:"friend"}}, {_id:3371, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"UNKNOWN", truncate:"", description:"ther earth includes the concept of beloved as a form of love.", created_at:1779195818, source_id:"chunk-9ce9a484e7e568c0c1a5e4c63e0e631c", entity_id:"beloved"}}, {_id:3372, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)<SEP>YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)<SEP>unknown_source<SEP>YouTube Video: OnAAtrwsfOc (URL: https://www.youtube.com/watch?v=OnAAtrwsfOc)<SEP>YouTube Video: pPHQMD3w9-s (URL: https://www.youtube.com/watch?v=pPHQMD3w9-s)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", entity_type:"concept", truncate:"", created_at:1779673177, description:"Run-on Sentence is a grammatical structure characterized by the improper joining of multiple independent clauses without appropriate punctuation or conjunctions. This results in an unbroken, complex sentence that can affect readability. In the source text, such a structure may be employed stylistically to convey a poetic flow, and it is sometimes viewed as a stylistic choice within the text. However, it is also recognized as a structural issue in the original text, which is often addressed during editing to improve clarity. The original mantra or text may present this as a single, long sentence lacking proper punctuation, and it is identified in the transcription as phrases that are improperly concatenated.

While some descriptions emphasize its stylistic use, others highlight the need for correction, reflecting a dual perspective. Overall, the run-on sentence is a grammatical phenomenon that can serve both stylistic and problematic functions, requiring careful consideration during editing.<SEP>A run-on sentence is a grammatical error where multiple independent clauses are incorrectly joined without proper punctuation or conjunctions.", source_id:"chunk-0f5e9ea66f1f177a0f68566957d7e46e<SEP>chunk-9cae7143f497353be3068de2f13fe25c<SEP>chunk-41070a47242b017794bd4b01d9403428<SEP>chunk-ff94932b6f3b0d226dc634858c45e539<SEP>chunk-c7379196e71801ae32380230fbd6d871<SEP>chunk-87c7719422a9d8333cc199f60bc9b163<SEP>chunk-4b35201ea3b2c1a816e4f9f7600e1284<SEP>chunk-f56196cf5558ef3761957d9648db2990<SEP>chunk-98921940959422839d1d78085fa664be", entity_id:"Run-on Sentence"}}, {_id:3373, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"method", truncate:"", description:"An editing method involving minimal punctuation addition to improve readability while preserving original wording.", created_at:1779195845, source_id:"chunk-0f5e9ea66f1f177a0f68566957d7e46e", entity_id:"Punctuation Approach"}}, {_id:3374, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"concept", truncate:"", description:"Deities or symbolic representations of Earth and nature, referenced to emphasize the spiritual connection between humanity and the planet.", created_at:1779195845, source_id:"chunk-0f5e9ea66f1f177a0f68566957d7e46e", entity_id:"Tara/Pachamama/Gaia"}}, {_id:3375, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"naturalobject", truncate:"", description:"Black is a color associated with the aquarius flowers.", created_at:1779195920, source_id:"chunk-a99229b983dae13e0ed5b2a0590d3a45", entity_id:"Black"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:3376, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"naturalobject", truncate:"", description:"Yellow is a color associated with the aquarius flowers.", created_at:1779195920, source_id:"chunk-a99229b983dae13e0ed5b2a0590d3a45", entity_id:"Yellow"}}, {_id:3377, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"naturalobject", truncate:"", description:"White is a color associated with the aquarius flowers.", created_at:1779195920, source_id:"chunk-a99229b983dae13e0ed5b2a0590d3a45", entity_id:"White"}}, {_id:3378, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"naturalobject", truncate:"", description:"Brown is a color associated with the aquarius flowers.", created_at:1779195920, source_id:"chunk-a99229b983dae13e0ed5b2a0590d3a45", entity_id:"Brown"}}, {_id:3379, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"concept", truncate:"", description:"Colorful flowers described as falling from trees, symbolizing spiritual or natural elements.<SEP>These flowers symbolize diversity and natural harmony in the text.", created_at:1779196539, source_id:"chunk-42408707c5d0317901f331fccaa3c6ec<SEP>chunk-d1869a7dd8cd366f77b083e8e452d625", entity_id:"Black Yellow White and Brown Aquarius Flowers"}}, {_id:3380, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)<SEP>YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"natural_object", truncate:"", description:"A floral element referenced in the corrected phrase.<SEP>Flowers are part of the natural world depicted in the text.<SEP>Flower symbolizes beauty and growth, mentioned alongside other natural elements.`<SEP>Flower is a natural object mentioned in the text.", created_at:1779659819, source_id:"chunk-42408707c5d0317901f331fccaa3c6ec<SEP>chunk-6c15a75af214595c325b0cdb5584b6a9<SEP>chunk-a1db67931b8b2b2ca86238a361b1b4df<SEP>chunk-831e414d3c516304d3109f8ff76d5f01", entity_id:"Flower"}}, {_id:3381, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"concept", truncate:"", description:"Represents abstract or cosmic realms referenced in the corrected phrase.", created_at:1779195996, source_id:"chunk-42408707c5d0317901f331fccaa3c6ec", entity_id:"Worlds"}}, {_id:3382, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)<SEP>YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"natural_object", truncate:"", description:"A natural water feature mentioned in the corrected textual context.<SEP>Streams are natural features integrated into Mother Earth's imagery.<SEP>Stream represents flowing water, part of the earth's natural systems and metaphorical life force.`<SEP>Stream is a natural object included in the description of Mother Earth.", created_at:1779659819, source_id:"chunk-42408707c5d0317901f331fccaa3c6ec<SEP>chunk-6c15a75af214595c325b0cdb5584b6a9<SEP>chunk-a1db67931b8b2b2ca86238a361b1b4df<SEP>chunk-831e414d3c516304d3109f8ff76d5f01", entity_id:"Stream"}}, {_id:3383, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)<SEP>YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"natural_object", truncate:"", description:"A bird referenced in the corrected phrase.<SEP>Birds are mentioned as elements within Mother Earth's domain.<SEP>Bird is part of the wildlife imagery representing freedom and nature's harmony.`<SEP>Bird is a natural object listed as part of Mother Earth.", created_at:1779659819, source_id:"chunk-42408707c5d0317901f331fccaa3c6ec<SEP>chunk-6c15a75af214595c325b0cdb5584b6a9<SEP>chunk-a1db67931b8b2b2ca86238a361b1b4df<SEP>chunk-831e414d3c516304d3109f8ff76d5f01", entity_id:"Bird"}}, {_id:3384, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)<SEP>YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"naturalobject", truncate:"", created_at:1779659866, description:"Fruit and grains are referred to as radiant skin from Hubble, indicating natural abundance and beauty.<SEP>Fruit and Grains are depicted as radiant skin, symbolizing nourishment and abundance.`<SEP>Fruit and grains are described as radiant skin, highlighting nourishment and beauty derived from the Earth.", source_id:"chunk-093dc8f3e4a0df5f961253a49ed85614<SEP>chunk-a1db67931b8b2b2ca86238a361b1b4df<SEP>chunk-a28c71d3080d41b1e18683441ac8c1c6", entity_id:"Fruit and Grains"}}, {_id:3385, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)<SEP>YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"naturalobject", truncate:"", created_at:1779659337, description:"The colors of the changing seasons are mentioned as part of the earth's spirit, symbolizing natural cycles and beauty.<SEP>Colors of the Changing Seasons symbolize the cyclical beauty and impermanence of natural phenomena.`<SEP>The colors of the changing seasons represent the visual aspect of nature's cycles, listed as a natural element.", source_id:"chunk-093dc8f3e4a0df5f961253a49ed85614<SEP>chunk-a1db67931b8b2b2ca86238a361b1b4df<SEP>chunk-492f527e534c0851925d26b6a1dafb40", entity_id:"Colors of the Changing Seasons"}}, {_id:3386, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"concept", truncate:"", description:"The spirit of the earth is a central theme, unifying all natural elements and deities in the chant.<SEP>Spirit of Our Great Earth encapsulates the unifying consciousness and interconnectedness of all life forms.`", created_at:1779196411, source_id:"chunk-093dc8f3e4a0df5f961253a49ed85614<SEP>chunk-a1db67931b8b2b2ca86238a361b1b4df", entity_id:"Spirit of Our Great Earth"}}, {_id:3387, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"content", truncate:"", description:"The text describes a piece of content that is a chant or spoken word, characterized by a lack of punctuation and run-on sentences.", created_at:1779196063, source_id:"chunk-1f4f1bcfd84ca14411b1cd0d6255f42f", entity_id:"Chant or Spoken Word Piece"}}, {_id:3388, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)<SEP>YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)<SEP>YouTube Video: OnAAtrwsfOc (URL: https://www.youtube.com/watch?v=OnAAtrwsfOc)", entity_type:"concept", truncate:"", created_at:1779441419, description:"The lack of punctuation and run-on nature is identified as a deliberate stylistic choice to preserve the original style.<SEP>A subjective decision regarding writing style, such as comma usage or sentence structure, debated in the context of the quoted text.<SEP>The overarching theme of the text, emphasizing the author's preference for preserving original stylistic elements over imposing corrections.", source_id:"chunk-1f4f1bcfd84ca14411b1cd0d6255f42f<SEP>chunk-29779f717d41c769f251b6af1e672ed3<SEP>chunk-e77f3d9613dd83bbd6d28d639e4b61ba", entity_id:"Stylistic Choice"}}, {_id:3389, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"concept", truncate:"", description:"Style changes involve altering the linguistic structure or tone of text, which conflicts with the requirement to preserve original wording and flow.", created_at:1779196085, source_id:"chunk-6fd6012e05c2767b1ef80ae64dd0e74e", entity_id:"Style Changes"}}, {_id:3390, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"concept", truncate:"", description:"Punctuation for readability involves adding periods to segment text into logical chunks without modifying words or stylistic elements.<SEP>Punctuation for readability is a rule applied to improve text structure without changing words or style.", created_at:1779196150, source_id:"chunk-6fd6012e05c2767b1ef80ae64dd0e74e<SEP>chunk-6b1770434ea3a49d69b7c2d0fa427675", entity_id:"Punctuation for Readability"}}, {_id:3391, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"content", truncate:"", description:"Chunk 1 contains a poetic description of nature and interconnectedness, including phrases like \"the wrongs the trees the stream the flower the be the bird the butterfly the sense of the wild.\"", created_at:1779196085, source_id:"chunk-6fd6012e05c2767b1ef80ae64dd0e74e", entity_id:"Chunk 1"}}, {_id:3392, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"content", truncate:"", description:"Chunk 2 includes symbolic references to deities (\"she is Tara she is Pachamama she is Gaia\") and themes of unity with nature.", created_at:1779196085, source_id:"chunk-6fd6012e05c2767b1ef80ae64dd0e74e", entity_id:"Chunk 2"}}, {_id:3393, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"UNKNOWN", truncate:"", description:"\"DO NOT rewrite the style\" implies strict adherence to preserving original wording and narrative flow.", created_at:1779196116, source_id:"chunk-6fd6012e05c2767b1ef80ae64dd0e74e", entity_id:"Original Wording"}}, {_id:3394, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"concept", truncate:"", description:"The departed clear stuck energy, leading to liberation and dissolution of health problems in the family.<SEP>Stuck energy refers to stagnant or unresolved emotional or spiritual energy that hinders progress.", created_at:1779228977, source_id:"chunk-484efc8f94e4787f4bc0cc8762ad9476<SEP>chunk-7fd3191dae6c1c66321a24ecdfc2f30a", entity_id:"Stuck energy"}}, {_id:3396, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"naturalobject", truncate:"", description:"Radiant Skin metaphorically describes the beauty and vitality of natural produce.`", created_at:1779196412, source_id:"chunk-a1db67931b8b2b2ca86238a361b1b4df", entity_id:"Radiant Skin"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:3397, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"UNKNOWN", truncate:"", description:"Soil is described as flesh and boots, representing the earth's tangible presence.`", created_at:1779196508, source_id:"chunk-a1db67931b8b2b2ca86238a361b1b4df", entity_id:"Flesh and Boots"}}, {_id:3398, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"naturalobject", truncate:"", description:"Flowers are depicted as symbols of nature's beauty and cycles.", created_at:1779196538, source_id:"chunk-d1869a7dd8cd366f77b083e8e452d625", entity_id:"Flowers"}}, {_id:3399, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"concept", truncate:"", description:"Mother Earth is a song that personifies Earth as a nurturing and unifying force, incorporating themes of nature, love, and interconnectedness.", created_at:1779196675, source_id:"chunk-c7e8b27f35d19f89b191e7be54d4f4ed", entity_id:"Mother Earth (Song)"}}, {_id:3400, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=-u6ZDfHdB54)", entity_type:"data", truncate:"", description:"URL is the web address linking to the YouTube video featuring the song \"Mother Earth.\"", created_at:1779196675, source_id:"chunk-c7e8b27f35d19f89b191e7be54d4f4ed", entity_id:"URL (https://www.youtube.com/watch?v=-u6ZDfHdB54)"}}, {_id:3401, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"UNKNOWN", truncate:"", description:"Jewish belief in reincarnation is documented in Gnostic gospel.", created_at:1779228831, source_id:"chunk-8c4fdae5005ad5ebdfceee30c70b21dc", entity_id:"Gnostic gospel"}}, {_id:3402, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"UNKNOWN", truncate:"", description:"Japanese observe Obon, a festival honoring ancestors.", created_at:1779228831, source_id:"chunk-8c4fdae5005ad5ebdfceee30c70b21dc", entity_id:"Japanese"}}, {_id:3403, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"event", truncate:"", created_at:1779229186, description:"Chinese observe Ghost Festival, a day to clean tombs of ancestors.<SEP>Ghost Festival is a traditional East Asian festival commemorating ancestors and honoring spirits of the deceased.<SEP>Ghost Festival is a Chinese tradition involving tomb cleaning and gratitude offerings to ancestors.", source_id:"chunk-8c4fdae5005ad5ebdfceee30c70b21dc<SEP>chunk-7fd3191dae6c1c66321a24ecdfc2f30a<SEP>chunk-dd4f29607e86446996b5a0f4d31130d7", entity_id:"Ghost Festival"}}, {_id:3405, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"concept", truncate:"", description:"Stream of consciousness describes the continuous flow of thoughts and experiences in human perception.<SEP>Stream of Consciousness is a philosophical view of life as an unending flow of experience beyond birth and death.", created_at:1779229214, source_id:"chunk-7909a6563f5b96191ad7c41fa18cd126<SEP>chunk-98219edafe8ffc379bb20679c2f8f076", entity_id:"Stream of Consciousness"}}, {_id:3411, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"UNKNOWN", truncate:"", description:"Ancestors and Ancestral samskaras have a ritual connection, where ancestors participate in ancestral samskaras.", created_at:1779228916, source_id:"chunk-bfc222041dab5af4f8a47b40b1c47cc5", entity_id:"Ancestral samskaras"}}, {_id:3412, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"concept", truncate:"", description:"The ancient people had a philosophy where life after death was considered a fact of existence.", created_at:1779228938, source_id:"chunk-ff31f73b2ef0618c73b0f438087fdec4", entity_id:"Ancient people"}}, {_id:3413, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"concept", truncate:"", description:"Ancient ceremonies were effective due to priests and the philosophy of the ancient people regarding life after death.", created_at:1779228938, source_id:"chunk-ff31f73b2ef0618c73b0f438087fdec4", entity_id:"Ancient ceremonies"}}, {_id:3414, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"method", truncate:"", description:"Releasing the departed is a spiritual practice offered in Ekam circles as a gift.", created_at:1779228938, source_id:"chunk-ff31f73b2ef0618c73b0f438087fdec4", entity_id:"Releasing the departed"}}, {_id:3415, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"method", truncate:"", description:"Releasing the departed is a spiritual practice offered in Ekam Circles as a gift to families.", created_at:1779228938, source_id:"chunk-ff31f73b2ef0618c73b0f438087fdec4", entity_id:"Releasing The Departed"}}, {_id:3416, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"concept", truncate:"", description:"The ancient people had a philosophy where life after death was considered a fact of existence.", created_at:1779228940, source_id:"chunk-ff31f73b2ef0618c73b0f438087fdec4", entity_id:"Ancient People"}}, {_id:3417, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"naturalobject", truncate:"", description:"Tombs are burial places where the remains of the departed rest, often linked to ancestral veneration.", created_at:1779228976, source_id:"chunk-7fd3191dae6c1c66321a24ecdfc2f30a", entity_id:"Tombs"}}, {_id:3421, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"UNKNOWN", truncate:"", description:"Mahaprasthana signifies the process of death as a transition to the afterlife.", created_at:1779228978, source_id:"chunk-7fd3191dae6c1c66321a24ecdfc2f30a", entity_id:"death"}}, {_id:3422, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"UNKNOWN", truncate:"", description:"Mahal-e-amavasya is a term associated with lunar eclipses, holding spiritual and cultural significance.", created_at:1779228978, source_id:"chunk-7fd3191dae6c1c66321a24ecdfc2f30a", entity_id:"lunar eclipse"}}, {_id:3423, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"UNKNOWN", truncate:"", description:"Ekam mitras are companions who undertake a spiritual journey together, supporting mutual growth.", created_at:1779228978, source_id:"chunk-7fd3191dae6c1c66321a24ecdfc2f30a", entity_id:"spiritual journey"}}, {_id:3424, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"UNKNOWN", truncate:"", description:"Tombs serve as physical repositories for the departed, maintaining their presence in the material world.", created_at:1779228978, source_id:"chunk-7fd3191dae6c1c66321a24ecdfc2f30a", entity_id:"departed"}}, {_id:3425, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"person", truncate:"", description:"Emperor Constantine is a historical figure associated with the Roman Empire and the period before which ancient cultures existed.", created_at:1779229062, source_id:"chunk-5a061c3e192c4aaa5026aa79274bb0f1", entity_id:"Emperor Constantine"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:3428, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"concept", truncate:"", description:"Destructive vasanas are negative tendencies that ancient cultures aimed to dissolve through rituals.", created_at:1779229112, source_id:"chunk-7ac9109abdb5bdc9de2685e960e358c1", entity_id:"Destructive Vasanas"}}, {_id:3430, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"concept", truncate:"", description:"The experience involves instant liberation and emotional release when the departed move into the light in a state of peace, leading to the dissolution of health problems and stuck energy.", created_at:1779229186, source_id:"chunk-dd4f29607e86446996b5a0f4d31130d7", entity_id:"Experience of Releasing the Departed"}}, {_id:3431, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"concept", truncate:"", description:"Universal Consciousness or Brahman represents the ultimate state of blissfulness and unity in the afterlife.", created_at:1779229187, source_id:"chunk-dd4f29607e86446996b5a0f4d31130d7", entity_id:"Universal Consciousness or Brahman"}}, {_id:3432, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"concept", truncate:"", description:"Departed ancestors are revered in various cultures as entities that influence the living, requiring rituals for their peaceful transition.", created_at:1779229187, source_id:"chunk-dd4f29607e86446996b5a0f4d31130d7", entity_id:"Departed Ancestors"}}, {_id:3433, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"concept", truncate:"", description:"Stuck energy refers to restless or trapped energy associated with unresolved emotions or suffering of the departed, cleared through rituals.", created_at:1779229187, source_id:"chunk-dd4f29607e86446996b5a0f4d31130d7", entity_id:"Stuck Energy"}}, {_id:3434, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"concept", truncate:"", description:"Health problems in families are believed to dissolve when the departed move into the light, symbolizing the release of stuck energy.", created_at:1779229187, source_id:"chunk-dd4f29607e86446996b5a0f4d31130d7", entity_id:"Health Problems"}}, {_id:3435, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"UNKNOWN", truncate:"", description:"The experience involves liberation and emotional release when the departed transition peacefully, dissolving obstacles and health issues.", created_at:1779229187, source_id:"chunk-dd4f29607e86446996b5a0f4d31130d7", entity_id:"Liberation and Emotional Release"}}, {_id:3436, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"UNKNOWN", truncate:"", description:"Rituals like Obon and Chisok clear stuck energy associated with the departed.", created_at:1779229188, source_id:"chunk-dd4f29607e86446996b5a0f4d31130d7", entity_id:"Rituals"}}, {_id:3437, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"concept", truncate:"", description:"Jewish Tradition included beliefs in reincarnation as per Gnostic gospel and Dead Sea Scrolls.", created_at:1779229213, source_id:"chunk-98219edafe8ffc379bb20679c2f8f076", entity_id:"Jewish Tradition"}}, {_id:3438, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"event", truncate:"", description:"New Moon Day is observed to honor ancestors and release departed souls believed to be trapped in the earthly plane.", created_at:1779229213, source_id:"chunk-98219edafe8ffc379bb20679c2f8f076", entity_id:"New Moon Day"}}, {_id:3439, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)<SEP>YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", entity_type:"fearlessness", truncate:"", description:"Fearlessness about death is achieved through living fully without regret or reservations.<SEP>Successful leaders are fearless.<SEP>Successful leaders are fearless.", created_at:1779560221, source_id:"chunk-98219edafe8ffc379bb20679c2f8f076<SEP>chunk-79db2134238652230b07da08d8f6f290<SEP>chunk-8fe41869f1b0fa2b6e988f652c7091c5", entity_id:"Fearlessness"}}, {_id:3440, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"UNKNOWN", truncate:"", description:"Love for the \"end of the day\" symbolizes acceptance of life's impermanence and death's inevitability.", created_at:1779229239, source_id:"chunk-98219edafe8ffc379bb20679c2f8f076", entity_id:"End of the Day"}}, {_id:3441, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Corrected phrase removing unnecessary adjective for thematic coherence.", created_at:1779229930, source_id:"chunk-08f4904e8e77b13454b5704d698bedbc", entity_id:"states of joy, connection or peace"}}, {_id:3442, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Erroneous sentence with subject-verb agreement mismatch (\"arises\" vs plural subject).", created_at:1779229930, source_id:"chunk-08f4904e8e77b13454b5704d698bedbc", entity_id:"Faith, love and compassion arises in you"}}, {_id:3443, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Corrected version removing \"no\", though redundant, directly addressing transcription error.", created_at:1779229930, source_id:"chunk-08f4904e8e77b13454b5704d698bedbc", entity_id:"a suffering state or a suffering state"}}, {_id:3444, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Corrected sentence with proper singular noun matching subject.", created_at:1779229930, source_id:"chunk-08f4904e8e77b13454b5704d698bedbc", entity_id:"You are a kangaroo"}}, {_id:3445, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Corrected sentence with proper plural verb agreement for subject consistency.", created_at:1779229930, source_id:"chunk-08f4904e8e77b13454b5704d698bedbc", entity_id:"Faith, love and compassion arise in you"}}, {_id:3446, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Erroneous sentence with incorrect plural noun form conflicting with subject number.", created_at:1779229930, source_id:"chunk-08f4904e8e77b13454b5704d698bedbc", entity_id:"You are a kangaroos"}}, {_id:3447, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Erroneous phrase with misplaced adjective \"beautiful\" disrupting conceptual consistency.", created_at:1779229930, source_id:"chunk-08f4904e8e77b13454b5704d698bedbc", entity_id:"beautiful states of joy, connection or peace"}}, {_id:3448, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Erroneous phrase containing extraneous \"no\", creating grammatical redundancy and unclear meaning.", created_at:1779229930, source_id:"chunk-08f4904e8e77b13454b5704d698bedbc", entity_id:"a no suffering state"}}] AS row
