UNWIND [{start: {_id:7685}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"conceptual framework,source", weight:1.0, description:"The video hosts discussions around these concepts, though their exact context remains unspecified.", created_at:1779671847, source_id:"chunk-331ce489e777434104c9abde748a4203"}}, {start: {_id:2373}, end: {_id:2364}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"cognitive,repetition,statistical,statistical prevalence", weight:2.0, description:"Repetitive thoughts are a subset of total thoughts, defined by their recurring nature.<SEP>The average number of thoughts per day is statistically linked to repetitive thinking.", created_at:1779672444, source_id:"chunk-331ce489e777434104c9abde748a4203<SEP>chunk-9174f4aac6278b492855cabdc7a615b1"}}, {start: {_id:7684}, end: {_id:2373}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"proportion,statistical prevalence", weight:1.0, description:"The percentage reflects the dominance of repetitive thoughts among daily thoughts.", created_at:1779671847, source_id:"chunk-331ce489e777434104c9abde748a4203"}}, {start: {_id:7683}, end: {_id:2364}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"daily average,quantification", weight:1.0, description:"The numerical range directly quantifies the daily average of thoughts.", created_at:1779671847, source_id:"chunk-331ce489e777434104c9abde748a4203"}}, {start: {_id:7692}, end: {_id:7689}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"alternative terms,context,correction,replacement", weight:2.0, description:"Debris is replaced by baggage in the context of thoughts to better convey the idea of a burden.<SEP>Debris is replaced by \"baggage\" as another option for expressing thoughts metaphorically.", created_at:1779671942, source_id:"chunk-7d201146e40d123c544e6caf9225da91<SEP>chunk-c47a850c80a21ed6c67cbed2bc4b8ec0"}}, {start: {_id:7691}, end: {_id:7690}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"emotional state", weight:1.0, description:"The state of being scared is one of the negative emotions resulting from the 70 percent.", created_at:1779671870, source_id:"chunk-7d201146e40d123c544e6caf9225da91"}}, {start: {_id:511}, end: {_id:7691}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"emotional state", weight:1.0, description:"The state of being angry is one of the negative emotions resulting from the 70 percent.", created_at:1779671871, source_id:"chunk-7d201146e40d123c544e6caf9225da91"}}, {start: {_id:7689}, end: {_id:7693}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"alternative terms,context,correction,replacement", weight:2.0, description:"Debris is replaced by load in the context of thoughts to better convey the idea of a quantity.<SEP>Debris is replaced by \"load\" in the context of describing thoughts metaphorically.", created_at:1779671942, source_id:"chunk-7d201146e40d123c544e6caf9225da91<SEP>chunk-c47a850c80a21ed6c67cbed2bc4b8ec0"}}, {start: {_id:951}, end: {_id:7691}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"emotional state", weight:1.0, description:"The state of being hurt is one of the negative emotions resulting from the 70 percent.", created_at:1779671871, source_id:"chunk-7d201146e40d123c544e6caf9225da91"}}, {start: {_id:7691}, end: {_id:7687}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"thought pattern", weight:1.0, description:"The repetitive nature of thoughts is linked to the negative emotional state.", created_at:1779671871, source_id:"chunk-7d201146e40d123c544e6caf9225da91"}}, {start: {_id:1707}, end: {_id:7697}, properties:{file_path:"unknown_source", keywords:"observation,understanding", truncate:"", weight:1.0, description:"The ancients in India observed the life cycle and agricultural processes, understanding cause and effect.", created_at:1779671904, source_id:"chunk-295ff82e6931c82451b6f00c8154605e"}}, {start: {_id:7696}, end: {_id:7699}, properties:{file_path:"unknown_source", keywords:"agricultural cycle,cause and effect", truncate:"", weight:1.0, description:"Planting a mango tree leads to future fruit production, illustrating the agricultural cycle.", created_at:1779671904, source_id:"chunk-295ff82e6931c82451b6f00c8154605e"}}, {start: {_id:7700}, end: {_id:7698}, properties:{file_path:"unknown_source", keywords:"example,natural phenomenon", truncate:"", weight:1.0, description:"The apple falling demonstrates the law of gravity in action, used as an analogy for karma.", created_at:1779671904, source_id:"chunk-295ff82e6931c82451b6f00c8154605e"}}, {start: {_id:7680}, end: {_id:116}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", keywords:"metaphorical,signaling", truncate:"", weight:1.0, description:"Negative State is linked to signaling the universe through thoughts and emotional states.", created_at:1779671942, source_id:"chunk-c47a850c80a21ed6c67cbed2bc4b8ec0"}}, {start: {_id:155}, end: {_id:4973}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", keywords:"linguistic,resolution", truncate:"", weight:1.0, description:"Solution is framed as addressing a \"real problem\" requiring grammatical correction.", created_at:1779671942, source_id:"chunk-c47a850c80a21ed6c67cbed2bc4b8ec0"}}, {start: {_id:7699}, end: {_id:7704}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Ji-hdW1t30g)", keywords:"example,negative outcome", truncate:"", weight:1.0, description:"A mango tree producing toxic fruit illustrates Karma's principle of consequences mirroring actions.", created_at:1779671952, source_id:"chunk-ed6b93b857d66f4aba7388c8d2b20ca9"}}, {start: {_id:7702}, end: {_id:7703}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Ji-hdW1t30g)", truncate:"", keywords:"growth,production", weight:1.0, description:"Planting a mango sapling leads to the production of mangoes, illustrating Karma's cause-and-effect principle.", created_at:1779671952, source_id:"chunk-ed6b93b857d66f4aba7388c8d2b20ca9"}}, {start: {_id:7704}, end: {_id:7705}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Ji-hdW1t30g)", keywords:"example,negative outcome", truncate:"", weight:1.0, description:"Toxic fruit leads to toxic trees, reinforcing the cyclical nature of Karma's law.", created_at:1779671952, source_id:"chunk-ed6b93b857d66f4aba7388c8d2b20ca9"}}, {start: {_id:7702}, end: {_id:1888}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Ji-hdW1t30g)", truncate:"", keywords:"growth,production", weight:1.0, description:"Planting a mango sapling results in mango trees, demonstrating cyclical natural outcomes.", created_at:1779671952, source_id:"chunk-ed6b93b857d66f4aba7388c8d2b20ca9"}}, {start: {_id:348}, end: {_id:7706}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"content analysis,language correction", weight:1.0, description:"The YouTube video discusses grammatical corrections and their application in the context of a spiritual vision.", created_at:1779672011, source_id:"chunk-7975f5d7f00031d3544c8f0ea4e7d340"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
