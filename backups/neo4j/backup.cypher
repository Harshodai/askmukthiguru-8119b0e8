UNWIND [{start: {_id:3157}, end: {_id:3158}, properties:{file_path:"unknown_source", keywords:"authority,hold over", truncate:"", weight:1.0, description:"The community of Ekam mitras holds over the Ekams circles.", created_at:1779228590, source_id:"chunk-3e049881ccf8fc860b28166decc1a1b4"}}, {start: {_id:3166}, end: {_id:3180}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"community structure,holding,spiritual practice", weight:2.0, description:"Ekam Circles are groups of Ekam Mitras (community members) who collectively engage in spiritual rituals and processes.<SEP>The community of Ekam mitras holds the Ekam Circles where spiritual gifts are offered.", created_at:1779228940, source_id:"chunk-6995806c11a29b44fc7094ee22938f78<SEP>chunk-ff31f73b2ef0618c73b0f438087fdec4"}}, {start: {_id:2023}, end: {_id:3184}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"conceptual link,existential journey,journey metaphor,philosophical concept,philosophical interpretation,philosophical significance", weight:3.0, created_at:1779229239, description:"Mahaprasthana is directly tied to the concept of death, symbolizing its philosophical and existential implications.<SEP>Mahaprasthana redefines death as the start of a profound spiritual journey.<SEP>Mahaprasthana refers to the \"great journey\" of death, symbolizing the transition to the afterlife.", source_id:"chunk-5a19acf43a2f6c0f94ca9b0cb0573ad6<SEP>chunk-dd4f29607e86446996b5a0f4d31130d7<SEP>chunk-98219edafe8ffc379bb20679c2f8f076"}}, {start: {_id:3204}, end: {_id:3178}, properties:{file_path:"unknown_source", truncate:"", keywords:"festival name correction,misheard words", weight:1.0, description:"\"Born\" was corrected to \"Obon\" as the accurate name for the Japanese ancestral festival.", created_at:1779228590, source_id:"chunk-6995806c11a29b44fc7094ee22938f78"}}, {start: {_id:2023}, end: {_id:3206}, properties:{file_path:"unknown_source", truncate:"", keywords:"life approach,philosophical necessity", weight:1.0, description:"Living life fully without regret is presented as essential to being fearless about death.", created_at:1779228590, source_id:"chunk-5a19acf43a2f6c0f94ca9b0cb0573ad6"}}, {start: {_id:2023}, end: {_id:3207}, properties:{file_path:"unknown_source", truncate:"", keywords:"emotional state,philosophical necessity", weight:1.0, description:"Loving completely without reserve is described as necessary to embrace death when it arrives.", created_at:1779228591, source_id:"chunk-5a19acf43a2f6c0f94ca9b0cb0573ad6"}}, {start: {_id:3208}, end: {_id:3228}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"afterlife,afterlife concept,cultural belief,religious belief", weight:4.0, description:"Egyptian civilization believed in life after death as part of their spiritual framework.<SEP>Egyptian civilization believed in life after death as part of their religious doctrine.<SEP>Egyptian civilization believed in life after death, influencing their spiritual practices.<SEP>Egyptian Civilization believed in life after death as part of their religious traditions.", created_at:1779229238, source_id:"chunk-fff4055f00cd2414c407b066c68e8d55<SEP>chunk-5a061c3e192c4aaa5026aa79274bb0f1<SEP>chunk-dd4f29607e86446996b5a0f4d31130d7<SEP>chunk-98219edafe8ffc379bb20679c2f8f076"}}, {start: {_id:3227}, end: {_id:3240}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"Gnostic influence,religious belief,religious doctrine,scripture,spiritual belief,spiritual concepts", weight:3.0, created_at:1779229139, description:"Jews adopted reincarnation beliefs through Gnostic gospel and Dead Sea Scrolls.<SEP>Jewish beliefs in reincarnation are supported by the Dead Sea Scrolls and Gnostic gospel.<SEP>Jews believed in reincarnation according to Gnostic gospel and the Dead Sea Scrolls.", source_id:"chunk-fff4055f00cd2414c407b066c68e8d55<SEP>chunk-5a061c3e192c4aaa5026aa79274bb0f1<SEP>chunk-7ac9109abdb5bdc9de2685e960e358c1"}}, {start: {_id:3234}, end: {_id:3230}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"karmic bonds,spiritual interconnectedness", weight:1.0, description:"Shared consciousness enhances the significance of human relationships through perceived shared journeys.", created_at:1779228729, source_id:"chunk-fff4055f00cd2414c407b066c68e8d55"}}, {start: {_id:3169}, end: {_id:3241}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"ancestor veneration,ancestral reverence,cultural practice", weight:2.0, description:"Koreans observe Chisok to honor their ancestors.<SEP>Koreans observe Chisok, a festival honoring ancestors.", created_at:1779228832, source_id:"chunk-fff4055f00cd2414c407b066c68e8d55<SEP>chunk-8c4fdae5005ad5ebdfceee30c70b21dc"}}, {start: {_id:2023}, end: {_id:3258}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"life cycle,philosophical concept", weight:1.0, description:"Death is framed as a transition between life phases rather than an endpoint.", created_at:1779228730, source_id:"chunk-fff4055f00cd2414c407b066c68e8d55"}}, {start: {_id:1839}, end: {_id:3168}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"ancestral rituals,cultural practice", weight:1.0, description:"Chinese observe Kinmen to clean ancestral tombs and offer gratitude.", created_at:1779228730, source_id:"chunk-fff4055f00cd2414c407b066c68e8d55"}}, {start: {_id:3241}, end: {_id:3167}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"cultural practice,spiritual transition", weight:1.0, description:"Koreans observe Mahale Amavasya to honor ancestors and release departed souls.", created_at:1779228730, source_id:"chunk-fff4055f00cd2414c407b066c68e8d55"}}, {start: {_id:3287}, end: {_id:3278}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"generational impact,ritual resolution", weight:1.0, description:"Ancient ceremonies aimed to dissolve destructive vasanas passed through generations.", created_at:1779228760, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281"}}, {start: {_id:3274}, end: {_id:3280}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"ancestor appeasement,ancestral transition,ritual,ritual observance,ritual purpose,spiritual appeasement,spiritual practices,spiritual release", weight:4.0, description:"Mahal-e-amavasya is dedicated to helping ancestors in unhappy conditions transition to peace.<SEP>Mahal-e-amavasya is a day dedicated to appeasing the spirits of ancestors who may have passed away in unhappy conditions or undesirable conditions.<SEP>Mahal-e-amavasya is observed to honor ancestors and release departed souls in Korean culture.<SEP>Mahal-e-amavasya is dedicated to appeasing ancestors who died in unhappy conditions.", created_at:1779229139, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281<SEP>chunk-bfc222041dab5af4f8a47b40b1c47cc5<SEP>chunk-5a061c3e192c4aaa5026aa79274bb0f1<SEP>chunk-7ac9109abdb5bdc9de2685e960e358c1"}}, {start: {_id:3273}, end: {_id:3331}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"experiential necessity,experiential truth,modern validation,truth validation", weight:2.0, description:"Spiritual experience is required to validate spiritual realities in contemporary times.<SEP>Spiritual realities require direct spiritual experience for modern validation.", created_at:1779228760, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281"}}, {start: {_id:3288}, end: {_id:3228}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"existential belief,philosophical framework", weight:1.0, description:"Ancient philosophy framed life after death as a factual continuation of existence.", created_at:1779228760, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281"}}, {start: {_id:3332}, end: {_id:3285}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"ancestral connection,ritual practice", weight:1.0, description:"Ancient Hindus performed ancestral samskaras to dissolve generational vasanas.", created_at:1779228761, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281"}}, {start: {_id:3259}, end: {_id:3333}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"consciousness continuity,emotional legacy", weight:1.0, description:"Life experiences determine the emotional state of consciousness in the afterlife.", created_at:1779228761, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281"}}, {start: {_id:3274}, end: {_id:3260}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"ancestral reconciliation,cultural practice", weight:1.0, description:"Ancient cultures reconnected with ancestors to address unresolved vasanas.", created_at:1779228761, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281"}}] AS row
