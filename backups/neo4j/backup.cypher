UNWIND [{_id:6012, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", entity_type:"concept", truncate:"", description:"The body of a child is noted as non-existent in the present, highlighting impermanence.", created_at:1779554093, source_id:"chunk-b45f3a725ee597bc7f79c1f42e7fee1d", entity_id:"Child body"}}, {_id:6013, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", entity_type:"concept", truncate:"", description:"The body of a young person is observed to change and not persist over time.", created_at:1779554093, source_id:"chunk-b45f3a725ee597bc7f79c1f42e7fee1d", entity_id:"Young person body"}}, {_id:6014, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", entity_type:"concept", truncate:"", description:"The body of a middle-aged person is described as transient and subject to decay.", created_at:1779554094, source_id:"chunk-b45f3a725ee597bc7f79c1f42e7fee1d", entity_id:"Middle-aged person body"}}, {_id:6015, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", entity_type:"concept", truncate:"", description:"The aged body is noted as bound to decay, emphasizing impermanence.", created_at:1779554094, source_id:"chunk-b45f3a725ee597bc7f79c1f42e7fee1d", entity_id:"Aged person body"}}, {_id:6017, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", entity_type:"UNKNOWN", truncate:"", description:"ung people and adults prioritize making money over skill development, learning, or correct decisions.", created_at:1779554094, source_id:"chunk-b45f3a725ee597bc7f79c1f42e7fee1d", entity_id:"money-making"}}, {_id:6018, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", entity_type:"UNKNOWN", truncate:"", description:"Sharira is inherently dissolving and changing, symbolizing the body's temporary nature.", created_at:1779554117, source_id:"chunk-6d556ad8b74e04409555169154f3886c", entity_id:"Dissolution"}}, {_id:6019, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", entity_type:"concept", truncate:"", description:"Observing consciousness is the consciousness that observes everything and is unchanging, synonymous with the unitary field of consciousness.", created_at:1779554125, source_id:"chunk-182703a5f6b3f0b44169765435446675", entity_id:"Observing consciousness"}}, {_id:6020, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", entity_type:"concept", truncate:"", description:"Ananda Sat is a concept representing pure, unchanging existence, synonymous with the unitary field of consciousness and described as \"Ananda\" or \"Bliss.\"", created_at:1779554125, source_id:"chunk-182703a5f6b3f0b44169765435446675", entity_id:"Ananda Sat"}}, {_id:6021, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", entity_type:"concept", truncate:"", description:"Unitary field of consciousness is a concept representing a single, unitary existence that is intelligent and sentient, existing in all creation.", created_at:1779554125, source_id:"chunk-182703a5f6b3f0b44169765435446675", entity_id:"Unitary field of consciousness"}}, {_id:6022, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", entity_type:"concept", truncate:"", description:"Sentient intelligence is the intelligent and sentient aspect of the unitary field of consciousness that exists in all creation.", created_at:1779554125, source_id:"chunk-182703a5f6b3f0b44169765435446675", entity_id:"Sentient intelligence"}}, {_id:6024, properties:{file_path:"unknown_source<SEP>YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", created_at:1779563366, description:"An enlightened mind refers to a state of mental clarity and heightened awareness associated with advanced cognitive and emotional balance.<SEP>An enlightened mind refers to a state of mental clarity and heightened awareness associated with advanced cognitive and emotional balance.<SEP>An enlightened mind is characterized by clarity, emotional presence, and the ability to overcome mental stress and life challenges.<SEP>An enlightened mind represents the culmination of spiritual evolution, marked by unity, dissolution of divisions, and conscious, joyful actions rooted in love and satisfaction.", source_id:"chunk-7ae937704ca1201df5ce3ccc8999552d<SEP>chunk-18859e4480224ac68f76cca24a1ad2ca<SEP>chunk-b49cabb6cbf6a92062b2c4decee8543b", entity_id:"Enlightened Mind"}}, {_id:6025, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Beta brainwave state (13-40 cycles/second) corresponds to an agitated, stressed mental state with impaired concentration and focus.<SEP>Beta brainwave state (13-40 cycles/second) corresponds to an agitated, stressed mental state with impaired concentration and focus.", created_at:1779554221, source_id:"chunk-7ae937704ca1201df5ce3ccc8999552d", entity_id:"Beta Brainwave State"}}, {_id:6026, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Theta brainwave state (4-7 cycles/second) facilitates intuition and connection to universal intelligence, as demonstrated by Archimedes' discovery.<SEP>Theta brainwave state (4-7 cycles/second) facilitates intuition and connection to universal intelligence, as demonstrated by Archimedes' discovery.", created_at:1779554222, source_id:"chunk-7ae937704ca1201df5ce3ccc8999552d", entity_id:"Theta Brainwave State"}}, {_id:6027, properties:{file_path:"unknown_source<SEP>YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)<SEP>YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", entity_type:"person", truncate:"", created_at:1779559889, description:"Shri Krishna Ji is a spiritual leader and co-creator of Akam, promoting enlightenment and neurobiological understanding of the mind.<SEP>Shri Krishna Ji is a spiritual leader and co-creator of Akam, promoting enlightenment and neurobiological understanding of the mind.<SEP>Shri Krishna Ji is a co-creator of Akam and a spiritual leader focused on enlightenment and mental stress conquest.<SEP>Shri Krishna ji is the co-creator of Akam and emphasizes creating enlightened individuals and eco-friendly abundance.<SEP>Shri Krishna ji is associated with the creation of Akam as a center for enlightenment.<SEP>Shri Krishna ji is a spiritual figure referenced in the context of creating Akam as a center for enlightenment.", source_id:"chunk-7ae937704ca1201df5ce3ccc8999552d<SEP>chunk-18859e4480224ac68f76cca24a1ad2ca<SEP>chunk-6390a02d03fdb4770463600e69448a2a<SEP>chunk-ff3e80d959eda2affcf9fb1d2dff2880<SEP>chunk-7dca0f22171b9785fbbab01b79ee3fa3", entity_id:"Shri Krishna Ji"}}, {_id:6029, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Gamma brainwave state (>80 cycles/second) enables enlightenment, unity, and extraordinary problem-solving through heightened neural synchronization.<SEP>Gamma brainwave state (>80 cycles/second) enables enlightenment, unity, and extraordinary problem-solving through heightened neural synchronization.", created_at:1779554222, source_id:"chunk-7ae937704ca1201df5ce3ccc8999552d", entity_id:"Gamma Brainwave State"}}, {_id:6030, properties:{file_path:"unknown_source<SEP>YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"An unenlightened mind is characterized by distraction, agitation, and lack of focus, often leading to stress and poor decision-making.<SEP>An unenlightened mind is characterized by distraction, agitation, and lack of focus, often leading to stress and poor decision-making.<SEP>An unenlightened mind is marked by confusion, disconnection, and negative emotional patterns like loneliness and addiction.", created_at:1779554345, source_id:"chunk-7ae937704ca1201df5ce3ccc8999552d<SEP>chunk-18859e4480224ac68f76cca24a1ad2ca", entity_id:"Unenlightened Mind"}}, {_id:6031, properties:{file_path:"unknown_source<SEP>YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", created_at:1779555080, description:"Gamma is a high-frequency brain state associated with enlightened living, miraculous healings, and Buddha-like inner states, enabling clarity and extraordinary responses to challenges.<SEP>Gamma is a high-frequency brain state associated with enlightened living, miraculous healings, and Buddha-like inner states, enabling clarity and extraordinary responses to challenges.<SEP>Gamma state is a recently discovered brain wave state by scientists, associated with high-level cognitive processing.<SEP>Gamma State is a high-frequency brain wave state associated with heightened consciousness, enlightenment, and cognitive processing.", source_id:"chunk-81a80670e6aa7bf176b0cacf73a6f715<SEP>chunk-89dc7d961c53a5116215f981f7e729a5<SEP>chunk-4dd42d1c4c17856886839529f0694f39", entity_id:"Gamma State"}}, {_id:6032, properties:{file_path:"unknown_source<SEP>YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"method", truncate:"", created_at:1779555100, description:"Mystic technology developed by Akam enables transition between brain states during daily activities like walking and working, promoting enlightened living.<SEP>Mystic technology developed by Akam enables transition between brain states during daily activities like walking and working, promoting enlightened living.<SEP>Mystic Technology is a neurotechnological framework developed to transition individuals between brain states (beta to Gamma/Nirvikalpa) during daily activities.<SEP>Mystic Technology is a proprietary method designed to facilitate transitions between brain states (including Gamma) through daily activities like walking or working.", source_id:"chunk-81a80670e6aa7bf176b0cacf73a6f715<SEP>chunk-4dd42d1c4c17856886839529f0694f39<SEP>chunk-921bac8d531822a1c218a0ec38fab591", entity_id:"Mystic Technology"}}, {_id:6033, properties:{file_path:"unknown_source<SEP>YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"organization", truncate:"", description:"Adventist Sports Gear Company is a prestigious company facing financial challenges under the leadership of a CEO.<SEP>Adventist Sports Gear Company is a prestigious sports gear company facing financial difficulties and requiring a turnaround strategy.`<SEP>Adventist Sports Gear Company is a prestigious company facing financial challenges under the leadership of a CEO.<SEP>Adventist Sports Gear Company is a prestigious sports gear company facing financial difficulties and requiring a turnaround strategy.`<SEP>Adventist Sports Gear Company is a sports gear company facing financial challenges and leadership decisions.", created_at:1779555367, source_id:"chunk-81a80670e6aa7bf176b0cacf73a6f715<SEP>chunk-d62b0a2e608fc2a0128294d9e544e3ca<SEP>chunk-6c59f41034b90b3918c1775bcca9c910", entity_id:"Adventist Sports Gear Company"}}, {_id:6034, properties:{file_path:"unknown_source", entity_type:"event", truncate:"", description:"Hard board meeting where the CEO received disturbances and challenges after taking over the company.<SEP>Hard board meeting where the CEO received disturbances and challenges after taking over the company.", created_at:1779554221, source_id:"chunk-81a80670e6aa7bf176b0cacf73a6f715", entity_id:"Board Meeting"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6035, properties:{file_path:"unknown_source<SEP>YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"event", truncate:"", description:"Acum Retreat is a location where the CEO and his wife attended a retreat that influenced his decision-making perspective.`<SEP>Acum Retreat is a location where the CEO and his wife attended a retreat that influenced his decision-making perspective.`<SEP>Acum Retreat is an event attended by the CEO and his wife, leading to discussions on state and decision-making.", created_at:1779555367, source_id:"chunk-d62b0a2e608fc2a0128294d9e544e3ca<SEP>chunk-6c59f41034b90b3918c1775bcca9c910", entity_id:"Acum Retreat"}}, {_id:6036, properties:{file_path:"unknown_source<SEP>YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"creature", truncate:"", description:"Chimpanzees respond to uncertainty with aggression due to testosterone release, contrasting with bonobos.`<SEP>Chimpanzees respond to uncertainty with aggression due to testosterone release, contrasting with bonobos.`<SEP>A primate that responds to uncertainty with aggression, releasing testosterone.", created_at:1779555433, source_id:"chunk-d62b0a2e608fc2a0128294d9e544e3ca<SEP>chunk-0f9934def7b71a5f1166df0b2b2d22fb", entity_id:"Chimpanzee"}}, {_id:6037, properties:{file_path:"unknown_source", entity_type:"creature", truncate:"", description:"Bonobos respond to uncertainty with fear and anxiety due to cortisone release, contrasting with chimpanzees.`<SEP>Bonobos respond to uncertainty with fear and anxiety due to cortisone release, contrasting with chimpanzees.`", created_at:1779554220, source_id:"chunk-d62b0a2e608fc2a0128294d9e544e3ca", entity_id:"Bonobo Monkey"}}, {_id:6038, properties:{file_path:"unknown_source", entity_type:"event", truncate:"", description:"The market turned around due to increased demand, enabling the company to grow after retaining employees.`<SEP>The market turned around due to increased demand, enabling the company to grow after retaining employees.`", created_at:1779554220, source_id:"chunk-d62b0a2e608fc2a0128294d9e544e3ca", entity_id:"Market Turnaround"}}, {_id:6039, properties:{file_path:"unknown_source", entity_type:"event", truncate:"", description:"The company achieved 20% growth and reached $600 million in value after retaining employees and improving efficiency.`<SEP>The company achieved 20% growth and reached $600 million in value after retaining employees and improving efficiency.`", created_at:1779554220, source_id:"chunk-d62b0a2e608fc2a0128294d9e544e3ca", entity_id:"Company Growth"}}, {_id:6040, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"person", truncate:"", description:"Shri Krishna Ji's Wife co-created Akam with Shri Krishna Ji and collaborates in spiritual guidance.", created_at:1779554345, source_id:"chunk-18859e4480224ac68f76cca24a1ad2ca", entity_id:"Shri Krishna Ji's Wife"}}, {_id:6041, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"Challenges of life include obstacles like relationship conflicts and existential dissatisfaction, mitigated by enlightenment.", created_at:1779554345, source_id:"chunk-18859e4480224ac68f76cca24a1ad2ca", entity_id:"Challenges of Life"}}, {_id:6042, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"Mental stress refers to psychological strain caused by life challenges, addressed through enlightened mind practices.", created_at:1779554345, source_id:"chunk-18859e4480224ac68f76cca24a1ad2ca", entity_id:"Mental Stress"}}, {_id:6043, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"An anxiety-free entrepreneur embodies calmness and present-mindedness in professional life.", created_at:1779554345, source_id:"chunk-18859e4480224ac68f76cca24a1ad2ca", entity_id:"Anxiety-Free Entrepreneur"}}, {_id:6044, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"A connected parent demonstrates emotional presence and harmony in family relationships.", created_at:1779554346, source_id:"chunk-18859e4480224ac68f76cca24a1ad2ca", entity_id:"Connected Parent"}}, {_id:6045, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"A passionate student exhibits focus and joy in academic pursuits through an enlightened mindset.", created_at:1779554346, source_id:"chunk-18859e4480224ac68f76cca24a1ad2ca", entity_id:"Passionate Student"}}, {_id:6046, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"An emotionally present partner fosters mutual understanding and love in relationships.", created_at:1779554346, source_id:"chunk-18859e4480224ac68f76cca24a1ad2ca", entity_id:"Emotionally Present Partner"}}, {_id:6047, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Technology enables transition between brain states for improved daily functioning and enlightenment.` - The description is good.", created_at:1779554363, source_id:"chunk-81a80670e6aa7bf176b0cacf73a6f715", entity_id:"Gamma State/Stressful State/Beautiful State"}}, {_id:6048, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"CEO's choice of state determines response quality to challenges and company outcomes.` - The relationship keywords are good. The description is also good.", created_at:1779554365, source_id:"chunk-81a80670e6aa7bf176b0cacf73a6f715", entity_id:"Stressful State/Beautiful State"}}, {_id:6049, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"UNKNOWN", truncate:"", description:"Frequent social media use is linked to sustained distraction and agitation.", created_at:1779554397, source_id:"chunk-4c105f1c2d83f8107fb4042d9f1771a7", entity_id:"Distraction"}}, {_id:6050, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"UNKNOWN", truncate:"", description:"Alpha state enables concentration, memory, and attention.", created_at:1779554398, source_id:"chunk-4c105f1c2d83f8107fb4042d9f1771a7", entity_id:"Focus"}}, {_id:6051, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"Represents external abundance and sustainable living achieved through enlightened thinking.", created_at:1779555023, source_id:"chunk-6390a02d03fdb4770463600e69448a2a", entity_id:"Eco-Friendly Vehicle"}}, {_id:6052, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"person", truncate:"", description:"The king challenged Archimedes to verify the purity of a crown without melting it.", created_at:1779555023, source_id:"chunk-6390a02d03fdb4770463600e69448a2a", entity_id:"King of Syracuse"}}, {_id:6053, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"Refers to active participation in global challenges with loved ones, rooted in enlightenment.", created_at:1779555023, source_id:"chunk-6390a02d03fdb4770463600e69448a2a", entity_id:"Engaged World Journey"}}, {_id:6054, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"Symbolizes an enlightened mental state, driving personal abundance and world engagement.", created_at:1779555023, source_id:"chunk-6390a02d03fdb4770463600e69448a2a", entity_id:"Enlightened Mind (Buddha)"}}] AS row
