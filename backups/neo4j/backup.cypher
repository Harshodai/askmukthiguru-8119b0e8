UNWIND [{_id:2394, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Psychology is noted to have incorporated elements of Hindu/Buddhist philosophy but remains separate from pure spiritual experiences.", created_at:1779173283, source_id:"chunk-3ba320b05f330dd38ee53d270146e432", entity_id:"Psychology"}}, {_id:2395, properties:{file_path:"unknown_source", entity_type:"method", truncate:"", description:"Soul-sync practice is a daily mindfulness exercise aimed at fostering connection and fulfillment, even for non-spiritual individuals.<SEP>Soul-sync practice is a daily mindfulness exercise involving 12 minutes of focused attention to cultivate inner peace and connection, framed as brain/mind training regardless of spiritual alignment.` -> This looks correct. `entity_name`, `entity_type`, `entity_description`.", created_at:1779173284, source_id:"chunk-cb2b247e069cff8e39d34db433289983<SEP>chunk-39ae671b46577f26845d7bb862a61c36", entity_id:"Soul-Sync Practice"}}, {_id:2396, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=k5RDNv-CH9M)", entity_type:"concept", truncate:"", description:"The power of consciousness is described as ever-present presence, living intelligence, and a field of infinite possibilities.", created_at:1779222459, source_id:"chunk-1821dd190f52a60ee5308675e2253b71", entity_id:"The Power of Consciousness"}}, {_id:2397, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Human responsibility refers to compassionate, joyful actions toward oneself and others arising from a peaceful state of consciousness.>", created_at:1779173284, source_id:"chunk-cb2b247e069cff8e39d34db433289983", entity_id:"Human Responsibility"}}, {_id:2398, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"World movement describes collective individual growth toward peaceful consciousness to create a harmonious global society.>", created_at: