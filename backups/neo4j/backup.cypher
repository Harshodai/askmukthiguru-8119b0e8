d:492}, end: {_id:6135}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"destruction,historical impact", weight:1.0, description:"The British destroyed the World's Greatest Education, leading to a decline in India's GDP and educational system.", created_at:1779555886, source_id:"chunk-2033f09bf8213ddf39a0e5521e23bdef"}}, {start: {_id:6131}, end: {_id:6135}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"historical significance,institutional part", weight:1.0, description:"Takshashila was part of the World's Greatest Education system, contributing to its legacy.", created_at:1779555886, source_id:"chunk-2033f09bf8213ddf39a0e5521e23bdef"}}, {start: {_id:492}, end: {_id:6141}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"colonial policy,economic exploitation,historical action,method of exploitation", weight:2.0, description:"The British engaged in looting India as a method of economic exploitation and colonial control.<SEP>Looting was a method employed by the British to exploit India's resources.", created_at:1779555886, source_id:"chunk-2033f09bf8213ddf39a0e5521e23bdef"}}, {start: {_id:6129}, end: {_id:6135}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"historical significance,institutional part", weight:1.0, description:"Nalanda was part of the World's Greatest Education system, contributing to its legacy.", created_at:1779555886, source_id:"chunk-2033f09bf8213ddf39a0e5521e23bdef"}}, {start: {_id:492}, end: {_id:6142}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"colonial policy,historical action,labor structure,method of labor creation", weight:2.0, description:"The British created a structure to generate clerks useful to the British Empire, impacting education and society.<SEP>Creating clerks was a method used by the British to shape the workforce.", created_at:1779555886, source_id:"chunk-2033f09bf8213ddf39a0e5521e23bdef"}}, {start: {_id:6133}, end: {_id:6135}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"academic focus,educational structure", weight:1.0, description:"The student-teacher ratio was a key feature of the World's Greatest Education, emphasizing personalized learning.", created_at:1779555887, source_id:"chunk-2033f09bf8213ddf39a0e5521e23bdef"}}, {start: {_id:6134}, end: {_id:6135}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"educational system,knowledge branches", weight:1.0, description:"Gurukula education was a specialized branch of the World's Greatest Education, focusing on specific knowledge areas.", created_at:1779555887, source_id:"chunk-2033f09bf8213ddf39a0e5521e23bdef"}}, {start: {_id:4499}, end: {_id:6131}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"educational excellence,historical significance", weight:1.0, description:"Takshashila exemplifies India's historical educational achievements, supporting the concept of education's transformative potential.", created_at:1779555913, source_id:"chunk-0aa35626964e0e0b383b32633be633be"}}, {start: {_id:4499}, end: {_id:6129}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"educational excellence,historical significance", weight:1.0, description:"Nalanda's legacy underscores the importance of education in fostering intellectual growth, as referenced in the discussion.", created_at:1779555913, source_id:"chunk-0aa35626964e0e0b383b32633be633be"}}, {start: {_id:4499}, end: {_id:6130}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"student engagement,systemic challenges", weight:1.0, description:"Indian classrooms struggle with student attention and engagement, reflecting broader issues in the education system's implementation.", created_at:1779555913, source_id:"chunk-0aa35626964e0e0b383b32633be633be"}}, {start: {_id:4499}, end: {_id:178}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"expectations,student well-being", weight:1.0, description:"Societal expectations from educators create pressure on students, contributing to stress and anxiety in educational settings.", created_at:1779555913, source_id:"chunk-0aa35626964e0e0b383b32633be633be"}}, {start: {_id:4499}, end: {_id:6132}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"student experience,systemic structure", weight:1.0, description:"Institutions enforce educational frameworks that often prioritize routine over meaningful learning experiences for students.", created_at:1779555913, source_id:"chunk-0aa35626964e0e0b383b32633be633be"}}, {start: {_id:6150}, end: {_id:6149}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"mental health disparity,urban-rural divide", weight:1.0, description:"Urban youth face twice the mental health challenges compared to rural youth.", created_at:1779555916, source_id:"chunk-748133f16cf9409e907621d95ac797bb"}}, {start: {_id:6144}, end: {_id:6143}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"demographic impact,emotional crisis", weight:1.0, description:"The youth mental health crisis disproportionately affects Indian youth, with high rates of depression and anxiety.", created_at:1779555916, source_id:"chunk-748133f16cf9409e907621d95ac797bb"}}, {start: {_id:6145}, end: {_id:6143}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"ineffective measures,ongoing crisis", weight:1.0, description:"Despite government efforts, the youth mental health crisis persists due to insufficient impact.", created_at:1779555916, source_id:"chunk-748133f16cf9409e907621d95ac797bb"}}] AS row
