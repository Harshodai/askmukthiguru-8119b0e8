UNWIND [{start: {_id:4845}, end: {_id:4846}, properties:{file_path:"unknown_source", keywords:"energy growth,visualization", truncate:"", weight:1.0, description:"The chanting of Om is directly linked to the visualization and growth of the luminous light.", created_at:1779411576, source_id:"chunk-724531516c99b2814a8e329894ee9bdf"}}, {start: {_id:4843}, end: {_id:886}, properties:{file_path:"unknown_source<SEP>YouTube Video: qQmrTz6i2x4 (URL: https://www.youtube.com/watch?v=qQmrTz6i2x4)", keywords:"alignment,energy influence,energy tuning", truncate:"", weight:2.0, description:"The moon is described as being in alignment with lunar energies, which are tuned during the ritual.<SEP>The moon's position and phases are linked to lunar energies that affect bodily alignment in the practice.", created_at:1779411618, source_id:"chunk-724531516c99b2814a8e329894ee9bdf<SEP>chunk-faad39bb9ba8730957c6d719dd0fa2bc"}}, {start: {_id:4846}, end: {_id:4844}, properties:{file_path:"unknown_source", keywords:"correlation,energy amplification", truncate:"", weight:1.0, description:"The phases of the moon are described as increasing in size, which correlates with the amplification of the luminous light.", created_at:1779411576, source_id:"chunk-724531516c99b2814a8e329894ee9bdf"}}, {start: {_id:738}, end: {_id:886}, properties:{file_path:"unknown_source", keywords:"alignment,energy tuning", truncate:"", weight:1.0, description:"The body is described as being in alignment with the moon and lunar energies during the ritual.", created_at:1779411576, source_id:"chunk-724531516c99b2814a8e329894ee9bdf"}}, {start: {_id:738}, end: {_id:4843}, properties:{file_path:"unknown_source", keywords:"alignment,energy tuning", truncate:"", weight:1.0, description:"The body is in tune with the lunar energies as part of the ritual process.", created_at:1779411576, source_id:"chunk-724531516c99b2814a8e329894ee9bdf"}}, {start: {_id:4846}, end: {_id:886}, properties:{file_path:"unknown_source", keywords:"light manifestation,lunar influence", truncate:"", weight:1.0, description:"The moon's presence is implied to influence the manifestation of the luminous light through its phases.", created_at:1779411576, source_id:"chunk-724531516c99b2814a8e329894ee9bdf"}}, {start: {_id:4845}, end: {_id:4848}, properties:{file_path:"YouTube Video: qQmrTz6i2x4 (URL: https://www.youtube.com/watch?v=qQmrTz6i2x4)", truncate:"", keywords:"meditation practice,visualization", weight:1.0, description:"The chanting of Om facilitates the visualization of the luminous light as part of the meditation process.", created_at:1779411618, source_id:"chunk-faad39bb9ba8730957c6d719dd0fa2bc"}}, {start: {_id:4848}, end: {_id:886}, properties:{file_path:"YouTube Video: qQmrTz6i2x4 (URL: https://www.youtube.com/watch?v=qQmrTz6i2x4)", truncate:"", keywords:"phase growth,visual metaphor", weight:1.0, description:"The light's growth mirrors the moon's phases, serving as a metaphorical connection in the meditation exercise.", created_at:1779411618, source_id:"chunk-faad39bb9ba8730957c6d719dd0fa2bc"}}, {start: {_id:738}, end: {_id:4849}, properties:{file_path:"unknown_source", keywords:"calmness,health,radiance", truncate:"", weight:1.0, description:"The body is described as being filled with soft radiance, symbolizing inner calm and well-being.", created_at:1779412508, source_id:"chunk-001ceefc701be2ec77d8774583dfaee8"}}, {start: {_id:738}, end: {_id:4851}, properties:{file_path:"unknown_source", keywords:"breathing technique,mindfulness", truncate:"", weight:1.0, description:"Slow breaths are practiced to maintain calmness and focus.", created_at:1779412508, source_id:"chunk-001ceefc701be2ec77d8774583dfaee8"}}, {start: {_id:738}, end: {_id:4853}, properties:{file_path:"unknown_source", keywords:"mental state,self-affirmation", truncate:"", weight:1.0, description:"The mantra invokes a calm and courageous state within the body.", created_at:1779412508, source_id:"chunk-001ceefc701be2ec77d8774583dfaee8"}}, {start: {_id:738}, end: {_id:4852}, properties:{file_path:"unknown_source", keywords:"physical well-being,self-affirmation", truncate:"", weight:1.0, description:"The mantra emphasizes healing and health for the body.", created_at:1779412508, source_id:"chunk-001ceefc701be2ec77d8774583dfaee8"}}, {start: {_id:738}, end: {_id:4850}, properties:{file_path:"unknown_source", keywords:"environment,harmony", truncate:"", weight:1.0, description:"The body's state connects to the broader desire for a safe and harmonious world.", created_at:1779412508, source_id:"chunk-001ceefc701be2ec77d8774583dfaee8"}}, {start: {_id:4856}, end: {_id:4855}, properties:{file_path:"YouTube Video: 5hNCT4duOgc (URL: https://www.youtube.com/watch?v=5hNCT4duOgc)", truncate:"", keywords:"reference,source", weight:1.0, description:"The video is hosted at the specified URL, serving as its direct source.", created_at:1779412530, source_id:"chunk-d6bda38ec2ac70c5b39894384ca14857"}}, {start: {_id:4854}, end: {_id:4856}, properties:{file_path:"YouTube Video: 5hNCT4duOgc (URL: https://www.youtube.com/watch?v=5hNCT4duOgc)", truncate:"", keywords:"content,theme", weight:1.0, description:"The video features affirmations focused on calmness, courage, and healing as central thematic elements.", created_at:1779412530, source_id:"chunk-d6bda38ec2ac70c5b39894384ca14857"}}, {start: {_id:4858}, end: {_id:4860}, properties:{file_path:"unknown_source<SEP>YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"educational collaboration,educational source,knowledge source,practices", weight:2.0, description:"The Breathing Room platform incorporates practices from the O&O Academy of philosophy and meditation school.<SEP>Breathing Room Platform incorporates well-tested meditation and philosophy practices from the O&O Academy.", created_at:1779413902, source_id:"chunk-09281c1d13593beda4d12244d150cf31<SEP>chunk-8924b6a6a34d401eea1dd88448275257"}}, {start: {_id:4858}, end: {_id:4857}, properties:{file_path:"unknown_source", keywords:"life improvement,stress relief", truncate:"", weight:1.0, description:"The platform addresses challenges of modern life by offering practices to counteract stress and enhance fulfillment.", created_at:1779413774, source_id:"chunk-09281c1d13593beda4d12244d150cf31"}}, {start: {_id:486}, end: {_id:4860}, properties:{file_path:"unknown_source<SEP>YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"cultural origin,headquarters,institutional base,institutional location,location", weight:4.0, description:"The O&O Academy is centered in India and crafts practices rooted in ancient Indian traditions.<SEP>O&O Academy of Philosophy and Meditation School is centered in India.<SEP>The O&O Academy is headquartered in India.<SEP>Academy is physically located and culturally rooted in India.", created_at:1779414171, source_id:"chunk-09281c1d13593beda4d12244d150cf31<SEP>chunk-8924b6a6a34d401eea1dd88448275257<SEP>chunk-35e8d232b554b659ba6aef9a72d19bb8<SEP>chunk-455b122fda4addf20dfaf68404d297db"}}, {start: {_id:4858}, end: {_id:499}, properties:{file_path:"unknown_source", keywords:"relaxation,stress management", truncate:"", weight:1.0, description:"The platform provides techniques to mitigate stress through guided meditation and breathing exercises.", created_at:1779413774, source_id:"chunk-09281c1d13593beda4d12244d150cf31"}}, {start: {_id:4858}, end: {_id:4859}, properties:{file_path:"unknown_source", truncate:"", keywords:"emotional well-being,social improvement", weight:1.0, description:"The platform aims to foster joyful conversations by promoting mindfulness and emotional balance.", created_at:1779413774, source_id:"chunk-09281c1d13593beda4d12244d150cf31"}}] AS row
