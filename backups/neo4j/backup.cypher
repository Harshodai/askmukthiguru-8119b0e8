UNWIND [{start: {_id:2480}, end: {_id:2001}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"emotional dominance,information flow", weight:1.0, description:"The limbic system's information flow to the prefrontal cortex is stronger than the reverse, causing emotions to override positive thinking.", created_at:1779395893, source_id:"chunk-019177d585b65eb10f97dfb309cde652"}}, {start: {_id:4509}, end: {_id:4036}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"beneficiary determination,beneficiary influence,decision-making,subconscious power", weight:2.0, description:"Intention subtly determines who benefits from decisions, operating beneath conscious awareness.<SEP>Intention determines who the beneficiary of a decision is.", created_at:1779396049, source_id:"chunk-019177d585b65eb10f97dfb309cde652<SEP>chunk-de8ced1f0ad24cf1ada29f88e70d381e"}}, {start: {_id:3497}, end: {_id:4508}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"information disparity,processing capacity", weight:1.0, description:"The unconscious mind processes vastly more information than the conscious mind, creating a cognitive imbalance.", created_at:1779395893, source_id:"chunk-019177d585b65eb10f97dfb309cde652"}}, {start: {_id:534}, end: {_id:2480}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"emotional processing,override effect", weight:1.0, description:"Emotions like anxiety and anger originate in the limbic system and override conscious positive thinking.", created_at:1779395894, source_id:"chunk-019177d585b65eb10f97dfb309cde652"}}, {start: {_id:2480}, end: {_id:2175}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"balance,neuroplasticity", truncate:"", weight:1.0, description:"Meditation practice reverses the limbic system's dominance over the prefrontal cortex, restoring balance.", created_at:1779395894, source_id:"chunk-019177d585b65eb10f97dfb309cde652"}}, {start: {_id:4477}, end: {_id:4476}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"correction,grammar", truncate:"", weight:2.0, description:"The phrase \"created you\" is corrected to \"created in you\" for grammatical accuracy.", created_at:1779395945, source_id:"chunk-06b512c92e682b8d2052145d11d7fba4"}}, {start: {_id:4473}, end: {_id:4510}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"experience,learning", truncate:"", weight:1.0, description:"The user learned about the importance of spirituality in business from their experience in Ono.", created_at:1779395990, source_id:"chunk-38d10efd726b55222a60dd6302bc5fed"}}, {start: {_id:4511}, end: {_id:348}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"grammar,text correction", truncate:"", weight:1.0, description:"The YouTube video's text has \"created you\" which should be corrected to \"created in you\".", created_at:1779395991, source_id:"chunk-38d10efd726b55222a60dd6302bc5fed"}}, {start: {_id:4512}, end: {_id:4510}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"absence,education gap,exclusion,importance,lack of coverage,omission", weight:3.0, created_at:1779396173, description:"Spirituality in Business is important in business but was not covered in the user's business education.<SEP>Business Education excluded teachings on spirituality in business despite its importance.<SEP>Business Education did not cover spirituality in business, leading to the user's surprise.", source_id:"chunk-de8ced1f0ad24cf1ada29f88e70d381e<SEP>chunk-b54c1c8684702c9200700834a33ecb01<SEP>chunk-e8faa81a993f207602fa6e9806472986"}}, {start: {_id:4475}, end: {_id:4510}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"association,concept relationship,conceptual foundation,emphasis,importance,subject,teachings", weight:5.0, created_at:1779396220, description:"O&O Teachings emphasize the importance of spirituality in business.<SEP>O&O Teachings cover the subject of spirituality in business.<SEP>O&O Teachings are associated with the importance of spirituality in business as per teachings learned in Ono.<SEP>O&O Teachings emphasize the importance of spirituality in business.<SEP>O&O teachings are related to spirituality in business, as the user learned about O&O teachings in Ono.", source_id:"chunk-de8ced1f0ad24cf1ada29f88e70d381e<SEP>chunk-6be585d75cf325a3e49671e7f39dd2b5<SEP>chunk-b54c1c8684702c9200700834a33ecb01<SEP>chunk-e8faa81a993f207602fa6e9806472986<SEP>chunk-d1012dbbd23737bb4a6584bd720f3300"}}, {start: {_id:4473}, end: {_id:2096}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"learning,visited", weight:1.0, description:"The user visited Ono to learn about spirituality in business.", created_at:1779396075, source_id:"chunk-6be585d75cf325a3e49671e7f39dd2b5"}}, {start: {_id:4475}, end: {_id:4473}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"association,education,origin,teachings origin", weight:2.0, description:"Ono is the origin of O&O Teachings that highlight spirituality in business.<SEP>O&O Teachings originated from Ono and are part of the education the user received there.", created_at:1779396173, source_id:"chunk-b54c1c8684702c9200700834a33ecb01<SEP>chunk-e8faa81a993f207602fa6e9806472986"}}, {start: {_id:4473}, end: {_id:2144}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"original text location", truncate:"", weight:1.0, description:"The original text is associated with Ono, where the user's experience led to learning about spirituality in business.", created_at:1779396220, source_id:"chunk-d1012dbbd23737bb4a6584bd720f3300"}}, {start: {_id:4513}, end: {_id:4510}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"concept contrast", weight:1.0, description:"Business at school and spirituality in business are contrasted, as the user studied business but wasn't taught about spirituality in business.", created_at:1779396220, source_id:"chunk-d1012dbbd23737bb4a6584bd720f3300"}}, {start: {_id:44}, end: {_id:4036}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"impact,influence", weight:1.0, description:"Intention affects business outcomes and decision-making processes.", created_at:1779396276, source_id:"chunk-f63f1b5d24ba94b5a3f6d30a788d8dd0"}}, {start: {_id:4475}, end: {_id:4514}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"explanation,teaching content", weight:1.0, description:"The Power of Intention is a key concept within the O&O Teachings, explaining decision-making principles.", created_at:1779396276, source_id:"chunk-f63f1b5d24ba94b5a3f6d30a788d8dd0"}}, {start: {_id:4036}, end: {_id:294}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"impact,influence", weight:1.0, description:"Intention affects work outcomes and task execution.", created_at:1779396276, source_id:"chunk-f63f1b5d24ba94b5a3f6d30a788d8dd0"}}, {start: {_id:4515}, end: {_id:2390}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"central,core_influence", truncate:"", weight:1.0, description:"Spirituality is at the core of the energy flow and decision-making process.", created_at:1779396321, source_id:"chunk-62aafe5d597e7b4e36bd88d98b8974d0"}}, {start: {_id:2081}, end: {_id:4036}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"decision_process,outcome", truncate:"", weight:1.0, description:"Intention leads to decisions, which contribute to destiny.", created_at:1779396321, source_id:"chunk-62aafe5d597e7b4e36bd88d98b8974d0"}}, {start: {_id:1815}, end: {_id:2081}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"action_process,outcome", truncate:"", weight:2.0, description:"Decisions influence actions, which contribute to destiny.<SEP>Decisions lead to actions, which contribute to destiny.", created_at:1779396321, source_id:"chunk-62aafe5d597e7b4e36bd88d98b8974d0"}}] AS row
