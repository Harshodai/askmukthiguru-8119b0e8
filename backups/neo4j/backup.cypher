UNWIND [{start: {_id:3287}, end: {_id:3329}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"intuition,practitioners,ritual expertise,spiritual intuition", weight:2.0, description:"Priests conducted ceremonies with intuitive understanding of other worlds.<SEP>Ancient Ceremonies were effective because the priests who conducted them could intuit other worlds.", created_at:1779228940, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281<SEP>chunk-ff31f73b2ef0618c73b0f438087fdec4"}}, {start: {_id:3183}, end: {_id:3289}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"afterlife suffering,emotional consequence", weight:1.0, description:"Unhappy life conditions result in a grief-filled afterlife for ancestors.", created_at:1779228761, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281"}}, {start: {_id:3336}, end: {_id:3312}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"emotional legacy,spiritual harmony", weight:1.0, description:"Peaceful lives lead to a harmonious afterlife for ancestors.", created_at:1779228761, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281"}}, {start: {_id:3287}, end: {_id:3288}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"cultural framework,ritual design", weight:1.0, description:"Ancient philosophy influenced the design and purpose of ancestral rituals.", created_at:1779228761, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281"}}, {start: {_id:3330}, end: {_id:3329}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"intuitive understanding,spiritual knowledge", weight:1.0, description:"Priests intuitively grasped concepts of other worlds through philosophical training.", created_at:1779228761, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281"}}, {start: {_id:3339}, end: {_id:293}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"emotional release,releasing", weight:1.0, description:"Families release the departed, experiencing instant liberation and emotional release as the departed move into the light.", created_at:1779228802, source_id:"chunk-484efc8f94e4787f4bc0cc8762ad9476"}}, {start: {_id:3339}, end: {_id:3394}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"energy clearance,liberation", weight:1.0, description:"The departed clear stuck energy, leading to liberation and dissolution of health problems in the family.", created_at:1779228802, source_id:"chunk-484efc8f94e4787f4bc0cc8762ad9476"}}, {start: {_id:3344}, end: {_id:3184}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"commencement,spiritual journey", weight:1.0, description:"Mahaprasthana signifies the commencement of a great spiritual journey toward enlightenment.", created_at:1779228802, source_id:"chunk-484efc8f94e4787f4bc0cc8762ad9476"}}, {start: {_id:3401}, end: {_id:3227}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", keywords:"doctrine,religious text", truncate:"", weight:1.0, description:"Jewish belief in reincarnation is documented in Gnostic gospel.", created_at:1779228831, source_id:"chunk-8c4fdae5005ad5ebdfceee30c70b21dc"}}, {start: {_id:3402}, end: {_id:3178}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"ancestor veneration,cultural practice", weight:1.0, description:"Japanese observe Obon, a festival honoring ancestors.", created_at:1779228832, source_id:"chunk-8c4fdae5005ad5ebdfceee30c70b21dc"}}, {start: {_id:1839}, end: 