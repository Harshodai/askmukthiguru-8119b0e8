UNWIND [{_id:8196, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Courageous souls challenge themselves and embrace challenges to transcend mediocrity and achieve growth.<SEP>Courageous souls challenge themselves and embrace challenges to transcend mediocrity and achieve growth.", created_at:1779734159, source_id:"chunk-0a805eaee62c04f0b4972c562982e21f", entity_id:"Courageous souls"}}, {_id:8197, properties:{file_path:"unknown_source", entity_type:"event", truncate:"", description:"The Soul Sync meditation challenge is a seven-day program encouraging daily five-minute meditation practice.<SEP>The Soul Sync meditation challenge is a seven-day program encouraging daily five-minute meditation practice.", created_at:1779734159, source_id:"chunk-0a805eaee62c04f0b4972c562982e21f", entity_id:"Soul Sync meditation challenge"}}, {_id:8198, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Emotional growth involves the development of emotional resilience and self-awareness.<SEP>Emotional growth involves the development of emotional resilience and self-awareness.", created_at:1779734159, source_id:"chunk-0a805eaee62c04f0b4972c562982e21f", entity_id:"Emotional growth"}}, {_id:8199, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Intellectual growth refers to the development of cognitive abilities and knowledge.<SEP>Intellectual growth refers to the development of cognitive abilities and knowledge.", created_at:1779734159, source_id:"chunk-0a805eaee62c04f0b4972c562982e21f", entity_id:"Intellectual growth"}}, {_id:8200, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Business growth pertains to the expansion and success of professional endeavors.<SEP>Business growth pertains to the expansion and success of professional endeavors.", created_at:1779734159, source_id:"chunk-0a805eaee62c04f0b4972c562982e21f", entity_id:"Business growth"}}, {_id:8201, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Spiritual growth relates to the development of inner peace and higher purpose.<SEP>Spiritual growth relates to the development of inner peace and higher purpose.", created_at:1779734159, source_id:"chunk-0a805eaee62c04f0b4972c562982e21f", entity_id:"Spiritual growth"}}, {_id:8202, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=4ytgjpow498)", entity_type:"method", truncate:"", description:"Breath Counting Method involves synchronizing breath awareness with thumb-to-fingertip touch for eight counts during inhalations and exhalations, forming the first stage of Soul Sync.<SEP>Breath Counting Method involves synchronizing breath awareness with thumb-to-fingertip touch for eight counts during inhalations and exhalations, forming the first stage of Soul Sync.", created_at:1779734159, source_id:"chunk-553cd7a1612ef0be55af8c2a1d0c2ae4", entity_id:"Breath Counting Method"}}, {_id:8203, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Courageous souls challenge themselves to transcend limitations and achieve growth.", created_at:1779734195, source_id:"chunk-0a805eaee62c04f0b4972c562982e21f", entity_id:"Themselves"}}, {_id:8204, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=4ytgjpow498)", entity_type:"concept", truncate:"", description:"An environment with high pathogen presence, necessitating immune system support for survival.", created_at:1779734201, source_id:"chunk-190acc93a27012825956522182c7d1a4", entity_id:"Infection-Filled Atmosphere"}}, {_id:8206, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=4ytgjpow498)", entity_type:"concept", truncate:"", description:"A state of profound calm and rest achieved through controlled breathing and meditation.", created_at:1779734214, source_id:"chunk-5bf3950956a6b9404d15