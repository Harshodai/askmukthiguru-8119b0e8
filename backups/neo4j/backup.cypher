UNWIND [{start: {_id:1817}, end: {_id:2097}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=FP5O9F9JiOk)", truncate:"", keywords:"correction,correction target,correction task,focus area", weight:3.0, created_at:1779721965, description:"Homophones are a focus area for the task of fixing transcription errors.<SEP>Homophones are a focus area for the text correction task.<SEP>Fixing homophones is a key part of the transcription error correction task.", source_id:"chunk-95a91e026d1863541a1b478787efb747<SEP>chunk-ce98cef5ee578e41291bb93814fc0b95<SEP>chunk-2c4a8ff4dacf62c911a74483fadc685b"}}, {start: {_id:1817}, end: {_id:1790}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=KTe11DlB4QI)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)<SEP>YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=FP5O9F9JiOk)", truncate:"", keywords:"correction,correction task,focus area,formatting,grammar,readability,readability adjustment,readability adjustments,task component,task focus", weight:13.0, description:"Fix Transcription Errors is a relation that focuses on correcting transcription errors, with a particular emphasis on punctuation and capitalization. The task involves adjusting these elements to improve readability and clarity in the text. Within the Fix Transcription Errors task, punctuation and capitalization are identified as key focus areas. The method enforces proper punctuation and capitalization to ensure the corrected text is clear and easy to understand. This component is integral to the overall error correction process. The task of fixing transcription errors includes addressing punctuation and capitalization as part of the correction. These elements are consistently highlighted as focus areas across the descriptions, underscoring their importance in achieving a readable and accurate text.", created_at:1779721971, source_id:"chunk-95a91e026d1863541a1b478787efb747<SEP>chunk-a438089a70a6295bfcb56f41468c76e0<SEP>chunk-ce98cef5ee578e41291bb93814fc0b95<SEP>chunk-c3a39db7f9720a122a0c7c42879a22e6<SEP>chunk-46c59d79ae75a285b992cb76b9f206e4<SEP>chunk-24d9ed96880450331df58985b0f9b175<SEP>chunk-2c4a8ff4dacf62c911a74483fadc685b"}}, {start: {_id:1786}, end: {_id:1594}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)<SEP>unknown_source", truncate:"", keywords:"correction example,correction target,example,misheard term", weight:2.0, description:"Sadhana is an example of a domain-specific term to be corrected.<SEP>The misheard term \"Sadhana\" is an example of a domain-specific term that was misheard.", created_at:1779393637, source_id:"chunk-95a91e026d1863541a1b478787efb747<SEP>chunk-d66cf68ce9f6d614d8c2ffeac6619b27"}}, {start: {_id:1786}, end: {_id:1500}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)<SEP>unknown_source", truncate:"", keywords:"correction example,correction target,example,misheard term", weight:2.0, description:"Limitless Field is an example of a domain-specific term to be corrected.<SEP>The misheard term \"Limitless Field\" is an example of a domain-specific term that was misheard.", created_at:1779393637, source_id:"chunk-95a91e026d1863541a1b478787efb747<SEP>chunk-d66cf68ce9f6d614d8c2ffeac6619b27"}}, {start: {_id:2296}, end: {_id:2298}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"cosmic symbolism,metaphysical unity,religious significance,worship", weight:2.0, description:"Ekam Kshetra is dedicated to the worship of Hiranyagarbha as described in the Rig Veda.<SEP>Ekam Kshetra relates to Hiranyagarbha as unified cosmic principles.", created_at:1779167181, source_id:"chunk-96e7034ec10353f076fb39e1a418516e<SEP>chunk-5dcadb28ba25332dd33280807411fe6e"}}, {start: {_id:2296}, end: {_id:2295}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"divine inspiration,revelation", weight:1.0, description:"Prithaji's revelation about non-dual consciousness inspired the creation of Ekam Kshetra.", created_at:1779167028, source_id:"chunk-96e7034ec10353f076fb39e1a418516e"}}, {start: {_id:2298}, end: {_id:2297}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"cosmological origin,religious authority,scriptural reference", weight:2.0, description:"The Rig Veda provides scriptural validation for the worship of Hiranyagarbha at Ekam Kshetra.<SEP>Hiranyagarbha is described in the Rig Veda as the cosmic origin.", created_at:1779167180, source_id:"chunk-96e7034ec10353f076fb39e1a418516e<SEP>chunk-5dcadb28ba25332dd33280807411fe6e"}}, {start: {_id:2298}, end: {_id:2305}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"divine origin,primordial source", weight:1.0, description:"Hiranyagarbha is the primordial source from which all other divine forms emerge according to the Rig Veda.", created_at:1779167088, source_id:"chunk-9f2392959877074397c1ce18b8f748b3"}}, {start: {_id:1820}, end: {_id:2306}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"energy activation,energy cultivation,spiritual awakening,spiritual practice", weight:2.0, description:"Prana Upasanas at Ekam Kshetra trigger the rise of Kundalini energy and surreal consciousness.<SEP>Prana Upasanas relate to Kundalini energy activation.", created_at:1779167180, source_id:"chunk-9f2392959877074397c1ce18b8f748b3<SEP>chunk-5dcadb28ba25332dd33280807411fe6e"}}, {start: {_id:2296}, end: {_id:2304}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"recommendation,spiritual significance", weight:2.0, description:"Visiting Ekam Kshetra is recommended as the best start to a beautiful life, emphasizing its transformative spiritual power.", created_at:1779167088, source_id:"chunk-9f2392959877074397c1ce18b8f748b3"}}, {start: {_id:2299}, end: {_id:2302}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"spiritual practice,transcendent state", weight:1.0, description:"Amruta Kalesha is associated with advanced Upasanas.", created_at:1779167180, source_id:"chunk-5dcadb28ba25332dd33280807411fe6e"}}, {start: {_id:2295}, end: {_id:2310}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"elemental representation,personification", weight:1.0, description:"Prithaji embodies the Earth in Vedic personification.", created_at:1779167181, source_id:"chunk-5dcadb28ba25332dd33280807411fe6e"}}, {start: {_id:2297}, end: {_id:2300}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"ritualistic significance,sacred symbolism", weight:1.0, description:"Surya Yantra is referenced in Vedic traditions tied to the Rig Veda.", created_at:1779167181, source_id:"chunk-5dcadb28ba25332dd33280807411fe6e"}}, {start: {_id:2301}, end: {_id:2302}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"spiritual achievement,yogic mastery", weight:1.0, description:"Siddhis result from dedicated Upasanas.", created_at:1779167181, source_id:"chunk-5dcadb28ba25332dd33280807411fe6e"}}, {start: {_id:2282}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"content structure,stylistic device", weight:1.0, description:"The video incorporates repetitive phrasing as a deliberate stylistic choice to emphasize its thematic tone.", created_at:1779167375, source_id:"chunk-2571a5b04e1099d62f3684e457e34d71"}}, {start: {_id:2317}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"linguistic style,narrative structure", weight:1.0, description:"The video features an extended, uninterrupted sentence reflecting its unique narrative approach.", created_at:1779167375, source_id:"chunk-2571a5b04e1099d62f3684e457e34d71"}}, {start: {_id:2318}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"content inclusion,linguistic element", weight:2.0, description:"The YouTube video's content includes the phrase \"Thank you\" as part of a run-on sentence.", created_at:1779167396, source_id:"chunk-a9697fcde15e625c6897be6f1b0218f7"}}, {start: {_id:2320}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"content hosting,readability improvement", weight:1.0, description:"The YouTube Video contains the Massive Sentence, which requires punctuation fixes to enhance readability.", created_at:1779167415, source_id:"chunk-d488fbfb15a8f79f360ab3c5b1d504a1"}}, {start: {_id:2320}, end: {_id:2319}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vy09aBxslx0)", truncate:"", keywords:"readability,text processing", weight:1.0, description:"The Massive Sentence is the subject of punctuation fixing efforts to improve its structure and readability.", created_at:1779167415, source_id:"chunk-d488fbfb15a8f79f360ab3c5b1d504a1"}}, {start: {_id:2323}, end: {_id:2321}, properties:{file_path:"unknown_source", keywords:"concept,definition", truncate:"", weight:1.0, description:"Dhiira is defined as one whose intellect shines with the light of dharma.", created_at:1779168414, source_id:"chunk-716f70c82340a863624fa47098e63ad3"}}] AS row
