UNWIND [{start: {_id:520}, end: {_id:1463}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", truncate:"", keywords:"preference,societal critique", weight:1.0, description:"People express a preference to contract coronavirus over remaining confined at home, reflecting dissatisfaction with societal constraints.", created_at:1779662148, source_id:"chunk-e3a9d3b4e75a6781f9fb7a4d35559a14"}}, {start: {_id:115}, end: {_id:4020}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", keywords:"escapism,extremism", truncate:"", weight:1.0, description:"The concept of freedom is linked to extreme ideas like leaving Earth, highlighting its abstract and paradoxical nature.", created_at:1779662148, source_id:"chunk-e3a9d3b4e75a6781f9fb7a4d35559a14"}}, {start: {_id:7293}, end: {_id:7290}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", truncate:"", keywords:"concept,freedom", weight:1.0, description:"The video discusses freedom as an internal state rather than physical escape.", created_at:1779662157, source_id:"chunk-056af6c4761b77d7ca60b82d77a7fd2e"}}, {start: {_id:7294}, end: {_id:7290}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", truncate:"", keywords:"concept,escape", weight:1.0, description:"The video contrasts escape with true freedom, correcting the phrase \"Keep running out\".", created_at:1779662157, source_id:"chunk-056af6c4761b77d7ca60b82d77a7fd2e"}}, {start: {_id:7295}, end: {_id:7290}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", truncate:"", keywords:"concept,fear", weight:1.0, description:"The video discusses how actions during a pandemic can lead to increased fear.", created_at:1779662158, source_id:"chunk-056af6c4761b77d7ca60b82d77a7fd2e"}}, {start: {_id:7296}, end: {_id:2326}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", truncate:"", keywords:"fear amplification,virus impact", weight:3.0, description:"The coronavirus causes fear, with the speaker describing exponential growth in fear levels.", created_at:1779662167, source_id:"chunk-e264e9dc0aed2215851420aa0c3de19d"}}, {start: {_id:7290}, end: {_id:2326}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", truncate:"", keywords:"content analysis,discussion", weight:2.0, description:"The YouTube video discusses fear in the context of the coronavirus pandemic.", created_at:1779662167, source_id:"chunk-e264e9dc0aed2215851420aa0c3de19d"}}, {start: {_id:7281}, end: {_id:6100}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", keywords:"content,discussion", truncate:"", weight:1.0, description:"The video discusses humanity's fight for freedom as a central theme.", created_at:1779662176, source_id:"chunk-bd7c38352cd44635d7efe811b1c3eb50"}}, {start: {_id:7281}, end: {_id:7297}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", keywords:"content,discussion", truncate:"", weight:1.0, description:"The video addresses privacy as a major issue with ongoing problems.", created_at:1779662176, source_id:"chunk-bd7c38352cd44635d7efe811b1c3eb50"}}, {start: {_id:6100}, end: {_id:1498}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", keywords:"fight for,struggle", truncate:"", weight:1.0, description:"Humanity is engaged in a continuous fight for freedom, representing the collective struggle for liberation.", created_at:1779662176, source_id:"chunk-bd7c38352cd44635d7efe811b1c3eb50"}}, {start: {_id:1463}, end: {_id:7266}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", truncate:"", keywords:"loss", weight:1.0, description:"People experience a loss of privacy as a consequence of seeking freedom on the platforms.", created_at:1779662225, source_id:"chunk-f3cc07a478604197eefad4556e973256"}}, {start: {_id:410}, end: {_id:1463}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", truncate:"", keywords:"seeking freedom", weight:1.0, description:"People seek freedom on the Facebook platform.", created_at:1779662225, source_id:"chunk-f3cc07a478604197eefad4556e973256"}}, {start: {_id:7271}, end: {_id:1463}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", truncate:"", keywords:"seeking freedom", weight:1.0, description:"People seek freedom on the Instagram platform.", created_at:1779662225, source_id:"chunk-f3cc07a478604197eefad4556e973256"}}, {start: {_id:7266}, end: {_id:348}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", keywords:"analysis,discussion", truncate:"", weight:1.0, description:"The YouTube Video discusses the concept of privacy and its implications in modern technology.", created_at:1779662235, source_id:"chunk-8d1735e497b4fb0d684267020bb40bf9"}}, {start: {_id:7260}, end: {_id:7299}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", truncate:"", keywords:"data collection,technology", weight:1.0, description:"Smartphones are highlighted as tools that enable constant monitoring and data collection, impacting privacy.", created_at:1779662235, source_id:"chunk-8d1735e497b4fb0d684267020bb40bf9"}}, {start: {_id:3033}, end: {_id:7300}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", keywords:"monitoring,tracking", truncate:"", weight:1.0, description:"New York is referenced in the context of surveillance and tracking practices affecting personal privacy.", created_at:1779662235, source_id:"chunk-8d1735e497b4fb0d684267020bb40bf9"}}, {start: {_id:7258}, end: {_id:7266}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", truncate:"", keywords:"concern,impact", weight:1.0, description:"Corona has contributed to heightened concerns about privacy due to increased surveillance measures.", created_at:1779662235, source_id:"chunk-8d1735e497b4fb0d684267020bb40bf9"}}, {start: {_id:7298}, end: {_id:348}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", keywords:"analysis,discussion", truncate:"", weight:1.0, description:"The YouTube Video discusses the implications of surveillance on personal privacy in the context of modern technology.", created_at:1779662235, source_id:"chunk-8d1735e497b4fb0d684267020bb40bf9"}}, {start: {_id:7266}, end: {_id:2466}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", keywords:"governance,regulation", truncate:"", weight:1.0, description:"The state's role in implementing surveillance policies impacts individual privacy and data protection.", created_at:1779662235, source_id:"chunk-8d1735e497b4fb0d684267020bb40bf9"}}, {start: {_id:3033}, end: {_id:7298}, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", keywords:"monitoring,tracking", truncate:"", weight:1.0, description:"New York is referenced in the context of surveillance and tracking practices affecting personal privacy.", created_at:1779662235, source_id:"chunk-8d1735e497b4fb0d684267020bb40bf9"}}] AS row
