UNWIND [{start: {_id:371}, end: {_id:3675}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"cultural shift,social fragmentation", weight:1.0, description:"Modernization and culture are linked to increased loneliness through nuclear families.", created_at:1779236648, source_id:"chunk-c2dfb10d73bb85ba3334f2281cc0afee"}}, {start: {_id:3677}, end: {_id:3675}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"cultural shift,societal change", weight:1.0, description:"Modernization and culture have led to the adoption of individualistic lifestyles over traditional communal living.", created_at:1779236648, source_id:"chunk-c2dfb10d73bb85ba3334f2281cc0afee"}}, {start: {_id:3677}, end: {_id:371}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"emotional impact,social structure", weight:1.0, description:"Individualistic lifestyles contribute to increased loneliness and social isolation.", created_at:1779236649, source_id:"chunk-c2dfb10d73bb85ba3334f2281cc0afee"}}, {start: {_id:1406}, end: {_id:3677}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"mental health,societal factors", weight:1.0, description:"Individualistic lifestyles are linked to higher rates of depression due to social isolation.", created_at:1779236649, source_id:"chunk-c2dfb10d73bb85ba3334f2281cc0afee"}}, {start: {_id:3647}, end: {_id:1799}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"interaction", weight:1.0, description:"Human Beings interact with computers for entertainment and gaming.", created_at:1779236694, source_id:"chunk-41d7d19401b85a866185adb1962d3632"}}, {start: {_id:1406}, end: {_id:3679}, properties:{file_path:"YouTube Video: Unkn