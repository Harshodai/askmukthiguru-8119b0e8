 {_id:8087, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mbhdVEKEbLg)<SEP>unknown_source", entity_type:"concept", truncate:"", description:"Oneness Yoga for Body Bliss is a spiritual platform session providing yoga instructions.<SEP>Oneness Yoga for Body Bliss is a yoga practice program taught through the Mukthi Guru platform, including specific poses and breathing techniques.<SEP>Oneness Yoga for Body Bliss is a yoga practice focusing on breathwork and body awareness to achieve bliss.<SEP>Oneness Yoga for Body Bliss is a yoga practice focusing on breathwork and body awareness to achieve bliss.", created_at:1779728077, source_id:"chunk-36fa56d112cbdc5765c290773877158c<SEP>chunk-308efbb281d63e25861e9d14fd29eb11<SEP>chunk-732d750a0827a995cd3b0ecc80ab6c79", entity_id:"Oneness Yoga for Body Bliss"}}, {_id:8088, properties:{file_path:"unknown_source", entity_type:"method", truncate:"", description:"Deep exhale is a breathing technique involving a forceful exhalation.", created_at:1779727904, source_id:"chunk-ec478c10875545e8ef266c1e5b96452e", entity_id:"Deep Exhale"}}, {_id:8089, properties:{file_path:"unknown_source", entity_type:"method", truncate:"", description:"Straighten knees is an action of extending the legs, often part of a physical exercise.", created_at:1779727904, source_id:"chunk-ec478c10875545e8ef266c1e5b96452e", entity_id:"Straighten Knees"}}, {_id:8090, properties:{file_path:"unknown_source", entity_type:"method", truncate:"", description:"Bend knees is an action of flexing the knees, commonly performed in yoga or meditation.", created_at:1779727904, source_id:"chunk-ec478c10875545e8ef266c1e5b96452e", entity_id:"Bend Knees"}}, {_id:8091, properties:{file_path:"unknown_source", entity_type:"method", truncate:"", description:"Inhaling is a breathing technique central to yoga and meditation practices.`<SEP>Inhaling is the act of drawing air into the lungs, a fundamental part of breathing.", created_at:1779727904, sourc