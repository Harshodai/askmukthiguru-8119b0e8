UNWIND [{start: {_id:537}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)", keywords:"content inclusion,editing", truncate:"", weight:1.0, description:"The YouTube Video includes the Course content, which has been edited with corrections.", created_at:1779686721, source_id:"chunk-fedec056ab462ac623268f5f37e05639"}}, {start: {_id:1804}, end: {_id:7856}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)", truncate:"", keywords:"natural behavior,seasonal movement", weight:1.0, description:"Birds migrate seasonally between Siberia and India, demonstrating a natural destination.", created_at:1779687235, source_id:"chunk-bed30e61f70b382a4a6595c34ba8a934"}}, {start: {_id:1449}, end: {_id:7822}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)", truncate:"", keywords:"contrast,philosophical debate", weight:2.0, description:"Destiny is contrasted between being pre-written versus self-created, with the speaker arguing against pre-written destiny.", created_at:1779687235, source_id:"chunk-bed30e61f70b382a4a6595c34ba8a934"}}, {start: {_id:1696}, end: {_id:4815}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)", truncate:"", keywords:"biological behavior,comparison,survival", weight:2.0, description:"Animals exhibit purposeful behavior (destination) similar to humans, such as seeking food and breeding.<SEP>Animals exhibit purposeful behavior (destination) such as finding food and breeding.", created_at:1779687235, source_id:"chunk-bed30e61f70b382a4a6595c34ba8a934"}}, {start: {_id:238}, end: {_id:7855}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)", keywords:"human agency,necessity", truncate:"", weight:1.0, description:"Self-created destiny requires conscious effort and action to manifest.", created_at:1779687235, source_id:"chunk-bed30e61f70b382a4a6595c34ba8a934"}}, {start: {_id:1449}, end: {_id:7855}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)", truncate:"", keywords:"contrast,philosophical debate", weight:1.0, description:"Destiny is contrasted between being pre-written versus self-created, with the speaker advocating for self-created destiny.", created_at:1779687235, source_id:"chunk-bed30e61f70b382a4a6595c34ba8a934"}}, {start: {_id:4815}, end: {_id:5844}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)", keywords:"life significance,purpose", truncate:"", weight:1.0, description:"Humans require a destination to have a meaningful life, unlike mere survival.", created_at:1779687235, source_id:"chunk-bed30e61f70b382a4a6595c34ba8a934"}}, {start: {_id:4815}, end: {_id:234}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)", keywords:"life significance,purpose", truncate:"", weight:1.0, description:"A person without a destination lacks purpose, merely surviving like an animal.", created_at:1779687235, source_id:"chunk-bed30e61f70b382a4a6595c34ba8a934"}}, {start: {_id:7862}, end: {_id:7861}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oZRQoiRe7s4)", truncate:"", keywords:"behavioral demands,relationship expectations", weight:1.0, description:"Idealized love includes the expectation of undivided attention from the partner.", created_at:1779687812, source_id:"chunk-428c28379181a7cdc217fc69118ccc4d"}}, {start: {_id:900}, end: {_id:7816}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oZRQoiRe7s4)", truncate:"", keywords:"emotional impact,relational consequences", weight:1.0, description:"Possessiveness fosters emotional distance and disconnection in relationships.", created_at:1779687812, source_id:"chunk-428c28379181a7cdc217fc69118ccc4d"}}, {start: {_id:7863}, end: {_id:7861}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oZRQoiRe7s4)", truncate:"", keywords:"behavioral demands,relationship expectations", weight:1.0, description:"Idealized love imposes rigid behavioral expectations on the partner.", created_at:1779687812, source_id:"chunk-428c28379181a7cdc217fc69118ccc4d"}}, {start: {_id:89}, end: {_id:900}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oZRQoiRe7s4)", truncate:"", keywords:"emotional impact,relational consequences", weight:1.0, description:"Anger disrupts communication and deepens relational rifts.", created_at:1779687812, source_id:"chunk-428c28379181a7cdc217fc69118ccc4d"}}, {start: {_id:900}, end: {_id:852}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oZRQoiRe7s4)", truncate:"", keywords:"emotional impact,relational consequences", weight:1.0, description:"Fear of loss or rejection leads to withdrawal and emotional separation.", created_at:1779687812, source_id:"chunk-428c28379181a7cdc217fc69118ccc4d"}}, {start: {_id:900}, end: {_id:7857}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oZRQoiRe7s4)", truncate:"", keywords:"emotional impact,relational consequences", weight:1.0, description:"Judging others creates resentment and erodes trust.", created_at:1779687812, source_id:"chunk-428c28379181a7cdc217fc69118ccc4d"}}, {start: {_id:900}, end: {_id:1185}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oZRQoiRe7s4)", truncate:"", keywords:"emotional impact,relational consequences", weight:1.0, description:"Obsession over a partner's actions results in relational estrangement.", created_at:1779687812, source_id:"chunk-428c28379181a7cdc217fc69118ccc4d"}}, {start: {_id:900}, end: {_id:7861}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oZRQoiRe7s4)", truncate:"", keywords:"emotional impact,relational consequences", weight:1.0, description:"Unmet expectations in idealized love lead to emotional disconnection.", created_at:1779687812, source_id:"chunk-428c28379181a7cdc217fc69118ccc4d"}}, {start: {_id:352}, end: {_id:7865}, properties:{file_path:"unknown_source", keywords:"birthing,sustaining life", truncate:"", weight:1.0, description:"The mother?s role in birthing and sustaining life forms the foundation of the primal relationship.", created_at:1779687913, source_id:"chunk-439f02067105223fb4f1c1b8d3263e52"}}, {start: {_id:352}, end: {_id:4023}, properties:{file_path:"unknown_source", keywords:"biological connection,nurturing", truncate:"", weight:1.0, description:"The womb symbolizes the biological and nurturing connection between mother and child.", created_at:1779687913, source_id:"chunk-439f02067105223fb4f1c1b8d3263e52"}}, {start: {_id:7864}, end: {_id:352}, properties:{file_path:"unknown_source", keywords:"comfort,cultural tradition", truncate:"", weight:1.0, description:"Mothers use lullabies to comfort and pass on cultural traditions to their children.", created_at:1779687913, source_id:"chunk-439f02067105223fb4f1c1b8d3263e52"}}, {start: {_id:352}, end: {_id:7866}, properties:{file_path:"unknown_source", keywords:"teaching love,values", truncate:"", weight:1.0, description:"Soft words from mothers teach love and moral values to their children.", created_at:1779687913, source_id:"chunk-439f02067105223fb4f1c1b8d3263e52"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
