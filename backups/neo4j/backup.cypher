UNWIND [{start: {_id:7021}, end: {_id:116}, properties:{file_path:"YouTube Video: RFx74Q6Oq2c (URL: https://www.youtube.com/watch?v=RFx74Q6Oq2c)<SEP>unknown_source", truncate:"", keywords:"cognitive potential,cosmic design,design,implantation", weight:2.0, description:"The universe is portrayed as having designed humans to possess the lateral frontal pole, a brain structure enabling future-oriented thinking and intelligent decision-making.<SEP>The universe designed the lateral frontal pole in the human brain to enable future-oriented thinking and strategic decision-making.", created_at:1779653313, source_id:"chunk-c58820007a8ce164af9a67cbf25bf444<SEP>chunk-e91a27787e30cafec7220a14b1dcbe86"}}, {start: {_id:4399}, end: {_id:7025}, properties:{file_path:"unknown_source", truncate:"", keywords:"cognitive activation,potential realization", weight:1.0, description:"Consciousness awakening unlocks latent decision-making capabilities for extraordinary outcomes.", created_at:1779653311, source_id:"chunk-e91a27787e30cafec7220a14b1dcbe86"}}, {start: {_id:2081}, end: {_id:7026}, properties:{file_path:"unknown_source", keywords:"fate,possibility manifestation", truncate:"", weight:1.0, description:"Decisions directly determine life outcomes and opportunities across different timeframes.", created_at:1779653311, source_id:"chunk-e91a27787e30cafec7220a14b1dcbe86"}}, {start: {_id:7023}, end: {_id:7022}, properties:{file_path:"unknown_source", keywords:"education,wisdom", truncate:"", weight:1.0, description:"Sessions address the Youth Manifest's principles for personal transformation.", created_at:1779653312, source_id:"chunk-e91a27787e30cafec7220a14b1dcbe86"}}, {start: {_id:7021}, end: {_id:7020}, properties:{file_path:"unknown_source", keywords:"discovery,neuroscience research", truncate:"", weight:1.0, description:"Oxford University conducted a 2017 study identifying the lateral frontal pole's role in human cognition.", created_at:1779653312, source_id:"chunk-e91a27787e30cafec7220a14b1dcbe86"}}, {start: {_id:7027}, end: {_id:7021}, properties:{file_path:"unknown_source", keywords:"decision-making,neuroscience", truncate:"", weight:1.0, description:"The structure enables strategic thinking and future-oriented decision-making unique to humans.", created_at:1779653313, source_id:"chunk-e91a27787e30cafec7220a14b1dcbe86"}}, {start: {_id:2081}, end: {_id:287}, properties:{file_path:"YouTube Video: RFx74Q6Oq2c (URL: https://www.youtube.com/watch?v=RFx74Q6Oq2c)", keywords:"impact,interconnectedness", truncate:"", weight:1.0, description:"Daily decisions shape life's direction and impact its entirety due to interconnected aspects.", created_at:1779653385, source_id:"chunk-fda55ecccb000507a303d6e1d174ab3e"}}, {start: {_id:7032}, end: {_id:7030}, properties:{file_path:"YouTube Video: RFx74Q6Oq2c (URL: https://www.youtube.com/watch?v=RFx74Q6Oq2c)", truncate:"", keywords:"causation,outcome", weight:1.0, description:"Making right decisions through wisdom and consciousness leads to a successful life.", created_at:1779653386, source_id:"chunk-fda55ecccb000507a303d6e1d174ab3e"}}, {start: {_id:7029}, end: {_id:287}, properties:{file_path:"YouTube Video: RFx74Q6Oq2c (URL: https://www.youtube.com/watch?v=RFx74Q6Oq2c)", keywords:"directionality,influence", truncate:"", weight:1.0, description:"Metaphorical forces and currents represent how decisions collectively push life in specific directions.", created_at:1779653386, source_id:"chunk-fda55ecccb000507a303d6e1d174ab3e"}}, {start: {_id:2081}, end: {_id:7033}, properties:{file_path:"YouTube Video: RFx74Q6Oq2c (URL: https://www.youtube.com/watch?v=RFx74Q6Oq2c)", keywords:"guidance,necessity", truncate:"", weight:1.0, description:"Wisdom, awareness, and consciousness are required to make right decisions most of the time.", created_at:1779653386, source_id:"chunk-fda55ecccb000507a303d6e1d174ab3e"}}, {start: {_id:2081}, end: {_id:7034}, properties:{file_path:"YouTube Video: RFx74Q6Oq2c (URL: https://www.youtube.com/watch?v=RFx74Q6Oq2c)", keywords:"guidance,necessity", truncate:"", weight:1.0, description:"Wisdom, awareness, attention, and consciousness are required to make right decisions most of the time.", created_at:1779653386, source_id:"chunk-fda55ecccb000507a303d6e1d174ab3e"}}, {start: {_id:5844}, end: {_id:116}, properties:{file_path:"YouTube Video: RFx74Q6Oq2c (URL: https://www.youtube.com/watch?v=RFx74Q6Oq2c)", truncate:"", keywords:"design,potential implantation", weight:1.0, description:"The universe designed humans to be intelligent decision makers and implanted potential within their brains.", created_at:1779653398, source_id:"chunk-6ef6484c9c5864e2092708e409da731a"}}, {start: {_id:1474}, end: {_id:7022}, properties:{file_path:"YouTube Video: RFx74Q6Oq2c (URL: https://www.youtube.com/watch?v=RFx74Q6Oq2c)", keywords:"education,transformation", truncate:"", weight:1.0, description:"The Youth Manifest is structured to facilitate awakening in consciousness, enabling individuals to activate their inherent potential for extraordinary living.", created_at:1779653398, source_id:"chunk-6ef6484c9c5864e2092708e409da731a"}}, {start: {_id:7024}, end: {_id:7022}, properties:{file_path:"YouTube Video: RFx74Q6Oq2c (URL: https://www.youtube.com/watch?v=RFx74Q6Oq2c)", keywords:"decision-making,guidance", truncate:"", weight:1.0, description:"The Youth Manifest addresses the importance of small daily decisions in achieving extraordinary life by providing frameworks for mindful choices.", created_at:1779653398, source_id:"chunk-6ef6484c9c5864e2092708e409da731a"}}, {start: {_id:1474}, end: {_id:116}, properties:{file_path:"YouTube Video: RFx74Q6Oq2c (URL: https://www.youtube.com/watch?v=RFx74Q6Oq2c)", truncate:"", keywords:"design,potential activation", weight:1.0, description:"The universe's design includes the potential for awakening, which is necessary to activate human potential for an extraordinary life.", created_at:1779653398, source_id:"chunk-6ef6484c9c5864e2092708e409da731a"}}, {start: {_id:1460}, end: {_id:7022}, properties:{file_path:"YouTube Video: RFx74Q6Oq2c (URL: https://www.youtube.com/watch?v=RFx74Q6Oq2c)", keywords:"contrast,education", truncate:"", weight:1.0, description:"The Youth Manifest addresses the misconception that only big decisions matter, emphasizing the importance of small daily decisions.", created_at:1779653398, source_id:"chunk-6ef6484c9c5864e2092708e409da731a"}}, {start: {_id:157}, end: {_id:7042}, properties:{file_path:"unknown_source", keywords:"cause,consequence", truncate:"", weight:1.0, description:"Challenges and uncertainties lead to quitting when emotional states are absent.", created_at:1779653473, source_id:"chunk-f911f447e8921c9205ec53996cfbe423"}}, {start: {_id:2891}, end: {_id:299}, properties:{file_path:"unknown_source", keywords:"connection,motivation", truncate:"", weight:1.0, description:"Love for a life partner exemplifies a sustaining emotional connection.", created_at:1779653473, source_id:"chunk-f911f447e8921c9205ec53996cfbe423"}}, {start: {_id:7035}, end: {_id:1809}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", keywords:"foundation,sustainability", truncate:"", weight:2.0, description:"Drive and willpower require a strong state of consciousness to sustain through challenges.<SEP>Drive and willpower require a strong state of consciousness to be sustainable.", created_at:1779653558, source_id:"chunk-f911f447e8921c9205ec53996cfbe423<SEP>chunk-56da25e7d132b4ecea54c551b7809f75"}}, {start: {_id:7040}, end: {_id:2668}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=9Mv4Thnx9SU)", keywords:"analogy,emotional grounding,foundation", truncate:"", weight:2.0, description:"Willpower depends on roots (emotional connections) for stability.<SEP>Willpower's effectiveness depends on a strong foundation, similar to a tree's roots providing stability.", created_at:1779654075, source_id:"chunk-f911f447e8921c9205ec53996cfbe423<SEP>chunk-46d6abd520d390d99cea37e408f7a403"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
