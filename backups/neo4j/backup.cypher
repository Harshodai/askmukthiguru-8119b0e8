UNWIND [{start: {_id:7577}, end: {_id:1638}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", truncate:"", keywords:"content inclusion,repetition", weight:1.0, description:"The YouTube video contains the repetitive phrase as its central auditory or textual content.", created_at:1779668537, source_id:"chunk-f018cf41e59b4ba83eeeac40a081a9af"}}, {start: {_id:7574}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", keywords:"discussion,example", truncate:"", weight:1.0, description:"The video discusses rhetorical repetition and provides examples of its representation through punctuation.", created_at:1779668590, source_id:"chunk-b0665bc54ec5c34cda1db12508303332"}}, {start: {_id:1978}, end: {_id:7574}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=BkM7IcqUaj0)", keywords:"implementation,solution", truncate:"", weight:1.0, description:"Punctuation is used as a solution to replace repetitive rhetorical structures.", created_at:1779668591, source_id:"chunk-b0665bc54ec5c34cda1db12508303332"}}, {start: {_id:610}, end: {_id:1338}, properties:{file_path:"unknown_source", keywords:"communication,kindness", truncate:"", weight:1.0, description:"Self considers making speech more kind and communicative.", created_at:1779668711, source_id:"chunk-c088c9de5db4ddb6d01a048401214aef"}}, {start: {_id:2128}, end: {_id:430}, properties:{file_path:"unknown_source", keywords:"inability,past limitations", truncate:"", weight:1.0, description:"Childhood involved an inability to change others due to past limitations.", created_at:1779668711, source_id:"chunk-c088c9de5db4ddb6d01a048401214aef"}}, {start: {_id:4615}, end: {_id:610}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"evaluation,expansion,judgment,kindness,love,unity,warmth", truncate:"", weight:3.0, description:"Self's expanded sense of self includes others, fostering unity.<SEP>Self desires others to be more kind, warm, and loving.<SEP>The individual evaluates others' behavior (e.g., kindness, warmth) through questions about their actions and words.", created_at:1779669125, source_id:"chunk-c088c9de5db4ddb6d01a048401214aef<SEP>chunk-607beefb79fd1c2b867abf7979a1dbfc"}}, {start: {_id:1799}, end: {_id:7581}, properties:{file_path:"unknown_source", keywords:"cruelty,exploitation", truncate:"", weight:1.0, description:"Human beings heartlessly killed the pregnant elephant, highlighting violent exploitation of nature.", created_at:1779668723, source_id:"chunk-22e861448de43c78f776c4d84f1409bd"}}, {start: {_id:486}, end: {_id:7582}, properties:{file_path:"unknown_source", keywords:"cultural heritage,spiritual values", truncate:"", weight:1.0, description:"India's tradition of chanting the mantra reflects its historical alignment with compassion for all life.", created_at:1779668723, source_id:"chunk-22e861448de43c78f776c4d84f1409bd"}}, {start: {_id:7578}, end: {_id:7583}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", keywords:"comparison,maternal behavior,nurturing,parental care", truncate:"", weight:2.0, description:"Both elephant and human mothers exhibit nurturing behaviors, with elephants having longer gestation periods.<SEP>The text compares elephant mothers and human mothers in their nurturing behaviors toward offspring.", created_at:1779670597, source_id:"chunk-22e861448de43c78f776c4d84f1409bd<SEP>chunk-fbc362953fe784a8510b72471b749390"}}, {start: {_id:1799}, end: {_id:7580}, properties:{file_path:"unknown_source", truncate:"", keywords:"cultural hypocrisy,moral contradiction", weight:1.0, description:"Worshipping Vinayaka while harming animals is seen as a contradiction in values.", created_at:1779668724, source_id:"chunk-22e861448de43c78f776c4d84f1409bd"}}, {start: {_id:7584}, end: {_id:7585}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"change,influence", weight:1.0, description:"Impacting others can lead to their transformation through conscious support.", created_at:1779668803, source_id:"chunk-f04d03012ed553fb652e4004f39c94d4"}}, {start: {_id:1473}, end: {_id:7587}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"identity shift,self-expansion", weight:1.0, description:"Consciousness transformation leads to an expanded sense of self that includes others.", created_at:1779668803, source_id:"chunk-f04d03012ed553fb652e4004f39c94d4"}}, {start: {_id:7587}, end: {_id:7584}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"causal relationship,empathy,influence,mutual influence", weight:2.0, description:"An expanded sense of self enables impact on others through non-judgmental support.<SEP>Transcending individuality creates reciprocal impact dynamics between beings.", created_at:1779669400, source_id:"chunk-f04d03012ed553fb652e4004f39c94d4<SEP>chunk-7aa2539edad7b667d56ec7a44037cb45"}}, {start: {_id:7586}, end: {_id:1473}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"contrast,growth", weight:1.0, description:"Childhood experiences contrast with the current ability to transform others through consciousness.", created_at:1779668803, source_id:"chunk-f04d03012ed553fb652e4004f39c94d4"}}, {start: {_id:7590}, end: {_id:5621}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"perception shift,unity", truncate:"", weight:1.0, description:"The sense of self expands to include others, dissolving perceived separation (concept).", created_at:1779668956, source_id:"chunk-472321605b70f46b6792fb017a049d8d"}}, {start: {_id:430}, end: {_id:771}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"communication,reflection", truncate:"", weight:1.0, description:"Childhood experiences prompt reflection on kindness in communication and behavior.", created_at:1779668956, source_id:"chunk-472321605b70f46b6792fb017a049d8d"}}, {start: {_id:771}, end: {_id:234}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"expression,method", weight:1.0, description:"Kindness is expressed through direct communication and behavior, as seen in the context of childhood reflections.", created_at:1779668956, source_id:"chunk-472321605b70f46b6792fb017a049d8d"}}, {start: {_id:348}, end: {_id:7591}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"textual expression,video content", weight:1.0, description:"This quote is part of the content featured in the YouTube Video.", created_at:1779668973, source_id:"chunk-af4d2e2579b9e6b4a477f7cbfa2c8ae1"}}, {start: {_id:348}, end: {_id:7592}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"textual expression,video content", weight:1.0, description:"This quote is part of the content featured in the YouTube Video.", created_at:1779668973, source_id:"chunk-af4d2e2579b9e6b4a477f7cbfa2c8ae1"}}, {start: {_id:348}, end: {_id:7594}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"textual expression,video content", weight:1.0, description:"This quote is part of the content featured in the YouTube Video.", created_at:1779668973, source_id:"chunk-af4d2e2579b9e6b4a477f7cbfa2c8ae1"}}] AS row
