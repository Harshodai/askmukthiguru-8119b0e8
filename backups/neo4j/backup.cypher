UNWIND [{start: {_id:299}, end: {_id:5614}, properties:{file_path:"unknown_source<SEP>YouTube Video: 3WnNyhhB_4w (URL: https://www.youtube.com/watch?v=3WnNyhhB_4w)<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", keywords:"aspect,broader category,contrast,love,romantic love,subset", truncate:"", weight:3.0, created_at:1779557056, description:"Romantic love is contrasted with the deeper, conscious connection of true love.<SEP>Romantic love is a specific form of love that humanity runs behind.<SEP>Romantic love is a subset of universal love, emphasizing transient pleasure.", source_id:"chunk-30e3bfda839778033ca7e4ddfabb670b<SEP>chunk-811e6c42c9ccf4bfac70459d1ccf2336<SEP>chunk-463088ccb7af0ca596d7f4a288f68a78"}}, {start: {_id:299}, end: {_id:5615}, properties:{file_path:"YouTube Video: 3WnNyhhB_4w (URL: https://www.youtube.com/watch?v=3WnNyhhB_4w)", truncate:"", keywords:"discussion topic,educational content", weight:1.0, description:"The video discusses love as a universal phenomenon and its characteristics.", created_at:1779519835, source_id:"chunk-811e6c42c9ccf4bfac70459d1ccf2336"}}, {start: {_id:299}, end: {_id:5616}, properties:{file_path:"YouTube Video: 3WnNyhhB_4w (URL: https://www.youtube.com/watch?v=3WnNyhhB_4w)<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", keywords:"love,manifestation,radiance,symbolism", truncate:"", weight:2.0, description:"Radiance is a quality that shines from those in love.<SEP>Love is symbolized as radiance, a luminous force emanating from consciousness.", created_at:1779557206, source_id:"chunk-811e6c42c9ccf4bfac70459d1ccf2336<SEP>chunk-1d477f5607ac5cfb56e2b711bd58f1aa"}}, {start: {_id:299}, end: {_id:5617}, properties:{file_path:"YouTube Video: 3WnNyhhB_4w (URL: https://www.youtube.com/watch?v=3WnNyhhB_4w)", keywords:"love,romantic high", truncate:"", weight:1.0, description:"Romantic high is a momentary feeling of love, distinct from love.", created_at:1779519836, source_id:"chunk-811e6c42c9ccf4bfac70459d1ccf2336"}}, {start: {_id:1887}, end: {_id:1469}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", truncate:"", keywords:"destruction,environmental impact", weight:1.0, description:"War causes irreversible damage to the global ecosystem.", created_at:1779519902, source_id:"chunk-ab90f4a2ea15bf468182f88153f57ef6"}}, {start: {_id:4515}, end: {_id:5620}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", truncate:"", keywords:"energy expenditure,negative outcome", weight:1.0, description:"Foolishness leads to wasting energy on hating others, resulting in no meaningful life achievements.", created_at:1779519902, source_id:"chunk-ab90f4a2ea15bf468182f88153f57ef6"}}, {start: {_id:5618}, end: {_id:1469}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", truncate:"", keywords:"destruction,economic impact", weight:1.0, description:"War leads to the collapse of national economies and resource instability.", created_at:1779519902, source_id:"chunk-ab90f4a2ea15bf468182f88153f57ef6"}}, {start: {_id:5619}, end: {_id:1469}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)<SEP>unknown_source", truncate:"", keywords:"cause,humanitarian impact,resource diversion,social impact", weight:2.0, description:"War exacerbates famine by diverting resources from addressing hunger.<SEP>War causes famine by diverting resources from addressing critical humanitarian needs.", created_at:1779519924, source_id:"chunk-ab90f4a2ea15bf468182f88153f57ef6<SEP>chunk-7abe568e63ed3025b11ad246b7eb6e12"}}, {start: {_id:4515}, end: {_id:2137}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", truncate:"", keywords:"energy investment,positive outcome", weight:1.0, description:"Wisdom involves investing energy in growth and constructive activities for personal and collective benefit.", created_at:1779519902, source_id:"chunk-ab90f4a2ea15bf468182f88153f57ef6"}}, {start: {_id:4603}, end: {_id:1469}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", truncate:"", keywords:"hidden motives,instigation", weight:1.0, description:"War is instigated by selfish reasons such as power, authority, control, or riches, despite being framed as noble causes.", created_at:1779519903, source_id:"chunk-ab90f4a2ea15bf468182f88153f57ef6"}}, {start: {_id:1799}, end: {_id:1469}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", keywords:"consequences,suffering", truncate:"", weight:1.0, description:"War inflicts long-term trauma and suffering on human beings across generations.", created_at:1779519923, source_id:"chunk-ab90f4a2ea15bf468182f88153f57ef6"}}, {start: {_id:2963}, end: {_id:755}, properties:{file_path:"unknown_source", keywords:"meditation,prevention", truncate:"", weight:1.0, description:"Peace in collective consciousness can dissipate wars through meditation.", created_at:1779519923, source_id:"chunk-7abe568e63ed3025b11ad246b7eb6e12"}}, {start: {_id:3271}, end: {_id:1469}, properties:{file_path:"unknown_source", keywords:"cause,effect,mental infection", truncate:"", weight:2.0, description:"War is instigated by violence in human minds, a 70,000-year-old mental infection.<SEP>Violence is a cause of war.", created_at:1779520632, source_id:"chunk-7abe568e63ed3025b11ad246b7eb6e12<SEP>chunk-8ae1e84c94c9daf68cd33af74bbc6fbf"}}, {start: {_id:2963}, end: {_id:5350}, properties:{file_path:"unknown_source", keywords:"emergence,instability", truncate:"", weight:1.0, description:"Egoistic leaders emerge from collective unawareness and contribute to global instability.", created_at:1779519924, source_id:"chunk-7abe568e63ed3025b11ad246b7eb6e12"}}, {start: {_id:453}, end: {_id:755}, properties:{file_path:"unknown_source", keywords:"positive outcome,prosperity", truncate:"", weight:1.0, description:"Collective peace fosters abundance through spiritual growth and reduced conflict.", created_at:1779519924, source_id:"chunk-7abe568e63ed3025b11ad246b7eb6e12"}}, {start: {_id:5619}, end: {_id:5366}, properties:{file_path:"unknown_source", keywords:"financial impact,resource diversion", truncate:"", weight:1.0, description:"Less than 3% of war spending could end global starvation.", created_at:1779519924, source_id:"chunk-7abe568e63ed3025b11ad246b7eb6e12"}}, {start: {_id:5622}, end: {_id:5621}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", truncate:"", keywords:"behavior,psychological impact", weight:1.0, description:"A denser sense of self leads to a desire to control and dominate others.", created_at:1779519946, source_id:"chunk-60af06a20529afe356c9b2c29e286a87"}}, {start: {_id:5346}, end: {_id:5621}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", keywords:"inheritance,transmission", truncate:"", weight:1.0, description:"The mental infection of violence is passed on through generations and communities, affecting the sense of self.", created_at:1779519946, source_id:"chunk-60af06a20529afe356c9b2c29e286a87"}}, {start: {_id:2402}, end: {_id:5346}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", keywords:"prevention,solution", truncate:"", weight:1.0, description:"Growth is presented as a way to overcome the mental infection of violence.", created_at:1779519946, source_id:"chunk-60af06a20529afe356c9b2c29e286a87"}}, {start: {_id:5624}, end: {_id:5626}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", keywords:"prevents,societal balance", truncate:"", weight:1.0, description:"Collective peace neutralizes the rise of egoistic leaders by fostering harmony.", created_at:1779519970, source_id:"chunk-3262d5415ded94fc1fc56ae56e675a4b"}}] AS row
