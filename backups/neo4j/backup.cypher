UNWIND [{start: {_id:3464}, end: {_id:3463}, properties:{file_path:"unknown_source", keywords:"metaphor,symbolism", truncate:"", weight:1.0, description:"The Chhataka bird's refusal to drink from ponds symbolizes living a life free of suffering, waiting for rainwater instead.", created_at:1779230277, source_id:"chunk-86019daf1852abb84546a1585e862173"}}, {start: {_id:3464}, end: {_id:287}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=MKOAMUmZ-RA)", keywords:"ideal state,metaphor", truncate:"", weight:1.0, description:"The bird serves as a metaphor for living life from an enlightened, suffering-free perspective.", created_at:1779230345, source_id:"chunk-8ae7d2bf13d490cfea1a9347ee1a6a78"}}, {start: {_id:3474}, end: {_id:3470}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)", truncate:"", keywords:"iconography,repetition,symbolic representation,symbolism", weight:2.0, description:"The lotus is repeatedly mentioned as part of Mahalakshmi's form to emphasize divine beauty.<SEP>The lotus is a defining attribute in Mahalakshmi's form during the ritual visualization.", created_at:1779231203, source_id:"chunk-999724134081683327acbc7368915cf5<SEP>chunk-7dcda87b32c6120a6328a9d38eb2e300"}}, {start: {_id:3473}, end: {_id:3480}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)", truncate:"", keywords:"conceptual framework,instruction", weight:1.0, description:"Chidakasha is defined as the focal point for meditation in the ritual.", created_at:1779231157, source_id:"chunk-999724134081683327acbc7368915cf5"}}, {start: {_id:3478}, end: {_id:3475}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)", truncate:"", keywords:"correction,religious practice,spelling correction,terminology", weight:2.0, description:"Correction of \"Mahalakshmi Opasana\" to \"Mahalakshmi Upasana\" for accuracy.<SEP>Correction of \"Opasana\" to \"Upasana\" to reflect accurate terminology for the worship practice.", created_at:1779231179, source_id:"chunk-999724134081683327acbc7368915cf5<SEP>chunk-5969bac7e4ebef9ea84bf92976a3cbfa"}}, {start: {_id:3477}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"analytical focus,content,content subject,source", weight:2.0, description:"The YouTube video is the source of the text being analyzed for errors and corrections.<SEP>The video's text is analyzed to identify linguistic errors.", created_at:1779724245, source_id:"chunk-999724134081683327acbc7368915cf5<SEP>chunk-3db9ad5f02c298caf4a10a42bcc57f29"}}, {start: {_id:3479}, end: {_id:3481}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)", keywords:"recitation,uncertainty", truncate:"", weight:1.0, description:"The mantra is recited during the ritual but noted as potentially corrupted or mixed with other phrases.", created_at:1779231158, source_id:"chunk-999724134081683327acbc7368915cf5"}}, {start: {_id:3476}, end: {_id:3481}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)", keywords:"recitation,uncertainty", truncate:"", weight:1.0, description:"The phrase \"Dadya dayanupavanodravina budhara\" is recited during the ritual, with uncertainty about its correctness or contextual relevance.", created_at:1779231158, source_id:"chunk-999724134081683327acbc7368915cf5"}}, {start: {_id:3487}, end: {_id:3485}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)", truncate:"", keywords:"contextual analysis,contextual consideration,contextual relevance,linguistic analysis,possible correction,semantic match,terminology,typo consideration,typo correction", weight:7.0, created_at:1779231443, description:"Correction of misspelled \"Appendedents\" to \"Appurtenances\" for accurate meaning.<SEP>\"Appendedents\" is hypothesized to be a typo for \"Appurtenances\" due to its contextual relevance to accessories or additional items.<SEP>Appendedents is considered a possible typo for \"Appurtenances\" in the context of accessories or additional items.<SEP>Appendedents is hypothesized to be a typo for \"Appurtenances\" due to contextual relevance to accessories.<SEP>Appendedents is hypothesized to be a typo for Appurtenances, which denotes accessories or supplementary items.<SEP>Appendedents is considered a possible typo for \"Appurtenances\" due to context suggesting accessories or additional items.<SEP>The term \"Appendedents\" is likely a typo for \"Appurtenances\", which refers to accessories or additional items.", source_id:"chunk-5969bac7e4ebef9ea84bf92976a3cbfa<SEP>chunk-53c678de7b319878f854b5b824232f14<SEP>chunk-4295ddd02a3292ede05e5c526f20348c<SEP>chunk-ba305c34677a8ecb23f50488bd7f48af<SEP>chunk-171cae3475dfcb996a091f49a00ad9f0<SEP>chunk-5905b0597e31ce6ff252e83c9b1cdb87<SEP>chunk-d80db01f0c02ebd69b4519719fc6964b"}}, {start: {_id:3470}, end: {_id:3471}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jy4hcpUSBms)", truncate:"", keywords:"deity worship,divine form,divine play,prosperity,religious celebration,ritual timing", weight:3.0, created_at:1779673406, description:"Mahalakshmi is the central deity invoked during the Mahalakshmi Upasana performed on the 4th-6th days of Navaratri.<SEP>Mahalakshmi appears during the fourth-sixth nights to transcend Rajas and guide seekers beyond desire.<SEP>Mahalakshmi's divine play occurs during Navaratri.", source_id:"chunk-7dcda87b32c6120a6328a9d38eb2e300<SEP>chunk-7b3a64aa7e92b879d5649be1dd23a938<SEP>chunk-0ab03500cfe03bdf3ff37b159be99afe"}}, {start: {_id:3475}, end: {_id:3471}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)", truncate:"", keywords:"festival context,ritual timing", weight:1.0, description:"Mahalakshmi Upasana is performed on the 4th-6th days of Navaratri as part of the festival's rituals.", created_at:1779231203, source_id:"chunk-7dcda87b32c6120a6328a9d38eb2e300"}}, {start: {_id:3489}, end: {_id:3483}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)", truncate:"", keywords:"invocation,spiritual connection", weight:1.0, description:"The mantra \"Shreem\" is chanted to invoke blessings from the Divine Mother and connect with her energy.", created_at:1779231231, source_id:"chunk-cdb7e2c2a992ab4d052399a789ce199f"}}, {start: {_id:3473}, end: {_id:3490}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)", keywords:"meditation focus,synonym", truncate:"", weight:1.0, description:"\"Dark Space\" and \"Chidakasha\" refer to the same conceptual space for visualization in meditation.", created_at:1779231231, source_id:"chunk-cdb7e2c2a992ab4d052399a789ce199f"}}, {start: {_id:3455}, end: {_id:1828}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)", truncate:"", keywords:"energy channeling,ritual gesture", weight:1.0, description:"Using the Namaskara Mudra during chanting channels blessings from the Divine Mother.", created_at:1779231231, source_id:"chunk-cdb7e2c2a992ab4d052399a789ce199f"}}, {start: {_id:3470}, end: {_id:3483}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)", keywords:"prosperity,worship", truncate:"", weight:1.0, description:"\"Shreem\" is associated with Mahalakshmi, the goddess of wealth, to attract abundance.", created_at:1779231231, source_id:"chunk-cdb7e2c2a992ab4d052399a789ce199f"}}, {start: {_id:3494}, end: {_id:3487}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)", truncate:"", keywords:"grammatical interpretation,grammatical possibility,less likely,linguistic analysis,linguistic evaluation,possible correction,typo consideration,typo correction", weight:6.0, created_at:1779231444, description:"\"Appendedents\" is considered a potential misspelling of \"Appended\" based on grammatical context and linguistic plausibility.<SEP>Appendedents is also considered a possible typo for \"Appended\".<SEP>Appendedents is considered a potential misspelling of \"Appended\" based on grammatical context.<SEP>Appendedents is also considered a potential misspelling of Appended, a grammatical term indicating addition or attachment.<SEP>Appendedents might be a misspelling of \"Appended\", though less likely than \"Appurtenances\".<SEP>The term \"Appendedents\" could be a typo for \"Appended\", though this is considered less likely.", source_id:"chunk-53c678de7b319878f854b5b824232f14<SEP>chunk-4295ddd02a3292ede05e5c526f20348c<SEP>chunk-ba305c34677a8ecb23f50488bd7f48af<SEP>chunk-171cae3475dfcb996a091f49a00ad9f0<SEP>chunk-5905b0597e31ce6ff252e83c9b1cdb87<SEP>chunk-d80db01f0c02ebd69b4519719fc6964b"}}, {start: {_id:3487}, end: {_id:1782}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)", keywords:"analysis,decision-making", truncate:"", weight:1.0, description:"The speaker critically evaluates \"Appendedents\" and weighs corrections like \"Appurtenances\" and \"Appended\".", created_at:1779231326, source_id:"chunk-ba305c34677a8ecb23f50488bd7f48af"}}, {start: {_id:3485}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)", keywords:"discussion content,source", truncate:"", weight:1.0, description:"The YouTube video discusses \"Appurtenances\" as a potential correction for \"Appendedents.\"", created_at:1779231397, source_id:"chunk-5905b0597e31ce6ff252e83c9b1cdb87"}}, {start: {_id:3487}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)", keywords:"discussion content,source", truncate:"", weight:1.0, description:"The YouTube video contains the discussion about the term \"Appendedents\" and its possible corrections.", created_at:1779231397, source_id:"chunk-5905b0597e31ce6ff252e83c9b1cdb87"}}, {start: {_id:3494}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=V5fBJwo_KQk)", keywords:"discussion content,source", truncate:"", weight:1.0, description:"The YouTube video considers \"Appended\" as a possible correction for \"Appendedents.\"", created_at:1779231397, source_id:"chunk-5905b0597e31ce6ff252e83c9b1cdb87"}}] AS row
