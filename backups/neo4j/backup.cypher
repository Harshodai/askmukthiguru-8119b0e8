UNWIND [{start: {_id:137}, end: {_id:135}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", truncate:"", keywords:"agitation vs. calmness,assistance,beautiful vs. stressful states,conflict,contrast,distress relief,empathy,help,metaphor,representation,rule violation,spiritual lesson,teaching moment,transformation,wisdom", weight:12.0, created_at:1779183637, description:"The relation (Nomi, Yesmi) involves two monks, Nomi and Yesmi, who represent contrasting inner states. Nomi is depicted in a suffering state, characterized by rigidity and stress, while Yesmi embodies a compassionate, problem-solving state. The monks confront each other, with Yesmi attempting to help Nomi alleviate distress through a wise question.

This interaction illustrates the contrast between a compassionate, beautiful state and a rigid, stressful state. The dynamic highlights the difference between carrying burdens (Nomi) and releasing them (Yesmi), as well as the difference between beautiful and stressful states. The monks' interaction serves as a metaphor for inner conflict and the potential for compassionate intervention.<SEP>Nomi and Yesmi represent opposing states of consciousness, with Yesmi enabling transition from suffering.", source_id:"chunk-2c5321682aea240a40b41c720211188a<SEP>chunk-92e23343f6e8c0c72900c7b35b033bb3<SEP>chunk-bdc4a608530faeb54a567f51d21bad5a<SEP>chunk-6299fc30fbbfe258eb23a6bd35458a43<SEP>chunk-23f4ae85323a27ae180ceca7fa33c13a<SEP>chunk-bd28b1a048122e44541304a8505b07db<SEP>chunk-1ba7f5be1d21e67ddd5d6d9988215271<SEP>chunk-81f7d5b351616383eb1a7cca9b4d2b48<SEP>chunk-8b68736730809289d016abf18cb33a9d<SEP>chunk-98ebbba09ead01df2486b7e4f58bcc9b"}}, {start: {_id:141}, end: {_id:138}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"distress,separation", truncate:"", weight:1.0, description:"The woman is distressed because she cannot get back to her toddler.", created_at:1779135853, source_id:"chunk-2c5321682aea240a40b41c720211188a"}}, {start: {_id:139}, end: {_id:135}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"metaphor,representation", truncate:"", weight:3.0, description:"The monks represent the two inner states experienced by all living beings.<SEP>Yesmi represents one of the inner states experienced by all living beings.<SEP>Yesmi symbolizes one of the inner states experienced by all living beings.", created_at:1779135853, source_id:"chunk-2c5321682aea240a40b41c720211188a"}}, {start: {_id:140}, end: {_id:135}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"assistance,rescue", truncate:"", weight:1.0, description:"Yesmi volunteers to help the woman cross the river.", created_at:1779135853, source_id:"chunk-2c5321682aea240a40b41c720211188a"}}, {start: {_id:139}, end: {_id:137}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"metaphor,representation", truncate:"", weight:2.0, description:"Nomi represents the other inner state experienced by all living beings.<SEP>Nomi symbolizes the other inner state experienced by all living beings.", created_at:1779135853, source_id:"chunk-2c5321682aea240a40b41c720211188a"}}, {start: {_id:140}, end: {_id:138}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"natural barrier,obstacle", truncate:"", weight:1.0, description:"The rising waters of the river prevent the woman from crossing.", created_at:1779135853, source_id:"chunk-2c5321682aea240a40b41c720211188a"}}, {start: {_id:137}, end: {_id:38}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", truncate:"", keywords:"character representation,embodiment,overcomplication,representation,state embodiment", weight:3.0, created_at:1779183192, description:"Nomi embodies the suering state in the narrative.<SEP>Nomi?s agitation embodies a suering state, leading him to overcomplicate matters irrationally.<SEP>Nomi represents the \"suering state\" through agitation and overcomplication.", source_id:"chunk-852cc1672a2a3a688bdf18076d61f76f<SEP>chunk-bd28b1a048122e44541304a8505b07db<SEP>chunk-1ba7f5be1d21e67ddd5d6d9988215271"}}, {start: {_id:137}, end: {_id:143}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"problem creation,stress induction", truncate:"", weight:1.0, description:"Nomi created a nonexistent problem in his mind, leading to stress and attempted resolution.", created_at:1779135886, source_id:"chunk-852cc1672a2a3a688bdf18076d61f76f"}}, {start: {_id:144}, end: {_id:50}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"harmonious alignment,intentional outcomes", weight:1.0, description:"Beautiful states trigger synchronicities that align with one's intentions.", created_at:1779135927, source_id:"chunk-a954f0d11042551baf073ae27fdc369d"}}, {start: {_id:146}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"documented concepts,observational findings", weight:1.0, description:"The source document discusses suffering states as destructive patterns observed in consciousness.", created_at:1779135927, source_id:"chunk-a954f0d11042551baf073ae27fdc369d"}}, {start: {_id:29}, end: {_id:145}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"destructive consequences,life challenges", weight:1.0, description:"Suering states lead to life becoming chaotic, with mounting problems and confusion.", created_at:1779135927, source_id:"chunk-a954f0d11042551baf073ae27fdc369d"}}, {start: {_id:50}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"documented concepts,observational findings", weight:1.0, description:"The source document defines synchronicities as meaningful coincidences tied to intentions.", created_at:1779135927, source_id:"chunk-a954f0d11042551baf073ae27fdc369d"}}, {start: {_id:29}, end: {_id:146}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"destructive consequences,life challenges", weight:1.0, description:"Suffering states lead to life becoming chaotic, with mounting problems and confusion.", created_at:1779135927, source_id:"chunk-a954f0d11042551baf073ae27fdc369d"}}, {start: {_id:144}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"documented concepts,observational findings", weight:1.0, description:"The source document describes beautiful states as rejuvenating and life-giving.", created_at:1779135927, source_id:"chunk-a954f0d11042551baf073ae27fdc369d"}}, {start: {_id:145}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"conceptual origin,documented concepts,observational findings,source", weight:2.0, description:"The source document discusses suering states as destructive patterns observed in consciousness.<SEP>The document discusses suffering states as part of its philosophical framework.", created_at:1779144921, source_id:"chunk-a954f0d11042551baf073ae27fdc369d<SEP>chunk-a6edb23148812a00c784704ababdb3ee"}}, {start: {_id:149}, end: {_id:152}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"consciousness impact,manifestation", truncate:"", weight:1.0, description:"Transcendental states enable impact on the fabric of consciousness to manifest aspirations.", created_at:1779135997, source_id:"chunk-2177b8057ec605d01dc4819162240231"}}, {start: {_id:17}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"author,authorship,philosophical discourse,source,spiritual guidance", truncate:"", weight:3.0, created_at:1779136853, description:"Krishnaji authored the document \"The_Four_Sacred_Secrets.pdf\" presenting the discussed concepts.<SEP>Krishnaji authored the text and contributed to its spiritual teachings.<SEP>Krishnaji authored the document discussing emotional states and consciousness.", source_id:"chunk-2177b8057ec605d01dc4819162240231<SEP>chunk-d86f83774f270c01370f6d935b6fb012<SEP>chunk-3a296ec9ad2af5d46dab6c458e4a48dd"}}, {start: {_id:151}, end: {_id:153}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional stages,psychological impact", weight:1.0, description:"Suering encompasses a spectrum of emotional experiences progressing from mild to severe stages.", created_at:1779135997, source_id:"chunk-2177b8057ec605d01dc4819162240231"}}, {start: {_id:151}, end: {_id:154}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"harmful effects,negative consequences", weight:1.0, description:"Prolonging suering is described as damaging and potentially leading to obsessive states.", created_at:1779135997, source_id:"chunk-2177b8057ec605d01dc4819162240231"}}, {start: {_id:156}, end: {_id:160}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"character portrayal,documentary subject", weight:1.0, description:"Tiger Queen (2010) features Machli's story.", created_at:1779136038, source_id:"chunk-38402aa2a9c3bfe289dc137352589b52"}}] AS row
