UNWIND [{_id:7115, properties:{file_path:"YouTube Video: 1PlGMOAypCI (URL: https://www.youtube.com/watch?v=1PlGMOAypCI)", entity_type:"concept", truncate:"", description:"Regulations refer to established rules or laws governing behavior, contrasted with ideals in the text.", created_at:1779655589, source_id:"chunk-bf98c80e4c8e0ceabdc9951dcc42a4ec", entity_id:"Regulations"}}, {_id:7116, properties:{file_path:"YouTube Video: 1PlGMOAypCI (URL: https://www.youtube.com/watch?v=1PlGMOAypCI)", entity_type:"concept", truncate:"", description:"Codes of conduct are practical rules or regulations (e.g., traffic rules, travel regulations) that govern behavior in specific contexts, distinct from idealistic principles.", created_at:1779655593, source_id:"chunk-12740ae94c3469761e52a81015d8effe", entity_id:"Codes of Conduct"}}, {_id:7117, properties:{file_path:"YouTube Video: 1PlGMOAypCI (URL: https://www.youtube.com/watch?v=1PlGMOAypCI)", entity_type:"concept", truncate:"", description:"Moral or ethical conflict arises when ideals clash with practical actions, causing internal and external disharmony.", created_at:1779655593, source_id:"chunk-12740ae94c3469761e52a81015d8effe", entity_id:"Moral or Ethical Conflict"}}, {_id:7118, properties:{file_path:"YouTube Video: 1PlGMOAypCI (URL: https://www.youtube.com/watch?v=1PlGMOAypCI)", entity_type:"UNKNOWN", truncate:"", description:"Ideals define one's sense of self and identity, and determine moral judgments.", created_at:1779655621, source_id:"chunk-12740ae94c3469761e52a81015d8effe", entity_id:"Self-Definition"}}, {_id:7119, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", entity_type:"concept", truncate:"", description:"The text describes a concept where excessive focus on and criticism of one's body leads to negative mental states.", created_at:1779655641, source_id:"chunk-53aef598f36a2b6f13abedf2e8766221", entity_id:"Extreme obsession and judgment over body appearance"}}, {_id:7120, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", entity_type:"concept", truncate:"", description:"The text identifies unhappy human beings as a result of extreme obsession and judgment over body appearance.", created_at:1779655641, source_id:"chunk-53aef598f36a2b6f13abedf2e8766221", entity_id:"Unhappy human beings"}}, {_id:7121, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", entity_type:"concept", truncate:"", description:"The text identifies insecure human beings as a result of extreme obsession and judgment over body appearance.", created_at:1779655641, source_id:"chunk-53aef598f36a2b6f13abedf2e8766221", entity_id:"Insecure human beings"}}, {_id:7122, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", entity_type:"concept", truncate:"", description:"Inner judgment refers to self-perception and evaluation of one's appearance and worth.", created_at:1779655644, source_id:"chunk-4ef399a9836bd5861ce4607a41690699", entity_id:"Inner Judgment"}}, {_id:7123, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", entity_type:"data", truncate:"", description:"Data refers to statistical information about people's impressions of their appearance and self-perception.", created_at:1779655644, source_id:"chunk-4ef399a9836bd5861ce4607a41690699", entity_id:"Data"}}, {_id:7124, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", entity_type:"data", truncate:"", description:"Statistical finding indicating that over 80% of people perceive themselves as less beautiful than others perceive them.", created_at:1779655644, source_id:"chunk-4ef399a9836bd5861ce4607a41690699", entity_id:"80% Statistic"}}, {_id:7125, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", entity_type:"concept", truncate:"", description:"Specialized form of love associated with caregivers that influences self-perception development.", created_at:1779655644, source_id:"chunk-4ef399a9836bd5861ce4607a41690699", entity_id:"Parental or Grandparental Love"}}, {_id:7126, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", entity_type:"concept", truncate:"", description:"Shame around the body is linked to negative self-image and mental health challenges like depression.", created_at:1779655644, source_id:"chunk-4ef399a9836bd5861ce4607a41690699", entity_id:"Shame Around the Body"}}, {_id:7127, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", entity_type:"method", truncate:"", description:"Cosmetic procedures are interventions aimed at altering physical appearance, critiqued in the video as insufficient for achieving lasting happiness.", created_at:1779655664, source_id:"chunk-97eda5ea96b7f1db5f0d7a104094ffd9", entity_id:"Cosmetic Procedures"}}, {_id:7128, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", entity_type:"concept", truncate:"", description:"Physical appearance refers to the external characteristics of the human body and face, central to the video's discussion on self-perception and societal pressures.", created_at:1779655664, source_id:"chunk-97eda5ea96b7f1db5f0d7a104094ffd9", entity_id:"Physical Appearance"}}, {_id:7129, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", entity_type:"concept", truncate:"", description:"Overcome From is a concept representing the corrected phrase.", created_at:1779655684, source_id:"chunk-17c02c595633bd3e57c08b98506f9fb1", entity_id:"Overcome From"}}, {_id:7130, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", entity_type:"concept", truncate:"", description:"Overcome With is a concept representing the original phras