UNWIND [{_id:6997, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=o_eg6YTifRE)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=4ytgjpow498)", entity_type:"concept", truncate:"", description:"The immune system is the body's defense mechanism that destroys invading organisms.<SEP>The body's defense mechanism against foreign invaders, which can be negatively impacted by chronic stress and inflammation.<SEP>The immune system is the body's defense mechanism that destroys invading organisms.<SEP>The immune system is a biological system referenced in the meditation stages impacting bodily functions.<SEP>The immune system defends the body against infections and diseases, requiring strengthening to survive in environments with pathogens.", created_at:1779734201, source_id:"chunk-3da16f4292642f8022ca187ac2cb1ede<SEP>chunk-5aeea4b62735a07173124f3878e34dac<SEP>chunk-cea1285a91ee1aefd87d1e411abeb97b<SEP>chunk-190acc93a27012825956522182c7d1a4", entity_id:"Immune System"}}, {_id:6998, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A severe inflammatory response in the body, often compared to a storm, that can be triggered by prolonged emotional distress.", created_at:1779652907, source_id:"chunk-5aeea4b62735a07173124f3878e34dac", entity_id:"Cytokine Storm"}}, {_id:6999, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The principle that mental and emotional states directly influence physical health and well-being.", created_at:1779652907, source_id:"chunk-5aeea4b62735a07173124f3878e34dac", entity_id:"Mind-Body Connection"}}, {_id:7000, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", entity_type:"concept", truncate:"", description:"Body cells are biological components that communicate to maintain health when in a calm state.<SEP>Body cells are biological components that communicate to maintain health when in a calm state.", created_at:1779652962, source_id:"chunk-a0d5e6f42a0ce75b924e7ae7dbeb9676", entity_id:"Body Cells"}}, {_id:7001, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", entity_type:"concept", truncate:"", description:"Future health is the state of well-being that can be destroyed by an unhappy mind.<SEP>Future health is the state of well-being that can be destroyed by an unhappy mind.", created_at:1779652962, source_id:"chunk-a0d5e6f42a0ce75b924e7ae7dbeb9676", entity_id:"Future Health"}}, {_id:7004, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", entity_type:"content", truncate:"", description:"YouTube video titled \"uZg9XnRub7w\" hosted at https://www.youtube.com/watch?v=uZg9XnRub7w, containing audio content analyzed for linguistic ambiguities.<SEP>YouTube video titled \"uZg9XnRub7w\" hosted on YouTube, referenced as the source of the discussed content.", created_at:1779655069, source_id:"chunk-84ba32121caabf0d9a2977600d6129bc<SEP>chunk-0e9a254b995e0c98e3ca94960e93f701", entity_id:"YouTube Video: uZg9XnRub7w"}}, {_id:7005, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", entity_type:"concept", truncate:"", description:"Subsequent sentence fragment analyzed in connection with the preceding phrase, contributing to the discussion about mental states and linguistic coherence.", created_at:1779653024, source_id:"chunk-84ba32121caabf0d9a2977600d6129bc", entity_id:"Phrase: \"With an unhappy mind\""}}, {_id:7006, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", entity_type:"concept", truncate:"", description:"Phrase under analysis for potential typographical errors or contextual interpretation, discussed in relation to spiritual/self-help