UNWIND [{start: {_id:4862}, end: {_id:348}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"content to be corrected,task input", weight:1.0, description:"The YouTube video contains the sample text that needs to be corrected as part of the task.", created_at:1779413857, source_id:"chunk-5ffb39a92a1dd1b071afec2852568b14"}}, {start: {_id:2097}, end: {_id:4862}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", keywords:"error focus,transcription", truncate:"", weight:1.0, description:"The sample text includes homophones and other errors that need to be corrected.", created_at:1779413857, source_id:"chunk-5ffb39a92a1dd1b071afec2852568b14"}}, {start: {_id:1881}, end: {_id:4862}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"domain-specific,error focus", weight:1.0, description:"The sample text contains domain-specific terms that are part of the correction focus.", created_at:1779413857, source_id:"chunk-5ffb39a92a1dd1b071afec2852568b14"}}, {start: {_id:1790}, end: {_id:4862}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", keywords:"error focus,readability", truncate:"", weight:1.0, description:"The sample text's punctuation and capitalization are part of the correction focus.", created_at:1779413857, source_id:"chunk-5ffb39a92a1dd1b071afec2852568b14"}}, {start: {_id:1789}, end: {_id:4862}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"correction,task requirement", weight:1.0, description:"The sample text must adhere to the specified constraints during correction.", created_at:1779413858, source_id:"chunk-5ffb39a92a1dd1b071afec2852568b14"}}, {start: {_id:1789}, end: {_id:2097}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", keywords:"correction,task focus", truncate:"", weight:1.0, description:"Homophones are a focus area for the correction task.", created_at:1779413858, source_id:"chunk-5ffb39a92a1dd1b071afec2852568b14"}}, {start: {_id:1789}, end: {_id:1881}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", keywords:"correction,task focus", truncate:"", weight:1.0, description:"Domain-specific terms are a focus area for the correction task.", created_at:1779413858, source_id:"chunk-5ffb39a92a1dd1b071afec2852568b14"}}, {start: {_id:1789}, end: {_id:1790}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", keywords:"correction,task focus", truncate:"", weight:1.0, description:"Punctuation and capitalization are a focus area for the correction task.", created_at:1779413858, source_id:"chunk-5ffb39a92a1dd1b071afec2852568b14"}}, {start: {_id:266}, end: {_id:4863}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"proper noun,transcription error", weight:1.0, description:"The Breathing Room's name has inconsistent capitalization, which is a transcription error.", created_at:1779414012, source_id:"chunk-0891d811d05e0ff0fd82c20d195e706c"}}, {start: {_id:266}, end: {_id:2257}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"proper noun,transcription error", weight:1.0, description:"The Breathing Room's name has inconsistent capitalization, which is a transcription error.", created_at:1779414012, source_id:"chunk-0891d811d05e0ff0fd82c20d195e706c"}}, {start: {_id:14}, end: {_id:4865}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"correct formatting,proper noun", weight:1.0, description:"O&O Academy is consistently capitalized as a proper name for the meditation platform.", created_at:1779414054, source_id:"chunk-3a8bed92469d79105da75d0930238822"}}, {start: {_id:266}, end: {_id:4864}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"inconsistent capitalization,proper noun", weight:1.0, description:"Breathing Room is capitalized in some references (e.g., \"Enter the Breathing Room\") but not in others (e.g., \"the Breathing Room platform\"), creating inconsistency.", created_at:1779414054, source_id:"chunk-3a8bed92469d79105da75d0930238822"}}, {start: {_id:266}, end: {_id:4866}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"context,mention", weight:1.0, description:"The error occurs specifically in the mentions of the Breathing Room program within the transcript.", created_at:1779414108, source_id:"chunk-35e8d232b554b659ba6aef9a72d19bb8"}}, {start: {_id:4869}, end: {_id:266}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", keywords:"association,outcome", truncate:"", weight:1.0, description:"The Breathing Room program aims to cultivate beautiful states of calm as part of its practice.", created_at:1779414108, source_id:"chunk-35e8d232b554b659ba6aef9a72d19bb8"}}, {start: {_id:4860}, end: {_id:4867}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", keywords:"development,source", truncate:"", weight:1.0, description:"The academy developed the specially guided meditations mentioned in the video.", created_at:1779414109, source_id:"chunk-35e8d232b554b659ba6aef9a72d19bb8"}}, {start: {_id:4857}, end: {_id:499}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"cause-effect,causes,impact,lifestyle impact,psychological effects,psychological impact", weight:3.0, created_at:1779414275, description:"Modern life's demands perpetuate chronic stress and anxiety.<SEP>Modern life's comforts and connectivity do not prevent prolonged stress and inability to cope with life changes.<SEP>Modern life's pressures lead to chronic stress, manifesting in habits like shallow breathing and anxiety.", source_id:"chunk-455b122fda4addf20dfaf68404d297db<SEP>chunk-4bed43ee7fc71a8a85a60323529265cc<SEP>chunk-61b4ea6aaf1b9ba778cf54922eb9b8fa"}}, {start: {_id:266}, end: {_id:4860}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"collaboration,knowledge sharing", weight:1.0, description:"Breathing Room platform brings meditation practices from the O&O Academy to address modern challenges.", created_at:1779414170, source_id:"chunk-455b122fda4addf20dfaf68404d297db"}}, {start: {_id:4872}, end: {_id:4857}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"paradoxical effects,societal structure", weight:1.0, description:"Global connectivity coexists with fulfillment challenges in modern existence.", created_at:1779414170, source_id:"chunk-455b122fda4addf20dfaf68404d297db"}}, {start: {_id:266}, end: {_id:486}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"cultural origin,headquarters,location", weight:2.0, description:"Breathing Room sources practices from the India-centered O&O Academy.<SEP>Breathing Room is centered in India, drawing from the O&O Academy's local expertise.", created_at:1779414196, source_id:"chunk-455b122fda4addf20dfaf68404d297db<SEP>chunk-09d79ee40c176e3ec0ecf0d2471f0b89"}}, {start: {_id:266}, end: {_id:499}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", keywords:"mental health,remedy", truncate:"", weight:1.0, description:"Breathing Room addresses stress-related breathing habits through meditation.", created_at:1779414172, source_id:"chunk-455b122fda4addf20dfaf68404d297db"}}] AS row
