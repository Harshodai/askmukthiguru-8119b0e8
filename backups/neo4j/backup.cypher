UNWIND [{start: {_id:579}, end: {name:"Serene Mind"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"mindfulness,temporal focus", truncate:"", weight:1.0, description:"Serene Mind involves focusing on the present moment with grace and ease, as described in the text.", created_at:1779138689, source_id:"chunk-dfb4cd1f4b16e36588d2ae2b6b987ae7"}}, {start: {_id:1205}, end: {name:"Serene Mind"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"overcoming despair,psychological practice,solution", truncate:"", weight:2.0, description:"Serene Mind is presented as a method to transcend the Nobody State by fostering emotional detachment and clarity.<SEP>Practicing Serene Mind helps individuals transcend the Nobody State by releasing attachments and self-interest.", created_at:1779187443, source_id:"chunk-6bd5636c13f54dcbb4aa1a8db98334b5<SEP>chunk-d47f9b2e2b97109267ed4aa51e7ce893"}}, {start: {_id:886}, end: {name:"Yoga"}, properties:{file_path:"unknown_source", keywords:"physical recovery,resilience", truncate:"", weight:1.0, description:"Yoga practice helps Moon recover physically and maintain composure post-accident.", created_at:1779186277, source_id:"chunk-5849ade76c5b4eb2790b0b03a838cc07"}}, {start: {_id:3924}, end: {name:"Yoga"}, properties:{file_path:"unknown_source<SEP>YouTube Video: OnAAtrwsfOc (URL: https://www.youtube.com/watch?v=OnAAtrwsfOc)", keywords:"emergence,enlightenment context,historical context,historical origin,origin,spiritual practice", truncate:"", weight:6.0, description:"Yoga originated among the sages of India, who were its original practitioners.<SEP>Yoga emerged among the Sages of India as part of their enlightened teachings.<SEP>Yoga emerged amongst the enlightened Sages of India.<SEP>Yoga is portrayed as emerging among Indian sages pursuing enlightenment, not health practitioners, per the video's analysis.<SEP>Yoga emerged amongst the sages of India.<SEP>Yoga is stated to have emerged amongst the sages of India, not health practitioners.", created_at:1779441650, source_id:"chunk-3c35da3ef16cded7b3dd200cbc19a5f4<SEP>chunk-b0711a74429c017f31e7a7d0d9eeca01<SEP>chunk-d7ea1b9fc81f64e7ae9644bf15bc144a<SEP>chunk-da64ae4026c154e16d22e9bdea555e82<SEP>chunk-fcb0245a76a7b396fd778f0392cfe0f8<SEP>chunk-508a8bdd4417bc922470bc1cee6c4244"}}, {start: {_id:1193}, end: {name:"Yoga"}, properties:{file_path:"unknown_source<SEP>YouTube Video: OnAAtrwsfOc (URL: https://www.youtube.com/watch?v=OnAAtrwsfOc)", keywords:"application,current application,current intention,focus,intended outcome,intended purpose,modern application,purpose", truncate:"", weight:5.0, created_at:1779441604, description:"Yoga is now associated with health as a primary focus.<SEP>Yoga is intended for promoting health as per the text.<SEP>Yoga's purpose includes health as one of its intended outcomes.<SEP>Yoga is framed as being intended for health.<SEP>Health is one of the current intentions of yoga.", source_id:"chunk-3c35da3ef16cded7b3dd200cbc19a5f4<SEP>chunk-b0711a74429c017f31e7a7d0d9eeca01<SEP>chunk-4b35201ea3b2c1a816e4f9f7600e1284<SEP>chunk-cbc63c32944f9f552dca3de43ae2906d<SEP>chunk-fcb0245a76a7b396fd778f0392cfe0f8"}}, {start: {_id:2391}, end: {name:"Yoga"}, properties:{file_path:"unknown_source", keywords:"original purpose,spiritual goal", truncate:"", weight:1.0, description:"Yoga's original purpose was enlightenment, contrasting with its current health and youthfulness focus.", created_at:1779440737, source_id:"chunk-3c35da3ef16cded7b3dd200cbc19a5f4"}}, {start: {_id:5142}, end: {name:"Yoga"}, properties:{file_path:"YouTube Video: OnAAtrwsfOc (URL: https://www.youtube.com/watch?v=OnAAtrwsfOc)", truncate:"", keywords:"contrast,contrasting origin,exclusion,historical contrast,misconception,origin,origin debate", weight:4.0, description:"Yoga emerged among the sages of India, not the health practitioners of India.<SEP>Yoga emerged amongst the enlightened Sages of India rather than the health practitioners of India.<SEP>The video contrasts yoga's emergence among enlightened sages rather than health practitioners, highlighting differing historical narratives.<SEP>The text corrects the misconception that yoga originated with health practitioners, clarifying it emerged with the sages.", created_at:1779441650, source_id:"chunk-b0711a74429c017f31e7a7d0d9eeca01<SEP>chunk-d7ea1b9fc81f64e7ae9644bf15bc144a<SEP>chunk-da64ae4026c154e16d22e9bdea555e82<SEP>chunk-508a8bdd4417bc922470bc1cee6c4244"}}, {start: {_id:5145}, end: {name:"Yoga"}, properties:{file_path:"YouTube Video: OnAAtrwsfOc (URL: https://www.youtube.com/watch?v=OnAAtrwsfOc)", keywords:"perspective,sentiment", truncate:"", weight:1.0, description:"Pessimistic sentiment is expressed toward yoga's perceived loss of greater purpose.", created_at:1779441174, source_id:"chunk-cbc63c32944f9f552dca3de43ae2906d"}}, {start: {_id:5160}, end: {name:"Yoga"}, properties:{file_path:"YouTube Video: OnAAtrwsfOc (URL: https://www.youtube.com/watch?v=OnAAtrwsfOc)", truncate:"", keywords:"current state,lost purpose", weight:1.0, description:"Yoga's greater purpose is lost, and its current purposes are health and youthfulness.", created_at:1779441604, source_id:"chunk-fcb0245a76a7b396fd778f0392cfe0f8"}}, {start: {_id:5882}, end: {name:"Serene Mind"}, properties:{file_path:"YouTube Video: igSp4H0OWLE (URL: https://www.youtube.com/watch?v=igSp4H0OWLE)", truncate:"", keywords:"breathing exercise,meditation technique", weight:1.0, description:"Serene Mind incorporates conscious breathing as a core component.", created_at:1779552070, source_id:"chunk-511a319a40b03fc2d48c14b1ec8da740"}}, {start: {_id:2003}, end: {name:"Serene Mind"}, properties:{file_path:"YouTube Video: igSp4H0OWLE (URL: https://www.youtube.com/watch?v=igSp4H0OWLE)", keywords:"focus,visualization", truncate:"", weight:1.0, description:"The practice involves focusing on the Eyebrow Center to visualize a flame and achieve calm.", created_at:1779552070, source_id:"chunk-511a319a4