UNWIND [{start: {_id:29}, end: {_id:1809}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=gQiIwfA3mlk)", truncate:"", keywords:"causal relationship,emotional influence", weight:1.0, description:"Suffering in consciousness attracts chaos into life experiences.", created_at:1779149760, source_id:"chunk-be5b7210ecbddf5ded747efb6c288c98"}}, {start: {_id:116}, end: {_id:745}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=gQiIwfA3mlk)", truncate:"", keywords:"communication negation,contrast", weight:1.0, description:"Words are explicitly excluded as primary communication method with the universe.\" Similarly for Actions. That's correct.", created_at:1779149760, source_id:"chunk-be5b7210ecbddf5ded747efb6c288c98"}}, {start: {_id:1816}, end: {_id:364}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=gQiIwfA3mlk)", truncate:"", keywords:"behavioral dynamics,natural instinct", weight:1.0, description:"Lions and tigers maintain respectful distance from humans when hungry due to instinct.", created_at:1779149761, source_id:"chunk-be5b7210ecbddf5ded747efb6c288c98"}}, {start: {_id:1805}, end: {_id:1809}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=gQiIwfA3mlk)", truncate:"", keywords:"causal relationship,emotional influence", weight:1.0, description:"Calm consciousness aligns with order and solution-receptivity.", created_at:1779149761, source_id:"chunk-be5b7210ecbddf5ded747efb6c288c98"}}, {start: {_id:1815}, end: {_id:116}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=gQiIwfA3mlk)", truncate:"", keywords:"communication negation,contrast", weight:1.0, description:"Actions/mannerisms are stated as non-determinative in universal communication.", created_at:1779149761, source_id:"chunk-be5b7210ecbddf5ded747efb6c288c98"}}, {start: {_id:1816}, end: {_id:116}, properties:{file_path:"YouTube Video: Un