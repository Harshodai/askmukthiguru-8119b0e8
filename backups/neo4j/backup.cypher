UNWIND [{start: {_id:7844}, end: {_id:7847}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)", keywords:"conditionality,creation", truncate:"", weight:1.0, description:"Living in a connected state allows creating a magical destiny for the child.", created_at:1779676734, source_id:"chunk-8c1ce6f720e86ef2022e1e5ad2755f85"}}, {start: {_id:7845}, end: {_id:7847}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)", keywords:"conditionality,creation", truncate:"", weight:1.0, description:"Living in a beautiful state allows creating a magical destiny for the child.", created_at:1779676734, source_id:"chunk-8c1ce6f720e86ef2022e1e5ad2755f85"}}, {start: {_id:7848}, end: {_id:7847}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)", truncate:"", keywords:"component,method", weight:1.0, description:"Holding an intention and clarity about desires is part of creating the magical destiny.", created_at:1779676734, source_id:"chunk-8c1ce6f720e86ef2022e1e5ad2755f85"}}, {start: {_id:1789}, end: {_id:1619}, properties:{file_path:"unknown_source", keywords:"platform,rules,task", truncate:"", weight:189.0, description:"We need to produce a merged description for the entity or relation \"Constraints, Mukthi Guru\". The input is a list of JSON objects, each with a \"Description\" field. The output should be a plain text summary, multiple paragraphs, objective, third-person, mention the full name of the entity at the beginning, and not exceed 600 tokens.

