UNWIND [{start: {_id:1684}, end: {_id:2096}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)<SEP>unknown_source", truncate:"", keywords:"domain-specific terms,error correction,sound similarity,text correction", weight:2.0, description:"The user's task involves correcting homophones and misheard words.<SEP>The user's task involves identifying and correcting homophones and misheard words.", created_at:1779243046, source_id:"chunk-12bed1be4bf6242f57b4ecc660b06100<SEP>chunk-50f259044416b29784cc45b625bee372"}}, {start: {_id:1760}, end: {_id:2096}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)<SEP>unknown_source", truncate:"", keywords:"readability,text correction", weight:2.0, description:"The user's task involves correcting punctuation and capitalization for readability.<SEP>The user is also correcting punctuation and capitalization for better readability.", created_at:1779243046, source_id:"chunk-12bed1be4bf6242f57b4ecc660b06100<SEP>chunk-50f259044416b29784cc45b625bee372"}}, {start: {_id:1767}, end: {_id:591}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"life cycles,natural patterns", weight:1.0, description:"Human life is characterized by cyclical movements encompassing contrasting states like order/disorder.", created_at:1779217975, source_id:"chunk-cdb6ddc2b47b984a3a935456e27dbbae"}}, {start: {_id:2176}, end: {_id:1768}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", keywords:"philosophy,spirituality", truncate:"", weight:1.0, description:"Ekam Mantra is presented as a spiritual concept central to the text's themes.", created_at:1779217975, source_id:"chunk-cdb6ddc2b47b984a3a935456e27dbbae"}}, {start: {_id:1763}, end: {_id:591}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"cyclical events,life stages", weight:1.0, description:"Birth and death are highlighted as fundamental cyclical events in human existence.", created_at:1779217975, source_id:"chunk-cdb6ddc2b47b984a3a935456e27dbbae"}}, {start: {_id:1765}, end: {_id:591}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"natural fluctuation,well-being", weight:1.0, description:"Health and ill health are framed as inevitable cyclical aspects of human experience.", created_at:1779217976, source_id:"chunk-cdb6ddc2b47b984a3a935456e27dbbae"}}, {start: {_id:1769}, end: {_id:1772}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"collective action,public health", weight:1.0, description:"Seva through staying home aids in containing the epidemic and saving lives globally.", created_at:1779218022, source_id:"chunk-80b6135a8c5f98aa06b34dde60b95f6b"}}, {start: {_id:1770}, end: {_id:179}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", keywords:"renewal,self-reflection", truncate:"", weight:1.0, description:"Gudi Padva promotes introspection and maintaining a beautiful inner state during uncertain times.", created_at:1779218022, source_id:"chunk-80b6135a8c5f98aa06b34dde60b95f6b"}}, {start: {_id:1771}, end: {_id:1679}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"cultural significance,life philosophy", weight:1.0, description:"Ugadi encourages embracing stillness and the wholeness of life experiences.", created_at:1779218022, source_id:"chunk-80b6135a8c5f98aa06b34dde60b95f6b"}}, {start: {_id:1594}, end: {_id:1771}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"personal growth,spiritual practice", weight:1.0, description:"Stillness is advocated as a form of sadhana for individual and familial evolution.", created_at:1779218022, source_id:"chunk-80b6135a8c5f98aa06b34dde60b95f6b"}}, {start: {_id:1770}, end: {_id:1679}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"cultural festivals,shared traditions", weight:1.0, description:"Both festivals emphasize celebrating life and community bonds amidst global challenges.", created_at:1779218022, source_id:"chunk-80b6135a8c5f98aa06b34dde60b95f6b"}}, {start: {_id:1773}, end: {_id:1679}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"celebration,cultural observance", weight:1.0, description:"Dians celebrate Ugadi as part of their traditions during the epidemic.", created_at:1779218077, source_id:"chunk-b2060cce5c790369f1297fb5121e7ed9"}}, {start: {_id:1773}, end: {_id:1758}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"celebration,cultural observance", weight:1.0, description:"Dians celebrate Gudi Padma alongside Ugadi, reflecting their cultural practices.", created_at:1779218077, source_id:"chunk-b2060cce5c790369f1297fb5121e7ed9"}}, {start: {_id:1775}, end: {_id:1776}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", keywords:"orbital motion,physics", truncate:"", weight:1.0, description:"Electrons orbit the nucleus in cyclical paths, governed by quantum mechanical principles.", created_at:1779218114, source_id:"chunk-0c7f86b942d7f89bb8ff0cf5ae6c0035"}}, {start: {_id:1818}, end: {_id:2139}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", keywords:"gravity,orbital motion", truncate:"", weight:1.0, description:"Planets move in cyclical orbits around the Sun due to gravitational forces.", created_at:1779218114, source_id:"chunk-0c7f86b942d7f89bb8ff0cf5ae6c0035"}}, {start: {_id:1792}, end: {_id:1807}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", keywords:"cyclical movement,gravity", truncate:"", weight:1.0, description:"Galaxies orbit the Center of the Universe in cyclical patterns influenced by gravitational dynamics.", created_at:1779218114, source_id:"chunk-0c7f86b942d7f89bb8ff0cf5ae6c0035"}}, {start: {_id:591}, end: {_id:1805}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", keywords:"natural cycles,philosophy", truncate:"", weight:1.0, description:"Human life alternates between phases of order and disorder as part of cyclical natural rhythms.", created_at:1779218114, source_id:"chunk-0c7f86b942d7f89bb8ff0cf5ae6c0035"}}, {start: {_id:1830}, end: {_id:591}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", keywords:"natural cycles,philosophy", truncate:"", weight:1.0, description:"Human life includes cyclical phases of disorder, balancing periods of structured order.", created_at:1779218114, source_id:"chunk-0c7f86b942d7f89bb8ff0cf5ae6c0035"}}, {start: {_id:1683}, end: {_id:1679}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", truncate:"", keywords:"cultural variation,festival", weight:1.0, description:"Gudi Bhadva is presented as a regional counterpart to Ugadi with similar philosophical themes.", created_at:1779218178, source_id:"chunk-27a4dfd2bd2512da5799c450f509330b"}}, {start: {_id:287}, end: {_id:1900}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)", keywords:"celebration,philosophy", truncate:"", weight:1.0, description:"Ugadi or Gudi Bhadva symbolizes life's wholeness and acceptance of all experiences.", created_at:1779218178, source_id:"chunk-27a4dfd2bd2512da5799c450f509330b"}}] AS row
