UNWIND [{start: {_id:4715}, end: {_id:4559}, properties:{file_path:"unknown_source", keywords:"mind's prison,self-realization", truncate:"", weight:1.0, description:"Liberation frees from destructive tendencies in the mind.", created_at:1779404784, source_id:"chunk-0b8200467f9ed7bc0b0109cef2c5f58c"}}, {start: {_id:4716}, end: {_id:4559}, properties:{file_path:"unknown_source", keywords:"mind's prison,self-realization", truncate:"", weight:1.0, description:"Liberation prevents future tendencies from causing suffering.", created_at:1779404785, source_id:"chunk-0b8200467f9ed7bc0b0109cef2c5f58c"}}, {start: {_id:3833}, end: {_id:4722}, properties:{file_path:"unknown_source", keywords:"destruction,impact", truncate:"", weight:1.0, description:"The creature is described as impacting humanity's consciousness, which is a destructive force.", created_at:1779405611, source_id:"chunk-04d56d56ff3befc2a05ebcfab17f9d42"}}, {start: {_id:3833}, end: {_id:1167}, properties:{file_path:"unknown_source", keywords:"participation", truncate:"", weight:1.0, description:"The creature is part of the event's impact, affecting consciousness and purpose.", created_at:1779405612, source_id:"chunk-04d56d56ff3befc2a05ebcfab17f9d42"}}, {start: {_id:1071}, end: {_id:1799}, properties:{file_path:"YouTube Video: q15gR1aGjVs (URL: https://www.youtube.com/watch?v=q15gR1aGjVs)", truncate:"", keywords:"electromagnetic alignment,resonance", weight:1.0, description:"Earth's electromagnetic field resonates at 7.83 Hertz, while human beings emit similar fields but are currently out of sync due to negative emotional states.", created_at:1779405655, source_id:"chunk-e1495814eef87b4611431212c4eeb855"}}, {start: {_id:1071}, end: {_id:4723}, properties:{file_path:"YouTube Video: q15gR1aGjVs (URL: https://www.youtube.com/watch?v=q15gR1aGjVs)", truncate:"", keywords:"environmental impact,rhythmic influence", weight:1.0, description:"Earth's electromagnetic heart governs natural cycles, which are currently disrupted due to humanity's dissonance.", created_at:1779405655, source_id:"chunk-e1495814eef87b4611431212c4eeb855"}}, {start: {_id:1799}, end: {_id:993}, properties:{file_path:"YouTube Video: q15gR1aGjVs (URL: https://www.youtube.com/watch?v=q15gR1aGjVs)", truncate:"", keywords:"emotional dissonance,resonance disruption", weight:1.0, description:"States like depression and anger disrupt human resonance with Earth's magnetic field, causing misalignment.", created_at:1779405655, source_id:"chunk-e1495814eef87b4611431212c4eeb855"}}, {start: {_id:1071}, end: {_id:4724}, properties:{file_path:"YouTube Video: q15gR1aGjVs (URL: https://www.youtube.com/watch?v=q15gR1aGjVs)", keywords:"comprises,part of", truncate:"", weight:1.0, description:"The Earth has a heart (Earth's Heart), which generates its electromagnetic field and vibration.", created_at:1779405655, source_id:"chunk-e1495814eef87b4611431212c4eeb855"}}, {start: {_id:4729}, end: {_id:4730}, properties:{file_path:"unknown_source<SEP>YouTube Video: 8p3zqYg5wuo (URL: https://www.youtube.com/watch?v=8p3zqYg5wuo)", truncate:"", keywords:"communication,consciousness,interaction,universe characteristics", weight:2.0, description:"The Living Universe is characterized by consciousness, enabling communication across all entities.<SEP>The living universe is conscious and communicates with the conscious universe.", created_at:1779406374, source_id:"chunk-85ff6540f61eaa4adc3ec9e5f4057b70<SEP>chunk-53a1844f9e75d5bbffcc37eefcf95719"}}, {start: {_id:1811}, end: {_id:1193}, properties:{file_path:"unknown_source", keywords:"cellular communication,health state", truncate:"", weight:1.0, description:"A perfect state of communication between cells is health.", created_at:1779406323, source_id:"chunk-85ff6540f61eaa4adc3ec9e5f4057b70"}}, {start: {_id:1806}, end: {_id:1808}, properties:{file_path:"unknown_source", truncate:"", keywords:"biological process,cellular communication", weight:1.0, description:"Enzymes and neuropeptides facilitate communication between cells in the human body.", created_at:1779406323, source_id:"chunk-85ff6540f61eaa4adc3ec9e5f4057b70"}}, {start: {_id:1716}, end: {_id:784}, properties:{file_path:"YouTube Video: 8p3zqYg5wuo (URL: https://www.youtube.com/watch?v=8p3zqYg5wuo)", keywords:"communication,interaction", truncate:"", weight:1.0, description:"The human body communicates with cells through enzymes and neuropeptides.", created_at:1779406374, source_id:"chunk-53a1844f9e75d5bbffcc37eefcf95719"}}, {start: {_id:1812}, end: {_id:1798}, properties:{file_path:"YouTube Video: 8p3zqYg5wuo (URL: https://www.youtube.com/watch?v=8p3zqYg5wuo)", truncate:"", keywords:"interaction,non-verbal communication", weight:1.0, description:"Species communicate non-verbally with trees.", created_at:1779406374, source_id:"chunk-53a1844f9e75d5bbffcc37eefcf95719"}}, {start: {_id:784}, end: {_id:1809}, properties:{file_path:"YouTube Video: 8p3zqYg5wuo (URL: https://www.youtube.com/watch?v=8p3zqYg5wuo)", keywords:"communication,interaction", truncate:"", weight:1.0, description:"The human body communicates with the universe through the state of consciousness.", created_at:1779406374, source_id:"chunk-53a1844f9e75d5bbffcc37eefcf95719"}}, {start: {_id:4730}, end: {_id:1812}, properties:{file_path:"YouTube Video: 8p3zqYg5wuo (URL: https://www.youtube.com/watch?v=8p3zqYg5wuo)", keywords:"communication,interaction", truncate:"", weight:1.0, description:"The living universe communicates with different species.", created_at:1779406375, source_id:"chunk-53a1844f9e75d5bbffcc37eefcf95719"}}, {start: {_id:1809}, end: {_id:745}, properties:{file_path:"YouTube Video: 8p3zqYg5wuo (URL: https://www.youtube.com/watch?v=8p3zqYg5wuo)", keywords:"communication,interaction", truncate:"", weight:1.0, description:"The state of consciousness is communicated through words.", created_at:1779406375, source_id:"chunk-53a1844f9e75d5bbffcc37eefcf95719"}}, {start: {_id:4732}, end: {_id:1809}, properties:{file_path:"YouTube Video: 8p3zqYg5wuo (URL: https://www.youtube.com/watch?v=8p3zqYg5wuo)", keywords:"communication,interaction", truncate:"", weight:1.0, description:"The state of consciousness is communicated through actions and behaviors.", created_at:1779406375, source_id:"chunk-53a1844f9e75d5bbffcc37eefcf95719"}}, {start: {_id:2391}, end: {_id:1799}, properties:{file_path:"unknown_source<SEP>YouTube Video: 4Fjf6IQsjQs (URL: https://www.youtube.com/watch?v=4Fjf6IQsjQs)<SEP>YouTube Video: 6j6EGVpQkI8 (URL: https://www.youtube.com/watch?v=6j6EGVpQkI8)", keywords:"conscious utilization,continuity,historical continuity,historical desire,pursuit,transformative potential", truncate:"", weight:4.0, description:"Human beings have continuously pursued enlightenment as a fundamental desire across all civilizations, viewing it as the oldest human pursuit.<SEP>Human beings can create enlightenment by directing the universe's intelligence toward problem-solving and societal improvement.<SEP>Human beings have continuously pursued enlightenment as the oldest human endeavor, transcending civilizational changes and historical fluctuations in culture and language.<SEP>Human beings have persistently sought enlightenment across civilizations as the oldest and most universal human desire.", created_at:1779520523, source_id:"chunk-e3078bf1d851c024b6410b1cee86f48f<SEP>chunk-55cc26bf031f0db4fced411b5d43e45c<SEP>chunk-e7076c6d9101be02063cc3fee9b2fbba<SEP>chunk-e56919e461f379123fc8b4b2380a2a52"}}, {start: {_id:463}, end: {_id:1799}, properties:{file_path:"unknown_source<SEP>YouTube Video: 6j6EGVpQkI8 (URL: https://www.youtube.com/watch?v=6j6EGVpQkI8)", keywords:"cultural evolution,historical context,historical experience,observation", truncate:"", weight:2.0, description:"Human beings have observed and experienced the cyclical rise and fall of civilizations, witnessing cultural and linguistic changes over time.<SEP>Human beings have observed the rise and fall of civilizations, shaping their understanding of enduring pursuits like enlightenment.", created_at:1779520523, source_id:"chunk-e3078bf1d851c024b6410b1cee86f48f<SEP>chunk-e56919e461f379123fc8b4b2380a2a52"}}, {start: {_id:2391}, end: {_id:4735}, properties:{file_path:"YouTube Video: aJIunwxx3NI (URL: https://www.youtube.com/watch?v=aJIunwxx3NI)", truncate:"", keywords:"content,source", weight:1.0, description:"The video serves as a source explaining enlightenment as a state of consciousness free from suffering and historical human pursuit.", created_at:1779407053, source_id:"chunk-40b461a9a6003a76fc21c44ed3a8e6f1"}}] AS row
