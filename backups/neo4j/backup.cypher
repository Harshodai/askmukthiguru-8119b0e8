UNWIND [{start: {name:"Beautiful State"}, end: {_id:2345}, properties:{file_path:"unknown_source", keywords:"compassion,mutual well-being", truncate:"", weight:1.0, description:"Participants wish for each other to reside in a beautiful state.", created_at:1779173095, source_id:"chunk-688e0592e6058a0f8fa853433206f1bf"}}, {start: {name:"Beautiful State"}, end: {_id:2386}, properties:{file_path:"unknown_source", keywords:"effect,outcome", truncate:"", weight:1.0, description:"Living in the beautiful state fosters connection, freedom, and purpose, countering suffering.` - Looks correct.", created_at:1779173152, source_id:"chunk-1fc805671f75f5c49fede8b02e05b8db"}}, {start: {name:"Beautiful State"}, end: {_id:2353}, properties:{file_path:"unknown_source", keywords:"achieving,connection,inner peace", truncate:"", weight:10.0, description:"Yasmi's actions lead to a state of connection and peace.", created_at:1779173153, source_id:"chunk-665f72ba5123be26210ce8f477e2012f"}}, {start: {name:"Beautiful State"}, end: {_id:2356}, properties:{file_path:"unknown_source", keywords:"harmony,unity", truncate:"", weight:1.0, description:"A connected state aligns with a beautiful state to reduce suffering and enhance well-being.", created_at:1779173268, source_id:"chunk-a29dd9226d9c6641c3dfa10db6f15eb5"}}, {start: {name:"Beautiful State"}, end: {_id:284}, properties:{file_path:"unknown_source", keywords:"answer,awareness,condition,healing,interpersonal harmony,self-awareness,support,unity", truncate:"", weight:4.0, description:"The Beautiful State fosters connection to universal intelligence and interconnectedness.<SEP>Connection facilitates healing and support in relationships by allowing individuals to feel connected without boundaries.<SEP>Connection contributes to the beautiful state by fostering unity with others.<SEP>Connection in a beautiful state leads to finding answers to moral dilemmas.", created_at:1779655573, source_id:"chunk-b4387a01e271d1d16068a0288faa84e5<SEP>chunk-5f2b82bf7ee5cac6adf00faf7fb17ffd<SEP>chunk-3d3e1db7059b50ed67e675540955de81<SEP>chunk-a6affe7a665bbb46d2be844611d794d1"}}, {start: {name:"Ekam"}, end: {_id:2391}, properties:{file_path:"unknown_source", keywords:"enlightenment,spiritual practice", truncate:"", weight:1.0, description:"Ekam facilitates experiences of expanded consciousness and divine connection central to enlightenment.", created_at:1779173785, source_id:"chunk-3ba320b05f330dd38ee53d270146e432"}}, {start: {name:"Ekam"}, end: {_id:2388}, properties:{file_path:"unknown_source", truncate:"", keywords:"institutional affiliation,spiritual leadership", weight:1.0, description:"Preetaji is associated with Ekam as a leader discussing enlightenment and consciousness.", created_at:1779173785, source_id:"chunk-3ba320b05f330dd38ee53d270146e432"}}, {start: {name:"Beautiful State"}, end: {_id:2398}, properties:{file_path:"unknown_source", keywords:"consciousness,transformation", truncate:"", weight:1.0, description:"The Beautiful State of consciousness drives the world movement toward collective transformation.>", created_at:1779173785, source_id:"chunk-cb2b247e069cff8e39d34db433289983"}}, {start: {name:"Consciousness"}, end: {_id:2391}, properties:{file_path:"unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)<SEP>YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"attainment,core theme,crisis,experiential state,inner stillness,path to enlightenment,resolution,spiritual journey", truncate:"", weight:5.0, description:"Enlightenment involves expanded consciousness transcending ego and thought.<SEP>The awakening of consciousness through spiritual practice leads to enlightenment as its ultimate destination.<SEP>Consciousness is associated with inner stillness, which is a component of enlightenment.<SEP>Consciousness is associated with inner stillness, which is a component of enlightenment.<SEP>Enlightenment addresses the crisis of a noisy, dissatisfied consciousness.", created_at:1779559887, source_id:"chunk-3ba320b05f330dd38ee53d270146e432<SEP>chunk-eb1bcec2ec4775f87f2a9dcf795a907a<SEP>chunk-d887f374fce140e42345a26a703cd352<SEP>chunk-ff3e80d959eda2affcf9fb1d2dff2880"}}, {start: {name:"Consciousness"}, end: {_id:2398}, properties:{file_path:"unknown_source", keywords:"foundation,transformation", truncate:"", weight:1.0, description:"Consciousness quality forms the foundation for the world movement's transformative potential.>", created_at:1779173786, source_id:"chunk-cb2b247e069cff8e39d34db433289983"}}, {start: {name:"Beautiful State"}, end: {_id:1613}, properties:{file_path:"unknown_source", keywords:"consciousness,state shift", truncate:"", weight:1.0, description:"Meditations help transition the mind to a beautiful state for life transformation.", created_at:1779173789, source_id:"chunk-58262216b12d3a82c0194e2a972ecdde"}}, {start: {name:"Beautiful State"}, end: {_id:2439}, properties:{file_path:"unknown_source", keywords:"impact,transformation", truncate:"", weight:1.0, description:"Sustaining a beautiful state in consciousness leads to profound shifts in life experiences, including external abundance and reduced suffering.", created_at:1779173791, source_id:"chunk-0b9ac55d2cab188fc69b15917905c7be"}}, {start: {name:"Oneness"}, end: {_id:2441}, properties:{file_path:"unknown_source", keywords:"discipline,integration", truncate:"", weight:1.0, description:"Oneness philosophy requires structured practices (e.g., Serene Mind) to bridge inner and external realities permanently.", created_at:1779173791, source_id:"chunk-0b9ac55d2cab188fc69b15917905c7be"}}, {start: {name:"Beautiful State"}, end: {_id:1523}, properties:{file_path:"unknown_source", keywords:"causation,manifestation", truncate:"", weight:1.0, description:"Consistent beautiful states in consciousness create ripple effects in the external world, manifesting as abundance and stability.", created_at:1779173791, source_id:"chunk-0b9ac55d2cab188fc6