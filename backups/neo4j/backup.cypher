UNWIND [{start: {_id:7651}, end: {_id:2232}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"ecological destruction,environmental harm", weight:1.0, description:"Heartlessness toward Mother Earth is tied to humanity's destructive actions against nature.", created_at:1779670618, source_id:"chunk-fbc362953fe784a8510b72471b749390"}}, {start: {_id:7650}, end: {_id:7579}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"action,awareness", weight:1.0, description:"World Environment Day serves as a platform to promote environmental ethics and sustainable practices.", created_at:1779670618, source_id:"chunk-427deb5cc43b417a4dd893f3e73a5d18"}}, {start: {_id:7631}, end: {_id:7579}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"conservation,consumer choices", weight:1.0, description:"Pledging to avoid animal-harm products aligns with protecting endangered species like elephants.", created_at:1779670621, source_id:"chunk-427deb5cc43b417a4dd893f3e73a5d18"}}, {start: {_id:2232}, end: {_id:7582}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", truncate:"", keywords:"blessings,spiritual connection", weight:1.0, description:"Chanting Sarve Jana Sukhino Bhavantu reflects reverence for Mother Earth and all life forms.", created_at:1779670621, source_id:"chunk-427deb5cc43b417a4dd893f3e73a5d18"}}, {start: {_id:7650}, end: {_id:7631}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", keywords:"accountability,compassion", truncate:"", weight:1.0, description:"Apologizing to Mother Elephant underscores ethical responsibility toward endangered species.", created_at:1779670621, source_id:"chunk-427deb5cc43b417a4dd893f3e73a5d18"}}, {start: {_id:1883}, end: {_id:7580}, propert