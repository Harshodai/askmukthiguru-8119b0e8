ce_id:"chunk-a6d5fb2d9a6f95d89ee353ec0e3d3252<SEP>chunk-828fe791bfee22158562b2e56c06c719<SEP>chunk-e9621dc7d3757b01547188c8c828f956", entity_id:"Oprah Winfrey"}}, {_id:882, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"concept", truncate:"", description:"Yoga classes are sessions taught by Moon, contributing to her hectic schedule and personal workload.<SEP>Yoga classes are part of Moon's routine, contributing to her physical resilience post-accident.", created_at:1779186055, source_id:"chunk-bc8e5c6e2903c7efd30d7faf6ff8221b<SEP>chunk-3371fee7dc2e5f20ad27eaf69ba00c32", entity_id:"Yoga Classes"}}, {_id:883, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"content", truncate:"", description:"Personal work refers to Moon's tasks that she needs to catch up on, adding to her hectic schedule.", created_at:1779140333, source_id:"chunk-bc8e5c6e2903c7efd30d7faf6ff8221b", entity_id:"Personal Work"}}, {_id:884, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", entity_type:"concept", truncate:"", description:"The power of mantra refers to the esoteric science of using sound vibrations for spiritual protection and transformation.", created_at:1779212913, source_id:"chunk-242c86adb935c1461785f26c0c3f9e28", entity_id:"Power of Mantra"}}, {_id:885, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"event", truncate:"", description:"The hectic week includes Moon's yoga classes and personal work, causing stress and no respite for her.", created_at:1779140333, source_id:"chunk-bc8e5c6e2903c7efd30d7faf6ff8221b", entity_id:"Hectic Week"}}, {_id:886, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: qQmrTz6i2x4 (URL: https://www.youtube.com/watch?v=qQmrTz6i2x4)<SEP>YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"naturalobject", truncate:"", created_at:1779652356, description:"<think>
