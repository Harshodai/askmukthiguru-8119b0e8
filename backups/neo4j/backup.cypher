UNWIND [{start: {_id:1615}, end: {_id:6559}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"Latin,ancient term", truncate:"", weight:1.0, description:"Spirit is the Latin term for breath, symbolizing divine essence.", created_at:1779563149, source_id:"chunk-7234398961838f3894f5b3cb8bdb630b"}}, {start: {_id:6584}, end: {_id:6581}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"continuity,shared molecules", weight:1.0, description:"Molecules are described as flowing through all living beings, shared with East African animals.", created_at:1779563149, source_id:"chunk-7234398961838f3894f5b3cb8bdb630b"}}, {start: {_id:1615}, end: {_id:6582}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"life force,sacredness", truncate:"", weight:1.0, description:"Breath is considered sacred in ancient wisdom, linked to life force.", created_at:1779563149, source_id:"chunk-7234398961838f3894f5b3cb8bdb630b"}}, {start: {_id:1615}, end: {_id:1703}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"immense power,life force", truncate:"", weight:1.0, description:"Power is attributed to breath, highlighting its immense influence.", created_at:1779563149, source_id:"chunk-7234398961838f3894f5b3cb8bdb630b"}}, {start: {_id:2056}, end: {_id:6580}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"harmony,social transformation", weight:1.0, description:"Enlightened individuals can restore balance through conscious living and promote societal harmony.", created_at:1779563151, source_id:"chunk-10a63ebc48cb5367889fe83878ad4257"}}, {start: {_id:6575}, end: {_id:1068}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"neurological impact,overstimulation", weight:1.0, description:"Excessive stimuli overwhelm the human brain, leading to derangement and loss of creativity.", created_at:1779563151, source_id:"chunk-10a63ebc48cb5367889fe83878ad4257"}}, {start: {_id:3648}, end: {_id:3271}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"desensitization,media influence", weight:1.0, description:"Movies expose audiences to frequent violence, causing desensitization to gore and blood.", created_at:1779563151, source_id:"chunk-10a63ebc48cb5367889fe83878ad4257"}}, {start: {_id:684}, end: {_id:6556}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"cognitive impact,societal influence", weight:1.0, description:"Excess in the civilization negatively impacts children's cognitive development, leading to impoverished brains and reduced creativity.", created_at:1779563151, source_id:"chunk-10a63ebc48cb5367889fe83878ad4257"}}, {start: {_id:2207}, end: {_id:6579}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"imbalance,individualism", truncate:"", weight:1.0, description:"Human beings prioritize individualistic gratification, contributing to societal imbalance and loss of collective harmony.", created_at:1779563151, source_id:"chunk-10a63ebc48cb5367889fe83878ad4257"}}, {start: {_id:6556}, end: {_id:6577}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"chaos,metaphorical comparison", weight:1.0, description:"The civilization's excess-driven behavior is compared to rogue elephants acting chaotically without direction or balance.", created_at:1779563152, source_id:"chunk-10a63ebc48cb5367889fe83878ad4257"}}, {start: {_id:2703}, end: {_id:6575}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"negative correlation,stifling effect", weight:1.0, description:"Excess eliminates boredom, thereby stifling creativity and intellectual growth in children.", created_at:1779563152, source_id:"chunk-10a63ebc48cb5367889fe83878ad4257"}}, {start: {_id:6561}, end: {_id:6590}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"energy channels,physiological impact", weight:1.0, description:"The energy body contains the Ida Nadi, a key channel for lunar energy.", created_at:1779563270, source_id:"chunk-ac91c3a51bfc466fbc02960659f7837d"}}, {start: {_id:486}, end: {_id:2120}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"cultural study,tradition", truncate:"", weight:1.0, description:"Sages in India have studied breath and consciousness for generations.", created_at:1779563270, source_id:"chunk-ac91c3a51bfc466fbc02960659f7837d"}}, {start: {_id:6561}, end: {_id:6592}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"association,brain influence,energy transmission,energy type", weight:2.0, description:"The Ida Nadi carries lunar energy affecting the right brain hemisphere.<SEP>Ida Nadi carries Lunar Energy.", created_at:1779563361, source_id:"chunk-ac91c3a51bfc466fbc02960659f7837d<SEP>chunk-3ed034bb1fbb1592baaabc5e71449be5"}}, {start: {_id:4390}, end: {_id:6563}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"hierarchy,interconnectedness", truncate:"", weight:1.0, description:"The physical body is the smallest of the six interconnected bodies.", created_at:1779563270, source_id:"chunk-ac91c3a51bfc466fbc02960659f7837d"}}, {start: {_id:6593}, end: {_id:5131}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"impact,interdependence", truncate:"", weight:2.0, description:"Energy channels in the Pranamaya Kosha impact overall bodily and mental states.\" But in the entities list, \"Energy Channels\" isn't present. That's a mistake. The original output included a relationship with \"Energy Channels\" as the source entity, but it wasn't listed as an entity. That's an error. So \"Energy Channels\" should be an entity, but it's missing. Therefore, this is a missed entity.<SEP>Energy channels in the Pranamaya Kosha impact overall bodily and mental states.", created_at:1779563271, source_id:"chunk-ac91c3a51bfc466fbc02960659f7837d"}}, {start: {_id:6588}, end: {_id:6563}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"metaphor,structure", truncate:"", weight:1.0, description:"The dolls metaphorically represent the nested and hierarchical nature of the six bodies.", created_at:1779563271, source_id:"chunk-ac91c3a51bfc466fbc02960659f7837d"}}, {start: {_id:6591}, end: {_id:116}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"interconnectedness,scale", truncate:"", weight:1.0, description:"The Bliss body is described as being as large as the universe.", created_at:1779563271, source_id:"chunk-ac91c3a51bfc466fbc02960659f7837d"}}, {start: {_id:738}, end: {_id:1615}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"consciousness,mind", truncate:"", weight:1.0, description:"Breath mastery impacts the body, mind, and consciousness through expanded states.", created_at:1779563329, source_id:"chunk-ac91c3a51bfc466fbc02960659f7837d"}}, {start: {_id:6585}, end: {_id:6581}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"exhalation,inhalation", truncate:"", weight:1.0, description:"The animal in East Africa inhales and exhales the same molecules, demonstrating the cycle of breath.", created_at:1779563329, source_id:"chunk-369c95aae7fc4dbe0b27e0f7e8e427f7"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
