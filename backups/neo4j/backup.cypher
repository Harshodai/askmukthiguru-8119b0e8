UNWIND [{start: {_id:3310}, end: {_id:3261}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"societal impact,violent manifestation", weight:1.0, description:"The Italian rebellion killings exemplify the violent consequences of unaddressed societal anger.`", created_at:1779192613, source_id:"chunk-08f2f333c27085728d7608b7e47baa48"}}, {start: {_id:3303}, end: {_id:861}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"education reform,societal change", weight:1.0, description:"Teachers are tasked with eradicating division and discrimination from young minds.`", created_at:1779192613, source_id:"chunk-08f2f333c27085728d7608b7e47baa48"}}, {start: {_id:3309}, end: {_id:3306}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"generational transmission,systemic discrimination", weight:1.0, description:"Facial and social discrimination are interconnected forms of systemic discrimination passed through generations.`", created_at:1779192613, source_id:"chunk-08f2f333c27085728d7608b7e47baa48"}}, {start: {_id:3304}, end: {_id:3311}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"cultural narratives,value transmission", weight:1.0, description:"Grandparents and parents transmit values of connection and oneness through stories.`", created_at:1779192613, source_id:"chunk-08f2f333c27085728d7608b7e47baa48"}}, {start: {_id:3295}, end: {_id:3271}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"conflict resolution,societal transformation", weight:1.0, description:"Peaceful demonstrations aim to end violence and transform societal behavior.`", created_at:1779192613, source_id:"chunk-08f2f333c27085728d7608b7e47baa48"}}, {start: {_id:1490}, end: {_id:1521}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"collective evolution,inner change", weight:1.0, description:"Meditation for peace seeks to evolve human consciousness and foster inner transformation.`", created_at:1779192613, source_id:"chunk-08f2f333c27085728d7608b7e47baa48"}}, {start: {_id:3302}, end: {_id:3290}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"non-violent change,paradigm shift", weight:1.0, description:"Inner evolution is proposed as a replacement for violent external revolutions.`", created_at:1779192613, source_id:"chunk-08f2f333c27085728d7608b7e47baa48"}}, {start: {_id:3270}, end: {_id:3255}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"address,historical cycles,history,societal issues", weight:2.0, description:"The U.S. has addressed racial violence through ideals but struggles with recurring historical patterns.<SEP>Address racial violence with values and ideals, repeated eruptions.", created_at:1779193793, source_id:"chunk-a466e41ebd2dd29a05776a329c8e9dec<SEP>chunk-acb941e2e31d401b209b5294a9065fb1"}}, {start: {_id:89}, end: {_id:3315}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"cruelty,drive", weight:1.0, description:"Prolonged anger and hate lead to acts like crushing throats or burning homes.", created_at:1779192795, source_id:"chunk-a466e41ebd2dd29a05776a329c8e9dec"}}, {start: {_id:3272}, end: {_id:3270}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"cycles,repeat", weight:1.0, description:"Racial violence has erupted repeatedly in the U.S., suppressed but never fully resolved.", created_at:1779192795, source_id:"chunk-a466e41ebd2dd29a05776a329c8e9dec"}}, {start: {_id:3255}, end: {_id:3282}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"inadequacy,parrot", weight:1.0, description:"America parroted values/ideals without confronting inner truths, insufficient for peace.", created_at:1779192796, source_id:"chunk-a466e41ebd2dd29a05776a329c8e9dec"}}, {start: {_id:533}, end: {_id:3313}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", keywords:"leadership,nurture", truncate:"", weight:1.0, description:"Politicians and leaders must nurture compassion in their consciousness and governance.", created_at:1779192796, source_id:"chunk-a466e41ebd2dd29a05776a329c8e9dec"}}, {start: {_id:3254}, end: {_id:3316}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"discrimination basis,societal issue", weight:1.0, description:"America's discrimination is based on race.", created_at:1779192820, source_id:"chunk-f97c33bc1c34505752dbdf13ce792596"}}, {start: {_id:3090}, end: {_id:3318}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"societal challenge,universal issue", weight:1.0, description:"Discrimination is a fundamental human problem affecting all nations.", created_at:1779192820, source_id:"chunk-f97c33bc1c34505752dbdf13ce792596"}}, {start: {_id:2148}, end: {_id:486}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", keywords:"discrimination basis,societal issue", truncate:"", weight:2.0, description:"India's discrimination is based on caste.<SEP>India discriminates on the basis of caste, which is a form of societal discrimination.", created_at:1779192876, source_id:"chunk-f97c33bc1c34505752dbdf13ce792596<SEP>chunk-1a2d9f9a94f699ed87aa72d476d3870c"}}, {start: {_id:3256}, end: {_id:2392}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", keywords:"discrimination basis,societal issue", truncate:"", weight:2.0, description:"The Middle East's discrimination is based on religion.<SEP>The Middle East discriminates on the basis of religion, which is a form of societal discrimination.", created_at:1779192876, source_id:"chunk-f97c33bc1c34505752dbdf13ce792596<SEP>chunk-1a2d9f9a94f699ed87aa72d476d3870c"}}, {start: {_id:3257}, end: {_id:3317}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", keywords:"discrimination basis,societal issue", truncate:"", weight:2.0, description:"China's discrimination is based on class.<SEP>China discriminates on the basis of class, which is a form of societal discrimination.", created_at:1779192876, source_id:"chunk-f97c33bc1c34505752dbdf13ce792596<SEP>chunk-1a2d9f9a94f699ed87aa72d476d3870c"}}, {start: {_id:292}, end: {_id:1283}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"emotional cause,psychological effect", weight:1.0, description:"Insecurity leads to hate.", created_at:1779192821, source_id:"chunk-f97c33bc1c34505752dbdf13ce792596"}}, {start: {_id:89}, end: {_id:852}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"emotional cause,psychological effect", weight:4.0, description:"Anger leads to fear, which in turn leads to hate.<SEP>Anger leads to fear, which contributes to hate.<SEP>Anger leads to fear.", created_at:1779192821, source_id:"chunk-f97c33bc1c34505752dbdf13ce792596"}}, {start: {_id:852}, end: {_id:292}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", truncate:"", keywords:"emotional cause,emotional progression,psychological effect,societal impact", weight:2.0, description:"Fear leads to hate.<SEP>Fear leads to hate, which spreads as an endless contagion across individuals and generations.", created_at:1779193256, source_id:"chunk-f97c33bc1c34505752dbdf13ce792596<SEP>chunk-0cb21e09915c74bf08c75e2e9b3c1480"}}] AS row
