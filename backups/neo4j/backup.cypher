s:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=yDTGeNo-w0c)", entity_type:"concept", truncate:"", description:"Avistas are the four states of being in Hindu philosophy, including Jagrita, Svapna, Nidra, and Turiya.", created_at:1779147701, source_id:"chunk-daee63fc8106d8a10a17ec73a8e7fc6b", entity_id:"Avistas"}}, {_id:1667, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=yDTGeNo-w0c)", entity_type:"concept", truncate:"", description:"Contemporary challenges related to sleep quality and consciousness states in human beings.", created_at:1779147701, source_id:"chunk-daee63fc8106d8a10a17ec73a8e7fc6b", entity_id:"Modern Sleep Problems"}}, {_id:1668, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=yDTGeNo-w0c)", entity_type:"event", truncate:"", description:"An annual festival held at Akam Kshetra focused on spiritual enlightenment and consciousness exploration.", created_at:1779147701, source_id:"chunk-daee63fc8106d8a10a17ec73a8e7fc6b", entity_id:"Akam Enlightenment Festival"}}, {_id:1669, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=yDTGeNo-w0c)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=odXq5g-Y7gM)", entity_type:"concept", truncate:"", created_at:1779148634, description:"Sleep is a physiological state essential for bodily recovery and health, with patterns that can be corrected through practices like yoga nidra.<SEP>Sleep is closely linked to depression, with bidirectional influence between sleep disturbances and depressive states.", source_id:"chunk-1685a3c1f2fe3dbf55dfa2a4eee6833c<SEP>chunk-a77f1fee05f090e6b596f48781d6d33a<SEP>chunk-f72535558ce867c4994087fd8e358aea", entity_id:"Sleep"}}, {_id:1670, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=yDTGeNo-w0c)", entity_type:"concept", truncate:"", description:"Visualization of a bright star at the center of the eyebrow, spreading light and energy as part of the yoga nidra practice.", created_at:1779147747, source_id:"chunk-7886f1f557a9b4fb1480f7484e40bb20", entity_id:"Star Visualization"}}, {_id:1671, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=yDTGeNo-w0c)", entity_type:"concept", truncate:"", description:"Simultaneous focus on maintaining a calm body and alert mind during yoga nidra.", created_at:1779147747, source_id:"chunk-7886f1f557a9b4fb1480f7484e40bb20", entity_id:"Mind-Body Dual Awareness"}}, {_id:1672, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", entity_type:"concept", truncate:"", description:"Fasting Food involves eating only when digestive fire is active, avoiding unnecessary consumption to support immunity and household balance.<SEP>Fasting Food is one of the four langanams, referring to dietary practices that involve controlled eating habits.", created_at:1779148123, source_id:"chunk-9dee8f46d29882e9ac37655a29e4adbd<SEP>chunk-b7b52be74b8fe2742a9e4d6ec70ae0ec", entity_id:"Fasting Food"}}, {_id:1673, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", entity_type:"concept", truncate:"", description:"Antibodies are biological agents that combat infections, linked to protein intake through eating.<SEP>Antibodies are biological molecules produced by the immune system to neutralize pathogens.", created_at:1779148144, source_id:"chunk-9dee8f46d29882e9ac37655a29e4adbd<SEP>chunk-8beba43872c2a4b73d69ad70815212d9", entity_id:"Antibodies"}}, {_id:1674, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", entity_type:"concept", truncate:"", created_at:1779148144, description:"Fasting Breath refers to controlled breathing practices by ancient yogis to enhance cellular efficiency and positive thinking.<SEP>Fasting Breath is the second langanam in Langanam Parama Avshadam, emphasizing the practice of fasting to balance bodily functions and enhance immunity.<SEP>Fasting breath involves regulating breathing patterns during fasting for optimal digestion.", source_id:"chunk-9dee8f46d29882e9ac37655a29e4adbd<SEP>chunk-5f95b172448640801fae7c555ba54742<SEP>chunk-8beba43872c2a4b73d69ad70815212d9", entity_id:"Fasting Breath"}}, {_id:1675, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Fasting Movement entails stillness and mindfulness to reduce physical and mental restlessness.", created_at:1779147947, source_id:"chunk-9dee8f46d29882e9ac37655a29e4adbd", entity_id:"Fasting Movement"}}, {_id:1676, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Langanam Parama Avashyam is a principle emphasizing fasting practices for holistic health, encompassing food, breath, speech, and movement restraint.", created_at:1779147947, source_id:"chunk-9dee8f46d29882e9ac37655a29e4adbd", entity_id:"Langanam Parama Avashyam"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:1677, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", entity_type:"concept", truncate:"", created_at:1779148144, description:"Immunoglobulins are antibodies derived from dietary proteins that enhance disease resistance.<SEP>Immunoglobulins are antibodies produced by the immune system to combat diseases, derived from dietary proteins.<SEP>Immunoglobulins are proteins that function as antibodies to fight diseases.", source_id:"chunk-9dee8f46d29882e9ac37655a29e4adbd<SEP>chunk-5f95b172448640801fae7c555ba54742<SEP>chunk-8beba43872c2a4b73d69ad70815212d9", entity_id:"Immunoglobulins"}}, {_id:1678, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Fasting from Hurtful Speech involves mindful communication to cultivate Vak Shakti (power of speech) and manifest goals.", created_at:1779147947, source_id:"chunk-9dee8f46d29882e9ac37655a29e4adbd", entity_id:"Fasting from Hurtful Speech"}}, {_id:1679, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=46g5U6v3SGc)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UbCEX5KBbPw)<SEP>YouTube Video: nQpRoOOu5Yc (URL: https://www.youtube.com/watch?v=nQpRoOOu5Yc)", entity_type:"event", truncate:"", description:"{\"Description\": \"We need to produce a merged description of Ugadi, integrating all key information from each description. The descriptions are:\\\
