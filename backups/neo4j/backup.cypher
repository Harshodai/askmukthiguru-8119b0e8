UNWIND [{start: {_id:6419}, end: {_id:6418}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"emotional anchoring,reflection", weight:1.0, description:"The practice uses loving experiences as an emotional anchor to cultivate mindfulness and connection during the daily ritual.", created_at:1779560499, source_id:"chunk-24179c364db0fb884a0fd4e2f2818e29"}}, {start: {_id:1071}, end: {_id:6367}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)<SEP>YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", truncate:"", keywords:"ecological balance,exploitation,interconnectedness,interconnection", weight:2.0, description:"Addressing Earth's problems through awareness of life interconnection activates Mother Nature's restorative power.<SEP>The paradox of becoming the earth one exploits leads to a chance for renewed perception and action.", created_at:1779659025, source_id:"chunk-ffdd34b0438c947d32b8b2d304f135c4<SEP>chunk-c70b663ec8c2f1951db8e07e51d5edd1"}}, {start: {_id:1490}, end: {_id:1395}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"consciousness shift,societal impact", weight:1.0, description:"Leaders' shift toward Oneness transforms their influence on families, organizations, and the world.", created_at:1779560528, source_id:"chunk-ffdd34b0438c947d32b8b2d304f135c4"}}, {start: {_id:6421}, end: {_id:1490}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"chaos prevention,expansion", weight:1.0, description:"Consciously expanding one's social/emotional circumference avoids chaotic disconnection from universal harmony.", created_at:1779560529, source_id:"chunk-ffdd34b0438c947d32b8b2d304f135c4"}}, {start: {_id:29}, end: {_id:6421}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"chaos prevention,expansion", weight:1.0, description:"Consciously expanding one's circumference prevents life from becoming chaotic and disconnected.", created_at:1779560529, source_id:"chunk-ffdd34b0438c947d32b8b2d304f135c4"}}, {start: {_id:1490}, end: {_id:116}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"connection,harmony", truncate:"", weight:1.0, description:"Human consciousness's awareness of universal interconnectedness fosters harmony and balance.", created_at:1779560529, source_id:"chunk-ffdd34b0438c947d32b8b2d304f135c4"}}, {start: {_id:6424}, end: {_id:6423}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"blood flow increase,neurological effect", weight:1.0, description:"The practice increases blood flow to the mid prefrontal cortex.", created_at:1779560586, source_id:"chunk-7ce8fefcf62e47ed9c0240fe4b1abc3e"}}, {start: {_id:6425}, end: {_id:6423}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"blood flow increase,neurological effect", weight:1.0, description:"The practice increases blood flow to the anterior singulate.", created_at:1779560586, source_id:"chunk-7ce8fefcf62e47ed9c0240fe4b1abc3e"}}, {start: {_id:1301}, end: {_id:610}, properties:{file_path:"unknown_source", truncate:"", keywords:"conceptual framework,intellectual exploration", weight:1.0, description:"Self is portrayed as a playground for great intelligence to flow into one's life.", created_at:1779560659, source_id:"chunk-d3b0ed6747a54a9af9e558b6935aa651"}}, {start: {_id:704}, end: {_id:6427}, properties:{file_path:"unknown_source<SEP>YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"causation,neurological,neurological activity,survival mechanism", weight:2.0, description:"The amygdala's overactivity drives the brain's negative bias, rooted in ancient survival mechanisms that prioritized threat detection.<SEP>The amygdala's overactivity perpetuates negative bias, which awareness practices aim to counteract.", created_at:1779561311, source_id:"chunk-1b0c6f6cf5b3451d482de925f92b2a15<SEP>chunk-2c9bcdcac30e6029287eee4161a0477b"}}, {start: {_id:6429}, end: {_id:610}, properties:{file_path:"unknown_source", truncate:"", keywords:"creative expression,dynamic interaction", weight:1.0, description:"Self serves as a conduit for creative energy to manifest in lived experiences.", created_at:1779560659, source_id:"chunk-d3b0ed6747a54a9af9e558b6935aa651"}}, {start: {_id:2483}, end: {_id:6427}, properties:{file_path:"unknown_source", truncate:"", keywords:"emotional balance,rational regulation", weight:1.0, description:"The medial prefrontal cortex counteracts the amygdala's negativity by promoting rational thought and emotional regulation.", created_at:1779560659, source_id:"chunk-1b0c6f6cf5b3451d482de925f92b2a15"}}, {start: {_id:704}, end: {_id:742}, properties:{file_path:"unknown_source<SEP>YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"chaotic imagination,cognitive regulation,emotional balance,mental noise", truncate:"", weight:2.0, description:"Awareness reduces the amygdala's overactivity, silencing chaotic mental projections and fostering calmness.<SEP>Awareness counteracts the amygdala's chaotic imaginings by fostering present-moment focus.", created_at:1779560718, source_id:"chunk-1b0c6f6cf5b3451d482de925f92b2a15<SEP>chunk-3c35c8046e4068fa71b3df5521e81022"}}, {start: {_id:738}, end: {_id:610}, properties:{file_path:"unknown_source", keywords:"critical evaluation,self-perception", truncate:"", weight:1.0, description:"The text prompts reflection on bodily self-image and judgment through direct questioning.", created_at:1779560659, source_id:"chunk-d3b0ed6747a54a9af9e558b6935aa651"}}, {start: {_id:6426}, end: {_id:6427}, properties:{file_path:"unknown_source", keywords:"emotional connection,problem-solving", truncate:"", weight:1.0, description:"Loving conversation mitigates negativity by fostering non-judgmental understanding and collaborative problem-solving.", created_at:1779560659, source_id:"chunk-1b0c6f6cf5b3451d482de925f92b2a15"}}, {start: {_id:1380}, end: {_id:6431}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"memory retention,survival", truncate:"", weight:1.0, description:"In ancient times, remembering threats like tigers was critical for survival, shaping the brain's memory traits.", created_at:1779560665, source_id:"chunk-4d55dfbe4972cfb9a0847506f1eaa432"}}, {start: {_id:1068}, end: {_id:6430}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"attraction,survival mechanism", weight:1.0, description:"The human brain is biologically inclined to retain negative incidents due to evolutionary survival needs.", created_at:1779560667, source_id:"chunk-4d55dfbe4972cfb9a0847506f1eaa432"}}, {start: {_id:1068}, end: {_id:6432}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"less retention,non-stick", truncate:"", weight:1.0, description:"Positive memories do not adhere to the human brain as strongly, leading to reduced retention.", created_at:1779560668, source_id:"chunk-4d55dfbe4972cfb9a0847506f1eaa432"}}, {start: {_id:1380}, end: {_id:788}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"evolutionary adaptation,survival mechanism", weight:1.0, description:"The brain evolved to prioritize negative memories for survival during ancient times.", created_at:1779560715, source_id:"chunk-729a868fcc915b32e3804866576c1ee4"}}, {start: {_id:788}, end: {_id:1200}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"memory retention,threat response", weight:1.0, description:"The brain retained memories of tigers as survival-critical threats.", created_at:1779560715, source_id:"chunk-729a868fcc915b32e3804866576c1ee4"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
