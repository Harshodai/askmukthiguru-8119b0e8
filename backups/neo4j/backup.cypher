UNWIND [{_id:7583, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", entity_type:"concept", truncate:"", created_at:1779670566, description:"Both elephant and human mothers exhibit nurturing behaviors, with elephants having longer gestation periods.<SEP>A human mother engages in nurturing activities like playing, grooming, and raising her child.<SEP>A human mother is described as engaging in nurturing behaviors like playing and grooming with her child, similar to elephant mothers.", source_id:"chunk-22e861448de43c78f776c4d84f1409bd<SEP>chunk-3f4d7d5f1ac5203240b389ee05d9fc5e<SEP>chunk-fbc362953fe784a8510b72471b749390", entity_id:"Human Mother"}}, {_id:7584, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", created_at:1779669373, description:"Impact on others involves influencing or changing others through one's transformed consciousness.<SEP>Impact on others highlights the influence one's actions and consciousness can have on transforming others.<SEP>Impact on others highlights the influence one's actions and consciousness can have on transforming others.<SEP>Impact on Others highlights reciprocal influence in human interactions and shared transformation.", source_id:"chunk-f04d03012ed553fb652e4004f39c94d4<SEP>chunk-4f083f509b73a704942cae198b15e4c6<SEP>chunk-7aa2539edad7b667d56ec7a44037cb45", entity_id:"Impact on Others"}}, {_id:7585, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"Transformation of others refers to creating change in others due to expanded consciousness and support.<SEP>Transformation of Others involves creating meaningful change in others through connection and understanding.", created_at:1779669373, source_id:"chunk-f04d03012ed553fb652e4004f39c94d4<SEP>chunk-7aa2539edad7b667d56ec7a44037cb45", entity_id:"Transformation of Others"}}, {_id:7586, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"Childhood experiences highlight past instances where individuals wished for kindness but could not effect change.<SEP>Childhood experiences are formative memories and interactions that influence adult perspectives and emotional responses.", created_at:1779669234, source_id:"chunk-f04d03012ed553fb652e4004f39c94d4<SEP>chunk-149f1fa94cc8d81b9d634c9e418c534a", entity_id:"Childhood Experiences"}}, {_id:7587, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"Expanded sense of self describes the state where an individual's identity extends beyond their physical body to encompass others.<SEP>The idea that one's sense of self expands beyond the body to include others, leading to transformative actions.<SEP>Expanded Sense of Self refers to the idea of self-awareness extending to include others, highlighted in the transcript's narrative.<SEP>Expanded Sense of Self describes the idea of transcending individual physical limits to include others in one's self-perception.", created_at:1779669373, source_id:"chunk-f04d03012ed553fb652e4004f39c94d4<SEP>chunk-18f022fb885e6a466d44b91626fa7777<SEP>chunk-b56929fa3724f6c3aa9b138899e446f7<SEP>chunk-7aa2539edad7b667d56ec7a44037cb45", entity_id:"Expanded Sense of Self"}}, {_id:7589, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"person", truncate:"", description:"People around you are individuals in one's immediate social environment influenced by one's consciousness.", created_at:1779668922, source_id:"chunk-472321605b70f46b6792fb017a049d8d", entity_id:"People Around You"}}, {_id:7590, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"person", truncate:"", description:"The \"other being\" represents individuals perceived as separate entities in one's social context.", created_at:1779668922, source_id:"chunk-472321605b70f46b6792fb017a049d8d", entity_id:"Other Being"}}, {_id:7591, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"content", truncate:"", description:"\"can this person speak a little more kind\" is a direct quote expressing a request for more kindness in speech.", created_at:1779668937, source_id:"chunk-af4d2e2579b9e6b4a477f7cbfa2c8ae1", entity_id:"can this person speak a little more kind"}}, {_id:7592, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"content", truncate:"", description:"\"can a speech be a little more kind\" is a direct quote suggesting kindness in communication.", created_at:1779668937, source_id:"chunk-af4d2e2579b9e6b4a477f7cbfa2c8ae1", entity_id:"can a speech be a little more kind"}}, {_id:7593, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"content", truncate:"", description:"\"but it did not happen then you couldn't change that person\" is a direct quote reflecting on past limitations in influencing others.", created_at:1779668937, source_id:"chunk-af4d2e2579b9e6b4a477f7cbfa2c8ae1", entity_id:"but it did not happen then you couldn't change that person"}}, {_id:7594, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"content", truncate:"", description:"\"can he be a little more warm\" is a direct quote requesting warmth in behavior.", created_at:1779668937, source_id:"chunk-af4d2e2579b9e6b4a477f7cbfa2c8ae1", entity_id:"can he be a little more warm"}}, {_id:7595, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"content", truncate:"", description:"\"can she be a little more loving\" is a direct quote advocating for loving behavior.", created_at:1779668937, source_id:"chunk-af4d2e2579b9e6b4a477f7cbfa2c8ae1", entity_id:"can she be a little more loving"}}, {_id:7596, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"content", truncate:"", description:"\"but now with your consciousness being transformed you would be able to create the change in that person\" is a direct quote emphasizing personal transformation enabling influence.", created_at:1779668937, source_id:"chunk-af4d2e2579b9e6b4a477f7cbfa2c8ae1", entity_id:"but now with your consciousness being transformed you would be able to create the change in that person"}}, {_id:7597, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"content", truncate:"", description:"\"because you are not no longer in a position where you are sitting and judging the other where you sitting and analyzing the other but actually supporting the other with your arms\" is a direct quote describing a shift from judgment to support.", created_at:1779668937, source_id:"chunk-af4d2e2579b9e6b4a477f7cbfa2c8ae1", entity_id:"because you are not no longer in a position where you are sitting and judging the other where you sitting and analyzing the other but actually supporting the other with your arms"}}, {_id:7598, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"The concept of sitting in a position to judge others, which is contrasted with supporting them.", created_at:1779668976, source_id:"chunk-18f022fb885e6a466d44b91626fa7777", entity_id:"Sitting and Judging the Other"}}, {_id:7599, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"The act of physically supporting others with one's arms, presented as a shift from judgment.", created_at:1779668976, source_id:"chunk-18f022fb885e6a466d44b91626fa7777", entity_id:"Supporting the Other with Your Arms"}}, {_id:7600, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"The act of caring for others, which is part of the expanded sense of self.", created_at:1779668976, source_id:"chunk-18f022fb885e6a466d44b91626fa7777", entity_id:"Caring for the Others"}}, {_id:7601, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"The concept of impacting others, which is related to supporting and caring.", created_at:1779668976, source_id:"chunk-18f022fb885e6a466d44b91626fa7777", entity_id:"Impacting the Others"}}, {_id:7602, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"Supporting others, which is a key action in the expanded sense of self.", created_at:1779668976, source_id:"chunk-18f022fb885e6a466d44b91626fa7777", entity_id:"Supporting the Others"}}, {_id:7603, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"The act of transforming others, which is a result of supporting and impacting them.", created_at:1779668976, source_id:"chunk-18f022fb885e6a466d44b91626fa7777", entity_id:"Transforming the Others"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:7604, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"The word \"kind\" as a potential misheard word for \"kindly,\" which is related to the actions of supporting and caring.", created_at:1779668976, source_id:"chunk-18f022fb885e6a466d44b91626fa7777", entity_id:"Kind"}}, {_id:7605, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"Self-expansion describes the process of the self including others, leading to support and impact on loved ones.", created_at:1779669007, source_id:"chunk-313c3c4bd3fa26c1b3b5e358022a1e6b", entity_id:"Self-Expansion"}}, {_id:7606, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"Clear errors in punctuation and capitalization within the transcription text.<SEP>Clear errors in punctuation and capitalization within the transcription text.", created_at:1779669102, source_id:"chunk-83b5870805a040aa46ebf56e8d1032f7", entity_id:"Punctuation and Capitalization Errors"}}, {_id:7607, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"Grammar refers to the rules governing the structure and usage of language, mentioned in the context of transcription errors versus grammatical concerns.", created_at:1779669157, source_id:"chunk-b56929fa3724f6c3aa9b138899e446f7", entity_id:"Grammar"}}, {_id:7610, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"UNKNOWN", truncate:"", description:"Childhood is characterized by numerous instances and experiences that are reflected upon.", created_at:1779669193, source_id:"chunk-e9d2d065e530e86a6fbd6e76094e9842", entity_id:"Instance"}}, {_id:7611, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"Judging Others refers to evaluating or criticizing others, which is contrasted with supportive behavior.<SEP>Judging others refers to evaluating or analyzing others' actions or character, which is contrasted with supportive behavior in transformed consciousness.<SEP>Judging others refers to evaluating or analyzing others' actions or character, which is contrasted with supportive behavior in transformed consciousness.", created_at:1779669295, source_id:"chunk-c5b629deefcb32f62e58cbc3ee1d28ae<SEP>chunk-4f083f509b73a704942cae198b15e4c6", entity_id:"Judging Others"}}, {_id:7612, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"Expanded Sense is a broader self-perception that includes the sense of self and others.", created_at:1779669209, source_id:"chunk-c5b629deefcb32f62e58cbc3ee1d28ae", entity_id:"Expanded Sense"}}, {_id:7613, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"Supporting Others involves actively aiding or encouraging others, contrasting with judgment or analysis.<SEP>The concept of supporting others with one's arms is discussed as part of the editing plan.<SEP>Supporting others involves providing encouragement and care through physical and emotional means, as described in the text.<SEP>Supporting others involves providing encouragement and care through physical and emotional means, as described in the text.<SEP>Supporting Others refers to physically and emotionally backing individuals through gestures like arm support.", created_at:1779669373, source_id:"chunk-c5b629deefcb32f62e58cbc3ee1d28ae<SEP>chunk-d3241e43fceaf23540d1629ac06a9653<SEP>chunk-4f083f509b73a704942cae198b15e4c6<SEP>chunk-7aa2539edad7b667d56ec7a44037cb45", entity_id:"Supporting Others"}}, {_id:7614, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"UNKNOWN", truncate:"", description:"Supporting Others contrasts with analyzing others, indicating a shift from analysis to support.", created_at:1779669211, source_id:"chunk-c5b629deefcb32f62e58cbc3ee1d28ae", entity_id:"Analyzing Others"}}, {_id:7615, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"method", truncate:"", description:"The method of adding punctuation to fix run-on sentences is proposed.", created_at:1779669212, source_id:"chunk-d3241e43fceaf23540d1629ac06a9653", entity_id:"Correcting Punctuation"}}, {_id:7616, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"method", truncate:"", description:"Capitalizing the first word of sentences is a proposed correction.", created_at:1779669212, source_id:"chunk-d3241e43fceaf23540d1629ac06a9653", entity_id:"Capitalizing Sentences"}}, {_id:7617, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"The idea of expanding one's sense of self to include others is a key theme.", created_at:1779669212, source_id:"chunk-d3241e43fceaf23540d1629ac06a9653", entity_id:"Expanding Sense of Self"}}, {_id:7618, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"method", truncate:"", description:"Breaking up long sentences is part of the editing plan.", created_at:1779669212, source_id:"chunk-d3241e43fceaf23540d1629ac06a9653", entity_id:"Breaking Up Sentences"}}, {_id:7619, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"method", truncate:"", description:"Ignoring domain-specific terms is a strategy to avoid rewriting.", created_at:1779669212, source_id:"chunk-d3241e43fceaf23540d1629ac06a9653", entity_id:"Ignoring Domain Terms"}}, {_id:7620, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"Kindness in communication refers to the quality of being compassionate and considerate in speech and interaction.<SEP>Kindness in communication refers to the quality of being compassionate and considerate in speech and interaction.", created_at:1779669295, source_id:"chunk-4f083f509b73a704942cae198b15e4c6", entity_id:"Kindness in Communication"}}, {_id:7621, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"method", truncate:"", description:"Physical support involves tangible actions like using arms to show care, as described in the context of transformed consciousness.<SEP>Physical support involves tangible actions like using arms to show care, as described in the context of transformed consciousness.", created_at:1779669295, source_id:"chunk-4f083f509b73a704942cae198b15e4c6", entity_id:"Physical Support"}}, {_id:7622, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"Others refers to individuals being supported, impacted, and transformed through expanded sense of self.<SEP>Others refers to individuals being supported, impacted, and transformed through expanded sense of self.", created_at:1779669295, source_id:"chunk-fb3062b3d6881522fcc2387d435da879", entity_id:"others"}}, {_id:7623, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", description:"Change in others results from transformed consciousness and expanded sense of self, manifesting as support and impact.<SEP>Change in others results from transformed consciousness and expanded sense of self, manifesting as support and impact.", created_at:1779669295, source_id:"chunk-fb3062b3d6881522fcc2387d435da879<SEP>chunk-4f083f509b73a704942cae198b15e4c6", entity_id:"Change in Others"}}, {_id:7624, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Respectability is mentioned in relation to shame, where the death of respectability is felt when one is ashamed.", created_at:1779669387, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400", entity_id:"Respectability"}}, {_id:7625, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Ancient Health and Metallurgic Sciences in India are referenced as historical practices that researched conquering death.", created_at:1779669387, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400", entity_id:"Ancient Health and Metallurgic Sciences in India"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:7626, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Identity is referenced as something that can be lost, leading to a sense of death when a part of oneself is lost.", created_at:1779669387, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400", entity_id:"Identity"}}, {_id:7627, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", entity_type:"method", truncate:"", description:"Genetic engineering is a method mentioned as a way to conquer death.<SEP>Genetic engineering is cited as a modern scientific approach to conquering death.<SEP>Genetic engineering is cited as a modern scientific approach to conquering death.", created_at:1779670976, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400<SEP>chunk-8afdbda86ff5c184cd2f7d6fbf294ca1", entity_id:"Genetic Engineering"}}, {_id:7628, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", entity_type:"method", truncate:"", description:"Stem cell research is a method mentioned as a way to conquer death.<SEP>Stem cell research is mentioned as part of scientific efforts to address mortality.<SEP>Stem cell research is mentioned as part of scientific efforts to address mortality.", created_at:1779670976, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400<SEP>chunk-8afdbda86ff5c184cd2f7d6fbf294ca1", entity_id:"Stem Cell Research"}}, {_id:7629, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=W2ZzApmqJmo)", entity_type:"concept", truncate:"", description:"The classical seeker grapples with fundamental questions.<SEP>The classical seeker grapples with existential questions about identity, origin, and purpose, though enlightenment is broadened beyond this archetype.<SEP>The classical seeker grapples with existential questions about identity, origin, and purpose, though enlightenment is broadened beyond this archetype.", created_at:1779671549, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400<SEP>chunk-4d4c85ceafd744808b1dcd571678ad02", entity_id:"Classical Seeker"}}, {_id:7630, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The classical seeker grapples with fundamental questions.", created_at:1779669414, source_id:"chunk-8deb210332b332578c1f4d6ba4fde400", entity_id:"Fundamental Questions"}}, {_id:7631, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", entity_type:"concept", truncate:"", description:"Mother Elephant is noted for holding her baby for an extended period.<SEP>Mother Elephant is a symbolic representation of elephants, highlighting their suffering and the need for compassion.<SEP>Mother Elephant represents elephants as sentient beings deserving compassion and ethical treatment.<SEP>Symbolic representation of suffering and loss in nature due to human actions.", created_at:1779670712, source_id:"chunk-2e8cf037a481fa8f6c03056c638fd995<SEP>chunk-b7f51f52125fd52ba3d4f9070154d664<SEP>chunk-427deb5cc43b417a4dd893f3e73a5d18<SEP>chunk-e4cf02903a0735df8c35d1ebc9a0cf97", entity_id:"Mother Elephant"}}, {_id:7632, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", entity_type:"creature", truncate:"", description:"Baby Elephant is the offspring of a mother elephant, with a prolonged gestation period.", created_at:1779669459, source_id:"chunk-2e8cf037a481fa8f6c03056c638fd995", entity_id:"Baby Elephant"}}, {_id:7633, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", entity_type:"concept", truncate:"", description:"Heartless Killing refers to the act of killing a pregnant elephant, discussed in the text.", created_at:1779669459, source_id:"chunk-2e8cf037a481fa8f6c03056c638fd995", entity_id:"Heartless Killing"}}, {_id:7635, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", entity_type:"UNKNOWN", truncate:"", description:"Human beings are described as stealing life, land, babies, bodies, and future from others through arrogance and entitlement.", created_at:1779669497, source_id:"chunk-3f4d7d5f1ac5203240b389ee05d9fc5e", entity_id:"Life/Land/Babies/Bodies/Future"}}, {_id:7637, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", entity_type:"concept", truncate:"", description:"The global economic system encompassing trade, production, and financial markets.<SEP>The global economy is described as vulnerable to collapse from events like pandemics, impacting livelihoods and stability.", created_at:1779670566, source_id:"chunk-5f51161e463ac960fab8b2a50bc6505c<SEP>chunk-fbc362953fe784a8510b72471b749390", entity_id:"World's Economy"}}, {_id:7638, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=X3LKG0Ycl3A)", entity_type:"concept", truncate:"", description:"Emotional states or sentient experiences in humans or living beings.<SEP>Feeling is an emotional or sensory response validated as correct in the context of experiential engagement.", created_at:1779728755, source_id:"chunk-5f51161e463ac960fab8b2a50bc6505c<SEP>chunk-6f90bcd92d07d52aa1d337005e488437", entity_id:"Feeling"}}, {_id:7639, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", entity_type:"concept", truncate:"", created_at:1779670566, description:"A Sanskrit phrase meaning \"May all the worlds be happy,\" emphasizing collective welfare.<SEP>Lokan Samastan Sukhino Bhavantu is a Sanskrit phrase meaning \"May all beings be happy and prosperous.\"<SEP>Lokan Samastan Sukhino Bhavantu is a Sanskrit mantra extending blessings to all living creatures.", source_id:"chunk-5f51161e463ac960fab8b2a50bc6505c<SEP>chunk-b7f51f52125fd52ba3d4f9070154d664<SEP>chunk-427deb5cc43b417a4dd893f3e73a5d18", entity_id:"Lokan Samastan Sukhino Bhavantu"}}, {_id:7640, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=07NOYJmkkFo)", entity_type:"naturalobject", truncate:"", created_at:1779717683, description:"Elephants are large mammals recognized for their intelligence and significant ecological roles within ecosystems. In the source text, they are identified as natural objects, appearing in the list of natural objects without transcription errors. This classification underscores their presence as part of the natural objects category in the original material.", source_id:"chunk-5f51161e463ac960fab8b2a50bc6505c<SEP>chunk-fbc362953fe784a8510b72471b749390<SEP>chunk-8bb4cd3f15349f29218db621b3677f01<SEP>chunk-b08f45193924d9c9045e2c6dd99944d2<SEP>chunk-718eaa0299a4e69592d1bfeffc841e25", entity_id:"Elephants"}}, {_id:7641, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", entity_type:"concept", truncate:"", description:"The decision to avoid purchasing objects that harm animals is a call for ethical consumption.", created_at:1779669594, source_id:"chunk-b7f51f52125fd52ba3d4f9070154d664", entity_id:"Decision to not buy harmful objects"}}, {_id:7642, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", entity_type:"naturalobject", truncate:"", description:"Mother Earth's creatures refers to all living beings on Earth, including animals.<SEP>Mother Earth's creatures are entities mentioned in the input text, with possessive form discussed.", created_at:1779670792, source_id:"chunk-b7f51f52125fd52ba3d4f9070154d664<SEP>chunk-26a7443eb36f08fd3454645b1347212b", entity_id:"Mother Earth's creatures"}}, {_id:7643, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", entity_type:"concept", truncate:"", description:"Mother Elephant's suffering highlights the pain and harm inflicted on elephants, often for human use.", created_at:1779669594, source_id:"chunk-b7f51f52125fd52ba3d4f9070154d664", entity_id:"Mother Elephant's suffering"}}, {_id:7644, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", entity_type:"concept", truncate:"", description:"Harm caused to animals in the creation of objects of beauty or prestige, as mentioned in the quoted text.", created_at:1779669622, source_id:"chunk-809f983a7cfe15bffeec6a7d03608d1b", entity_id:"Animal Harm"}}, {_id:7645, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", entity_type:"concept", truncate:"", description:"An item or entity perceived as beautiful or prestigious, potentially created through processes involving harm to animals, as discussed in the quoted text.<SEP>Refers to items valued for aesthetic or status purposes, potentially linked to unethical production.", created_at:1779670641, source_id:"chunk-809f983a7cfe15bffeec6a7d03608d1b<SEP>chunk-c97736465adbd1c78f127386c0a694a1", entity_id:"Object of Beauty or Prestige"}}, {_id:7648, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", entity_type:"naturalobject", truncate:"", description:"Elephants are large land mammals known for their intelligence, social behavior, and ecological importance.", created_at:1779669650, source_id:"chunk-5c12b3ed0b19bd1ebb50b224bafcfb2e", entity_id:"elephants"}}, {_id:7649, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=VTx4G0KEuUE)", entity_type:"concept", truncate:"", description:"A virus represents a catastrophic threat capable of causing widespread death and economic devastation.", created_at:1779670566, source_id:"chunk-fbc362953fe784a8510b72471b749390", entity_id:"One Simple Virus"}}] AS row
