d: {_id:252}, properties:{file_path:"unknown_source", keywords:"connection,nurturing", truncate:"", weight:1.0, description:"Organizations nurture individuals by promoting judgment-free spaces and connected dialogue.", created_at:1779400756, source_id:"chunk-54304c335de80180a629fdfe3979a92e"}}, {start: {_id:4597}, end: {_id:598}, properties:{file_path:"unknown_source", keywords:"avoidance,non-judgmental", truncate:"", weight:1.0, description:"Holding space requires consciously avoiding judgment to prevent tension and foster connection.", created_at:1779400756, source_id:"chunk-54304c335de80180a629fdfe3979a92e"}}, {start: {_id:4593}, end: {_id:252}, properties:{file_path:"unknown_source", keywords:"disconnection,metaphor", truncate:"", weight:1.0, description:"Organizations without connection resemble uncoordinated horses running in different directions, hindering collective success.", created_at:1779400756, source_id:"chunk-54304c335de80180a629fdfe3979a92e"}}, {start: {_id:598}, end: {_id:4594}, properties:{file_path:"unknown_source", keywords:"cause,stress", truncate:"", weight:1.0, description:"Judgment triggers inner tension and stress, leading to compulsive urges to correct others.", created_at:1779400756, source_id:"chunk-54304c335de80180a629fdfe3979a92e"}}, {start: {_id:4598}, end: {_id:4601}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", keywords:"foundation,mental state", truncate:"", weight:1.0, description:"Holding space is rooted in inner spaciousness, enabling non-judgmental presence.", created_at:1779400827, source_id:"chunk-a9c35b7e3af59116caff7410890807ed"}}, {start: {_id:598}, end: {_id:3050}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", truncate:"", keywords:"cause,source", weight:1.0, description:"Judgment often stems from unconscious prejudice, distorting interactions.", created_at:1779400827, source_id:"chunk-a9c35b7e3af59116caff7410890807ed"}}, {start: {_id:4600}, end: {_id:598}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", truncate:"", keywords:"cause,consequence", weight:1.0, description:"Judgment leads to disrespect, harming others' self-worth and productivity.", created_at:1779400827, source_id:"chunk-a9c35b7e3af59116caff7410890807ed"}}, {start: {_id:2703}, end: {_id:4600}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", truncate:"", keywords:"hindrance,impact", weight:1.0, description:"Disrespect stifles creativity by creating fear and insecurity.", created_at:1779400827, source_id:"chunk-a9c35b7e3af59116caff7410890807ed"}}, {start: {_id:598}, end: {_id:4603}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", truncate:"", keywords:"judgment,self-interest threat", weight:1.0, description:"Judgment can perceive others as a threat to one's self-interest, leading to defensive reactions and conflict.", created_at:1779400827, source_id:"chunk-a9c35b7e3af59116caff7410890807ed"}}, {start: {_id:4600}, end: {_id:4599}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", truncate:"", keywords:"hindrance,impact", weight:1.0, description:"Disrespect reduces productivity through stress and disengagement.", created_at:1779400827, source_id:"chunk-a9c35b7e3af59116caff7410890807ed"}}, {start: {_id:284}, end: {_id:2703}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", keywords:"enhancement,impact", truncate:"", weight:1.0, description:"Connection fosters creativity by creating psychological safety.", created_at:1779400827, source_id:"chunk-a9c35b7e3af59116caff7410890807ed"}}, {start: {_id:4602}, end: {_id:4600}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", keywords:"prevalence,statistic", truncate:"", weight:1.0, description:"54% of workers report disrespect, underscoring the urgency of non-judgmental practices.", created_at:1779400828, source_id:"chunk-a9c35b7e3af59116caff7410890807ed"}}, {start: {_id:284}, end: {_id:4599}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", keywords:"enhancement,impact", truncate:"", weight:1.0, description:"Connection improves productivity through collaborative problem-solving.", created_at:1779400828, source_id:"chunk-a9c35b7e3af59116caff7410890807ed"}}, {start: {_id:1599}, end: {_id:254}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", truncate:"", keywords:"collective growth,organizational strategy", weight:1.0, description:"Regular meditation practices are essential for the organization to build success through a collective brain.", created_at:1779400900, source_id:"chunk-6ae1a5128f5bd3988c5b8902bc010873"}}, {start: {_id:1599}, end: {_id:501}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", truncate:"", keywords:"enabler,method", weight:1.0, description:"Regular meditation practices enable the organization to achieve success through a collective brain.", created_at:1779400900, source_id:"chunk-6ae1a5128f5bd3988c5b8902bc010873"}}] AS row
