UNWIND [{start: {_id:1236}, end: {_id:1244}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"influence,shaping", truncate:"", weight:1.0, description:"Societal messages shape the Perfect Self ideal through cultural narratives about success and virtue.", created_at:1779143251, source_id:"chunk-e9621dc7d3757b01547188c8c828f956"}}, {start: {_id:1248}, end: {_id:1246}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"judgment,yardstick", truncate:"", weight:1.0, description:"The concepts of reasonable and unreasonable are questioned as subjective societal judgments.", created_at:1779143251, source_id:"chunk-e9621dc7d3757b01547188c8c828f956"}}, {start: {_id:1236}, end: {_id:1240}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"example,ideal", truncate:"", weight:1.0, description:"Steve Jobs exemplifies the Perfect Self archetype with intellectual and professional achievements.", created_at:1779143251, source_id:"chunk-e9621dc7d3757b01547188c8c828f956"}}, {start: {_id:880}, end: {_id:1236}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"example,ideal", truncate:"", weight:1.0, description:"Oprah Winfrey represents the Perfect Self through emotional and social success.", created_at:1779143251, source_id:"chunk-e9621dc7d3757b01547188c8c828f956"}}, {start: {_id:1242}, end: {_id:1236}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"example,ideal", truncate:"", weight:1.0, description:"Gigi Hadid embodies the Perfect Self's physical attractiveness and desirability.", created_at:1779143251, source_id:"chunk-e9621dc7d3757b01547188c8c828f956"}}, {start: {_id:1236}, end: {_id:1241}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"example,ideal", truncate:"", weight:1.0, description:"Warren Buffett symbolizes the Perfect Self's financial abundance and acumen.", created_at:1779143251, source_id:"chunk-e9621dc7d3757b01547188c8c828f956"}}, {start: {_id:1243}, end: {_id:1236}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"example,ideal", truncate:"", weight:1.0, description:"The Dalai Lama reflects the Perfect Self's emotional and spiritual virtues.", created_at:1779143251, source_id:"chunk-e9621dc7d3757b01547188c8c828f956"}}, {start: {_id:1247}, end: {_id:1236}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"measurement,self-evaluation", truncate:"", weight:1.0, description:"The Perfect Self serves as an inner gauge for self-assessment and measuring reality against ideals.", created_at:1779143251, source_id:"chunk-e9621dc7d3757b01547188c8c828f956"}}, {start: {_id:1236}, end: {_id:1249}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"comparison,self-assessment", truncate:"", weight:1.0, description:"Constant comparison between the Perfect Self and reality leads to disappointment when ideals are unmet.", created_at:1779143251, source_id:"chunk-e9621dc7d3757b01547188c8c828f956"}}, {start: {_id:60}, end: {_id:1250}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"relationship,text content", truncate:"", weight:1.0, description:"The text describes a state of being in childhood.", created_at:1779143298, source_id:"chunk-f072f6c1aecbc4e4e511168e02ba440e"}}, {start: {_id:60}, end: {_id:1251}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"relationship,text content", truncate:"", weight:1.0, description:"The text describes a state of innocence as a paradise.", created_at:1779143298, source_id:"chunk-f072f6c1aecbc4e4e511168e02ba440e"}}, {start: {_id:60}, end: {_id:1252}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"relationship,text content", truncate:"", weight:1.0, description:"The text describes a state of innocence as a paradise.", created_at:1779143298, source_id:"chunk-f072f6c1aecbc4e4e511168e02ba440e"}}, {start: {_id:60}, end: {_id:1254}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"relationship,text content", truncate:"", created_at:1779143298, weight:1.0, description:"The text describes a state of peace.", source_id:"chunk-f072f6c1aecbc4e4e511168e02ba440e"}}, {start: {_id:1205}, end: {_id:1256}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"despair,limitation,wealth impact", truncate:"", weight:2.0, description:"The Nobody State restricts individuals' ability to engage in wealth creation due to despair and self-interest.<SEP>The Nobody State obstructs wealth creation by trapping individuals in despair and self-doubt.", created_at:1779187442, source_id:"chunk-6bd5636c13f54dcbb4aa1a8db98334b5<SEP>chunk-d47f9b2e2b97109267ed4aa51e7ce893"}}, {start: {_id:1278}, end: {_id:1266}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"addressing,treatment", truncate:"", weight:1.0, description:"Healing the In?amed Mind involves addressing stress-induced inflammation through practices like Serene Mind to restore bodily equilibrium.", created_at:1779143371, source_id:"chunk-9d4d6de56ac10d5ab428310e3d4ea053"}}, {start: {_id:1280}, end: {_id:1205}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cause,manifestation", truncate:"", weight:1.0, description:"The Nobody State can manifest as inflammation of the mind, which remains undetected for decades and warps life.", created_at:1779143395, source_id:"chunk-438096b3bdf297662997da0ce488b0dc"}}, {start: {_id:1282}, end: {_id:1281}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"behavioral pattern,psychological symptom", weight:1.0, description:"Extreme relationships to wealth include oscillating between obsession and distaste for money, rooted in the Nobody State.", created_at:1779143395, source_id:"chunk-438096b3bdf297662997da0ce488b0dc"}}, {start: {_id:1205}, end: {_id:1281}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"psychological effect,symptom", truncate:"", weight:1.0, description:"The Nobody State often leads to an obsessive fixation with money as a compensatory mechanism.", created_at:1779143395, source_id:"chunk-438096b3bdf297662997da0ce488b0dc"}}, {start: {_id:1286}, end: {_id:1221}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"obsession,psychological impact", truncate:"", weight:1.0, description:"Mei's fear of financial inadequacy stems from the psychological effects of the Nobody State, driving obsessive behavior.", created_at:1779143409, source_id:"chunk-bff75bb2f7b2ca92ac4ac1a9d943c725"}}, {start: {_id:1219}, end: {_id:1286}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"insecurity,obsession", truncate:"", weight:1.0, description:"Mei's distorted relationship with money arises from her obsession with financial abundance to alleviate insecurity.", created_at:1779143410, source_id:"chunk-bff75bb2f7b2ca92ac4ac1a9d943c725"}}] AS row
