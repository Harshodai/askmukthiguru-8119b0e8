:1779404285, source_id:"chunk-3538d3a6dca3eeca95cabf452a553746"}}, {start: {_id:152}, end: {_id:4680}, properties:{file_path:"YouTube Video: AyUE-2Uh5Vg (URL: https://www.youtube.com/watch?v=AyUE-2Uh5Vg)", keywords:"mirroring,reflection", truncate:"", weight:1.0, description:"The field reflects and responds to human consciousness, mirroring inner states like peace/coherence or chaos/anger.", created_at:1779404302, source_id:"chunk-cd8e8c16e2620c27c2e75a44c149d1ff"}}] AS row
