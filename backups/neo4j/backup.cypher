UNWIND [{start: {name:"Brahman"}, end: {_id:3300}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2DLb6hDIhmg)", truncate:"", keywords:"metaphysical essence,spiritual concept", weight:1.0, description:"Teacher taught Brahman as the supreme essence underlying all existence.", created_at:1779211104, source_id:"chunk-2ed6c538824d03e53845129e9fe68f60"}}, {start: {name:"Ekam"}, end: {_id:724}, properties:{file_path:"unknown_source", keywords:"case study,practical application", truncate:"", weight:1.0, description:"Ekam mantra chanting demonstrated cognitive improvement in a child through parental practice.", created_at:1779212331, source_id:"chunk-04b32295251921d572678567c60204df"}}, {start: {name:"Deeksha"}, end: {_id:775}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", keywords:"context,correction,list", truncate:"", weight:2.0, description:"The term \"manenath trananath\" is being corrected based on the context of the list of terms.<SEP>The term \"manenath trananath\" is part of a list of terms including \"Deeksha\".", created_at:1779212741, source_id:"chunk-22ae4a6d383bcd6eb1c726163e13f796"}}, {start: {name:"Mantra"}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=207izZBbqVg)", truncate:"", keywords:"content origin,discussion topic,esoteric concepts,source", weight:2.0, description:"The video discusses mantra as part of its content on spiritual practices.<SEP>The mantra text is sourced from the YouTube video, which includes both the Sanskrit phrases and the instructional directive for dharana.", created_at:1779259855, source_id:"chunk-242c86adb935c1461785f26c0c3f9e28<SEP>chunk-ff46b53ab89c597d3fb954e4982613d0"}}, {start: {name:"Mantra"}, end: {_id:884}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)",