UNWIND [{_id:1348, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"organization", truncate:"", description:"executives are the smarter executives who joined the company, causing the Student to feel second in the company hierarchy.", created_at:1779143907, source_id:"chunk-ec0775a84f775c1f45594bb341b87476", entity_id:"executives"}}, {_id:1349, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"person", truncate:"", description:"The Student is a person who developed technology to improve animal lives, runs a successful company, and struggles with feelings of inadequacy and employee retention challenges.", created_at:1779143907, source_id:"chunk-ec0775a84f775c1f45594bb341b87476", entity_id:"The Student"}}, {_id:1350, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"artifact", truncate:"", description:"The Treadmill symbolizes the student's internal struggle, representing his inability to step off a cycle of self-doubt and external validation-seeking.", created_at:1779143907, source_id:"chunk-ec0775a84f775c1f45594bb341b87476", entity_id:"Treadmill"}}, {_id:1351, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)<SEP>YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", description:"The Spiritual Journey leads the Student to realize his inner state fuels his professional struggles.<SEP>The process of recognizing one's true emotions and understanding the roots of gratitude.<SEP>Self-awareness is a concept involving conscious recognition of one's own thoughts and emotions, crucial for overcoming anger as highlighted in the text.<SEP>Self-awareness involves conscious understanding of one's thoughts and emotions, enabling mindful communication without blame.<SEP>Self-awareness is the capacity to perceive one's own blind spots, which is often easier to see in others than in oneself.", created_at:1779563551, source_id:"chunk-ec0775a84f775c1f45594bb341b87476<SEP>chunk-a3883befbc3677e763ade9f571892747<SEP>chunk-95ede5878070f28d1b63e5213e0a1f6e<SEP>chunk-10353e11213908c6dce7cb7f38908ef1<SEP>chunk-a35e19231d7bd0423fa3c980dbea5e47<SEP>chunk-a5a06fbb8006348a3ccd90b704dc666e", entity_id:"Self-Awareness"}}, {_id:1352, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)", entity_type:"concept", truncate:"", description:"Stress actually causes ill health within individuals, as corrected from \"causes ill health\" to \"cause ill health\" for subject-verb agreement.<SEP>Ill health describes a state of poor physical or mental well-being, caused by prolonged suffering.", created_at:1779217096, source_id:"chunk-8853b5baf81ba75f9ee5305c84800872<SEP>chunk-c58601a836dc8ba4921372bcb850407d", entity_id:"Ill Health"}}, {_id:1353, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"event", truncate:"", description:"The transformational journey refers to the man's personal and professional evolution that led to organizational change.", created_at:1779143950, source_id:"chunk-e897fef731236d55e77f48600e6eadf5", entity_id:"Transformational Journey"}}, {_id:1354, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"natural_object", truncate:"", description:"A large rock that rolled onto the road, causing the car accident.", created_at:1779144028, source_id:"chunk-bcdc6f717c6627075a9723ba584173eb", entity_id:"Rock"}}, {_id:1355, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"location", truncate:"", description:"Medical facility where the man was revived after his car accident, leading to his profound transformation.<SEP>The medical facility where the man was revived after his near-fatal car crash.", created_at:1779187731, source_id:"chunk-bcdc6f717c6627075a9723ba584173eb<SEP>chunk-76ae728c8b06838498707d7f45c78764", entity_id:"ICU"}}, {_id:1356, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: fiABnex9O6Y (URL: https://www.youtube.com/watch?v=fiABnex9O6Y)", entity_type:"concept", truncate:"", description:"{\"Description\": \"{\\\"Description\\\": \\\"We need to synthesize a list of descriptions of the entity \\\\\\\"Wealth Consciousness\\\\\\\"...\\\"} ...\"}", created_at:1779518124, source_id:"chunk-bcdc6f717c6627075a9723ba584173eb<SEP>chunk-94684d3c1e91618d6299c39872dafbdf<SEP>chunk-57c07a0512777570587c500dccd8311d", entity_id:"Wealth Consciousness"}}, {_id:1357, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", created_at:1779144120, description:"A profound experience where one's life flashes before their eyes during a near-death event, leading to personal transformation.<SEP>The near-death experience is a pivotal event where the man gains profound insights about life and interconnectedness.<SEP>A profound consciousness experience often reported after life-threatening events.", source_id:"chunk-bcdc6f717c6627075a9723ba584173eb<SEP>chunk-047b4478344df168d1315f3ec6d2549f<SEP>chunk-54233c1b9347f0901ecd163446757676", entity_id:"Near-Death Experience"}}, {_id:1358, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=CZ_r5sYeTyY)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", entity_type:"concept", truncate:"", created_at:1779668922, description:"The effect of one's actions or service on others, as discussed in the context of work and creation.<SEP>Impact refers to the profound effect the Serene Mind Practice can have on individuals' lives and the world despite its brevity.<SEP>Impact refers to the influence or effect one's consciousness has on others, particularly in the context of transformation and agency.", source_id:"chunk-bcdc6f717c6627075a9723ba584173eb<SEP>chunk-132b8aaee32a493c686704b9df170e0b<SEP>chunk-472321605b70f46b6792fb017a049d8d<SEP>chunk-149f1fa94cc8d81b9d634c9e418c534a", entity_id:"Impact"}}, {_id:1359, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"creature", truncate:"", description:"A goat that was hit by the man as a child, later experienced by him through shared pain.<SEP>A goat the man once harmed as a child, later experienced through its pain during his near-death reflection.", created_at:1779187731, source_id:"chunk-2bc40004c68743e1129ffd4a3498a55f<SEP>chunk-76ae728c8b06838498707d7f45c78764", entity_id:"Goat"}}, {_id:1360, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"creature", truncate:"", created_at:1779187731, description:"Turtles attempting to cross the rocky patch, whose vulnerability the man recognized.<SEP>Turtles are creatures attempting to cross a road, symbolizing vulnerability and the need for protection in the narrative.<SEP>Turtles crossing the road that the man previously rescued, later experienced through his perspective during his near-death state.", source_id:"chunk-2bc40004c68743e1129ffd4a3498a55f<SEP>chunk-047b4478344df168d1315f3ec6d2549f<SEP>chunk-76ae728c8b06838498707d7f45c78764", entity_id:"Turtles"}}, {_id:1361, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"location", truncate:"", description:"A location where the man previously lost control of his car and where turtles cross.<SEP>The rocky patch is a location where the man rescues turtles and where he previously lost control of his car.", created_at:1779144084, source_id:"chunk-2bc40004c68743e1129ffd4a3498a55f<SEP>chunk-047b4478344df168d1315f3ec6d2549f", entity_id:"Rocky Patch"}}, {_id:1362, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"The fabric of life is a concept representing the interconnectedness of all living beings, central to the man?s realization.", created_at:1779144084, source_id:"chunk-047b4478344df168d1315f3ec6d2549f", entity_id:"Fabric of Life"}}, {_id:1363, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"An altered mental state characterized by heightened awareness and perception transformation.", created_at:1779144120, source_id:"chunk-54233c1b9347f0901ecd163446757676", entity_id:"Expanded State of Consciousness"}}, {_id:1364, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", entity_type:"concept", truncate:"", created_at:1779563408, description:"The interconnectedness of all life and actions, emphasizing collective impact.<SEP>Awareness of interconnectedness emphasized in organizational and personal enlightenment.<SEP>Awareness of interconnectedness emphasized in organizational and personal enlightenment.<SEP>The realization of unity and interconnectedness with all life and consciousness.", source_id:"chunk-54233c1b9347f0901ecd163446757676<SEP>chunk-922e23e61222fa7ebaae80af23f09b19<SEP>chunk-6cdea9db2f882e51edbd9de21797726f", entity_id:"Interconnection"}}, {_id:1365, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"concept", truncate:"", created_at:1779187731, description:"A mission or ideal promoting global cooperation and balance through individual actions.<SEP>The mission of creating harmony in the world, which involves interconnected actions and a ripple effect.<SEP>Mission promoting global harmony through interconnected work activities like technology use, lab work, business opportunities, education, and travel.<SEP>A conceptual mission symbolizing collective efforts to create global harmony through daily actions.", source_id:"chunk-54233c1b9347f0901ecd163446757676<SEP>chunk-ed2a8a5a882c678a038da88cc2f4309e<SEP>chunk-76ae728c8b06838498707d7f45c78764<SEP>chunk-b14b79dd6088b9676b5e759c61265472", entity_id:"Harmonious World"}}, {_id:1366, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)", entity_type:"concept", truncate:"", description:"The 90-second window refers to the brief timeframe in which a threat (e.g., escaping a tiger) must be addressed, emphasizing the urgency of stress responses.", created_at:1779216940, source_id:"chunk-12b99bdaf0b9e3dacedf22c15bf06bc9", entity_id:"90-Second Window"}}, {_id:1367, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"The far-reaching consequences of individual actions on the collective well-being.", created_at:1779144120, source_id:"chunk-54233c1b9347f0901ecd163446757676", entity_id:"Ripple Effects of Their Actions"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
