, {start: {_id:2231}, end: {_id:2233}, properties:{file_path:"unknown_source", keywords:"lifestyle approach,method", truncate:"", weight:1.0, description:"the art of living beautifully is a method to achieve a stress-free life through conscious living.", created_at:1779221493, source_id:"chunk-a7619f77eafbc391703609d89706c93c"}}, {start: {_id:2236}, end: {_id:2096}, properties:{file_path:"unknown_source", keywords:"output,style", truncate:"", weight:1.0, description:"The User must maintain a specific tone and style in the output.", created_at:1779221493, source_id:"chunk-7651e3f88938aa416a882ccdc7e8497a"}}, {start: {_id:2369}, end: {_id:2199}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=_X5jRvqxEEo)", keywords:"believing,collaboration,discussion,supporting", truncate:"", weight:2.0, description:"Pritha ji is believed to strongly believe in the problem of pressure, supporting the speaker's view.<SEP>Pritha ji and the speaker discuss the issue of psychological pressure and its impact.", created_at:1779221574, source_id:"chunk-349671a87ed47c9a9189c9696547ad85<SEP>chunk-f6de882ef63b995a9da5918fd43ea741"}}] AS row
