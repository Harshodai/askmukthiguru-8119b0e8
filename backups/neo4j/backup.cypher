UNWIND [{start: {_id:41}, end: {_id:38}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional obstruction,prevention", truncate:"", weight:1.0, description:"Suering states impede courageous actions.", created_at:1779135367, source_id:"chunk-c07886881fdb93e8dac5d36189340a55"}}, {start: {_id:36}, end: {_id:38}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"cyclical impact,emotional consequence", weight:1.0, description:"Suering states perpetuate negative baseline moods like sadness or anger.", created_at:1779135367, source_id:"chunk-c07886881fdb93e8dac5d36189340a55"}}, {start: {_id:37}, end: {_id:38}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional barrier,obstruction", truncate:"", weight:1.0, description:"Suering states prevent lasting happiness.", created_at:1779135367, source_id:"chunk-c07886881fdb93e8dac5d36189340a55"}}, {start: {_id:43}, end: {_id:38}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"obstruction,relational barrier", truncate:"", weight:1.0, description:"Suering states undermine meaningful connections.", created_at:1779135367, source_id:"chunk-c07886881fdb93e8dac5d36189340a55"}}, {start: {_id:50}, end: {_id:21}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"magical phenomena,spiritual guidance,spiritual support,teachings", truncate:"", weight:2.0, description:"The book teaches that holding the sacred secrets leads to synchronicities supporting the journey.<SEP>The book references synchronicities as tools to empower the reader's journey.", created_at:1779135419, source_id:"chunk-44c5424a50aefa089772fd12a4f10112<SEP>chunk-a3cf87dcbdae759e4fd39a070ea3cde7"}}, {start: {_id:52}, end: {_id:25}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conceptual framework,personal growth", truncate:"", weight:1.0, description:"The beautiful state is presented as a framework for achieving personal transformation.", created_at:1779135395, source_id:"chunk-44c5424a50aefa089772fd12a4f10112"}}, {start: {_id:53}, end: {_id:50}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cosmic support,manifestation", truncate:"", weight:1.0, description:"Synchronicities manifest as magical, supportive events in the universe.", created_at:1779135395, source_id:"chunk-44c5424a50aefa089772fd12a4f10112"}}, {start: {_id:49}, end: {_id:25}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"life improvement,outcome", truncate:"", weight:1.0, description:"Transformation leads to a state of effortlessness in various aspects of life.", created_at:1779135395, source_id:"chunk-44c5424a50aefa089772fd12a4f10112"}}, {start: {_id:55}, end: {_id:14}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"educational approach,transformative", truncate:"", weight:1.0, description:"The O&O Academy employs dynamic learning as a method to achieve transformative consciousness in individuals.", created_at:1779135419, source_id:"chunk-a3cf87dcbdae759e4fd39a070ea3cde7"}}, {start: {_id:21}, end: {_id:56}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"atmosphere,setting", truncate:"", weight:1.0, description:"The book begins with a serene veranda setting that establishes the reader's initial connection to the text.", created_at:1779135419, source_id:"chunk-a3cf87dcbdae759e4fd39a070ea3cde7"}}, {start: {_id:17}, end: {_id:14}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"co-founders,education,founder,founders,leadership,mentorship,spiritual education", truncate:"", weight:4.0, description:"Krishnaji co-founds the O&O Academy, which focuses on transformative consciousness through dynamic learning.<SEP>Krishnaji co-founded O&O Academy to teach transformative consciousness.<SEP>Krishnaji cofounded O&O Academy and mentors global leaders.<SEP>Krishnaji co-founded O&O Academy and mentors global leaders through its initiatives.", created_at:1779188276, source_id:"chunk-a3cf87dcbdae759e4fd39a070ea3cde7<SEP>chunk-2d7f2293587016371499185adff2fbdb<SEP>chunk-8a3ef14b4ae6173889d682a026ec55c0<SEP>chunk-68272ee7ebb0f34dcf88d287b8d9983d"}}, {start: {_id:57}, end: {_id:21}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"engagement method,reflection", truncate:"", weight:1.0, description:"The book encourages readers to use daily meditation to interact with its teachings.", created_at:1779135419, source_id:"chunk-a3cf87dcbdae759e4fd39a070ea3cde7"}}, {start: {_id:54}, end: {_id:14}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"education,founders", truncate:"", weight:1.0, description:"Amma co-founds the O&O Academy, contributing to its educational and spiritual teachings.", created_at:1779135419, source_id:"chunk-a3cf87dcbdae759e4fd39a070ea3cde7"}}, {start: {_id:58}, end: {_id:21}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"existential exploration,philosophical inquiry", weight:1.0, description:"The book addresses humanity's search for meaning through concepts of consciousness and existence.", created_at:1779135419, source_id:"chunk-a3cf87dcbdae759e4fd39a070ea3cde7"}}, {start: {_id:54}, end: {_id:21}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"spiritual guidance,teachings", truncate:"", weight:1.0, description:"The book incorporates Amma?s contributions to the philosophy of Oneness and consciousness.", created_at:1779135420, source_id:"chunk-a3cf87dcbdae759e4fd39a070ea3cde7"}}, {start: {_id:58}, end: {_id:17}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"existential themes,teachings", truncate:"", weight:1.0, description:"Krishnaji's philosophy connects to humanity's quest for answers through concepts like Oneness.", created_at:1779135420, source_id:"chunk-a3cf87dcbdae759e4fd39a070ea3cde7"}}, {start: {_id:54}, end: {_id:58}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"existential themes,teachings", truncate:"", weight:1.0, description:"Amma's contributions align with exploring humanity's search for meaning through spiritual teachings.", created_at:1779135420, source_id:"chunk-a3cf87dcbdae759e4fd39a070ea3cde7"}}, {start: {_id:17}, end: {_id:62}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", truncate:"", keywords:"authorship,co-authorship,co-founders,co-mention,cofounders,collaboration,decision-making,interconnectedness,marriage,merger,organizational leadership,parenthood,partnership,philanthropy,relationship,retreat participants,shared goals,spiritual collaboration,spiritual partnership,spouse,transcription analysis,travel companions,unity", weight:16.0, description:"Krishnaji and Preethaji are married spiritual teachers and philanthropists who collaborate on a wide range of initiatives, including educational and charitable projects. They co-found O&O Academy, an institution created by merging Oneness and One World Academy, and they also co-author books to share their teachings. Their partnership extends to spiritual retreats and experiences, where they explore concepts of oneness and consciousness.  

As co-founders of educational and charitable initiatives, Krishnaji and Preethaji have established O&O Academy as a hub for learning and service. They have merged two organizations to create this academy and have been involved in co-authoring a book that reflects their spiritual and philosophical perspectives. Their collaboration is also evident in their philanthropic efforts, which focus on education and charitable causes.  

Krishnaji and Preethaji participate in spiritual retreats and engage in experiences that foster a sense of oneness. These retreats provide opportunities for them to deepen their spiritual practice and share insights with others. Their involvement in such activities underscores their commitment to spiritual growth and community building.  

The couple travels together with their daughter, Lokaa, and has visited places like Big Bear Lake, where they discuss topics such as Jet Skis at the marina. These trips are not only recreational but also serve as opportunities for family bonding and for exploring new ideas. The discussions about Jet Skis, for instance, reflect their openness to diverse experiences and their willingness to engage in meaningful conversations.  

In their decision-making, Krishnaji and Preethaji consider the interests and enthusiasm of their family, including Lokaa, when making choices about activities and initiatives. Their collaborative approach ensures that decisions are made with consideration for all stakeholders. Through their combined efforts, they continue to advance spiritual teachings, philanthropy, and educational initiatives, making a positive impact in their community and beyond.<SEP>Krishnaji and Preethaji share a relationship and travel to Big Bear Lake.<SEP>Preethaji and Krishnaji are married, parents to a teenage daughter, and co-founders of educational and philanthropic ventures.<SEP>Krishnaji and Preethaji co-founded O&O Academy and collaborate on spiritual education.` - This is a bit of a stretch. The text says they are co-founders of the academy. The relationship is between them, but the description is about the academy. The keyword `co-founders` is good. The description could be more precise. Let's see if I can improve it. \"Krishnaji and Preethaji co-founded O&O Academy, a school for transforming human consciousness.\" That's better.<SEP>Krishnaji and Preethaji co-founded O&O Academy and collaborate on spiritual education.` The description is a bit long and could be more concise. Let's try to refine it. \"Krishnaji and Preethaji co-founded O&O Academy, a philosophy and meditation school for transforming human consciousness.\" This is better.<SEP>Preethaji and Krishnaji cofounded O&O Academy and collaborate on teachings about consciousness and stress management.<SEP>Krishnaji and Preethaji are discussed together in the context of identifying and correcting transcription errors in names.", created_at:1779456049, source_id:"chunk-2d7f2293587016371499185adff2fbdb<SEP>chunk-95d009c63a3449c63c28d254570391b6<SEP>chunk-8539e53b3407e35921fe5963280d3207<SEP>chunk-a2cc4d07b96d813e34cd5ee5e3d96e0d<SEP>chunk-d83a359a3b08bc2ee4dd9304ff1558fc<SEP>chunk-23f4ae85323a27ae180ceca7fa33c13a<SEP>chunk-dad86cc04528a53c723f853b94021683<SEP>chunk-e92892e6fc3f2eca65cd533bfb485c1c<SEP>chunk-81f7d5b351616383eb1a7cca9b4d2b48<SEP>chunk-50804a0cd2fabf8122814121f088fb8d<SEP>chunk-3f7b8834c0b5fdd9d0b5f928c5733a2b<SEP>chunk-9f8b0701a1ef7e4365563a4d66474949"}}, {start: {_id:61}, end: {_id:62}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"author,charitable work,crisis,familial bond,family,family bond,message,parent-child,relationship,shared experience,shared goals,shared trauma,spiritual upbringing", truncate:"", weight:9.0, description:"Relation (Lokaa, Preethaji) is described as follows: Preethaji is Lokaa's mother and they share a deep, fulfilling relationship as parent and child. They jointly experienced a traumatic incident involving Jet Skis, which has deepened their emotional connection and contributed to a spiritual bond. Preethaji engages in retreat activities with Lokaa, indicating a shared involvement in such experiences.  

Lokaa, as the daughter of Preethaji, is involved in charitable foundations, reflecting a broader social engagement. Additionally, Preethaji authored a text advocating for self-acceptance and inner harmony, highlighting her role as a writer and thought leader. Some descriptions also note that Lokaa points out the Jet Skis and that the relationship is shared, while others repeat the same points. Overall, the relationship between Lokaa and Preethaji is characterized by mutual support, shared trauma, spiritual connection, and contributions to charitable and intellectual endeavors.<SEP>Preethaji is the mother of Lokaa, who grows up in a spiritually enriched household.` - This is correct.", created_at:1779187967, source_id:"chunk-2d7f2293587016371499185adff2fbdb<SEP>chunk-30b3ce6bb0954806ce5e0dee5f14e7c3<SEP>chunk-37f26db11e149c4af43719c414b748ce<SEP>chunk-8a3ef14b4ae6173889d682a026ec55c0<SEP>chunk-2bd00175db71e25481fb9ce67f057b84<SEP>chunk-e92892e6fc3f2eca65cd533bfb485c1c<SEP>chunk-50d6ad908c447f2c1930066f85129418<SEP>chunk-50804a0cd2fabf8122814121f088fb8d"}}, {start: {_id:63}, end: {_id:61}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"curiosity,enthusiasm", truncate:"", weight:1.0, description:"Lokaa's excitement about the Jet Skis drives the group's activity at the marina.", created_at:1779135444, source_id:"chunk-2d7f2293587016371499185adff2fbdb"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
