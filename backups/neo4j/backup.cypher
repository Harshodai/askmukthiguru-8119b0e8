UNWIND [{start: {name:"Deeksha"}, end: {_id:3782}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)", truncate:"", keywords:"concept association,mantra correction", weight:1.0, description:"Medha and Deeksha are both concepts corrected from words in the mantra, showing a thematic link.", created_at:1779241028, source_id:"chunk-b8d18accff7354006bbf1baf5cc50967"}}, {start: {name:"Deeksha"}, end: {_id:3796}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)", truncate:"", keywords:"domain-specific terms,reference list", weight:1.0, description:"Deeksha is included in the domain-specific terms list.", created_at:1779241219, source_id:"chunk-4aa2186804f084108c45c41993118d21"}}, {start: {name:"Ekam"}, end: {_id:2892}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=owXqW04b08o)<SEP>YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", truncate:"", keywords:"analysis,mantra consideration,teaching,terminology", weight:2.0, description:"Ekam is considered as a potential mantra component for the spiritual platform despite structural inconsistencies.<SEP>The Spiritual Platform teaches the concept of Ekam as part of its spiritual teachings.", created_at:1779447878, source_id:"chunk-237725492b688a0663257df076c15f50<SEP>chunk-19de200e362a0af16f232c1f956ad32c"}}, {start: {name:"Ekam"}, end: {_id:3824}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", truncate:"", keywords:"domain-specific term,standardization", weight:1.0, description:"Multiple \"ekam\" variations need standardization to capitalized \"Ekam\".", created_at:1779241917, source_id:"chunk-821c3bab77b0da45d408ce80c80c9144"}}, {start: {name:"Brahman"}, end: {_id:1594}, properties:{file_path:"unknown_source", keywords:"enlightenment,spiritual practice", truncate:"", weight:1.0, description:"Sadhana and Deeksha are practices to realize Brahman.", created_at:1779243856, source_id:"chunk-2e434306df5b4f2083250fff41e8b701"}}, {start: {name:"Consciousness"}, end: {_id:3896}, properties:{file_path:"unknown_source", keywords:"cosmic scale,interconnectedness", truncate:"", weight:1.0, description:"Consciousness is linked to the vastness of galaxies and universes.", created_at:1779243856, source_id:"chunk-2e434306df5b4f2083250fff41e8b701"}}, {start: {name:"Beautiful State"}, end: {_id:39}, properties:{file_path:"unknown_source", keywords:"emotional foundation,foundation,self-acceptance", truncate:"", weight:2.0, description:"Nurturing a beautiful state enables joy and harmonious living.<SEP>Joy is a core component of the beautiful state cultivated through self-love.", created_at:1779524873, source_id:"chunk-cdbfc6e200f4cd4487961cefed0a0954<SEP>chunk-3d3e1db7059b50ed67e675540955de81"}}, {start: {name:"Beautiful State"}, end: {_id:1517}, properties:{file_path:"unknown_source", keywords:"absence", truncate:"", weight:1.0, description:"A beautiful state eliminates internal and external conflict.", created_at:1779244249, source_id:"chunk-cdbfc6e200f4cd4487961cefed0a0954"}}, {start: {name:"Beautiful State"}, end: {_id:2604}, properties:{file_path:"unknown_source", keywords:"paradigm shift", truncate:"", weight:1.0, description:"The civilization must prioritize inner beauty over external achievements for true harmony.", created_at:1779244249, source_id:"chunk-cdbfc6e200f4cd4487961cefed0a0954"}}, {start: {name:"Beautiful State"}, end: {_id:264}, properties:{file_path:"unknown_source", keywords:"foundation,transformation", truncate:"", weight:1.0, description:"Nurturing a beautiful state transforms the life journey into a peaceful and harmonious process.", created_at:1779244249, source_id:"chunk-cdbfc6e200f4cd4487961cefed0a0954"}}, {start: {name:"Suffering"}, end: {_id:1381}, properties:{file_path:"unknown_source", keywords:"consequences,impact", truncate:"", weight:1.0, description:"Suffering perpetuates global pain and conflict as described in the text.", created_at:1779248746, source_id:"chunk-c9caee3e34754dd743fb5e0f90ac1a6b"}}, {start: {name:"Ekam"}, end: {_id:3477}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bSyewSnu2Ak)", truncate:"", keywords:"accuracy check,explicit mention", weight:1.0, description:"Ekam is directly referenced in the text and requires validation.", created_at:1779254090, source_id:"chunk-d57e9e7661b8c29c289bb2a8bcb7d92d"}}, {start: {name:"Deeksha"}, end: {_id:62}, properties:{file_path:"unknown_source", truncate:"", keywords:"domain-specific term,spiritual concept", weight:1.0, description:"Preethaji is associated with the domain-specific term Deeksha, which is correctly used.", created_at:1779257012, source_id:"chunk-87a42eb6572d13c3b49d24da9eb84c9b"}}, {start: {name:"Deeksha"}, end: {_id:17}, properties:{file_path:"unknown_source", truncate:"", keywords:"domain-specific term,spiritual concept", weight:1.0, description:"Krishnaji is associated with the domain-specific term Deeksha, which is correctly used.", created_at:1779257013, source_id:"chunk-87a42eb6572d13c3b49d24da9eb84c9b"}}, {start: {name:"Ekam"}, end: {_id:4173}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", keywords:"affiliation,association", truncate:"", weight:1.0, description:"Students of the academy are affiliated with Ekam.", created_at:1779257302, source_id:"chunk-e89be378630661d2c676d9886934ef21"}}, {start: {name:"Ekam"}, end: {_id:4176}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", keywords:"affiliation,association", truncate:"", weight:1.0, description:"Seekers at Ekam are associated with Ekam.", created_at:1779257302, source_id:"chunk-e89be378630661d2c676d9886934ef21"}}, {start: {name:"Ekam"}, end: {_id:4172}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mNM-x9RFMcE)", truncate:"", keywords:"association,involvement", created_at:1779257302, weight:1.0, description:"Preetajji is involved with Ekam.", source_id:"chunk-e89be378630661d2c676d9886934ef21"}}, {start: {name:"Consciousness"}, end: {_id:1193}, properties:{file_path:"unknown_source<SEP>YouTube Video: WOKBogNTmPI (URL: https://www.youtube.com/watch?v=WOKBogNTmPI)", keywords:"cellular alignment,conscious harmony,holistic health,holistic state", truncate:"", weight:2.0, description:"Health integrates consciousness as a vital dimension, harmonizing with physical and mental states.<SEP>Consciousness influences health through optimal cellular communication and alignment with universal intelligence.", created_at:1779518234, source_id:"chunk-6ceaf029b184877ef7237e73de7e90eb<SEP>chunk-6988c802643ab5986cfc41940a6f6b44"}}, {start: {name:"Consciousness"}, end: {_id:4389}, properties:{file_path:"unknown_source", keywords:"conscious unity,harmony state", truncate:"", weight:1.0, description:"Swasa is defined by the harmonization of consciousness with the self and the world.", created_at:1779346706, source_id:"chunk-6ceaf029b184877ef7237e73de7e90eb"}}, {start: {name:"Ekam"}, end: {_id:1787}, properties:{file_path:"unknown_source", keywords:"correction example,misheard term", truncate:"", weight:1.0, description:"Homophones and misheard words include the misheard term \"Ekam\" which needs correction.", created_at:1779393636, source_id:"chunk-d66cf68ce9f6d614d8c2ffeac6619b27"}}] AS row
