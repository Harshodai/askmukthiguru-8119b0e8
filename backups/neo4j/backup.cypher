UNWIND [{start: {name:"Consciousness"}, end: {_id:5621}, properties:{file_path:"unknown_source", keywords:"self-expansion,universal unity", truncate:"", weight:1.0, description:"Expanded consciousness dissolves the constricted sense of self, fostering unity with the universe.", created_at:1779556408, source_id:"chunk-e2d0ff9dea6a5334fbc3569bce6e4413"}}, {start: {name:"Consciousness"}, end: {_id:1617}, properties:{file_path:"unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", keywords:"consciousness expansion,influence,interconnection,mental calmness,mind observation,observation", truncate:"", weight:4.0, created_at:1779556959, description:"Observing the mind's chaotic thoughts leads to mental stillness and expanded consciousness.<SEP>The mind and consciousness are interconnected, influencing each other during practice.<SEP>The mind and consciousness are interconnected, influencing each other during practice.<SEP>Expanding consciousness allows the mind to become an observer, transforming chaotic thoughts into harmonious flow.", source_id:"chunk-e2d0ff9dea6a5334fbc3569bce6e4413<SEP>chunk-d887f374fce140e42345a26a703cd352<SEP>chunk-3198061b7d9cb7c891cdfe291494700c"}}, {start: {name:"Consciousness"}, end: {_id:1654}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"consciousness expansion,mental impact", weight:1.0, description:"Retaining Prana affects consciousness, leading to expanded awareness.", created_at:1779556889, source_id:"chunk-e15affa7e924b9530baaf1cc0152bad4"}}, {start: {name:"Consciousness"}, end: {_id:610}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"consciousness definition,sense of self", weight:1.0, description:"Consciousness is defined as the sense of self, which can expand or diminish.", created_at:1779556968, source_id:"chunk-b04f7ebc196bc2024dc00fdd71633076"}}, {start: {name:"Consciousness"}, end: {_id:2364}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)<SEP>unknown_source", truncate:"", keywords:"component,mental activity,mental processes,observation", weight:2.0, description:"During meditation, thoughts are present but not attributed to a self.<SEP>Thoughts are a primary component of conscious mental activity.", created_at:1779670850, source_id:"chunk-b04f7ebc196bc2024dc00fdd71633076<SEP>chunk-53e525d93caa11247db9588a7b9a8e7a"}}, {start: {name:"Beautiful State"}, end: {_id:6359}, properties:{file_path:"unknown_source<SEP>YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"awareness,elevated state,transcendence", truncate:"", weight:2.0, description:"Entering the magical zone occurs when limitations are broken through beautiful consciousness.`<SEP>Entering a magical zone occurs when limitations are broken through, enabling synchronicities.", created_at:1779560390, source_id:"chunk-d18ebd8ed5109a40c69cb7a69ecd8f61<SEP>chunk-fb34444d5342f0a266be4edca9184fcf"}}, {start: {name:"Consciousness"}, end: {_id:5876}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"crisis,dissatisfaction", truncate:"", weight:1.0, description:"King's dissatisfaction stems from a noisy, dissatisfied consciousness seeking constant negation.", created_at:1779559887, source_id:"chunk-ff3e80d959eda2affcf9fb1d2dff2880"}}, {start: {name:"Beautiful State"}, end: {_id:591}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"driving force,universal experience", weight:1.0, description:"The beautiful state underlies all human experiences, including cooperation, love, and success.", created_at:1779560387, source_id:"chunk-a6934bb5f3e6b9a7dbc975f40692be35"}}, {start: {name:"Beautiful State"}, end: {_id:501}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"long-term advantage,outcome", weight:1.0, description:"The beautiful mind state correlates with sustained success and leadership effectiveness over time.", created_at:1779560387, source_id:"chunk-a6934bb5f3e6b9a7dbc975f40692be35"}}, {start: {name:"Beautiful State"}, end: {_id:158}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"problem resolution,stress reduction", weight:1.0, description:"Problems dissolve effortlessly in a beautiful state, akin to ice melting in sunlight.", created_at:1779560390, source_id:"chunk-fb34444d5342f0a266be4edca9184fcf"}}, {start: {name:"Beautiful State"}, end: {_id:230}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"alignment,fulfillment", truncate:"", weight:1.0, description:"Heartfelt intentions are more likely to manifest when rooted in a beautiful state.", created_at:1779560391, source_id:"chunk-fb34444d5342f0a266be4edca9184fcf"}}, {start: {name:"Beautiful State"}, end: {_id:5438}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"decision-making,vision", truncate:"", weight:1.0, description:"Leaders in a beautiful state make decisions aligned with higher purpose and collaboration.", created_at:1779560391, source_id:"chunk-fb34444d5342f0a266be4edca9184fcf"}}, {start: {name:"Beautiful State"}, end: {_id:6407}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"culture shaping,positive environment", weight:1.0, description:"Organizational culture reflects the leader's state, fostering harmony or stress.", created_at:1779560391, source_id:"chunk-fb34444d5342f0a266be4edca9184fcf"}}, {start: {name:"Beautiful State"}, end: {_id:6408}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"harmony,synchronicity", truncate:"", weight:1.0, description:"Alignment with the magical flow enables effortless navigation of life's challenges.", created_at:1779560391, source_id:"chunk-fb34444d5342f0a266be4edca9184fcf"}}, {start: {name:"Beautiful State"}, end: {_id:6409}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"order,purpose-driven alignment", weight:1.0, description:"The random universe organizes into meaningful patterns for those in a beautiful state.", created_at:1779560392, source_id:"chunk-fb34444d5342f0a266be4edca9184fcf"}}, {start: {name:"Consciousness"}, end: {_id:6418}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"application,mindfulness", truncate:"", weight:1.0, description:"This method serves as a tool to cultivate consciousness and deepen one's connection to universal oneness.", created_at:1779560499, source_id:"chunk-24179c364db0fb884a0fd4e2f2818e29"}}, {start: {name:"Consciousness"}, end: {_id:6419}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"emotional connection,mindfulness", weight:1.0, description:"Reliving loving experiences deepens emotional awareness and connection to universal oneness during consciousness expansion.", created_at:1779560499, source_id:"chunk-24179c364db0fb884a0fd4e2f2818e29"}}, {start: {name:"Oneness"}, end: {_id:116}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"nurturing,support", weight:1.0, description:"Embracing oneness through inclusion and connection leads to the universe acting as a supportive ally in nurturing life's purpose.", created_at:1779560528, source_id:"chunk-24179c364db0fb884a0fd4e2f2818e29"}}, {start: {name:"Consciousness"}, end: {_id:1068}, properties:{file_path:"unknown_source<SEP>YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"capability,enlightenment,self-awareness,transcendence", truncate:"", weight:2.0, description:"The human brain's capacity for consciousness allows it to evolve beyond survival-driven negativity toward compassion and enlightenment.<SEP>The human brain enables consciousness to achieve enlightenment, leading to profound states like equanimity and bliss.", created_at:1779561379, source_id:"chunk-1b0c6f6cf5b3451d482de925f92b2a15<SEP>chunk-9645fe2118f4e6de1b034351a972ae59"}}, {start: {name:"Consciousness"}, end: {_id:386}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"capability,enlightenment", truncate:"", weight:1.0, description:"The brain and Consciousness are depicted as interconnected, with the brain enabling Consciousness to achieve enlightenment and profound states like equanimity and bliss.", created_at:1779561379, source_id:"chunk-9645fe2118f4e6de1b034351a972ae59"}}] AS row
MATCH (start:Concept{name: row.start.name})
