CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:5343, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)<SEP>YouTube Video: pPHQMD3w9-s (URL: https://www.youtube.com/watch?v=pPHQMD3w9-s)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=aSNQUkuyB18)", entity_type:"content", truncate:"", description:"Revised version of the sentence: \"When we become awakened human beings, we become enlightened human beings, and we are in a true state of oneness, and we live in a true state of oneness.\"<SEP>Revised version of the sentence: \"When we become awakened human beings, we become enlightened human beings, and we are in a true state of oneness, and we live in a true state of oneness.\"<SEP>The corrected sentence \"We are falling sick our friends or relatives the people we know are falling sick.\" is the final version considered a bad fix.<SEP>Corrected sentence: \"We are falling sick, our friends or relatives, the people we know are falling sick.\"<SEP>\"We are falling sick our friends or relatives the people we know are falling sick.\" A revised version of the original sentence with commas removed after 'sick' and 'know'.<SEP>Corrected Sentence is the properly structured sentence using the provided terms: \"Sri Preethaji and Sri Krishnaji offer Deeksha, initiating Sadhana to experience the Limitless Field and realize the truth of Ekam.\"<SEP>Corrected Sentence is the properly structured sentence using the provided terms: \"Sri Preethaji and Sri Krishnaji offer Deeksha, initiating Sadhana to experience the Limitless Field and realize the truth of Ekam.\"", created_at:1779738138, source_id:"chunk-bf775281b0e0ffbc9e43851a7fa22924<SEP>chunk-552b739d2ae70fc8e9c600ab5f945b84<SEP>chunk-5ad87d01b925f7db7d300ff617025fd6<SEP>chunk-0a3d8dace7b91faabb1727dba264fce1<SEP>chunk-66d052cfce333baac252a06ac5cc806d<SEP>chunk-53319cc6044d059cf5c7ef51c4ac6f3a<SEP>chunk-c57555a46d14250b46e377974720eca3", entity_id:"Corrected Sentence"}}, {_id:5344, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=zGhlBQ8iWl4)", entity_type:"concept", truncate:"", description:"World's problems are addressed through the concepts of awakening, peace, and enlightenment.<SEP>World's problems are linked to the need for a paradigm shift in human collective thinking.<SEP>World's problems are linked to the need for a paradigm shift in human collective thinking.", created_at:1779701484, source_id:"chunk-d319e7ca1c821b8d3953f9189c7b08fd<SEP>chunk-c2a3583743d6818c48f0ebcba32019d3", entity_id:"World's Problems"}}, {_id:5345, properties:{file_path:"unknown_source<SEP>YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", entity_type:"concept", truncate:"", created_at:1779455700, description:"ACOM is a global organization dedicated to peace meditation, hosting gatherings for spiritual and collective harmony.<SEP>ACOM is an organization mentioned in the context of a sacred gathering of peace meditators.`<SEP>ACOM is a domain-specific term that should be replaced with \"Ekam\" in the context of peace meditators.", source_id:"chunk-c1d8dd3f6ee4794537974077b8f6d5c9<SEP>chunk-4b54aa8a9252857e691b1304a2061fad<SEP>chunk-8e11843c5e5d416ebb2d563613787d4b<SEP>chunk-967a1ebc79cd7d83afc2b43d42c8ab36<SEP>chunk-bfcad8a2e2d4df5f6523bcfa541887ac", entity_id:"ACOM"}}, {_id:5346, properties:{file_path:"unknown_source<SEP>YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)<SEP>YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", entity_type:"concept", truncate:"", description:"A metaphorical concept describing violence as a psychological affliction transmitted across generations and communities, perpetuating conflict.<SEP>The mental infection of violence refers to the ingrained violent tendencies in human minds that perpetuate conflict.<SEP>Mental infection of violence describes the pervasive presence of violent tendencies within human psychology.<SEP>Mental Infection of Violence describes a metaphorical \"infection\" of violent tendencies within human psychology, perpetuated across generations and communities.<SEP>A mental infection of violence that has been present for the past 70,000 years, passed through generations and communities, and leads to wars and internal conflict.", created_at:1779519946, source_id:"chunk-c1d8dd3f6ee4794537974077b8f6d5c9<SEP>chunk-c31c96b585957b3d969c1f44467db292<SEP>chunk-195432225c839e4aa9996bf06701d94e<SEP>chunk-e1d5e0073f33e1ee1857e1f6302d5b7f<SEP>chunk-60af06a20529afe356c9b2c29e286a87", entity_id:"Mental Infection of Violence"}}, {_id:5347, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Collective peace signifies the shared tranquility among individuals and communities that can prevent egoistic leadership and war.<SEP>Collective peace is emphasized as the solution to global conflicts and egoistic leadership.`", created_at:1779455234, source_id:"chunk-4b54aa8a9252857e691b1304a2061fad<SEP>chunk-c31c96b585957b3d969c1f44467db292", entity_id:"Collective Peace"}}, {_id:5348, properties:{file_path:"unknown_source<SEP>YouTube Video: d0v8RE6i0GM (URL: https://www.youtube.com/watch?v=d0v8RE6i0GM)", entity_type:"natural_object", truncate:"", description:"COVID-19 is a virus mentioned as a dangerous infection that cannot be hidden from.`<SEP>COVID-19 is a pandemic that has significantly impacted global health, social dynamics, and economic stability.<SEP>COVID-19 is a pandemic that has significantly impacted human relationships, global economy, and societal behavior.<SEP>COVID-19 is a pandemic disease that has exacerbated social alienation and altered human interactions.<SEP>COVID-19 is a pandemic disease that has exacerbated social alienation and altered human interactions.", created_at:1779519252, source_id:"chunk-4b54aa8a9252857e691b1304a2061fad<SEP>chunk-13c9585183fe0f71b4560d16c5cd2726<SEP>chunk-47ba35801c62795c3acbb6bf1357ab08<SEP>chunk-39252be9066242f35311d64c382dc3da", entity_id:"COVID-19"}}, {_id:5350, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Collective peace prevents the emergence of egoistic leaders by fostering unity and understanding.<SEP>Collective peace prevents the emergence of egoistic leaders and fosters global harmony.`<SEP>Egoistic leaders emerge from collective unawareness and contribute to global instability.", created_at:1779519874, source_id:"chunk-4b54aa8a9252857e691b1304a2061fad<SEP>chunk-c31c96b585957b3d969c1f44467db292<SEP>chunk-7abe568e63ed3025b11ad246b7eb6e12", entity_id:"Egoistic Leaders"}}, {_id:5351, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Solutions are born within individuals, requiring internal focus rather than external problem-solving.", created_at:1779455329, source_id:"chunk-c31c96b585957b3d969c1f44467db292", entity_id:"Individual Realization"}}, {_id:5352, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Dharma involves protecting the innocence and future of children through righteous actions.", created_at:1779455349, source_id:"chunk-c31c96b585957b3d969c1f44467db292", entity_id:"Protecting Innocence"}}, {_id:5354, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", entity_type:"content", truncate:"", description:"4LIZkNHlNaM is a YouTube video discussing corrections to terms such as Sri Krishnaji and Ekam, with a URL provided.", created_at:1779455535, source_id:"chunk-8e11843c5e5d416ebb2d563613787d4b", entity_id:"4LIZkNHlNaM"}}, {_id:5355, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", entity_type:"UNKNOWN", truncate:"", description:"Inconsistent capitalization in \"limitless Field\" is corrected to \"Limitless Field\" for conceptual clarity.", created_at:1779455617, source_id:"chunk-8e11843c5e5d416ebb2d563613787d4b", entity_id:"limitless Field"}}, {_id:5356, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)<SEP>YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)<SEP>unknown_source", entity_type:"category", truncate:"", created_at:1779519875, description:"Drinking water problems denote global challenges related to access to clean and safe drinking water.<SEP>Global water scarcity challenges that could be mitigated with minimal war spending reallocation.<SEP>Drinking Water Problems signify a global challenge addressable through reallocated resources from war preparation.<SEP>Drinking water scarcity could be resolved with minimal war-related spending, contrasting with the vast resources allocated to conflict.<SEP>Drinking water scarcity can be alleviated with minimal war spending, highlighting resource misallocation.", source_id:"chunk-195432225c839e4aa9996bf06701d94e<SEP>chunk-3a7068f2a209054e42abe5d72250029a<SEP>chunk-e1d5e0073f33e1ee1857e1f6302d5b7f<SEP>chunk-ab90f4a2ea15bf468182f88153f57ef6<SEP>chunk-7abe568e63ed3025b11ad246b7eb6e12", entity_id:"Drinking Water Problems"}}, {_id:5357, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", entity_type:"event", truncate:"", description:"Wars on Earth represent historical and ongoing armed conflicts between nations and groups.", created_at:1779455646, source_id:"chunk-195432225c839e4aa9996bf06701d94e", entity_id:"Wars on Earth"}}, {_id:5358, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", entity_type:"concept", truncate:"", description:"War preparation refers to the resources and efforts allocated towards military readiness and conflict.", created_at:1779455646, source_id:"chunk-195432225c839e4aa9996bf06701d94e", entity_id:"War Preparation"}}, {_id:5359, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", entity_type:"concept", truncate:"", description:"Violent battleground symbolizes the internal struggle and conflict within an individual's mind and heart.", created_at:1779455646, source_id:"chunk-195432225c839e4aa9996bf06701d94e", entity_id:"Violent Battleground"}}, {_id:5361, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", entity_type:"UNKNOWN", truncate:"", description:"The infection has been passed through generations and communities, indicating its persistent and contagious nature.", created_at:1779455648, source_id:"chunk-195432225c839e4aa9996bf06701d94e", entity_id:"generations and communities"}}, {_id:5362, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", entity_type:"UNKNOWN", truncate:"", description:"The statement \"You can't hide from it\" underscores the inescapable reality of confronting the mental infection.", created_at:1779455648, source_id:"chunk-195432225c839e4aa9996bf06701d94e", entity_id:"hiding"}}, {_id:5366, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)<SEP>unknown_source", entity_type:"concept", truncate:"", description:"Global expenditures on war and military preparedness, contrasted with potential solutions to global challenges.<SEP>Financial resources allocated to war and military preparation, diverting funds from humanitarian needs.", created_at:1779519875, source_id:"chunk-3a7068f2a209054e42abe5d72250029a<SEP>chunk-7abe568e63ed3025b11ad246b7eb6e12", entity_id:"War Spending"}}, {_id:5367, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", entity_type:"concept", truncate:"", description:"Global hunger issues that could be addressed with a small fraction of war-related spending.<SEP>Starvation represents a critical global issue linked to resource distribution and human suffering, contrasted with military expenditures.", created_at:1779455772, source_id:"chunk-3a7068f2a209054e42abe5d72250029a<SEP>chunk-e1d5e0073f33e1ee1857e1f6302d5b7f", entity_id:"Starvation"}}, {_id:5368, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", entity_type:"concept", truncate:"", description:"Proposed balance between individual, societal, and planetary interests.<SEP>Equilibrium is needed between self, larger society, and the planet for harmony.", created_at:1779455850, source_id:"chunk-3a7068f2a209054e42abe5d72250029a<SEP>chunk-a1a3adb6e659bbb8209f01781e8bec78", entity_id:"Equilibrium"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
