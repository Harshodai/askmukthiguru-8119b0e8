UNWIND [{_id:2785, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Holding a spiritual vision enables individuals to reshape their mental and emotional states.", created_at:1779183318, source_id:"chunk-7d4c8c26b3558bb963e2145eec96c28f", entity_id:"inner world transformation"}}, {_id:2786, properties:{file_path:"unknown_source", entity_type:"category", truncate:"", description:"These brain regions are associated with increased blood flow during spiritual vision practices, reducing emotional chatter.", created_at:1779183332, source_id:"chunk-08a8bfd8ab34e14f6fb9afe4224d7966", entity_id:"Anterior Cingulate and Frontal Lobes"}}, {_id:2787, properties:{file_path:"unknown_source", entity_type:"naturalobject", truncate:"", description:"These brain structures are linked to the concept of Brahma Garbha in ancient consciousness practices.", created_at:1779183334, source_id:"chunk-1d01b8567ae6021fb37c32daeed210ed", entity_id:"Pineal, Pituitary, and Hypothalamus"}}, {_id:2788, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"These are goals achievable through the Soul Sync practice for creating personal transformation.", created_at:1779183355, source_id:"chunk-1d01b8567ae6021fb37c32daeed210ed", entity_id:"Financial Security, Nurturing Relationship, Meaningful Career, Deeper Spiritual Life, Connection with the Universe"}}, {_id:2789, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=X3LKG0Ycl3A)", entity_type:"naturalobject", truncate:"", description:"Breaths are counted during the Soul Sync practice to regulate breathing and enhance consciousness activation.<SEP>Breaths are physiological processes central to life and meditation practices.", created_at:1779728745, source_id:"chunk-1d01b8567ae6021fb37c32daeed210ed<SEP>chunk-db13cb83fc521e55cec5df8eb2ee018c", entity_id:"Breaths"}}, {_id:2790, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The world of matter refers to the physical reality where intentions manifest through the Soul Sync practice.", created_at:1779183355, source_id:"chunk-1d01b8567ae6021fb37c32daeed210ed", entity_id:"world of matter"}}, {_id:2791, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The thought barrier represents mental limitations that must be transcended to manifest intentions in the world of matter.", created_at:1779183355, source_id:"chunk-1d01b8567ae6021fb37c32daeed210ed", entity_id:"thought barrier"}}, {_id:2792, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"concept", truncate:"", description:"Pain of Being a Failure describes emotional distress tied to perceived inadequacy, influencing addiction persistence.", created_at:1779225055, source_id:"chunk-f2f9786934d74ebda8763ab5342ee99b", entity_id:"Pain of Being a Failure"}}, {_id:2793, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"concept", truncate:"", description:"Haunting Boredom signifies persistent, distressing monotony that may lead individuals to seek stimulation through addictive behaviors.", created_at:1779225057, source_id:"chunk-f2f9786934d74ebda8763ab5342ee99b", entity_id:"Haunting Boredom"}}, {_id:2794, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"concept", truncate:"", description:"Drinking refers to the consumption of alcoholic beverages, which can transition from a harmless pastime to an addiction.", created_at:1779225057, source_id:"chunk-f2f9786934d74ebda8763ab5342ee99b", entity_id:"Drinking"}}, {_id:2795, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"concept", truncate:"", description:"Binge Eating is characterized by excessive consumption of food in a short period, often linked to emotional distress.", created_at:1779225057, source_id:"chunk-f2f9786934d74ebda8763ab5342ee99b", entity_id:"Binge Eating"}}, {_id:2796, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"UNKNOWN", truncate:"", description:"The Ekam Abundance Festival is associated with people giving up their addictions, including their loved ones.<SEP>The Ekam Abundance Festival is associated with people giving up their addictions.", created_at:1779225109, source_id:"chunk-6924307324d5ba84e533d49dbdf29d98", entity_id:"Addiction cessation"}}, {_id:2797, properties:{file_path:"unknown_source", entity_type:"artifact", truncate:"", description:"Software platform hosting the audio guide for the Soul Sync practice.", created_at:1779183432, source_id:"chunk-3c49e28407e5138bcf1195c71da21835", entity_id:"App"}}, {_id:2798, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A mental state of clarity and absence of compulsive thoughts.", created_at:1779183476, source_id:"chunk-8b68736730809289d016abf18cb33a9d", entity_id:"Inner Simplicity"}}, {_id:2799, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"person", truncate:"", created_at:1779225502, description:"eldest son is a person who has been a matter of public shame for the individual.<SEP>eldest son is a person who has been a source of public shame for Ekam and has grown up with loneliness from childhood to adulthood.<SEP>The eldest son is referenced as a source of public shame in the context of No. Ekam.", source_id:"chunk-c124eb457ddeb5ac1234d8e03a8dc522<SEP>chunk-a00a616ea914a3f9cb6efa32114cd948<SEP>chunk-fe2346fa14faa0c7de81fae68776a0fd", entity_id:"eldest son"}}, {_id:2800, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Actions characterized by decisiveness and power in a beautiful state.", created_at:1779183477, source_id:"chunk-8b68736730809289d016abf18cb33a9d", entity_id:"Decisive Action"}}, {_id:2801, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The fable about Yesmi and Nomi allegorically explains the First Sacred Secret's core concept.", created_at:1779183545, source_id:"chunk-81f7d5b351616383eb1a7cca9b4d2b48", entity_id:"Monks' Story"}}, {_id:2802, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The stressful state drives conflicts, addictions, and political corruption in human societies.", created_at:1779183546, source_id:"chunk-81f7d5b351616383eb1a7cca9b4d2b48", entity_id:"Human Behavior"}}, {_id:2803, properties:{file_path:"unknown_source", entity_type:"method", truncate:"", description:"Step Six focuses on manifesting heartfelt desires in the present moment, such as healing relationships or career aspirations.", created_at:1779183668, source_id:"chunk-6e3b92943a430e127a61bead1ab61d60", entity_id:"Step Six"}}, {_id:2804, properties:{file_path:"unknown_source", entity_type:"method", truncate:"", description:"Step Five involves visualizing the transformation of one's body into light and perceiving the interconnectedness of all existence.", created_at:1779183668, source_id:"chunk-6e3b92943a430e127a61bead1ab61d60", entity_id:"Step Five"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:2805, properties:{file_path:"unknown_source<SEP>YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", entity_type:"concept", truncate:"", description:"Waking Up is a common time for practicing Soul Sync to set intentions for the day.<SEP>Waking up is a daily occurrence contextualized as a neutral act of existence, devoid of intrinsic meaning.<SEP>Waking up is analyzed as a daily occurrence linked to existence, with its significance questioned in the philosophical discourse.<SEP>Waking up is examined as a routine action questioned for its existential significance.<SEP>Waking up is presented as an action with existential significance, devoid of inherent meaning.<SEP>A daily human activity questioned for its inherent significance in the context of existence.", created_at:1779402795, source_id:"chunk-6e3b92943a430e127a61bead1ab61d60<SEP>chunk-075b8e71a3c71d11c785be4bbfe965ed<SEP>chunk-cd11c060af63780157ebf40717dc0fe2<SEP>chunk-8ac203494cdcc9d8041ac912b2411f28<SEP>chunk-e94d81180e7457d6f36d99965cfbf34d<SEP>chunk-89ddb9ac19fba38ddebc97bcf3b40b3b", entity_id:"Waking Up"}}, {_id:2806, properties:{file_path:"unknown_source", entity_type:"content", truncate:"", description:"Sanskrit Chant includes phrases like ?Ah-hum? and ?I am limitless consciousness? used in Soul Sync for spiritual alignment.", created_at:1779183668, source_id:"chunk-6e3b92943a430e127a61bead1ab61d60", entity_id:"Sanskrit Chant"}}, {_id:2807, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"New Career represents the aspiration to envision and manifest professional change via Soul Sync.", created_at:1779183668, source_id:"chunk-6e3b92943a430e127a61bead1ab61d60", entity_id:"New Career"}}, {_id:2808, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Healing Relationship refers to the desire to transform interpersonal dynamics through Soul Sync.", created_at:1779183668, source_id:"chunk-6e3b92943a430e127a61bead1ab61d60", entity_id:"Healing Relationship"}}, {_id:2809, properties:{file_path:"unknown_source", entity_type:"content", truncate:"", description:"?Ah-hum? is a Sanskrit phrase meaning ?I am,? used in Soul Sync to affirm self-connection.", created_at:1779183668, source_id:"chunk-6e3b92943a430e127a61bead1ab61d60", entity_id:"Ah-hum"}}, {_id:2810, properties:{file_path:"unknown_source", entity_type:"content", truncate:"", description:"?I am limitless consciousness? is a Sanskrit affirmation emphasizing unity with universal consciousness in Soul Sync.", created_at:1779183668, source_id:"chunk-6e3b92943a430e127a61bead1ab61d60", entity_id:"I am limitless consciousness"}}, {_id:2811, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The Unitary Field of Consciousness is a concept in Soul Sync representing the interconnectedness of all existence.", created_at:1779183668, source_id:"chunk-6e3b92943a430e127a61bead1ab61d60", entity_id:"Unitary Field of Consciousness"}}, {_id:2812, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Thought and Matter are considered unified in the context of Soul Sync, symbolizing non-duality.", created_at:1779183668, source_id:"chunk-6e3b92943a430e127a61bead1ab61d60", entity_id:"Thought and Matter"}}, {_id:2813, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Destinations symbolize endpoints or outcomes tied to goals, contrasted with the process-oriented nature of spiritual vision.", created_at:1779183674, source_id:"chunk-e48cb770a294a3d305875880cc43095f", entity_id:"Destinations"}}, {_id:2814, properties:{file_path:"unknown_source<SEP>YouTube Video: c2oUDKf6ndo (URL: https://www.youtube.com/watch?v=c2oUDKf6ndo)", entity_type:"concept", truncate:"", created_at:1779518382, description:"World Peace represents a global harmony goal pursued through meditation and spiritual practices.<SEP>World peace is a state of harmony and absence of conflict, achievable by dissolving violence and promoting spiritual recognition of women's dignity and power.<SEP>World peace is achieved by dissolving violence towards women and fostering inner peace.", source_id:"chunk-e48cb770a294a3d305875880cc43095f<SEP>chunk-8371bf8d7e493ffa27d258dec87d349a<SEP>chunk-1ae790eba9b81ee033f955299e2cd86b<SEP>chunk-d3d330d042772c704e2fd89e4454d795", entity_id:"World Peace"}}, {_id:2815, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The Emotional Trail refers to the lingering impact of past experiences, contrasted with the child's ability to move beyond pain quickly.", created_at:1779183716, source_id:"chunk-6e5caa7e31ebe95d72aef04edb890b5c", entity_id:"Emotional Trail"}}, {_id:2816, properties:{file_path:"unknown_source<SEP>YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", entity_type:"concept", truncate:"", description:"Mistakes are viewed as opportunities for growth rather than sources of fear in the Happy Child state.<SEP>Mistakes are the actions that occurred in Ahalya's life, either unknowingly or due to emotional states.", created_at:1779564419, source_id:"chunk-6e5caa7e31ebe95d72aef04edb890b5c<SEP>chunk-6a0ae176234daa0b99856020306df342", entity_id:"Mistakes"}}, {_id:2817, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"This concept describes a mental state ready for new experiences, unburdened by past pain or repetitive efforts.", created_at:1779183716, source_id:"chunk-6e5caa7e31ebe95d72aef04edb890b5c", entity_id:"Clear Slate of Consciousness"}}, {_id:2818, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Next Experience represents the readiness for new experiences without past emotional burden, as exemplified by the Happy Child's state.", created_at:1779183716, source_id:"chunk-6e5caa7e31ebe95d72aef04edb890b5c", entity_id:"Next Experience"}}, {_id:2819, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The First Life Journey is about healing the Wounded Child.", created_at:1779183733, source_id:"chunk-64bedfe4784f383c0c7cb35f66854285", entity_id:"Heal the Wounded Child"}}, {_id:2820, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The First Life Journey is about healing the Wounded Child.", created_at:1779183733, source_id:"chunk-64bedfe4784f383c0c7cb35f66854285", entity_id:"The First Life Journey"}}, {_id:2821, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"concept", truncate:"", description:"public shame refers to the concept of embarrassment or disgrace associated with the eldest son.", created_at:1779225177, source_id:"chunk-c124eb457ddeb5ac1234d8e03a8dc522", entity_id:"public shame"}}, {_id:2822, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Sh seller is a character who sells goods and experiences difficulty sleeping due to the smell of her own product.<SEP>A character in Sri Ramakrishna?s story, embodying restlessness and unresolved emotional turmoil.`", created_at:1779183742, source_id:"chunk-6b077b95a5e468c5e42f57a37944c07d<SEP>chunk-1c4d31dfa44d01e98b11093ef31cbb04", entity_id:"Sh Seller"}}, {_id:2823, properties:{file_path:"unknown_source", entity_type:"artifact", truncate:"", description:"A physical object symbolizing unresolved emotions and subconscious triggers in the sh seller?s mind.`", created_at:1779183743, source_id:"chunk-6b077b95a5e468c5e42f57a37944c07d", entity_id:"Flower Basket"}}, {_id:2824, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Ower seller is a character who sells goods and hosts the sh seller during the rain.", created_at:1779183743, source_id:"chunk-1c4d31dfa44d01e98b11093ef31cbb04", entity_id:"Ower Seller"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:2825, properties:{file_path:"unknown_source", entity_type:"artifact", truncate:"", description:"Ower basket contains goods for sale and is moved by the sh seller to alleviate her discomfort.", created_at:1779183743, source_id:"chunk-1c4d31dfa44d01e98b11093ef31cbb04", entity_id:"Ower Basket"}}, {_id:2826, properties:{file_path:"unknown_source<SEP>YouTube Video: tOi1Ho5Kwhk (URL: https://www.youtube.com/watch?v=tOi1Ho5Kwhk)", entity_type:"concept", truncate:"", description:"Sh is a product described as stinking and old, causing the sh seller discomfort.<SEP>Sh is a mantra or chant used in the Festival of Happening for spiritual practice and self-awareness.", created_at:1779428759, source_id:"chunk-1c4d31dfa44d01e98b11093ef31cbb04<SEP>chunk-c5f3bfe2a8c8ea1bf2d9597c128a1514", entity_id:"Sh"}}, {_id:2827, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Neuropsychologist Rick Hanson is a professional who studies the brain and describes it as tofu-like tissue.", created_at:1779183743, source_id:"chunk-1c4d31dfa44d01e98b11093ef31cbb04", entity_id:"Neuropsychologist Rick Hanson"}}, {_id:2828, properties:{file_path:"unknown_source", entity_type:"naturalobject", truncate:"", description:"Neuroglia are support cells in the brain that assist neurons.", created_at:1779183743, source_id:"chunk-1c4d31dfa44d01e98b11093ef31cbb04", entity_id:"Neuroglia"}}, {_id:2829, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Thoughts and emotions are mental processes that influence neural connections through repetition.", created_at:1779183743, source_id:"chunk-1c4d31dfa44d01e98b11093ef31cbb04<SEP>chunk-811f7f6fb4de9a85b774d5d90a726b13", entity_id:"Thoughts and Emotions"}}, {_id:2830, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)<SEP>YouTube Video: pTnZt0SqDFM (URL: https://www.youtube.com/watch?v=pTnZt0SqDFM)<SEP>YouTube Video: pPHQMD3w9-s (URL: https://www.youtube.com/watch?v=pPHQMD3w9-s)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=mbhdVEKEbLg)", entity_type:"concept", truncate:"", description:"The input text discusses grammatical errors in a YouTube video, including incorrect phrases and their corrections.<SEP>Grammatical errors are issues in the text, such as incorrect prepositions.<SEP>Grammatical errors refer to incorrect punctuation and redundant phrasing in the original text.<SEP>Errors in sentence structure, verb tense, or syntax.", created_at:1779728147, source_id:"chunk-764a60f0373bce6d1a2697a7aec65b1b<SEP>chunk-bf6e1c8e25957956967b751c441a4ec5<SEP>chunk-6e04a4c62d902254eca99c62ead8bb55<SEP>chunk-2e887df4e41c5e950164bbabac239c03", entity_id:"Grammatical Errors"}}, {_id:2831, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Jaya's mother is described as abusive and alcoholic, contributing to Jaya's traumatic childhood.", created_at:1779183757, source_id:"chunk-da0dcd44b642ae88bb5ae6bfa953a323", entity_id:"Abusive, Alcoholic Mother"}}, {_id:2832, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Jaya assigned an empowering meaning to her suffering, believing her trauma served a greater purpose to motivate others.", created_at:1779183758, source_id:"chunk-da0dcd44b642ae88bb5ae6bfa953a323", entity_id:"Empowering Meaning"}}, {_id:2833, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Jaya's self-image as an independent, self-made individual is revealed as a mask hiding her unresolved pain.", created_at:1779183758, source_id:"chunk-da0dcd44b642ae88bb5ae6bfa953a323", entity_id:"Independent, Self-Made Woman"}}, {_id:2834, properties:{file_path:"unknown_source<SEP>YouTube Video: PnvNqgTyIFI (URL: https://www.youtube.com/watch?v=PnvNqgTyIFI)", entity_type:"concept", truncate:"", description:"The Mask symbolizes Jaya's facade of invincibility and emotional detachment, concealing her true vulnerability.<SEP>A metaphorical mask symbolizing self-deception or denial, which is removed to reveal truth and enable self-awareness.<SEP>Mask symbolizes a metaphorical barrier to truth, described as being \"peeled back\" to reveal clarity after 38 years.<SEP>Mask symbolizes a metaphorical barrier to truth, described as being \"peeled back\" to reveal clarity after 38 years.<SEP>Mask symbolizes a metaphorical barrier to truth, described as being \"peeled back\" to reveal clarity after 38 years.", created_at:1779524397, source_id:"chunk-da0dcd44b642ae88bb5ae6bfa953a323<SEP>chunk-97418c51f26c4090e6f6b986b0a848a6<SEP>chunk-eff8e4dcfe33dc3f019672706583990a", entity_id:"Mask"}}, {_id:2835, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Jaya's realization of her injured sense of self during the retreat highlights her unresolved childhood trauma.", created_at:1779183758, source_id:"chunk-da0dcd44b642ae88bb5ae6bfa953a323", entity_id:"Injured Sense of Self"}}, {_id:2836, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The story illustrates the impact of childhood conditioning and the journey toward self-realization.`", created_at:1779183763, source_id:"chunk-6b077b95a5e468c5e42f57a37944c07d", entity_id:"Sri Ramakrishnas Story"}}, {_id:2837, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"UNKNOWN", truncate:"", description:"The text identifies specific incorrect phrases that need correction.", created_at:1779225229, source_id:"chunk-764a60f0373bce6d1a2697a7aec65b1b", entity_id:"Incorrect Phrases"}}, {_id:2838, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"UNKNOWN", truncate:"", description:"The text provides the correct versions of the incorrect phrases.", created_at:1779225229, source_id:"chunk-764a60f0373bce6d1a2697a7aec65b1b", entity_id:"Correct Phrases"}}, {_id:2841, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Generation to generation refers to the transmission of behaviors, traits, or experiences across successive generations.>", created_at:1779183797, source_id:"chunk-5d0f74c4239eabf7a6fea87da28be5d8", entity_id:"Generation to Generation"}}, {_id:2843, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"concept", truncate:"", description:"Over-eating is listed as a form of addiction or compulsive behavior.", created_at:1779225255, source_id:"chunk-f1b80dca74bf6e05c17db254a9158b6f", entity_id:"Over-eating"}}, {_id:2845, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The lion cub story serves as a metaphor for self-discovery, illustrating the transition from self-doubt to self-realization through inner awakening.", created_at:1779183827, source_id:"chunk-0c3de714c4e42df4c68c8fd79dfac5ad", entity_id:"Lion Cub Story"}}, {_id:2846, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"concept", truncate:"", description:"Classical addictions include dependencies like alcohol, nicotine, drugs, and internet gaming.", created_at:1779225256, source_id:"chunk-f1b80dca74bf6e05c17db254a9158b6f", entity_id:"Classical Addictions"}}, {_id:2848, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"event", truncate:"", description:"festival in Ekam is an event where Ekam experienced a divine intervention and became aware of his son's loneliness.", created_at:1779225388, source_id:"chunk-a00a616ea914a3f9cb6efa32114cd948", entity_id:"festival in Ekam"}}, {_id:2849, properties:{file_path:"unknown_source", entity_type:"location", truncate:"", description:"The dining hall is the location where Christina felt insulted by Lee.", created_at:1779183860, source_id:"chunk-b66967ff647e15e2ccfdb242ffc22fb6", entity_id:"Dining Hall"}}] AS row
