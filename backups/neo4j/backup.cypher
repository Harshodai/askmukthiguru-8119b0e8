UNWIND [{_id:1286, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"person", truncate:"", description:"Mei is an ikebana teacher who lived in fear of financial insecurity, leading to obsessive behavior and depression.<SEP>Mei is a character who experiences insecurity and an obsession with money, leading to compulsive behaviors and eventual self-realization.", created_at:1779143436, source_id:"chunk-bff75bb2f7b2ca92ac4ac1a9d943c725<SEP>chunk-35cc025b430daf0a7bba9a9dd5d71488", entity_id:"Mei"}}, {_id:1287, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"A moral aversion to money and wealthy individuals rooted in unresolved past experiences (\"inflammation\"), influencing financial behavior.", created_at:1779143470, source_id:"chunk-d857b265b139964df02ec1f7935d551c", entity_id:"Inner Disgust"}}, {_id:1288, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"An obsessive fixation on wealth driven by the Nobody State, manifesting as either avoidance or aggressive pursuit of financial gain.", created_at:1779143470, source_id:"chunk-d857b265b139964df02ec1f7935d551c", entity_id:"Money Mania"}}, {_id:1289, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"concept", truncate:"", description:"The Nobody State manifests as avoidance of financial entitlement, leading to undercharging and self-deprecation.<SEP>Avoidance represents the tendency to deflect responsibility or ignore the root cause of suffering by focusing on superficial explanations or external blame.", created_at:1779519253, source_id:"chunk-d857b265b139964df02ec1f7935d551c<SEP>chunk-6202900249469971e378d57b74b99662", entity_id:"Avoidance"}}, {_id:1290, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"UNKNOWN", truncate:"", description:"Dislike of money stems from unresolved past experiences (\"inflammation\"), shaping present attitudes toward wealth.", created_at:1779143471, source_id:"chunk-d857b265b139964df02ec1f7935d551c", entity_id:"Past Inflammation"}}, {_id:1291, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"financial obsession refers to an unhealthy fixation on wealth or abundance, leading to self-destructive behaviors and negative consequences for others.", created_at:1779143488, source_id:"chunk-80ca049174c7e20382ae27ec1972b6dc", entity_id:"financial obsession"}}, {_id:1292, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"the Nobody State is a mental state characterized by fear of insignificance, negative energy, and unwise decisions driven by obsession.", created_at:1779143488, source_id:"chunk-80ca049174c7e20382ae27ec1972b6dc", entity_id:"the Nobody State"}}, {_id:1293, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"person", truncate:"", description:"the people who have it are individuals associated with ney, experiencing its psychological and emotional impacts.", created_at:1779143488, source_id:"chunk-80ca049174c7e20382ae27ec1972b6dc", entity_id:"the people who have it"}}, {_id:1294, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=KTe11DlB4QI)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vNj7OSHos1I)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=X3LKG0Ycl3A)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=o_eg6YTifRE)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Vt_CjAdzebM)", entity_type:"content", truncate:"", created_at:1779736827, description:"<think>
