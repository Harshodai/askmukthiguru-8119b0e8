UNWIND [{_id:1697, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", entity_type:"concept", truncate:"", description:"Langanam of fasting movement involves sitting still in mindfulness, observing breath, nature sounds, or chanting a divine name inwardly.", created_at:1779148062, source_id:"chunk-2a50761feb8fad8d98aa8399b70c426c", entity_id:"Langanam of Fasting Movement"}}, {_id:1698, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", entity_type:"concept", truncate:"", description:"Langanam of fasting breath involves breath fasting, likening cellular activity to an engine's heat and burn rate.", created_at:1779148062, source_id:"chunk-2a50761feb8fad8d98aa8399b70c426c", entity_id:"Langanam of Fasting Breath"}}, {_id:1699, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", entity_type:"concept", truncate:"", description:"Langanam of fasting hurtful speech emphasizes avoiding negative or pessimistic speech to cultivate positive manifestation through conscious communication.", created_at:1779148062, source_id:"chunk-2a50761feb8fad8d98aa8399b70c426c", entity_id:"Langanam of Fasting Hurtful Speech"}}, {_id:1700, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", entity_type:"concept", truncate:"", description:"Globulins are antibodies that fight diseases and are classified as proteins.", created_at:1779148062, source_id:"chunk-2a50761feb8fad8d98aa8399b70c426c", entity_id:"Globulins"}}, {_id:1701, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", entity_type:"UNKNOWN", truncate:"", description:"The practice compares cellular energy consumption to an engine's heat and burn rate.", created_at:1779148063, source_id:"chunk-2a50761feb8fad8d98aa8399b70c426c", entity_id:"Cells as Engines"}}, {_id:1702, properties:{file_path:"YouTube Video: Un