UNWIND [{start: {_id:2767}, end: {name:"Oneness"}, properties:{file_path:"unknown_source", keywords:"education,spiritual teaching", truncate:"", weight:1.0, description:"Oneness's school taught conventional education alongside spiritual teachings.", created_at:1779179957, source_id:"chunk-df1ee8c2e900dce3525e47875fd865ea"}}, {start: {_id:88}, end: {name:"Oneness"}, properties:{file_path:"unknown_source", keywords:"education,interpersonal dynamics", truncate:"", weight:1.0, description:"Oneness's school taught the art of joyful relationships as part of education.", created_at:1779179957, source_id:"chunk-df1ee8c2e900dce3525e47875fd865ea"}}, {start: {_id:61}, end: {name:"Oneness"}, properties:{file_path:"unknown_source", truncate:"", keywords:"childhood innocence,spiritual awakening", weight:2.0, description:"Lokaa's participation in the Incident led to her experiencing Oneness and interconnectedness.<SEP>Lokaa's participation in the Incident led to her experiencing Oneness and interconnectedness.", created_at:1779183210, source_id:"chunk-50d6ad908c447f2c1930066f85129418"}}, {start: {_id:506}, end: {name:"Suffering State"}, properties:{file_path:"unknown_source", keywords:"perpetuation,self-focus", truncate:"", weight:1.0, description:"Christina?s suffering state was perpetuated by self-obsession, as discussed in the dialogue.", created_at:1779183899, source_id:"chunk-b66967ff647e15e2ccfdb242ffc22fb6"}}, {start: {_id:505}, end: {name:"Suffering State"}, properties:{file_path:"unknown_source", keywords:"emotional response,self-reflection", truncate:"", weight:1.0, description:"Christina entered a suffering state marked by humiliation and anger, prompting self-reflection on her emotional reactions.", created_at:1779183899, source_id:"chunk-b66967ff647e15e2ccfdb242ffc22fb6"}}, {start: {_id:826}, end: {name:"Mantra"}, properties:{file_path:"unknown_source", keywords:"focus,preparation", truncate:"", weight:1.0, description:"The mantra precedes and facilitates the focus on the heart region during the practice.", created_at:1779184411, source_id:"chunk-0f072682ae3f44593523bf73ac3ea68d"}}, {start: {_id:1326}, end: {name:"Suffering State"}, properties:{file_path:"unknown_source", keywords:"negative transformation", truncate:"", weight:1.0, description:"Kama can be pursued from a suffering state, leading to negative outcomes.", created_at:1779187600, source_id:"chunk-dc9927460d19d840d6ca22cca3f93322"}}, {start: {_id:1324}, end: {name:"Suffering State"}, properties:{file_path:"unknown_source", keywords:"negative transformation", truncate:"", weight:1.0, description:"Mukti can be pursued from a suffering state, leading to negative outcomes.", created_at:1779187601, source_id:"chunk-dc9927460d19d840d6ca22cca3f93322"}}, {start: {_id:2978}, end: {name:"Suffering State"}, properties:{file_path:"unknown_source", keywords:"negative outcome,pursuit state", truncate:"", weight:1.0, description:"Each of the four prime pursuits can be pursued from a suffering state, leading to negative outcomes.", created_at:1779187601, source_id:"chunk-dc9927460d19d840d6ca22cca3f93322"}}, {start: {_id:1382}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", keywords:"overcoming,transformation", truncate:"", weight:7.0, description:"Scott overcame his suffering through transformation, leading to a new sense of purpose.<SEP>Scott overcame suffering, which was part of his transformation.<SEP>Scott overcame suffering.", created_at:1779187848, source_id:"chunk-b628c030400a26f95b386175dbe5ab57"}}, {start: {_id:144}, end: {name:"Consciousness"}, properties:{file_path:"unknown_source", keywords:"metaphorical representation,shore of", truncate:"", weight:2.0, description:"Beautiful states are described as a shore of the ocean of consciousness, representing a specific plane of experience.", created_at:1779188049, source_id:"chunk-f2ff2524cafc909c25f1c32f713185d4"}}, {start: {_id:290}, end: {name:"Suffering State"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hwNlLB1sze0)", truncate:"", keywords:"consciousness,metaphysical effect", weight:1.0, description:"The suffering state creates blocks in consciousness, disrupting communication with universal intelligence.", created_at:1779209846, source_id:"chunk-bb8776e3af3003e2566aad28f28875b7"}}, {start: {_id:110}, end: {name:"Beautiful State"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hwNlLB1sze0)", keywords:"alignment,prerequisite", truncate:"", weight:1.0, description:"Living in a beautiful state is necessary to achieve a beautiful, purposeful life.", created_at:1779209846, source_id:"chunk-bb8776e3af3003e2566aad28f28875b7"}}, {start: {_id:704}, end: {name:"Mantra"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"mental regulation,neurological effect,silences", weight:2.0, description:"Mantra silences the overactive amygdala, reducing stress responses.<SEP>Mantra repetition silences the overactive amygdala, reducing emotional reactivity.", created_at:1779212595, source_id:"chunk-9656a8edd47ef08164c3565d2801af16<SEP>chunk-5bdd4af6edc5e8065c7f95fb8fc0543f"}}, {start: {_id:740}, end: {name:"Mantra"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", keywords:"definition,explanation", truncate:"", weight:1.0, description:"The phrase provides a Sanskrit definition of mantra as a mind-silencing tool.", created_at:1779212553, source_id:"chunk-9656a8edd47ef08164c3565d2801af16"}}, {start: {_id:748}, end: {name:"Mantra"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"combination,contextual representation,incorrect term,meditation techniques,protection,result,spiritual practice", weight:5.0, description:"Mantra is combined with dharana to focus on a form or essence during meditation.<SEP>The combination of mantra and dharana is incorrectly termed as manenath trananath in the text.<SEP>Combining mantra and dharana is discussed in the context of creating a protective concept.<SEP>The combination of mantra and dharana is described as leading to the term \"manenath trananath,\" which is supposed to represent protection.<SEP>The combination of dharana and mantra results in a protective force (\"manenath trananath\").", created_at:1779212925, source_id:"chunk-5bdd4af6edc5e8065c7f95fb8fc0543f<SEP>chunk-fe04edafc045a28a3551d9aaa81cc514<SEP>chunk-e9d6a455cfecdcbfbf4b9187a0f8773c<SEP>chunk-242c86adb935c1461785f26c0c3f9e28"}}, {start: {_id:2129}, end: {name:"Mantra"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", keywords:"example,mantra practice", truncate:"", weight:1.0, description:"Hanuman is used as an example for chanting mantras in spiritual practice.", created_at:1779212595, source_id:"chunk-5bdd4af6edc5e8065c7f95fb8fc0543f"}}, {start: {_id:774}, end: {name:"Mantra"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"conceptual origin,protection", weight:1.0, description:"Mantra contributes to the formation of \"manenath trananath,\" a protective concept.", created_at:1779212926, source_id:"chunk-242c86adb935c1461785f26c0c3f9e28"}}, {start: {_id:1352}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)", truncate:"", keywords:"health consequences,psychological impact", weight:1.0, description:"Suffering is directly linked to causing ill health within individuals.", created_at:1779217129, source_id:"chunk-c58601a836dc8ba4921372bcb850407d"}}, {start: {_id:2402}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)", truncate:"", keywords:"developmental necessity,paradoxical relationship", weight:1.0, description:"The text suggests suffering is paradoxically necessary for growth.", created_at:1779217129, source_id:"chunk-c58601a836dc8ba4921372bcb850407d"}}] AS row
