nnection?\".", created_at:1779141794, source_id:"chunk-4ca9aac0c54b5272b268630d1b3e68f9"}}, {start: {_id:901}, end: {_id:905}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"love,self-preoccupation", truncate:"", weight:1.0, description:"Shifting to other-centric consciousness enables enduring love and spontaneous responses of love.", created_at:1779141794, source_id:"chunk-4ca9aac0c54b5272b268630d1b3e68f9"}}, {start: {_id:17}, end: {_id:1085}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"deep connection,personal experience", truncate:"", weight:1.0, description:"Author highlights their significant connection with Krishnaji as part of their exploration of connection.", created_at:1779141794, source_id:"chunk-4ca9aac0c54b5272b268630d1b3e68f9"}}] AS row
