UNWIND [{start: {_id:352}, end: {_id:1163}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"passion,reconnection", truncate:"", weight:1.0, description:"The young man reconnects with his mother through cooking, awakening a new passion.", created_at:1779142699, source_id:"chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa"}}, {start: {_id:1165}, end: {_id:1163}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"invitation,transformation", truncate:"", weight:1.0, description:"The young man is invited to the foundation's event, leading to personal change.", created_at:1779142699, source_id:"chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa"}}, {start: {_id:352}, end: {_id:1170}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"employment,labor", truncate:"", weight:1.0, description:"The mother works on the rich man?s agricultural land to support her family.", created_at:1779142699, source_id:"chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa"}}, {start: {_id:1167}, end: {_id:1163}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"self-awareness,transformation", truncate:"", weight:1.0, description:"The event catalyzes the young man's self-realization and growth.", created_at:1779142699, source_id:"chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa"}}, {start: {_id:1166}, end: {_id:1163}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"liberation,self-hate", truncate:"", weight:1.0, description:"The process helps the young man overcome self-hate and familial estrangement.", created_at:1779142699, source_id:"chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa"}}, {start: {_id:1172}, end: {_id:1163}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"passion,reconnection", truncate:"", weight:1.0, description:"The shared cooking experience reignites the young man's passion for family and simple joys.", created_at:1779142699, source_id:"chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa"}}, {start: {_id:1169}, end: {_id:1163}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"invitation,opportunity", truncate:"", weight:1.0, description:"The young man interacts with the foundation?s volunteers, leading to his invitation to the event.", created_at:1779142699, source_id:"chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa"}}, {start: {_id:1171}, end: {_id:1163}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"overcoming,struggle", truncate:"", weight:1.0, description:"The young man initially struggles with self-hate but later overcomes it through the transformation process.", created_at:1779142699, source_id:"chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa"}}, {start: {_id:1175}, end: {_id:295}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"well-being", truncate:"", weight:1.0, description:"Sacrificing can lead to bitterness and regret, affecting well-being.", created_at:1779142740, source_id:"chunk-53db4a4895ca5dc8d4cc1183c39f2b74"}}, {start: {_id:1174}, end: {_id:146}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"prosperity", truncate:"", weight:1.0, description:"Opportunities and prosperity come after dissolving suffering states.", created_at:1779142740, source_id:"chunk-53db4a4895ca5dc8d4cc1183c39f2b74"}}, {start: {_id:1173}, end: {_id:295}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"well-being", truncate:"", weight:1.0, description:"Decisions for life should be made from a beautiful state, considering well-being.", created_at:1779142740, source_id:"chunk-53db4a4895ca5dc8d4cc1183c39f2b74"}}, {start: {_id:1173}, end: {_id:1174}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"decisions", truncate:"", weight:1.0, description:"Decisions for life lead to opportunities and prosperity.", created_at:1779142740, source_id:"chunk-53db4a4895ca5dc8d4cc1183c39f2b74"}}, {start: {_id:1173}, end: {_id:146}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"states", truncate:"", weight:1.0, description:"Decisions for life are made after dissolving suffering states.", created_at:1779142740, source_id:"chunk-53db4a4895ca5dc8d4cc1183c39f2b74"}}, {start: {_id:1143}, end: {_id:1176}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"ethical consideration,mutual respect", truncate:"", weight:1.0, description:"Spiritual right action requires balancing self and others' well-being without self-sacrifice.", created_at:1779142762, source_id:"chunk-14be37b1d86fb5b82128188406768290"}}, {start: {_id:1181}, end: {_id:1182}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional consequences,unmet expectations", weight:1.0, description:"Self-sacrifice without gratitude leads to bitterness and disconnection.", created_at:1779142762, source_id:"chunk-14be37b1d86fb5b82128188406768290"}}, {start: {_id:284}, end: {_id:1143}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"empathy,interconnectedness", truncate:"", weight:1.0, description:"Right action emerges naturally from a state of deep connection with others.", created_at:1779142762, source_id:"chunk-14be37b1d86fb5b82128188406768290"}}, {start: {_id:1177}, end: {_id:1143}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"harm minimization,situational awareness", weight:1.0, description:"Actions prioritize minimizing harm in complex interpersonal scenarios.", created_at:1779142762, source_id:"chunk-14be37b1d86fb5b82128188406768290"}}, {start: {_id:1179}, end: {_id:1143}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: 1PlGMOAypCI (URL: https://www.youtube.com/watch?v=1PlGMOAypCI)", truncate:"", keywords:"contextual adaptability,idealism rejection,inclusion,part", weight:2.0, description:"Right action rejects rigid ideals in favor of present-moment assessment.<SEP>Spiritual right action is part of ideal-driven behavior, which includes moral or ethical principles.", created_at:1779655621, source_id:"chunk-14be37b1d86fb5b82128188406768290<SEP>chunk-12740ae94c3469761e52a81015d8effe"}}, {start: {_id:1178}, end: {_id:1179}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"ideal projection,inspiration seeking", truncate:"", weight:1.0, description:"Reading biographies reflects attempts to apply others' ideals rather than contextual wisdom.", created_at:1779142762, source_id:"chunk-14be37b1d86fb5b82128188406768290"}}, {start: {_id:1180}, end: {_id:1143}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"mindfulness,situational presence", truncate:"", weight:1.0, description:"Ethical decisions require conscious awareness of current circumstances.", created_at:1779142762, source_id:"chunk-14be37b1d86fb5b82128188406768290"}}] AS row
