UNWIND [{start: {_id:603}, end: {_id:734}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"division,judgment", truncate:"", weight:1.0, description:"Incessant commentary leads to comparison and inner war by splitting experiences into \"should be\" and \"should not be.\"", created_at:1779139384, source_id:"chunk-6ff356fa9f4583782a04af42a23a7935"}}, {start: {_id:713}, end: {_id:737}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"inner conflict,pain", truncate:"", weight:1.0, description:"Maureen's pain is connected to her experience of warring-self states and self-criticism.", created_at:1779139384, source_id:"chunk-6ff356fa9f4583782a04af42a23a7935"}}, {start: {_id:732}, end: {_id:737}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"component,inner conflict,manifestation,self-criticism", truncate:"", weight:4.0, created_at:1779184163, description:"Warring-self states manifest as inner critics that drive self-division and steal joy and calm.<SEP>Warring-self states manifest as inner critics, leading to self-criticism and psychological conflict.<SEP>Inner critics are part of warring-self states.<SEP>Warring-self states involve inner critics.", source_id:"chunk-6ff356fa9f4583782a04af42a23a7935<SEP>chunk-7146bcb62c68c22b68c6b0cc9e8d3a09<SEP>chunk-246826c01e25761bf87cb37c0f82bbb8"}}, {start: {_id:734}, end: {_id:735}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"idealization,judgment", truncate:"", weight:1.0, description:"Incessant commentary imposes \"should be\" standards to evaluate experiences.", created_at:1779139384, source_id:"chunk-6ff356fa9f4583782a04af42a23a7935"}}, {start: {_id:734}, end: {_id:736}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"idealization,judgment", truncate:"", weight:1.0, description:"Incessant commentary imposes \"should not be\" standards to evaluate experiences.", created_at:1779139384, source_id:"chunk-6ff356fa9f4583782a04af42a23a7935"}}, {start: {_id:732}, end: {_id:733}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional theft,self-sabotage", truncate:"", weight:1.0, description:"Inner critics diminish joy and calm by perpetuating self-criticism.", created_at:1779139384, source_id:"chunk-6ff356fa9f4583782a04af42a23a7935"}}, {start: {_id:739}, end: {_id:734}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"judgment,relational conflict", truncate:"", weight:1.0, description:"Self-commentary affects family interactions by judging members against idealized standards.", created_at:1779139384, source_id:"chunk-6ff356fa9f4583782a04af42a23a7935"}}, {start: {_id:738}, end: {_id:734}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"judgment,self-criticism", truncate:"", weight:1.0, description:"Self-commentary leads to judging the body as \"should be\" or \"should not be.\"", created_at:1779139384, source_id:"chunk-6ff356fa9f4583782a04af42a23a7935"}}, {start: {_id:40}, end: {_id:739}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional balance,non-judgmental observation", weight:2.0, description:"Observing family without judgment leads to a sense of calm.", created_at:1779139407, source_id:"chunk-bdbd2fe36ae96adf18be4a84f4f759a5"}}, {start: {_id:743}, end: {_id:745}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"self-perception", truncate:"", weight:1.0, description:"Words and statements do not become a way of looking at oneself.", created_at:1779139407, source_id:"chunk-bdbd2fe36ae96adf18be4a84f4f759a5"}}, {start: {_id:751}, end: {_id:746}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"assimilation,non-blame", truncate:"", weight:1.0, description:"Failure is assimilated without the need to blame oneself or another.", created_at:1779139407, source_id:"chunk-bdbd2fe36ae96adf18be4a84f4f759a5"}}, {start: {_id:744}, end: {_id:746}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"assimilation,non-blame", truncate:"", weight:1.0, description:"Failure is assimilated without the need to blame oneself or another.", created_at:1779139407, source_id:"chunk-bdbd2fe36ae96adf18be4a84f4f759a5"}}, {start: {_id:464}, end: {_id:643}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"process,self-awareness,transformation", truncate:"", weight:2.0, description:"The exercise guides individuals from a state of internal conflict (warring self) toward self-acceptance.<SEP>Soul Sync Exercise guides the transition from the Warring Self to the Beautiful Self through mindful observation.", created_at:1779179452, source_id:"chunk-f184ea56bcea598aa525718d96f6e142<SEP>chunk-6af7eefe80697b9b2cf1b0520fd6a984"}}, {start: {_id:61}, end: {_id:757}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conflict,rebellion", truncate:"", weight:1.0, description:"Lokaa's authentic self-expression through poetry contrasts with societal pressures to conform, highlighting a rebellion against expectations.", created_at:1779139477, source_id:"chunk-f184ea56bcea598aa525718d96f6e142"}}, {start: {_id:754}, end: {_id:464}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"mindfulness,outcome,self-transformation,transformation", truncate:"", weight:2.0, description:"The exercise aims to cultivate a peaceful, harmonious self through self-observation and acceptance.<SEP>The exercise guides visualization of the Beautiful Self to replace the Warring Self through mindful observation and acceptance.", created_at:1779179453, source_id:"chunk-f184ea56bcea598aa525718d96f6e142<SEP>chunk-6af7eefe80697b9b2cf1b0520fd6a984"}}, {start: {_id:40}, end: {_id:464}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"achievement,emotional regulation,emotional state,outcome", truncate:"", weight:2.0, description:"The exercise facilitates the attainment of calmness as a result of self-acceptance.<SEP>The exercise fosters calm by encouraging acceptance of present realities without judgment.", created_at:1779179452, source_id:"chunk-f184ea56bcea598aa525718d96f6e142<SEP>chunk-6af7eefe80697b9b2cf1b0520fd6a984"}}, {start: {_id:753}, end: {_id:464}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"achievement,emotional state", truncate:"", weight:1.0, description:"The exercise promotes inner harmony by resolving self-conflict.", created_at:1779139477, source_id:"chunk-f184ea56bcea598aa525718d96f6e142"}}, {start: {_id:755}, end: {_id:464}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"achievement,emotional state", truncate:"", weight:1.0, description:"The exercise leads to self-acceptance and peace through the dissolution of internal strife.", created_at:1779139477, source_id:"chunk-f184ea56bcea598aa525718d96f6e142"}}, {start: {_id:61}, end: {_id:759}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"resilience,societal pressure", truncate:"", weight:1.0, description:"Lokaa's poetry exemplifies resilience against societal pressures to conform, highlighting the tension between authenticity and norms.", created_at:1779139516, source_id:"chunk-53499f381af4c99f9a37a7d03455b285"}}, {start: {_id:758}, end: {_id:760}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"key to,life satisfaction", truncate:"", weight:1.0, description:"Authenticity and genuine choices are emphasized as essential for a fulfilling life, contrasting with external solutions.", created_at:1779139516, source_id:"chunk-53499f381af4c99f9a37a7d03455b285"}}] AS row
