UNWIND [{start: {_id:6370}, end: {_id:6369}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"advisory efforts,failure", truncate:"", weight:1.0, description:"The Counselors tried to advise the king but could not resolve his misery.", created_at:1779558399, source_id:"chunk-3f35ef057620d3747f3f79daa132d83a"}}, {start: {_id:6372}, end: {_id:6369}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"entertainment,ineffectiveness", truncate:"", weight:1.0, description:"The Dancers performed for the king but did not alleviate his unhappiness.", created_at:1779558399, source_id:"chunk-3f35ef057620d3747f3f79daa132d83a"}}, {start: {_id:6371}, end: {_id:6369}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"entertainment,ineffectiveness", truncate:"", weight:1.0, description:"The Musicians played for the king but failed to improve his mood.", created_at:1779558399, source_id:"chunk-3f35ef057620d3747f3f79daa132d83a"}}, {start: {_id:5876}, end: {_id:6374}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"happiness,offer", weight:2.0, description:"The King offers his shirt and half the kingdom to the man in the wilderness in exchange for his shirt.", created_at:1779559811, source_id:"chunk-2906abe5180c989f9b833008109705f4"}}, {start: {_id:6375}, end: {_id:5876}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"association,belief", truncate:"", weight:1.0, description:"The King's association with the High Throne is part of his belief in happiness.", created_at:1779559811, source_id:"chunk-2906abe5180c989f9b833008109705f4"}}, {start: {_id:6374}, end: {_id:6355}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"non-existence,ownership", truncate:"", weight:2.0, description:"The man in the wilderness never owned a shirt.", created_at:1779559811, source_id:"chunk-2906abe5180c989f9b833008109705f4"}}, {start: {_id:5876}, end: {_id:6351}, properties:{file_path:"unknown_source", keywords:"guidance,wisdom", truncate:"", weight:1.0, description:"The Sage provides a magical solution to the King's unhappiness, guiding him toward self-realization.", created_at:1779559842, source_id:"chunk-f72de7c8d762c18a6655f15c49149836"}}, {start: {_id:6353}, end: {_id:6352}, properties:{file_path:"unknown_source", keywords:"discovery,transportation", truncate:"", weight:1.0, description:"The Soldiers transport the Happy Man to the King's Palace, driven by anticipation of a reward.", created_at:1779559842, source_id:"chunk-f72de7c8d762c18a6655f15c49149836"}}, {start: {_id:6357}, end: {_id:4677}, properties:{file_path:"unknown_source", keywords:"contrast,enlightenment", truncate:"", weight:1.0, description:"Eye Consciousness represents self-centeredness, while Oneness Consciousness embodies interconnectedness and holistic well-being.", created_at:1779559842, source_id:"chunk-f72de7c8d762c18a6655f15c49149836"}}, {start: {_id:5876}, end: {_id:6352}, properties:{file_path:"unknown_source", keywords:"command,execution", truncate:"", weight:1.0, description:"The King orders his soldiers to search for a happy man to fulfill the Sage's condition.", created_at:1779559842, source_id:"chunk-f72de7c8d762c18a6655f15c49149836"}}, {start: {_id:1803}, end: {_id:1071}, properties:{file_path:"unknown_source", keywords:"mission,sustainability", truncate:"", weight:1.0, description:"Akam's mission addresses challenges affecting the Earth and its inhabitants through enlightened solutions.", created_at:1779559842, source_id:"chunk-f72de7c8d762c18a6655f15c49149836"}}, {start: {_id:3654}, end: {_id:499}, properties:{file_path:"unknown_source", keywords:"societal pressure,technology impact", truncate:"", weight:1.0, description:"Artificial intelligence accelerates societal changes, increasing stress and anxiety in human populations.", created_at:1779559842, source_id:"chunk-a0046775dcffdb1de7b7527ea2dfaa5d"}}, {start: {_id:5876}, end: {_id:6355}, properties:{file_path:"unknown_source", keywords:"irony,symbolism", truncate:"", weight:1.0, description:"The King's desire for the Happy Man's shirt symbolizes his misplaced pursuit of happiness through external objects.", created_at:1779559843, source_id:"chunk-f72de7c8d762c18a6655f15c49149836"}}, {start: {_id:6380}, end: {_id:4677}, properties:{file_path:"unknown_source", keywords:"cellular harmony,healing", truncate:"", weight:1.0, description:"Practicing Oneness consciousness activates cellular cooperation for physical healing and stress reduction.", created_at:1779559843, source_id:"chunk-a0046775dcffdb1de7b7527ea2dfaa5d"}}, {start: {_id:5580}, end: {_id:499}, properties:{file_path:"unknown_source", truncate:"", keywords:"health consequences,physiological effects", weight:1.0, description:"Chronic stress leads to obesity, fatigue, and respiratory issues like shrinking lungs.", created_at:1779559843, source_id:"chunk-a0046775dcffdb1de7b7527ea2dfaa5d"}}, {start: {_id:992}, end: {_id:6358}, properties:{file_path:"unknown_source", keywords:"leadership,transformation", truncate:"", weight:2.0, description:"The couple's shift to Oneness Consciousness led to the company's miraculous recovery and growth.` - This seems correct.<SEP>The couple's shift to Oneness Consciousness led to the company's miraculous recovery and growth.`", created_at:1779559843, source_id:"chunk-d18ebd8ed5109a40c69cb7a69ecd8f61"}}, {start: {_id:5876}, end: {_id:6356}, properties:{file_path:"unknown_source", keywords:"dissatisfaction,governance", truncate:"", weight:1.0, description:"The Kingdom's people reflect the King's internal dissatisfaction, highlighting the root of societal issues.", created_at:1779559843, source_id:"chunk-f72de7c8d762c18a6655f15c49149836"}}, {start: {_id:2642}, end: {_id:1782}, properties:{file_path:"unknown_source", keywords:"collaboration,enlightenment", truncate:"", weight:1.0, description:"The Speaker and Shri Krishna co-founded Akam to promote solutions rooted in enlightened consciousness.", created_at:1779559843, source_id:"chunk-f72de7c8d762c18a6655f15c49149836"}}, {start: {_id:6353}, end: {_id:5876}, properties:{file_path:"unknown_source", keywords:"curiosity,irony", truncate:"", weight:1.0, description:"The King meets the Happy Man, who reveals the futility of his quest for happiness through material means.", created_at:1779559843, source_id:"chunk-f72de7c8d762c18a6655f15c49149836"}}, {start: {_id:6381}, end: {_id:4677}, properties:{file_path:"unknown_source", truncate:"", keywords:"spiritual alignment,universal support", weight:1.0, description:"Awakening Oneness consciousness fosters a reciprocal relationship with the universe for guidance and support.", created_at:1779559843, source_id:"chunk-a0046775dcffdb1de7b7527ea2dfaa5d"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
UNWIND [{start: {_id:992}, end: {_id:1317}, properties:{file_path:"unknown_source", keywords:"connection,gratitude", truncate:"", weight:2.0, description:"The couple felt profound connection to employees, driving gratitude and collective success.` - This seems correct.<SEP>The couple felt profound connection to employees, driving gratitude and collective success.`", created_at:1779559844, source_id:"chunk-d18ebd8ed5109a40c69cb7a69ecd8f61"}}, {start: {_id:6367}, end: {_id:4677}, properties:{file_path:"unknown_source", keywords:"ecological balance,interconnection", truncate:"", weight:1.0, description:"Addressing Earth's problems through Oneness consciousness enables Mother Nature to restore planetary harmony.", created_at:1779559844, source_id:"chunk-a0046775dcffdb1de7b7527ea2dfaa5d"}}, {start: {_id:301}, end: {_id:5876}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"dissatisfaction,seeking", truncate:"", weight:1.0, description:"King pursues happiness through various means but remains dissatisfied.", created_at:1779559886, source_id:"chunk-ff3e80d959eda2affcf9fb1d2dff2880"}}, {start: {_id:6377}, end: {_id:5876}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"ambition,unfulfillment", truncate:"", weight:1.0, description:"King acquires a bigger kingdom but finds no happiness.", created_at:1779559886, source_id:"chunk-ff3e80d959eda2affcf9fb1d2dff2880"}}, {start: {_id:6378}, end: {_id:5876}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"dissatisfaction,marriage", truncate:"", weight:1.0, description:"King marries a queen but remains unhappy.", created_at:1779559886, source_id:"chunk-ff3e80d959eda2affcf9fb1d2dff2880"}}, {start: {_id:684}, end: {_id:5876}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"parenthood,unfulfillment", truncate:"", weight:1.0, description:"King has children yet remains dissatisfied.", created_at:1779559886, source_id:"chunk-ff3e80d959eda2affcf9fb1d2dff2880"}}, {start: {_id:6379}, end: {_id:5876}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"desire,paradox", weight:1.0, description:"King seeks the beggar's shirt, but it doesn't exist, highlighting unfulfilled desire.", created_at:1779559887, source_id:"chunk-ff3e80d959eda2affcf9fb1d2dff2880"}}, {start: {_id:5876}, end: {_id:3456}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"crisis,spiritual seeking", truncate:"", weight:1.0, description:"King's dissatisfaction leads to seeking tranquility and enlightenment.", created_at:1779559887, source_id:"chunk-ff3e80d959eda2affcf9fb1d2dff2880"}}, {start: {_id:2391}, end: {_id:5876}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"spiritual journey,transformation", weight:1.0, description:"King's quest culminates in pursuing enlightenment through Akam.", created_at:1779559887, source_id:"chunk-ff3e80d959eda2affcf9fb1d2dff2880"}}, {start: {_id:6382}, end: {_id:6383}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"emotional manifestations,self-obsession", weight:1.0, description:"Ego Consciousness manifests through negative emotional states dominated by self-preoccupation.", created_at:1779559890, source_id:"chunk-7dca0f22171b9785fbbab01b79ee3fa3"}}, {start: {_id:6384}, end: {_id:5443}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"holistic awareness,positive force", weight:1.0, description:"One Consciousness is described as a constructive state fostering unity and positive change.", created_at:1779559890, source_id:"chunk-7dca0f22171b9785fbbab01b79ee3fa3"}}, {start: {_id:1803}, end: {_id:1782}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"enlightenment mission,spiritual collaboration", weight:1.0, description:"Speaker co-founded Akam with Shri Krishna ji to cultivate solutions for societal and environmental issues.", created_at:1779559891, source_id:"chunk-7dca0f22171b9785fbbab01b79ee3fa3"}}, {start: {_id:1803}, end: {_id:6382}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"consciousness framework,destructive construct", weight:1.0, description:"Akam's philosophy contrasts Ego Consciousness (destructive) with One Consciousness (constructive) as part of its teachings.", created_at:1779559891, source_id:"chunk-7dca0f22171b9785fbbab01b79ee3fa3"}}, {start: {_id:299}, end: {_id:4677}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"emotional connection,state manifestation", weight:1.0, description:"Love is a manifestation of Oneness Consciousness, emphasizing connection and compassion.", created_at:1779560068, source_id:"chunk-feadf97235c8f111320838dcf92b6b01"}}, {start: {_id:39}, end: {_id:4677}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"emotional well-being,state manifestation", weight:1.0, description:"Joy reflects Oneness Consciousness through inner peace and contentment.", created_at:1779560069, source_id:"chunk-feadf97235c8f111320838dcf92b6b01"}}, {start: {_id:4677}, end: {_id:755}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"harmony,state manifestation", weight:1.0, description:"Peace is a state of Oneness Consciousness associated with tranquility and balance.", created_at:1779560069, source_id:"chunk-feadf97235c8f111320838dcf92b6b01"}}, {start: {_id:300}, end: {_id:4677}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"appreciation,state manifestation", weight:1.0, description:"Gratitude arises from Oneness Consciousness as acknowledgment of interconnectedness.", created_at:1779560069, source_id:"chunk-feadf97235c8f111320838dcf92b6b01"}}, {start: {_id:533}, end: {_id:4677}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"empathy,state manifestation", weight:1.0, description:"Compassion in Oneness Consciousness fosters empathy and care for others.", created_at:1779560071, source_id:"chunk-feadf97235c8f111320838dcf92b6b01"}}, {start: {_id:6385}, end: {_id:4677}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"resilience,state manifestation", weight:1.0, description:"Endurance reflects Oneness Consciousness through perseverance and strength.", created_at:1779560071, source_id:"chunk-feadf97235c8f111320838dcf92b6b01"}}, {start: {_id:41}, end: {_id:4677}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"bravery,state manifestation", weight:1.0, description:"Courage emerges from Oneness Consciousness as boldness and strength.", created_at:1779560071, source_id:"chunk-feadf97235c8f111320838dcf92b6b01"}}] AS row
