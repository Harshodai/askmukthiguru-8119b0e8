UNWIND [{start: {_id:1714}, end: {_id:1741}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", keywords:"subject,technical context", truncate:"", weight:1.0, description:"The engine is the focal point of the example sentence discussing heat production.", created_at:1779148325, source_id:"chunk-16cb17d50adced4f0b0959b822d03a3e"}}, {start: {_id:1735}, end: {_id:1740}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"article critique,linguistic analysis", weight:1.0, description:"The article's example sentence is scrutinized for adherence to grammar rules regarding article usage.", created_at:1779148325, source_id:"chunk-16cb17d50adced4f0b0959b822d03a3e"}}, {start: {_id:1714}, end: {_id:1739}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", keywords:"subject,technical context", truncate:"", weight:1.0, description:"The engine is the source of heat production described in the debated sentence.", created_at:1779148325, source_id:"chunk-16cb17d50adced4f0b0959b822d03a3e"}}, {start: {_id:1741}, end: {_id:1733}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", keywords:"object,technical context", truncate:"", weight:1.0, description:"Heat is the output metric analyzed in the debated example sentence.", created_at:1779148325, source_id:"chunk-16cb17d50adced4f0b0959b822d03a3e"}}, {start: {_id:1743}, end: {_id:1742}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", keywords:"accuracy,correction", truncate:"", weight:1.0, description:"The correct phrase resolves the grammatical error in the article.", created_at:1779148367, source_id:"chunk-791613ee96d428f562709fadee905618"}}, {start: {_id:1742}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)<SEP>YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", truncate:"", keywords:"analysis,critique,discussion,error identification,text analysis,transcription inaccuracies", weight:4.0, description:"The YouTube Video critiques the article's grammatical inaccuracy regarding engine terminology.<SEP>The YouTube video contains grammatical errors in its transcript that require correction.<SEP>The video discusses the grammatical error in the sentence regarding subject-verb agreement.<SEP>The YouTube video contains grammatical errors that need to be identified and corrected.", created_at:1779724466, source_id:"chunk-791613ee96d428f562709fadee905618<SEP>chunk-ac963c80865bf4f33baf1d166cbe42de<SEP>chunk-c3bdf300b2509154604072df1057a411<SEP>chunk-c32bf7fcfe6dd8d2fa78dd2f0cb30726"}}, {start: {_id:1735}, end: {_id:1742}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", keywords:"content analysis,error", truncate:"", weight:1.0, description:"The article contains a grammatical error in its phrasing of engine-related content.", created_at:1779148368, source_id:"chunk-791613ee96d428f562709fadee905618"}}, {start: {_id:1735}, end: {_id:1744}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"content,error", weight:1.0, description:"The article incorrectly uses \"the more heat, an engine produces.\"", created_at:1779148368, source_id:"chunk-791613ee96d428f562709fadee905618"}}, {start: {_id:1734}, end: {_id:1745}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"grammar rules,linguistic analysis", weight:1.0, description:"Article usage is a component of grammatical structure governing correct sentence formation.", created_at:1779148408, source_id:"chunk-8aa2f59e36f19c5d55a059a126d62dac"}}, {start: {_id:1745}, end: {_id:1746}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"language standards,syntax rules", weight:1.0, description:"Sentence correction aligns sentences with established grammatical structure principles.", created_at:1779148408, source_id:"chunk-8aa2f59e36f19c5d55a059a126d62dac"}}, {start: {_id:1734}, end: {_id:1746}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"error identification,linguistic intervention", weight:1.0, description:"Sentence correction addresses incorrect article usage to achieve grammatical accuracy.", created_at:1779148408, source_id:"chunk-8aa2f59e36f19c5d55a059a126d62dac"}}, {start: {_id:1748}, end: {_id:1751}, properties:{file_path:"unknown_source", keywords:"bonding,neurochemical", truncate:"", weight:1.0, description:"Oxytocin is released during loving touch, facilitating emotional bonding and healing.`", created_at:1779148561, source_id:"chunk-a77f1fee05f090e6b596f48781d6d33a"}}, {start: {_id:1406}, end: {_id:1749}, properties:{file_path:"unknown_source", keywords:"belonging,prevention", truncate:"", weight:1.0, description:"Kathana combats depression by fostering belonging through communal storytelling, countering loneliness.`", created_at:1779148561, source_id:"chunk-a77f1fee05f090e6b596f48781d6d33a"}}, {start: {_id:108}, end: {_id:1669}, properties:{file_path:"unknown_source", keywords:"meditation,surrender", truncate:"", weight:1.0, description:"Meditative practices involving the divine aid in quieting the mind for sleep, indirectly preventing depression.`", created_at:1779148561, source_id:"chunk-a77f1fee05f090e6b596f48781d6d33a"}}, {start: {_id:1406}, end: {_id:1751}, properties:{file_path:"unknown_source", keywords:"oxytocin release,prevention", truncate:"", weight:1.0, description:"Loving touch releases oxytocin, alleviating heartache and healing emotional distress linked to depression.`", created_at:1779148561, source_id:"chunk-a77f1fee05f090e6b596f48781d6d33a"}}, {start: {_id:1406}, end: {_id:1747}, properties:{file_path:"unknown_source", keywords:"prevention,self-awareness", truncate:"", weight:1.0, description:"Self-friendship helps recognize early emotional disturbances to prevent depression escalation.`", created_at:1779148561, source_id:"chunk-a77f1fee05f090e6b596f48781d6d33a"}}, {start: {_id:1406}, end: {_id:371}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", keywords:"cause,causes,disconnection,mental health,mental health crisis,social isolation", truncate:"", weight:3.0, created_at:1779236648, description:"Loneliness and disconnection are root causes of depression, addressed by Yuktis to restore connection.`<SEP>Loneliness is linked to depression as a result of isolation and unmet emotional needs.<SEP>Loneliness from individualistic lifestyles leads to widespread depression.", source_id:"chunk-a77f1fee05f090e6b596f48781d6d33a<SEP>chunk-1f205cfd4f752f944e4f589c26e28701<SEP>chunk-c2dfb10d73bb85ba3334f2281cc0afee"}}, {start: {_id:1755}, end: {_id:1750}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=odXq5g-Y7gM)", truncate:"", keywords:"scientific basis,spiritual basis", weight:1.0, description:"Yuktis are grounded in neuroscience and spiritual wisdom as dual foundations.", created_at:1779148636, source_id:"chunk-f72535558ce867c4994087fd8e358aea"}}, {start: {_id:1406}, end: {_id:1669}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=odXq5g-Y7gM)", keywords:"bidirectional relationship", truncate:"", weight:1.0, description:"Depression and sleep disturbances mutually reinforce each other in a cyclical manner.", created_at:1779148636, source_id:"chunk-f72535558ce867c4994087fd8e358aea"}}, {start: {_id:1754}, end: {_id:1750}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=odXq5g-Y7gM)", truncate:"", keywords:"spiritual basis,universal principles", weight:1.0, description:"Yuktis draw from spiritual wisdom about human connection and cosmic order.", created_at:1779148636, source_id:"chunk-f72535558ce867c4994087fd8e358aea"}}] AS row
