UNWIND [{start: {_id:1024}, end: {_id:5678}, properties:{file_path:"YouTube Video: EhY6npcnSs8 (URL: https://www.youtube.com/watch?v=EhY6npcnSs8)", truncate:"", keywords:"advocacy,wish", weight:1.0, description:"The culture expresses a wish for peace in all nations of the world as part of its core values.", created_at:1779520795, source_id:"chunk-c1132eb602efecba3dcd1e9547e3e420"}}, {start: {_id:1024}, end: {_id:1799}, properties:{file_path:"YouTube Video: EhY6npcnSs8 (URL: https://www.youtube.com/watch?v=EhY6npcnSs8)", truncate:"", keywords:"advocacy,wish", weight:1.0, description:"The culture advocates for peace among all human beings as a fundamental desire.", created_at:1779520795, source_id:"chunk-c1132eb602efecba3dcd1e9547e3e420"}}, {start: {_id:1024}, end: {_id:287}, properties:{file_path:"YouTube Video: EhY6npcnSs8 (URL: https://www.youtube.com/watch?v=EhY6npcnSs8)", truncate:"", keywords:"advocacy,wish", weight:1.0, description:"The culture emphasizes peace for all life, extending beyond human existence to encompass all living beings.", created_at:1779520795, source_id:"chunk-c1132eb602efecba3dcd1e9547e3e420"}}, {start: {_id:5682}, end: {_id:2390}, properties:{file_path:"unknown_source", keywords:"enlightenment,spiritual practice", truncate:"", weight:1.0, description:"Spirituality serves as the foundation for achieving awakened states and God realization.", created_at:1779520810, source_id:"chunk-4675fae3df6dc621969cec7edcf35797"}}, {start: {_id:32}, end: {_id:5679}, properties:{file_path:"unknown_source", keywords:"alignment,unification", truncate:"", weight:1.0, description:"Role, purpose, and mission can be unified or distinct depending on individual circumstances, requiring alignment for fulfillment.", created_at:1779520810, source_id:"chunk-4675fae3df6dc621969cec7edcf35797"}}, {start: {_id:5680}, end: {_id:32}, properties:{file_path:"unknown_source", keywords:"clarity,direct influence", truncate:"", weight:1.0, description:"Clarifying one's purpose automatically defines their mission and subsequent role.", created_at:1779520810, source_id:"chunk-4675fae3df6dc621969cec7edcf35797"}}, {start: {_id:5681}, end: {_id:5679}, properties:{file_path:"unknown_source", keywords:"alignment,fulfillment", truncate:"", weight:1.0, description:"Aligning role with purpose and mission leads to life satisfaction and contentment.", created_at:1779520810, source_id:"chunk-4675fae3df6dc621969cec7edcf35797"}}, {start: {_id:5680}, end: {_id:5679}, properties:{file_path:"unknown_source", keywords:"necessity,practical application", truncate:"", weight:1.0, description:"Fulfilling a mission necessitates specific actions (role), such as acting to become an actor.", created_at:1779520810, source_id:"chunk-4675fae3df6dc621969cec7edcf35797"}}, {start: {_id:5681}, end: {_id:32}, properties:{file_path:"unknown_source", keywords:"clarity,fulfillment", truncate:"", weight:1.0, description:"Understanding one's purpose contributes to life satisfaction through purposeful living.", created_at:1779520810, source_id:"chunk-4675fae3df6dc621969cec7edcf35797"}}, {start: {_id:123}, end: {_id:5373}, properties:{file_path:"YouTube Video: EhY6npcnSs8 (URL: https://www.youtube.com/watch?v=EhY6npcnSs8)", truncate:"", keywords:"historical repetition,war-mongering tendency", weight:1.0, description:"Humanity exhibits a persistent tendency toward war despite millennia of recorded history and its destructive outcomes.", created_at:1779520829, source_id:"chunk-6fa29767ceb8e0fa67cf872f6c5dc513"}}, {start: {_id:5662}, end: {_id:5663}, properties:{file_path:"YouTube Video: EhY6npcnSs8 (URL: https://www.youtube.com/watch?v=EhY6npcnSs8)", truncate:"", keywords:"evolutionary comparison,species contrast", weight:1.0, description:"Bonobos and chimpanzees are contrasted in the context of human evolutionary origins, with bonobos representing a hypothetical peaceful alternative.", created_at:1779520829, source_id:"chunk-6fa29767ceb8e0fa67cf872f6c5dc513"}}, {start: {_id:5666}, end: {_id:5670}, properties:{file_path:"YouTube Video: EhY6npcnSs8 (URL: https://www.youtube.com/watch?v=EhY6npcnSs8)", truncate:"", keywords:"futility of war,tragic outcome", weight:1.0, description:"The Mahabharata War exemplifies how victory leads to profound loss and suffering, questioning its value.", created_at:1779520829, source_id:"chunk-6fa29767ceb8e0fa67cf872f6c5dc513"}}, {start: {_id:123}, end: {_id:5673}, properties:{file_path:"YouTube Video: EhY6npcnSs8 (URL: https://www.youtube.com/watch?v=EhY6npcnSs8)", truncate:"", keywords:"behavioral contradiction,societal complexity", weight:1.0, description:"Humanity is defined by contradictory traits like peace/war and wealth/insecurity, reflecting internal conflict.", created_at:1779520830, source_id:"chunk-6fa29767ceb8e0fa67cf872f6c5dc513"}}, {start: {_id:5671}, end: {_id:5373}, properties:{file_path:"YouTube Video: EhY6npcnSs8 (URL: https://www.youtube.com/watch?v=EhY6npcnSs8)", truncate:"", keywords:"global impact,post-war consequences", weight:1.0, description:"Wars like World War Two lead to long-term consequences such as terrorism and societal instability.", created_at:1779520830, source_id:"chunk-6fa29767ceb8e0fa67cf872f6c5dc513"}}, {start: {_id:1474}, end: {_id:2390}, properties:{file_path:"YouTube Video: 5YJ6vynFWFc (URL: https://www.youtube.com/watch?v=5YJ6vynFWFc)", truncate:"", keywords:"enlightenment,spiritual goal", weight:1.0, description:"Spirituality aims to awaken people and achieve God realization.", created_at:1779520830, source_id:"chunk-dd506a27566aa3b0948c2e961bb69dbf"}}, {start: {_id:292}, end: {_id:5373}, properties:{file_path:"YouTube Video: EhY6npcnSs8 (URL: https://www.youtube.com/watch?v=EhY6npcnSs8)", truncate:"", keywords:"conflict initiation,motivational driver", weight:1.0, description:"Hate is identified as a primary motivator for initiating wars and violent conflicts.", created_at:1779520830, source_id:"chunk-6fa29767ceb8e0fa67cf872f6c5dc513"}}, {start: {_id:5675}, end: {_id:123}, properties:{file_path:"YouTube Video: EhY6npcnSs8 (URL: https://www.youtube.com/watch?v=EhY6npcnSs8)", truncate:"", keywords:"insecurity response,territorial behavior", weight:1.0, description:"Humanity addresses powerlessness and insecurity through territorial expansion despite the risks of conflict.", created_at:1779520830, source_id:"chunk-6fa29767ceb8e0fa67cf872f6c5dc513"}}, {start: {_id:5674}, end: {_id:5373}, properties:{file_path:"YouTube Video: EhY6npcnSs8 (URL: https://www.youtube.com/watch?v=EhY6npcnSs8)", truncate:"", keywords:"generational trauma,lasting impact", weight:1.0, description:"Wars leave enduring scars on societies, persisting across generations and influencing future behavior.", created_at:1779520831, source_id:"chunk-6fa29767ceb8e0fa67cf872f6c5dc513"}}, {start: {_id:123}, end: {_id:5676}, properties:{file_path:"YouTube Video: EhY6npcnSs8 (URL: https://www.youtube.com/watch?v=EhY6npcnSs8)", truncate:"", keywords:"cyclical repetition,learning failure", weight:1.0, description:"Despite 10,000 years of recorded history, humanity has not learned to avoid repeating destructive patterns of war.", created_at:1779520831, source_id:"chunk-6fa29767ceb8e0fa67cf872f6c5dc513"}}, {start: {_id:1782}, end: {_id:5686}, properties:{file_path:"YouTube Video: 5YJ6vynFWFc (URL: https://www.youtube.com/watch?v=5YJ6vynFWFc)", truncate:"", keywords:"mission statement,role definition", weight:1.0, description:"Speaker identifies as a spiritual teacher whose mission is to guide others into awakened states.", created_at:1779520856, source_id:"chunk-1118c9b4ddb64c612c4d8aecbb280b07"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
