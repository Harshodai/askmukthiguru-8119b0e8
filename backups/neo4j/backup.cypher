UNWIND [{start: {_id:3294}, end: {_id:5320}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"philosophical themes,social issues", weight:1.0, description:"The video discusses racial discrimination as a symptom of separation and division.", created_at:1779452826, source_id:"chunk-c5d032c6a2271ec421a56c36fda060bb"}}, {start: {_id:3291}, end: {_id:5320}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"cultural context,social issues", weight:1.0, description:"Caste discrimination is presented as a specific example of societal inequality.", created_at:1779452826, source_id:"chunk-c5d032c6a2271ec421a56c36fda060bb"}}, {start: {_id:5320}, end: {_id:5321}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"economic inequality,social issues", weight:1.0, description:"Wealth discrimination is framed as a form of systemic separation.", created_at:1779452827, source_id:"chunk-c5d032c6a2271ec421a56c36fda060bb"}}, {start: {_id:5320}, end: {_id:5322}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"philosophical theme,unity", truncate:"", weight:1.0, description:"The video promotes \"true oneness\" as the antidote to societal divisions.", created_at:1779452827, source_id:"chunk-c5d032c6a2271ec421a56c36fda060bb"}}, {start: {_id:5323}, end: {_id:5320}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"collective responsibility,interconnectedness", weight:1.0, description:"Human species is portrayed as needing to embrace unity and mutual care.", created_at:1779452827, source_id:"chunk-c5d032c6a2271ec421a56c36fda060bb"}}, {start: {_id:5320}, end: {_id:2544}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"conflict,societal issues", truncate:"", weight:1.0, description:"Unawakened consciousness is linked to the origin of discrimination and division.", created_at:1779452827, source_id:"chunk-c5d032c6a2271ec421a56c36fda060bb"}}, {start: {_id:5324}, end: {_id:5320}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"conflict,social constructs", weight:1.0, description:"Money, power, and ambition are shown as expressions of conflict-driven human behavior.", created_at:1779452828, source_id:"chunk-c5d032c6a2271ec421a56c36fda060bb"}}, {start: {_id:5325}, end: {_id:5320}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"contrast,philosophical theme", weight:1.0, description:"The video contrasts ordinary peace with the concept of true oneness, emphasizing the need for deeper interconnectedness.", created_at:1779452828, source_id:"chunk-c5d032c6a2271ec421a56c36fda060bb"}}, {start: {_id:1500}, end: {_id:5326}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", keywords:"correction,mishearing", truncate:"", weight:1.0, description:"peace festival was a mishearing of \"Limitless Field\", leading to its correction in the text.", created_at:1779452927, source_id:"chunk-cb58e055a049ad330cf62961e6ace3a0"}}, {start: {_id:5327}, end: {_id:152}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"intrinsic characteristics,manifestation", weight:1.0, description:"consciousness is intrinsically linked to conflict and pain as manifestations of its unawakened state.", created_at:1779452927, source_id:"chunk-cb58e055a049ad330cf62961e6ace3a0"}}, {start: {_id:5329}, end: {_id:5330}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"core principle,philosophical foundation", weight:1.0, description:"The true state of oneness underpins the concept of enlightened human beings in the discussed philosophy.", created_at:1779452945, source_id:"chunk-c7acaad240d059f10b98d44f2fbe69ce"}}, {start: {_id:5328}, end: {_id:5319}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"collective evolution,philosophical alignment,shared goal,spiritual transformation,vision,visionary concept", weight:3.0, created_at:1779454017, description:"Prithais is associated with the vision of human awakening and enlightenment.<SEP>Prithais advocates for humanity's transition to enlightened existence.<SEP>Prithais shares the vision of awakening with the speaker.", source_id:"chunk-c7acaad240d059f10b98d44f2fbe69ce<SEP>chunk-1756c3e8d7e9eefbffb3f49a179b77fc<SEP>chunk-d319e7ca1c821b8d3953f9189c7b08fd"}}, {start: {_id:5330}, end: {_id:5318}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"content analysis,philosophical discussion", weight:1.0, description:"The video contains text analyzing the concept of oneness and human states of consciousness.", created_at:1779452946, source_id:"chunk-c7acaad240d059f10b98d44f2fbe69ce"}}, {start: {_id:5328}, end: {_id:5329}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"enlightenment,progression,progressive state,spiritual hierarchy,state,transformation", weight:3.0, created_at:1779454017, description:"Awakened human beings are presented as a precursor to enlightened human beings in the text's framework.<SEP>Awakened human beings become enlightened human beings through the process of enlightenment, leading to a state of true oneness.<SEP>Awakened human beings progress to enlightened human beings as part of the vision.", source_id:"chunk-c7acaad240d059f10b98d44f2fbe69ce<SEP>chunk-789bf2d75055e2793929c4fd3bb0d56b<SEP>chunk-d319e7ca1c821b8d3953f9189c7b08fd"}}, {start: {_id:2144}, end: {_id:5330}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"conceptual correction,conceptual emphasis,conceptual repetition,redundancy", weight:4.0, description:"The original text redundantly emphasizes the \"true state of oneness\" through repeated phrasing.<SEP>The original text redundantly mentions the \"true state of oneness.\"<SEP>The original text's error (\"about judgments\") is corrected to reference the \"true state of oneness.\"<SEP>The original text's error (\"about judgments\") is corrected to reference the \"true state of oneness.\"", created_at:1779453877, source_id:"chunk-0f552efe7570d318a6ba9ae560f12962<SEP>chunk-bf775281b0e0ffbc9e43851a7fa22924"}}, {start: {_id:5331}, end: {_id:348}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"content inclusion,textual analysis", weight:1.0, description:"The YouTube video presents the proposed fix as a revised version of the original text to improve clarity and flow.", created_at:1779452990, source_id:"chunk-0f552efe7570d318a6ba9ae560f12962"}}, {start: {_id:5331}, end: {_id:5330}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"conceptual integration,textual revision", weight:1.0, description:"The proposed fix integrates the \"true state of oneness\" into a cohesive statement with \"awakened\" and \"enlightened\" human beings.", created_at:1779452990, source_id:"chunk-0f552efe7570d318a6ba9ae560f12962"}}, {start: {_id:5328}, end: {_id:5331}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"conceptual alignment,textual representation", weight:1.0, description:"The proposed fix aligns the concept of \"awakened human beings\" with the true state of oneness.", created_at:1779452990, source_id:"chunk-0f552efe7570d318a6ba9ae560f12962"}}, {start: {_id:5329}, end: {_id:5331}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"conceptual alignment,textual representation", weight:1.0, description:"The proposed fix aligns the concept of \"enlightened human beings\" with the true state of oneness.", created_at:1779452990, source_id:"chunk-0f552efe7570d318a6ba9ae560f12962"}}, {start: {_id:1500}, end: {_id:5322}, properties:{file_path:"YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", truncate:"", keywords:"awakening,philosophical state,spiritual concept,unity", weight:2.0, description:"The Limitless Field facilitates the transition into a state of true oneness through meditation and awakening.<SEP>The Limitless Field is the context in which the state of true oneness is achieved through meditative practice.", created_at:1779453162, source_id:"chunk-789bf2d75055e2793929c4fd3bb0d56b<SEP>chunk-f1f81e864da7b8ec0ed93a28a3397730"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
