UNWIND [{start: {_id:2404}, end: {_id:755}, properties:{file_path:"unknown_source<SEP>YouTube Video: 3ITFXvYIPqg (URL: https://www.youtube.com/watch?v=3ITFXvYIPqg)", keywords:"emotional cultivation,nurturing,personal,societal", truncate:"", weight:2.0, description:"Peace in individuals can radiate to families, organizations, and nations.<SEP>The individual maintains peace as a deliberate emotional practice.", created_at:1779524833, source_id:"chunk-8ae1e84c94c9daf68cd33af74bbc6fbf<SEP>chunk-55501b6eda54d23ad2ef3c8a94319a9a"}}, {start: {_id:5667}, end: {_id:5665}, properties:{file_path:"unknown_source", keywords:"conflict,outcome", truncate:"", weight:1.0, description:"Aggression is linked to World War Two.", created_at:1779520631, source_id:"chunk-8ae1e84c94c9daf68cd33af74bbc6fbf"}}, {start: {_id:123}, end: {_id:3271}, properties:{file_path:"unknown_source", keywords:"conflict,ingrained traits", truncate:"", weight:1.0, description:"Violence is an inherent trait of humanity that leads to wars.", created_at:1779520631, source_id:"chunk-8ae1e84c94c9daf68cd33af74bbc6fbf"}}, {start: {_id:39}, end: {_id:5670}, properties:{file_path:"unknown_source", keywords:"emotion,outcome", truncate:"", weight:1.0, description:"Victory does not give true joy, only the thrill of crushing the enemy.", created_at:1779520631, source_id:"chunk-8ae1e84c94c9daf68cd33af74bbc6fbf"}}, {start: {_id:5671}, end: {_id:5665}, properties:{file_path:"unknown_source", keywords:"aftermath", truncate:"", weight:1.0, description:"Terrorism is an aftermath of World War Two.", created_at:1779520631, source_id:"chunk-8ae1e84c94c9daf68cd33af74bbc6fbf"}}, {start: {_id:5662}, end: {_id:123}, properties:{file_path:"unknown_source", keywords:"hypothetical,peaceful", truncate:"", weight:1.0, description:"Bonobos are a hypothetical peaceful ancestor for humanity.", created_at:1779520631, source_id:"chunk-8ae1e84c94c9daf68cd33af74bbc6fbf"}}, {start: {_id:5663}, end: {_id:123}, properties:{file_path:"unknown_source", keywords:"actual,aggressive", truncate:"", weight:1.0, description:"Chimpanzees are the actual aggressive ancestor for humanity.", created_at:1779520632, source_id:"chunk-8ae1e84c94c9daf68cd33af74bbc6fbf"}}, {start: {_id:123}, end: {_id:5672}, properties:{file_path:"unknown_source", keywords:"ancestral,hypothetical", truncate:"", weight:1.0, description:"Two million years ago is a time related to hypothetical ancestral origins.", created_at:1779520632, source_id:"chunk-8ae1e84c94c9daf68cd33af74bbc6fbf"}}, {start: {_id:2500}, end: {_id:755}, properties:{file_path:"unknown_source", keywords:"global,national", truncate:"", weight:1.0, description:"Peace in nations is a goal for millions of Indians and Chinese.", created_at:1779520632, source_id:"chunk-8ae1e84c94c9daf68cd33af74bbc6fbf"}}, {start: {_id:2500}, end: {_id:252}, properties:{file_path:"unknown_source", keywords:"mutual", truncate:"", weight:1.0, description:"Nations and organizations are entities that can pray for peace.", created_at:1779520633, source_id:"chunk-8ae1e84c94c9daf68cd33af74bbc6fbf"}}, {start: {_id:991}, end: {_id:755}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", truncate:"", keywords:"foundational pillar,self-compassion", weight:1.0, description:"Forgiveness initiates peace by fostering self-acceptance and inner tranquility.", created_at:1779520658, source_id:"chunk-3f4d48e02ed3cffc983ab81c8c5b5555"}}, {start: {_id:4499}, end: {_id:5647}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", truncate:"", keywords:"curriculum integration,societal impact", weight:1.0, description:"Peace studies in education aim to nurture global harmony through systemic change.", created_at:1779520658, source_id:"chunk-3f4d48e02ed3cffc983ab81c8c5b5555"}}, {start: {_id:4499}, end: {_id:39}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", truncate:"", keywords:"emotional balance,holistic development", weight:1.0, description:"Joy is prioritized alongside peace in children?s education for balanced growth.", created_at:1779520658, source_id:"chunk-3f4d48e02ed3cffc983ab81c8c5b5555"}}, {start: {_id:5646}, end: {_id:755}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", truncate:"", keywords:"conflict resolution,empathy", weight:1.0, description:"Non-judgment dissolves interpersonal conflict through mutual understanding.", created_at:1779520658, source_id:"chunk-3f4d48e02ed3cffc983ab81c8c5b5555"}}, {start: {_id:533}, end: {_id:755}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", truncate:"", keywords:"emotional connection,shared humanity", weight:1.0, description:"Compassion arises from recognizing universal human emotions, deepening relational harmony.", created_at:1779520658, source_id:"chunk-3f4d48e02ed3cffc983ab81c8c5b5555"}}, {start: {_id:5648}, end: {_id:755}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", truncate:"", keywords:"emotional release,mutual respect", weight:1.0, description:"Releasing judgment enables transformative empathy in relationships.", created_at:1779520659, source_id:"chunk-3f4d48e02ed3cffc983ab81c8c5b5555"}}, {start: {_id:755}, end: {_id:894}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", keywords:"application,awareness", truncate:"", weight:1.0, description:"Police use their power with great awareness to contribute to peace.", created_at:1779520659, source_id:"chunk-3f4d48e02ed3cffc983ab81c8c5b5555"}}, {start: {_id:5649}, end: {_id:755}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", keywords:"awareness,implementation", truncate:"", weight:1.0, description:"Bureaucrats apply their power with awareness to promote peace.", created_at:1779520659, source_id:"chunk-3f4d48e02ed3cffc983ab81c8c5b5555"}}, {start: {_id:1395}, end: {_id:755}, properties:{file_path:"YouTube Video: Ao8Rhhl9E8k (URL: https://www.youtube.com/watch?v=Ao8Rhhl9E8k)", keywords:"advocacy,leadership", truncate:"", weight:1.0, description:"Leaders drive organizations and nations towards peace.", created_at:1779520659, source_id:"chunk-3f4d48e02ed3cffc983ab81c8c5b5555"}}, {start: {_id:5677}, end: {_id:755}, properties:{file_path:"YouTube Video: EhY6npcnSs8 (URL: https://www.youtube.com/watch?v=EhY6npcnSs8)", keywords:"advocacy,promotion", truncate:"", weight:1.0, description:"The video promotes peace in nations, human beings, and all life through its spiritual and cultural messaging.", created_at:1779520795, source_id:"chunk-c1132eb602efecba3dcd1e9547e3e420"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
