UNWIND [{start: {_id:1318}, end: {name:"Samsara"}, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", truncate:"", keywords:"discussion,spiritual connection", weight:1.0, description:"He is connected to Samsara in a spiritual or philosophical context.", created_at:1779433502, source_id:"chunk-5baab383769ea33393f76b07d34a78c0"}}, {start: {_id:5104}, end: {name:"Satsang"}, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", truncate:"", keywords:"cause,outcome", weight:1.0, description:"The Satsang led to significant business growth, resulting in a 400% increase.", created_at:1779433889, source_id:"chunk-a8830e719ab8be4a9944bce2ee0a988b"}}, {start: {_id:300}, end: {name:"Satsang"}, properties:{file_path:"YouTube Video: owC8E_G2fY4 (URL: https://www.youtube.com/watch?v=owC8E_G2fY4)", truncate:"", keywords:"cause,recognition", weight:1.0, description:"The Satsang was the context in which the speaker expressed gratitude for the business growth.", created_at:1779433890, source_id:"chunk-a8830e719ab8be4a9944bce2ee0a988b"}}, {start: {_id:5116}, end: {name:"Consciousness"}, properties:{file_path:"YouTube Video: 2JL1ZgMS7nY (URL: https://www.youtube.com/watch?v=2JL1ZgMS7nY)", truncate:"", keywords:"cascading change,initiator", weight:1.0, description:"Conscious actions can trigger an avalanche of transformative outcomes.", created_at:1779436363, source_id:"chunk-62f545b8a18583cad0e4d9409246e40c"}}, {start: {_id:5282}, end: {name:"Consciousness"}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", keywords:"necessity,personal growth", truncate:"", weight:1.0, description:"Connected people require awakened consciousness to embrace positive change.", created_at:1779447486, source_id:"chunk-e27c90d3f030c932363441c1ed78bf62"}}, {start: {_id:5273}, end: {name:"Ekam"}, properties:{file_path:"YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)", truncate:"", keywords:"conceptual association,proposed term", weight:1.0, description:"\"Ekam\" is suggested as a domain-specific term related to the dissatisfaction state's context.", created_at:1779447974, source_id:"chunk-c20a2f436d20bbb7182961653d101544"}}, {start: {_id:1474}, end: {name:"Consciousness"}, properties:{file_path:"unknown_source", keywords:"awakening,awareness,realization", truncate:"", weight:2.0, description:"Awakening leads to heightened consciousness and awareness of global challenges.<SEP>Awakening involves recognizing consciousness as the witness beyond thoughts.", created_at:1779522100, source_id:"chunk-06677578ca40c691ebe5110657b20260<SEP>chunk-97418c51f26c4090e6f6b986b0a848a6"}}, {start: {_id:5345}, end: {name:"Ekam"}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", truncate:"", keywords:"correction,domain-specific term,name correction,spelling,standardization", weight:4.0, created_at:1779510748, description:"ACOM is corrected to Ekam due to consistent spelling and pronunciation requirements.<SEP>ACOM is a term that should be replaced with \"Ekam\".<SEP>Ekam is a corrected term from \"ACOM\".<SEP>\"ACOM\" is standardized to \"Ekam\" as per the reference list for organizational consistency.", source_id:"chunk-8e11843c5e5d416ebb2d563613787d4b<SEP>chunk-967a1ebc79cd7d83afc2b43d42c8ab36<SEP>chunk-bfcad8a2e2d4df5f6523bcfa541887ac"}}, {start: {_id:5354}, end: {name:"Ekam"}, properties:{file_path:"YouTube Video: 4LIZkNHlNaM (URL: https://www.youtube.com/watch?v=4LIZkNHlNaM)", truncate:"", keywords:"content,source", weight:1.0, description:"The YouTube video addresses the correction of \"ACOM\" to \"Ekam\".", created_at:1779455626, source_id:"chunk-8e11843c5e5d416ebb2d563613787d4b"}}, {start: {_id:2391}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: uSAO5p0GIU8 (URL: https://www.youtube.com/watch?v=uSAO5p0GIU8)<SEP>YouTube Video: 6j6EGVpQkI8 (URL: https://www.youtube.com/watch?v=6j6EGVpQkI8)", truncate:"", keywords:"elimination,liberation,transcendence,understanding", weight:2.0, description:"Provides understanding of suffering and the path to liberation.<SEP>Enlightenment eliminates suffering by removing all roots or tendencies that cause it, leading to a suffering-free state.", created_at:1779520523, source_id:"chunk-1d721d9fcd5e561bfe9353bb3e49e8a1<SEP>chunk-e56919e461f379123fc8b4b2380a2a52"}}, {start: {_id:2399}, end: {name:"Consciousness"}, properties:{file_path:"YouTube Video: E-LCT0YEpWQ (URL: https://www.youtube.com/watch?v=E-LCT0YEpWQ)", truncate:"", keywords:"associated with,enlightened state", weight:1.0, description:"Consciousness is described as being bliss in the enlightened state of Ananda.", created_at:1779511969, source_id:"chunk-e7a44718d07524dc9d25d8465c12f664"}}, {start: {_id:5423}, end: {name:"Oneness"}, properties:{file_path:"unknown_source<SEP>YouTube Video: R0bGNxoJ4sM (URL: https://www.youtube.com/watch?v=R0bGNxoJ4sM)", keywords:"connection,interconnectedness,spiritual state,unity", truncate:"", weight:2.0, description:"Ananda is associated with Oneness, experiencing unity in every odd place.<SEP>Ananda involves experiencing Oneness in every odd place through sensory details and cellular awareness.", created_at:1779512136, source_id:"chunk-16505689511452878f9de53f0eb16c6e<SEP>chunk-b898618f68efd08df9f5924199c43f87"}}, {start: {_id:5429}, end: {name:"Oneness"}, properties:{file_path:"unknown_source", keywords:"contextual reference", truncate:"", weight:1.0, description:"Oneness is mentioned in the context of Early Neodo Harnam.", created_at:1779512095, source_id:"chunk-16505689511452878f9de53f0eb16c6e"}}, {start: {_id:5511}, end: {name:"Suffering"}, properties:{file_path:"YouTube Video: YguId6pF5KI (URL: https://www.youtube.com/watch?v=YguId6pF5KI)", truncate:"", keywords:"alleviation,freedom,teaching purpose", weight:2.0, description:"The Pre-30 teaching aims to free individuals from suffering.<SEP>The Pre-30 teaching aims to alleviate suffering.", created_at:1779518309, source_id:"chunk-f66651ee848911049e03ee6f58135f0a"}}, {start: {_id:1336}, end: {name:"Suffering"}, properties:{file_path:"unknown_source<SEP>YouTube Video: XFFgRTgP8Rs (URL: https://www.youtube.com/watch?v=XFFgRTgP8Rs)", keywords:"cause,origin", truncate:"", weight:2.0, description:"Suffering arises from the conflict between self-image and perceived failures, as self-image dictates emotional reactions to setbacks.<SEP>Suffering originates from conflicts or threats to self-image, such as unmet expectations.", created_at:1779519365, source_id:"chunk-6202900249469971e378d57b74b99662<SEP>chunk-87e2f7787298d3205ec139c556ef83c0"}}, {start: {_id:123}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", truncate:"", keywords:"generational transmission,inherent state", weight:1.0, description:"Humanity collectively experiences suffering due to inherited patterns in the human collective consciousness.", created_at:1779519700, source_id:"chunk-86b06c28798f4c4a7bd03b34bd895d71"}}, {start: {_id:3704}, end: {name:"Suffering"}, properties:{file_path:"unknown_source", truncate:"", keywords:"cyclical reinforcement,psychological legacy", weight:1.0, description:"Suffering perpetuates through generations via the transmission of collective emotional and mental states.", created_at:1779519701, source_id:"chunk-86b06c28798f4c4a7bd03b34bd895d71"}}, {start: {_id:3274}, end: {name:"Suffering"}, properties:{file_path:"unknown_source<SEP>YouTube Video: LapJqYf9hzI (URL: https://www.youtube.com/watch?v=LapJqYf9hzI)", truncate:"", keywords:"generational impact,legacy,legacy transmission,transmission", weight:2.0, description:"Ancestors' legacies perpetuate suffering through the collective consciousness.<SEP>Ancestors' suffering is transmitted through generations, contributing to current collective suffering.", created_at:1779519777, source_id:"chunk-86b06c28798f4c4a7bd03b34bd895d71<SEP>chunk-b4ef0432d09dd625d180cc94f3e0ef2e"}}, {start: {_id:5613}, end: {name:"Consciousness"}, properties:{file_path:"unknown_source", keywords:"impact,transformation", truncate:"", weight:1.0, description:"Awakening to love fundamentally transforms consciousness and human experience.", created_at:1779519835, source_id:"chunk-30e3bfda839778033ca7e4ddfabb670b"}}, {start: {_id:5710}, end: {name:"Oneness"}, properties:{file_path:"unknown_source<SEP>YouTube Video: MJYpyUlwxg0 (URL: https://www.youtube.com/watch?v=MJYpyUlwxg0)", keywords:"cosmic representation,embodiment,represents,unified source", truncate:"", weight:2.0, description:"Mahadeva embodies the unified source of the diversified universe, manifesting the principle of oneness through his existence and dance.<SEP>Mahadeva represents the oneness of birth, continuity, and death, serving as the unified source of the diversified universe.", created_at:1779521247, source_id:"chunk-a4ec9b97a69f62614437c5e1621469d7<SEP>chunk-2440e826e4f3cf50974cdd2445cd5354"}}] AS row
