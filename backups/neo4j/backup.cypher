UNWIND [{start: {_id:348}, end: {_id:3067}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jW3JDLY0cDA)", truncate:"", keywords:"reference,source", weight:1.0, description:"The video is sourced from the provided YouTube URL, serving as its digital host.", created_at:1779227517, source_id:"chunk-f78b0e4aa7017a9c67d7f42fb709f53c"}}, {start: {_id:3176}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jW3JDLY0cDA)<SEP>YouTube Video: LYm7oczfWEk (URL: https://www.youtube.com/watch?v=LYm7oczfWEk)", truncate:"", keywords:"content hosting,textual analysis,textual representation", weight:2.0, description:"The YouTube video hosts the transcript as its textual content.<SEP>The video contains the transcript which is analyzed for stylistic and readability issues.", created_at:1779439235, source_id:"chunk-d0497b4532233dee8d4d35231ced73d4<SEP>chunk-1c57270923c0b9f6969285d11c29b4d9"}}, {start: {_id:2273}, end: {_id:3176}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jW3JDLY0cDA)", truncate:"", keywords:"content inclusion,thematic focus", weight:1.0, description:"The transcript contains the motivational message as its primary content.", created_at:1779227564, source_id:"chunk-d0497b4532233dee8d4d35231ced73d4"}}, {start: {_id:3069}, end: {_id:3176}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jW3JDLY0cDA)", truncate:"", keywords:"revision process,textual refinement", weight:1.0, description:"The edits were applied to the transcript during multiple correction passes.", created_at:1779227564, source_id:"chunk-d0497b4532233dee8d4d35231ced73d4"}}, {start: {_id:3073}, end: {_id:2273}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jW3JDLY0cDA)", truncate:"", keywords:"emotional tone,thematic emphasis", weight:1.0, description:"The message emphasizes encouragement and hope for those feeling low.", created_at:1779227564, source_id:"chunk-d0497b4532233dee8d4d35231ced73d4"}}, {start: {_id:3069}, end: {_id:2097}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jW3JDLY0cDA)", truncate:"", keywords:"accuracy,linguistic correction", weight:1.0, description:"Edits addressed homophones and misheard words (e.g., \"to you is\" correction).", created_at:1779227565, source_id:"chunk-d0497b4532233dee8d4d35231ced73d4"}}, {start: {_id:3074}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jW3JDLY0cDA)", truncate:"", keywords:"narrative focus,thematic content", weight:1.0, description:"The video's transcript addresses themes of financial struggles through its narrative.", created_at:1779227612, source_id:"chunk-8b28e95f654546fbfe92679721749ead"}}, {start: {_id:3077}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jW3JDLY0cDA)", truncate:"", keywords:"narrative focus,thematic content", weight:1.0, description:"The video discusses overcoming personal challenges as part of its message.", created_at:1779227612, source_id:"chunk-8b28e95f654546fbfe92679721749ead"}}, {start: {_id:550}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jW3JDLY0cDA)", truncate:"", keywords:"emotional resonance,thematic content", weight:1.0, description:"The video explores emotional states like desperation and hope through its content.", created_at:1779227613, source_id:"chunk-8b28e95f654546fbfe92679721749ead"}}, {start: {_id:3143}, end: {_id:3144}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jW3JDLY0cDA)", truncate:"", keywords:"`,then `,then the keywords", weight:1.0, description:"`, then the description. This also matches.", created_at:1779227720, source_id:"chunk-88b7d624b4e849716b3032203238716d"}}, {start: {_id:1791}, end: {_id:2409}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jW3JDLY0cDA)", truncate:"", keywords:"method and result", weight:1.0, description:"Corrections were applied to generate the corrected text.", created_at:1779227818, source_id:"chunk-69a4ec67bd6a54f9121bf1b7c9d15b69"}}, {start: {_id:1791}, end: {_id:1881}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jW3JDLY0cDA)", keywords:"absence and content", truncate:"", weight:1.0, description:"Domain-specific terms were noted as absent in the corrected text.", created_at:1779227819, source_id:"chunk-69a4ec67bd6a54f9121bf1b7c9d15b69"}}, {start: {_id:3148}, end: {_id:1791}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jW3JDLY0cDA)", truncate:"", keywords:"clarity,grammar", weight:1.0, description:"Commas were added to improve readability and correct punctuation in the text.", created_at:1779227819, source_id:"chunk-69a4ec67bd6a54f9121bf1b7c9d15b69"}}, {start: {_id:3152}, end: {_id:1500}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=w1U9nHF3H5o)", keywords:"analogy,application,life guidance,trajectory alignment", truncate:"", weight:2.0, description:"The Limitless Field is likened to a course correction for consciousness, realigning individuals toward achievements.<SEP>The Limitless Field provides a \"course correction\" to align one's life path with success.", created_at:1779228093, source_id:"chunk-9ec14937b8902b88b2d052765d91f9c8<SEP>chunk-7a5e3663de47874378de2e99b5670753"}}, {start: {_id:1500}, end: {_id:1782}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=w1U9nHF3H5o)<SEP>unknown_source", truncate:"", keywords:"collective harmony,explanation,meditation guidance,spiritual philosophy", weight:2.0, description:"The Speaker explains the concept and effects of the Limitless Field during meditation.<SEP>The speaker references the Limitless Field to symbolize the interconnectedness of all beings and the power of collective peace.", created_at:1779455328, source_id:"chunk-7a5e3663de47874378de2e99b5670753<SEP>chunk-c1d8dd3f6ee4794537974077b8f6d5c9"}}, {start: {_id:1500}, end: {_id:3156}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=w1U9nHF3H5o)", truncate:"", keywords:"molecular impact,transformation", weight:1.0, description:"The Limitless Field alters the molecular arrangement of matter, akin to a magnetic force.", created_at:1779228093, source_id:"chunk-7a5e3663de47874378de2e99b5670753"}}, {start: {_id:3155}, end: {_id:1500}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=w1U9nHF3H5o)", truncate:"", keywords:"frequency elevation,meditation", weight:1.0, description:"The Limitless Field increases consciousness frequency through intense meditation.", created_at:1779228093, source_id:"chunk-7a5e3663de47874378de2e99b5670753"}}, {start: {_id:1500}, end: {_id:3154}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=w1U9nHF3H5o)", truncate:"", keywords:"life outcomes,universal attraction", weight:1.0, description:"Engaging with the Limitless Field draws positive outcomes into one's life.", created_at:1779228093, source_id:"chunk-7a5e3663de47874378de2e99b5670753"}}, {start: {_id:1500}, end: {_id:3153}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=w1U9nHF3H5o)", truncate:"", keywords:"dissolution,mental cleansing", weight:1.0, description:"The Limitless Field dissolves negative thoughts and beliefs to remove life obstacles.", created_at:1779228093, source_id:"chunk-7a5e3663de47874378de2e99b5670753"}}, {start: {_id:3198}, end: {_id:3193}, properties:{file_path:"unknown_source", keywords:"authority,influence", truncate:"", weight:1.0, description:"The community of Ekam mitras is depicted as holding influence or authority over the Ekam circles.", created_at:1779228590, source_id: