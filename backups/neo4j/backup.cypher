UNWIND [{_id:3878, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Peace meditation is a concept mentioned in the text analysis.", created_at:1779242999, source_id:"chunk-50f259044416b29784cc45b625bee372", entity_id:"Peace meditation"}}, {_id:3879, properties:{file_path:"unknown_source", entity_type:"product", truncate:"", description:"Gold futures is a product mentioned in the text analysis.", created_at:1779242999, source_id:"chunk-50f259044416b29784cc45b625bee372", entity_id:"Gold futures"}}, {_id:3880, properties:{file_path:"unknown_source", entity_type:"product", truncate:"", description:"Crude oil is a product mentioned in the text analysis.", created_at:1779242999, source_id:"chunk-50f259044416b29784cc45b625bee372", entity_id:"Crude oil"}}, {_id:3882, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=JRlaAip4kmk)<SEP>unknown_source<SEP>YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", entity_type:"concept", truncate:"", description:"A technique involving inhaling and exhaling focused on the heart, used in the meditation to facilitate peace.<SEP>Breathing is a biological act framed as a movement of existence, devoid of inherent meaning but essential to life.<SEP>Breathing is framed as a biological process tied to existence, with its meaning debated in the context of human experience.<SEP>Breathing is analyzed as a biological act devoid of intrinsic meaning.<SEP>Breathing is a physiological process framed as a movement of pure existence in the text.<SEP>A biological process interrogated for its intrinsic meaning within existential frameworks.", created_at:1779402795, source_id:"chunk-7e21cbebb168cec17df5a464a689a4f9<SEP>chunk-ef821e71b2fbcaa55b79671c314f5fac<SEP>chunk-075b8e71a3c71d11c785be4bbfe965ed<SEP>chunk-cd11c060af63780157ebf40717dc0fe2<SEP>chunk-8ac203494cdcc9d8041ac912b2411f28<SEP>chunk-e94d81180e7457d6f36d99965cfbf34d<SEP>chunk-89ddb9ac19fba38ddebc97bcf3b40b3b<SEP>chunk-25679c68ddef27fd2e2fa60d50bdcb05", entity_id:"Breathing"}}, {_id:3883, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=JRlaAip4kmk)", entity_type:"concept", truncate:"", description:"The act of forgiving oneself for past grievances, central to the video's message of achieving peace.", created_at:1779243159, source_id:"chunk-999192b96103e7c498639cfadd062722<SEP>chunk-ef821e71b2fbcaa55b79671c314f5fac", entity_id:"Self-Forgiveness"}}, {_id:3884, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=JRlaAip4kmk)", entity_type:"concept", truncate:"", description:"Concept represented by the repeated phrase \"The best\" in the YouTube Video.", created_at:1779243210, source_id:"chunk-e5c2ff89d512e2359c660a031e299399", entity_id:"The Best"}}, {_id:3885, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Lokas denote different realms or worlds in Hindu cosmology.<SEP>Realms or dimensions mentioned in the text, which are pervaded by spirits.<SEP>Lokas represent different planes of existence or worlds in Hindu cosmology.", created_at:1779666216, source_id:"chunk-e866ae584a17f66fb50b03a4539236de<SEP>chunk-2e434306df5b4f2083250fff41e8b701<SEP>chunk-ef84739ec9f14b6d1ebaee11b611e3e8", entity_id:"Lokas"}}, {_id:3886, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=qtG8c2zhn7A)", entity_type:"concept", truncate:"", created_at:1779666216, description:"Devas refer to divine beings or gods in Hindu mythology.<SEP>Celestial beings mentioned in the text, who are part of the cosmic order.<SEP>Devas are divine beings considered part of the indivisible consciousness in the Brahma Sutra teachings.<SEP>Devas refer to divine beings or gods in Hindu cosmology.", source_id:"chunk-e866ae584a17f66fb50b03a4539236de<SEP>chunk-2e434306df5b4f2083250fff41e8b701<SEP>chunk-bfaa19ebdb9bfd6b1d14f908f21f4e5c<SEP>chunk-ef84739ec9f14b6d1ebaee11b611e3e8", entity_id:"Devas"}}, {_id:3887, properties:{file_path:"unknown_source<SEP>YouTube Video: 6-GWHR9_iSU (URL: https://www.youtube.com/watch?v=6-GWHR9_iSU)", entity_type:"concept", truncate:"", description:"The Brahma Sutras are a collection of teachings compiled by sage Vyasa.<SEP>A text that describes the nature of Brahman and all that exists as the one indivisible field of consciousness.<SEP>The Brahma Sutras are brief descriptions of profound, enlightened states of consciousness of sages.<SEP>Brahma Sutras are brief descriptions of profound, enlightened states of consciousness of sages.<SEP>The Brahma Sutras are brief descriptions of profound, enlightened states of consciousness of sages.", created_at:1779666246, source_id:"chunk-e866ae584a17f66fb50b03a4539236de<SEP>chunk-6c96fcf9dc4b3dd6ae02c9c745b85e2a<SEP>chunk-e0651d1d759d9ec9887e923e28bd51f5<SEP>chunk-ef84739ec9f14b6d1ebaee11b611e3e8<SEP>chunk-e62e4366c052c78d46a09bec53d2a9c4<SEP>chunk-5b76959242343174ca2993b42bcf33e0", entity_id:"Brahma Sutras"}}, {_id:3888, properties:{file_path:"unknown_source<SEP>YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", entity_type:"event", truncate:"", description:"Guru Purnima is an ancient Hindu festival celebrated on the full moon day of the lunar month of Ashadha. It honors sage Vyasa and marks the completion of the Brahma?Sutras, a seminal work in Hindu philosophy. The festival is a traditional Indian celebration that serves as a day of reverence for Vyasa, who is credited with compiling the Brahma?Sutras. It is also observed as a day for seekers of enlightenment, celebrating the potential of human consciousness for enlightenment and liberation. The celebration emphasizes the importance of the sage's contributions and the spiritual significance of the full moon day in the lunar calendar.

The festival also serves as a celebration of enlightenment and the potential of human consciousness, a theme emphasized in Indian tradition. It is observed as a traditional day of celebration for seekers of enlightenment in India, specifically commemorating the completion of the Brahma?Sutras by sage Vyasa. Additionally, the day is regarded as a celebration of the potential of human consciousness for enlightenment and liberation, highlighting the spiritual significance of the sage's contributions.<SEP>Guru Purnima is a traditional day of celebration for seekers of enlightenment in India, commemorating the completion of the Brahma-Sutras by sage Vyasa.", created_at:1779665909, source_id:"chunk-e866ae584a17f66fb50b03a4539236de<SEP>chunk-6c96fcf9dc4b3dd6ae02c9c745b85e2a<SEP>chunk-2e434306df5b4f2083250fff41e8b701<SEP>chunk-c00a8eefe100525e46599a752324e087<SEP>chunk-312a7e6dcdab5fa1268941f1387c1ed0<SEP>chunk-8f1a363d87bc0be2ccf5c1de79b00140<SEP>chunk-ed14675eaeee5b36e94642ad031a9dc4<SEP>chunk-85df277d52184fe481533e8c7c5ed363", entity_id:"Guru Purnima"}}, {_id:3889, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=qtG8c2zhn7A)", entity_type:"person", truncate:"", description:"Sage Vyasa is a person associated with the compilation of the Brahma Sutras.<SEP>A sage who gathered the enlightenment experiences of numerous sages and compiled them into 134 Brahma Sutras.<SEP>Sage Vyasa is a revered figure who compiled the Brahma Sutras from the experiences of enlightened sages.", created_at:1779244004, source_id:"chunk-e866ae584a17f66fb50b03a4539236de<SEP>chunk-6c96fcf9dc4b3dd6ae02c9c745b85e2a<SEP>chunk-bfaa19ebdb9bfd6b1d14f908f21f4e5c", entity_id:"Sage Vyasa"}}, {_id:3891, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Sarvam Kalvidam Brahma is a key phrase representing the essence of the Brahma Sutras.<SEP>Sarvam Kalvidam Brahma is a text describing the oneness of all existence.", created_at:1779243808, source_id:"chunk-6c96fcf9dc4b3dd6ae02c9c745b85e2a<SEP>chunk-2e434306df5b4f2083250fff41e8b701", entity_id:"Sarvam Kalvidam Brahma"}}, {_id:3892, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=qtG8c2zhn7A)", entity_type:"concept", truncate:"", description:"Brahma Sutra is an ancient Hindu scripture attributed to Vyasa, describing spiritual and philosophical concepts.<SEP>The Brahma Sutra is a central philosophical concept representing the unity of all consciousness and the essence of humanity.", created_at:1779244004, source_id:"chunk-2e434306df5b4f2083250fff41e8b701<SEP>chunk-bfaa19ebdb9bfd6b1d14f908f21f4e5c<SEP>chunk-ef84739ec9f14b6d1ebaee11b611e3e8", entity_id:"Brahma Sutra"}}, {_id:3893, properties:{file_path:"unknown_source", entity_type:"organization", truncate:"", description:"Vedic Tradition encompasses spiritual and philosophical teachings from ancient India.", created_at:1779243808, source_id:"chunk-2e434306df5b4f2083250fff41e8b701", entity_id:"Vedic Tradition"}}, {_id:3894, properties:{file_path:"unknown_source<SEP>YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", entity_type:"person", truncate:"", description:"Vyasa is a revered sage and author of the Brahma Sutra and other Vedic texts.<SEP>Vyasa is a great sage in India known for compiling the Brahmasutras.<SEP>Vyasa is a great sage in India known for compiling the Brahmasutras.<SEP>Vyasa is a sage who compiled the Brahma-Sutras.<SEP>Vyasa is a revered sage in Indian tradition who compiled the Brahma-Sutras by collecting verses from enlightened sages and prevalent opinions of his time.<SEP>Vyasa was a great sage in India who compiled the Brahma-Sutras and completed their compilation on Guru Purnima.<SEP>Vyasa is a sage who compiled the Brahma-Sutras by collecting verses from enlightened sages and their experiences of consciousness.", created_at:1779665932, source_id:"chunk-2e434306df5b4f2083250fff41e8b701<SEP>chunk-c00a8eefe100525e46599a752324e087<SEP>chunk-0f41e4f1e81b951f715718bd721d4f9b<SEP>chunk-8f1a363d87bc0be2ccf5c1de79b00140<SEP>chunk-85df277d52184fe481533e8c7c5ed363<SEP>chunk-25679c68ddef27fd2e2fa60d50bdcb05", entity_id:"Vyasa"}}, {_id:3896, properties:{file_path:"unknown_source<SEP>YouTube Video: 4Fjf6IQsjQs (URL: https://www.youtube.com/watch?v=4Fjf6IQsjQs)", entity_type:"naturalobject", truncate:"", created_at:1779511874, description:"Galaxies are vast systems of stars, gas, and dust in the universe.<SEP>Galaxies are mentioned as manifestations of intelligence in the universe's cosmic structures.<SEP>Galaxies are presented as manifestations of intelligence within the universe, part of its intelligent structure.", source_id:"chunk-2e434306df5b4f2083250fff41e8b701<SEP>chunk-3a9b1e90fab2bdbcbb151bc873bcb657<SEP>chunk-55cc26bf031f0db4fced411b5d43e45c", entity_id:"Galaxies"}}, {_id:3898, properties:{file_path:"unknown_source<SEP>YouTube Video: pTnZt0SqDFM (URL: https://www.youtube.com/watch?v=pTnZt0SqDFM)<SEP>YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", entity_type:"naturalobject", truncate:"", description:"Bacteria are single-celled microorganisms found in diverse environments.<SEP>Bacteria is metaphorically referenced as part of the diseased state of the planet, linked to suffering and separation.<SEP>Bacteria are living organisms that can invade the body and trigger an immune response.<SEP>Bacteria are living organisms that can invade the body and trigger an immune response.<SEP>Bacteria are emerging and spreading due to environmental degradation, posing threats to global health.", created_at:1779663974, source_id:"chunk-2e434306df5b4f2083250fff41e8b701<SEP>chunk-1a7e64bb8a0d59d10204b5dfcccfe785<SEP>chunk-3da16f4292642f8022ca187ac2cb1ede<SEP>chunk-014f762e43b25d198c755c424f29f67a", entity_id:"Bacteria"}}, {_id:3901, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=qtG8c2zhn7A)", entity_type:"concept", truncate:"", description:"Spirits are non-physical entities in various belief systems.<SEP>Spirits pervading other Lokas are acknowledged as part of the unified consciousness in the Brahma Sutra.", created_at:1779244004, source_id:"chunk-2e434306df5b4f2083250fff41e8b701<SEP>chunk-bfaa19ebdb9bfd6b1d14f908f21f4e5c<SEP>chunk-e62e4366c052c78d46a09bec53d2a9c4", entity_id:"Spirits"}}, {_id:3902, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Communities characterized by peace and absence of conflict, resulting from nurtured inner states.", created_at:1779244221, source_id:"chunk-cdbfc6e200f4cd4487961cefed0a0954", entity_id:"Harmonious Communities"}}, {_id:3903, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", created_at:1779672357, description:"The pursuit of goals and success, often linked to happiness in the culture's belief system.<SEP>Successfully completing Day Three by maintaining focus on breath pauses despite distractions.<SEP>Achievement is paradoxically linked to increased pressure, as success amplifies expectations and stress.`<SEP>Extraordinary accomplishments in the external world resulting from family togetherness.", source_id:"chunk-cdbfc6e200f4cd4487961cefed0a0954<SEP>chunk-edcb79b79435bcba9facfbb3e2e5ae09<SEP>chunk-58a607380e83d993d819574f258cb8d8<SEP>chunk-360f7674da2e91f036d52739a28095ed<SEP>chunk-ae2f2a9e144a0416a2b1367a6eab9be2<SEP>chunk-0ec81fd92a8028a31f8c6ce341a46fe9", entity_id:"Achievement"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:3904, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The feeling of constant craving for attention or importance, part of the inner state.<SEP>A feeling of insufficiency, which hinders one's ability to think about the world.", created_at:1779392875, source_id:"chunk-cdbfc6e200f4cd4487961cefed0a0954<SEP>chunk-3e00aec0d824214dc3b1bf504e305af0", entity_id:"Sense of Lack"}}, {_id:3905, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The intense desire for external validation or importance, conflicting with inner joy.", created_at:1779244222, source_id:"chunk-cdbfc6e200f4cd4487961cefed0a0954", entity_id:"Craving"}}, {_id:3906, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Gt3o8lcbcII)", entity_type:"concept", truncate:"", description:"The belief that attaining goals or achievements leads to happiness, taught as a foundational principle within the culture.", created_at:1779244331, source_id:"chunk-4523f9fd37288caff920e368b2232bf0", entity_id:"Achievement-Driven Happiness Belief"}}, {_id:3907, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Gt3o8lcbcII)", entity_type:"concept", truncate:"", description:"The emotional state resulting from the relentless pursuit of achievement, characterized by sadness and suffering during the process.", created_at:1779244331, source_id:"chunk-4523f9fd37288caff920e368b2232bf0", entity_id:"Ingrained Sadness and Suffering"}}, {_id:3908, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Gt3o8lcbcII)", entity_type:"concept", truncate:"", description:"The cultural practice of intense effort and hard work toward goals, perceived as a necessary process for eventual happiness.", created_at:1779244331, source_id:"chunk-4523f9fd37288caff920e368b2232bf0", entity_id:"Striving for Achievement"}}, {_id:3909, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Gt3o8lcbcII)", entity_type:"concept", truncate:"", description:"A culture or civilization that prioritizes belief in achievement as a path to happiness, with ingrained perceptions of sadness and suffering in the pursuit of goals.", created_at:1779244331, source_id:"chunk-4523f9fd37288caff920e368b2232bf0", entity_id:"Believing Culture"}}, {_id:3910, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=cI7D2aO34yw)", entity_type:"person", truncate:"", description:"Christ is a religious figure associated<SEP>Christ is a religious figure associated with periods of isolation and reflection.", created_at:1779245471, source_id:"chunk-550e13cc834f4b3fe1d51617d1c42fa2<SEP>chunk-89ad31026dfac5cb5747676ec6d57a32", entity_id:"Christ"}}, {_id:3912, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=cI7D2aO34yw)", entity_type:"person", truncate:"", description:"Bill Gates is a technology giant known for moving away from everyday activities.<SEP>Bill Gates is a technology innovator who isolated himself for creative breakthroughs.", created_at:1779245471, source_id:"chunk-550e13cc834f4b3fe1d51617d1c42fa2<SEP>chunk-89ad31026dfac5cb5747676ec6d57a32", entity_id:"Bill Gates"}}, {_id:3913, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Seclusion and solitude are states of isolation and loneliness, often associated with introspection and self-reflection.", created_at:1779245226, source_id:"chunk-f925857f8965034d2828680e1a46c470", entity_id:"Seclusion And Solitude"}}, {_id:3914, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Reinventing oneself refers to the process of self-discovery and personal transformation during periods of seclusion and solitude.", created_at:1779245226, source_id:"chunk-f925857f8965034d2828680e1a46c470", entity_id:"Reinvent Yourself"}}, {_id:3917, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Bill Gates moved away from everyday activities.", created_at:1779245311, source_id:"chunk-550e13cc834f4b3fe1d51617d1c42fa2", entity_id:"Technology Giants"}}, {_id:3918, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"The period of seclusion is a time for creativity.", created_at:1779245311, source_id:"chunk-550e13cc834f4b3fe1d51617d1c42fa2", entity_id:"Period of Seclusion"}}, {_id:3919, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=cI7D2aO34yw)", entity_type:"person", truncate:"", description:"Nitu is a person from Bangalore expressing frustration and mental distress during seclusion.", created_at:1779245470, source_id:"chunk-89ad31026dfac5cb5747676ec6d57a32", entity_id:"Nitu"}}, {_id:3920, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=cI7D2aO34yw)", entity_type:"concept", truncate:"", description:"Mental sickness is a psychological state experienced during prolonged seclusion.", created_at:1779245470, source_id:"chunk-89ad31026dfac5cb5747676ec6d57a32", entity_id:"Mental Sickness"}}, {_id:3921, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=cI7D2aO34yw)<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=XMzZe5aEmTo)", entity_type:"concept", truncate:"", created_at:1779675549, description:"Punishment is a perception of seclusion as a form of retribution.<SEP>Punishment results from obsessive attitudes, ignoring situational changes.<SEP>Punishment is a form of violence that does not transform the target but instead increases their hate.", source_id:"chunk-89ad31026dfac5cb5747676ec6d57a32<SEP>chunk-3f2351d7bbf12ee7e6a879305b4fddf7<SEP>chunk-811d40ad37d225c3aaeb783ea8c4d627", entity_id:"Punishment"}}, {_id:3922, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=cI