UNWIND [{start: {_id:4473}, end: {_id:1620}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"correction focus,domain-specific terms", weight:1.0, description:"The Text Correction Expert must correct references to Ono in the text.", created_at:1779395771, source_id:"chunk-30f8eb963440e45a21a8e3124afd7bdf"}}, {start: {_id:4485}, end: {_id:4486}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"data reporting,statistic", truncate:"", weight:1.0, description:"The Guardian reported the statistic about workers at risk of losing livelihoods.", created_at:1779395800, source_id:"chunk-fdd335641b05120f25a544e040a0e521"}}, {start: {_id:4488}, end: {_id:4482}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"integration,necessity", truncate:"", weight:1.0, description:"Spirituality is argued as essential for business leaders and systems.", created_at:1779395800, source_id:"chunk-fdd335641b05120f25a544e040a0e521"}}, {start: {_id:4484}, end: {_id:4494}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"language correction,typo fix", weight:1.0, description:"Correction of grammatical error from \"created you\" to \"created in you\".", created_at:1779395800, source_id:"chunk-fdd335641b05120f25a544e040a0e521"}}, {start: {_id:4487}, end: {_id:4482}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"integration,necessity", truncate:"", weight:1.0, description:"Spirituality must be integrated with politics for systemic change.", created_at:1779395801, source_id:"chunk-fdd335641b05120f25a544e040a0e521"}}, {start: {_id:4489}, end: {_id:4482}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"integration,necessity", truncate:"", weight:1.0, description:"Spirituality should be integrated with education for holistic development.", created_at:1779395801, source_id:"chunk-fdd335641b05120f25a544e040a0e521"}}, {start: {_id:4490}, end: {_id:4482}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"harm reduction,necessity,rebuilding,systemic change", weight:2.0, description:"Rebuilding the economy requires spiritual integration to avoid harmful systems.<SEP>Spirituality is necessary to prevent the economy from becoming \"cancerous\" and to rebuild it sustainably.", created_at:1779395801, source_id:"chunk-fdd335641b05120f25a544e040a0e521"}}, {start: {_id:3927}, end: {_id:4497}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"decision-making,leadership dynamics", weight:1.0, description:"Business leaders employ strategic action to achieve success through calculated business maneuvers.", created_at:1779395822, source_id:"chunk-8542a80600889bb6e804d31658e4ffdd"}}, {start: {_id:44}, end: {_id:2390}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"integration,interdisciplinary connection", weight:1.0, description:"Spirituality is proposed to be integrated with business to foster holistic transformation in professional and societal realms.", created_at:1779395822, source_id:"chunk-8542a80600889bb6e804d31658e4ffdd"}}, {start: {_id:3927}, end: {_id:4495}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"cognitive application,problem-solving", weight:1.0, description:"Leaders leverage intelligence in action to make clever investments and optimize outcomes.", created_at:1779395822, source_id:"chunk-8542a80600889bb6e804d31658e4ffdd"}}, {start: {_id:3927}, end: {_id:4496}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"impact,visibility", weight:1.0, description:"The world prioritizes the power of action as it directly reflects the tangible results of leadership decisions.", created_at:1779395822, source_id:"chunk-8542a80600889bb6e804d31658e4ffdd"}}, {start: {_id:4498}, end: {_id:2390}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"integration,interdisciplinary connection", weight:1.0, description:"Spirituality is suggested to merge with politics to guide ethical governance and decision-making frameworks.", created_at:1779395822, source_id:"chunk-8542a80600889bb6e804d31658e4ffdd"}}, {start: {_id:4499}, end: {_id:2390}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)<SEP>YouTube Video: KTlY-lHs_Ew (URL: https://www.youtube.com/watch?v=KTlY-lHs_Ew)", truncate:"", keywords:"analogy,education,enjoyment,integration,interdisciplinary connection,stage comparison", weight:3.0, created_at:1779398287, description:"Spirituality is advocated to be combined with education to cultivate introspective and purpose-driven learning environments.<SEP>Spirituality stages are explained through an analogy with educational levels (e.g., grades, undergraduate studies, PhD).<SEP>Spirituality involves enjoying educational pursuits as part of harmonious living.", source_id:"chunk-8542a80600889bb6e804d31658e4ffdd<SEP>chunk-1fbe8b29b004fd2a51bfaf808ad4a188<SEP>chunk-6a5c1cd3abe977e04aa0398546d911a7"}}, {start: {_id:1395}, end: {_id:4496}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"mastery,strategic balance", truncate:"", weight:1.0, description:"Leaders achieve total power of action by balancing fearless engagement with peaceful inaction, transcending habitual reactions.", created_at:1779395867, source_id:"chunk-ba586743a140b7df40d5cacb7f238ed9"}}, {start: {_id:2480}, end: {_id:4501}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"behavioral influence,neurological processing", weight:1.0, description:"The limbic system channels unconscious tendencies into observable actions and decision-making patterns.", created_at:1779395867, source_id:"chunk-ba586743a140b7df40d5cacb7f238ed9"}}, {start: {_id:4507}, end: {_id:4504}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"emotional detachment,mental clarity", weight:1.0, description:"Power of decision emerges when free from muddled thinking and unresolved emotional layers.", created_at:1779395867, source_id:"chunk-ba586743a140b7df40d5cacb7f238ed9"}}, {start: {_id:4502}, end: {_id:4506}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"attitude vs. depth", truncate:"", weight:1.0, description:"Positive thinking is critiqued as superficial, insufficient to address deeper unconscious influences on cognition.", created_at:1779395867, source_id:"chunk-ba586743a140b7df40d5cacb7f238ed9"}}, {start: {_id:4503}, end: {_id:4501}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"karmic influence,psychological legacy", weight:1.0, description:"Previous lives contribute to unconscious tendencies affecting present behavior and cognition.", created_at:1779395867, source_id:"chunk-ba586743a140b7df40d5cacb7f238ed9"}}, {start: {_id:4500}, end: {_id:2364}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"cognitive distortion,emotional contamination", weight:1.0, description:"Undissolved emotional memories render thoughts anxiety-ridden despite positive attitudes.", created_at:1779395867, source_id:"chunk-ba586743a140b7df40d5cacb7f238ed9"}}, {start: {_id:4500}, end: {_id:4501}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"influence,subconscious impact", weight:1.0, description:"Emotional memories from past experiences contribute to unconscious tendencies that affect behavior and cognition.", created_at:1779395868, source_id:"chunk-ba586743a140b7df40d5cacb7f238ed9"}}] AS row
