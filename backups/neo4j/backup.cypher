UNWIND [{start: {_id:2361}, end: {_id:62}, properties:{file_path:"unknown_source", keywords:"collaboration,hosting", truncate:"", weight:1.0, description:"Marie Forleo hosts Preethaji on MarieTV to explore consciousness and inner peace.", created_at:1779173268, source_id:"chunk-3d84d66881e27df882507ec43ab5fd29"}}, {start: {_id:284}, end: {_id:2366}, properties:{file_path:"unknown_source", keywords:"intelligence,well-being", truncate:"", weight:1.0, description:"Spiritual action emerges from connection, prioritizing collective well-being.", created_at:1779173269, source_id:"chunk-0b93a19f07fdaada8a87bb7bfa37fae9"}}, {start: {_id:2355}, end: {_id:2361}, properties:{file_path:"unknown_source", keywords:"authorship,self-help", truncate:"", weight:1.0, description:"Marie Forleo authored \"Everything is Figureoutable\" to promote problem-solving and mindset shifts.", created_at:1779173269, source_id:"chunk-3d84d66881e27df882507ec43ab5fd29"}}, {start: {_id:1192}, end: {_id:1179}, properties:{file_path:"unknown_source", keywords:"idealism,self-focus", truncate:"", weight:1.0, description:"Honesty is critiqued as an ideal-driven trait rather than connection-based truth.", created_at:1779173269, source_id:"chunk-0b93a19f07fdaada8a87bb7bfa37fae9"}}, {start: {_id:2365}, end: {_id:506}, properties:{file_path:"unknown_source", keywords:"mental patterns,self-centered focus", truncate:"", weight:1.0, description:"Negative thoughts reinforce self-obsession and suffering.", created_at:1779173269, source_id:"chunk-0b93a19f07fdaada8a87bb7bfa37fae9"}}, {start: {_id:284}, end: {_id:2365}, properties:{file_path:"unknown_source", keywords:"awareness,transformation", truncate:"", weight:1.0, description:"Awareness of thoughts dissolves negativity and fosters connection.", created_at:1779173269, source_id:"chunk-0b93a19f07fdaada8a87bb7bfa37fae9"}}, {start: {_id:157}, end: {_id:2369}, properties:{file_path:"unknown_source", keywords:"universal experience", truncate:"", weight:1.0, description:"Challenges and pressure are inherent to existence across all species, distinct from suffering.`", created_at:1779173269, source_id:"chunk-bd988ca2fbb6c189e4b536ea7d78104c"}}, {start: {_id:2005}, end: {_id:2366}, properties:{file_path:"unknown_source", keywords:"clarity,intelligence", truncate:"", weight:1.0, description:"Spiritual action enables clear problem-solving through dissolved suffering.", created_at:1779173269, source_id:"chunk-0b93a19f07fdaada8a87bb7bfa37fae9"}}, {start: {_id:1184}, end: {_id:1192}, properties:{file_path:"unknown_source", keywords:"justice,paradox", truncate:"", weight:1.0, description:"Confucius's parable challenges conventional honesty through contextual fairness.", created_at:1779173269, source_id:"chunk-0b93a19f07fdaada8a87bb7bfa37fae9"}}, {start: {_id:788}, end: {_id:2371}, properties:{file_path:"unknown_source", keywords:"neurological impact", truncate:"", weight:1.0, description:"Science demonstrates suffering reduces brain size and intelligence, while connection expands them.`", created_at:1779173269, source_id:"chunk-bd988ca2fbb6c189e4b536ea7d78104c"}}, {start: {_id:2365}, end: {_id:2373}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", keywords:"emotional,negativity bias,psychological,self-perpetuation", truncate:"", weight:2.0, description:"Negative thoughts are repetitive and self-reinforcing, maintaining suffering cycles.`<SEP>Repetitive thoughts often involve negative emotions like fear or anger.", created_at:1779672444, source_id:"chunk-bd988ca2fbb6c189e4b536ea7d78104c<SEP>chunk-9174f4aac6278b492855cabdc7a615b1"}}, {start: {_id:2375}, end: {_id:2374}, properties:{file_path:"unknown_source", keywords:"evolutionary origin", truncate:"", weight:1.0, description:"Negativity bias originates from survival mechanisms now hindering Beautiful State.`", created_at:1779173269, source_id:"chunk-bd988ca2fbb6c189e4b536ea7d78104c"}}, {start: {_id:2371}, end: {_id:2364}, properties:{file_path:"unknown_source", keywords:"quantitative analysis", truncate:"", weight:1.0, description:"Science quantifies thought patterns (12,000-60,000 daily thoughts) and negativity bias.`", created_at:1779173269, source_id:"chunk-bd988ca2fbb6c189e4b536ea7d78104c"}}, {start: {_id:788}, end: {_id:1301}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=07NOYJmkkFo)", keywords:"example of,neurological correlation,part of", truncate:"", weight:2.0, description:"Intelligence levels correlate with brain size changes based on mental states.`<SEP>The brain is an example of intelligence, as are the neural structure, heart, and spine.", created_at:1779702685, source_id:"chunk-bd988ca2fbb6c189e4b536ea7d78104c<SEP>chunk-66a8a0b1aaccb5bccc35d977f8203c58"}}, {start: {_id:496}, end: {_id:2376}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hwNlLB1sze0)", keywords:"dissolution,emotional regulation,solution", truncate:"", weight:2.0, description:"Serene Mind Practice dissolves anxiety and desperation by focusing on present-moment awareness.<SEP>The Serene Mind Practice is presented as a solution to anxiety.", created_at:1779209896, source_id:"chunk-b4387a01e271d1d16068a0288faa84e5<SEP>chunk-bbc81bf6a0558d20de7cf1bfde2d1f2a"}}, {start: {_id:2377}, end: {_id:785}, properties:{file_path:"unknown_source", keywords:"access,manifestation", truncate:"", created_at:1779173270, weight:1.0, description:"The Four Stages guide individuals", source_id:"chunk-b4387a01e271d1d16068a0288faa84e5"}}, {start: {_id:1190}, end: {_id:2378}, properties:{file_path:"unknown_source", keywords:"necessity,theft", truncate:"", weight:1.0, description:"The Boy stole the Horse to feed his family, driven by necessity and hunger.", created_at:1779173270, source_id:"chunk-46f092e49beb29848499bc5cec4e1faf"}}, {start: {_id:1432}, end: {_id:2376}, properties:{file_path:"unknown_source", keywords:"retreat,spiritual practice", truncate:"", weight:1.0, description:"The Serene Mind Practice is taught during the Field of Abundance retreat to cultivate connection.", created_at:1779173270, source_id:"chunk-46f092e49beb29848499bc5cec4e1faf"}}, {start: {_id:1184}, end: {_id:2378}, properties:{file_path:"unknown_source", keywords:"judgment,moral lesson", truncate:"", weight:1.0, description:"Confucius jailed The Boy to illustrate the dangers of obsession with honesty over compassion.", created_at:1779173270, source_id:"chunk-46f092e49beb29848499bc5cec4e1faf"}}, {start: {_id:284}, end: {_id:785}, properties:{file_path:"unknown_source", keywords:"access,manifestation", truncate:"", weight:1.0, description:"A state of Connection allows access to Universal Intelligence for manifesting desires.", created_at:1779173270, source_id:"chunk-46f092e49beb29848499bc5cec4e1faf"}}] AS row
