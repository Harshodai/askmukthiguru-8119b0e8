UNWIND [{start: {_id:360}, end: {_id:759}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cause,societal pressure", truncate:"", weight:1.0, description:"Societal norms like competition and self-criticism directly cause inner conflict by creating pressure to conform.", created_at:1779139516, source_id:"chunk-53499f381af4c99f9a37a7d03455b285"}}, {start: {_id:615}, end: {_id:360}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"ineffective,root cause", truncate:"", weight:1.0, description:"External solutions fail to address the root cause (inner conflict) of unhappiness, underscoring the need for self-realignment.", created_at:1779139516, source_id:"chunk-53499f381af4c99f9a37a7d03455b285"}}, {start: {_id:759}, end: {_id:689}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cause,societal pressure", truncate:"", weight:1.0, description:"Societal norms lead to unhappiness by prioritizing conformity over genuine self-connection.", created_at:1779139516, source_id:"chunk-53499f381af4c99f9a37a7d03455b285"}}, {start: {_id:766}, end: {_id:764}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"consequences,internal conflict", truncate:"", weight:1.0, description:"Internal conflict leads to poor decisions and indecisiveness in personal and career contexts.", created_at:1779139614, source_id:"chunk-e22f7c2305a6d6df213efae54a651699"}}, {start: {_id:615}, end: {_id:767}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"avoidance,temporary relief", truncate:"", weight:1.0, description:"Seeking external solutions is a common but ineffective way to address internal conflicts.", created_at:1779139614, source_id:"chunk-e22f7c2305a6d6df213efae54a651699"}}, {start: {_id:770}, end: {_id:765}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"self-awareness,self-criticism", truncate:"", weight:1.0, description:"Dissatisfaction with self-perception negatively impacts relationships, self-image, and happiness.", created_at:1779139614, source_id:"chunk-e22f7c2305a6d6df213efae54a651699"}}, {start: {_id:110}, end: {_id:466}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"mindset,philosophy", truncate:"", weight:1.0, description:"Embracing self-acceptance leads to a perspective of life as inherently beautiful.", created_at:1779139614, source_id:"chunk-e22f7c2305a6d6df213efae54a651699"}}, {start: {_id:772}, end: {_id:762}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"acceptance,mental state", truncate:"", weight:1.0, description:"Accepting reality through serene observation fosters calmness and emotional balance.", created_at:1779139614, source_id:"chunk-e22f7c2305a6d6df213efae54a651699"}}, {start: {_id:771}, end: {_id:761}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"self-awareness,transformation", truncate:"", weight:1.0, description:"Observing self-criticism with kindness initiates personal growth and self-acceptance.", created_at:1779139614, source_id:"chunk-e22f7c2305a6d6df213efae54a651699"}}, {start: {_id:778}, end: {_id:776}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"example,illustration", truncate:"", weight:1.0, description:"King Ravana's internal conflict leads to destructive behavior, as depicted in the Ramayana.", created_at:1779139639, source_id:"chunk-afc14563513f7a4dcf36c1ff3fddd517"}}, {start: {_id:777}, end: {_id:778}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cause,consequence", truncate:"", weight:1.0, description:"Internal conflicts can result in destructive behavior despite apparent virtue.", created_at:1779139639, source_id:"chunk-afc14563513f7a4dcf36c1ff3fddd517"}}, {start: {_id:781}, end: {_id:782}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"meditation goal,self-acceptance", truncate:"", weight:1.0, description:"The Sixth Step of Meditation aims to achieve Inner Peace and Self-Acceptance through self-imagery.", created_at:1779139682, source_id:"chunk-30c84c53b6b4f178532cf06dec726c9f"}}, {start: {_id:783}, end: {_id:784}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"composition,elements", truncate:"", weight:1.0, description:"The Human Body is composed of 60 Elements of Nature, including six key elements.", created_at:1779139682, source_id:"chunk-30c84c53b6b4f178532cf06dec726c9f"}}, {start: {_id:780}, end: {_id:785}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"biological process,concept focus", truncate:"", weight:1.0, description:"The Third Sacred Secret emphasizes Universal Intelligence as the force behind the body's complexity and biological functions.", created_at:1779139682, source_id:"chunk-30c84c53b6b4f178532cf06dec726c9f"}}, {start: {_id:466}, end: {_id:782}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"meditation goal,self-acceptance", truncate:"", weight:1.0, description:"The Sixth Step of Meditation promotes Self-Acceptance by encouraging harmony with oneself and the world.", created_at:1779139682, source_id:"chunk-30c84c53b6b4f178532cf06dec726c9f"}}, {start: {_id:788}, end: {_id:785}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"biological function,intelligence", truncate:"", weight:1.0, description:"Universal Intelligence is linked to the Brain's neurons and neural connections, driving cognitive processes.", created_at:1779139682, source_id:"chunk-30c84c53b6b4f178532cf06dec726c9f"}}, {start: {_id:783}, end: {_id:789}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"composition,subset", truncate:"", weight:1.0, description:"Six Key Elements (oxygen, hydrogen, carbon, nitrogen, calcium, phosphorus) constitute 99% of the Human Body's composition.", created_at:1779139682, source_id:"chunk-30c84c53b6b4f178532cf06dec726c9f"}}, {start: {_id:786}, end: {_id:785}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"biological function,intelligence", truncate:"", weight:1.0, description:"Universal Intelligence enables the Heart's neurons to engage in feeling and decision-making.", created_at:1779139682, source_id:"chunk-30c84c53b6b4f178532cf06dec726c9f"}}, {start: {_id:787}, end: {_id:785}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"biological function,intelligence", truncate:"", weight:1.0, description:"Universal Intelligence is associated with the Gut's neurons, influencing bodily functions and decisions.", created_at:1779139682, source_id:"chunk-30c84c53b6b4f178532cf06dec726c9f"}}, {start: {_id:792}, end: {_id:785}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", truncate:"", keywords:"body systems,intelligence distribution,interconnected intelligence,unified system", weight:2.0, description:"Brain intelligence is part of a unified intelligence system encompassing universal intelligence.<SEP>Universal Intelligence encompasses brain intelligence, which is traditionally emphasized but not exclusive.`", created_at:1779184233, source_id:"chunk-7a11c33d05bfc14747b1fe7585c881fd<SEP>chunk-3bc441c03c9cd5688b0f20314b1b1b3b"}}] AS row
