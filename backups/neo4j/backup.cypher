UNWIND [{_id:1162, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Principle of non-control advocates responding to life?s flow rather than desperately trying to control it, reflecting spiritual maturity.", created_at:1779142558, source_id:"chunk-5655e9ab49fbb632676d8c50aa4d7718", entity_id:"Principle of Non-Control"}}, {_id:1163, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"person", truncate:"", created_at:1779187360, description:"A young man who participated in a course offered by the Youth Charity Foundation, experiences frustration in a city, and cannot return to his village due to conflict with his father. He works a call center job selling pickles and struggles with poverty.<SEP>A young man who experiences poverty, self-hate, and undergoes personal transformation through a foundation's program.<SEP>The young man reported his father for stealing a horse, leading to a conflict between honesty and family loyalty.<SEP>The young man is a character who stole a horse to feed his family and faces ethical dilemmas.<SEP>The young man who reported his father for stealing a horse, demonstrating honesty and adherence to Confucian principles.", source_id:"chunk-369f0db74a66636fddaa77ce9a54b9b6<SEP>chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa<SEP>chunk-05a2f5d02725dc2dcf8ad2e755a9ea94<SEP>chunk-f85d41f2377858e80129dfbf7af31bf8<SEP>chunk-fcd1a45c686f83b559e31c346f079d1e", entity_id:"Young Man"}}, {_id:1164, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"organization", truncate:"", description:"An organization offering courses that helped the young man understand spiritual right action through practices like Serene Mind.<SEP>The foundation offers transformative programs, including the course that catalyzed the young man's self-discovery.", created_at:1779187359, source_id:"chunk-369f0db74a66636fddaa77ce9a54b9b6<SEP>chunk-03367dd9ee49f7699a39e3df3605c23c", entity_id:"Youth Charity Foundation"}}, {_id:1165, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"organization", truncate:"", description:"An organization running programs for teenagers, including events and transformative courses.", created_at:1779142675, source_id:"chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa", entity_id:"Foundation"}}, {_id:1166, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"method", truncate:"", description:"A deep personal process leading to overcoming self-hate and reconnecting with family.<SEP>Process enabling individuals to awaken to deeper emotional states and connect with others' experiences.", created_at:1779187732, source_id:"chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa<SEP>chunk-b14b79dd6088b9676b5e759c61265472", entity_id:"Transformation Process"}}, {_id:1167, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"event", truncate:"", description:"A transformative program for teenagers organized by the foundation at the school.", created_at:1779142675, source_id:"chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa<SEP>chunk-04d56d56ff3befc2a05ebcfab17f9d42", entity_id:"Event"}}, {_id:1168, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=KTe11DlB4QI)", entity_type:"concept", truncate:"", description:"Sanskrit term meaning \"sight\" or \"vision,\" discussed as a component of the philosophical phrase.", created_at:1779213996, source_id:"chunk-061e2a4672fa2680d7a89f99e4d6de80", entity_id:"Drishti"}}, {_id:1169, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"organization", truncate:"", description:"Volunteers associated with the foundation who invite the young man to the event.", created_at:1779142675, source_id:"chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa", entity_id:"Volunteers"}}, {_id:1170, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"location", truncate:"", description:"A piece of agricultural land owned by a rich man where the mother works to support her family.", created_at:1779142675, source_id:"chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa", entity_id:"Rich Man's Agricultural Land"}}, {_id:1171, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"A state of negative self-perception experienced by the young man, later overcome through transformation.", created_at:1779142675, source_id:"chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa", entity_id:"Self-Hate"}}, {_id:1172, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"event", truncate:"", description:"A shared cooking experience between the young man and his mother, reigniting his passion for simple tasks.", created_at:1779142675, source_id:"chunk-84d2a4edbdbc9a3e5f2a16c04a23d9aa", entity_id:"Family Dinner"}}, {_id:1173, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Choices made after dissolving suffering states, leading to spiritual right action.", created_at:1779142721, source_id:"chunk-53db4a4895ca5dc8d4cc1183c39f2b74", entity_id:"Decisions for Life"}}, {_id:1174, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Positive outcomes that arise from processing decisions after dissolving suffering states.", created_at:1779142721, source_id:"chunk-53db4a4895ca5dc8d4cc1183c39f2b74", entity_id:"Opportunities and Prosperity"}}, {_id:1175, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"The act of giving up something for the sake of others, which can lead to bitterness and regret.", created_at:1779142721, source_id:"chunk-53db4a4895ca5dc8d4cc1183c39f2b74", entity_id:"Sacrificing"}}, {_id:1176, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"concept", truncate:"", created_at:1779531248, description:"Well-being refers to the state of physical and emotional health, emphasized as central to spiritual right action.<SEP>The state of being healthy, happy, and prosperous, both individually and collectively.", source_id:"chunk-14be37b1d86fb5b82128188406768290<SEP>chunk-03367dd9ee49f7699a39e3df3605c23c<SEP>chunk-c3b39a7ccf4908b1d880b7e4b31351a8", entity_id:"Well-Being"}}, {_id:1177, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Least damage principle guides actions in complex situations to minimize harm to all parties involved.", created_at:1779142761, source_id:"chunk-14be37b1d86fb5b82128188406768290", entity_id:"Least Damage"}}, {_id:1178, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"content", truncate:"", description:"Biographies are written accounts of others' lives, often sought for inspiration but distinct from contextual right action.", created_at:1779142761, source_id:"chunk-14be37b1d86fb5b82128188406768290", entity_id:"Biographies"}}, {_id:1179, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)<SEP>YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)<SEP>YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)<SEP>YouTube Video: 1PlGMOAypCI (URL: https://www.youtube.com/watch?v=1PlGMOAypCI)", entity_type:"concept", truncate:"", description:"Ideals are abstract beliefs that may conflict with spiritual right action when prioritized over situational awareness. They are also described as mechanical and self-focused, contrasting with actions rooted in present-moment connection. Additionally, ideals are considered inadequate for leading society toward peace, especially when disconnected from actionable truths.

Ideals represent aspirational principles of unity and equality. The universality of ideals is often contrasted with the reality of societal divisiveness.", created_at:1779655619, source_id:"chunk-14be37b1d86fb5b82128188406768290<SEP>chunk-0b93a19f07fdaada8a87bb7bfa37fae9<SEP>chunk-638abb6fbdf727a0284e50fe14e82b1f<SEP>chunk-bfec7ed2213b36e2e9d3090ab708cd73<SEP>chunk-08c5fbdcd35ed15300b9915ca1fced8a<SEP>chunk-fb20367827f31cb284dc2e32ba2e1bb0<SEP>chunk-95adc2eca3ca128f7e7b2f4a7bf1a8d6<SEP>chunk-a6affe7a665bbb46d2be844611d794d1<SEP>chunk-8b53cedbcd4de86ef1b08281380f9428<SEP>chunk-bf98c80e4c8e0ceabdc9951dcc42a4ec<SEP>chunk-12740ae94c3469761e52a81015d8effe", entity_id:"Ideals"}}, {_id:1180, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Present awareness involves mindful engagement with the current moment to inform ethical decisions.", created_at:1779142761, source_id:"chunk-14be37b1d86fb5b82128188406768290", entity_id:"Present Awareness"}}, {_id:1181, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Self-sacrifice refers to prioritizing others' well-being over one's own, often leading to resentment and disconnection when unreciprocated.", created_at:1779142761, source_id:"chunk-14be37b1d86fb5b82128188406768290", entity_id:"Self-Sacrifice"}}] AS row
