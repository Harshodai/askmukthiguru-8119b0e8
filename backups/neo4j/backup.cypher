 {_id:6184}, end: {_id:6185}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"addressing trauma,emotional support", weight:1.0, description:"'ave' provides support to help divorced or separated couples overcome past conflicts.>", created_at:1779555971, source_id:"chunk-b82baadbeec25bfa1e39c2d7d0458ebd"}}, {start: {_id:125}, end: {_id:6189}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"guidance,mentorship", truncate:"", weight:1.0, description:"Teachers guide students in cultivating mental and emotional well-being through structured activities.>", created_at:1779555971, source_id:"chunk-b82baadbeec25bfa1e39c2d7d0458ebd"}}, {start: {_id:6184}, end: {_id:6187}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"career challenges,mental health", weight:1.0, description:"'ave' addresses business people's struggles with past failures or future obsessions.>", created_at:1779555971, source_id:"chunk-b82baadbeec25bfa1e39c2d7d0458ebd"}}, {start: {_id:6184}, end: {_id:6191}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"awareness campaigns,self-acceptance", weight:1.0, description:"'ave' promotes awareness to counter denial of aging and its psychological effects.>", created_at:1779555971, source_id:"chunk-b82baadbeec25bfa1e39c2d7d0458ebd"}}, {start: {_id:6184}, end: {_id:6188}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"mindfulness,self-perception", truncate:"", weight:1.0, description:"'ave' encourages mindfulness to address denial of appearance and foster self-acceptance.>", created_at:1779555971, source_id:"chunk-b82baadbeec25bfa1e39c2d7d0458ebd"}}, {start: {_id:6184}, end: {_id:6192}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"emotional health,social media literacy", weight:1.0, description:"'ave' educates on reducing global comparison tendencies to improve mental well-being.>", created_at:1779555971, source_id:"chunk-b82baadbeec25bfa1e39c2d7d0458ebd"}}, {start: {_id:6196}, end: {_id:499}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"psychological effects,symptoms", weight:1.0, description:"These mental states manifest as consequences of chronic stress and pressure internalization.", created_at:1779555985, source_id:"chunk-2171a2444f1340eb8e26b9e8bb9ef9cc"}}, {start: {_id:6194}, end: {_id:2369}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"coping,external stimuli", truncate:"", weight:1.0, description:"Pressure originates from external circumstances that the human organism must navigate.", created_at:1779555985, source_id:"chunk-2171a2444f1340eb8e26b9e8bb9ef9cc"}}, {start: {_id:6195}, end: {_id:2369}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"caregiving demands,life challenges", weight:1.0, description:"Caring for an aging parent exemplifies external pressures impacting daily life and mental health.", created_at:1779555985, source_id:"chunk-2171a2444f1340eb8e26b9e8bb9ef9cc"}}, {start: {_id:6198}, end: {_id:499}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"coping mechanism,psychological avoidance", weight:1.0, description:"Chronic denial of aging exacerbates stress by preventing healthy adaptation to life changes.", created_at:1779555985, source_id:"chunk-2171a2444f1340eb8e26b9e8bb9ef9cc"}}, {start: {_id:603}, end: {_id:6199}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"digital interaction,social dynamics", weight:1.0, description:"The global stage amplifies stress by enabling constant comparisons with distant strangers.", created_at:1779555985, source_id:"chunk-2171a2444f1340eb8e26b9e8bb9ef9cc"}}, {start: {_id:2369}, end: {_id:6197}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"caregiving demands,life challenges", weight:1.0, description:"Caring for a sick baby creates physical and emotional pressures on caregivers.", created_at:1779555985, source_id:"chunk-2171a2444f1340eb8e26b9e8bb9ef9cc"}}, {start: {_id:6193}, end: {_id:499}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"emotional strain,self-perception conflict", weight:1.0, description:"Chronic denial of appearance intensifies stress through unrealistic self-comparisons.", created_at:1779555986, source_id:"chunk-2171a2444f1340eb8e26b9e8bb9ef9cc"}}, {start: {_id:6194}, end: {_id:499}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"biological response,internalization", weight:1.0, description:"The human organism experiences stress as a physiological and psychological response to prolonged pressure.", created_at:1779555986, source_id:"chunk-2171a2444f1340eb8e26b9e8bb9ef9cc"}}, {start: {_id:6203}, end: {_id:6200}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"chronic state,interlinked", truncate:"", weight:1.0, description:"Emotional and physical inflammation are interlinked and can coexist chronically.", created_at:1779556008, source_id:"chunk-080d730202516ec2f29ea5332581d23c"}}] AS row
