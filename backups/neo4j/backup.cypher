UNWIND [{_id:2556, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"wholeness represents a state of unity with oneness, transcending ego-driven separation and limitations.", created_at:1779174142, source_id:"chunk-606a5dddaf8cbb6d5e610e78907fcb44", entity_id:"wholeness"}}, {_id:2557, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"a collective network of observers refers to synchronized consciousness enabling transcendent influence beyond physical constraints.", created_at:1779174143, source_id:"chunk-606a5dddaf8cbb6d5e610e78907fcb44", entity_id:"collective network of observers"}}, {_id:2558, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Newtonian classical physics represents a limited framework of reality that transcendent consciousness surpasses.", created_at:1779174143, source_id:"chunk-606a5dddaf8cbb6d5e610e78907fcb44", entity_id:"Newtonian classical physics"}}, {_id:2559, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"the greatest good of humanity refers to prioritizing universal well-being over individual or systemic agendas.", created_at:1779174143, source_id:"chunk-606a5dddaf8cbb6d5e610e78907fcb44", entity_id:"greatest good of humanity"}}, {_id:2560, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)<SEP>YouTube Video: V2WQ20Ocw_o (URL: https://www.youtube.com/watch?v=V2WQ20Ocw_o)", entity_type:"concept", truncate:"", created_at:1779667193, description:"problems are challenges perceived as obstacles, often arising from limited states of consciousness that can be reframed as opportunities.<SEP>Problems mentioned in the corrected phrase about disappearing.<SEP>problems are presented as manifestations of karma, resulting from imbalanced consciousness or harmful actions like spreading hurt or anger.", source_id:"chunk-606a5dddaf8cbb6d5e610e78907fcb44<SEP>chunk-ff56e69789b9f87a6e727c24b67b6e7c<SEP>chunk-6476052f135f5eca34d34e455193dc48", entity_id:"problems"}}, {_id:2561, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)", entity_type:"concept", truncate:"", description:"Professional challenges in business due to self-centered behavior.<SEP>Battles in business pertain to professional conflicts, competition, or operational difficulties in commercial endeavors.", created_at:1779223332, source_id:"chunk-ea86eced1dc5f4afd9febcb64617c6b8<SEP>chunk-133536d4556a6179b8f35ae5c660389b", entity_id:"Battles in Business"}}, {_id:2562, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)", entity_type:"concept", truncate:"", description:"Battles in relationships refer to conflicts or challenges arising in personal or interpersonal connections.", created_at:1779223332, source_id:"chunk-133536d4556a6179b8f35ae5c660389b", entity_id:"Battles in Relationships"}}, {_id:2563, properties:{file_path:"unknown_source", entity_type:"event", truncate:"", description:"Workshops are gatherings where people come to learn about health, wealth, and spiritual experiences, facilitating personal transformation.`", created_at:1779174143, source_id:"chunk-606a5dddaf8cbb6d5e610e78907fcb44", entity_id:"workshops"}}, {_id:2564, properties:{file_path:"unknown_source", entity_type:"event", truncate:"", description:"ACOM World Peace Festival is a global event focused on promoting peace and healing division through collective meditation.", created_at:1779174143, source_id:"chunk-ee8405ae87a23d4c3cf8bfa26fd8efc8", entity_id:"ACOM World Peace Festival"}}, {_id:2565, properties:{file_path:"unknown_source", entity_type:"artifact", truncate:"", description:"Breathing Room App is a meditation tool developed by Sri Sri Preethaji and Sri Sri Krishnaji to foster peace, love, and connection through guided practices.", created_at:1779174143, source_id:"chunk-ee8405ae87a23d4c3cf8bfa26fd8efc8", entity_id:"Breathing Room App"}}, {_id:2566, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Golris Gehrman is a New Zealand member of parliament and peace activist invited to the ACOM World Peace Festival.", created_at:1779174143, source_id:"chunk-ee8405ae87a23d4c3cf8bfa26fd8efc8", entity_id:"Golris Gehrman"}}, {_id:2567, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)", entity_type:"concept", truncate:"", description:"An inclusive life emphasizes empathy, interconnectedness, and mutual well-being, reducing life challenges through harmony.", created_at:1779223332, source_id:"chunk-133536d4556a6179b8f35ae5c660389b", entity_id:"Inclusive Life"}}, {_id:2568, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)", entity_type:"concept", truncate:"", description:"Positive interpersonal connections characterized by harmony and mutual understanding, contrasting with life battles.<SEP>Principle of fostering harmonious interpersonal connections as part of consciousness law principles.", created_at:1779223364, source_id:"chunk-133536d4556a6179b8f35ae5c660389b<SEP>chunk-65dfea79d783b0403b775689b17817eb", entity_id:"Beautiful Relationships"}}, {_id:2569, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Economic Dignity is a vision of equitable prosperity and sufficiency for all living beings, central to the festival's mission.<SEP>Economic dignity is a goal mentioned in the context of the peace meditation.", created_at:1779174143, source_id:"chunk-ee8405ae87a23d4c3cf8bfa26fd8efc8<SEP>chunk-9d2a0ad692331733d51852934ce7b3f5", entity_id:"Economic Dignity"}}, {_id:2570, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)", entity_type:"concept", truncate:"", description:"Facing battles in various aspects of life, including relationships, wealth, health, business, and professional life, as a collective challenge.", created_at:1779223332, source_id:"chunk-133536d4556a6179b8f35ae5c660389b", entity_id:"Facing Battles in Life"}}, {_id:2571, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)", entity_type:"UNKNOWN", truncate:"", description:"Living an inclusive life with empathy and interconnectedness reduces the number of life battles.", created_at:1779223333, source_id:"chunk-133536d4556a6179b8f35ae5c660389b", entity_id:"Reduced Battles"}}, {_id:2572, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)", entity_type:"UNKNOWN", truncate:"", description:"Chaos in one life aspect spreads to others if unresolved.", created_at:1779223366, source_id:"chunk-65dfea79d783b0403b775689b17817eb", entity_id:"Life Aspects"}}, {_id:2573, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kzRqQOvjRhA)<SEP>YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"naturalobject", truncate:"", created_at:1779661499, description:"Nervous system is a biological system whose harmonious functioning contributes to overall health.<SEP>The nervous system is part of the body's systems that function in harmony when there is perfect communication between bodily systems.<SEP>The body's system that is charged with electricity during enlightenment experiences.", source_id:"chunk-8c2cc5514a536fb11e09433f01ed2e85<SEP>chunk-f1afa41b3519d740bacb88dad54ed44e<SEP>chunk-355c42e8aaaf893df441489ff3a44b86", entity_id:"Nervous System"}}, {_id:2574, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Dr. Joe is a person mentioned in the text, identified as a recipient of thanks for wisdom and words.", created_at:1779174144, source_id:"chunk-9d2a0ad692331733d51852934ce7b3f5", entity_id:"Dr. Joe"}}, {_id:2575, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A-Kam is defined as the \"one undivided fabric of life\" and a divine force field.", created_at:1779174144, source_id:"chunk-9d2a0ad692331733d51852934ce7b3f5", entity_id:"A-Kam"}}] AS row
