UNWIND [{start: {_id:6586}, end: {_id:3924}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"breath control,metaphor", truncate:"", weight:1.0, description:"The sages of India likened breath to a kite's string, explaining how mastering breath controls the mind.", created_at:1779563329, source_id:"chunk-369c95aae7fc4dbe0b27e0f7e8e427f7"}}, {start: {_id:1615}, end: {_id:6594}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"health impact,vitality", truncate:"", weight:1.0, description:"Breath has the power to cure asthma and enhance vitality.", created_at:1779563330, source_id:"chunk-369c95aae7fc4dbe0b27e0f7e8e427f7"}}, {start: {_id:1615}, end: {_id:6595}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"health impact,vitality", truncate:"", weight:1.0, description:"Breath has the power to cure asthma, heal heart problems, and enhance vitality.", created_at:1779563331, source_id:"chunk-369c95aae7fc4dbe0b27e0f7e8e427f7"}}, {start: {_id:1615}, end: {_id:3924}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"knowledge,tradition", truncate:"", weight:1.0, description:"The sages of India are associated with the knowledge and tradition of breath control.", created_at:1779563331, source_id:"chunk-369c95aae7fc4dbe0b27e0f7e8e427f7"}}, {start: {_id:1615}, end: {_id:6596}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"health impact,vitality", truncate:"", weight:1.0, description:"Breath is described as having the power to cure asthma, heal heart problems, and enhance vitality.", created_at:1779563331, source_id:"chunk-369c95aae7fc4dbe0b27e0f7e8e427f7"}}, {start: {_id:1615}, end: {_id:6597}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"altered states,concentration", weight:1.0, description:"Mastering breath is linked to calming the mind, building concentration, and achieving altered states of consciousness.", created_at:1779563331, source_id:"chunk-369c95aae7fc4dbe0b27e0f7e8e427f7"}}, {start: {_id:6561}, end: {_id:6562}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"balance,energy channel activation", weight:1.0, description:"Ida Nadi and Pingala Nadi balance each other to influence brain hemispheres and personality.", created_at:1779563360, source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5"}}, {start: {_id:6599}, end: {_id:6562}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"energy channel activation", truncate:"", weight:1.0, description:"Nadi Shodhana Pranayama impacts the Pingala Nadi.", created_at:1779563360, source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5"}}, {start: {_id:6561}, end: {_id:6599}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"energy channel activation", truncate:"", weight:1.0, description:"Nadi Shodhana Pranayama impacts the Ida Nadi.", created_at:1779563361, source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5"}}, {start: {_id:6562}, end: {_id:6601}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"association,energy type", created_at:1779563361, weight:1.0, description:"Pingala Nadi carries Solar Energy.", source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5"}}, {start: {_id:6602}, end: {_id:6562}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"brain influence,energy channel", weight:1.0, description:"Pingala Nadi influences the Left Hemisphere.", created_at:1779563361, source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5"}}, {start: {_id:6561}, end: {_id:6600}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"brain influence,energy channel", weight:1.0, description:"Ida Nadi influences the Right Hemisphere.", created_at:1779563361, source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5"}}, {start: {_id:6605}, end: {_id:6562}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"anatomical association", truncate:"", weight:1.0, description:"Pingala Nadi is associated with the Right Nostril.", created_at:1779563361, source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5"}}, {start: {_id:6561}, end: {_id:6605}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"anatomical association", truncate:"", weight:1.0, description:"Ida Nadi is associated with the Left Nostril.", created_at:1779563361, source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5"}}, {start: {_id:6604}, end: {_id:6562}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"anatomical association", truncate:"", weight:1.0, description:"Pingala Nadi is associated with the Left Nostril.", created_at:1779563361, source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5"}}, {start: {_id:6561}, end: {_id:6603}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"anatomical association", truncate:"", weight:1.0, description:"Ida Nadi is associated with the Right Nostril.", created_at:1779563362, source_id:"chunk-3ed034bb1fbb1592baaabc5e71449be5"}}, {start: {_id:6606}, end: {_id:6553}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"behavioral patterns,lifestyle characteristics", weight:1.0, descrip