UNWIND [{start: {_id:305}, end: {_id:7728}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"blood flow increase,neurological impact,relationships,social effects", weight:2.0, description:"The practice enhances blood flow to the anterior cingulate, improving relationship connectivity.<SEP>Extraordinary Practice increases blood flow to the anterior cingulate, leading to improved relationships.", created_at:1779673193, source_id:"chunk-4e775b554bb52f0e7b422520123fe5a4<SEP>chunk-6cf55136aa5e4ce74dabd0e6bc9c5c31"}}, {start: {_id:307}, end: {_id:7728}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"causes,physiological effect", weight:1.0, description:"The practice increases blood flow to the prefrontal cortex and anterior cingulate.", created_at:1779672320, source_id:"chunk-4e775b554bb52f0e7b422520123fe5a4"}}, {start: {_id:7729}, end: {_id:2364}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"composition,mental content", weight:1.0, description:"Our mind is composed of thoughts, with repetitive and negative patterns dominating mental activity.", created_at:1779672345, source_id:"chunk-a806b7026395d82c6e1fe100191449c6"}}, {start: {_id:496}, end: {_id:176}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", keywords:"mental health,mitigation", truncate:"", weight:1.0, description:"Spiritual vision practices dissolve anxiety and stress through inner connection.", created_at:1779672345, source_id:"chunk-a806b7026395d82c6e1fe100191449c6"}}, {start: {_id:176}, end: {_id:116}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"interaction,mental influence", weight:1.0, description:"Spiritual vision aligns human consciousness with positive universal signaling.", created_at:1779672345, source_id:"chunk-a806b7026395d82c6e1fe100191449c6"}}, {start: {_id:305}, end: {_id:2364}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"neurological impact,relational effects", weight:1.0, description:"Negative thoughts impair blood flow to the anterior cingulate, hindering interpersonal connections.", created_at:1779672346, source_id:"chunk-a806b7026395d82c6e1fe100191449c6"}}, {start: {_id:499}, end: {_id:2364}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"causation,psychological state", weight:1.0, description:"Repetitive negative thoughts perpetuate stress and anxiety.", created_at:1779672346, source_id:"chunk-a806b7026395d82c6e1fe100191449c6"}}, {start: {_id:739}, end: {_id:1096}, properties:{file_path:"unknown_source", keywords:"collective power,unity", truncate:"", weight:1.0, description:"Family togetherness leads to collective power and purpose.", created_at:1779672444, source_id:"chunk-0ec81fd92a8028a31f8c6ce341a46fe9"}}, {start: {_id:1703}, end: {_id:1096}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Z7w7soyXmHs)", keywords:"collective attributes,collective power,collective strength,emotional impact,influence,motivation", truncate:"", weight:3.0, created_at:1779673158, description:"Togetherness generates collective power and influence.<SEP>Togetherness generates immense power as part of its inherent qualities.<SEP>Togetherness embodies power as a driving force for collective action.", source_id:"chunk-0ec81fd92a8028a31f8c6ce341a46fe9<SEP>chunk-47e1f1988fb8839c7401d731e2c56670<SEP>chunk-e8e24c4cdde1291a97c096da1259ca59"}}, {start: {_id:2404}, end: {_id:7730}, properties:{file_path:"unknown_source", keywords:"change experience,impact", truncate:"", weight:1.0, description:"An individual's beautiful state le