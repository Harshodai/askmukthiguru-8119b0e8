UNWIND [{start: {name:"Sri Preethaji"}, end: {name:"Beautiful State"}, properties:{}}, {start: {name:"Sri Krishnaji"}, end: {name:"Beautiful State"}, properties:{}}, {start: {name:"Sadhguru"}, end: {name:"Karma"}, properties:{}}, {start: {name:"Sadhguru"}, end: {name:"Dharma"}, properties:{}}] AS row
