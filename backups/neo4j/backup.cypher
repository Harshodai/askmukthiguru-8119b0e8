UNWIND [{start: {_id:1395}, end: {_id:2376}, properties:{file_path:"unknown_source", keywords:"mental technique,practice adoption", truncate:"", weight:1.0, description:"Leaders use the Serene Mind Practice to manage stress and maintain clarity in high-pressure situations.", created_at:1779183981, source_id:"chunk-5b0bc29474343c900abfcb530ac6bf39"}}, {start: {_id:473}, end: {_id:17}, properties:{file_path:"unknown_source", keywords:"practice,teaching", truncate:"", weight:1.0, description:"Krishnaji instructs participants to practice inner truth as a compassionate act of self-awareness.", created_at:1779183981, source_id:"chunk-21bacf187c7f2b778c240499081154ba"}}, {start: {_id:553}, end: {_id:504}, properties:{file_path:"unknown_source", keywords:"shared experiences,student", truncate:"", weight:1.0, description:"Diego and Lee are both students mentioned in the context of the story, though their specific interactions are not detailed.", created_at:1779183981, source_id:"chunk-999192b96103e7c498639cfadd062722"}}, {start: {_id:505}, end: {_id:553}, properties:{file_path:"unknown_source", keywords:"shared experiences,student", truncate:"", weight:1.0, description:"Diego and Christina are both students, with Christina's experience of attempting to extricate herself from anger being noted.", created_at:1779183981, source_id:"chunk-999192b96103e7c498639cfadd062722"}}, {start: {_id:2647}, end: {_id:2376}, properties:{file_path:"unknown_source", keywords:"mental technique,practice adoption", truncate:"", weight:1.0, description:"Seekers practice the Serene Mind to transition from obsessive states to present-moment awareness.", created_at:1779183981, source_id:"chunk-5b0bc29474343c900abfcb530ac6bf39"}}, {start: {_id:2376}, end: {_id:2858}, properties:{file_path:"unknown_source", keywords:"mental technique,practice adoption", truncate:"", weight:1.0, description:"Teenagers apply the practice to handle stress and emotional challenges in daily life.", created_at:1779183982, source_id:"chunk-5b0bc29474343c900abfcb530ac6bf39"}}, {start: {_id:553}, end: {_id:2855}, properties:{file_path:"unknown_source", keywords:"healing,participation", truncate:"", weight:1.0, description:"Diego participated in the process, which led to self-realization and a deep sense of calm.", created_at:1779183982, source_id:"chunk-999192b96103e7c498639cfadd062722"}}, {start: {_id:684}, end: {_id:2376}, properties:{file_path:"unknown_source", keywords:"mental technique,practice adoption", truncate:"", weight:1.0, description:"Children use the practice to manage emotions and improve focus during conflicts.", created_at:1779183982, source_id:"chunk-5b0bc29474343c900abfcb530ac6bf39"}}, {start: {_id:553}, end: {_id:2376}, properties:{file_path:"unknown_source", keywords:"adoption,transformation", truncate:"", weight:1.0, description:"Diego adopted the Serene Mind Practice, resulting in a state of serenity and clarity.", created_at:1779183983, source_id:"chunk-999192b96103e7c498639cfadd062722"}}, {start: {_id:642}, end: {_id:21}, properties:{file_path:"unknown_source", truncate:"", keywords:"conceptual framework,psychological analysis", weight:1.0, description:"The source document discusses the \"Shrinking Self\" as a universal human challenge rooted in self-doubt.", created_at:1779184065, source_id:"chunk-cb8bc4106969c883bf9c7f5bf8e466fc"}}, {start: {_id:279}, end: {_id:634}, properties:{file_path:"unknown_source", keywords:"inner conflict,self-destruction", truncate:"", weight:1.0, description:"Alex's journey mirrors Ravana's inner war, highlighting how unresolved self-doubt can lead to self-sabotage.", created_at:1779184066, source_id:"chunk-cb8bc4106969c883bf9c7f5bf8e466fc"}}, {start: {_id:279}, end: {_id:101}, properties:{file_path:"unknown_source", keywords:"achievement,competition", truncate:"", weight:1.0, description:"Alex's athletic success contrasts with his internal struggle, underscoring the disconnect between external achievements and self-worth.", created_at:1779184066, source_id:"chunk-cb8bc4106969c883bf9c7f5bf8e466fc"}}, {start: {_id:2861}, end: {_id:38}, properties:{file_path:"unknown_source", keywords:"causation,psychological impact", truncate:"", weight:1.0, description:"The suering state is a manifestation of internal conflict, leading to indecision and self-doubt.", created_at:1779184074, source_id:"chunk-2cc93fe7ed8db16f45e89fcd38b3ac24"}}, {start: {_id:2860}, end: {_id:619}, properties:{file_path:"unknown_source", keywords:"causation,psychological impact", truncate:"", weight:1.0, description:"Self-doubt leads to indecision as individuals struggle to make confident choices.", created_at:1779184074, source_id:"chunk-2cc93fe7ed8db16f45e89fcd38b3ac24"}}, {start: {_id:2862}, end: {_id:38}, properties:{file_path:"unknown_source", keywords:"impact,psychological state", truncate:"", weight:1.0, description:"Being in a suering state reduces the energy available to enjoy relationships, wealth, leisure, or success.", created_at:1779184075, source_id:"chunk-2cc93fe7ed8db16f45e89fcd38b3ac24"}}, {start: {_id:2860}, end: {_id:38}, properties:{file_path:"unknown_source", keywords:"decision-making,impact,psychological state,self-conflict", truncate:"", weight:3.0, description:"The suering state directly impacts an individual's ability to make clear and confident decisions.<SEP>The suering state erodes self-respect and leads to indecision in personal and professional choices.` -> Looks good.<SEP>The suering state erodes self-respect and leads to indecision in personal and professional choices.`", created_at:1779184335, source_id:"chunk-2cc93fe7ed8db16f45e89fcd38b3ac24<SEP>chunk-035b6c44730bb7cdf05bfef04ef27b03"}}, {start: {_id:623}, end: {_id:2860}, properties:{file_path:"unknown_source", keywords:"decision-making,metaphor", truncate:"", weight:1.0, description:"The game \"eeny meeny miney mo\" illustrates how people make decisions without taking responsibility, similar to indecisiveness.", created_at:1779184075, source_id:"chunk-2cc93fe7ed8db16f45e89fcd38b3ac24"}}, {start: {_id:667}, end: {_id:2754}, properties:{file_path:"unknown_source", keywords:"irony,wit", truncate:"", weight:1.0, description:"Birbal identifies the old man as the \"fool\" due to his illogical search strategy.", created_at:1779184159, source_id:"chunk-813e5d6774fbe0673f530d4b67ec6629"}}, {start: {_id:667}, end: {_id:2863}, properties:{file_path:"unknown_source", keywords:"intellectual challenge,reward", truncate:"", weight:1.0, description:"Akbar rewards Birbal for solving the riddle of the \"biggest fool.\"", created_at:1779184159, source_id:"chunk-813e5d6774fbe0673f530d4b67ec6629"}}, {start: {_id:612}, end: {_id:689}, properties:{file_path:"unknown_source", truncate:"", keywords:"emotional state,psychological effects", weight:1.0, description:"Inner war perpetuates unhappiness through unresolved mental conflict.", created_at:1779184160, source_id:"chunk-5c02e046d7832f0655166e3f716f3e10"}}] AS row
