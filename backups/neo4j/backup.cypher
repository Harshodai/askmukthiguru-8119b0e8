UNWIND [{start: {_id:370}, end: {_id:368}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"behavioral development,psychological impact", weight:1.0, description:"Early experiences solidify into habitual states that influence self-perception and social interactions.", created_at:1779137427, source_id:"chunk-391c88f34f518d5844e754bc2fc76c03"}}, {start: {_id:371}, end: {_id:366}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional consequences,social effects", weight:1.0, description:"Rejection during childhood can lead to loneliness and", created_at:1779137427, source_id:"chunk-391c88f34f518d5844e754bc2fc76c03"}}, {start: {_id:372}, end: {_id:366}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional impact,psychological consequences", weight:1.0, description:"Rejection during childhood can cause deep emotional wounds affecting self-perception and social interactions.", created_at:1779137427, source_id:"chunk-391c88f34f518d5844e754bc2fc76c03"}}, {start: {_id:372}, end: {_id:375}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional impact,psychological consequences", weight:1.0, description:"Neglect in parental relationships leads to emotional wounds that shape habitual behaviors in adulthood.", created_at:1779137428, source_id:"chunk-391c88f34f518d5844e754bc2fc76c03"}}, {start: {_id:373}, end: {_id:372}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"psychological effects,societal influence", weight:1.0, description:"Pressure to accept emotional compromise perpetuates emotional wounds through normalized suppression of feelings.", created_at:1779137428, source_id:"chunk-391c88f34f518d5844e754bc2fc76c03"}}, {start: {_id:372}, end: {_id:146}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cause,foundation", truncate:"", weight:1.0, description:"Emotional wounds are the foundation for the emergence of suffering states.", created_at:1779137456, source_id:"chunk-b6d2ea9a34bd43a3b859724cf57d8bec"}}, {start: {_id:378}, end: {_id:376}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"co-participation,friendship,host-guest", truncate:"", weight:2.0, description:"The Flower Seller and Salt Seller are friends who went to the market together and stayed at the Flower Seller's house.<SEP>The Flower Seller hosted the Salt Seller during the rain.", created_at:1779137456, source_id:"chunk-b6d2ea9a34bd43a3b859724cf57d8bec"}}, {start: {_id:379}, end: {_id:380}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"authorship,illustration", truncate:"", weight:1.0, description:"Sri Ramakrishna authored a story that illustrates the impact of suffering states.", created_at:1779137456, source_id:"chunk-b6d2ea9a34bd43a3b859724cf57d8bec"}}, {start: {_id:372}, end: {_id:377}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"formation,ground", truncate:"", weight:1.0, description:"Wounded child state is formed by emotional wounds.", created_at:1779137456, source_id:"chunk-b6d2ea9a34bd43a3b859724cf57d8bec"}}, {start: {_id:376}, end: {_id:146}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional distress,experiencing", truncate:"", weight:1.0, description:"The Salt Seller experienced suffering states due to emotional distress.", created_at:1779137456, source_id:"chunk-b6d2ea9a34bd43a3b859724cf57d8bec"}}, {start: {_id:380}, end: {_id:146}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"educational,illustrates", truncate:"", weight:1.0, description:"The story illustrates the impact of suffering states for educational purposes.", created_at:1779137456, source_id:"chunk-b6d2ea9a34bd43a3b859724cf57d8bec"}}, {start: {_id:380}, end: {_id:4}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"content,source", truncate:"", weight:1.0, description:"The Four Sacred Secrets.pdf is the source of the story.", created_at:1779137456, source_id:"chunk-b6d2ea9a34bd43a3b859724cf57d8bec"}}, {start: {_id:382}, end: {_id:384}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"interaction,observation", truncate:"", weight:1.0, description:"sh seller notices the ower basket and later replaces it with another basket.", created_at:1779137489, source_id:"chunk-69fc0126e446c5384fe288452b412653"}}, {start: {_id:390}, end: {_id:392}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"impact,metaphor", truncate:"", weight:1.0, description:"tides metaphorically represent how repeated thoughts shape neural pathways.", created_at:1779137489, source_id:"chunk-69fc0126e446c5384fe288452b412653"}}, {start: {_id:389}, end: {_id:393}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"movement,transmission", truncate:"", weight:1.0, description:"thoughts and emotions propagate as electrical impulses between neurons.", created_at:1779137489, source_id:"chunk-69fc0126e446c5384fe288452b412653"}}, {start: {_id:386}, end: {_id:388}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"composition,structure", truncate:"", weight:1.0, description:"brain contains over 100 billion neurons as part of its structure.", created_at:1779137489, source_id:"chunk-69fc0126e446c5384fe288452b412653"}}, {start: {_id:391}, end: {_id:395}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cause-effect,neuroplasticity", truncate:"", weight:1.0, description:"repeated thoughts strengthen neural connections, akin to tides shaping a coastline.", created_at:1779137489, source_id:"chunk-69fc0126e446c5384fe288452b412653"}}, {start: {_id:386}, end: {_id:387}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"composition,support", truncate:"", weight:1.0, description:"brain includes a trillion neuroglia cells supporting neuronal functions.", created_at:1779137489, source_id:"chunk-69fc0126e446c5384fe288452b412653"}}, {start: {_id:384}, end: {_id:381}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"interaction,sensory response", truncate:"", weight:1.0, description:"sh seller uses the stinking old sh basket to induce sleep through inhalation.", created_at:1779137489, source_id:"chunk-69fc0126e446c5384fe288452b412653"}}, {start: {_id:386}, end: {_id:391}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"adaptability,composition", truncate:"", weight:1.0, description:"brain?s neural connections are shaped by repeated thoughts and emotions.", created_at:1779137489, source_id:"chunk-69fc0126e446c5384fe288452b412653"}}] AS row
