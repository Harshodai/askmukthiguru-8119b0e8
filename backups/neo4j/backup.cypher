UNWIND [{_id:6055, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"Scientific principle discovered by Archimedes to explain floating objects.<SEP>The principle of buoyancy explains the upward force exerted by fluids, discovered by Archimedes during a Theta state insight.", created_at:1779555055, source_id:"chunk-6390a02d03fdb4770463600e69448a2a<SEP>chunk-89dc7d961c53a5116215f981f7e729a5", entity_id:"Principle of Buoyancy"}}, {_id:6056, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"person", truncate:"", description:"The individual who provided the crown to the king of Syracuse.", created_at:1779555024, source_id:"chunk-6390a02d03fdb4770463600e69448a2a", entity_id:"Goldsmith"}}, {_id:6057, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"event", truncate:"", description:"The approaching deadline imposed by the king, causing Archimedes' urgency.", created_at:1779555024, source_id:"chunk-6390a02d03fdb4770463600e69448a2a", entity_id:"Deadline"}}, {_id:6058, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"Theta state is a brain wave state (4-7 Hz) associated with intuition, universal intelligence tuning, and creative insight.", created_at:1779555055, source_id:"chunk-89dc7d961c53a5116215f981f7e729a5", entity_id:"Theta State"}}, {_id:6059, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"Delta state is a brain wave state (1-3 Hz) linked to deep sleep and Nirvikalpa Samadhi, a conscious state achieved by sages.", created_at:1779555055, source_id:"chunk-89dc7d961c53a5116215f981f7e729a5", entity_id:"Delta State"}}, {_id:6060, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)<SEP>unknown_source", entity_type:"concept", truncate:"", description:"Alpha state is a brain wave state (8-13 Hz) characterized by focused attention, increased efficiency, and heightened success potential.<SEP>Alpha state is a brain state characterized by calmness and attentiveness, achievable through practices like meditation.<SEP>Alpha state is a brain state characterized by calmness and attentiveness, achievable through practices like meditation.<SEP>Alpha state is a brain state characterized by calmness and attentiveness, achievable through practices like meditation.<SEP>Alpha state is a brain state characterized by calmness and attentiveness, achievable through practices like meditation.<SEP>Alpha state is a brain state characterized by calmness and attentiveness, achievable through practices like meditation.<SEP>Alpha state is a brain state characterized by calmness and attentiveness, achievable through practices like meditation.", created_at:1779752084, source_id:"chunk-89dc7d961c53a5116215f981f7e729a5<SEP>chunk-8755cb65b2a15a49199dbdcff939d479", entity_id:"Alpha State"}}, {_id:6061, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"Nirvikalpa Samadhi is a profound meditative state of complete absorption, achievable in Delta state by enlightened individuals.<SEP>Nirvikalpa Samadhi is a meditative state characterized by being awake while experiencing profound unity and dissolution of ego boundaries.", created_at:1779555080, source_id:"chunk-89dc7d961c53a5116215f981f7e729a5<SEP>chunk-4dd42d1c4c17856886839529f0694f39", entity_id:"Nirvikalpa Samadhi"}}, {_id:6062, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"UNKNOWN", truncate:"", description:"Gamma state correlates with advanced scientific and analytical activities.", created_at:1779555055, source_id:"chunk-89dc7d961c53a5116215f981f7e729a5", entity_id:"scientific discovery"}}, {_id:6063, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"UNKNOWN", truncate:"", description:"Alpha state enables heightened focus and efficiency, leading to improved life outcomes.", created_at:1779555055, source_id:"chunk-89dc7d961c53a5116215f981f7e729a5", entity_id:"focused attention"}}, {_id:6064, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"Low Gamma is a brain wave state (40-80 cycles/second) linked to compassionate awareness and emotional depth.", created_at:1779555080, source_id:"chunk-4dd42d1c4c17856886839529f0694f39", entity_id:"Low Gamma"}}, {_id:6065, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"High Gamma is an extraordinary brain wave state (>80 cycles/second) associated with transcendental experiences, oneness, and miraculous life transformations.", created_at:1779555080, source_id:"chunk-4dd42d1c4c17856886839529f0694f39", entity_id:"High Gamma"}}, {_id:6067, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"Buddha State represents a spiritual condition of enlightenment, inner peace, and transcendence, likened to the high Gamma brain wave state.", created_at:1779555080, source_id:"chunk-4dd42d1c4c17856886839529f0694f39", entity_id:"Buddha State"}}, {_id:6068, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"High Gamma State refers to an elevated brain state associated with enlightened living and presence during daily activities.", created_at:1779555100, source_id:"chunk-921bac8d531822a1c218a0ec38fab591", entity_id:"High Gamma State"}}, {_id:6069, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"Enlightened Living describes a state of mind characterized by presence and awareness during daily interactions, akin to the Buddha's state of being.", created_at:1779555100, source_id:"chunk-921bac8d531822a1c218a0ec38fab591", entity_id:"Enlightened Living"}}, {_id:6070, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"A thought pattern where thinking goes in circles, leading to indecision and inability to move forward in a stressful state.", created_at:1779555123, source_id:"chunk-710d5353b76529c73b545b6e7e4050a9", entity_id:"Circular Thinking"}}, {_id:6071, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"Clear, purposeful resolutions to problems and challenges emerging from focused thinking.", created_at:1779555235, source_id:"chunk-19daeaae096340ea0105da39649682b5", entity_id:"Wise Solutions"}}, {_id:6073, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)<SEP>unknown_source<SEP>YouTube Video: QzJ_Ft1de1o (URL: https://www.youtube.com/watch?v=QzJ_Ft1de1o)", entity_type:"concept", truncate:"", created_at:1779656816, description:"Ancient human groups facing physical dangers like wild animals, triggering physiological stress responses.<SEP>Hunter-gatherers are ancient human societies characterized by communal living and division of labor between hunting and gathering.<SEP>Hunter-gatherers are ancient human societies characterized by communal living and division of labor between hunting and gathering.<SEP>Hunter-gatherers are ancient human societies characterized by communal living and division of labor between hunting and gathering.<SEP>Hunter-gatherers are ancient human societies characterized by communal living and division of labor between hunting and gathering.<SEP>Hunter-gatherers are ancient human societies characterized by communal living and division of labor between hunting and gathering.<SEP>Hunter-gatherers describes early human societies where survival depended on hunting and gathering, requiring communal cooperation.", source_id:"chunk-2996cf05c59c4a2d1ccea6c5e1750952<SEP>chunk-efef91f79f63a3dccc0da4a26bee1fef<SEP>chunk-f8d4df49e2bb59337f3b12dcef1d6f2c", entity_id:"Hunter-gatherers"}}, {_id:6077, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"naturalobject", truncate:"", description:"A sugar molecule released by the body during stress or danger, later metabolized or stored.", created_at:1779555235, source_id:"chunk-2996cf05c59c4a2d1ccea6c5e1750952", entity_id:"Glucose"}}, {_id:6078, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"naturalobject", truncate:"", description:"A hormone regulating blood sugar, elevated under chronic stress with cardiovascular consequences.", created_at:1779555236, source_id:"chunk-2996cf05c59c4a2d1ccea6c5e1750952", entity_id:"Insulin"}}, {_id:6080, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"UNKNOWN", truncate:"", description:"The stressful state leads to repetitive thinking and unwise decisions due to mental clutter.", created_at:1779555314, source_id:"chunk-19daeaae096340ea0105da39649682b5", entity_id:"Unwise Choices"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6081, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"content", truncate:"", description:"YouTube Video titled \"U23yKxWbIcI\" discussing the impact of mental states on responses to challenges, including a real-life CEO story from Acum.", created_at:1779555342, source_id:"chunk-65663b0201354a6434222ff714a6bcfd", entity_id:"YouTube Video: U23yKxWbIcI"}}, {_id:6082, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)<SEP>unknown_source", entity_type:"location", truncate:"", description:"An organization where the CEO studied, mentioned in the context of the real-life story.<SEP>Acum is a location associated with the Acum retreat where the CEO studied.<SEP>Acum is a location mentioned in the text, later corrected to Ekam due to a mishearing.<SEP>Acum is a location mentioned in the text, later corrected to Ekam due to a mishearing.<SEP>Acum is a location mentioned in the text, later corrected to Ekam due to a mishearing.<SEP>Acum is a location mentioned in the text, later corrected to Ekam due to a mishearing.<SEP>Acum is a location mentioned in the text, later corrected to Ekam due to a mishearing.", created_at:1779749983, source_id:"chunk-65663b0201354a6434222ff714a6bcfd<SEP>chunk-6c59f41034b90b3918c1775bcca9c910<SEP>chunk-9bafe94fc3b8386a6692c9d466cef05c", entity_id:"Acum"}}, {_id:6083, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"A concept describing the balanced biochemical processes within the body that are essential for optimal functioning and remain untampered.", created_at:1779555342, source_id:"chunk-65663b0201354a6434222ff714a6bcfd", entity_id:"Body's Enzymal Harmony"}}, {_id:6086, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"The initial desperate option considered due to insecurity and pressure.", created_at:1779555418, source_id:"chunk-5424541c24943ffc408f99bb3aa45c96", entity_id:"Laying Off People"}}, {_id:6087, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"event", truncate:"", description:"The market experienced a significant upturn before Christmas, leading to increased demand.", created_at:1779555433, source_id:"chunk-0f9934def7b71a5f1166df0b2b2d22fb", entity_id:"The Market"}}, {_id:6088, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"creature", truncate:"", description:"A primate that responds to uncertainty with fear, leading to anxiety.", created_at:1779555433, source_id:"chunk-0f9934def7b71a5f1166df0b2b2d22fb", entity_id:"Bonobo"}}, {_id:6089, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"organization", truncate:"", description:"The company retained all employees, achieved 20% growth, and became a 600 million dollar company.", created_at:1779555433, source_id:"chunk-0f9934def7b71a5f1166df0b2b2d22fb", entity_id:"The Company"}}, {_id:6090, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"UNKNOWN", truncate:"", description:"Stressful states are divided into aggression (chimpanzee) and anxiety (bonobo).", created_at:1779555466, source_id:"chunk-0f9934def7b71a5f1166df0b2b2d22fb", entity_id:"Aggression, Anxiety"}}, {_id:6091, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"inner state refers to an individual's habitual response to challenges, such as anxiety or aggression.", created_at:1779555492, source_id:"chunk-be5f080de6d70d3597be3fed655ffb6c", entity_id:"inner state"}}, {_id:6092, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"naturalobject", truncate:"", description:"cortisone is a hormone released in bonobo monkeys' brains during stressful situations.", created_at:1779555492, source_id:"chunk-be5f080de6d70d3597be3fed655ffb6c", entity_id:"cortisone"}}, {_id:6093, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"creature", truncate:"", description:"bonobo monkey is a primate that releases cortisone in large quantities during difficult situations, leading to fear-based stress responses.", created_at:1779555492, source_id:"chunk-be5f080de6d70d3597be3fed655ffb6c", entity_id:"bonobo monkey"}}, {_id:6095, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"concept", truncate:"", description:"stress responses include anxiety, aggression, and combinations thereof, influenced by biological and cultural factors.", created_at:1779555492, source_id:"chunk-be5f080de6d70d3597be3fed655ffb6c", entity_id:"stress responses"}}, {_id:6096, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"creature", truncate:"", description:"panzee is a primate whose brain and body release testosterone in response to uncertainty.", created_at:1779555492, source_id:"chunk-be5f080de6d70d3597be3fed655ffb6c", entity_id:"panzee"}}, {_id:6097, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"naturalobject", truncate:"", description:"testosterone is a hormone released in panzee's brain and body during uncertainty.", created_at:1779555492, source_id:"chunk-be5f080de6d70d3597be3fed655ffb6c", entity_id:"testosterone"}}, {_id:6098, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=xUO_WoOlWmI)", entity_type:"concept", truncate:"", description:"destiny is linked to understanding and managing one's inner states during pressured situations.<SEP>Destiny refers to a pre-written or self-created future influenced by consciousness and intention, as discussed in the text.<SEP>destiny refers to the future trajectory or outcomes that can be consciously shaped through spiritual practices like Ekam, requiring an awakened state of consciousness for creation.<SEP>destiny refers to the future trajectory or outcomes that can be consciously shaped through spiritual practices like Ekam, requiring an awakened state of consciousness for creation.", created_at:1779675955, source_id:"chunk-be5f080de6d70d3597be3fed655ffb6c<SEP>chunk-c221b35beb5903b6212b49e01a938f47<SEP>chunk-3060fcf971a2939151d1a8320d675a71", entity_id:"destiny"}}, {_id:6100, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)<SEP>YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"concept", truncate:"", description:"freedom is achieved through self-awareness and recognition of one's stress responses.<SEP>Freedom is a central theme in the discussion, representing the ongoing struggle and desire for liberation.", created_at:1779662176, source_id:"chunk-be5f080de6d70d3597be3fed655ffb6c<SEP>chunk-bd7c38352cd44635d7efe811b1c3eb50", entity_id:"freedom"}}, {_id:6101, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"UNKNOWN", truncate:"", description:"understanding one's inner state informs decisions, actions, and words.\" That seems correct.", created_at:1779555494, source_id:"chunk-be5f080de6d70d3597be3fed655ffb6c", entity_id:"decisions"}}, {_id:6102, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", entity_type:"UNKNOWN", truncate:"", description:"Stress responses can manifest as showing aggression/anxiety or hiding them.", created_at:1779555494, source_id:"chunk-be5f080de6d70d3597be3fed655ffb6c", entity_id:"expression"}}, {_id:6103, properties:{file_path:"unknown_source<SEP>YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"A state of consciousness that observes the mind's dualistic movements, leading to liberation from suffering and pleasure.<SEP>Enlightened awareness refers to a state of conscious understanding that assimilates past experiences into personal strength.", created_at:1779556161, source_id:"chunk-beeabf4db9d94499feff9e07a340c9a1<SEP>chunk-6d16539213ab1e4cb0268da2ab5977c1", entity_id:"Enlightened Awareness"}}, {_id:6107, properties:{file_path:"unknown_source<SEP>YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"The mental process that generates pleasurable and painful states, considered unreal and fantasy-based.<SEP>Imagination is the generator of both pleasure and pain, creating dualistic experiences through a habit-driven mind.", created_at:1779556055, source_id:"chunk-beeabf4db9d94499feff9e07a340c9a1<SEP>chunk-2d8b862305b33bd0f79f0f3bd76e8c3a", entity_id:"Imagination"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6110, properties:{file_path:"unknown_source<SEP>YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vNj7OSHos1I)", entity_type:"concept", truncate:"", description:"A state where the ego feels greater than others, associated with pleasure.<SEP>Superiority is the feeling of being better than others, experienced by lottery winners after initial comparisons.<SEP>A concept discussed in the monologue, touching on themes of dominance and excellence.<SEP>A concept discussed in the monologue, touching on themes of dominance and excellence.<SEP>Superiority is a concept discussed in the context of social comparisons leading to problems.", created_at:1779723367, source_id:"chunk-beeabf4db9d94499feff9e07a340c9a1<SEP>chunk-9c1aa39a1d495c6095f631b7613571fb<SEP>chunk-93d9522c9ab38104a94e5ffe196677ac<SEP>chunk-bb8c7007984e1dbf803d7545148dee09", entity_id:"Superiority"}}, {_id:6111, properties:{file_path:"unknown_source", entity_type:"artifact", truncate:"", description:"Non-biodegradable waste that chokes life, symbolizing unresolved experiences without awareness.", created_at:1779555751, source_id:"chunk-beeabf4db9d94499feff9e07a340c9a1", entity_id:"Plastic Debris"}}, {_id:6112, properties:{file_path:"unknown_source<SEP>YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"creature", truncate:"", description:"A small reptile mentioned in the text as an example of a creature that appears larger in a state of expanded consciousness.<SEP>Small creatures symbolizing minor challenges that appear monstrous without expanded consciousness.", created_at:1779556161, source_id:"chunk-beeabf4db9d94499feff9e07a340c9a1<SEP>chunk-6d16539213ab1e4cb0268da2ab5977c1", entity_id:"Lizard or Gecko"}}, {_id:6113, properties:{file_path:"unknown_source<SEP>YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"creature", truncate:"", description:"A metaphorical creature representing exaggerated challenges in a state of expanded consciousness.<SEP>A metaphorical representation of exaggerated fears or challenges in a distorted perception.", created_at:1779556161, source_id:"chunk-beeabf4db9d94499feff9e07a340c9a1<SEP>chunk-6d16539213ab1e4cb0268da2ab5977c1", entity_id:"Godzilla"}}, {_id:6114, properties:{file_path:"unknown_source<SEP>YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"The Fourth Revolution refers to current technological advancements including artificial intelligence, virtual reality, and emerging innovations like vertical farming and nano robots.<SEP>The Fourth Revolution encompasses artificial intelligence, virtual reality, vertical farming, nano robots, gene editing, and AI-driven services like legal and education, representing the current technological upheaval.", created_at:1779555938, source_id:"chunk-258f679e26eb593f69a947105d5b63a9<SEP>chunk-bf3e14052a899fd14050d312f32aa97b", entity_id:"Fourth Revolution"}}, {_id:6115, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Virtual Reality is a key component of the Fourth Revolution, used in applications like virtual classrooms and immersive learning environments.", created_at:1779555751, source_id:"chunk-258f679e26eb593f69a947105d5b63a9<SEP>chunk-bf3e14052a899fd14050d312f32aa97b", entity_id:"Virtual Reality"}}, {_id:6118, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"organization", truncate:"", description:"Schools and educational institutions in India are measured by their output of professionals such as doctors, engineers, and chartered accountants.", created_at:1779555766, source_id:"chunk-23e9242ea59e5f560418d06d7bacd802", entity_id:"Schools and Educational Institutions"}}, {_id:6119, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Indian education system focuses on preparing youth for professions like medicine, engineering, science, law, arts, and academia, prioritizing employability over student well-being.", created_at:1779555766, source_id:"chunk-23e9242ea59e5f560418d06d7bacd802", entity_id:"Indian Education"}}, {_id:6120, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Medical profession is one of the key career paths emphasized by the Indian education system.", created_at:1779555766, source_id:"chunk-23e9242ea59e5f560418d06d7bacd802", entity_id:"Medical Profession"}}, {_id:6122, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Engineering is a prominent professional field targeted by the education system's curriculum.", created_at:1779555766, source_id:"chunk-23e9242ea59e5f560418d06d7bacd802", entity_id:"Engineering"}}, {_id:6123, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Scientific profession is a career focus area promoted by Indian educational institutions.", created_at:1779555766, source_id:"chunk-23e9242ea59e5f560418d06d7bacd802", entity_id:"Scientific Profession"}}, {_id:6124, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Legal or artistic professions are among the career outcomes measured by educational success metrics.", created_at:1779555766, source_id:"chunk-23e9242ea59e5f560418d06d7bacd802", entity_id:"Legal or Artistic Profession"}}, {_id:6125, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Academic profession is included in the education system's framework for student outcomes.", created_at:1779555766, source_id:"chunk-23e9242ea59e5f560418d06d7bacd802", entity_id:"Academic Profession"}}, {_id:6126, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Metaphorical reference to students being molded into highly competitive professionals for financial survival.", created_at:1779555766, source_id:"chunk-23e9242ea59e5f560418d06d7bacd802", entity_id:"Successful Robots"}}, {_id:6129, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"organization", truncate:"", description:"Nalanda is an ancient Indian university renowned for its educational excellence, hosting over 10,000 students and a thousand professors during its peak.<SEP>Nalanda was an ancient university in India with over 10,000 students and a thousand professors.", created_at:1779555885, source_id:"chunk-0aa35626964e0e0b383b32633be633be<SEP>chunk-2033f09bf8213ddf39a0e5521e23bdef", entity_id:"Nalanda"}}, {_id:6130, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Indian classrooms face challenges in maintaining student attention and inspiring learning, with education often perceived as a routine process rather than an engaging experience.", created_at:1779555870, source_id:"chunk-0aa35626964e0e0b383b32633be633be", entity_id:"Indian Classrooms"}}, {_id:6131, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"organization", truncate:"", description:"Takshashila is one of the world's oldest universities, known for its historical significance in education with over 10,000 students and a thousand professors.<SEP>Takshashila was an ancient university in India with over 10,000 students and a thousand professors.", created_at:1779555885, source_id:"chunk-0aa35626964e0e0b383b32633be633be<SEP>chunk-2033f09bf8213ddf39a0e5521e23bdef", entity_id:"Takshashila"}}, {_id:6132, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"organization", truncate:"", description:"Institutions are highlighted as entities that enforce educational systems, often prioritizing structure over student well-being or engagement.", created_at:1779555870, source_id:"chunk-d97614999399e6f5f1181bdaebd85f12<SEP>chunk-0aa35626964e0e0b383b32633be633be", entity_id:"Institution"}}, {_id:6133, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"The student-teacher ratio in ancient Indian education was one to ten, indicating a focus on personalized learning.", created_at:1779555885, source_id:"chunk-2033f09bf8213ddf39a0e5521e23bdef", entity_id:"Student-Teacher Ratio"}}, {_id:6134, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Gurukula education was a network that specialized in specific branches of knowledge like surgery, medicine, architecture, astrology, and Vedic math.", created_at:1779555885, source_id:"chunk-2033f09bf8213ddf39a0e5521e23bdef", entity_id:"Gurukula Education"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6135, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"The World's Greatest Education refers to the ancient Indian education system, including universities like Takshashila and Nalanda, with a student-teacher ratio of one to ten and a focus on creating superior human beings.", created_at:1779555885, source_id:"chunk-2033f09bf8213ddf39a0e5521e23bdef", entity_id:"World's Greatest Education"}}, {_id:6141, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Looting was an action taken by the British to exploit India in the name of taxes.", created_at:1779555885, source_id:"chunk-2033f09bf8213ddf39a0e5521e23bdef", entity_id:"Looting"}}, {_id:6142, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Creating clerks was a method used by the British to generate workers useful to the British Empire.", created_at:1779555885, source_id:"chunk-2033f09bf8213ddf39a0e5521e23bdef", entity_id:"Creating Clerks"}}, {_id:6143, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"A significant emotional and psychological challenge faced by young people, characterized by high rates of depression, anxiety, and substance use, exacerbated by societal pressures.", created_at:1779555915, source_id:"chunk-748133f16cf9409e907621d95ac797bb", entity_id:"Youth Mental Health Crisis"}}, {_id:6144, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"person", truncate:"", description:"The demographic group of young people in India, numbering over 434 million, facing mental health challenges and pressures.", created_at:1779555915, source_id:"chunk-748133f16cf9409e907621d95ac797bb", entity_id:"Indian Youth"}}, {_id:6145, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"organization", truncate:"", description:"Efforts by authorities to address youth mental health issues, perceived as insufficient despite existing programs.", created_at:1779555915, source_id:"chunk-748133f16cf9409e907621d95ac797bb", entity_id:"Government Initiatives"}}, {_id:6147, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Conditions such as depression, anxiety, and substance use prevalent among teenagers in educational institutions.", created_at:1779555915, source_id:"chunk-748133f16cf9409e907621d95ac797bb", entity_id:"Mental Health Problems"}}, {_id:6148, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"data", truncate:"", description:"Statistical data indicating India's youth population exceeds 434 million, with high rates of mental health issues.", created_at:1779555915, source_id:"chunk-748133f16cf9409e907621d95ac797bb", entity_id:"Indian Youth Population"}}, {_id:6149, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"person", truncate:"", description:"Young people living in urban areas, twice as prone to mental health problems compared to rural youth.", created_at:1779555915, source_id:"chunk-748133f16cf9409e907621d95ac797bb", entity_id:"Urban Youth"}}, {_id:6150, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"person", truncate:"", description:"Young people in rural areas, experiencing fewer mental health challenges than their urban counterparts.", created_at:1779555915, source_id:"chunk-748133f16cf9409e907621d95ac797bb", entity_id:"Rural Youth"}}, {_id:6151, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"The \"new reality\" refers to the emerging world shaped by the Fourth Revolution's technologies, which youth are unprepared to navigate.", created_at:1779555938, source_id:"chunk-bf3e14052a899fd14050d312f32aa97b", entity_id:"New Reality"}}, {_id:6154, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Youth experience frustration and dissatisfaction due to societal pressures, unrealistic comparisons, and global revolutionary changes.", created_at:1779555938, source_id:"chunk-bf3e14052a899fd14050d312f32aa97b", entity_id:"Youth Dissatisfaction"}}, {_id:6156, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Social media fosters unrealistic comparisons among youth with celebrity lifestyles and international pop culture, leading to dissatisfaction.", created_at:1779555938, source_id:"chunk-bf3e14052a899fd14050d312f32aa97b", entity_id:"Social Media Comparison Culture"}}, {_id:6157, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)<SEP>YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", entity_type:"concept", truncate:"", description:"Family pressure contributes to psychological strain due to generational dissonance and fragile relationships.<SEP>Family pressure is mentioned as a reason for partner relationships failing, but was not extracted in the previous task.", created_at:1779558333, source_id:"chunk-2d5e1779572c80b9567627b5320742fc<SEP>chunk-0e593bb50eabcacd46122f257190fe7f", entity_id:"Family Pressure"}}, {_id:6158, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Peer pressure is a source of psychological stress influencing youth behavior and decisions.", created_at:1779555939, source_id:"chunk-2d5e1779572c80b9567627b5320742fc", entity_id:"Peer Pressure"}}, {_id:6159, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Hormonal and physiological changes during adolescence exacerbate psychological challenges.", created_at:1779555939, source_id:"chunk-2d5e1779572c80b9567627b5320742fc", entity_id:"Biological Changes"}}, {_id:6160, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Work-related stress impacts psychological well-being, particularly for young adults.", created_at:1779555939, source_id:"chunk-2d5e1779572c80b9567627b5320742fc", entity_id:"Job Pressure"}}, {_id:6161, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Academic and institutional expectations from schools create stress among young people.", created_at:1779555939, source_id:"chunk-2d5e1779572c80b9567627b5320742fc", entity_id:"Societal Pressure from Schools"}}, {_id:6162, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Family fragility in modern India leads to emotional dissonance and lack of caregiving support.", created_at:1779555939, source_id:"chunk-2d5e1779572c80b9567627b5320742fc", entity_id:"Breakdown of Families"}}, {_id:6163, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Social media exposure fuels unrealistic comparisons with celebrity lifestyles and global peers.", created_at:1779555939, source_id:"chunk-2d5e1779572c80b9567627b5320742fc", entity_id:"Global Exposure via Social Media"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6164, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Unhealthy comparisons with curated celebrity lives intensify feelings of inadequacy.", created_at:1779555939, source_id:"chunk-2d5e1779572c80b9567627b5320742fc", entity_id:"Celebrity Lifestyle Comparison"}}, {_id:6165, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"artifact", truncate:"", description:"Source material discussing youth psychological pressure and societal factors.", created_at:1779555939, source_id:"chunk-2d5e1779572c80b9567627b5320742fc", entity_id:"YouTube Video (nCkbv_lvFfg)"}}, {_id:6166, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Perceptions of older generations dismissing youth struggles due to differing life contexts.", created_at:1779555939, source_id:"chunk-2d5e1779572c80b9567627b5320742fc", entity_id:"Senior Generation Judgment"}}, {_id:6168, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"UNKNOWN", truncate:"", description:"Family fragility creates emotional distance between generations.", created_at:1779555940, source_id:"chunk-2d5e1779572c80b9567627b5320742fc", entity_id:"Family Dissonance"}}, {_id:6170, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Conflict-free individuals are those who resolve internal and external disputes harmoniously, enabling creative and effective leadership.", created_at:1779555965, source_id:"chunk-8023f21b8329ca4fd7e397012bdb99e9", entity_id:"Conflict-Free Individuals"}}, {_id:6171, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"organization", truncate:"", description:"Oneness Young Leaders is a charitable foundation focused on nurturing young people into transformed leaders through mental and emotional health programs.", created_at:1779555965, source_id:"chunk-8023f21b8329ca4fd7e397012bdb99e9", entity_id:"Oneness Young Leaders"}}, {_id:6174, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Spiritually conscious young people exhibit mindfulness and ethical awareness, aligning their actions with universal well-being and compassion.", created_at:1779555965, source_id:"chunk-8023f21b8329ca4fd7e397012bdb99e9", entity_id:"Spiritually Conscious Young People"}}, {_id:6177, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Mental and emotional health encompasses psychological well-being and resilience, critical for personal and collective growth.", created_at:1779555966, source_id:"chunk-8023f21b8329ca4fd7e397012bdb99e9", entity_id:"Mental and Emotional Health"}}, {_id:6179, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"group", truncate:"", description:"Parents, educators, and leaders are individuals tasked with guiding young people through modern challenges and fostering their mental and emotional well-being.", created_at:1779555966, source_id:"chunk-8023f21b8329ca4fd7e397012bdb99e9", entity_id:"parents, educators, and leaders"}}, {_id:6180, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"UNKNOWN", truncate:"", description:"Spiritually conscious youth are uniquely positioned to prioritize universal well-being and ethical governance.", created_at:1779555967, source_id:"chunk-8023f21b8329ca4fd7e397012bdb99e9", entity_id:"Loka Kalyana and Universal Will"}}, {_id:6181, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"UNKNOWN", truncate:"", description:"Parents, educators, and leaders are encouraged to actively support young people in adopting transformative leadership and mental wellness practices.", created_at:1779555967, source_id:"chunk-8023f21b8329ca4fd7e397012bdb99e9", entity_id:"solution implementation"}}, {_id:6182, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"UNKNOWN", truncate:"", description:"Conflict-free individuals are more likely to emerge as innovative and impactful leaders.", created_at:1779555967, source_id:"chunk-8023f21b8329ca4fd7e397012bdb99e9", entity_id:"Creative Leaders"}}, {_id:6183, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"UNKNOWN", truncate:"", description:"Universities and colleges welcome Oneness Young Leaders to support students in enhancing mental and emotional health.", created_at:1779555967, source_id:"chunk-8023f21b8329ca4fd7e397012bdb99e9", entity_id:"Universities and Colleges"}}, {_id:6184, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"organization", truncate:"", description:"An organization providing programs for students' mental and emotional health, collaborating with universities and colleges to foster awareness and well-being.>", created_at:1779555970, source_id:"chunk-b82baadbeec25bfa1e39c2d7d0458ebd", entity_id:"ave"}}, {_id:6185, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Individuals struggling to release past relationship conflicts, leading to emotional stagnation and difficulty moving forward.>", created_at:1779555970, source_id:"chunk-b82baadbeec25bfa1e39c2d7d0458ebd", entity_id:"divorced or separated couples"}}, {_id:6186, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"organization", truncate:"", description:"Educational institutions partnering with 'ave' to support students in developing mental and emotional health through structured programs.>", created_at:1779555970, source_id:"chunk-b82baadbeec25bfa1e39c2d7d0458ebd", entity_id:"universities and colleges"}}, {_id:6187, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Professionals facing challenges related to past failures or excessive focus on future outcomes, impacting their mental well-being.>", created_at:1779555970, source_id:"chunk-b82baadbeec25bfa1e39c2d7d0458ebd", entity_id:"business people"}}, {_id:6188, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"An ongoing resistance to accepting physical appearance, fostering insecurity and negative self-perception.>", created_at:1779555970, source_id:"chunk-b82baadbeec25bfa1e39c2d7d0458ebd", entity_id:"chronic denial of appearance"}}, {_id:6189, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Educators volunteering to assist students in developing mental and emotional resilience through mindfulness and self-awareness practices.>", created_at:1779555970, source_id:"chunk-b82baadbeec25bfa1e39c2d7d0458ebd", entity_id:"teachers"}}, {_id:6190, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Young individuals volunteering to support peers in cultivating greater awareness and emotional health through community-driven initiatives.>", created_at:1779555970, source_id:"chunk-b82baadbeec25bfa1e39c2d7d0458ebd", entity_id:"youth"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6191, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"A persistent refusal to acknowledge aging and its associated life changes, contributing to psychological distress and disconnection from reality.>", created_at:1779555970, source_id:"chunk-b82baadbeec25bfa1e39c2d7d0458ebd", entity_id:"chronic denial of aging"}}, {_id:6192, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"The tendency to compare oneself with strangers worldwide, leading to diminished self-worth and emotional instability.>", created_at:1779555970, source_id:"chunk-b82baadbeec25bfa1e39c2d7d0458ebd", entity_id:"global comparison"}}, {_id:6193, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"A psychological tendency to avoid confronting changes in physical appearance over time.", created_at:1779555984, source_id:"chunk-2171a2444f1340eb8e26b9e8bb9ef9cc", entity_id:"Chronic Denial of Appearance"}}, {_id:6194, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"creature", truncate:"", description:"The human organism reacts internally to external pressures, manifesting stress when coping with difficult circumstances.", created_at:1779555984, source_id:"chunk-2171a2444f1340eb8e26b9e8bb9ef9cc", entity_id:"Human Organism"}}, {_id:6195, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Caring for an aging parent represents a physical and emotional pressure contributing to external stressors.", created_at:1779555984, source_id:"chunk-2171a2444f1340eb8e26b9e8bb9ef9cc", entity_id:"Aging Parent"}}, {_id:6196, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"These mental states result from internalizing pressure, spilling over into other life experiences and exacerbating stress.", created_at:1779555984, source_id:"chunk-2171a2444f1340eb8e26b9e8bb9ef9cc", entity_id:"Anxiety, Frustration, Agitation"}}, {_id:6197, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Caring for a sick baby is a pressure arising from physical and emotional demands on caregivers.", created_at:1779555984, source_id:"chunk-2171a2444f1340eb8e26b9e8bb9ef9cc", entity_id:"Sick Baby"}}, {_id:6198, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"A psychological state where individuals refuse to acknowledge aging and its implications.", created_at:1779555984, source_id:"chunk-2171a2444f1340eb8e26b9e8bb9ef9cc", entity_id:"Chronic Denial of Aging"}}, {_id:6199, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"The worldwide platform where social comparisons and competition occur through digital connectivity.", created_at:1779555985, source_id:"chunk-2171a2444f1340eb8e26b9e8bb9ef9cc", entity_id:"Global Stage"}}, {_id:6200, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Physical inflammation involves the body's immune response to prolonged stress or danger.", created_at:1779555989, source_id:"chunk-080d730202516ec2f29ea5332581d23c", entity_id:"Physical Inflammation"}}, {_id:6201, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)<SEP>YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", entity_type:"concept", truncate:"", description:"Inflammation refers to the body's response to harm, which can become chronic if prolonged.<SEP>Inflammation is a visible sign of the body's fight against pathogens.<SEP>Inflammation is a visible sign of the body's fight against pathogens.", created_at:1779652962, source_id:"chunk-9d4d6de56ac10d5ab428310e3d4ea053<SEP>chunk-080d730202516ec2f29ea5332581d23c<SEP>chunk-3da16f4292642f8022ca187ac2cb1ede", entity_id:"Inflammation"}}, {_id:6203, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Emotional inflammation refers to chronic distress or agitation that persists over time.", created_at:1779555989, source_id:"chunk-080d730202516ec2f29ea5332581d23c", entity_id:"Emotional Inflammation"}}, {_id:6204, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"naturalobject", truncate:"", description:"Tissues are biological structures that can be negatively impacted by chronic inflammation.", created_at:1779555989, source_id:"chunk-080d730202516ec2f29ea5332581d23c", entity_id:"Tissues"}}, {_id:6205, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Chronic inflammation occurs when the body remains in a prolonged state of alert after the danger has passed.", created_at:1779555989, source_id:"chunk-080d730202516ec2f29ea5332581d23c", entity_id:"Chronic Inflammation"}}, {_id:6206, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)<SEP>unknown_source", entity_type:"concept", truncate:"", description:"Chemicals released during stress that disrupt bodily functions, communication, and contribute to disease or ill health.<SEP>Chemicals released by the body during stress that can disrupt normal cellular function and communication.", created_at:1779652907, source_id:"chunk-05457b0af5553482321d52283975782d<SEP>chunk-5aeea4b62735a07173124f3878e34dac", entity_id:"Stress Chemicals"}}, {_id:6207, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Prolonged state of inflamed emotions leading to physiological changes and health issues, including stress chemical release and disrupted bodily communication.", created_at:1779556009, source_id:"chunk-05457b0af5553482321d52283975782d", entity_id:"Chronic Emotional Inflammation"}}, {_id:6208, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)<SEP>unknown_source", entity_type:"concept", truncate:"", description:"Physiological changes in the body due to prolonged emotional inflammation, involving stress chemical release and altered cellular communication.<SEP>The chemical processes within the body, which are altered by prolonged emotional states like fear and anger.", created_at:1779652907, source_id:"chunk-05457b0af5553482321d52283975782d<SEP>chunk-5aeea4b62735a07173124f3878e34dac", entity_id:"Body Chemistry"}}, {_id:6210, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Signaling and interaction between cells and organs in the body, disrupted by stress chemicals leading to health issues.", created_at:1779556009, source_id:"chunk-05457b0af5553482321d52283975782d", entity_id:"Body Communication"}}, {_id:6211, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Lottery Winners are individuals who have won significant lotteries and experience initial thrill followed by a return to their previous mental state.", created_at:1779556036, source_id:"chunk-9c1aa39a1d495c6095f631b7613571fb", entity_id:"Lottery Winners"}}, {_id:6212, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Initial Thrill refers to the immediate excitement and euphoria experienced by lottery winners after winning, which may last for hours or days.", created_at:1779556036, source_id:"chunk-9c1aa39a1d495c6095f631b7613571fb", entity_id:"Initial Thrill"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6213, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"Previous Mental State is the original state of mind that lottery winners return to after the initial euphoria from winning.", created_at:1779556036, source_id:"chunk-9c1aa39a1d495c6095f631b7613571fb", entity_id:"Previous Mental State"}}, {_id:6214, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=RvgN5Mfbd5A)", entity_type:"concept", truncate:"", created_at:1779675622, description:"Competitors are individuals that lottery winners compare themselves to, leading to feelings of superiority.<SEP>Competitors are individuals or groups in rivalry, often prioritizing dominance over cooperation.<SEP>Competitors are individuals driven by rivalry rather than genuine friendship.", source_id:"chunk-9c1aa39a1d495c6095f631b7613571fb<SEP>chunk-00a19ff47058297a371a169b18ef727a<SEP>chunk-f9137367b6fc0c1e310ef8df615fc408", entity_id:"Competitors"}}, {_id:6216, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"UNKNOWN", truncate:"", description:"Dissolving stress leads to acid arising, affecting the body.", created_at:1779556038, source_id:"chunk-289fa3c790540a34a24858f5f191d9ca", entity_id:"Acid"}}, {_id:6217, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)<SEP>YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", entity_type:"concept", truncate:"", description:"An unhappy mind victimizes the body, leading to health issues.<SEP>Unhappy Mind is a mental state that leads to negative physical effects and future health deterioration.<SEP>Unhappy Mind is a mental state that leads to negative physical effects and future health deterioration.", created_at:1779652962, source_id:"chunk-289fa3c790540a34a24858f5f191d9ca<SEP>chunk-a0d5e6f42a0ce75b924e7ae7dbeb9676", entity_id:"Unhappy Mind"}}, {_id:6218, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"The illusory ego is a constructed sense of self that fluctuates between feeling bloated (pleasure) or shrunk (suffering) based on external perceptions.", created_at:1779556055, source_id:"chunk-2d8b862305b33bd0f79f0f3bd76e8c3a", entity_id:"Illusory Ego"}}, {_id:6219, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"The illusory sense of self refers to a perceived diminished or shrunk feeling of one's identity, often leading to emotions like jealousy or anger when comparing oneself to others.<SEP>The illusory sense of self refers to a perceived diminished or shrunk feeling of one's identity, often leading to emotions like jealousy or anger when comparing oneself to others.", created_at:1779556112, source_id:"chunk-fd5ce10ac8b9d8fd71b9d99f866818d3", entity_id:"Illusory Sense of Self"}}, {_id:6221, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"naturalobject", truncate:"", description:"Leaves are organic components of trees that fall to the forest floor, later being digested by the Earth to nourish the tree.<SEP>Leaves are organic components of trees that fall to the forest floor, later being digested by the Earth to nourish the tree.", created_at:1779556112, source_id:"chunk-fd5ce10ac8b9d8fd71b9d99f866818d3", entity_id:"Leaves"}}, {_id:6222, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)<SEP>unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=vIUY446FVPw)", entity_type:"artifact", truncate:"", created_at:1779724619, description:"Plastic symbolizes human-made waste that disrupts natural cycles, persisting without assimilation and harming ecosystems.<SEP>Plastic symbolizes human-made waste that disrupts natural cycles, persisting without assimilation and harming ecosystems.<SEP>Plastic is a non-biodegradable material that does not assimilate into nature and can harm trees when discarded nearby.<SEP>A material contributing to environmental pollution, prompting calls for reduced usage and systemic change.` - Correct. `Plastic` is a natural object. Description is good.<SEP>A material being reduced in use, often in packaging, discussed in the context of supermarkets.", source_id:"chunk-fd5ce10ac8b9d8fd71b9d99f866818d3<SEP>chunk-6d16539213ab1e4cb0268da2ab5977c1<SEP>chunk-c4b94aac2706cfc4b2e48f3b112a4be6<SEP>chunk-ab6b594ae56e39d2a27d9720bf296186", entity_id:"Plastic"}}, {_id:6223, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"concept", truncate:"", description:"All elements of existence perceived as equally significant in a state of expanded consciousness.", created_at:1779556161, source_id:"chunk-6d16539213ab1e4cb0268da2ab5977c1", entity_id:"Live Situations, People, and Yourself"}}, {_id:6224, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"UNKNOWN", truncate:"", description:"The metaphor contrasts natural cycles (leaves) with human stagnation (plastic) to illustrate overcoming past fixation.", created_at:1779556194, source_id:"chunk-fd5ce10ac8b9d8fd71b9d99f866818d3", entity_id:"Forest Floor Metaphor"}}, {_id:6225, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"UNKNOWN", truncate:"", description:"Beautiful states emerge from being present to various aspects of life, free from divisive comparisons.", created_at:1779556194, source_id:"chunk-fd5ce10ac8b9d8fd71b9d99f866818d3", entity_id:"Life Experiences/Mind/People/Divine"}}, {_id:6226, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", entity_type:"UNKNOWN", truncate:"", description:"The illusory sense of self triggers negative emotions like jealousy or anger when perceived as lesser than others.", created_at:1779556194, source_id:"chunk-fd5ce10ac8b9d8fd71b9d99f866818d3", entity_id:"Jealousy/Disappointment/Anger"}}, {_id:6227, properties:{file_path:"unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"person", truncate:"", created_at:1779557031, description:"Tulsidas is a person who experienced romantic love, addiction to euphoric highs, and eventual enlightenment through self-realization.<SEP>Tulsidas is a person who experienced romantic love, addiction to euphoric highs, and eventual enlightenment through self-realization.<SEP>Tulsidas is a person who experiences emotional and psychological effects from early abandonment and later romantic love, including attachment and dopamine-driven experiences.", source_id:"chunk-0443cca2d76c87663467e3610969c2ba<SEP>chunk-1c0d240a13e1e4d9ab6e3ad8bbc9337e<SEP>chunk-9c98dc777cc549809cb267c54df4e36b", entity_id:"Tulsidas"}}, {_id:6228, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Tulsidas's wife is a person who confronts his obsessive behavior and questions the nature of his love, leading to his transformation.<SEP>Tulsidas's wife is a person who confronts his obsessive behavior and questions the nature of his love, leading to his transformation.", created_at:1779556301, source_id:"chunk-0443cca2d76c87663467e3610969c2ba", entity_id:"Tulsidas's Wife"}}, {_id:6229, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"concept", truncate:"", description:"The past mind is likened to a goat tethered to a post, endlessly recycling memories and limiting present-life experience.<SEP>The past mind is likened to a goat tethered to a post, endlessly recycling memories and limiting present-life experience.", created_at:1779556299, source_id:"chunk-922e23e61222fa7ebaae80af23f09b19", entity_id:"Past Mind"}}, {_id:6230, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"concept", truncate:"", description:"Refers to young people in India being educated to live free of stress as part of enlightenment pursuits.<SEP>Refers to young people in India being educated to live free of stress as part of enlightenment pursuits.", created_at:1779556299, source_id:"chunk-922e23e61222fa7ebaae80af23f09b19", entity_id:"Youth of India"}}, {_id:6231, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"concept", truncate:"", description:"Leaders in organizations taught to embrace interconnection and awareness for enlightened decision-making.<SEP>Leaders in organizations taught to embrace interconnection and awareness for enlightened decision-making.", created_at:1779556299, source_id:"chunk-922e23e61222fa7ebaae80af23f09b19", entity_id:"Corporate Leader"}}, {_id:6232, properties:{file_path:"unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"creature", truncate:"", description:"A mother cow is referenced as an example of natural nurturing behavior critical for infant development.<SEP>A mother cow is referenced as an example of natural nurturing behavior critical for infant development.<SEP>Mother cow is a creature that licks her newborn calf, illustrating the importance of physical touch for infants.", created_at:1779557031, source_id:"chunk-0443cca2d76c87663467e3610969c2ba<SEP>chunk-9c98dc777cc549809cb267c54df4e36b", entity_id:"Mother Cow"}}, {_id:6233, properties:{file_path:"unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"creature", truncate:"", description:"The newborn calf receives loving physical touch from its mother, highlighting the importance of early bonding.<SEP>The newborn calf receives loving physical touch from its mother, highlighting the importance of early bonding.<SEP>Newborn calf is a creature receiving maternal care through licking, used as an example of infant bonding.", created_at:1779557031, source_id:"chunk-0443cca2d76c87663467e3610969c2ba<SEP>chunk-9c98dc777cc549809cb267c54df4e36b", entity_id:"Newborn Calf"}}, {_id:6234, properties:{file_path:"unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"creature", truncate:"", description:"A python Tulsidas holds during his reckless journey symbolizes his destructive obsession with romantic highs.<SEP>A python Tulsidas holds during his reckless journey symbolizes his destructive obsession with romantic highs.<SEP>A large python he mistakes for a creeper, symbolizing his misguided fears and obsession.", created_at:1779557080, source_id:"chunk-0443cca2d76c87663467e3610969c2ba<SEP>chunk-98e0115fe065f5dab78321b7c772863d", entity_id:"Python"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6236, properties:{file_path:"unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"naturalobject", truncate:"", created_at:1779556998, description:"Dopamine is described as the neurochemical driving euphoric experiences and subsequent cravings.<SEP>Dopamine is described as the neurochemical driving euphoric experiences and subsequent cravings.<SEP>Dopamine is a neurotransmitter released by the brain during euphoric experiences like romantic love, linked to pleasure.<SEP>Dopamine is a neurotransmitter released by the brain during euphoric experiences like romantic love, linked to pleasure.<SEP>Dopamine is a neurotransmitter associated with pleasure and reward, which subsides over time in romantic relationships.", source_id:"chunk-0443cca2d76c87663467e3610969c2ba<SEP>chunk-463088ccb7af0ca596d7f4a288f68a78<SEP>chunk-9a7c58d7cc886bef4c4d232cf5fffc42", entity_id:"Dopamine"}}, {_id:6238, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"concept", truncate:"", description:"The act of dealing with life's challenges and issues, which enlightenment seeks to transcend through liberation from mental constraints.<SEP>The act of dealing with life's challenges and issues, which enlightenment seeks to transcend through liberation from mental constraints.", created_at:1779556302, source_id:"chunk-922e23e61222fa7ebaae80af23f09b19", entity_id:"Problem Management"}}, {_id:6239, properties:{file_path:"unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"concept", truncate:"", description:"Hunger for love is described as a disease or addiction that obscures true love, needing cessation to experience genuine affection.<SEP>Hunger for love is described as a disease or addiction that obscures true love, needing cessation to experience genuine affection.<SEP>Hunger for love is contrasted with true love, representing a state of longing rather than fulfillment.<SEP>Hunger for love is contrasted with true love, representing a state of longing rather than fulfillment.", created_at:1779557180, source_id:"chunk-5c1ed637dca2d0d131d85c8ff4dd33cb<SEP>chunk-1d477f5607ac5cfb56e2b711bd58f1aa", entity_id:"Hunger for Love"}}, {_id:6240, properties:{file_path:"unknown_source<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"naturalobject", truncate:"", description:"Heart neurons are biological components that, when awakened, facilitate the experience of love as a radiant consciousness.<SEP>Heart neurons are biological components that, when awakened, facilitate the experience of love as a radiant consciousness.<SEP>Heart neurons (40,000 in number) are linked to the neurological awakening of love and conscious experience.<SEP>Heart neurons (40,000 in number) are linked to the neurological awakening of love and conscious experience.<SEP>Heart neurons enable women to process emotions and intuition independently of the brain, influencing decisions in relationships and self-awareness.<SEP>Heart neurons enable women to process emotions and intuition independently of the brain, influencing decisions in relationships and self-awareness.", created_at:1779557379, source_id:"chunk-5c1ed637dca2d0d131d85c8ff4dd33cb<SEP>chunk-1d477f5607ac5cfb56e2b711bd58f1aa<SEP>chunk-30bdabdce129add775eb3da51d3ffd8d", entity_id:"Heart Neurons"}}, {_id:6241, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)<SEP>unknown_source", entity_type:"method", truncate:"", created_at:1779732038, description:"Pranayama is a breathing technique involving controlled inhalation and exhalation to influence the mind and consciousness.<SEP>Pranayama is a breathing technique involving controlled inhalation and exhalation to influence the mind and consciousness.<SEP>Pranayama is a breathing technique involving controlled inhalation and exhalation to influence the mind and consciousness.<SEP>Yogic breathing techniques used as a foundation for spiritual practices like Nadi Shodhana.<SEP>Pranayama is a breathing technique used in the Soul Sync challenge to generate nitric oxide and induce relaxation.", source_id:"chunk-e15affa7e924b9530baaf1cc0152bad4<SEP>chunk-7fd1a34e003778b212b04bd1c6c64ad5<SEP>chunk-e7c18228609ac51ebd48c9c0f7da32d4", entity_id:"Pranayama"}}, {_id:6242, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"method", truncate:"", description:"Inhalation is the process of drawing breath into the body, associated with the intake of Prana and oxygen.<SEP>Inhalation is the process of drawing breath into the body, associated with the intake of Prana and oxygen.<SEP>Inhalation is the process of drawing breath into the body, associated with the intake of Prana and oxygen.", created_at:1779556815, source_id:"chunk-e15affa7e924b9530baaf1cc0152bad4", entity_id:"Inhalation"}}, {_id:6243, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"method", truncate:"", description:"Exhalation is the process of releasing breath from the body, associated with the release of Prana and carbon dioxide.<SEP>Exhalation is the process of releasing breath from the body, associated with the release of Prana and carbon dioxide.<SEP>Exhalation is the process of releasing breath from the body, associated with the release of Prana and carbon dioxide.", created_at:1779556815, source_id:"chunk-e15affa7e924b9530baaf1cc0152bad4", entity_id:"Exhalation"}}, {_id:6244, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"naturalobject", truncate:"", description:"Carbon dioxide is a gas released during exhalation as part of the respiratory exchange.<SEP>Carbon dioxide is a gas released during exhalation as part of the respiratory exchange.<SEP>Carbon dioxide is a gas released during exhalation as part of the respiratory exchange.", created_at:1779556815, source_id:"chunk-e15affa7e924b9530baaf1cc0152bad4", entity_id:"Carbon Dioxide"}}, {_id:6245, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"naturalobject", truncate:"", description:"Oxygen is a gas exchanged during breathing, part of the biological process of respiration.<SEP>Oxygen is a gas exchanged during breathing, part of the biological process of respiration.<SEP>Oxygen is a gas exchanged during breathing, part of the biological process of respiration.", created_at:1779556815, source_id:"chunk-e15affa7e924b9530baaf1cc0152bad4", entity_id:"Oxygen"}}, {_id:6246, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"concept", truncate:"", description:"Social judgment disappears temporarily in romantic love, contributing to its \"blind\" nature.<SEP>Social judgment disappears temporarily in romantic love, contributing to its \"blind\" nature.", created_at:1779556997, source_id:"chunk-463088ccb7af0ca596d7f4a288f68a78", entity_id:"Social Judgment"}}, {_id:6247, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"concept", truncate:"", description:"Euphoric love refers to the initial intense emotional high driven by dopamine release, which later diminishes.", created_at:1779556997, source_id:"chunk-9a7c58d7cc886bef4c4d232cf5fffc42", entity_id:"Euphoric Love"}}, {_id:6248, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"naturalobject", truncate:"", description:"The mind-brain complex is where judgments and fault-finding emerge after dopamine subsides in relationships.", created_at:1779556997, source_id:"chunk-9a7c58d7cc886bef4c4d232cf5fffc42", entity_id:"Mind-Brain Complex"}}, {_id:6250, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"concept", truncate:"", description:"Hunger for pleasure is an unconscious urge driving people to seek repeated euphoric experiences.", created_at:1779556997, source_id:"chunk-9a7c58d7cc886bef4c4d232cf5fffc42", entity_id:"Hunger for Pleasure"}}, {_id:6251, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"UNKNOWN", truncate:"", description:"The hunger drives individuals to seek new partners to recreate euphoric highs.", created_at:1779556999, source_id:"chunk-9a7c58d7cc886bef4c4d232cf5fffc42", entity_id:"Chasing New Partners"}}, {_id:6252, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"UNKNOWN", truncate:"", description:"True love is portrayed as mutually beneficial, unlike dopamine-driven hunger.", created_at:1779556999, source_id:"chunk-9a7c58d7cc886bef4c4d232cf5fffc42", entity_id:"Mutual Nourishment"}}, {_id:6253, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"UNKNOWN", truncate:"", description:"Dopamine dependency creates a cycle of craving more euphoric experiences.", created_at:1779556999, source_id:"chunk-9a7c58d7cc886bef4c4d232cf5fffc42", entity_id:"Craving for More"}}, {_id:6254, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"concept", truncate:"", description:"The expanded and sensitive state of a newborn's consciousness, capable of perceiving emotional acceptance or rejection.", created_at:1779557018, source_id:"chunk-1c0d240a13e1e4d9ab6e3ad8bbc9337e", entity_id:"Newborn's Consciousness"}}, {_id:6255, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"concept", truncate:"", description:"The act of abandoning a child at birth, considered damaging to the child's consciousness and emotional development.", created_at:1779557018, source_id:"chunk-1c0d240a13e1e4d9ab6e3ad8bbc9337e", entity_id:"Abandonment at Birth"}}, {_id:6256, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"UNKNOWN", truncate:"", description:"Tulsidas achieved a breakthrough in consciousness, illustrating the potential for transformation despite early trauma.", created_at:1779557018, source_id:"chunk-1c0d240a13e1e4d9ab6e3ad8bbc9337e", entity_id:"Breakthrough in Consciousness"}}, {_id:6257, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"person", truncate:"", description:"Kind woman is a person who raises Tulsidas after his abandonment, though he retains psychological effects from early deprivation.", created_at:1779557031, source_id:"chunk-9c98dc777cc549809cb267c54df4e36b", entity_id:"Kind Woman"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6258, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"concept", truncate:"", description:"romance chemical describes the biochemical processes (e.g., dopamine) activated in Tulsidas's brain during romantic experiences, perceived as love.", created_at:1779557031, source_id:"chunk-9c98dc777cc549809cb267c54df4e36b", entity_id:"romance chemical"}}, {_id:6259, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"concept", truncate:"", description:"chemistry of pleasure represents the physiological responses associated with Tulsidas's attachment to his wife and romantic experiences.", created_at:1779557031, source_id:"chunk-9c98dc777cc549809cb267c54df4e36b", entity_id:"chemistry of pleasure"}}, {_id:6260, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"concept", truncate:"", description:"destructive samskara refers to a harmful imprint in consciousness caused by lack of love or touch during infancy, leading to lifelong longing for affection.", created_at:1779557031, source_id:"chunk-9c98dc777cc549809cb267c54df4e36b", entity_id:"destructive samskara"}}, {_id:6261, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"UNKNOWN", truncate:"", description:"The absence of love in infancy leads to the formation of destructive samskara in Tulsidas's consciousness.", created_at:1779557032, source_id:"chunk-9c98dc777cc549809cb267c54df4e36b", entity_id:"lack of love"}}, {_id:6263, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"location", truncate:"", description:"The dangerous riverbed he crosses, symbolizing the perilous nature of his actions and emotions.", created_at:1779557080, source_id:"chunk-98e0115fe065f5dab78321b7c772863d", entity_id:"Riverbed"}}, {_id:6265, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", entity_type:"person", truncate:"", description:"She is his wife who confronts him about the unsustainable nature of his obsession and questions the authenticity of his love.", created_at:1779557080, source_id:"chunk-98e0115fe065f5dab78321b7c772863d", entity_id:"She (His Wife)"}}, {_id:6267, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)<SEP>unknown_source", entity_type:"concept", truncate:"", description:"We need to produce a merged description for the entity \"Breakthrough\". The input includes a long description and a short description repeated 6 times. The long description is:

\"We need to produce a comprehensive, cohesive summary of the given entity \\\"Breakthrough\\\". The input is a JSON list of descriptions, each on a new line. The descriptions are:\
\
1. A long description that includes both internal shift and external connection to universal intelligence, and mentions both personal transformation and harnessing universal intelligence.\
\
2. A short description: \\\"Breakthrough signifies transformative progress in personal or professional life achieved via accessing universal intelligence.\\\"\
\
3. Same as 2 (repeated 6 times). So we have 1 long description and 6 identical short descriptions.\
