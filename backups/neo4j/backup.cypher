crets.pdf", keywords:"academy platform,education", truncate:"", weight:1.0, description:"oo.academy serves as the platform for accessing the academy's transformative courses and teachings.", created_at:1779144664, source_id:"chunk-ad1491bbe0f389ff157fd08d75ab43e9"}}, {start: {_id:62}, end: {_id:1433}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"event organizer,spiritual teaching", truncate:"", weight:1.0, description:"Preethaji conducts the Source & Synchronicities online event to explore spiritual concepts.", created_at:1779144664, source_id:"chunk-ad1491bbe0f389ff157fd08d75ab43e9"}}, {start: {_id:1440}, end: {_id:1441}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cultural heritage,symbolic examples", truncate:"", weight:1.0, description:"Myths like Odysseus, Jonah, and Arjuna illustrate profound spiritual transformations and cultural wisdom.", created_at:1779144664, source_id:"chunk-ad1491bbe0f389ff157fd08d75ab43e9"}}, {start: {_id:1435}, end: {_id:62}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"event organizer,spiritual teaching", truncate:"", weight:1.0, description:"Preethaji offers the Being Limitless event to guide participants toward limitless consciousness.", created_at:1779144664, source_id:"chunk-ad1491bbe0f389ff157fd08d75ab43e9"}}, {start: {_id:225}, end: {_id:1427}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"education,transformation", truncate:"", weight:1.0, description:"The academy's curriculum is structured to enable personal transformation through education.", created_at:1779144698, source_id:"chunk-35a211b7f3bf5a88de37f2e6c5d66a39"}}, {start: {_id:1445}, end: {_id:1444}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"metamorphosis,transformation", truncate:"", weight:1.0, description:"The snake transforms into a dragon in the myth, symbolizing profound change.", created_at:1779144698, source_id:"chunk-35a211b7f3bf5a88de37f2e6c5d66a39"}}, {start: {_id:1450}, end: {_id:1447}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"cultural practice,societal development", weight:1.0, description:"Rites of passage have driven cultural evolution but are now disconnected from modern crises.", created_at:1779144698, source_id:"chunk-35a211b7f3bf5a88de37f2e6c5d66a39"}}, {start: {_id:1446}, end: {_id:25}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conceptual framework,wisdom", truncate:"", weight:1.0, description:"Stories serve as blueprints for transformation and embody powerful wisdom.", created_at:1779144698, source_id:"chunk-35a211b7f3bf5a88de37f2e6c5d66a39"}}, {start: {_id:1449}, end: {_id:1448}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"agency,fate", truncate:"", weight:1.0, description:"The curriculum helps individuals move beyond the wheel of fortune's randomness to forge their own destiny.", created_at:1779144698, source_id:"chunk-35a211b7f3bf5a88de37f2e6c5d66a39"}}] AS row
