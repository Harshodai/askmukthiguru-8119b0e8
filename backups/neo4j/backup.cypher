UNWIND [{_id:5206, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"Spiritual bodies are cleansed by cosmic energies through A-Come's connection to the sun's powers.", created_at:1779443328, source_id:"chunk-fcd10de7f7c7ea0f2a3875516f515d95", entity_id:"Spiritual Bodies"}}, {_id:5207, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"Golden Spiral energies are mystical energies present in the Himalayas that birds interact with during their high-speed leaps.", created_at:1779443328, source_id:"chunk-fcd10de7f7c7ea0f2a3875516f515d95", entity_id:"Golden Spiral Energies"}}, {_id:5208, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"Cosmic principles govern A-Come's construction, including its alignment with planetary energies and absence of gridlines.", created_at:1779443329, source_id:"chunk-fcd10de7f7c7ea0f2a3875516f515d95", entity_id:"Cosmic Principles"}}, {_id:5209, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"The sun's powerful cosmic energies are channeled into A-Come to cleanse spiritual bodies and fulfill desires.", created_at:1779443329, source_id:"chunk-fcd10de7f7c7ea0f2a3875516f515d95", entity_id:"Sun's Cosmic Energies"}}, {_id:5211, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"Negative energy is described as the composition of Earth's gridlines, contrasting with A-Come's energy-free location.", created_at:1779443329, source_id:"chunk-fcd10de7f7c7ea0f2a3875516f515d95", entity_id:"Negative Energy"}}, {_id:5213, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"The present cosmic principle encompasses three key features: Vastu Shastra (architecture design), Shilpa Chakra (proportions/images), and Nauti Shastra (vibrations).", created_at:1779443419, source_id:"chunk-03df0a8c5f964e8a916b1625f7109836", entity_id:"present cosmic principle"}}, {_id:5214, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"event", truncate:"", description:"An event mentioned in the analysis, part of the YouTube video's content.<SEP>An event mentioned in the text, with \"A-Come\" as a specific term.", created_at:1779443522, source_id:"chunk-dededd879a6495b8b3ec3f8c0e2e1ec9<SEP>chunk-41a69529bb31744f3a07ba326cfab626", entity_id:"A-Come Peace Festival"}}, {_id:5215, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"Omit is a misheard term possibly related to \"Homuth\".<SEP>Omit is mentioned as the only surviving child in the text, with uncertainty about their identity due to potential typographical errors.<SEP>Omit is a person who is considered a possible typo for the name \"Homuth\" in the original sentence.<SEP>Term \"Omit\" is discussed as a possible typo in the video content.<SEP>A term repeatedly considered as a possible typo for \"Homuth\" in the discussed content.<SEP>Omit is a term being considered as a possible alternative or typo for Homuth in a linguistic analysis.", created_at:1779443888, source_id:"chunk-41a69529bb31744f3a07ba326cfab626<SEP>chunk-519cd4a91883594546bbe5c947089bed<SEP>chunk-114ebac9b780241152e9fe1c4a635d98<SEP>chunk-a79c5e62ebdb00659be6360a7670b062<SEP>chunk-bfebef61287c8650377c2ac7ed5e64f9<SEP>chunk-3ac37055297c46080e6fe666a2bfa48f", entity_id:"Omit"}}, {_id:5216, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"person", truncate:"", description:"The baby boy tied to the mother?s back in the story.<SEP>Baby Boy is the son of the mother, who was shot and whose death leads to her depression.", created_at:1779443575, source_id:"chunk-41a69529bb31744f3a07ba326cfab626<SEP>chunk-12c41632c244e5787f737f83514e30b2", entity_id:"Baby Boy"}}, {_id:5217, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"content", truncate:"", created_at:1779444491, description:"YouTube Video titled \"HtmLQkxj8ec\" containing a discussion about possible typos between \"Omit\" and \"Homuth\".<SEP>YouTube Video: HtmLQkxj8ec is a video source containing linguistic analysis of potential typos between \"Homuth\" and \"Omit\".<SEP>YouTube Video: HtmLQkxj8ec is a video hosted on YouTube with the URL https://www.youtube.com/watch?v=HtmLQkxj8ec, containing linguistic analysis of a text.<SEP>YouTube Video: HtmLQkxj8ec is a video hosted on YouTube with the URL https://www.youtube.com/watch?v=HtmLQkxj8ec, containing paragraphs with specified capitalization instructions.<SEP>YouTube Video with URL https://www.youtube.com/watch?v=HtmLQkxj8ec.", source_id:"chunk-a79c5e62ebdb00659be6360a7670b062<SEP>chunk-3ac37055297c46080e6fe666a2bfa48f<SEP>chunk-caf8d9108c6f4af483b2843ef9ca6415<SEP>chunk-a64a91cb6096e3d972678b05691a5e52<SEP>chunk-0f3bac8e1f8c896868952f9b1dee3a52", entity_id:"YouTube Video: HtmLQkxj8ec"}}, {_id:5218, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"content", truncate:"", description:"The title of the YouTube video where the typo discussion takes place.<SEP>HtmLQkxj8ec is a YouTube video (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec) containing text to be corrected for the Mukthi Guru platform.<SEP>HtmLQkxj8ec is a YouTube video (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec) discussing corrections to capitalization in paragraphs of a text.<SEP>HtmLQkxj8ec is a YouTube video containing content related to capitalization instructions in paragraphs.", created_at:1779444535, source_id:"chunk-bfebef61287c8650377c2ac7ed5e64f9<SEP>chunk-70c49e40023777728f7dcdcfdfae87d4<SEP>chunk-54b4b17121472ee3f4df644005361769<SEP>chunk-99755b19290cfa78847869e819a08dcc", entity_id:"HtmLQkxj8ec"}}, {_id:5219, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"Repeated attempts to resolve a spelling ambiguity between \"Omit\" and \"Homuth\" in the text.", created_at:1779443829, source_id:"chunk-bfebef61287c8650377c2ac7ed5e64f9", entity_id:"Typo Attempts"}}, {_id:5221, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"person", truncate:"", description:"Two children are the offspring of the daughter, now in their 60s, who came to the Academy.", created_at:1779443988, source_id:"chunk-c51a2c0f14fc17ea0d067007e59e63a3", entity_id:"two children"}}, {_id:5222, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"A massive spiritual transformation refers to the process the children underwent, as described in the text, which involved going through a significant change.", created_at:1779443988, source_id:"chunk-c51a2c0f14fc17ea0d067007e59e63a3", entity_id:"massive spiritual transformation"}}, {_id:5223, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)<SEP>YouTube Video: nUrc8O7Avvk (URL: https://www.youtube.com/watch?v=nUrc8O7Avvk)", entity_type:"concept", truncate:"", description:"Colloquialism refers to informal language usage, such as \"went to\" in the text, contrasted with \"underwent\" for precision.<SEP>Informal language usage observed in the phrasing \"Discrimination and separation *is* no matter how you show it.\"<SEP>Colloquial language usage that may deviate from formal grammatical rules for natural speech.<SEP>The original sentence's use of \"is\" interpreted as a colloquial or informal phrasing despite grammatical inaccuracies.<SEP>The original sentence's use of \"is\" interpreted as a colloquial or informal phrasing despite grammatical inaccuracies.", created_at:1779667076, source_id:"chunk-caf8d9108c6f4af483b2843ef9ca6415<SEP>chunk-82910be7ab066a3e5e12d9a354ef4d9a<SEP>chunk-2668d66263a2b6505795cf0f77b429d1<SEP>chunk-c3bdf300b2509154604072df1057a411", entity_id:"Colloquialism"}}, {_id:5224, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"concept", truncate:"", description:"Wordy Phrasing describes overly complex expressions like \"at the receiving end of consequences\" in the text.", created_at:1779444003, source_id:"chunk-caf8d9108c6f4af483b2843ef9ca6415", entity_id:"Wordy Phrasing"}}, {_id:5225, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"person", truncate:"", description:"Homuth's mother is a character in the story who experiences emotional trauma and passes on hate to her daughter.", created_at:1779444024, source_id:"chunk-41455e0c00724b359d7c3da19a31a17a", entity_id:"Homuth's mother"}}, {_id:5230, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"content", truncate:"", description:"The h paragraph in the video requires the first word to be capitalized to 'All'.\"", created_at:1779444391, source_id:"chunk-6660218b60d32d2712cfcb4c8cf3617b", entity_id:"h paragraph"}}, {_id:5231, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"UNKNOWN", truncate:"", description:"The eleventh paragraph in the video requires the first word to be capitalized to 'What'.", created_at:1779444422, source_id:"chunk-6660218b60d32d2712cfcb4c8cf3617b", entity_id:"eleventh paragraph"}}, {_id:5232, properties:{file_path:"YouTube Video: HtmLQkxj8ec (URL: https://www.youtube.com/watch?v=HtmLQkxj8ec)", entity_type:"UNKNOWN", truncate:"", description:"The twelfth paragraph in the video requires the first word to be capitalized to 'All'.", created_at:1779444422, source_id:"chunk-6660218b60d32d2712cfcb4c8cf3617b", entity_id:"twelfth paragraph"}}] AS row
