id:"chunk-90c446d17c5f31f5c15266790a0e5852"}}, {start: {_id:496}, end: {_id:2159}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0k5f8G9uXqY)", truncate:"", keywords:"shared concern", weight:1.0, description:"Anxiety and economic uncertainty are intertwined during the crisis.", created_at:1779157754, source_id:"chunk-90c446d17c5f31f5c15266790a0e5852"}}, {start: {_id:496}, end: {_id:2163}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0k5f8G9uXqY)", truncate:"", keywords:"crisis impact,shared experience", weight:1.0, description:"People of various nationalities experience the same anxiety during the global crisis.", created_at:1779157754, source_id:"chunk-90c446d17c5f31f5c15266790a0e5852"}}, {start: {_id:1761}, end: {_id:1866}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0k5f8G9uXqY)", truncate:"", keywords:"inner clarity,spiritual connection", weight:1.0, description:"Meditation connects individuals to the divine and fosters inner clarity.", created_at:1779157776, source_id:"chunk-264fb8cd6c5c93babb84a7f63f71ecc5"}}, {start: {_id:2170}, end: {_id:2167}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0k5f8G9uXqY)", truncate:"", keywords:"shared experience,universal emotion", weight:1.0, description:"Anger is a universal human experience shared across individuals.", created_at:1779157776, source_id:"chunk-264fb8cd6c5c93babb84a7f63f71ecc5"}}, {start: {_id:626}, end: {_id:2167}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0k5f8G9uXqY)", truncate:"", keywords:"shared experience,universal emotion", weight:1.0, description:"Happiness is a universal human experience shared across individuals.", created_at:1779157776, source_id:"chunk-264fb8cd6c5c93babb84a7f63f71ecc5"}}, {start: {_id:2170}, end: {_id:2169}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0k5f8G9uXqY)", truncate:"", keywords:"shared emotion,universal expression", weight:1.0, description:"In-laws' anger is a shared human experience with universal expression.", created_at:1779157776, source_id:"chunk-264fb8cd6c5c93babb84a7f63f71ecc5"}}, {start: {_id:2168}, end: {_id:2167}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0k5f8G9uXqY)", truncate:"", keywords:"shared behavior,universal tendency", weight:1.0, description:"Clinging is a universal human tendency regardless of the object.", created_at:1779157776, source_id:"chunk-264fb8cd6c5c93babb84a7f63f71ecc5"}}, {start: {_id:626}, end: {_id:2172}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0k5f8G9uXqY)", truncate:"", keywords:"shared emotion,universal expression", weight:1.0, description:"A partner's happiness is a shared human experience with universal expression.", created_at:1779157776, source_id:"chunk-264fb8cd6c5c93babb84a7f63f71ecc5"}}, {start: {_id:626}, end: {_id:2171}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0k5f8G9uXqY)", truncate:"", keywords:"mutual understanding,shared emotion", weight:1.0, description:"A loved one's happiness is a shared human experience with mutual understanding.", created_at:1779157776, source_id:"chunk-264fb8cd6c5c93babb84a7f63f71ecc5"}}, {start: {_id:2166}, end: {_id:2167}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0k5f8G9uXqY)", truncate:"", keywords:"interconnectedness,shared unity", weight:1.0, description:"The experience of oneness is rooted in the interconnectedness of human experiences.", created_at:1779157776, source_id:"chunk-264fb8cd6c5c93babb84a7f63f71ecc5"}}, {start: {_id:2174}, end: {_id:2173}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0k5f8G9uXqY)", truncate:"", keywords:"divine identity,equivalence", weight:1.0, description:"Antaryamin is described as