UNWIND [{start: {_id:1695}, end: {_id:1680}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"dietary impact,health enhancement", weight:1.0, description:"Eating right enhances immunity through adequate protein intake.", created_at:1779148146, source_id:"chunk-8beba43872c2a4b73d69ad70815212d9"}}, {start: {_id:1674}, end: {_id:1715}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"energy expenditure,metaphorical comparison", weight:1.0, description:"Fasting breath regulates metabolic heat production like an engine.", created_at:1779148146, source_id:"chunk-8beba43872c2a4b73d69ad70815212d9"}}, {start: {_id:1695}, end: {_id:1713}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"dietary practice,fasting method", weight:1.0, description:"Langanam incorporates principles of eating right as part of fasting discipline.", created_at:1779148146, source_id:"chunk-8beba43872c2a4b73d69ad70815212d9"}}, {start: {_id:1714}, end: {_id:1674}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"energy regulation,metaphorical analogy", weight:1.0, description:"Engine metaphor explains fasting breath's energy dynamics.", created_at:1779148146, source_id:"chunk-8beba43872c2a4b73d69ad70815212d9"}}, {start: {_id:1726}, end: {_id:1722}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"avoidance,control", weight:2.0, description:"The third langanam is about avoiding hurtful and pessimistic speech.", created_at:1779148210, source_id:"chunk-42e81b4f05e078ec2af83230faa7d66a"}}, {start: {_id:1727}, end: {_id:1720}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", keywords:"enhancement,growth", truncate:"", weight:1.0, description:"Vak shakti grows with true and joyful speech.", created_at:1779148210, source_id:"chunk-42e81b4f05e078ec2af83230faa7d66a"}}, {start: {_id:1725}, end: {_id:1723}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", keywords:"involvement,practice", truncate:"", weight:1.0, description:"Fasting movement involves sitting still.", created_at:1779148210, source_id:"chunk-42e81b4f05e078ec2af83230faa7d66a"}}, {start: {_id:1725}, end: {_id:1728}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", keywords:"involvement,practice", truncate:"", weight:1.0, description:"Fasting movement involves observing breath.", created_at:1779148210, source_id:"chunk-42e81b4f05e078ec2af83230faa7d66a"}}, {start: {_id:1724}, end: {_id:1723}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"reduction", weight:1.0, description:"Sitting still reduces restlessness in the body.", created_at:1779148210, source_id:"chunk-42e81b4f05e078ec2af83230faa7d66a"}}, {start: {_id:1721}, end: {_id:1725}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", keywords:"involvement,practice", truncate:"", weight:3.0, description:"Fasting movement includes chanting the divine being's name.", created_at:1779148211, source_id:"chunk-42e81b4f05e078ec2af83230faa7d66a"}}, {start: {_id:1713}, end: {_id:1731}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"grammatical accuracy,terminology correction", weight:1.0, description:"Langanam is corrected to \"lankanas\" to resolve redundancy and improve clarity.", created_at:1779148236, source_id:"chunk-e78849d328e3a33491b015a1e6ba7265"}}, {start: {_id:1729}, end: {_id:1732}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"engine function,scientific context", weight:1.0, description:"\"An engine\" is discussed in relation to heat production, with grammatical adjustments for accuracy.", created_at:1779148236, source_id:"chunk-e78849d328e3a33491b015a1e6ba7265"}}, {start: {_id:1738}, end: {_id:1736}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"grammatical rules,syntactic analysis", weight:1.0, description:"The phrase exemplifies the contested grammatical structure being debated in the video.", created_at:1779148280, source_id:"chunk-802854365651bf3a642cd664c309c83e"}}, {start: {_id:1735}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"content analysis,discussion content,grammatical analysis,linguistic debate,source", weight:3.0, created_at:1779148367, description:"The YouTube video contains the phrase with disputed article usage, sparking debate over grammatical correctness.<SEP>The YouTube video features a discussion analyzing the grammatical accuracy of the article's example sentence.<SEP>The YouTube Video features a discussion critiquing the article's grammatical accuracy regarding engine terminology.", source_id:"chunk-802854365651bf3a642cd664c309c83e<SEP>chunk-16cb17d50adced4f0b0959b822d03a3e<SEP>chunk-791613ee96d428f562709fadee905618"}}, {start: {_id:1714}, end: {_id:1733}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"energy output,production,technical context", weight:2.0, description:"The engine's heat production is the subject of the grammatical discussion in the YouTube video.<SEP>The engine produces heat, as explicitly stated in the example sentence and analyzed in the grammatical debate.", created_at:1779148325, source_id:"chunk-802854365651bf3a642cd664c309c83e<SEP>chunk-16cb17d50adced4f0b0959b822d03a3e"}}, {start: {_id:1737}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"grammatical controversy,linguistic analysis", weight:1.0, description:"The video presents the phrase with disputed article usage, sparking a debate over grammatical rules and linguistic accuracy.", created_at:1779148280, source_id:"chunk-802854365651bf3a642cd664c309c83e"}}, {start: {_id:1735}, end: {_id:1714}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"article usage,correction,grammatical accuracy,grammatical error,grammatical structure,linguistic accuracy", weight:3.0, description:"The debate centers on whether the article should be \"the\" or \"an\" when describing the engine's heat production.<SEP>The article debates whether the correct phrase is \"the more heat an engine produces\" or \"the more heat, an engine produces.\"<SEP>The engine's portrayal in the article sparks debate over proper article usage (\"an\" vs. \"the\").", created_at:1779148368, source_id:"chunk-802854365651bf3a642cd664c309c83e<SEP>chunk-791613ee96d428f562709fadee905618"}}, {start: {_id:1734}, end: {_id:1737}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"article selection,linguistic principles", weight:1.0, description:"The debate centers on whether \"the\" or \"an\" is correct in describing the engine's heat production.", created_at:1779148280, source_id:"chunk-802854365651bf3a642cd664c309c83e"}}, {start: {_id:1734}, end: {_id:1714}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"grammatical context,technical terminology", weight:1.0, description:"The debate questions whether \"the\" or \"an\" appropriately modifies \"engine\" in the context of heat production.", created_at:1779148280, source_id:"chunk-802854365651bf3a642cd664c309c83e"}}, {start: {_id:1741}, end: {_id:1740}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"illustration,linguistic debate", weight:1.0, description:"The sentence \"the more heat an engine produces\" is used to debate correct article usage (\"an\" vs. \"the\").", created_at:1779148325, source_id:"chunk-16cb17d50adced4f0b0959b822d03a3e"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
