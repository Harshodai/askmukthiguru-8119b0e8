UNWIND [{start: {_id:14}, end: {name:"Oneness"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"merger,organizational restructuring", truncate:"", weight:1.0, description:"Oneness was merged with One World Academy to form O&O Academy.", created_at:1779135291, source_id:"chunk-8ee3e05777e56f75a0285ee42d5cac0e"}}, {start: {_id:13}, end: {name:"Oneness"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"merger,organizational restructuring", truncate:"", weight:1.0, description:"Oneness was merged with One World Academy to form O&O Academy.", created_at:1779135291, source_id:"chunk-8ee3e05777e56f75a0285ee42d5cac0e"}}, {start: {_id:23}, end: {name:"Four Sacred Secrets"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"purpose,transformation", truncate:"", weight:1.0, description:"The four sacred secrets are meant to attune individuals to the power of consciousness.", created_at:1779135341, source_id:"chunk-159b60743c404c64b4b2bc2c5ee55cc9"}}, {start: {_id:27}, end: {name:"Four Sacred Secrets"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"book,secrets", truncate:"", weight:1.0, description:"The four sacred secrets are content within the book.", created_at:1779135341, source_id:"chunk-159b60743c404c64b4b2bc2c5ee55cc9"}}, {start: {_id:29}, end: {name:"Suffering State"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=UZHSssZflFQ)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=OWMBvMlGWTA)", keywords:"cause-effect,life outcomes,negative impact,outcome,state", truncate:"", weight:3.0, created_at:1779230028, description:"The suffering state creates chaos.<SEP>Suffering states result in chaos, disrupting decisions and causing life stress.<SEP>Suffering state attracts chaotic events and negative experiences.`", source_id:"chunk-159b60743c404c64b4b2bc2c5ee55cc9<SEP>chunk-05f743c9b037a7017d2d7111bbe6ff3f<SEP>chunk-f75c5d6ff6cf90a0c79623ead0773fbc"}}, {start: {_id:31}, end: {name:"Suffering State"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"beautiful state,relationship", truncate:"", weight:1.0, description:"The suffering state is the opposite of the beautiful state.", created_at:1779135342, source_id:"chunk-159b60743c404c64b4b2bc2c5ee55cc9"}}, {start: {_id:33}, end: {name:"Beautiful State"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"outcome,state", truncate:"", weight:1.0, description:"The beautiful state awakens intuition.", created_at:1779135342, source_id:"chunk-159b60743c404c64b4b2bc2c5ee55cc9"}}, {start: {_id:17}, end: {name:"Oneness"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"philosophy,teaching", truncate:"", weight:1.0, description:"Krishnaji introduces and teaches the concept of Oneness as part of his spiritual and educational contributions.", created_at:1779135419, source_id:"chunk-a3cf87dcbdae759e4fd39a070ea3cde7"}}, {start: {_id:54}, end: {name:"Oneness"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"philosophy,teaching", truncate:"", weight:1.0, description:"Amma collaborates in presenting the philosophy of Oneness alongside Krishnaji.", created_at:1779135419, source_id:"chunk-a3cf87dcbdae759e4fd39a070ea3cde7"}}, {start: {_id:81}, end: {name:"Suffering"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"experience,understanding", truncate:"", weight:1.0, description:"The narrator comprehends their own suffering and extends this understanding to all of humanity.", created_at:1779135573, source_id:"chunk-03f4910a466e54c3db3456e161f19c10"}}, {start: {_id:155}, end: {name:"Suffering"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: k8iO5daXllM (URL: https://www.youtube.com/watch?v=k8iO5daXllM)", keywords:"contrast,differentiation,external vs internal,internal vs external,internal vs. external,internal-external,response framework", truncate:"", weight:6.0, description:"Suffering is an internal experience, while a problem is external, with the text emphasizing their fundamental difference in origin and approach.<SEP>Suffering is an internal emotional response, while problems are external challenges, though both are interconnected in human experience.<SEP>Suffering is an internal experience, while problems are external challenges addressed from either suffering or beautiful states.<SEP>Problem and suffering are distinguished by their nature: problem is external, suffering is internal.<SEP>Problem is framed as an external situation, while suffering is characterized as an internal experience.<SEP>Problems are external situations, while suffering represents internal emotional impact.", created_at:1779663875, source_id:"chunk-b9eed6b91a21f212612d0bb96c4d8857<SEP>chunk-ddc2a8c2bf46af1d243c4bae41044efd<SEP>chunk-98ebbba09ead01df2486b7e4f58bcc9b<SEP>chunk-9f51181a0a82fab99daeacb192359f2b<SEP>chunk-2abf9b76c25a40660c2457bb0ad9b00e<SEP>chunk-539d32cffeac32af158844b70b3aafe4"}}, {start: {_id:171}, end: {name:"Beautiful State"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"overcoming obstacles,transformation", truncate:"", weight:1.0, description:"The Beautiful State dissolves barriers that hinder progress, creating pathways for growth.", created_at:1779136111, source_id:"chunk-9ed2c626e4ecfc75e917140a3a7bfdbb"}}, {start: {_id:191}, end: {name:"Consciousness"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"impact,transformation", truncate:"", weight:1.0, description:"The center aims to impact individual and collective consciousness through designed environment.", created_at:1779136232, source_id:"chunk-2b4fda69309d99ad3cadc792e81ed13a"}}, {start: {_id:198}, end: {name:"Ekam"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"design,sacred architecture", truncate:"", weight:1.0, description:"The architect designed Ekam using ancient mystical principles of sacred architecture.", created_at:1779136253, source_id:"chunk-d6d985847ffebe163bb1dd6d9757e27c"}}, {start: {_id:137}, end: {name:"Suffering"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"destructive nature,emotional state", truncate:"", weight:1.0, description:"Nomi is directly linked to suffering, characterized by absence and disconnection.", created_at:1779136789, source_id:"chunk-ae33a0629a1035831d09370dbcb6fa05"}}, {start: {_id:29}, end: {name:"Suffering"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cause and effect,destructive outcome", truncate:"", weight:1.0, description:"Suffering leads to chaos through accumulating problems and confusion.", created_at:1779136789, source_id:"chunk-ae33a0629a1035831d09370dbcb6fa05"}}, {start: {_id:293}, end: {name:"Suffering"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"conflict,interpersonal impact", created_at:1779136789, weight:1.0, description:"Suffering states manifest as", source_id:"chunk-ae33a0629a1035831d09370dbcb6fa05"}}, {start: {_id:514}, end: {name:"Suffering"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"mitigation,prevention", truncate:"", weight:1.0, description:"Practicing the sacred secret helps reduce and manage suffering.", created_at:1779138470, source_id:"chunk-031bd1294ef04a689b10ae93123dbc7a"}}, {start: {_id:550}, end: {name:"Suffering"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"escalation,manifestation", truncate:"", weight:1.0, description:"Unmanaged emotional states contribute to increased suffering.", created_at:1779138470, source_id:"chunk-031bd1294ef04a689b10ae93123dbc7a"}}, {start: {_id:553}, end: {name:"Suffering"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"redemption,self-imposed punishment", truncate:"", weight:1.0, description:"Diego associates suffering with atonement and believes enduring pain is the only way to seek forgiveness for his son's death.", created_at:1779138559, source_id:"chunk-aba350ed9d0892b4b1d22f7c1f604b21"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
