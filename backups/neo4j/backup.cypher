UNWIND [{start: {_id:1449}, end: {_id:2390}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", truncate:"", keywords:"core influence,spirituality", weight:1.0, description:"Spirituality is at the core of leading to destiny through energy and decisions.", created_at:1779396321, source_id:"chunk-62aafe5d597e7b4e36bd88d98b8974d0"}}, {start: {_id:1815}, end: {_id:4036}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"action_process,outcome", truncate:"", weight:2.0, description:"Intention influences actions, which contribute to destiny.", created_at:1779396322, source_id:"chunk-62aafe5d597e7b4e36bd88d98b8974d0"}}, {start: {_id:4515}, end: {_id:1805}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"influence,order_energy_flow", truncate:"", weight:1.0, description:"Order energy flows into intention, decisions, and actions.", created_at:1779396322, source_id:"chunk-62aafe5d597e7b4e36bd88d98b8974d0"}}, {start: {_id:29}, end: {_id:4515}, properties:{file_path:"YouTube Video: Vr3PS2DdbDU (URL: https://www.youtube.com/watch?v=Vr3PS2DdbDU)", keywords:"chaos_energy_flow,influence", truncate:"", weight:1.0, description:"Chaos energy flows into intention, decisions, and actions.", created_at:1779396322, source_id:"chunk-62aafe5d597e7b4e36bd88d98b8974d0"}}, {start: {_id:1328}, end: {_id:4516}, properties:{file_path:"unknown_source", keywords:"emotional trigger,recognition", truncate:"", weight:1.0, description:"Inner disturbance triggers recognition of longing for love from husband as a recurring life pattern.", created_at:1779396440, source_id:"chunk-0ddbd4446b0368311d8844f5869734c4"}}, {start: {_id:4518}, end: {_id:4517}, properties:{file_path:"YouTube Video: zGOKGrTNlk4 (URL: https://www.youtube.com/watch?v=zGOKGrTNlk4)", truncate:"", keywords:"emotional trigger,relational dynamic", weight:1.0, description:"The listener associates inner disturbance with longing for love from their husband.", created_at:1779396490, source_id:"chunk-28084224d33efa95fcb7e18cd0d14748"}}, {start: {_id:1328}, end: {_id:2376}, properties:{file_path:"YouTube Video: zGOKGrTNlk4 (URL: https://www.youtube.com/watch?v=zGOKGrTNlk4)", keywords:"management,mindfulness", truncate:"", weight:1.0, description:"Serene mind practice is applied to manage inner disturbances through awareness.", created_at:1779396490, source_id:"chunk-28084224d33efa95fcb7e18cd0d14748"}}, {start: {_id:1328}, end: {_id:4517}, properties:{file_path:"YouTube Video: zGOKGrTNlk4 (URL: https://www.youtube.com/watch?v=zGOKGrTNlk4)", truncate:"", keywords:"emotional trigger,relational dynamic", weight:1.0, description:"Inner disturbance is associated with longing for love from the husband, reflecting recurring life experiences.", created_at:1779396490, source_id:"chunk-28084224d33efa95fcb7e18cd0d14748"}}, {start: {_id:4521}, end: {_id:2390}, properties:{file_path:"unknown_source<SEP>YouTube Video: KTlY-lHs_Ew (URL: https://www.youtube.com/watch?v=KTlY-lHs_Ew)", keywords:"analogy,foundational development,progression", truncate:"", weight:2.0, description:"Spirituality begins with achieving a basic, foundational state of being as a person.<SEP>Spirituality's first stage is described as foundational, akin to initial educational stages.", created_at:1779398060, source_id:"chunk-6f4b86894bf06d07d9095036ac74d620<SEP>chunk-3671b49c0db3dedf797a14f78cb2a87b"}}, {start: {_id:2391}, end: {_id:4522}, properties:{file_path:"unknown_source<SEP>YouTube Video: KTlY-lHs_Ew (URL: https://www.youtube.com/watch?v=KTlY-lHs_Ew)", keywords:"analogy,comparison,final stage,metaphorical equivalence", truncate:"", weight:3.0, created_at:1779398060, description:"Enlightenment is metaphorically equated to a PhD, representing the highest academic and spiritual achievement.<SEP>PhD is equated with enlightenment as the highest level in both education and spirituality.<SEP>Enlightenment is metaphorically linked to earning a PhD as the pinnacle of academic and spiritual achievement.", source_id:"chunk-6f4b86894bf06d07d9095036ac74d620<SEP>chunk-1fbe8b29b004fd2a51bfaf808ad4a188<SEP>chunk-3671b49c0db3dedf797a14f78cb2a87b"}}, {start: {_id:4520}, end: {_id:2390}, properties:{file_path:"unknown_source", keywords:"enlightenment,transformation", truncate:"", weight:1.0, description:"Spirituality culminates in enlightenment, a state of harmony between inner self and daily life.", created_at:1779397584, source_id:"chunk-6f4b86894bf06d07d9095036ac74d620"}}, {start: {_id:144}, end: {_id:2390}, properties:{file_path:"unknown_source", truncate:"", keywords:"experiential learning,inner alignment", weight:1.0, description:"Spirituality involves learning to inhabit beautiful inner states, which naturally manifest in actions.", created_at:1779397585, source_id:"chunk-6f4b86894bf06d07d9095036ac74d620"}}, {start: {_id:144}, end: {_id:4519}, properties:{file_path:"unknown_source", keywords:"analogical framework", truncate:"", weight:1.0, description:"Beautiful states parallel educational milestones, framing spiritual growth through familiar structures.", created_at:1779397585, source_id:"chunk-6f4b86894bf06d07d9095036ac74d620"}}, {start: {_id:179}, end: {_id:2390}, properties:{file_path:"unknown_source<SEP>YouTube Video: KTlY-lHs_Ew (URL: https://www.youtube.com/watch?v=KTlY-lHs_Ew)", keywords:"core focus,daily life,inner state,self-awareness", truncate:"", weight:2.0, description:"Spirituality prioritizes cultivating a natural, harmonious inner state over external behaviors or material circumstances.<SEP>Spirituality emphasizes a natural inner state that reflects in daily life.", created_at:1779398287, source_id:"chunk-6f4b86894bf06d07d9095036ac74d620<SEP>chunk-6a5c1cd3abe977e04aa0398546d911a7"}}, {start: {_id:127}, end: {_id:4523}, properties:{file_path:"YouTube Video: KTlY-lHs_Ew (URL: https://www.youtube.com/watch?v=KTlY-lHs_Ew)", truncate:"", keywords:"content refinement,editing process", weight:1.0, description:"The author applies grammar corrections to improve the video's textual clarity and readability.", created_at:1779397716, source_id:"chunk-8747b8559b6ab050bd73313beb85bb44"}}, {start: {_id:4499}, end: {_id:348}, properties:{file_path:"YouTube Video: KTlY-lHs_Ew (URL: https://www.youtube.com/watch?v=KTlY-lHs_Ew)", truncate:"", keywords:"analogical framework,conceptual parallel,explanatory tool,illustrative device", weight:2.0, description:"Education is used as a metaphor to elucidate spiritual concepts within the video.<SEP>The video employs educational structures to mirror spiritual development stages.", created_at:1779397716, source_id:"chunk-8747b8559b6ab050bd73313beb85bb44"}}, {start: {_id:4525}, end: {_id:4529}, properties:{file_path:"YouTube Video: KTlY-lHs_Ew (URL: https://www.youtube.com/watch?v=KTlY-lHs_Ew)", truncate:"", keywords:"standardization,terminology correction", weight:1.0, description:"\"Undergraduation\" is replaced with \"undergraduate studies\" for clarity and consistency.", created_at:1779397743, source_id:"chunk-1fbe8b29b004fd2a51bfaf808ad4a188"}}, {start: {_id:4526}, end: {_id:2390}, properties:{file_path:"YouTube Video: KTlY-lHs_Ew (URL: https://www.youtube.com/watch?v=KTlY-lHs_Ew)", truncate:"", keywords:"foundational stage,progression", weight:1.0, description:"Becoming is identified as the initial stage of spirituality focused on self-improvement.", created_at:1779397743, source_id:"chunk-1fbe8b29b004fd2a51bfaf808ad4a188"}}, {start: {_id:4499}, end: {_id:4525}, properties:{file_path:"YouTube Video: KTlY-lHs_Ew (URL: https://www.youtube.com/watch?v=KTlY-lHs_Ew)", truncate:"", keywords:"academic hierarchy,terminology", weight:1.0, description:"Undergraduate studies replaces \"undergraduation\" as the third educational stage in the analogy.", created_at:1779397743, source_id:"chunk-1fbe8b29b004fd2a51bfaf808ad4a188"}}, {start: {_id:4528}, end: {_id:2390}, properties:{file_path:"YouTube Video: KTlY-lHs_Ew (URL: https://www.youtube.com/watch?v=KTlY-lHs_Ew)", keywords:"culmination,final stage", truncate:"", weight:1.0, description:"The enlightened person represents the ultimate goal of spiritual development.", created_at:1779397743, source_id:"chunk-1fbe8b29b004fd2a51bfaf808ad4a188"}}] AS row
