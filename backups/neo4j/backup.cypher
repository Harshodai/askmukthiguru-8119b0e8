UNWIND [{_id:7224, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", description:"Discoverer of the Divine is a person who has a mystical experience and converts to a discoverer of the divine.`", created_at:1779661691, source_id:"chunk-71c647fd13898f185a71091bf9fbd510", entity_id:"Discoverer of the Divine"}}, {_id:7233, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", description:"A focus on personal interests that transcendental experiences help overcome.", created_at:1779661705, source_id:"chunk-9f245e3153d92a2c38134afd812338bf", entity_id:"Self-Centricity"}}, {_id:7234, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"data", truncate:"", description:"Massive electrical energy surging through the nervous system during enlightenment experiences.", created_at:1779661705, source_id:"chunk-9f245e3153d92a2c38134afd812338bf", entity_id:"Joules of Electricity"}}, {_id:7235, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", description:"A metaphysical state where subject-object distinctions dissolve, accessed through enlightenment.", created_at:1779661705, source_id:"chunk-9f245e3153d92a2c38134afd812338bf", entity_id:"Realm of Non-Duality"}}, {_id:7237, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"concept", truncate:"", description:"The \"garbage in, garbage out\" problem is discussed as a challenge for AI when processing flawed prompts.", created_at:1779661800, source_id:"chunk-2208b834de2276647fea09e4bf25b2bd", entity_id:"garbage in, garbage out"}}, {_id:7238, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"method", truncate:"", description:"Strict interpretation suggests no changes to the text as it is already correct.", created_at:1779661800, source_id:"chunk-2208b834de2276647fea09e4bf25b2bd", entity_id:"strict interpretation"}}, {_id:7239, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"method", truncate:"", description:"The task involves correcting the provided text based on user instructions and interpretations.", created_at:1779661800, source_id:"chunk-2208b834de2276647fea09e4bf25b2bd", entity_id:"task"}}, {_id:7240, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"content", truncate:"", description:"The text to be corrected is deemed grammatically and stylistically correct, requiring no changes.", created_at:1779661800, source_id:"chunk-2208b834de2276647fea09e4bf25b2bd", entity_id:"provided text"}}, {_id:7241, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"method", truncate:"", description:"Intent-based interpretation considers injecting terms like \"Sri Preethaji\" but dismisses it as illogical.", created_at:1779661801, source_id:"chunk-2208b834de2276647fea09e4bf25b2bd", entity_id:"intent-based interpretation"}}, {_id:7242, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"method", truncate:"", description:"Another interpretation proposes correcting misheard words but acknowledges their absence in the text.", created_at:1779661801, source_id:"chunk-2208b834de2276647fea09e4bf25b2bd", entity_id:"another interpretation"}}, {_id:7243, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"content", truncate:"", description:"The output is identical to the provided text, as no errors were found requiring correction.", created_at:1779661801, source_id:"chunk-2208b834de2276647fea09e4bf25b2bd", entity_id:"output"}}, {_id:7244, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"UNKNOWN", truncate:"", description:"The concept of \"Pineal gland activation\" is central to the mystical experience described.", created_at:1779661823, source_id:"chunk-2513ead52ad2bbf56e47a3233d1a61cb", entity_id:"Pineal Gland Activation"}}, {_id:7245, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"UNKNOWN", truncate:"", description:"The phrase \"In a mystical experience\" sets the context for the following description of the pineal gland.<SEP>The phrase \"In a mystical experience\" introduces the context of the mystical experience.", created_at:1779661823, source_id:"chunk-2513ead52ad2bbf56e47a3233d1a61cb", entity_id:"In a mystical experience"}}, {_id:7246, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"UNKNOWN", truncate:"", description:"The concept of \"Pineal gland activation\" is central to the mystical experience described.", created_at:1779661823, source_id:"chunk-2513ead52ad2bbf56e47a3233d1a61cb", entity_id:"Pineal gland activation"}}, {_id:7247, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"UNKNOWN", truncate:"", description:"The concept applies to the AI's reliance on accurate input for proper output.", created_at:1779661825, source_id:"chunk-2208b834de2276647fea09e4bf25b2bd", entity_id:"AI prompt"}}, {_id:7248, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"UNKNOWN", truncate:"", description:"Proposes correcting misheard words but finds none present in the text.", created_at:1779661825, source_id:"chunk-2208b834de2276647fea09e4bf25b2bd", entity_id:"misheard words"}}, {_id:7249, properties:{file_path:"YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"UNKNOWN", truncate:"", description:"Sri Preethaji is cited as an example of a misheard word in the text, though absent in the target text.", created_at:1779661825, source_id:"chunk-2208b834de2276647fea09e4bf25b2bd", entity_id:"misheard words example"}}, {_id:7250, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"method", truncate:"", description:"Grammatical analysis involves evaluating sentence structure and punctuation rules for correctness.", created_at:1779661853, source_id:"chunk-b787fee503789ccf5420cfc0f4003e6b", entity_id:"Grammatical Analysis"}}, {_id:7252, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The natural rhythm and interconnectedness of existence observed through awareness.", created_at:1779661910, source_id:"chunk-8570f0aea49283824eb9980842a005e9", entity_id:"Flow of Life"}}, {_id:7254, properties:{file_path:"unknown_source<SEP>YouTube Video: vch9C_hNjGs (URL: https://www.youtube.com/watch?v=vch9C_hNjGs)", entity_type:"concept", truncate:"", description:"Compulsive desires or attachments that drive self-centered behavior.<SEP>Emotional obsessions are compulsive tendencies to pursue or avoid things, described as undercurrents that consciousness transcends.", created_at:1779662710, source_id:"chunk-8570f0aea49283824eb9980842a005e9<SEP>chunk-c9bb5b4ae7e13a7674f385925b990906", entity_id:"Emotional Obsessions"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:7255, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A state of unconditional joy and existence beyond ego or limitations.", created_at:1779661910, source_id:"chunk-8570f0aea49283824eb9980842a005e9", entity_id:"Pure Bliss of Being"}}, {_id:7256, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Consciousness that perceives the unity of all life without egoic limitations.", created_at:1779661910, source_id:"chunk-8570f0aea49283824eb9980842a005e9", entity_id:"State of Awareness"}}, {_id:7257, properties:{file_path:"unknown_source<SEP>YouTube Video: vch9C_hNjGs (URL: https://www.youtube.com/watch?v=vch9C_hNjGs)", entity_type:"concept", truncate:"", description:"The understanding that all existence is interconnected and indivisible.<SEP>The realization of interconnectedness among all life, dissolving boundaries between self and the universe.", created_at:1779662710, source_id:"chunk-8570f0aea49283824eb9980842a005e9<SEP>chunk-c9bb5b4ae7e13a7674f385925b990906", entity_id:"Oneness of All Life"}}, {_id:7258, properties:{file_path:"unknown_source<SEP>YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"event", truncate:"", description:"Corona refers to the COVID-19 pandemic, discussed in the context of fear and societal impact.<SEP>Corona refers to COVID-19 virus in the context of pandemic-related freedom discussions.<SEP>Colloquial reference to the coronavirus pandemic and its impacts.<SEP>Corona refers to the COVID-19 pandemic, which has influenced societal dynamics and privacy concerns.", created_at:1779662211, source_id:"chunk-b32e50c1e5924b6f3ca08fb982fe71de<SEP>chunk-ecff7e1995c8cfd62a765753318d7dab<SEP>chunk-f7a7b6ec5216cd073aa9baeaf426fc77<SEP>chunk-8d1735e497b4fb0d684267020bb40bf9", entity_id:"Corona"}}, {_id:7260, properties:{file_path:"unknown_source<SEP>YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"artifact", truncate:"", description:"Smartphones are discussed as tools enabling constant surveillance and monitoring through technology.<SEP>Smartphones are devices that can access cameras and microphones, enabling surveillance capabilities.<SEP>Smartphone is a technological device highlighted for its role in enabling constant monitoring and data collection, impacting privacy.", created_at:1779662211, source_id:"chunk-ecff7e1995c8cfd62a765753318d7dab<SEP>chunk-f7a7b6ec5216cd073aa9baeaf426fc77<SEP>chunk-8d1735e497b4fb0d684267020bb40bf9", entity_id:"Smartphone"}}, {_id:7261, properties:{file_path:"unknown_source<SEP>YouTube Video: vch9C_hNjGs (URL: https://www.youtube.com/watch?v=vch9C_hNjGs)", entity_type:"concept", truncate:"", description:"The universal consciousness transcending individual existence.<SEP>The cosmic self represents the universal, all-encompassing identity (Aham Brahman) that transcends the limited individual self.", created_at:1779662710, source_id:"chunk-8570f0aea49283824eb9980842a005e9<SEP>chunk-c9bb5b4ae7e13a7674f385925b990906", entity_id:"Cosmic Self"}}, {_id:7263, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Motivation rooted in personal desire rather than universal purpose.", created_at:1779661911, source_id:"chunk-8570f0aea49283824eb9980842a005e9", entity_id:"Self-Fulfillment"}}, {_id:7264, properties:{file_path:"unknown_source", entity_type:"artifact", truncate:"", description:"Cameras are components in devices that can be remotely activated to capture visual data.", created_at:1779661911, source_id:"chunk-ecff7e1995c8cfd62a765753318d7dab", entity_id:"Cameras"}}, {_id:7266, properties:{file_path:"unknown_source<SEP>YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"concept", truncate:"", created_at:1779662211, description:"Privacy is highlighted as a contested concept in the digital age, with concerns about surveillance and data monitoring.<SEP>Privacy refers to the right to control personal information and freedom from surveillance.<SEP>The phrase \"a privacy is getting lost\" is critiqued for grammatical inaccuracy, with \"privacy\" being the correct singular form without the article.<SEP>Corrected term from \"A privacy\" to represent the concept of privacy loss.<SEP>Privacy is a central concept discussed as a major issue and a state of being lost or eroded in the context of digital platforms.<SEP>Privacy is a central concept discussed as a major issue and a state of being lost or eroded in the context of digital platforms.<SEP>Privacy refers to the concept of personal freedom and data protection in the context of technology and surveillance.", source_id:"chunk-ecff7e1995c8cfd62a765753318d7dab<SEP>chunk-f7a7b6ec5216cd073aa9baeaf426fc77<SEP>chunk-bc8be71ca178f551ef98cf124e252632<SEP>chunk-ccf8c615204507c39f3ca144b897ce7d<SEP>chunk-f3cc07a478604197eefad4556e973256<SEP>chunk-8d1735e497b4fb0d684267020bb40bf9", entity_id:"Privacy"}}, {_id:7270, properties:{file_path:"unknown_source<SEP>YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"concept", truncate:"", description:"Refers to bodily activity and pleasures tied to human experience and freedom.<SEP>Referenced in the video as part of life's pleasures contrasted with spiritual escape.", created_at:1779662114, source_id:"chunk-ecff7e1995c8cfd62a765753318d7dab<SEP>chunk-ccf8c615204507c39f3ca144b897ce7d", entity_id:"Physical Movement"}}, {_id:7271, properties:{file_path:"unknown_source<SEP>YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"organization", truncate:"", description:"Instagram is referenced alongside Facebook as a platform impacting privacy and freedom dynamics.<SEP>Instagram is another platform mentioned where the trade-off between seeking freedom and losing privacy occurs.<SEP>Instagram is another platform mentioned where the trade-off between seeking freedom and losing privacy occurs.", created_at:1779662196, source_id:"chunk-f7a7b6ec5216cd073aa9baeaf426fc77<SEP>chunk-f3cc07a478604197eefad4556e973256", entity_id:"Instagram"}}, {_id:7273, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"\"at\" is corrected to \"of\" in the phrase \"A state of humanity's fear.\"", created_at:1779661959, source_id:"chunk-b32e50c1e5924b6f3ca08fb982fe71de", entity_id:"at"}}, {_id:7274, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Awkward phrasing corrected to more natural \"what fear is there?\" for clarity.", created_at:1779661959, source_id:"chunk-b32e50c1e5924b6f3ca08fb982fe71de", entity_id:"what a fear is?"}}, {_id:7275, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"\"Let me have Corona\" corrected to \"Let me have the Corona\" for grammatical accuracy.", created_at:1779661959, source_id:"chunk-b32e50c1e5924b6f3ca08fb982fe71de", entity_id:"Let me have Corona"}}, {_id:7276, properties:{file_path:"unknown_source<SEP>YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"concept", truncate:"", description:"\"Pyram\" is corrected to \"Prana\" based on spiritual context.<SEP>Misheard term in the video, likely intended as \"Prana\" in spiritual context.", created_at:1779662114, source_id:"chunk-b32e50c1e5924b6f3ca08fb982fe71de<SEP>chunk-ccf8c615204507c39f3ca144b897ce7d", entity_id:"Pyram"}}, {_id:7277, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"\"tent\" is corrected to \"state\" due to mishearing in the phrase \"A tent at humanity's and fear.\"", created_at:1779661959, source_id:"chunk-b32e50c1e5924b6f3ca08fb982fe71de", entity_id:"tent"}}, {_id:7278, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"\"at\" is corrected to \"of\" in the phrase \"A state of humanity's fear.\"", created_at:1779661959, source_id:"chunk-b32e50c1e5924b6f3ca08fb982fe71de", entity_id:"of"}}, {_id:7279, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"\"Let me have Corona\" corrected to \"Let me have the Corona\" for grammatical accuracy.", created_at:1779661959, source_id:"chunk-b32e50c1e5924b6f3ca08fb982fe71de", entity_id:"Let me have the Corona"}}, {_id:7280, properties:{file_path:"unknown_source", entity_type:"UNKNOWN", truncate:"", description:"Awkward phrasing corrected to more natural \"what fear is there?\" for clarity.", created_at:1779661959, source_id:"chunk-b32e50c1e5924b6f3ca08fb982fe71de", entity_id:"what fear is there?"}}, {_id:7281, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"data", truncate:"", created_at:1779662638, description:"cHAJiF2byzg is a YouTube video ID linked to the source material for text correction tasks.<SEP>cHAJiF2byzg is a YouTube video ID linked to the source material for text correction tasks.<SEP>A YouTube video discussing humanity's fight for freedom and privacy issues, with the URL https://www.youtube.com/watch?v=cHAJiF2byzg.<SEP>The unique identifier (video ID) for the YouTube video referenced in the source.", source_id:"chunk-c3a39db7f9720a122a0c7c42879a22e6<SEP>chunk-bd7c38352cd44635d7efe811b1c3eb50<SEP>chunk-a532d15b45a354bea11d6dc57df813b2", entity_id:"cHAJiF2byzg"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:7282, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"content", truncate:"", description:"Original erroneous sentence requiring correction.<SEP>Original erroneous sentence requiring correction.", created_at:1779662014, source_id:"chunk-c3a39db7f9720a122a0c7c42879a22e6", entity_id:"A Tent at Humanity's and Fear"}}, {_id:7283, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"content", truncate:"", description:"Corrected sentence demonstrating proper transcription.<SEP>Corrected sentence demonstrating proper transcription.", created_at:1779662014, source_id:"chunk-c3a39db7f9720a122a0c7c42879a22e6", entity_id:"A State from Which We Need to Find Freedom"}}, {_id:7284, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"concept", truncate:"", description:"The phrase \"humanity is\" is proposed as the correct form in the context of freedom from oppression.", created_at:1779662068, source_id:"chunk-bc8be71ca178f551ef98cf124e252632", entity_id:"Humanity Is"}}, {_id:7285, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"concept", truncate:"", description:"The word \"continent\" is identified as a contextual error in the original text.", created_at:1779662068, source_id:"chunk-bc8be71ca178f551ef98cf124e252632", entity_id:"Continent"}}, {_id:7286, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"concept", truncate:"", description:"The phrase \"humanity's\" is discussed as a potential grammatical error in the context of freedom.", created_at:1779662068, source_id:"chunk-bc8be71ca178f551ef98cf124e252632", entity_id:"Humanity's"}}, {_id:7287, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"UNKNOWN", truncate:"", description:"\"A privacy is getting lost\" is corrected to \"privacy is getting lost\" due to grammatical inaccuracy.", created_at:1779662088, source_id:"chunk-bc8be71ca178f551ef98cf124e252632", entity_id:"A Privacy"}}, {_id:7288, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"UNKNOWN", truncate:"", description:"Krishnaji is mentioned in the context of vaccination and monitoring, raising concerns about fear and control.", created_at:1779662088, source_id:"chunk-bc8be71ca178f551ef98cf124e252632", entity_id:"vaccination, monitoring"}}, {_id:7289, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"concept", truncate:"", description:"Discussed theme about perceived lack of freedom and societal excuses.", created_at:1779662114, source_id:"chunk-ccf8c615204507c39f3ca144b897ce7d", entity_id:"Human Freedom"}}, {_id:7290, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"artifact", truncate:"", description:"YouTube video titled \"cHAJiF2byzg\" hosted on YouTube with the URL https://www.youtube.com/watch?v=cHAJiF2byzg.<SEP>A YouTube video with the URL https://www.youtube.com/watch?v=cHAJiF2byzg, discussing concepts of freedom, fear, and corrections to misheard quotes.<SEP>YouTube Video titled \"cHAJiF2byzg\" discussing fear and coronavirus.<SEP>YouTube Video: cHAJiF2byzg is a video hosted on YouTube, referenced by the URL https://www.youtube.com/watch?v=cHAJiF2byzg.", created_at:1779662692, source_id:"chunk-ccf8c615204507c39f3ca144b897ce7d<SEP>chunk-056af6c4761b77d7ca60b82d77a7fd2e<SEP>chunk-e264e9dc0aed2215851420aa0c3de19d<SEP>chunk-6a2dcd2eb95d21b4ee80f566c015729b", entity_id:"YouTube Video: cHAJiF2byzg"}}, {_id:7291, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"event", truncate:"", description:"Public demonstrations mentioned as expressions of the desire for freedom and escape from confinement.", created_at:1779662119, source_id:"chunk-e3a9d3b4e75a6781f9fb7a4d35559a14", entity_id:"Marches"}}, {_id:7293, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"UNKNOWN", truncate:"", description:"The video discusses freedom as an internal state rather than physical escape.", created_at:1779662157, source_id:"chunk-056af6c4761b77d7ca60b82d77a7fd2e", entity_id:"It's more of an inner state."}}, {_id:7294, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"UNKNOWN", truncate:"", description:"The video contrasts escape with true freedom, correcting the phrase \"Keep running out\".", created_at:1779662157, source_id:"chunk-056af6c4761b77d7ca60b82d77a7fd2e", entity_id:"Keep running out. That's not freedom, that's just escape."}}, {_id:7295, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"UNKNOWN", truncate:"", description:"The video discusses how actions during a pandemic can lead to increased fear.", created_at:1779662157, source_id:"chunk-056af6c4761b77d7ca60b82d77a7fd2e", entity_id:"But unfortunately, if you do that now and you get coronavirus, you will move to double or triple fear."}}, {_id:7296, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)<SEP>YouTube Video: pPHQMD3w9-s (URL: https://www.youtube.com/watch?v=pPHQMD3w9-s)", entity_type:"concept", truncate:"", description:"Coronavirus is a virus causing fear and health concerns.<SEP>Coronavirus is a topic discussed in the video, leading to punctuation errors such as comma", created_at:1779664212, source_id:"chunk-e264e9dc0aed2215851420aa0c3de19d<SEP>chunk-f56196cf5558ef3761957d9648db2990", entity_id:"coronavirus"}}, {_id:7297, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"concept", truncate:"", description:"Privacy is highlighted as a significant issue, with concerns about its erosion and the problems it causes.", created_at:1779662176, source_id:"chunk-bd7c38352cd44635d7efe811b1c3eb50", entity_id:"privacy"}}, {_id:7298, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"concept", truncate:"", description:"Surveillance refers to the continuous monitoring and tracking of individuals' activities, often without their explicit consent, raising privacy concerns.", created_at:1779662211, source_id:"chunk-8d1735e497b4fb0d684267020bb40bf9", entity_id:"Surveillance"}}, {_id:7299, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"UNKNOWN", truncate:"", description:"Smartphones are highlighted as tools that enable constant monitoring and data collection, impacting privacy.", created_at:1779662235, source_id:"chunk-8d1735e497b4fb0d684267020bb40bf9", entity_id:"monitoring"}}, {_id:7300, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"UNKNOWN", truncate:"", description:"New York is referenced in the context of surveillance and tracking practices affecting personal privacy.", created_at:1779662235, source_id:"chunk-8d1735e497b4fb0d684267020bb40bf9", entity_id:"surveillance"}}, {_id:7301, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"data", truncate:"", description:"The URL linking to the YouTube video containing the discussed content.", created_at:1779662638, source_id:"chunk-a532d15b45a354bea11d6dc57df813b2", entity_id:"https://www.youtube.com/watch?v=cHAJiF2byzg"}}, {_id:7302, properties:{file_path:"YouTube Video: cHAJiF2byzg (URL: https://www.youtube.com/watch?v=cHAJiF2byzg)", entity_type:"concept", truncate:"", description:"A philosophical or conceptual reference to the condition or nature of humanity, discussed in the video's corrected text.", created_at:1779662638, source_id:"chunk-a532d15b45a354bea11d6dc57df813b2", entity_id:"State of Humanity"}}] AS row
