UNWIND [{start: {_id:1782}, end: {_id:6446}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"education,guidance,leadership", weight:2.0, description:"Speaker leads people through deep spiritual journeys, emphasizing enlightenment and compassion.<SEP>Speaker leads participants through spiritual journeys to promote joy and self-awareness.", created_at:1779561382, source_id:"chunk-9645fe2118f4e6de1b034351a972ae59<SEP>chunk-5c58087a1e3ed399c95e3cd99bdd898b"}}, {start: {_id:4576}, end: {_id:1782}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"exploration,travel", truncate:"", weight:1.0, description:"Speaker travels to 25-30 countries annually, engaging with diverse cultures and perspectives.", created_at:1779561379, source_id:"chunk-9645fe2118f4e6de1b034351a972ae59"}}, {start: {_id:6443}, end: {_id:1782}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"self-perception,topic discussion", weight:1.0, description:"Speaker addresses challenges and societal pressures related to body image in their teachings.", created_at:1779561382, source_id:"chunk-5c58087a1e3ed399c95e3cd99bdd898b"}}, {start: {_id:6443}, end: {_id:6445}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"metaphor,self-acceptance", truncate:"", weight:1.0, description:"Lions symbolize natural self-acceptance, contrasting human dissatisfaction with appearance.", created_at:1779561382, source_id:"chunk-5c58087a1e3ed399c95e3cd99bdd898b"}}, {start: {_id:6443}, end: {_id:6444}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"metaphor,self-acceptance", truncate:"", weight:1.0, description:"Orca whales exemplify the absence of self-criticism seen in non-human species.", created_at:1779561382, source_id:"chunk-5c58087a1e3ed399c95e3cd99bdd898b"}}, {start: {_id:6447}, end: {_id:1782}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"global outreach,travel", truncate:"", weight:1.0, description:"The speaker's annual travel to 25-30 countries supports their international spiritual guidance and body image advocacy.", created_at:1779561382, source_id:"chunk-5c58087a1e3ed399c95e3cd99bdd898b"}}, {start: {_id:6448}, end: {_id:1782}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"critique,societal pressure", weight:1.0, description:"The speaker addresses the harmful effects of incessant judgment on body image and self-perception.", created_at:1779561383, source_id:"chunk-5c58087a1e3ed399c95e3cd99bdd898b"}}, {start: {_id:6449}, end: {_id:1782}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"awareness,self-acceptance", truncate:"", weight:1.0, description:"The speaker highlights the futility of body image obsessions through natural world analogies.", created_at:1779561383, source_id:"chunk-5c58087a1e3ed399c95e3cd99bdd898b"}}, {start: {_id:6454}, end: {_id:1607}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"cultural heritage,historical practices", weight:1.0, description:"The Indus Valley Civilization exemplifies ancient beauty practices through jewelry and grooming rituals.", created_at:1779561433, source_id:"chunk-9f1528e052c091ff9a2052d88bff2e72"}}, {start: {_id:6455}, end: {_id:1185}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"intellectual focus,preoccupation", weight:1.0, description:"Einstein's youthful preoccupation with his hair contrasts with his later scientific achievements, highlighting how obsession can distract from priorities.", created_at:1779561433, source_id:"chunk-9f1528e052c091ff9a2052d88bff2e72"}}, {start: {_id:6453}, end: {_id:1283}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"body image,insecurity", truncate:"", weight:1.0, description:"Cosmetic surgeries are often performed to address insecurities about body image but may perpetuate cycles of dissatisfaction.", created_at:1779561433, source_id:"chunk-9f1528e052c091ff9a2052d88bff2e72"}}, {start: {_id:6454}, end: {_id:6457}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"ancient traditions,universal tendency", weight:1.0, description:"Appreciating beauty is framed as an innate human trait, evident in ancient civilizations like the Indus Valley.", created_at:1779561434, source_id:"chunk-9f1528e052c091ff9a2052d88bff2e72"}}, {start: {_id:6453}, end: {_id:1185}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"addiction,beautification", truncate:"", weight:1.0, description:"Cosmetic surgeries can evolve into obsessive behavior, where individuals struggle to stop despite negative consequences.", created_at:1779561434, source_id:"chunk-9f1528e052c091ff9a2052d88bff2e72"}}, {start: {_id:6451}, end: {_id:178}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"beauty standards,social norms", weight:1.0, description:"Society perpetuates the concept of an ideal body through cultural norms and media influence.", created_at:1779561445, source_id:"chunk-641507fc1ac65e5fc2ff612c296612f6"}}, {start: {_id:1024}, end: {_id:6451}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"aesthetic values,fashion trends", weight:1.0, description:"Cultural shifts dictate changing definitions of the ideal body based on seasonal preferences.", created_at:1779561445, source_id:"chunk-641507fc1ac65e5fc2ff612c296612f6"}}, {start: {_id:6443}, end: {_id:6451}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"criticism,self-perception", truncate:"", weight:1.0, description:"Obsession with the ideal body leads to constant self-criticism and dissatisfaction with one's appearance.", created_at:1779561445, source_id:"chunk-641507fc1ac65e5fc2ff612c296612f6"}}, {start: {_id:6451}, end: {_id:1283}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"comparison,self-worth", truncate:"", weight:1.0, description:"Pursuit of the ideal body fosters insecurity due to perceived inadequacy compared to societal standards.", created_at:1779561445, source_id:"chunk-641507fc1ac65e5fc2ff612c296612f6"}}, {start: {_id:6443}, end: {_id:1283}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"projection,self-judgment", truncate:"", weight:1.0, description:"Insecurity manifests as negative self-assessment and fear of being judged by others.", created_at:1779561445, source_id:"chunk-641507fc1ac65e5fc2ff612c296612f6"}}, {start: {_id:6452}, end: {_id:6451}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"influence,trends", weight:1.0, description:"Fashion Houses' seasonal preferences dictate the evolving standards of the ideal body.", created_at:1779561445, source_id:"chunk-641507fc1ac65e5fc2ff612c296612f6"}}, {start: {_id:6461}, end: {_id:6462}, properties:{file_path:"YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", truncate:"", keywords:"cultural norms,historical practice", weight:1.0, description:"The Lotus Foot practice occurred during the 10th-19th century in China as part of beauty standards.", created_at:1779561539, source_id:"chunk-8809e9b9df76b16743d670ee1736d8d9"}}] AS row
