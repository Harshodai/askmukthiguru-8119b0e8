UNWIND [{start: {_id:3882}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=JRlaAip4kmk)", keywords:"exercise,methodology", truncate:"", weight:1.0, description:"Breathing exercises are instructed as part of the meditation process to enhance peace.", created_at:1779243182, source_id:"chunk-ef821e71b2fbcaa55b79671c314f5fac"}}, {start: {_id:3884}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=JRlaAip4kmk)", keywords:"content,repetition", truncate:"", weight:1.0, description:"The YouTube Video features the repeated phrase", created_at:1779243229, source_id:"chunk-e5c2ff89d512e2359c660a031e299399"}}, {start: {_id:3886}, end: {_id:3893}, properties:{file_path:"unknown_source", keywords:"cosmology,mythology", truncate:"", weight:1.0, description:"Devas and Asuras are integral to Vedic cosmology.", created_at:1779243856, source_id:"chunk-2e434306df5b4f2083250fff41e8b701"}}, {start: {_id:3892}, end: {_id:3894}, properties:{file_path:"unknown_source", keywords:"authorship,spiritual teachings", truncate:"", weight:1.0, description:"Vyasa authored the Brahma Sutra and Sarvam Kalvidam Brahma.", created_at:1779243856, source_id:"chunk-2e434306df5b4f2083250fff41e8b701"}}, {start: {_id:3888}, end: {_id:3889}, properties:{file_path:"unknown_source", keywords:"event participation,honor", truncate:"", weight:1.0, description:"Guru Purnima is celebrated in honor of sage Vyasa.", created_at:1779243856, source_id:"chunk-6c96fcf9dc4b3dd6ae02c9c745b85e2a"}}, {start: {_id:3887}, end: {_id:3889}, properties:{file_path:"unknown_source", keywords:"compilation,teachings", truncate:"", weight:1.0, description:"Sage Vyasa compiled the Brahma Sutras.", created_at:1779243856, source_id:"chunk-6c96fcf9dc4b3dd6ae02c9c745b85e2a"}}, {start: {_id:3888}, end: {_id:3894}, properties:{file_path:"unknown_source", keywords:"celebration,reverence", truncate:"", weight:1.0, description:"Guru Purnima is celebrated in honor of Vyasa's teachings.", created_at:1779243856, source_id:"chunk-2e434306df5b4f2083250fff41e8b701"}}, {start: {_id:3887}, end: {_id:3891}, properties:{file_path:"unknown_source", keywords:"essence,key phrase", truncate:"", weight:1.0, description:"Sarvam Kalvidam Brahma is a key phrase related to the Brahma Sutras.", created_at:1779243856, source_id:"chunk-6c96fcf9dc4b3dd6ae02c9c745b85e2a"}}, {start: {_id:1024}, end: {_id:2431}, properties:{file_path:"unknown_source", keywords:"belief,happiness pursuit", truncate:"", weight:1.0, description:"The culture believes altering the external environment leads to happiness.", created_at:1779244249, source_id:"chunk-cdbfc6e200f4cd4487961cefed0a0954"}}, {start: {_id:179}, end: {_id:299}, properties:{file_path:"unknown_source", keywords:"prerequisite", truncate:"", weight:1.0, description:"Love requires inner capability to perceive and nurture.", created_at:1779244249, source_id:"chunk-cdbfc6e200f4cd4487961cefed0a0954"}}, {start: {_id:2604}, end: {_id:301}, properties:{file_path:"unknown_source", keywords:"misguided pursuit", truncate:"", weight:1.0, description:"The civilization associates happiness with external achievements rather than inner states.", created_at:1779244249, source_id:"chunk-cdbfc6e200f4cd4487961cefed0a0954"}}, {start: {_id:2604}, end: {_id:3902}, properties:{file_path:"unknown_source", keywords:"transformative goal", truncate:"", weight:1.0, description:"Prioritizing inner beauty creates conflict-free, joyful communities.", created_at:1779244249, source_id:"chunk-cdbfc6e200f4cd4487961cefed0a0954"}}, {start: {_id:3905}, end: {_id:299}, properties:{file_path:"unknown_source", keywords:"conflict,obstacle", truncate:"", weight:1.0, description:"Craving for attention or importance obstructs the ability to perceive and nurture love.", created_at:1779244249, source_id:"chunk-cdbfc6e200f4cd4487961cefed0a0954"}}, {start: {_id:179}, end: {_id:3904}, properties:{file_path:"unknown_source", keywords:"component,conflict", truncate:"", weight:1.0, description:"The inner state includes a sense of lack, which leads to craving and conflict.", created_at:1779244249, source_id:"chunk-cdbfc6e200f4cd4487961cefed0a0954"}}, {start: {_id:3903}, end: {_id:301}, properties:{file_path:"unknown_source", keywords:"false correlation", truncate:"", weight:1.0, description:"The culture falsely links achievement to happiness, ignoring inner fulfillment.", created_at:1779244249, source_id:"chunk-cdbfc6e200f4cd4487961cefed0a0954"}}, {start: {_id:3906}, end: {_id:3909}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Gt3o8lcbcII)", truncate:"", keywords:"core belief,happiness pursuit", weight:1.0, description:"The culture's foundational belief centers on the idea that achieving goals leads to happiness.", created_at:1779244331, source_id:"chunk-4523f9fd37288caff920e368b2232bf0"}}, {start: {_id:3907}, end: {_id:3908}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Gt3o8lcbcII)", truncate:"", keywords:"consequence,emotional impact", weight:1.0, description:"The process of striving for achievement inherently causes sadness and suffering as a byproduct.", created_at:1779244331, source_id:"chunk-4523f9fd37288caff920e368b2232bf0"}}, {start: {_id:3909}, end: {_id:3908}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Gt3o8lcbcII)", truncate:"", keywords:"cultural practice,goal orientation", weight:1.0, description:"The culture emphasizes striving hard toward goals as a cultural norm and practice.", created_at:1779244332, source_id:"chunk-4523f9fd37288caff920e368b2232bf0"}}, {start: {_id:3914}, end: {_id:3913}, properties:{file_path:"unknown_source", keywords:"personal growth,self-discovery", truncate:"", weight:1.0, description:"Seclusion and solitude create an environment conducive to self-reflection and reinventing oneself.", created_at:1779245311, source_id:"chunk-f925857f8965034d2828680e1a46c470"}}, {start: {_id:1335}, end: {_id:2007}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=cI7D2aO34yw)", keywords:"chose seclusion,inspiration,method", truncate:"", weight:2.0, description:"Buddha chose seclusion.<SEP>Buddha used seclusion as a deliberate method for spiritual enlightenment.", created_at:1779245499, source_id:"chunk-550e13cc834f4b3fe1d51617d1c42fa2<SEP>chunk-89ad31026dfac5cb5747676ec6d57a32"}}] AS row
