UNWIND [{start: {_id:2391}, end: {_id:4559}, properties:{file_path:"unknown_source", keywords:"freedom,spiritual goal", truncate:"", weight:1.0, description:"Liberation and enlightenment are synonymous, achieved by overcoming internal and external dependencies.", created_at:1779556413, source_id:"chunk-5c1ed637dca2d0d131d85c8ff4dd33cb"}}, {start: {_id:1617}, end: {_id:1594}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"contribution,influence,path to enlightenment,practice", weight:4.0, description:"Mind contributes to sadhana, which is part of the path to enlightenment.<SEP>Mind is a key factor in sadhana, influencing the path to enlightenment.<SEP>Mind contributes to sadhana, which is part of the path to enlightenment.<SEP>Mind is a key factor in sadhana, influencing the path to enlightenment.", created_at:1779556865, source_id:"chunk-d887f374fce140e42345a26a703cd352"}}, {start: {_id:738}, end: {_id:1594}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"contribution,influence,path to enlightenment,practice", weight:4.0, description:"Body contributes to sadhana, which is part of the path to enlightenment.<SEP>Body is a key factor in sadhana, influencing the path to enlightenment.<SEP>Body contributes to sadhana, which is part of the path to enlightenment.<SEP>Body is a key factor in sadhana, influencing the path to enlightenment.", created_at:1779556865, source_id:"chunk-d887f374fce140e42345a26a703cd352"}}, {start: {_id:2391}, end: {_id:1617}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"attainment,inner stillness", weight:2.0, description:"Mind is associated with inner stillness, which is a component of enlightenment.<SEP>Mind is associated with inner stillness, which is a component of enlightenment.", created_at:1779556865, source_id:"chunk-d887f374fce140e42345a26a703cd352"}}, {start: {_id:738}, end: {_id:1617}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=o_eg6YTifRE)", truncate:"", keywords:"influence,interconnection,meditation focus,mind-body connection", weight:3.0, description:"The mind and body are interconnected, influencing each other during practice.<SEP>The mind and body are interconnected, influencing each other during practice.<SEP>The meditation process emphasizes the connection between the mind and body as part of the stages.", created_at:1779733269, source_id:"chunk-d887f374fce140e42345a26a703cd352<SEP>chunk-cea1285a91ee1aefd87d1e411abeb97b"}}, {start: {_id:2391}, end: {_id:1594}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"goal,path to enlightenment", weight:2.0, description:"Sadhana is the path to enlightenment.<SEP>Sadhana is the path to enlightenment.", created_at:1779556866, source_id:"chunk-d887f374fce140e42345a26a703cd352"}}, {start: {_id:1615}, end: {_id:1594}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"breath regulation,practice", weight:2.0, description:"Breath regulation is a method used in sadhana.<SEP>Breath regulation is a method used in sadhana.", created_at:1779556889, source_id:"chunk-d887f374fce140e42345a26a703cd352"}}, {start: {_id:6242}, end: {_id:1654}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"energy intake,mystical concept", weight:1.0, description:"Prana enters the body during inhalation, described as a life force.", created_at:1779556889, source_id:"chunk-e15affa7e924b9530baaf1cc0152bad4"}}, {start: {_id:6242}, end: {_id:6241}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"breathing technique,controlled practice", weight:1.0, description:"Pranayama is a breathing technique involving controlled inhalation and exhalation to influence the mind and consciousness.", created_at:1779556889, source_id:"chunk-e15affa7e924b9530baaf1cc0152bad4"}}, {start: {_id:6243}, end: {_id:1654}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"energy release,mystical concept", weight:1.0, description:"Prana exits the body during exhalation, releasing energy.", created_at:1779556889, source_id:"chunk-e15affa7e924b9530baaf1cc0152bad4"}}, {start: {_id:1617}, end: {_id:1654}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"consciousness expansion,mental impact", weight:1.0, description:"Holding Prana impacts the mind and consciousness, leading to calmness and expansion.", created_at:1779556889, source_id:"chunk-e15affa7e924b9530baaf1cc0152bad4"}}, {start: {_id:6243}, end: {_id:6241}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"breathing technique,controlled practice", weight:1.0, description:"Pranayama is a breathing technique involving controlled inhalation and exhalation to influence the mind and consciousness.", created_at:1779556889, source_id:"chunk-e15affa7e924b9530baaf1cc0152bad4"}}, {start: {_id:6243}, end: {_id:6242}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"breathing ratio,practice guideline", weight:1.0, description:"The text specifies that exhalation should be twice as long as inhalation.", created_at:1779556889, source_id:"chunk-e15affa7e924b9530baaf1cc0152bad4"}}, {start: {_id:1615}, end: {_id:6245}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"biological process,gas exchange", weight:1.0, description:"Breath involves the exchange of oxygen and carbon dioxide as part of the respiratory process.", created_at:1779556892, source_id:"chunk-e15affa7e924b9530baaf1cc0152bad4"}}, {start: {_id:1615}, end: {_id:6244}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"biological process,gas exchange", weight:1.0, description:"Breath involves the exchange of oxygen and carbon dioxide as part of the respiratory process.", created_at:1779556892, source_id:"chunk-e15affa7e924b9530baaf1cc0152bad4"}}, {start: {_id:2753}, end: {_id:5614}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"emotional motivation,universal pursuit", weight:1.0, description:"Romantic love is equated with pleasure, driving humanity's persistent pursuit of it across history.", created_at:1779556959, source_id:"chunk-3198061b7d9cb7c891cdfe291494700c"}}, {start: {_id:6236}, end: {_id:5341}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"neurochemical role,relationship dynamics", weight:1.0, description:"Dopamine subsidence leads to judgments and fault-finding in relationships.", created_at:1779556999, source_id:"chunk-9a7c58d7cc886bef4c4d232cf5fffc42"}}, {start: {_id:6251}, end: {_id:6250}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"behavioral response,relationship pattern", weight:1.0, description:"The hunger drives individuals to seek new partners to recreate euphoric highs.", created_at:1779556999, source_id:"chunk-9a7c58d7cc886bef4c4d232cf5fffc42"}}, {start: {_id:6252}, end: {_id:5267}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"emotional balance,relationship quality", weight:1.0, description:"True love is portrayed as mutually beneficial, unlike dopamine-driven hunger.", created_at:1779556999, source_id:"chunk-9a7c58d7cc886bef4c4d232cf5fffc42"}}, {start: {_id:5341}, end: {_id:6248}, properties:{file_path:"YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", truncate:"", keywords:"cognitive process,emotional transition", weight:1.0, description:"Judgments enter the mind-brain complex as euphoric love fades.", created_at:1779556999, source_id:"chunk-9a7c58d7cc886bef4c4d232cf5fffc42"}}] AS row
