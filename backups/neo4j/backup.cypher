UNWIND [{start: {_id:360}, end: {_id:334}, properties:{file_path:"unknown_source", truncate:"", keywords:"emotional paralysis,psychological struggle", weight:1.0, description:"Self-imposed claustrophobia exacerbates inner conflict by trapping individuals in cycles of judgment.", created_at:1779179149, source_id:"chunk-b75e52bdeada1ddd1aebcff0a658afb0"}}, {start: {_id:104}, end: {_id:357}, properties:{file_path:"unknown_source", keywords:"equipment significance,performance", truncate:"", weight:1.0, description:"Noah Carter used carbon-fiber spikes to enhance performance, analogous to the lion cub?s struggle.", created_at:1779179149, source_id:"chunk-d4fb27ed500b1a960390eadd6d011176"}}, {start: {_id:417}, end: {_id:717}, properties:{file_path:"unknown_source", keywords:"pivotal moment,self-discovery", truncate:"", weight:1.0, description:"Jaya's retreat is the setting where she confronts her inner wounds and undergoes transformation.", created_at:1779179149, source_id:"chunk-697da9f4d9cac1cfedd243857a8b8ccc"}}, {start: {_id:2723}, end: {_id:761}, properties:{file_path:"unknown_source", keywords:"emotional distress,mental noise", truncate:"", weight:1.0, description:"Self-criticism fuels chaotic thinking, hindering clarity and emotional balance.", created_at:1779179149, source_id:"chunk-b75e52bdeada1ddd1aebcff0a658afb0"}}, {start: {_id:2724}, end: {_id:761}, properties:{file_path:"unknown_source", keywords:"antidote,emotional liberation", truncate:"", weight:1.0, description:"Cultivating joyful honesty counteracts self-criticism and restores emotional freedom.", created_at:1779179149, source_id:"chunk-b75e52bdeada1ddd1aebcff0a658afb0"}}, {start: {_id:350}, end: {_id:348}, properties:{file_path:"unknown_source", keywords:"illustration,innocence", truncate:"", weight:1.0, description:"The video exemplifies the Happy Child?s unfiltered honesty and lack of self-judgment.", created_at:1779179149, source_id:"chunk-b75e52bdeada1ddd1aebcff0a658afb0"}}, {start: {_id:2726}, end: {_id:473}, properties:{file_path:"unknown_source", keywords:"inner truth", truncate:"", weight:1.0, description:"The temple's imagery illustrates the concept of inner truth.", created_at:1779179366, source_id:"chunk-1444d9544f5a6ff9532dfcc5227c350f"}}, {start: {_id:2727}, end: {_id:1194}, properties:{file_path:"unknown_source", keywords:"emotional state", truncate:"", weight:1.0, description:"The son experienced guilt over his own actions and inability to reconcile with his father's behavior.", created_at:1779179366, source_id:"chunk-214089f71bed8468f80247a24979283e"}}, {start: {_id:504}, end: {_id:506}, properties:{file_path:"unknown_source", keywords:"self-obsession", truncate:"", weight:1.0, description:"Lee's perspective is rooted in self-obsession.", created_at:1779179366, source_id:"chunk-1444d9544f5a6ff9532dfcc5227c350f"}}, {start: {_id:2729}, end: {_id:2376}, properties:{file_path:"unknown_source", keywords:"resource", truncate:"", weight:1.0, description:"The Audio Book is a supplementary content resource that supports the practice of the Serene Mind Practice.", created_at:1779179367, source_id:"chunk-214089f71bed8468f80247a24979283e"}}, {start: {_id:17}, end: {_id:2376}, properties:{file_path:"unknown_source", keywords:"creator,guide", truncate:"", weight:1.0, description:"Krishnaji designed and teaches the Serene Mind Practice to help individuals like Diego achieve emotional healing.", created_at:1779179367, source_id:"chunk-214089f71bed8468f80247a24979283e"}}, {start: {_id:553}, end: {_id:1194}, properties:{file_path:"unknown_source", keywords:"conflict,grief,guilt,parent-child", truncate:"", weight:2.0, description:"Diego's inability to reconcile with his stepmother leads to emotional distance and his son's suicide.<SEP>Diego's emotional distance and the son's depression led to a conflict resulting in the son's suicide.", created_at:1779179367, source_id:"chunk-214089f71bed8468f80247a24979283e<SEP>chunk-107b2dccdd97eea5e4e04ec3f64a95a9"}}, {start: {_id:550}, end: {_id:473}, properties:{file_path:"unknown_source", keywords:"emotional states", truncate:"", weight:1.0, description:"Inner truth encompasses all emotional states, not just positive ones.", created_at:1779179367, source_id:"chunk-1444d9544f5a6ff9532dfcc5227c350f"}}, {start: {_id:472}, end: {_id:2730}, properties:{file_path:"unknown_source", keywords:"conflict,discrimination,insult", truncate:"", weight:2.0, description:"Gandhi refused to move to the third-class compartment after being insulted by the ticket collector, demonstrating defiance.<SEP>The ticket collector insulted Gandhi by referring to him as a \"colored man\" and a \"coolie.\"", created_at:1779179367, source_id:"chunk-dec047b5cab8e88110c88f8cc2cfcd7d"}}, {start: {_id:553}, end: {_id:2727}, properties:{file_path:"unknown_source", keywords:"emotional state", truncate:"", weight:1.0, description:"Diego's guilt over his son's death is a central emotional state that drives his journey toward healing.", created_at:1779179367, source_id:"chunk-214089f71bed8468f80247a24979283e"}}, {start: {_id:2741}, end: {_id:473}, properties:{file_path:"unknown_source", keywords:"foundation", truncate:"", weight:1.0, description:"The text states that true greatness begins with a deep relationship with inner truth.", created_at:1779179367, source_id:"chunk-dec047b5cab8e88110c88f8cc2cfcd7d"}}, {start: {_id:1406}, end: {_id:553}, properties:{file_path:"unknown_source", keywords:"mental health condition", truncate:"", weight:1.0, description:"Diego's depression is a significant part of his emotional struggle following the loss of his son.", created_at:1779179367, source_id:"chunk-214089f71bed8468f80247a24979283e"}}, {start: {_id:1406}, end: {_id:1194}, properties:{file_path:"unknown_source", keywords:"mental health condition", truncate:"", weight:1.0, description:"The son's depression was a primary factor in his decision to end his life.", created_at:1779179368, source_id:"chunk-214089f71bed8468f80247a24979283e"}}, {start: {_id:553}, end: {_id:2728}, properties:{file_path:"unknown_source", keywords:"contribution,initiative,memorial,tribute", truncate:"", weight:2.0, description:"Diego plans to hold these competitions as a way to honor his son's memory and promote young talent.<SEP>Diego initiated the Talent Search Competitions as a way to honor his son and contribute to the world.", created_at:1779183983, source_id:"chunk-214089f71bed8468f80247a24979283e<SEP>chunk-999192b96103e7c498639cfadd062722"}}, {start: {_id:473}, end: {_id:1484}, properties:{file_path:"unknown_source", keywords:"misidentification", truncate:"", weight:1.0, description:"Inner truth is often mistaken for suffering states like stress, worry, or anger.", created_at:1779179368, source_id:"chunk-dec047b5cab8e88110c88f8cc2cfcd7d"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
