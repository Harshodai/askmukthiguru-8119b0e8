UNWIND [{start: {_id:386}, end: {_id:383}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"description,professional expertise", truncate:"", weight:1.0, description:"neuropsychologist Rick Hanson describes the brain?s structure and function.", created_at:1779137489, source_id:"chunk-69fc0126e446c5384fe288452b412653"}}, {start: {_id:401}, end: {_id:397}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"brain shaping,impact", truncate:"", weight:1.0, description:"Repetitive thinking leaves enduring impacts on neural connections through habitual reinforcement.", created_at:1779137511, source_id:"chunk-78e55709d93c5c1d09f2b5a02398b24d"}}, {start: {_id:40}, end: {_id:311}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional contrast,frequency comparison", weight:1.0, description:"Stressful states are contrasted with calm states in daily experience.", created_at:1779137511, source_id:"chunk-78e55709d93c5c1d09f2b5a02398b24d"}}, {start: {_id:399}, end: {_id:404}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"brain state,gradual process", truncate:"", weight:1.0, description:"Authentic transformation requires gradual shifts toward observational awareness.", created_at:1779137511, source_id:"chunk-78e55709d93c5c1d09f2b5a02398b24d"}}, {start: {_id:403}, end: {_id:400}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"life impact,self-assessment", truncate:"", weight:1.0, description:"The baseline state determines long-term happiness or unhappiness.", created_at:1779137511, source_id:"chunk-78e55709d93c5c1d09f2b5a02398b24d"}}, {start: {_id:39}, end: {_id:311}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional contrast,rarity", truncate:"", weight:1.0, description:"Joy is presented as a beautiful but infrequent alternative to habitual stress.", created_at:1779137511, source_id:"chunk-78e55709d93c5c1d09f2b5a02398b24d"}}, {start: {_id:396}, end: {_id:401}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"brain shaping,impact", truncate:"", weight:1.0, description:"Habitual emotions leave enduring impacts on neural connections through habitual reinforcement, similar to repetitive thinking.", created_at:1779137511, source_id:"chunk-78e55709d93c5c1d09f2b5a02398b24d"}}, {start: {_id:408}, end: {_id:406}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"brain function,neural adaptation", truncate:"", weight:1.0, description:"Research shows neural circuits adapt through engagement, with unused pathways deteriorating and new ones forming rapidly.", created_at:1779137544, source_id:"chunk-4c210ebd42ece17aa2cbb5a935a96e78"}}, {start: {_id:402}, end: {_id:338}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional response,psychological impact", weight:1.0, description:"The Wounded Child triggers reactions like feeling unloved or unappreciated during moments of disappointment.", created_at:1779137545, source_id:"chunk-4c210ebd42ece17aa2cbb5a935a96e78"}}, {start: {_id:401}, end: {_id:406}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"adaptation,neural plasticity", truncate:"", weight:1.0, description:"Research demonstrates that neural connections either atrophy from disuse or rapidly form through focused engagement with positive states.", created_at:1779137545, source_id:"chunk-4c210ebd42ece17aa2cbb5a935a96e78"}}, {start: {_id:409}, end: {_id:338}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"psychological state,temporal existence", weight:1.0, description:"The Wounded Child exists in the past, clinging to childhood pain and youth experiences.", created_at:1779137545, source_id:"chunk-4c210ebd42ece17aa2cbb5a935a96e78"}}, {start: {_id:60}, end: {_id:338}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional healing,psychological analysis", weight:1.0, description:"The document discusses the Wounded Child concept and its implications for emotional healing.", created_at:1779137545, source_id:"chunk-4c210ebd42ece17aa2cbb5a935a96e78"}}, {start: {_id:405}, end: {_id:338}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional persistence,psychological manifestation", weight:1.0, description:"The Wounded Child embodies a suffering state of being that persists in consciousness despite physical maturity.", created_at:1779137545, source_id:"chunk-4c210ebd42ece17aa2cbb5a935a96e78"}}, {start: {_id:407}, end: {_id:60}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"healing principles,psychological framework", weight:1.0, description:"The document outlines how beautiful states can be cultivated through recognition and neural adaptation principles.", created_at:1779137545, source_id:"chunk-4c210ebd42ece17aa2cbb5a935a96e78"}}, {start: {_id:412}, end: {_id:338}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional triggers,regression", truncate:"", weight:1.0, description:"The wounded child resurfaces during moments of disappointment, replicating childhood emotional reactions.", created_at:1779137585, source_id:"chunk-c0e08ca8392db0f9984988041685087e"}}, {start: {_id:89}, end: {_id:82}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conflict response,emotional modeling", truncate:"", weight:1.0, description:"Witnessing the father's anger toward the mother instills a predisposition to anger in the individual's own conflicts.", created_at:1779137585, source_id:"chunk-c0e08ca8392db0f9984988041685087e"}}, {start: {_id:411}, end: {_id:338}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional patterns,psychological persistence", weight:1.0, description:"The wounded child perpetuates unpleasant inner states of being despite the passage of time.", created_at:1779137585, source_id:"chunk-c0e08ca8392db0f9984988041685087e"}}, {start: {_id:410}, end: {_id:412}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"exclusion,social comparison", truncate:"", weight:1.0, description:"Observing friends' activities on Facebook can trigger feelings of being left out, mirroring childhood experiences of neglect.", created_at:1779137585, source_id:"chunk-c0e08ca8392db0f9984988041685087e"}}, {start: {_id:195}, end: {_id:338}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"childhood trauma,emotional legacy", truncate:"", weight:1.0, description:"Parental actions (e.g., favoritism) contribute to the formation of the wounded child's psychological state.", created_at:1779137586, source_id:"chunk-c0e08ca8392db0f9984988041685087e"}}, {start: {_id:299}, end: {_id:338}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional blockage,self-protection", truncate:"", weight:1.0, description:"The wounded child closes off love as a defense mechanism to avoid further emotional hurt.", created_at:1779137586, source_id:"chunk-c0e08ca8392db0f9984988041685087e"}}] AS row
