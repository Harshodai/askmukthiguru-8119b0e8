UNWIND [{start: {_id:951}, end: {_id:1617}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"psychological origin,source", weight:1.0, description:"The video attributes comparison to hurt, establishing it as the root cause within the mind.", created_at:1779652852, source_id:"chunk-3a5d8d7606e9b8e3d7ef11bf46090954"}}, {start: {_id:6995}, end: {_id:348}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"content analysis,linguistic critique", weight:1.0, description:"The video contains and analyzes the phrase \"Fix us a day\" as a non-sequitur.", created_at:1779652852, source_id:"chunk-3a5d8d7606e9b8e3d7ef11bf46090954"}}, {start: {_id:603}, end: {_id:178}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"cultural analysis,social behavior", weight:1.0, description:"Comparison is described as a pervasive social phenomenon influencing societal behavior.", created_at:1779652862, source_id:"chunk-3a5d8d7606e9b8e3d7ef11bf46090954"}}, {start: {_id:603}, end: {_id:6995}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"contextual relevance,thematic analysis", weight:1.0, description:"The phrase is discussed in the context of societal comparison and its implications.", created_at:1779652863, source_id:"chunk-3a5d8d7606e9b8e3d7ef11bf46090954"}}, {start: {_id:603}, end: {_id:951}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"negative emotion,root cause", weight:1.0, description:"Comparison arises from past hurts that create feelings of inadequacy and inferiority.", created_at:1779652864, source_id:"chunk-e27a47feac82bbd6f6606fd0582e97d1"}}, {start: {_id:603}, end: {_id:479}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"overcoming,solution", truncate:"", weight:1.0, description:"Healing from past hurts is necessary to eliminate harmful comparisons and achieve self-acceptance.", created_at:1779652864, source_id:"chunk-e27a47feac82bbd6f6606fd0582e97d1"}}, {start: {_id:603}, end: {_id:2183}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"context,inadequacy", truncate:"", weight:1.0, description:"Students may engage in comparison due to perceived academic shortcomings or societal expectations.", created_at:1779652864, source_id:"chunk-e27a47feac82bbd6f6606fd0582e97d1"}}, {start: {_id:603}, end: {_id:813}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"context,inadequacy", truncate:"", weight:1.0, description:"Doctors might compare themselves to peers or ideals, leading to self-doubt in professional competence.", created_at:1779652864, source_id:"chunk-e27a47feac82bbd6f6606fd0582e97d1"}}, {start: {_id:603}, end: {_id:4518}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"context,inadequacy", truncate:"", weight:1.0, description:"Husbands may compare themselves to societal or relational standards, causing dissatisfaction.", created_at:1779652865, source_id:"chunk-e27a47feac82bbd6f6606fd0582e97d1"}}, {start: {_id:603}, end: {_id:5518}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"context,inadequacy", truncate:"", weight:1.0, description:"Wives might compare themselves to others in domestic or social roles, fostering self-criticism.", created_at:1779652865, source_id:"chunk-e27a47feac82bbd6f6606fd0582e97d1"}}, {start: {_id:355}, end: {_id:603}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", keywords:"context,inadequacy", truncate:"", weight:1.0, description:"Children may compare themselves to peers or parental expectations, impacting self-esteem.", created_at:1779652865, source_id:"chunk-e27a47feac82bbd6f6606fd0582e97d1"}}, {start: {_id:6998}, end: {_id:6999}, properties:{file_path:"unknown_source", keywords:"inflammation", truncate:"", weight:1.0, description:"A severe inflammatory response in the body, often compared to a storm, that can be triggered by prolonged emotional distress.", created_at:1779652908, source_id:"chunk-5aeea4b62735a07173124f3878e34dac"}}, {start: {_id:6999}, end: {_id:6206}, properties:{file_path:"unknown_source", keywords:"immune system", truncate:"", weight:1.0, description:"Chemicals released by the body during stress that can disrupt normal cellular function and communication.", created_at:1779652908, source_id:"chunk-5aeea4b62735a07173124f3878e34dac"}}, {start: {_id:6997}, end: {_id:6999}, properties:{file_path:"unknown_source", keywords:"inflammation", truncate:"", weight:1.0, description:"The body's defense mechanism against foreign invaders, which can be negatively impacted by chronic stress and inflammation.", created_at:1779652908, source_id:"chunk-5aeea4b62735a07173124f3878e34dac"}}, {start: {_id:6208}, end: {_id:6999}, properties:{file_path:"unknown_source", keywords:"immune system", truncate:"", weight:2.0, description:"The chemical processes within the body, which are altered by prolonged emotional states like fear and anger.", created_at:1779652908, source_id:"chunk-5aeea4b62735a07173124f3878e34dac"}}, {start: {_id:3898}, end: {_id:784}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"biological interaction,immune response", weight:2.0, description:"The human body's immune system responds to bacteria by releasing defense proteins.<SEP>The human body's immune system responds to bacteria by releasing defense proteins.", created_at:1779652996, source_id:"chunk-3da16f4292642f8022ca187ac2cb1ede"}}, {start: {_id:784}, end: {_id:4578}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"biological interaction,immune response", weight:2.0, description:"The human body's immune system responds to viruses by releasing defense proteins.<SEP>The human body's immune system responds to viruses by releasing defense proteins.", created_at:1779652996, source_id:"chunk-3da16f4292642f8022ca187ac2cb1ede"}}, {start: {_id:6996}, end: {_id:784}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"biological interaction,defense", weight:2.0, description:"The human body releases cytokines to defend against bacteria and viruses.<SEP>The human body releases cytokines to defend against bacteria and viruses.", created_at:1779652996, source_id:"chunk-3da16f4292642f8022ca187ac2cb1ede"}}, {start: {_id:784}, end: {_id:6997}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"biological interaction,defense", weight:2.0, description:"The human body's immune system is responsible for destroying invading organisms.<SEP>The human body's immune system is responsible for destroying invading organisms.", created_at:1779652996, source_id:"chunk-3da16f4292642f8022ca187ac2cb1ede"}}, {start: {_id:784}, end: {_id:6201}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"biological interaction,defense", weight:2.0, description:"The human body's immune system shows inflammation as a sign of fighting pathogens.<SEP>The human body's immune system shows inflammation as a sign of fighting pathogens.", created_at:1779652996, source_id:"chunk-3da16f4292642f8022ca187ac2cb1ede"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
UNWIND [{start: {_id:7000}, end: {_id:6217}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", keywords:"health impact,victimizing", truncate:"", weight:1.0, description:"Unhappy Mind leads to victimizing the body and disrupting body cell communication.", created_at:1779653006, source_id:"chunk-a0d5e6f42a0ce75b924e7ae7dbeb9676"}}, {start: {_id:7001}, end: {_id:6217}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", keywords:"destruction,health impact", truncate:"", weight:1.0, description:"Unhappy Mind leads to the destruction of future health.", created_at:1779653006, source_id:"chunk-a0d5e6f42a0ce75b924e7ae7dbeb9676"}}, {start: {_id:7006}, end: {_id:7004}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"content analysis,linguistic ambiguity", weight:1.0, description:"The YouTube video contains the phrase \"Ones from our minds,\" which is analyzed for possible typographical errors and contextual meaning.", created_at:1779653025, source_id:"chunk-84ba32121caabf0d9a2977600d6129bc"}}, {start: {_id:7006}, end: {_id:7005}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"contextual connection,linguistic coherence", weight:1.0, description:"The two phrases are discussed together to assess their combined coherence and potential contextual relationship in the audio content.", created_at:1779653025, source_id:"chunk-84ba32121caabf0d9a2977600d6129bc"}}, {start: {_id:7004}, end: {_id:7007}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"content analysis,contextual interpretation", weight:1.0, description:"The video's content involves analyzing \"Ones from our minds\" within the context of spiritual/self-help terminology.", created_at:1779653025, source_id:"chunk-84ba32121caabf0d9a2977600d6129bc"}}, {start: {_id:7006}, end: {_id:7008}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"conceptual alignment,linguistic ambiguity", weight:1.0, description:"The phrase is evaluated against mind-related concepts to resolve its potential meaning and contextual relevance.", created_at:1779653025, source_id:"chunk-84ba32121caabf0d9a2977600d6129bc"}}, {start: {_id:7009}, end: {_id:7010}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"contextual evaluation,correction application,sentence formation,typo correction", weight:2.0, description:"\"Ones\" is evaluated as a possible correction for the phrase \"ons from our minds.\"<SEP>\"Ones from our minds\" is formed by correcting \"ons\" to \"Ones.\"", created_at:1779653228, source_id:"chunk-289ef384a1b5daa9cbc4ffdc3e0ef2e7<SEP>chunk-06e6179eba39030fd6aa5d04d8a22dea"}}, {start: {_id:7012}, end: {_id:7010}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"contextual evaluation,typo correction", weight:1.0, description:"\"Once\" is considered but rejected as a correction due to contextual mismatch.", created_at:1779653073, source_id:"chunk-289ef384a1b5daa9cbc4ffdc3e0ef2e7"}}, {start: {_id:7010}, end: {_id:7016}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"error resolution,linguistic evaluation", weight:1.0, description:"Typo analysis is applied to assess and resolve the grammatical awkwardness of the phrase.", created_at:1779653073, source_id:"chunk-289ef384a1b5daa9cbc4ffdc3e0ef2e7"}}, {start: {_id:348}, end: {_id:7007}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"content analysis,linguistic discussion", weight:1.0, description:"The video contains content analyzing spiritual/self-help phrasing and potential linguistic errors.", created_at:1779653101, source_id:"chunk-289ef384a1b5daa9cbc4ffdc3e0ef2e7"}}, {start: {_id:348}, end: {_id:7014}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"content reference,video title", weight:2.0, description:"The YouTube Video is associated with the title \"uZg9XnRub7w\" as its identifier.<SEP>The YouTube Video is associated with the title \"u", created_at:1779653102, source_id:"chunk-15cf065111167c4fd17a4bb8cdaeb73b"}}, {start: {_id:7010}, end: {_id:348}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"conceptual exploration,content discussion,content source,hosting,linguistic analysis,sentence fragment", weight:3.0, created_at:1779653229, description:"The video discusses the concept of \"ones from our minds\" in its content.<SEP>The YouTube Video hosts the content discussing the correction of \"ons\" to \"Ones.\"<SEP>The video contains the sentence fragment \"Ones from our minds\" as part of its content, which becomes the focus of linguistic analysis and typo correction attempts.", source_id:"chunk-15cf065111167c4fd17a4bb8cdaeb73b<SEP>chunk-06e6179eba39030fd6aa5d04d8a22dea<SEP>chunk-2dca847a750da585bff46befc68b66b6"}}, {start: {_id:7015}, end: {_id:7010}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"error correction,linguistic analysis", weight:1.0, description:"The method of fixing typos is applied to the phrase \"ones from our minds\" to address potential errors.", created_at:1779653102, source_id:"chunk-15cf065111167c4fd17a4bb8cdaeb73b"}}, {start: {_id:7009}, end: {_id:7019}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"correction,linguistic analysis,typo consideration", weight:2.0, description:"The word \"ons\" is considered a typo and proposed to be corrected to \"Ones.\"<SEP>\"ons\" is hypothesized to be a typo for \"Ones,\" with repeated discussion about its grammatical validity and contextual usage.", created_at:1779655070, source_id:"chunk-06e6179eba39030fd6aa5d04d8a22dea<SEP>chunk-0e9a254b995e0c98e3ca94960e93f701"}}, {start: {_id:348}, end: {_id:7018}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", keywords:"association,reference", truncate:"", weight:1.0, description:"The URL is directly linked to the YouTube Video as its source.", created_at:1779653228, source_id:"chunk-06e6179eba39030fd6aa5d04d8a22dea"}}, {start: {_id:348}, end: {_id:7017}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"discussion,source", weight:1.0, description:"kward is associated with the YouTube video as the source of the linguistic analysis and debate over the typo correction.", created_at:1779653228, source_id:"chunk-2dca847a750da585bff46befc68b66b6"}}, {start: {_id:7009}, end: {_id:7017}, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", truncate:"", keywords:"linguistic analysis,typo correction", weight:1.0, description:"kward proposes and debates the correction of \"ons\" to \"Ones\" in the sentence fragment, analyzing its implications and attempting to resolve ambiguity.", created_at:1779653229, source_id:"chunk-2dca847a750da585bff46befc68b66b6"}}, {start: {_id:7020}, end: {_id:6708}, properties:{file_path:"YouTube Video: RFx74Q6Oq2c (URL: https://www.youtube.com/watch?v=RFx74Q6Oq2c)", truncate:"", keywords:"academic research,scientific discovery", weight:1.0, description:"Oxford University conducted the study that discovered the lateral frontal pole's function in human cognition.", created_at:1779653274, source_id:"chunk-c58820007a8ce164af9a67cbf25bf444"}}, {start: {_id:7021}, end: {_id:6708}, properties:{file_path:"YouTube Video: RFx74Q6Oq2c (URL: https://www.youtube.com/watch?v=RFx74Q6Oq2c)", truncate:"", keywords:"discovery,neurological finding", weight:1.0, description:"The study identified the lateral frontal pole as a unique human brain structure enabling future planning and strategic decisions.", created_at:1779653274, source_id:"chunk-c58820007a8ce164af9a67cbf25bf444"}}, {start: {_id:2081}, end: {_id:7021}, properties:{file_path:"YouTube Video: RFx74Q6Oq2c (URL: https://www.youtube.com/watch?v=RFx74Q6Oq2c)", truncate:"", keywords:"cognitive function,decision-making", weight:1.0, description:"The lateral frontal pole enables humans to make intelligent decisions and envision future possibilities.", created_at:1779653274, source_id:"chunk-c58820007a8ce164af9a67cbf25bf444"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
