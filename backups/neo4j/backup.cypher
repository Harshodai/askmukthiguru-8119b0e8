UNWIND [{start: {_id:289}, end: {_id:506}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional consequence,self-criticism", truncate:"", weight:1.0, description:"Self-obsession results in frustration when personal expectations are unmet.", created_at:1779138786, source_id:"chunk-3b972b1465c1099f09b7fe384e4ebabc"}}, {start: {_id:592}, end: {_id:604}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"internal conflict,self-judgment", truncate:"", weight:1.0, description:"The presence of inner voices leads to a self-directed battle over self-perception and expectations.", created_at:1779138787, source_id:"chunk-3b972b1465c1099f09b7fe384e4ebabc"}}, {start: {_id:603}, end: {_id:594}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"judgment,teaching methods", truncate:"", weight:1.0, description:"The education system teaches individuals to compare and judge others through test scores and rankings.", created_at:1779138787, source_id:"chunk-3b972b1465c1099f09b7fe384e4ebabc"}}, {start: {_id:602}, end: {_id:61}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"inner state,non-conicted being", truncate:"", weight:1.0, description:"Lokaa maintains an unbroken sense of inner clarity and non-conictedness despite societal pressures.", created_at:1779138787, source_id:"chunk-3b972b1465c1099f09b7fe384e4ebabc"}}, {start: {_id:605}, end: {_id:178}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source<SEP>YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)", keywords:"cause and effect,competition,cultural influence,social dynamics,societal impact", truncate:"", weight:3.0, created_at:1779530955, description:"Society structurally encourages division and competition through education and social norms.<SEP>Society accentuates feelings of division and competition, influencing self-perception.<SEP>Division at all societal levels leads to violence and conflict.` - Seems correct.", source_id:"chunk-3b972b1465c1099f09b7fe384e4ebabc<SEP>chunk-2bd00175db71e25481fb9ce67f057b84<SEP>chunk-08c5fbdcd35ed15300b9915ca1fced8a"}}, {start: {_id:596}, end: {_id:595}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"innocence,sensory experience", truncate:"", weight:1.0, description:"Observing rainbows symbolizes the simple, joyful experiences of childhood.", created_at:1779138787, source_id:"chunk-3b972b1465c1099f09b7fe384e4ebabc"}}, {start: {_id:599}, end: {_id:289}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cause and effect,self-judgment", truncate:"", weight:1.0, description:"Unrealistic expectations directly cause frustration and self-criticism.", created_at:1779138787, source_id:"chunk-3b972b1465c1099f09b7fe384e4ebabc"}}, {start: {_id:593}, end: {_id:589}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"behavioral outcome,self-obsession", truncate:"", weight:1.0, description:"The internal conflict leads to behaviors of either pleasing others or proving oneself.", created_at:1779138787, source_id:"chunk-3b972b1465c1099f09b7fe384e4ebabc"}}, {start: {_id:608}, end: {_id:609}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"behavioral manifestation,psychological state", weight:1.0, description:"Pleasers exemplify self-preoccupation through excessive concern for others' approval.", created_at:1779138802, source_id:"chunk-c5db2181b0244c95f353d5c0b1c153ef"}}, {start: {_id:607}, end: {_id:609}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"behavioral manifestation,psychological state", weight:1.0, description:"Provers demonstrate self-preoccupation through resentment and attempts to prove others wrong.", created_at:1779138802, source_id:"chunk-c5db2181b0244c95f353d5c0b1c153ef"}}, {start: {_id:609}, end: {_id:42}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"antithesis,psychological contrast", truncate:"", weight:1.0, description:"Self-preoccupied individuals are disconnected from their innate wholeness and self-awareness.", created_at:1779138803, source_id:"chunk-c5db2181b0244c95f353d5c0b1c153ef"}}, {start: {_id:606}, end: {_id:609}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional health,opposing state", truncate:"", weight:1.0, description:"Self-love contrasts with self-preoccupation by fostering acceptance and self-compassion.", created_at:1779138803, source_id:"chunk-c5db2181b0244c95f353d5c0b1c153ef"}}, {start: {_id:611}, end: {_id:610}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"internal conflict,self-perception", truncate:"", weight:1.0, description:"The self observes and acknowledges moments of self-care and respect.", created_at:1779138818, source_id:"chunk-2e1251c183d277453a1b96fbfae7185f"}}, {start: {_id:613}, end: {_id:610}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional states,self-awareness", truncate:"", weight:1.0, description:"The self confronts and reflects on moments of dissatisfaction or dislike.", created_at:1779138818, source_id:"chunk-2e1251c183d277453a1b96fbfae7185f"}}, {start: {_id:614}, end: {_id:610}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"avoidance,coping mechanisms", truncate:"", weight:1.0, description:"The self seeks external solutions or escapes during moments of self-dissatisfaction.", created_at:1779138818, source_id:"chunk-2e1251c183d277453a1b96fbfae7185f"}}, {start: {_id:612}, end: {_id:610}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"internal conflict,self-awareness", truncate:"", weight:1.0, description:"The self observes and acknowledges the inner war as a normal state of self-dissatisfaction.", created_at:1779138818, source_id:"chunk-2e1251c183d277453a1b96fbfae7185f"}}, {start: {_id:620}, end: {_id:616}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"coping mechanism,escalation factor,negative cycle,self-destruction", truncate:"", weight:2.0, description:"The internal divide drives individuals toward harmful substances like narcotics.<SEP>The internal divide drives individuals to use narcotics as an escape.", created_at:1779184335, source_id:"chunk-0e910622cdbaf731d9c63e3af759ab25<SEP>chunk-035b6c44730bb7cdf05bfef04ef27b03"}}, {start: {_id:466}, end: {_id:619}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"psychological opposition,resolution", truncate:"", weight:1.0, description:"Self-doubt conflicts with self-acceptance, creating an internal divide that the text emphasizes as harmful.", created_at:1779138862, source_id:"chunk-0e910622cdbaf731d9c63e3af759ab25"}}, {start: {_id:301}, end: {_id:619}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"absence,emotional blockage", truncate:"", weight:1.0, description:"The text states that happiness cannot be achieved while at war with oneself (self-doubt).", created_at:1779138862, source_id:"chunk-0e910622cdbaf731d9c63e3af759ab25"}}, {start: {_id:301}, end: {_id:466}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"achievement,foundation,fulfillment,self-love", truncate:"", weight:2.0, description:"Self-acceptance is presented as the foundation for attaining happiness.<SEP>Self-acceptance results in genuine happiness and contentment.", created_at:1779184336, source_id:"chunk-0e910622cdbaf731d9c63e3af759ab25<SEP>chunk-66f6c16a0cd4b4ef4b399e98335000b4"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
