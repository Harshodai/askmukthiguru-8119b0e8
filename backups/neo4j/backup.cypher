UNWIND [{start: {name:"Oneness"}, end: {_id:1451}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"oneness,source", weight:1.0, description:"Source is associated with oneness, and oneness is described as the state of being one with love.", created_at:1779420380, source_id:"chunk-7a50476fe3717f3e56d4d65eb5669d3f"}}, {start: {name:"Oneness"}, end: {_id:4970}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"oneness,singularity", truncate:"", weight:1.0, description:"Singularity is associated with oneness, and oneness is described as the state of being one with love.", created_at:1779420381, source_id:"chunk-7a50476fe3717f3e56d4d65eb5669d3f"}}, {start: {name:"Oneness"}, end: {_id:4965}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", truncate:"", keywords:"oneness,origin,pure love", weight:2.0, description:"Pure Love is associated with oneness, and oneness is described as the state of being one with love.<SEP>Pure Love is the origin from which Oneness descends.", created_at:1779420638, source_id:"chunk-7a50476fe3717f3e56d4d65eb5669d3f<SEP>chunk-4f108a1313b1da3a2fa234ff5f49d6e5"}}, {start: {name:"Oneness"}, end: {_id:4964}, properties:{file_path:"YouTube Video: QAnRefsK-3Y (URL: https://www.youtube.com/watch?v=QAnRefsK-3Y)", keywords:"oneness,zero point", truncate:"", weight:1.0, description:"Zero Point is associated with oneness, and oneness is described as the state of being one with love.", created_at:1779420381, source_id:"chunk-7a50476fe3717f3e56d4d65eb5669d3f"}}, {start: {name:"Consciousness"}, end: {_id:4999}, properties:{file_path:"YouTube Video: smrj15-QOAI (URL: https://www.youtube.com/watch?v=smrj15-QOAI)", keywords:"correction,discussion", truncate:"", weight:1.0, description:"The video discusses the term \"consciousness\" and its usage in the text.", created_at:17