UNWIND [{start: {_id:5625}, end: {_id:5623}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", truncate:"", keywords:"causes,psychological tendency", weight:1.0, description:"A denser sense of self directly causes desires for control and domination over others.", created_at:1779519970, source_id:"chunk-3262d5415ded94fc1fc56ae56e675a4b"}}, {start: {_id:5624}, end: {_id:1866}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", truncate:"", keywords:"cultivates,spiritual practice", weight:1.0, description:"Meditation actively generates collective peace in human consciousness.", created_at:1779519970, source_id:"chunk-3262d5415ded94fc1fc56ae56e675a4b"}}, {start: {_id:5624}, end: {_id:5627}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", truncate:"", keywords:"conflict resolution,dissipates", weight:1.0, description:"Collective peace dissolves wars by addressing their root causes in human behavior.", created_at:1779519970, source_id:"chunk-3262d5415ded94fc1fc56ae56e675a4b"}}, {start: {_id:299}, end: {_id:5630}, properties:{file_path:"unknown_source<SEP>YouTube Video: F-hNATzOz2I (URL: https://www.youtube.com/watch?v=F-hNATzOz2I)", keywords:"irreplaceability,miracle,sacredness", truncate:"", weight:2.0, description:"Love is experienced as sacredness and irreplaceability in the presence of a newborn, symbolizing profound connection.<SEP>Love manifests as awe and reverence when encountering a newborn, seen as a divine gift.", created_at:1779520371, source_id:"chunk-5bd21ff5a870ab22c344b6bc7a8c56b4<SEP>chunk-352ac4da97f866ae1e36170e4635504b"}}, {start: {_id:299}, end: {_id:5628}, properties:{file_path:"unknown_source<SEP>YouTube Video: F-hNATzOz2I (URL: https://www.youtube.com/watch?v=F-hNATzOz2I)", keywords:"impact,irreplaceability,loss", truncate:"", weight:2.0, description:"Love arises from recognizing the irreplaceable nature and deep impact of a loved one, especially during moments of loss.<SEP>Love is recognized through the awareness of a loved one's irreplaceable presence, especially during their passing.", created_at:1779520371, source_id:"chunk-5bd21ff5a870ab22c344b6bc7a8c56b4<SEP>chunk-352ac4da97f866ae1e36170e4635504b"}}, {start: {_id:299}, end: {_id:2222}, properties:{file_path:"unknown_source<SEP>YouTube Video: F-hNATzOz2I (URL: https://www.youtube.com/watch?v=F-hNATzOz2I)", keywords:"presence,reverence,spiritual connection", truncate:"", weight:2.0, description:"Love is characterized by a sense of sacredness and reverence, often felt in moments of profound connection.<SEP>Love is experienced as the presence of the sacred, emphasizing a spiritual connection.", created_at:1779520371, source_id:"chunk-5bd21ff5a870ab22c344b6bc7a8c56b4<SEP>chunk-352ac4da97f866ae1e36170e4635504b"}}, {start: {_id:771}, end: {_id:299}, properties:{file_path:"unknown_source", keywords:"impact,recognition", truncate:"", weight:1.0, description:"Love involves recognizing and valuing the kindness of loved ones, which profoundly impacts one's life.", created_at:1779520199, source_id:"chunk-5bd21ff5a870ab22c344b6bc7a8c56b4"}}, {start: {_id:299}, end: {_id:5629}, properties:{file_path:"unknown_source", keywords:"acknowledgment,connection", truncate:"", weight:1.0, description:"Love is deepened by acknowledging the patience of loved ones, fostering a stronger emotional connection.", created_at:1779520199, source_id:"chunk-5bd21ff5a870ab22c344b6bc7a8c56b4"}}, {start: {_id:299}, end: {_id:1965}, properties:{file_path:"unknown_source", keywords:"admiration,inspiration", truncate:"", weight:1.0, description:"Love is inspired by admiring the strength of loved ones, which reinforces their profound impact.", created_at:1779520199, source_id:"chunk-5bd21ff5a870ab22c344b6bc7a8c56b4"}}, {start: {_id:41}, end: {_id:299}, properties:{file_path:"unknown_source", keywords:"respect,transformation", truncate:"", weight:1.0, description:"Love involves respecting the courage of loved ones, leading to personal transformation and deeper connection.", created_at:1779520200, source_id:"chunk-5bd21ff5a870ab22c344b6bc7a8c56b4"}}, {start: {_id:991}, end: {_id:299}, properties:{file_path:"unknown_source", keywords:"healing,reconciliation", truncate:"", weight:1.0, description:"Love is reinforced through forgiveness, promoting healing and reconciliation in relationships.", created_at:1779520200, source_id:"chunk-5bd21ff5a870ab22c344b6bc7a8c56b4"}}, {start: {_id:5631}, end: {_id:299}, properties:{file_path:"unknown_source", keywords:"celebration,connection", truncate:"", weight:1.0, description:"Love is celebrated through joyfulness, enhancing the bond and connection with loved ones.", created_at:1779520200, source_id:"chunk-5bd21ff5a870ab22c344b6bc7a8c56b4"}}, {start: {_id:299}, end: {_id:5633}, properties:{file_path:"YouTube Video: F-hNATzOz2I (URL: https://www.youtube.com/watch?v=F-hNATzOz2I)", truncate:"", keywords:"essence,feeling", weight:1.0, description:"Love is fundamentally tied to the feeling of preciousness, framing it as the emotional core of the connection.", created_at:1779520371, source_id:"chunk-352ac4da97f866ae1e36170e4635504b"}}, {start: {_id:5630}, end: {_id:2222}, properties:{file_path:"YouTube Video: F-hNATzOz2I (URL: https://www.youtube.com/watch?v=F-hNATzOz2I)", keywords:"divine presence,reverence", truncate:"", weight:1.0, description:"Newborns evoke a sense of sacredness and divine presence, seen as miracles from the universe.", created_at:1779520371, source_id:"chunk-352ac4da97f866ae1e36170e4635504b"}}, {start: {_id:299}, end: {_id:5634}, properties:{file_path:"YouTube Video: F-hNATzOz2I (URL: https://www.youtube.com/watch?v=F-hNATzOz2I)", truncate:"", keywords:"imperfections,positive traits", weight:1.0, description:"Love arises from recognizing the Other's imperfections and unique virtues, fostering deep emotional impact.", created_at:1779520371, source_id:"chunk-352ac4da97f866ae1e36170e4635504b"}}, {start: {_id:299}, end: {_id:116}, properties:{file_path:"YouTube Video: F-hNATzOz2I (URL: https://www.youtube.com/watch?v=F-hNATzOz2I)", truncate:"", keywords:"cosmic connection,divine origin", weight:1.0, description:"Love is perceived as a sacred gift from the universe, linking it to a cosmic or divine origin.", created_at:1779520371, source_id:"chunk-352ac4da97f866ae1e36170e4635504b"}}, {start: {_id:5642}, end: {_id:5638}, properties:{file_path:"unknown_source", truncate:"", keywords:"fostering leadership,preventing tyranny", weight:1.0, description:"Teaching peace education prevents figures like Hitler and cultivates leaders like Gandhi.", created_at:1779520409, source_id:"chunk-d3d330d042772c704e2fd89e4454d795"}}, {start: {_id:5560}, end: {_id:5639}, properties:{file_path:"unknown_source", keywords:"compassion,conflict resolution", truncate:"", weight:1.0, description:"Non-judgmental attitudes dissolve interpersonal conflict and promote mutual understanding.", created_at:1779520409, source_id:"chunk-d3d330d042772c704e2fd89e4454d795"}}, {start: {_id:5641}, end: {_id:2814}, properties:{file_path:"unknown_source", keywords:"antithesis,contrast", truncate:"", weight:1.0, description:"The Temple of Peace directly opposes violence and fear to establish global harmony.", created_at:1779520409, source_id:"chunk-d3d330d042772c704e2fd89e4454d795"}}, {start: {_id:5640}, end: {_id:1490}, properties:{file_path:"unknown_source", keywords:"balance shift,transformation", truncate:"", weight:1.0, description:"Mass meditations aim to shift collective consciousness from violence to peace.", created_at:1779520409, source_id:"chunk-d3d330d042772c704e2fd89e4454d795"}}] AS row
