UNWIND [{start: {_id:706}, end: {_id:785}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"connection,guidance", truncate:"", weight:1.0, description:"Activating the third eye enables reception of guidance from universal intelligence.", created_at:1779558313, source_id:"chunk-bdaca57c11a3d551259155ef196cf16d"}}, {start: {_id:1748}, end: {_id:6341}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"emotional expression,hormonal influence", weight:1.0, description:"Oxytocin secretion enables unconditional love in maternal relationships.", created_at:1779558313, source_id:"chunk-bdaca57c11a3d551259155ef196cf16d"}}, {start: {_id:355}, end: {_id:352}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=CQEGJ0OaIPo)", truncate:"", keywords:"behavioral impact,child potential,emotional healing,nurturing,parental judgment,parental sensitivity", weight:3.0, description:"The mother's judgment causes the child to feel lonely and engage in negative behaviors.<SEP>When the mother is sensitive, the child's potential is awakened.<SEP>The child's relationship with their mother, both biological and adoptive, is central to their upbringing and emotional well-being.", created_at:1779687982, source_id:"chunk-4da1e45ca993decf20ec10e31d56d36e<SEP>chunk-b99209818242fa366169c6ab46e01f5f"}}, {start: {_id:355}, end: {_id:2004}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"behavioral response,consequence of judgment", weight:1.0, description:"The child turns to video games as a result of feeling judged by the mother.", created_at:1779558325, source_id:"chunk-4da1e45ca993decf20ec10e31d56d36e"}}, {start: {_id:6297}, end: {_id:352}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"hormonal impact,state of consciousness", weight:1.0, description:"Aggressive ambition in the mother reduces oxytocin secretion.", created_at:1779558325, source_id:"chunk-4da1e45ca993decf20ec10e31d56d36e"}}, {start: {_id:352}, end: {_id:1748}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"bonding,hormonal impact", truncate:"", weight:1.0, description:"The mother's aggressive ambition reduces oxytocin, affecting her ability to bond with the child.", created_at:1779558325, source_id:"chunk-4da1e45ca993decf20ec10e31d56d36e"}}, {start: {_id:2598}, end: {_id:355}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"behavioral response,consequence of judgment", weight:1.0, description:"The child may develop addictions due to the stress of being judged.", created_at:1779558325, source_id:"chunk-4da1e45ca993decf20ec10e31d56d36e"}}, {start: {_id:6343}, end: {_id:355}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"behavioral response,consequence of judgment", weight:1.0, description:"The child forms bad friendships as a result of feeling judged and lonely.", created_at:1779558325, source_id:"chunk-4da1e45ca993decf20ec10e31d56d36e"}}, {start: {_id:355}, end: {_id:6342}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"neurological impact,stress effect", weight:1.0, description:"Stress from being judged by the mother leads to shrinkage of the child's hippocampus.", created_at:1779558326, source_id:"chunk-4da1e45ca993decf20ec10e31d56d36e"}}, {start: {_id:951}, end: {_id:6346}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"cause", weight:1.0, description:"Accumulated hurts and humiliations lead to the building of walls around the heart.", created_at:1779558355, source_id:"chunk-0e593bb50eabcacd46122f257190fe7f"}}, {start: {_id:788}, end: {_id:786}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"comparison,interaction", truncate:"", weight:1.0, description:"The heart and brain have neurons that function differently; the heart intuits while the brain reasons.", created_at:1779558355, source_id:"chunk-0e593bb50eabcacd46122f257190fe7f"}}, {start: {_id:6349}, end: {_id:6346}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"cause", weight:1.0, description:"Humiliations from parents and in-laws contribute to the formation of walls around the heart.", created_at:1779558355, source_id:"chunk-0e593bb50eabcacd46122f257190fe7f"}}, {start: {_id:6345}, end: {_id:786}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"concept", weight:1.0, description:"The text mentions Dh?ngin? in the context of women's roles, but does not define it as a concept.", created_at:1779558355, source_id:"chunk-0e593bb50eabcacd46122f257190fe7f"}}, {start: {_id:786}, end: {_id:6347}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"reason", weight:1.0, description:"Infidelity is cited as one of the numerous reasons why partner relationships fail.", created_at:1779558355, source_id:"chunk-0e593bb50eabcacd46122f257190fe7f"}}, {start: {_id:6157}, end: {_id:786}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"reason", weight:1.0, description:"Family pressure, along with infidelity and health reasons, is given as a cause for relationship failure.", created_at:1779558355, source_id:"chunk-0e593bb50eabcacd46122f257190fe7f"}}, {start: {_id:6348}, end: {_id:786}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"reason", weight:1.0, description:"Health reasons are listed as one of the fundamental reasons for partner relationships failing.", created_at:1779558355, source_id:"chunk-0e593bb50eabcacd46122f257190fe7f"}}, {start: {_id:452}, end: {_id:178}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", keywords:"emotional impact,judgment", truncate:"", weight:1.0, description:"Hearts accumulate hurts due to societal judgments about inadequacy in wealth, trends, beauty, or intelligence.", created_at:1779558374, source_id:"chunk-a8e26840aa3a5bf7f8632efb251d8ee5"}}, {start: {_id:299}, end: {_id:233}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"cultural context,definition", weight:1.0, description:"Love is defined in Sanskrit as a balance of substance, body, and soul, reflecting its philosophical underpinnings.", created_at:1779558374, source_id:"chunk-a8e26840aa3a5bf7f8632efb251d8ee5"}}, {start: {_id:452}, end: {_id:413}, properties:{file_path:"YouTube Video: DmzZPgTh7_M (URL: https://www.youtube.com/watch?v=DmzZPgTh7_M)", truncate:"", keywords:"emotional barriers,relational consequences", weight:1.0, description:"Accumulated hurts in the heart create distrust and withholding in relationships, preventing genuine connection.", created_at:1779558374, source_id:"chunk-a8e26840aa3a5bf7f8632efb251d8ee5"}}, {start: {_id:6368}, end: {_id:6369}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"failure,medical intervention", weight:1.0, description:"The Royal Physicians attempted to treat the king's unhappiness but were unsuccessful.", created_at:1779558399, source_id:"chunk-3f35ef057620d3747f3f79daa132d83a"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
