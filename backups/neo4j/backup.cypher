UNWIND [{start: {name:"Suffering"}, end: {_id:5581}, properties:{file_path:"YouTube Video: XFFgRTgP8Rs (URL: https://www.youtube.com/watch?v=XFFgRTgP8Rs)", truncate:"", keywords:"inadequate solutions,prolonged suffering", weight:1.0, description:"Superficial Answers prevent addressing the root cause, leading to prolonged suffering.", created_at:1779519413, source_id:"chunk-d305977f98ef25807e2b5a0d7a24ce2c"}}, {start: {name:"Suffering"}, end: {_id:5593}, properties:{file_path:"YouTube Video: LapJqYf9hzI (URL: https://www.youtube.com/watch?v=LapJqYf9hzI)", keywords:"analysis,discussion topic", truncate:"", weight:1.0, description:"The video analyzes the root causes and generational transmission of human suffering.", created_at:1779519776, source_id:"chunk-b4ef0432d09dd625d180cc94f3e0ef2e"}}, {start: {name:"Dharma"}, end: {_id:755}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)<SEP>YouTube Video: s6B81c2uTGg (URL: https://www.youtube.com/watch?v=s6B81c2uTGg)", truncate:"", keywords:"global peace,moral obligation,peace promotion,spiritual goal", weight:2.0, description:"Dharma's ultimate purpose is to cultivate and spread peace as a universal human responsibility.<SEP>Meditating for peace is framed as a universal dharma (duty) for all humans.", created_at:1779520992, source_id:"chunk-ab90f4a2ea15bf468182f88153f57ef6<SEP>chunk-523915ad473a2e9b1024913a693f94bb"}}, {start: {name:"Dharma"}, end: {_id:1469}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)<SEP>YouTube Video: ftFDBaH7RFg (URL: https://www.youtube.com/watch?v=ftFDBaH7RFg)", truncate:"", keywords:"ethical conflict,ethical duty,moral imperative,moral opposition", weight:2.0, description:"Dharma ethically opposes war's destructive motives, advocating for peace instead.<SEP>War is linked to Dharma as a righteous action when conducted to defend the vulnerable and maintain justice.", created_at:1779663137, source_id:"chunk-ab90f4a2ea15bf468182f88153f57ef6<SEP>chunk-0360e3d7478d7aa88e74b472aef4bc64"}}, {start: {name:"Dharma"}, end: {_id:4603}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", truncate:"", keywords:"ethical conflict,moral opposition", weight:1.0, description:"Dharma opposes self-interest by advocating for responsibilities that benefit others and the planet.", created_at:1779519920, source_id:"chunk-ab90f4a2ea15bf468182f88153f57ef6"}}, {start: {name:"Dharma"}, end: {_id:5632}, properties:{file_path:"YouTube Video: aqSM9LwqWgA (URL: https://www.youtube.com/watch?v=aqSM9LwqWgA)", truncate:"", keywords:"moral imperative,transcends", weight:1.0, description:"Dharma calls for overcoming conflict-driven thinking to embrace inherent peacefulness.", created_at:1779519970, source_id:"chunk-3262d5415ded94fc1fc56ae56e675a4b"}}, {start: {name:"Dharma"}, end: {_id:5689}, properties:{file_path:"YouTube Video: s6B81c2uTGg (URL: https://www.youtube.com/watch?v=s6B81c2uTGg)", truncate:"", keywords:"moral purpose,spiritual commitment", weight:1.0, description:"Satyathi fulfills his Dharma by protecting children and promoting peace, as highlighted in the speech.", created_at:1779520880, source_id:"chunk-87e9f6f06dda3bab56cb02db087a043c"}}, {start: {name:"Dharma"}, end: {_id:5702}, properties:{file_path:"YouTube Video: s6B81c2uTGg (URL: https://www.youtube.com/watch?v=s6B81c2uTGg)", keywords:"moral duty,protection", truncate:"", weight:1.0, description:"Dharma encompasses the moral duty to protect the innocence and future of children.", created_at:1779521017, source_id:"chunk-37d0d91f60cf0c0cf3f8569ec5103472"}}, {start: {name:"Oneness"}, end: {_id:785}, properties:{file_path:"unknown_source<SEP>YouTube Video: MJYpyUlwxg0 (URL: https://www.youtube.com/watch?v=MJYpyUlwxg0)", keywords:"foundation,foundational basis,manifestation,source", truncate:"", weight:2.0, created_at:1779521247, description:"Oneness originates from and is sustained by Universal Intelligence, which underlies all existence as its primary source.<SEP>Oneness is rooted in universal intelligence, which manifests as the diverse universe through continuity and passing.", source_id:"chunk-a4ec9b97a69f62614437c5e1621469d7<SEP>chunk-2440e826e4f3cf50974cdd2445cd5354"}}, {start: {name:"Dharma"}, end: {_id:1071}, properties:{file_path:"unknown_source", truncate:"", keywords:"ethical principle,ethical responsibility,planetary stewardship,sustainability", weight:3.0, description:"Dharma involves conscious living and compassionate treatment of Earth as a shared home for all life-forms.<SEP>Dharma involves conscious living and compassionate treatment of Earth as a shared home for all life-forms.<SEP>Dharma is a principle of living sustainably and respecting Earth's boundaries.", created_at:1779531588, source_id:"chunk-d459696e63e5250812e4b59a48640c43<SEP>chunk-aa80ceeb1e8b2dd7460f820d674a1d04"}}, {start: {name:"Dharma"}, end: {_id:5715}, properties:{file_path:"unknown_source", keywords:"ecological respect,moral obligation", truncate:"", weight:2.0, description:"Dharma requires humanity to respect boundaries and living spaces of other life-forms.<SEP>Dharma requires humanity to respect boundaries and living spaces of other life-forms.", created_at:1779521746, source_id:"chunk-d459696e63e5250812e4b59a48640c43"}}, {start: {name:"Dharma"}, end: {_id:123}, properties:{file_path:"YouTube Video: Xk1KsO3efP4 (URL: https://www.youtube.com/watch?v=Xk1KsO3efP4)", truncate:"", keywords:"environmental stewardship,ethical responsibility", weight:1.0, description:"Humanity's Dharma involves conscious living and compassionate treatment of Earth and other life forms.", created_at:1779521747, source_id:"chunk-8b2fbaa3ebe33f5b431669abfbee9a40"}}, {start: {name:"Consciousness"}, end: {_id:4730}, properties:{file_path:"unknown_source", keywords:"cosmic context,interconnectedness", truncate:"", weight:1.0, description:"Consciousness is part of a living universe, with divine power operating within it.", created_at:1779522027, source_id:"chunk-57d13edf70fda1b7b5635305ebadfc8d"}}, {start: {name:"Suffering"}, end: {_id:5737}, properties:{file_path:"unknown_source", keywords:"avoidance,education", truncate:"", weight:1.0, description:"Teens are taught to reject suffering and instead model joy to learn through positive behavior.", created_at:1779524102, source_id:"chunk-e32359164f62f64b8a0367195694bf0f"}}, {start: {name:"Deeksha"}, end: {_id:5771}, properties:{file_path:"YouTube Video: tegTDWT3SDc (URL: https://www.youtube.com/watch?v=tegTDWT3SDc)", truncate:"", keywords:"experience outcome,spiritual practice", weight:1.0, description:"The experience is a result of the Deeksha and blessing, involving physical and spiritual changes.", created_at:1779524485, source_id:"chunk-ea232d61d1eebbbf47a086d1e047bec3"}}, {start: {name:"Beautiful State"}, end: {_id:755}, properties:{file_path:"unknown_source", keywords:"inner harmony,self-acceptance", truncate:"", weight:1.0, description:"Peace is integral to the beautiful state achieved through self-embrace.", created_at:1779524874, source_id:"chunk-3d3e1db7059b50ed67e675540955de81"}}, {start: {name:"Beautiful State"}, end: {_id:40}, properties:{file_path:"unknown_source", keywords:"emotional stability,self-love", truncate:"", weight:1.0, description:"Calmness results from nurturing the beautiful state through self-acceptance.", created_at:1779524874, source_id:"chunk-3d3e1db7059b50ed67e675540955de81"}}, {start: {name:"Beautiful State"}, end: {_id:5765}, properties:{file_path:"unknown_source", keywords:"emotional health,self-rewiring", truncate:"", weight:1.0, description:"Cultivating the beautiful state results in personal completeness and societal transformation.", created_at:1779524874, source_id:"chunk-3d3e1db7059b50ed67e675540955de81"}}, {start: {name:"Beautiful State"}, end: {_id:788}, properties:{file_path:"unknown_source", keywords:"rewiring,self-acceptance", truncate:"", weight:1.0, description:"The beautiful state leads to brain rewiring, fostering self-acceptance and completeness.", created_at:1779524874, source_id:"chunk-3d3e1db7059b50ed67e675540955de81"}}, {start: {name:"Oneness"}, end: {_id:178}, properties:{file_path:"unknown_source", keywords:"collective action,resolution", truncate:"", weight:2.0, description:"Society is urged to move toward oneness to dissolve divisiveness.<SEP>Society is urged to move toward oneness to dissolve divisiveness.", created_at:1779530954, source_id:"chunk-bfec7ed2213b36e2e9d3090ab708cd73"}}] AS row
MATCH (start:Concept{name: row.start.name})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
UNWIND [{start: {name:"Brahman"}, end: {_id:5788}, properties:{file_path:"unknown_source", keywords:"metaphysical identity,unity", truncate:"", weight:1.0, description:"Brahmarpanam identifies Brahman as the indivisible consciousness underlying all existence.", created_at:1779531042, source_id:"chunk-e5bc7202d0a09227aeb490c17e163a8e"}}, {start: {name:"Consciousness"}, end: {_id:3649}, properties:{file_path:"unknown_source<SEP>YouTube Video: TQ0TGyaByhs (URL: https://www.youtube.com/watch?v=TQ0TGyaByhs)", keywords:"cyclicality,metaphysical connection,metaphysical equivalence,metaphysical role", truncate:"", weight:3.0, description:"Consciousness is simultaneously the food, the consumer, and the resulting energy in cosmic processes.<SEP>Consciousness is described as the food and the energy that emerges from offerings.<SEP>Food is linked to consciousness as a sacred mystery and the source of energy.", created_at:1779531118, source_id:"chunk-e5bc7202d0a09227aeb490c17e163a8e<SEP>chunk-ce2308cda5fca23d965042def4191e27"}}, {start: {name:"Consciousness"}, end: {_id:5789}, properties:{file_path:"YouTube Video: TQ0TGyaByhs (URL: https://www.youtube.com/watch?v=TQ0TGyaByhs)", keywords:"metaphorical representation", truncate:"", weight:1.0, description:"Consciousness is represented as the digestive fire in the concept of Yagna.", created_at:1779531119, source_id:"chunk-ce2308cda5fca23d965042def4191e27"}}, {start: {name:"Dharma"}, end: {_id:5814}, properties:{file_path:"unknown_source", keywords:"ethical principles,sustainability", truncate:"", weight:1.0, description:"Dharma represents the ethical principles of living sustainably and respecting Earth's boundaries.", created_at:1779531587, source_id:"chunk-aa80ceeb1e8b2dd7460f820d674a1d04"}}, {start: {name:"Dharma"}, end: {_id:5810}, properties:{file_path:"unknown_source", keywords:"conservation,ethical principle", truncate:"", weight:1.0, description:"Dharma calls for respecting life, which aligns with preventing vertebrate extinction.", created_at:1779531588, source_id:"chunk-aa80ceeb1e8b2dd7460f820d674a1d04"}}, {start: {name:"Consciousness"}, end: {_id:605}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)", truncate:"", keywords:"creation,origin", weight:2.0, description:"Division originates in thought before translating into speech or action, emphasizing the role of consciousness in its formation.<SEP>Division originates in thought before translating into speech or action, emphasizing the role of consciousness in its formation.", created_at:1779534743, source_id:"chunk-817243e49afe8b11df3c2d2ea2541519"}}, {start: {name:"Consciousness"}, end: {_id:3090}, properties:{file_path:"YouTube Video: cu-Tx7ehQvM (URL: https://www.youtube.com/watch?v=cu-Tx7ehQvM)", keywords:"awareness,elimination", truncate:"", weight:2.0, description:"Awakened consciousness leads to right perception, which eliminates discrimination.<SEP>Awakened consciousness leads to right perception, which eliminates discrimination.", created_at:1779534743, source_id:"chunk-817243e49afe8b11df3c2d2ea2541519"}}, {start: {name:"Dharma"}, end: {_id:5835}, properties:{file_path:"unknown_source", keywords:"Dharma,purpose", truncate:"", weight:1.0, description:"Eric Solheim is a man awakened to his Dharma of bringing peace.", created_at:1779536519, source_id:"chunk-2c155ca915a56ff1bf0ef30ef075e557"}}, {start: {name:"Consciousness"}, end: {_id:197}, properties:{file_path:"YouTube Video: 2seBB2oByZc (URL: https://www.youtube.com/watch?v=2seBB2oByZc)<SEP>unknown_source", truncate:"", keywords:"consciousness level,foundational change,holistic improvement,inner awareness", weight:2.0, description:"The inner world is closely tied to one's level of consciousness, which is emphasized as important for personal and social improvement.<SEP>Consciousness is positioned as the root for addressing both material and social challenges.` - This seems correct.", created_at:1779551942, source_id:"chunk-9eea478f3eb12a678ce672d3075c4af8<SEP>chunk-25f394f47fe40575ea9fbcd110df6414"}}, {start: {name:"Mantra"}, end: {_id:5909}, properties:{file_path:"YouTube Video: M_BYTcsLQuY (URL: https://www.youtube.com/watch?v=M_BYTcsLQuY)", truncate:"", keywords:"challenge component,spiritual practice", weight:1.0, description:"The mantra's vibration is integral to the Soul Sync Challenge's daily practice.", created_at:1779552769, source_id:"chunk-8aa416f4b92bde5e908126e0e7ad0000"}}, {start: {name:"Mantra"}, end: {_id:2434}, properties:{file_path:"YouTube Video: M_BYTcsLQuY (URL: https://www.youtube.com/watch?v=M_BYTcsLQuY)", truncate:"", keywords:"concept,method", weight:1.0, description:"Soul Sync Meditation incorporates the use of a specific mantra for vibrational alignment.", created_at:1779552772, source_id:"chunk-61c0437442c1a79367c1612c9b022b8f"}}, {start: {name:"Mantra"}, end: {_id:233}, properties:{file_path:"YouTube Video: M_BYTcsLQuY (URL: https://www.youtube.com/watch?v=M_BYTcsLQuY)", truncate:"", keywords:"concept,language", weight:1.0, description:"The mantra \"Aham Brahmasmi\" is expressed in the Sanskrit language.", created_at:1779552772, source_id:"chunk-61c0437442c1a79367c1612c9b022b8f"}}, {start: {name:"Mantra"}, end: {_id:2425}, properties:{file_path:"YouTube Video: M_BYTcsLQuY (URL: https://www.youtube.com/watch?v=M_BYTcsLQuY)", truncate:"", keywords:"concept", weight:1.0, description:"The mantra generates a specific vibration that participants aim to harmonize with.", created_at:1779552772, source_id:"chunk-61c0437442c1a79367c1612c9b022b8f"}}, {start: {name:"Consciousness"}, end: {_id:6008}, properties:{file_path:"YouTube Video: CrZuPkgwA6Q (URL: https://www.youtube.com/watch?v=CrZuPkgwA6Q)", keywords:"detachment,observation", truncate:"", weight:1.0, description:"Consciousness observes experiences without being affected by their arising or ceasing.", created_at:1779554117, source_id:"chunk-6d556ad8b74e04409555169154f3886c"}}, {start: {name:"Beautiful State"}, end: {_id:921}, properties:{file_path:"unknown_source", keywords:"clarity,decision-making", truncate:"", weight:1.0, description:"CEO adopted the beautiful state to make empathetic, collaborative decisions.`", created_at:1779554363, source_id:"chunk-d62b0a2e608fc2a0128294d9e544e3ca"}}, {start: {name:"Beautiful State"}, end: {_id:519}, properties:{file_path:"unknown_source", keywords:"awareness,transformation", truncate:"", weight:1.0, description:"Recognizing stressful states allows transitioning to the beautiful state for better decisions.`", created_at:1779554364, source_id:"chunk-d62b0a2e608fc2a0128294d9e544e3ca"}}, {start: {name:"Beautiful State"}, end: {_id:6071}, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", keywords:"clarity,problem-solving", truncate:"", weight:1.0, description:"The beautiful state fosters clear thinking, enabling wise solutions to challenges.", created_at:1779555282, source_id:"chunk-19daeaae096340ea0105da39649682b5"}}, {start: {name:"Beautiful State"}, end: {_id:3333}, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", keywords:"engagement,presence", truncate:"", weight:1.0, description:"In the beautiful state, one experiences life fully and remains connected to surroundings and others.", created_at:1779555314, source_id:"chunk-19daeaae096340ea0105da39649682b5"}}, {start: {name:"Beautiful State"}, end: {_id:4515}, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", keywords:"dissipation,focused", truncate:"", weight:1.0, description:"In the beautiful state, energy is focused rather than dissipated, enabling clear thinking and life engagement.", created_at:1779555334, source_id:"chunk-19daeaae096340ea0105da39649682b5"}}, {start: {name:"Beautiful State"}, end: {_id:6081}, properties:{file_path:"YouTube Video: U23yKxWbIcI (URL: https://www.youtube.com/watch?v=U23yKxWbIcI)", truncate:"", keywords:"content inclusion,mental state analysis", weight:1.0, description:"The video explains the benefits of the beautiful state in handling challenges.", created_at:1779555368, source_id:"chunk-65663b0201354a6434222ff714a6bcfd"}}] AS row
MATCH (start:Concept{name: row.start.name})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
