UNWIND [{start: {_id:786}, end: {_id:911}, properties:{file_path:"unknown_source", keywords:"medical,physical impact", truncate:"", weight:1.0, description:"Heartbreak causes physical heart damage, including neuron death and syndrome development.", created_at:1779247284, source_id:"chunk-f34fb6f27b6128e7888cfaefe712d84a"}}, {start: {_id:3947}, end: {_id:911}, properties:{file_path:"unknown_source", truncate:"", keywords:"medical concept,medical consequence,pain,physiological impact", weight:2.0, description:"Broken heart syndrome is directly linked to the physiological effects of heartbreak.<SEP>Heartbreak leads to broken heart syndrome, characterized by heart tissue damage.", created_at:1779247284, source_id:"chunk-f34fb6f27b6128e7888cfaefe712d84a<SEP>chunk-1049ffa49a880db4b5369cf84bcae432"}}, {start: {_id:3952}, end: {_id:1619}, properties:{file_path:"unknown_source", keywords:"Domain", truncate:"", weight:1.0, description:"The platform is a spiritual platform.", created_at:1779247284, source_id:"chunk-e3279f0867e1797d155f31a8f57b0737"}}, {start: {_id:911}, end: {_id:2371}, properties:{file_path:"unknown_source", keywords:"research,validation", truncate:"", weight:1.0, description:"Science validates heartbreak as the most painful human experience with physical effects.", created_at:1779247284, source_id:"chunk-f34fb6f27b6128e7888cfaefe712d84a"}}, {start: {_id:916}, end: {_id:413}, properties:{file_path:"unknown_source", keywords:"absence,emotional conflict", truncate:"", weight:1.0, description:"Lack of trust results in pain, anger, and other negative emotions overshadowing love.", created_at:1779247284, source_id:"chunk-f34fb6f27b6128e7888cfaefe712d84a"}}, {start: {_id:788}, end: {_id:299}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=GfAMCHC6_ek)", keywords:"brain activation,cognitive impact,euphoria,neurological activation,neurological impact", truncate:"", weight:3.0, created_at:1779248345, description: