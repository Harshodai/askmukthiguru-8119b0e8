UNWIND [{_id:1533, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)", entity_type:"concept", truncate:"", description:"Modification of sentence structure to improve clarity while retaining original intent, such as adjusting verb tense or syntax.", created_at:1779217246, source_id:"chunk-ac963c80865bf4f33baf1d166cbe42de", entity_id:"Sentence Restructuring"}}, {_id:1534, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Movement in consciousness refers to the shift in mindset toward peace, central to the festival?s philosophy.", created_at:1779145277, source_id:"chunk-4e6b8198f0f9d175c647ec3cce9d4ad7", entity_id:"Movement in Consciousness"}}, {_id:1535, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)", entity_type:"concept", truncate:"", description:"Correction of logical conjunction from 'or' to 'and' to fix a logical error.", created_at:1779217285, source_id:"chunk-6ccd1f5debd2817e69e48d59df4cdf36", entity_id:"Logical Conjunction Error"}}, {_id:1536, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"Five consolidated states of expanded consciousness derived from historical cultural descriptions of enlightenment.", created_at:1779145293, source_id:"chunk-aa6df70374eb253c7ca1bd643516678c", entity_id:"Five Classical Enlightened States of Consciousness"}}, {_id:1537, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)<SEP>YouTube Video: pPHQMD3w9-s (URL: https://www.youtube.com/watch?v=pPHQMD3w9-s)", entity_type:"concept", truncate:"", created_at:1779664288, description:"Correction of punctuation by adding a comma for clarity in a sentence.<SEP>Concept related to proper punctuation rules and comma placement in lists and clauses.", source_id:"chunk-6ccd1f5debd2817e69e48d59df4cdf36<SEP>chunk-b787fee503789ccf5420cfc0f4003e6b<SEP>chunk-5ad87d01b925f7db7d300ff617025fd6", entity_id:"Comma Usage"}}, {_id:1538, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"UNKNOWN", truncate:"", description:"Preethaji and the author co-designed the festival to enable participants to experience enlightened states.", created_at:1779145312, source_id:"chunk-aa6df70374eb253c7ca1bd643516678c", entity_id:"Preethaji and Author"}}, {_id:1539, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"data", truncate:"", description:"Website offering meditation apps and resources related to The Four Sacred Secrets.<SEP>www.breathingroom.com is the website hosting the audio guide for the Great Soul Sync practice.", created_at:1779174769, source_id:"chunk-64534fa37e2772d16d26e6098d4409b0<SEP>chunk-ba8be2f785637451bf56a7dc7363715b", entity_id:"www.breathingroom.com"}}, {_id:1540, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"person", truncate:"", description:"Author who helped craft the words of The Four Sacred Secrets book.", created_at:1779145361, source_id:"chunk-64534fa37e2772d16d26e6098d4409b0", entity_id:"Sarah Rainone"}}, {_id:1541, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=7Pfat_DztMI)", entity_type:"concept", truncate:"", description:"Promotional code for accessing meditations from The Four Sacred Secrets via the Breathing Room app.<SEP>soul sync is a specific term related to fulfilling heartfelt intentions.", created_at:1779146928, source_id:"chunk-64534fa37e2772d16d26e6098d4409b0<SEP>chunk-1bf28db69c75de3ca9eaece03397b226", entity_id:"soul sync"}}, {_id:1542, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"person", truncate:"", description:"Editor from Atria Books who shaped the book's content and structure.", created_at:1779145361, source_id:"chunk-64534fa37e2772d16d26e6098d4409b0", entity_id:"Michelle Herrera Mulligan"}}, {_id:1543, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"organization", truncate:"", created_at:1779145636, description:"Publishing house responsible for editing and producing The Four Sacred Secrets.<SEP>Atria Books is a subsidiary of Simon & Schuster, Inc. responsible for book publications.`. The previous output had this as `artifact`, which is wrong.<SEP>Atria Books is the publisher of the book \"The four sacred secrets\".", source_id:"chunk-64534fa37e2772d16d26e6098d4409b0<SEP>chunk-0ff8600d1eb0818e8deb9d5aab2e4351<SEP>chunk-a2cc4d07b96d813e34cd5ee5e3d96e0d<SEP>chunk-3f7b8834c0b5fdd9d0b5f928c5733a2b", entity_id:"Atria Books"}}, {_id:1544, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"method", truncate:"", description:"Discipline integrated into the academy's courses for consciousness transformation.", created_at:1779145362, source_id:"chunk-64534fa37e2772d16d26e6098d4409b0", entity_id:"Philosophy"}}, {_id:1545, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)", entity_type:"concept", truncate:"", description:"The scope of the task, which includes correcting grammatical and logical errors.", created_at:1779217285, source_id:"chunk-6ccd1f5debd2817e69e48d59df4cdf36", entity_id:"Task Scope"}}, {_id:1546, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)", entity_type:"content", truncate:"", description:"Corrected sentence changing \"life\" to \"lives\" for grammatical accuracy.", created_at:1779217329, source_id:"chunk-543e024dcb3bd423b553a43fdaa466ba", entity_id:"Corrected Sentence 2"}}, {_id:1547, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"organization", truncate:"", description:"One Humanity Care is a charitable foundation aimed at improving lives in villages near the academy in India.<SEP>One Humanity Care is a foundation under O&O Academy focused on improving lives in India.<SEP>One Humanity Care is a charitable foundation improving lives in Indian villages, part of the O&O Academy?s initiatives.<SEP>One Humanity Care is a foundation by Preethaji and Krishnaji dedicated to improving lives in India through humanitarian efforts.", created_at:1779188163, source_id:"chunk-8a3ef14b4ae6173889d682a026ec55c0<SEP>chunk-8539e53b3407e35921fe5963280d3207<SEP>chunk-68272ee7ebb0f34dcf88d287b8d9983d<SEP>chunk-3f7b8834c0b5fdd9d0b5f928c5733a2b", entity_id:"One Humanity Care"}}, {_id:1548, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"event", truncate:"", description:"TEDx Talks by Preethaji have been viewed by over two million people and focus on meditation and consciousness.<SEP>Platform for Preethaji's meditation-related presentations.", created_at:1779145500, source_id:"chunk-8a3ef14b4ae6173889d682a026ec55c0<SEP>chunk-4b1b158579ce0e632c723f5212472e9c<SEP>chunk-3f7b8834c0b5fdd9d0b5f928c5733a2b", entity_id:"TEDx Talks"}}, {_id:1549, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)", entity_type:"content", truncate:"", description:"Original sentence with singular \"life\" which should be plural.", created_at:1779217329, source_id:"chunk-543e024dcb3bd423b553a43fdaa466ba", entity_id:"Original Sentence 2"}}, {_id:1550, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"organization", truncate:"", created_at:1779188163, description:"World Youth Change Makers is a foundation under O&O Academy aimed at empowering youth leaders.<SEP>World Youth Change Makers is a charitable foundation supporting youth leadership transformation, established by Preethaji and Krishnaji.<SEP>World Youth Change Makers is a foundation by Preethaji and Krishnaji focused on empowering youth leaders globally.", source_id:"chunk-8539e53b3407e35921fe5963280d3207<SEP>chunk-68272ee7ebb0f34dcf88d287b8d9983d<SEP>chunk-3f7b8834c0b5fdd9d0b5f928c5733a2b", entity_id:"World Youth Change Makers"}}, {_id:1551, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)", entity_type:"content", truncate:"", description:"Corrected sentence replacing \"or\" with \"and\" for clarity.", created_at:1779217329, source_id:"chunk-543e024dcb3bd423b553a43fdaa466ba", entity_id:"Corrected Sentence 1"}}, {_id:1552, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"person", truncate:"", description:"Co-author of \"How God Changes Your Brain.\"<SEP>Co-author of \"How God Changes Your Brain\" with Dr. Andrew Newberg.<SEP>Mark Robert Waldman collaborates with Dr. Andrew Newberg in studying the effects of repetitive movements on brain function.<SEP>Mark Robert Waldman is a neuroscientist who co-authored studies on the brain's response to meditation, validating Soul Sync's impact on the vagus nerve and brain activity.`<SEP>Mark Robert Waldman is a researcher whose work supports the effects of Soul Sync on brain efficiency and memory.<SEP>Mark Robert Waldman is a co-author of studies on meditation's impact on brain efficiency and memory.<SEP>Mark Robert Waldman is a researcher who studied the neurological impacts of practices like Soul Sync.", created_at:1779183669, source_id:"chunk-4b1b158579ce0e632c723f5212472e9c<SEP>chunk-0ff8600d1eb0818e8deb9d5aab2e4351<SEP>chunk-2984b976f037a27596b29e94de8e3b21<SEP>chunk-ba8be2f785637451bf56a7dc7363715b<SEP>chunk-b694dcc1bb7e7bd6fa7878c3592e7c19<SEP>chunk-f1fcfd5a753f74e11984fed8934aec32<SEP>chunk-d2f3e8c672dcb84b8e0b2d792d3193eb", entity_id:"Mark Robert Waldman"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:1553, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"person", truncate:"", description:"Forbes contributor discussing breathing science.<SEP>Seth Porges is a science journalist referenced for his analysis of breathing techniques and their benefits.", created_at:1779188164, source_id:"chunk-4b1b158579ce0e632c723f5212472e9c<SEP>chunk-3f7b8834c0b5fdd9d0b5f928c5733a2b", entity_id:"Seth Porges"}}, {_id:1554, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"person", truncate:"", created_at:1779188244, description:"Dr. Andrew Newberg is a neuroscientist, neuropsychiatrist, and researcher whose work bridges neuroscience and the study of religious and spiritual experiences. He is best known as a co?author of the book ?How God Changes Your Brain,? which explores the neurological impact of spiritual practices. Newberg?s interdisciplinary approach has earned him recognition for linking brain function with concepts such as consciousness, meditation, and the physiological effects of religious rituals.

His research encompasses a range of topics, including the effects of meditation on brain function, breathing techniques, and the enhancement of brain efficiency through conscious repetitive hand movements. Newberg has also investigated the neurological effects of Soul Sync, a practice that combines focused attention with specific hand gestures, reporting that it can improve memory formation and overall brain performance. Additionally, he has contributed to the scientific understanding of how meditation influences neural pathways and cognitive processes.

Newberg?s scholarly output includes co?authoring research on the impact of meditation on brain function and has been cited for his studies on the physiological changes associated with spiritual practices. He is recognized for supporting the neurological effects of Soul Sync, providing evidence that such practices can enhance brain efficiency and memory. His work continues to be referenced in discussions of the intersection between neuroscience and spirituality.", source_id:"chunk-4b1b158579ce0e632c723f5212472e9c<SEP>chunk-0ff8600d1eb0818e8deb9d5aab2e4351<SEP>chunk-a2cc4d07b96d813e34cd5ee5e3d96e0d<SEP>chunk-2984b976f037a27596b29e94de8e3b21<SEP>chunk-ba8be2f785637451bf56a7dc7363715b<SEP>chunk-b694dcc1bb7e7bd6fa7878c3592e7c19<SEP>chunk-f1fcfd5a753f74e11984fed8934aec32<SEP>chunk-3f7b8834c0b5fdd9d0b5f928c5733a2b", entity_id:"Dr. Andrew Newberg"}}, {_id:1555, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"organization", truncate:"", description:"Initiatives aiming to empower youth leaders and improve lives in India.", created_at:1779145499, source_id:"chunk-4b1b158579ce0e632c723f5212472e9c", entity_id:"Youth Change Makers and One Humanity Care"}}, {_id:1556, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"content", truncate:"", description:"Book by Dr. Andrew Newberg and Mark Robert Waldman on neurotheology.<SEP>Book by Dr. Andrew Newberg and Mark Robert Waldman discussing neuroplasticity and spirituality.", created_at:1779145544, source_id:"chunk-4b1b158579ce0e632c723f5212472e9c<SEP>chunk-0ff8600d1eb0818e8deb9d5aab2e4351", entity_id:"How God Changes Your Brain"}}, {_id:1557, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"content", truncate:"", description:"Forbes article by Seth Porges on breathing's physiological effects.", created_at:1779145500, source_id:"chunk-4b1b158579ce0e632c723f5212472e9c", entity_id:"The Science of Breathing"}}, {_id:1558, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"event", truncate:"", description:"Preethaji's events blending scientific principles with spiritual practices.", created_at:1779145500, source_id:"chunk-4b1b158579ce0e632c723f5212472e9c", entity_id:"Science and Spirituality Events"}}, {_id:1560, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"person", truncate:"", description:"Author of \"Humming Bee; Normal Breathing\" in The Hindu.<SEP>Prathima Parthim Bose is a journalist cited for her work on breathing practices in The Hindu.", created_at:1779188164, source_id:"chunk-0ff8600d1eb0818e8deb9d5aab2e4351<SEP>chunk-3f7b8834c0b5fdd9d0b5f928c5733a2b", entity_id:"Prathima Parthim Bose"}}, {_id:1561, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"organization", truncate:"", description:"Publisher of \"How God Changes Your Brain\" (New York: Ballantine, 2009).", created_at:1779145544, source_id:"chunk-0ff8600d1eb0818e8deb9d5aab2e4351", entity_id:"Ballantine"}}, {_id:1562, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)", entity_type:"content", truncate:"", description:"Original sentence with incorrect use of \"or\" instead of \"and.\"", created_at:1779217329, source_id:"chunk-543e024dcb3bd423b553a43fdaa466ba<SEP>chunk-669447c66f2bd3f92a489ebe05f68fcb", entity_id:"Original Sentence 1"}}, {_id:1563, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"organization", truncate:"", description:"Indian newspaper publishing wellness-related content.", created_at:1779145545, source_id:"chunk-0ff8600d1eb0818e8deb9d5aab2e4351", entity_id:"The Hindu"}}, {_id:1564, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"content", truncate:"", description:"Article by Prathima Parthim Bose discussing breathing techniques.", created_at:1779145545, source_id:"chunk-0ff8600d1eb0818e8deb9d5aab2e4351", entity_id:"Humming Bee; Normal Breathing"}}, {_id:1565, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"content", truncate:"", description:"Book by Sri Ramakrishna containing spiritual stories and teachings.", created_at:1779145545, source_id:"chunk-0ff8600d1eb0818e8deb9d5aab2e4351", entity_id:"Tales and Parables of Sri Ramakrishna"}}, {_id:1566, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"organization", truncate:"", description:"Publisher of Sri Ramakrishna's collected works.", created_at:1779145545, source_id:"chunk-0ff8600d1eb0818e8deb9d5aab2e4351", entity_id:"Sri Ramakrishna Math"}}, {_id:1567, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"person", truncate:"", description:"Neuropsychologist and author of articles on positive neuroplasticity.<SEP>Rick Hanson is referenced in the book's content for his work on positivity and mindfulness.<SEP>A neuropsychologist who explained the brain?s neuroplasticity and the impact of repetitive thoughts.<SEP>Rick Hanson is a neuropsychologist referenced for his work on cultivating positive neural pathways.", created_at:1779188164, source_id:"chunk-0ff8600d1eb0818e8deb9d5aab2e4351<SEP>chunk-a2cc4d07b96d813e34cd5ee5e3d96e0d<SEP>chunk-d4fb27ed500b1a960390eadd6d011176<SEP>chunk-3f7b8834c0b5fdd9d0b5f928c5733a2b", entity_id:"Rick Hanson"}}, {_id:1568, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)", entity_type:"content", truncate:"", description:"Original phrase with incorrect preposition choice.", created_at:1779217352, source_id:"chunk-4dff62bd4ffb5621dd671b1f2ba93e65", entity_id:"where you escape"}}, {_id:1569, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZsPAwI)", entity_type:"content", truncate:"", description:"Corrected phrase using the appropriate preposition.", created_at:1779217352, source_id:"chunk-4dff62bd4ffb5621dd671b1f2ba93e65", entity_id:"in which you escape"}}, {_id:1570, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fdPQxZs