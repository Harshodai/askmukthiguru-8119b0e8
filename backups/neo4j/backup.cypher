UNWIND [{_id:5424, properties:{file_path:"unknown_source<SEP>YouTube Video: HZIuHUGmnGY (URL: https://www.youtube.com/watch?v=HZIuHUGmnGY)", entity_type:"concept", truncate:"", description:"True mystic is a state of being achieved by transcending limited perspectives and experiencing ultimate bliss.<SEP>True Mystic is a spiritual state achieved by moving beyond limited mental constructs and embracing universal consciousness.", created_at:1779512074, source_id:"chunk-c195d5abc160d6408ccad089d03fdf8f<SEP>chunk-5da4be811aa540e35dbc3127e30549e4", entity_id:"True Mystic"}}, {_id:5425, properties:{file_path:"unknown_source<SEP>YouTube Video: HZIuHUGmnGY (URL: https://www.youtube.com/watch?v=HZIuHUGmnGY)", entity_type:"concept", truncate:"", description:"Mental experiences are all cognitive processes that feed into the experience of bliss in enlightenment.<SEP>Mental Experience encompasses thoughts and cognitive processes that merge with sensory input to form the enlightened state.", created_at:1779512074, source_id:"chunk-c195d5abc160d6408ccad089d03fdf8f<SEP>chunk-5da4be811aa540e35dbc3127e30549e4", entity_id:"Mental Experience"}}, {_id:5426, properties:{file_path:"unknown_source<SEP>YouTube Video: yJoWk10CSjg (URL: https://www.youtube.com/watch?v=yJoWk10CSjg)", entity_type:"concept", truncate:"", description:"Mothers represent a group or archetype that seeks to transcend limitations to achieve mystical enlightenment.<SEP>Mothers symbolize nurturing and sustainability, requiring protection to address the global crisis.<SEP>Mothers symbolize nurturing and sustainability, requiring protection to address the global crisis.<SEP>Mothers symbolize nurturing and sustainability, requiring protection to address the global crisis.", created_at:1779536880, source_id:"chunk-c195d5abc160d6408ccad089d03fdf8f<SEP>chunk-773bb390e5733f45d0f03f5875cbd4a0", entity_id:"Mothers"}}, {_id:5428, properties:{file_path:"YouTube Video: HZIuHUGmnGY (URL: https://www.youtube.com/watch?v=HZIuHUGmnGY)", entity_type:"concept", truncate:"", description:"Bliss Without Reason describes an unconditional, non-projected experience of pure joy inherent to the enlightened state.", created_at:1779512074, source_id:"chunk-5da4be811aa540e35dbc3127e30549e4", entity_id:"Bliss Without Reason"}}, {_id:5429, properties:{file_path:"unknown_source<SEP>YouTube Video: R0bGNxoJ4sM (URL: https://www.youtube.com/watch?v=R0bGNxoJ4sM)", entity_type:"concept", truncate:"", description:"Early Neodo Harnam is a term mentioned in the context of the state of Oneness.<SEP>Early Neodo Harnam is a term associated with the described spiritual state, suggesting a conceptual framework or practice.", created_at:1779512108, source_id:"chunk-16505689511452878f9de53f0eb16c6e<SEP>chunk-b898618f68efd08df9f5924199c43f87", entity_id:"Early Neodo Harnam"}}, {_id:5430, properties:{file_path:"unknown_source<SEP>YouTube Video: ds6FM6QEDWM (URL: https://www.youtube.com/watch?v=ds6FM6QEDWM)", entity_type:"concept", truncate:"", description:"A state where the sense of personal identity dissolves, leaving only experiential phenomena.<SEP>A state where the sense of personal identity dissolves, leaving only experiential phenomena.<SEP>A state where the sense of personal identity dissolves, leaving only experiential phenomena.<SEP>A state where the sense of personal identity dissolves, leaving only experiences without an \"experiencer.\"", created_at:1779512402, source_id:"chunk-a0c2f5841754cfed02a33d6f3e39905a<SEP>chunk-ef58d1ac43cade418f738ee9bfcca18c", entity_id:"Absence of Individual Self"}}, {_id:5431, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A state of awareness transcending time and spatial boundaries, characterized by boundless perception.<SEP>A state of awareness transcending time and spatial boundaries, characterized by boundless perception.<SEP>A state of awareness transcending time and spatial boundaries, characterized by boundless perception.", created_at:177