UNWIND [{start: {_id:7419}, end: {_id:3894}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"compiler,spiritual teachings", weight:1.0, description:"Vyasa compiled the Brahmasutras, which are central to the Guru Purnima celebration.", created_at:1779665679, source_id:"chunk-c00a8eefe100525e46599a752324e087"}}, {start: {_id:7419}, end: {_id:3888}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", keywords:"celebration,completion", truncate:"", weight:1.0, description:"Guru Purnima celebrates the completion of the Brahmasutras by Vyasa.", created_at:1779665679, source_id:"chunk-c00a8eefe100525e46599a752324e087"}}, {start: {_id:1619}, end: {_id:7429}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", keywords:"platform content,source", truncate:"", weight:1.0, description:"The YouTube video is part of the 'Mukthi Guru' platform's content related to text corrections.", created_at:1779665679, source_id:"chunk-c00a8eefe100525e46599a752324e087"}}, {start: {_id:7419}, end: {_id:7430}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"correction,domain-specific term", weight:1.0, description:"The list includes 'Brahmasutras' as a term to be verified for correctness in the platform's texts.", created_at:1779665679, source_id:"chunk-c00a8eefe100525e46599a752324e087"}}, {start: {_id:7431}, end: {_id:3894}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"authorship,compilation,religious text,sage,spiritual authorship", weight:4.0, created_at:1779665958, description:"Vyasa compiled the Brahma-Sutras.<SEP>Vyasa compiled the Brahma-Sutras by synthesizing teachings from enlightened sages and contemporary philosophical ideas.<SEP>Vyasa compiled the Brahma-Sutras, which are central to spiritual teachings in India.<SEP>Vyasa collected and compiled the Brahma-Sutras from the teachings of enlightened sages.", source_id:"chunk-0f41e4f1e81b951f715718bd721d4f9b<SEP>chunk-8f1a363d87bc0be2ccf5c1de79b00140<SEP>chunk-85df277d52184fe481533e8c7c5ed363<SEP>chunk-25679c68ddef27fd2e2fa60d50bdcb05"}}, {start: {_id:7431}, end: {_id:717}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"philosophical content,teaching", weight:1.0, description:"The retreat incorporates teachings from the Brahma-Sutras to guide participants toward enlightenment.", created_at:1779665724, source_id:"chunk-0f5cc695879f69fa0bc7fb0810db881c"}}, {start: {_id:717}, end: {_id:7432}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"philosophical content,teaching", weight:1.0, description:"The retreat emphasizes the concept of Satyam Shivam Sundaram as a framework for experiencing sacred consciousness.", created_at:1779665724, source_id:"chunk-0f5cc695879f69fa0bc7fb0810db881c"}}, {start: {_id:717}, end: {_id:1237}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"participation,spiritual experience", weight:1.0, description:"The seeker attended the retreat, leading to a transformative experience of bliss and sacred awareness.", created_at:1779665724, source_id:"chunk-0f5cc695879f69fa0bc7fb0810db881c"}}, {start: {_id:2646}, end: {_id:7433}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"enlightenment,self-realization,spiritual initiation,spiritual practice,transformation", weight:3.0, created_at:1779666001, description:"The entrepreneur underwent a Mukti Diksha, which triggered a profound spiritual experience and enlightened states.<SEP>The entrepreneur experienced Tatvamasi during the Mukti Diksha ceremony.<SEP>The entrepreneur participated in a Mukti Diksha, leading to a profound spiritual experience and self-realization.", source_id:"chunk-e849cfea716f1fa6ab5ddfe4a147b56d<SEP>chunk-cd8bf67cc8d8498084f884afbf901342<SEP>chunk-ade616c2567b32dc9ebbc4ced1ffc773"}}, {start: {_id:7423}, end: {_id:7420}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", keywords:"identity,self-realization", truncate:"", weight:1.0, description:"Tatamasee and Ahamra are interconnected concepts representing the dissolution of ego and realization of self as universal consciousness.", created_at:1779665740, source_id:"chunk-e849cfea716f1fa6ab5ddfe4a147b56d"}}, {start: {_id:7419}, end: {_id:7435}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"cosmic truth,spiritual philosophy", weight:1.0, description:"The Brahmasutras are cited as the source of teachings about cosmic consciousness and enlightened states.", created_at:1779665740, source_id:"chunk-e849cfea716f1fa6ab5ddfe4a147b56d"}}, {start: {_id:7418}, end: {_id:7428}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"cosmic identity,enlightenment", weight:1.0, description:"Tatwa Masih and Tatparamasi are interconnected concepts describing states of ultimate realization and unity.", created_at:1779665740, source_id:"chunk-e849cfea716f1fa6ab5ddfe4a147b56d"}}, {start: {_id:2646}, end: {_id:7420}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"consciousness expansion,self-realization", weight:1.0, description:"The entrepreneur achieved the state of Tatamasee, experiencing the dissolution of ego and unity with existence.", created_at:1779665740, source_id:"chunk-e849cfea716f1fa6ab5ddfe4a147b56d"}}, {start: {_id:2646}, end: {_id:1932}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"identity dissolution,non-duality,spiritual perception,unity", weight:2.0, description:"The entrepreneur perceived the tree as an extension of himself, illustrating the breakdown of self-other boundaries.<SEP>The entrepreneur perceived himself as the tree during his experience, illustrating the \"Tatvamasi\" principle.", created_at:1779666001, source_id:"chunk-e849cfea716f1fa6ab5ddfe4a147b56d<SEP>chunk-ade616c2567b32dc9ebbc4ced1ffc773"}}, {start: {_id:7422}, end: {_id:7420}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"collective consciousness,cosmic unity", weight:1.0, description:"Tatamasee and Massmen together describe the experience of merging individual identity with universal consciousness.", created_at:1779665740, source_id:"chunk-e849cfea716f1fa6ab5ddfe4a147b56d"}}, {start: {_id:2646}, end: {_id:7434}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"non-duality,unity", weight:1.0, description:"The entrepreneur felt the fellow seeker as part of his own consciousness, reflecting the \"You are that\" principle.", created_at:1779665740, source_id:"chunk-e849cfea716f1fa6ab5ddfe4a147b56d"}}, {start: {_id:2646}, end: {_id:7436}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"enlightenment,spiritual state", weight:1.0, description:"The entrepreneur is described as living in a great state of being even after a decade, indicating sustained enlightenment.", created_at:1779665740, source_id:"chunk-e849cfea716f1fa6ab5ddfe4a147b56d"}}, {start: {_id:7422}, end: {_id:348}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"content analysis,linguistic ambiguity", weight:1.0, description:"The YouTube Video contains the ambiguous term \"Massmen\" requiring interpretation.", created_at:1779665761, source_id:"chunk-b581d80fb3e1672b9184e7ccb9a394ea"}}, {start: {_id:7420}, end: {_id:7437}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"conceptual reference,correction,phonetic mishearing,spelling,terminology", weight:3.0, created_at:1779665895, description:"\"Tatamasee\" appears to be a phonetic error referencing the philosophical concept \"Tatvamasi.\"<SEP>Original mishearing \"Tatamasee\" corrected to philosophical term \"Tatvamasi.\"<SEP>\"Tatamasee\" revised to \"Tatvamasi\".", source_id:"chunk-b581d80fb3e1672b9184e7ccb9a394ea<SEP>chunk-312a7e6dcdab5fa1268941f1387c1ed0<SEP>chunk-e0651d1d759d9ec9887e923e28bd51f5"}}, {start: {_id:7422}, end: {_id:7438}, properties:{file_path:"YouTube Video: oaKWpxmu0YI (URL: https://www.youtube.com/watch?v=oaKWpxmu0YI)", truncate:"", keywords:"interpretation challenge,linguistic uncertainty", weight:1.0, description:"\"Massmen\" exemplifies transcription error ambiguity in the context of possible corrections.", created_at:1779665761, source_id:"chunk-b581d80fb3e1672b9184e7ccb9a394ea"}}] AS row
