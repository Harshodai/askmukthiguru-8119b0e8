UNWIND [{_id:7201, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", created_at:1779661704, description:"Faith-driven describes a state of being characterized by spiritual motivation and alignment with divine principles following transcendental experiences.<SEP>A descriptor indicating actions or phrases are motivated by faith.<SEP>A state of being guided by spiritual faith and trust after transcendental experiences.", source_id:"chunk-2fad0fbe65ec4abc3eb5db49059e7a50<SEP>chunk-355c42e8aaaf893df441489ff3a44b86<SEP>chunk-9f245e3153d92a2c38134afd812338bf", entity_id:"Faith-Driven"}}, {_id:7203, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", description:"A broad category of spiritual experiences, including transformation and enlightenment types.", created_at:1779661499, source_id:"chunk-355c42e8aaaf893df441489ff3a44b86", entity_id:"Transcendental Experience"}}, {_id:7204, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", created_at:1779661704, description:"Emotional states associated with transformation experiences.<SEP>Abstract concepts representing themes of empathy and interconnectedness discussed in the video.<SEP>A state of unconditional love and compassion achieved through transcendental experiences.", source_id:"chunk-355c42e8aaaf893df441489ff3a44b86<SEP>chunk-3589746193d218d51479dd14e70466b0<SEP>chunk-9f245e3153d92a2c38134afd812338bf", entity_id:"Love and Compassion"}}, {_id:7205, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", description:"A non-standard phrase mentioned in the context of transformation experiences, possibly referring to a state of cause and effect.", created_at:1779661499, source_id:"chunk-355c42e8aaaf893df441489ff3a44b86", entity_id:"Space of Cause"}}, {_id:7206, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"content", truncate:"", description:"HELtP96Dd4w is a YouTube video discussing themes of consciousness, spirituality, and self-transformation, with references to metaphors like \"joules of electricity\" and concepts like \"non-duality\".", created_at:1779661517, source_id:"chunk-3589746193d218d51479dd14e70466b0", entity_id:"HELtP96Dd4w"}}, {_id:7208, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"naturalobject", truncate:"", description:"Unit of energy used metaphorically in the video to describe spiritual or emotional intensity.", created_at:1779661517, source_id:"chunk-3589746193d218d51479dd14e70466b0", entity_id:"Joules"}}, {_id:7209, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", description:"Metaphorical representation of spiritual energy or awareness surging through individuals.<SEP>An energy or current surging during enlightenment, connecting the seeker to universal consciousness.", created_at:1779661704, source_id:"chunk-3589746193d218d51479dd14e70466b0<SEP>chunk-9f245e3153d92a2c38134afd812338bf", entity_id:"Spiritual Current"}}, {_id:7210, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", created_at:1779661704, description:"State of heightened awareness and perception discussed in the video.<SEP>Extraordinary consciousness is a concept discussed in the original text, possibly a term for a state of awareness.<SEP>An elevated state of awareness and perception beyond ordinary human limits.", source_id:"chunk-3589746193d218d51479dd14e70466b0<SEP>chunk-6a8eb45ded9794e4df68146dcf6df106<SEP>chunk-9f245e3153d92a2c38134afd812338bf", entity_id:"Extraordinary Consciousness"}}, {_id:7211, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", description:"Philosophical concept referring to the unity of opposites or transcendence of dualistic thinking.<SEP>A philosophical state where distinctions between self and universe dissolve, achieved through enlightenment.", created_at:1779661705, source_id:"chunk-3589746193d218d51479dd14e70466b0<SEP>chunk-9f245e3153d92a2c38134afd812338bf", entity_id:"Non-Duality"}}, {_id:7212, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", description:"A phrase describing something done on a large scale or in a significant way.<SEP>Massive manner is a concept, corrected to be replaced by the adverb \"massively\" for better flow.", created_at:1779661654, source_id:"chunk-c0e4fdfc7ee5eb3e5b9c6befee06c664<SEP>chunk-6a8eb45ded9794e4df68146dcf6df106", entity_id:"Massive Manner"}}, {_id:7213, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", description:"An adverb indicating something done to a large extent or in a significant manner.<SEP>The corrected version of the adverbial phrase, in proper adverb form.", created_at:1779661676, source_id:"chunk-c0e4fdfc7ee5eb3e5b9c6befee06c664<SEP>chunk-bb98fef15e9b88e4048dd1b159bc2a6c", entity_id:"Massively"}}, {_id:7214, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", description:"Transformational experience is a concept, the context of which involves the activation of neurons in the heart.<SEP>Transformational experience involves the activation of neurons in the heart in a massive manner during spiritual seekers' profound changes.", created_at:1779661775, source_id:"chunk-6a8eb45ded9794e4df68146dcf6df106<SEP>chunk-84fe7edeb817f0143052c09f97b672fc", entity_id:"Transformational Experience"}}, {_id:7215, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"person", truncate:"", created_at:1779661822, description:"The original punctuation in \"Prieta G, and I believe\" is corrected to \"Prieta G and I believe\" for better readability.<SEP>The corrected version of the phrase, removing the unnecessary comma.<SEP>Prieta G and I believe is a corrected phrase from the original text.", source_id:"chunk-c0e4fdfc7ee5eb3e5b9c6befee06c664<SEP>chunk-bb98fef15e9b88e4048dd1b159bc2a6c<SEP>chunk-2513ead52ad2bbf56e47a3233d1a61cb", entity_id:"Prieta G and I believe"}}, {_id:7216, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"person", truncate:"", description:"The original punctuation in \"Prieta G, and I believe\" is corrected to \"Prieta G and I believe\" for better readability.<SEP>Prieta G and I believe is a corrected phrase from the original text.", created_at:1779661822, source_id:"chunk-c0e4fdfc7ee5eb3e5b9c6befee06c664<SEP>chunk-2513ead52ad2bbf56e47a3233d1a61cb", entity_id:"Prieta G, and I believe"}}, {_id:7217, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", description:"The original anatomical term that was corrected for clarity.", created_at:1779661676, source_id:"chunk-bb98fef15e9b88e4048dd1b159bc2a6c", entity_id:"Third eye"}}, {_id:7218, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", description:"The original grammatical phrase that was corrected to \"Everyone\".", created_at:1779661676, source_id:"chunk-bb98fef15e9b88e4048dd1b159bc2a6c", entity_id:"Every one"}}, {_id:7219, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", description:"The corrected version of the anatomical term, specifying location.", created_at:1779661676, source_id:"chunk-bb98fef15e9b88e4048dd1b159bc2a6c", entity_id:"Middle of your eyebrows"}}, {_id:7220, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", description:"The original adverbial phrase that was corrected to \"massively\".", created_at:1779661676, source_id:"chunk-bb98fef15e9b88e4048dd1b159bc2a6c", entity_id:"Massive manner"}}, {_id:7221, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", created_at:1779661853, description:"Mystical Dimension is a dimension beyond the mind, revealed during a mystical experience.`<SEP>A mystical dimension that opens up during transcendental experiences, revealing sacred aspects of reality.<SEP>The mystical dimension is a metaphysical realm that opens during spiritual activation of the pineal gland.", source_id:"chunk-71c647fd13898f185a71091bf9fbd510<SEP>chunk-9f245e3153d92a2c38134afd812338bf<SEP>chunk-b787fee503789ccf5420cfc0f4003e6b", entity_id:"Mystical Dimension"}}, {_id:7222, properties:{file_path:"YouTube Video: HELtP96Dd4w (URL: https://www.youtube.com/watch?v=HELtP96Dd4w)", entity_type:"concept", truncate:"", created_at:1779661853, description:"Sacred Dimension is a dimension of the divine, revealed during a mystical experience.`<SEP>A sacred dimension revealed through transcendental experiences, associated with spiritual awakening.<SEP>The sacred dimension represents a transcendent reality revealed through mystical experiences.", source_id:"chunk-71c647fd13898f185a71091bf9fbd510<SEP>chunk-9f245e3153d92a2c38134afd812338bf<SEP>chunk-b787fee503789ccf5420cfc0f4003e6b", entity_id:"Sacred Dimension"}}] AS row
