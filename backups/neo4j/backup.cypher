UNWIND [{start: {_id:3413}, end: {_id:3412}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", keywords:"effectiveness,philosophy", truncate:"", weight:3.0, description:"Ancient ceremonies were effective due to the ancient people's philosophy that considered life after death as a fact.<SEP>Ancient ceremonies were effective because the ancient people's philosophy considered life after death as a fact.", created_at:1779228940, source_id:"chunk-ff31f73b2ef0618c73b0f438087fdec4"}}, {start: {_id:3198}, end: {_id:3414}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", keywords:"gift,spiritual offering", truncate:"", weight:1.0, description:"Ekam circles offer the gift of releasing the departed as part of their spiritual practices.", created_at:1779228940, source_id:"chunk-ff31f73b2ef0618c73b0f438087fdec4"}}, {start: {_id:3166}, end: {_id:3415}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", keywords:"gift,spiritual offering", truncate:"", weight:1.0, description:"Ekam Circles offer the gift of releasing the departed as part of their spiritual practices.", created_at:1779228940, source_id:"chunk-ff31f73b2ef0618c73b0f438087fdec4"}}, {start: {_id:3413}, end: {_id:3329}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", keywords:"intuition,practitioners", truncate:"", weight:1.0, description:"Ancient ceremonies were effective because the priests could intuit other worlds.", created_at:1779228941, source_id:"chunk-ff31f73b2ef0618c73b0f438087fdec4"}}, {start: {_id:3403}, end: {_id:3178}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"ancestral veneration,cultural practices", weight:1.0, description:"Both Obon and Ghost Festival are traditions honoring the deceased, reflecting cultural approaches to ancestral connection.", created_at:1779228978, source_id:"chunk-7fd3191dae6c1c66321a24ecdfc2f30a"}}, {start: {_id:3184}, end: {_id:3421}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"spiritual departure,transitional journey", weight:1.0, description:"Mahaprasthana signifies the process of death as a transition to the afterlife.", created_at:1779228978, source_id:"chunk-7fd3191dae6c1c66321a24ecdfc2f30a"}}, {start: {_id:3193}, end: {_id:3423}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"companionship,shared purpose", weight:1.0, description:"Ekam mitras are companions who undertake a spiritual journey together, supporting mutual growth.", created_at:1779228978, source_id:"chunk-7fd3191dae6c1c66321a24ecdfc2f30a"}}, {start: {_id:3417}, end: {_id:3424}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"ancestral presence,resting place", weight:1.0, description:"Tombs serve as physical repositories for the departed, maintaining their presence in the material world.", created_at:1779228978, source_id:"chunk-7fd3191dae6c1c66321a24ecdfc2f30a"}}, {start: {_id:3280}, end: {_id:3422}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"astronomical event,spiritual symbolism", weight:1.0, description:"Mahal-e-amavasya is a term associated with lunar eclipses, holding spiritual and cultural significance.", created_at:1779228978, source_id:"chunk-7fd3191dae6c1c66321a24ecdfc2f30a"}}, {start: {_id:3260}, end: {_id:3425}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"historical context,temporal boundary", weight:1.0, description:"Ancient cultures predating Emperor Constantine's era believed in life after death.", created_at:1779229064, source_id:"chunk-5a061c3e192c4aaa5026aa79274bb0f1"}}, {start: {_id:3274}, end: {_id:3204}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", keywords:"cultural practice,ritual", truncate:"", weight:1.0, description:"Born is a festival to honor and revere ancestors in Japanese culture.", created_at:1779229064, source_id:"chunk-5a061c3e192c4aaa5026aa79274bb0f1"}}, {start: {_id:3274}, end: {_id:3169}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", keywords:"cultural practice,ritual", truncate:"", weight:1.0, description:"Chisok is a Korean festival for honoring ancestors.", created_at:1779229064, source_id:"chunk-5a061c3e192c4aaa5026aa79274bb0f1"}}, {start: {_id:3274}, end: {_id:3168}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", keywords:"cultural practice,ritual", truncate:"", weight:1.0, description:"Kinmen involves cleaning ancestral tombs and offering gratitude in Chinese tradition.", created_at:1779229064, source_id:"chunk-5a061c3e192c4aaa5026aa79274bb0f1"}}, {start: {_id:3260}, end: {_id:3428}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"cultural practices,spiritual beliefs", weight:1.0, description:"Ancient cultures dissolved destructive vasanas through ancestral rituals like samskaras.", created_at:1779229139, source_id:"chunk-7ac9109abdb5bdc9de2685e960e358c1"}}, {start: {_id:3332}, end: {_id:3260}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"ancestral veneration,rituals", weight:1.0, description:"Ancient Hindus performed ancestral samskaras to address ancestral spirits.", created_at:1779229139, source_id:"chunk-7ac9109abdb5bdc9de2685e960e358c1"}}, {start: {_id:3432}, end: {_id:3178}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"ancestral connection,cultural reverence", weight:1.0, description:"Obon honors ancestors, reflecting their enduring spiritual presence.", created_at:1779229187, source_id:"chunk-dd4f29607e86446996b5a0f4d31130d7"}}, {start: {_id:3169}, end: {_id:3432}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"ancestral release,ritual observance", weight:1.0, description:"Chisok facilitates the release of departed souls stuck on the earthly plane.", created_at:1779229187, source_id:"chunk-dd4f29607e86446996b5a0f4d31130d7"}}, {start: {_id:3434}, end: {_id:3433}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"energy dissolution,health impact", weight:1.0, description:"Health problems dissolve as stuck energy is cleared through the departed's peaceful transition.", created_at:1779229187, source_id:"chunk-dd4f29607e86446996b5a0f4d31130d7"}}, {start: {_id:3430}, end: {_id:3435}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"conceptual connection,spiritual transition", weight:1.0, description:"The experience involves liberation and emotional release when the departed transition peacefully, dissolving obstacles and health issues.", created_at:1779229187, source_id:"chunk-dd4f29607e86446996b5a0f4d31130d7"}}, {start: {_id:3432}, end: {_id:3403}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"ancestral gratitude,tomb maintenance", weight:1.0, description:"Ghost Festival involves cleaning tombs and offering gratitude to ancestors.", created_at:1779229188, source_id:"chunk-dd4f29607e86446996b5a0f4d31130d7"}}] AS row
