ed_at:1779178932, source_id:"chunk-01203a1e0e707c01ca21f28b8ce5261d", entity_id:"co-working space"}}, {_id:2710, properties:{file_path:"unknown_source", entity_type:"artifact", truncate:"", description:"marketing support includes promotional assistance offered by the organization to the start-up.", created_at:1779178932, source_id:"chunk-01203a1e0e707c01ca21f28b8ce5261d", entity_id:"marketing support"}}, {_id:2711, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"business impact highlights the influence of transformed consciousness on professional success and organizational outcomes.", created_at:1779178932, source_id:"chunk-01203a1e0e707c01ca21f28b8ce5261d", entity_id:"business impact"}}, {_id:2712, properties:{file_path:"unknown_source", entity_type:"artifact", truncate:"", description:"audio guide is a digital resource led by Preethaji to guide practitioners through the Soul Sync process.", created_at:1779178932, source_id:"chunk-01203a1e0e707c01ca21f28b8ce5261d", entity_id:"audio guide"}}, {_id:2713, properties:{file_path:"unknown_source", entity_type:"artifact", truncate:"", description:"app is a digital platform hosting the audio guide for the Great Soul Sync practice.", created_at:1779178933, source_id:"chunk-01203a1e0e707c01ca21f28b8ce5261d", entity_id:"app"}}, {_id:2714, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Business success is linked to emotional healing, as seen in Andrew?s improved professional performance post-forgiveness.<SEP>The gentleman's professional achievements, attributed to his mother's influence and internal conflict.", created_at:1779231672, source_id:"chunk-25634a7e16db511e9e5b4a8597da99fd<SEP>chunk-95ede5878070f28d1b63e5213e0a1f6e", entity_id:"Business Success"}}, {_id:2715, properties:{file_path:"unknown_source", entity_type:"person", truncate:"", description:"Jaya's mother is described as abusive and alcoholic, contributing to Jaya's traumatic childhood.", created_at:1779179021, source_id:"chunk-697da9f4d9cac1cfedd243857a8b8ccc", entity_id:"Abusive, alcoholic mother"}}, {_id:2716, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"other", truncate:"", description:"Loved ones of participants who give up addictions when impacted by their transformations.", created_at:1779224868, source_id:"chunk-60c3c70200e066b81d62b44f1233373d<SEP>chunk-f3c9a2b1053591399fd7351098da3627", entity_id:"loved ones"}}, {_id:2718, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"UNKNOWN", truncate:"", description:"Loved ones give up addictions when impacted by the transformations of participants.", created_at:1779224868, source_id:"chunk-f3c9a2b1053591399fd7351098da3627", entity_id:"participants (people who come to Ekam)"}}, {_id:2719, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)<SEP>YouTube Video: odNtpKqbCQo (URL: https://www.youtube.com/watch?v=odNtpKqbCQo)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", entity_type:"concept", truncate:"", created_at:1779673216, description:"Instructions emphasize addressing domain-specific terms alongside general errors (though the specific list is missing).<SEP>The instructions emphasize strict adherence to error correction without summarization, invention, or style rewriting.<SEP>Guidelines to correct text without summarizing or rewriting the style, focusing on error correction.", source_id:"chunk-782fc68234c609b298ab73b8f6469f59<SEP>chunk-270244bc8f269958a2c5fc40e2746175<SEP>chunk-1625d2a99ff17f15ce8a139663adfc1b", entity_id:"Instructions"}}, {_id:2720, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8mmungGgDNw)", entity_type:"data", truncate:"", description:"National statistic showing over 14 million alcohol addicts in India.", created_at:1779224948, source_id:"chunk-29187c924e9a374fb8f3996bb7bb3fb9", entity_id:"14 Million Alcohol Addicts in India"}}, {_id:2721, properties:{file_path:"unknown_source", entity_type:"organization", truncate:"", description:"Jaya's team members are part of her professional organization, affected by her leadership style.", created_at:1779179022, source_id:"chunk-697da9f4d9cac1cfedd243857a8b8ccc", entity_id:"Team members"}}] AS row
