UNWIND [{start: {_id:1052}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"conflict resolution,empathic understanding", weight:1.0, description:"Sunil gains insight into his daughter's", created_at:1779141340, source_id:"chunk-f8449165361188bfe6afa260ab623922"}}, {start: {_id:1060}, end: {_id:1059}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"necessity,requirement", truncate:"", weight:1.0, description:"The journey into truth requires courage and passion to undertake.", created_at:1779141391, source_id:"chunk-6159dcadf48bbe1bd234217f23bacc7b"}}, {start: {_id:1053}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"employee well-being,workplace focus", truncate:"", weight:1.0, description:"Sunil prioritizes enhancing the happiness of his employees at work.", created_at:1779141391, source_id:"chunk-6159dcadf48bbe1bd234217f23bacc7b"}}, {start: {_id:1059}, end: {_id:1058}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"contrast,exclusion", truncate:"", weight:1.0, description:"The journey into truth is not for lackadaisical lovers seeking instant gratification.", created_at:1779141391, source_id:"chunk-6159dcadf48bbe1bd234217f23bacc7b"}}, {start: {_id:1057}, end: {_id:1059}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"contrast,rejection", truncate:"", weight:1.0, description:"The journey into truth does not cater to those seeking instant gratification.", created_at:1779141391, source_id:"chunk-6159dcadf48bbe1bd234217f23bacc7b"}}, {start: {_id:1061}, end: {_id:1064}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"components,human existence", truncate:"", weight:1.0, description:"Survival is listed as a key component of the essence of being human.", created_at:1779141431, source_id:"chunk-3324f1848f747970d99d374e6a692e91"}}, {start: {_id:1063}, end: {_id:1061}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"components,human existence", truncate:"", weight:1.0, description:"Ambition is presented as a defining aspect of human identity and purpose.", created_at:1779141431, source_id:"chunk-3324f1848f747970d99d374e6a692e91"}}, {start: {_id:1061}, end: {_id:1065}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"components,human existence", truncate:"", weight:1.0, description:"Procreation is noted as a biological and societal element of humanity.", created_at:1779141431, source_id:"chunk-3324f1848f747970d99d374e6a692e91"}}, {start: {_id:1061}, end: {_id:1066}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"components,human existence", truncate:"", weight:1.0, description:"Growing old is acknowledged as an inevitable part of the human experience.", created_at:1779141432, source_id:"chunk-3324f1848f747970d99d374e6a692e91"}}, {start: {_id:909}, end: {_id:344}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional support,mindfulness", truncate:"", weight:1.0, description:"Presence fosters empathy by mindfully engaging with others' emotional states.", created_at:1779141474, source_id:"chunk-ff2be9cdc909be640e9aaf71298fc4c9"}}, {start: {_id:1069}, end: {_id:176}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conceptual foundation,familial bonds,family dynamics,spiritual connection", truncate:"", weight:4.0, description:"Nurturing a spiritual vision fosters a sense of connected family.<SEP>Spiritual Vision provides the foundation for understanding and nurturing a connected family dynamic.", created_at:1779141521, source_id:"chunk-ff2be9cdc909be640e9aaf71298fc4c9<SEP>chunk-0b04862bafff71350f55c66ef6226d43"}}, {start: {_id:284}, end: {_id:1070}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"healing,transformation", truncate:"", weight:1.0, description:"Connection diminishes relational distance and initiates healing, even in historically wounded relationships.", created_at:1779141475, source_id:"chunk-ff2be9cdc909be640e9aaf71298fc4c9"}}, {start: {_id:591}, end: {_id:299}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"existence,purpose", truncate:"", weight:2.0, description:"Love is integral to the purpose and essence of human life.", created_at:1779141475, source_id:"chunk-ff2be9cdc909be640e9aaf71298fc4c9"}}, {start: {_id:399}, end: {_id:284}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"causality,transformation", truncate:"", weight:2.0, description:"Connection leads to authentic transformation by shifting from self-absorption.", created_at:1779141475, source_id:"chunk-ff2be9cdc909be640e9aaf71298fc4c9"}}, {start: {_id:1072}, end: {_id:464}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional connection,practice application", weight:2.0, description:"Soul Sync Exercise is used to build stronger, loving relationships through intentional daily practice.", created_at:1779141521, source_id:"chunk-0b04862bafff71350f55c66ef6226d43"}}, {start: {_id:1071}, end: {_id:176}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"environmental connection,interconnectedness", weight:2.0, description:"Spiritual Vision emphasizes the interdependence between humans and the Earth, fostering ecological reverence.", created_at:1779141521, source_id:"chunk-0b04862bafff71350f55c66ef6226d43"}}, {start: {_id:533}, end: {_id:176}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"ethical outcome,life reverence", truncate:"", weight:2.0, description:"Spiritual Vision cultivates compassion for all life forms, transforming human behavior and societal norms.<SEP>Spiritual Vision fosters compassion for all life forms.", created_at:1779141521, source_id:"chunk-0b04862bafff71350f55c66ef6226d43"}}, {start: {_id:176}, end: {_id:25}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"behavioral impact,societal change", truncate:"", weight:1.0, description:"Spiritual Vision leads to transformative changes in human behavior and societal norms.", created_at:1779141521, source_id:"chunk-0b04862bafff71350f55c66ef6226d43"}}, {start: {_id:1074}, end: {_id:4}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"advocacy,content", truncate:"", weight:1.0, description:"The text emphasizes the importance of deep, transformative love in relationships.", created_at:1779141560, source_id:"chunk-a982ea596b48b390924063ff39da67f6"}}, {start: {_id:17}, end: {_id:1073}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"contribution,support", truncate:"", weight:1.0, description:"Krishnaji provides unconditional acceptance, enabling present peace and self-acceptance.", created_at:1779141560, source_id:"chunk-a982ea596b48b390924063ff39da67f6"}}] AS row
