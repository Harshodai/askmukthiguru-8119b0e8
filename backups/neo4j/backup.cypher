UNWIND [{start: {_id:299}, end: {_id:146}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=GfAMCHC6_ek)", truncate:"", keywords:"dissolving suffering,nurturing love", weight:1.0, description:"Dissolving suffering states enables nurturing and experiencing love.", created_at:1779247571, source_id:"chunk-d1580b380e66d60231e8bb1500c438e9"}}, {start: {_id:710}, end: {_id:299}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=GfAMCHC6_ek)", truncate:"", keywords:"emotional barrier,lack of connection,love shown,not experienced", weight:2.0, description:"Love shown to someone in a disconnected state is not experienced by them.<SEP>Love shown to someone in a disconnected state is not experienced by them due to emotional barriers.", created_at:1779248217, source_id:"chunk-d1580b380e66d60231e8bb1500c438e9<SEP>chunk-69c518552350983af20c342ffe0b1ce1"}}, {start: {_id:2207}, end: {_id:25}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=GfAMCHC6_ek)", keywords:"evolution,personal change", truncate:"", weight:1.0, description:"Transformation involves personal change in individuals.", created_at:1779247666, source_id:"chunk-9ddc02204a9aadcf3798e7d91145533d"}}, {start: {_id:3949}, end: {_id:299}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=GfAMCHC6_ek)", truncate:"", keywords:"chemical release,physiological response", weight:1.0, description:"Love causes the release of chemicals in the body.", created_at:1779247666, source_id:"chunk-9ddc02204a9aadcf3798e7d91145533d"}}, {start: {_id:3949}, end: {_id:3948}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=GfAMCHC6_ek)", truncate:"", keywords:"emotional response,neurological effect", weight:1.0, description:"Chemicals released lead to feelings of euphoria.", created_at:1779247666, source_id:"chunk-9ddc02204a9aadcf3798e7d91145533d"}}, {start: {_id:2160}, end: