ated_at:1779519277, source_id:"chunk-39252be9066242f35311d64c382dc3da"}}, {start: {_id:410}, end: {_id:5574}, properties:{file_path:"YouTube Video: d0v8RE6i0GM (URL: https://www.youtube.com/watch?v=d0v8RE6i0GM)", truncate:"", keywords:"digital immersion,platform contribution", weight:2.0, description:"Facebook contributes to the labyrinth world of the internet through prolonged user engagement.<SEP>Facebook contributes to the labyrinth world of the internet through prolonged user engagement.", created_at:1779519277, source_id:"chunk-39252be9066242f35311d64c382dc3da"}}, {start: {_id:753}, end: {_id:5575}, properties:{file_path:"YouTube Video: d0v8RE6i0GM (URL: https://www.youtube.com/watch?v=d0v8RE6i0GM)", truncate:"", keywords:"collective well-being,social goal", weight:2.0, description:"Harmony is a societal goal promoting mutual care and emotional connection.<SEP>Harmony is a societal goal promoting mutual care and emotional connection.", created_at:1779519277, source_id:"chunk-39252be9066242f35311d64c382dc3da"}}, {start: {_id:5574}, end: {_id:5570}, properties:{file_path:"YouTube Video: d0v8RE6i0GM (URL: https://www.youtube.com/watch?v=d0v8RE6i0GM)", truncate:"", keywords:"digital immersion,platform contribution", weight:2.0, description:"Netflix contributes to the labyrinth world of the internet through prolonged user engagement.<SEP>Netflix contributes to the labyrinth world of the internet through prolonged user engagement.", created_at:1779519277, source_id:"chunk-39252be9066242f35311d64c382dc3da"}}, {start: {_id:155}, end: {_id:1336}, properties:{file_path:"unknown_source<SEP>YouTube Video: XFFgRTgP8Rs (URL: https://www.youtube.com/watch?v=XFFgRTgP8Rs)", keywords:"connection,focus,origin,root cause", truncate:"", weight:2.0, description:"The problem (e.g., scoring a B) is linked to self-image, as the emotional response stems from self-perception rather than the event itself.<SEP>The problem is rooted in self-image fixation rather than the immediate challenge.", created_at:1779519365, source_id:"chunk-6202900249469971e378d57b74b99662<SEP>chunk-87e2f7787298d3205ec139c556ef83c0"}}, {start: {_id:5576}, end: {_id:1336}, properties:{file_path:"YouTube Video: XFFgRTgP8Rs (URL: https://www.youtube.com/watch?v=XFFgRTgP8Rs)", keywords:"dependency,vulnerability", truncate:"", weight:1.0, description:"Future plans are fragilely tied to self-image, making them susceptible to disruption.", created_at:1779519365, source_id:"chunk-87e2f7787298d3205ec139c556ef83c0"}}, {start: {_id:852}, end: {_id:1336}, properties:{file_path:"YouTube Video: XFFgRTgP8Rs (URL: https://www.youtube.com/watch?v=XFFgRTgP8Rs)", keywords:"consequence,projection", truncate:"", weight:1.0, description:"Fear emerges from self-image-driven anxieties about future outcomes.", created_at:1779519395, source_id:"chunk-87e2f7787298d3205ec139c556ef83c0"}}, {start: {_id:951}, end: {_id:1336}, properties:{file_path:"YouTube Video: XFFgRTgP8Rs (URL: https://www.youtube.com/watch?v=XFFgRTgP8Rs)", truncate:"", keywords:"consequence,emotional response", weight:1.0, description:"Hurt is a direct emotional consequence of perceived self-image failure.", created_at:1779519412, source_id:"chunk-87e2f7787298d3205ec139c556ef83c0"}}, {start: {_id:852}, end: {_id:707}, properties:{file_path:"YouTube Video: XFFgRTgP8Rs (URL: https://www.youtube.com/watch?v=XFFgRTgP8Rs)", keywords:"dissolution,resolution", truncate:"", weight:1.0, description:"Truth dissolves fear by removing the uncertainty about one's self-image.", created_at:1779519413, source_id:"chunk-d305977f98ef25807e2b5a0d7a24ce2c"}}, {start: {_id:1336}, end: {_id:707}, properties:{file_path:"YouTube Video: XFFgRTgP8Rs (URL: https://www.youtube.com/watch?v=XFFgRTgP8Rs)", keywords:"reality,self-perception", truncate:"", weight:1.0, description:"Self-Image relates to Truth as one's perception must align with reality to resolve issues.", created_at:1779519413, source_id:"chunk-d305977f98ef25807e2b5a0d7a24ce2c"}}, {start: {_id:5578},