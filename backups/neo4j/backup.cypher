UNWIND [{start: {_id:5402}, end: {_id:2390}, properties:{file_path:"unknown_source", keywords:"consciousness study,mystic science", truncate:"", weight:1.0, description:"Spirituality emphasizes the awakening of consciousness as a core component of its principles.", created_at:1779511102, source_id:"chunk-eb1bcec2ec4775f87f2a9dcf795a907a"}}, {start: {_id:2390}, end: {_id:5405}, properties:{file_path:"unknown_source", keywords:"learning,understanding", truncate:"", weight:1.0, description:"Spirituality involves learning the why of unhappiness through the awakening of consciousness.", created_at:1779511102, source_id:"chunk-eb1bcec2ec4775f87f2a9dcf795a907a"}}, {start: {_id:5406}, end: {_id:2390}, properties:{file_path:"unknown_source", keywords:"learning,method", truncate:"", weight:1.0, description:"Spirituality teaches the how of liberation as part of", created_at:1779511102, source_id:"chunk-eb1bcec2ec4775f87f2a9dcf795a907a"}}, {start: {_id:5409}, end: {_id:2390}, properties:{file_path:"YouTube Video: uSAO5p0GIU8 (URL: https://www.youtube.com/watch?v=uSAO5p0GIU8)", truncate:"", keywords:"consciousness awakening,mystic science", weight:1.0, description:"Spirituality is described as a mystic science of consciousness and its awakening.", created_at:1779511790, source_id:"chunk-1d721d9fcd5e561bfe9353bb3e49e8a1"}}, {start: {_id:192}, end: {_id:2390}, properties:{file_path:"YouTube Video: uSAO5p0GIU8 (URL: https://www.youtube.com/watch?v=uSAO5p0GIU8)", truncate:"", keywords:"stress relief,transformation", weight:1.0, description:"Aims to transform personal experience by removing stress, fear, and frustration.", created_at:1779511790, source_id:"chunk-1d721d9fcd5e561bfe9353bb3e49e8a1"}}, {start: {_id:1480}, end: {_id:2390}, properties:{file_path:"YouTube Video: uSAO5p0GIU8 (URL: https://www.youtube.com/watch?v=uSAO5p0GIU8)", keywords:"awakening,enlightenment", truncate:"", weight:1.0, description:"Seeks to awaken individuals to enlightened states influencing external circumstances.", created_at:1779511790, source_id:"chunk-1d721d9fcd5e561bfe9353bb3e49e8a1"}}, {start: {_id:5413}, end: {_id:5412}, properties:{file_path:"unknown_source<SEP>YouTube Video: 4Fjf6IQsjQs (URL: https://www.youtube.com/watch?v=4Fjf6IQsjQs)", keywords:"biological intelligence,biological systems,encompasses,intelligence manifestation", truncate:"", weight:2.0, description:"The intelligent universe includes single-cell organisms as part of its biological intelligence.<SEP>Single-cell organisms are part of the intelligent universe, demonstrating intelligence at the microscopic level.", created_at:1779511912, source_id:"chunk-3a9b1e90fab2bdbcbb151bc873bcb657<SEP>chunk-55cc26bf031f0db4fced411b5d43e45c"}}, {start: {_id:3896}, end: {_id:5413}, properties:{file_path:"unknown_source<SEP>YouTube Video: 4Fjf6IQsjQs (URL: https://www.youtube.com/watch?v=4Fjf6IQsjQs)", keywords:"cosmic intelligence,encompasses,structural complexity", truncate:"", weight:2.0, description:"The intelligent universe extends to galaxies as part of its cosmic intelligent framework.<SEP>Galaxies reflect the universe's intelligence through their organized and dynamic nature.", created_at:1779511912, source_id:"chunk-3a9b1e90fab2bdbcbb151bc873bcb657<SEP>chunk-55cc26bf031f0db4fced411b5d43e45c"}}, {start: {_id:5413}, end: {_id:4019}, properties:{file_path:"unknown_source<SEP>YouTube Video: 4Fjf6IQsjQs (URL: https://www.youtube.com/watch?v=4Fjf6IQsjQs)", keywords:"celestial intelligence,encompasses,energy systems", truncate:"", weight:2.0, description:"Stars are included in the universe's intelligent celestial structures.<SEP>Stars embody intelligence through their nuclear processes and role in sustaining life.", created_at:1779511913, source_id:"chunk-3a9b1e90fab2bdbcbb151bc873bcb657<SEP>chunk-55cc26bf031f0db4fced411b5d43e45c"}}, {start: {_id:1799}, end: {_id:5413}, properties:{file_path:"unknown_source<SEP>YouTube Video: 4Fjf6IQsjQs (URL: https://www.youtube.com/watch?v=4Fjf6IQsjQs)", truncate:"", keywords:"conscious utilization,problem-solving,tapping into intelligence", weight:2.0, description:"Human beings can access the universe's intelligence to address challenges and create enlightenment.<SEP>Human beings interact with the intelligent universe by harnessing its intelligence for enlightenment and addressing challenges.", created_at:1779511913, source_id:"chunk-3a9b1e90fab2bdbcbb151bc873bcb657<SEP>chunk-55cc26bf031f0db4fced411b5d43e45c"}}, {start: {_id:2454}, end: {_id:5413}, properties:{file_path:"unknown_source", truncate:"", keywords:"directs intelligence,purposeful application", weight:1.0, description:"An enlightened state enables the intentional use of universal intelligence for beneficial outcomes.", created_at:1779511852, source_id:"chunk-3a9b1e90fab2bdbcbb151bc873bcb657"}}, {start: {_id:2454}, end: {_id:5414}, properties:{file_path:"unknown_source", truncate:"", keywords:"channels intelligence,goal achievement", weight:1.0, description:"The enlightened state facilitates the transformation of intelligence into good or enlightenment for solving problems.", created_at:1779511852, source_id:"chunk-3a9b1e90fab2bdbcbb151bc873bcb657"}}, {start: {_id:2391}, end: {_id:5413}, properties:{file_path:"YouTube Video: 4Fjf6IQsjQs (URL: https://www.youtube.com/watch?v=4Fjf6IQsjQs)", truncate:"", keywords:"intelligence application,transformative potential", weight:1.0, description:"The intelligent universe provides the framework for achieving enlightenment through proper human interaction with its inherent intelligence.", created_at:1779511913, source_id:"chunk-55cc26bf031f0db4fced411b5d43e45c"}}, {start: {_id:2454}, end: {_id:1799}, properties:{file_path:"YouTube Video: 4Fjf6IQsjQs (URL: https://www.youtube.com/watch?v=4Fjf6IQsjQs)", truncate:"", keywords:"state requirement,transformative potential", weight:1.0, description:"Achieving an enlightened state allows humans to harness the universe's intelligence for positive outcomes.", created_at:1779511913, source_id:"chunk-55cc26bf031f0db4fced411b5d43e45c"}}, {start: {_id:5415}, end: {_id:5419}, properties:{file_path:"unknown_source", keywords:"blissful experience,intoxication", truncate:"", weight:1.0, description:"In this experience of wholeness, intoxication with bliss occurs.", created_at:1779511945, source_id:"chunk-633783812b5d5da425ce397a32e3139c"}}, {start: {_id:5421}, end: {_id:5420}, properties:{file_path:"unknown_source", keywords:"blissful nature,state of being", truncate:"", weight:1.0, description:"Experience in consciousness is described as bliss in the state.", created_at:1779511945, source_id:"chunk-633783812b5d5da425ce397a32e3139c"}}, {start: {_id:5417}, end: {_id:5415}, properties:{file_path:"unknown_source", truncate:"", keywords:"blissful experience,enlightened state", weight:1.0, description:"The enlightened state of Ananda incorporates intoxication with bliss as a defining characteristic.", created_at:1779511945, source_id:"chunk-633783812b5d5da425ce397a32e3139c"}}, {start: {_id:2399}, end: {_id:5418}, properties:{file_path:"YouTube Video: E-LCT0YEpWQ (URL: https://www.youtube.com/watch?v=E-LCT0YEpWQ)", truncate:"", keywords:"associated with,enlightened state", weight:1.0, description:"Mental experiences are part of the blissful state in the experience of wholeness.", created_at:1779511969, source_id:"chunk-e7a44718d07524dc9d25d8465c12f664"}}, {start: {_id:2399}, end: {_id:5416}, properties:{file_path:"YouTube Video: E-LCT0YEpWQ (URL: https://www.youtube.com/watch?v=E-LCT0YEpWQ)", truncate:"", keywords:"associated with,enlightened state", weight:1.0, description:"Sensory experiences like seeing, hearing, and touching are described as blissful.", created_at:1779511969, source_id:"chunk-e7a44718d07524dc9d25d8465c12f664"}}, {start: {_id:2399}, end: {_id:5422}, properties:{file_path:"YouTube Video: E-LCT0YEpWQ (URL: https://www.youtube.com/watch?v=E-LCT0YEpWQ)", truncate:"", keywords:"characterized by,intoxication", weight:1.0, description:"The enlightened state of Ananda is characterized by intoxication with bliss.", created_at:1779511969, source_id:"chunk-e7a44718d07524dc9d25d8465c12f664"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
