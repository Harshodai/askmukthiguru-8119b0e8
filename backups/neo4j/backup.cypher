192, source_id:"chunk-7a11c33d05bfc14747b1fe7585c881fd<SEP>chunk-3bc441c03c9cd5688b0f20314b1b1b3b", entity_id:"Spinal Intelligence"}}, {_id:791, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"concept", truncate:"", description:"Gut intelligence involves instinctual responses and decision-making connected to the digestive system.<SEP>Gut Intelligence highlights the role of the gut in processing emotions and influencing decisions through its neural network.`", created_at:1779184192, source_id:"chunk-7a11c33d05bfc14747b1fe7585c881fd<SEP>chunk-3bc441c03c9cd5688b0f20314b1b1b3b", entity_id:"Gut Intelligence"}}, {_id:792, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", entity_type:"concept", truncate:"", description:"Brain intelligence refers to cognitive processes and decision-making associated with the brain.<SEP>Brain Intelligence refers to the cognitive functions and decision-making processes traditionally associated with the brain.`", created_at:1779184192, source_id:"chunk-7a11c33d05bfc14747b1fe7585c881fd<SEP>chunk-3bc441c03c9cd5688b0f20314b1b1b3b", entity_id:"Brain Intelligence"}}, {_id:793, properties:{file_path:"The_Four_Sacred_Secrets.pdf", entity_type:"concept", truncate:"", description:"The vast visible universe encompasses all observable life-forms and physical reality.", created_at:1779139707, source_id:"chunk-7a11c33d05bfc14747b1fe7585c881fd", entity_id:"Vast Visible Universe"}}] AS row
