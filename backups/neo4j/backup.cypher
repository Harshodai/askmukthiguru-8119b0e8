UNWIND [{start: {_id:1657}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=yDTGeNo-w0c)", truncate:"", keywords:"instructions,relaxation pose", weight:1.0, description:"The video includes demonstrations of Shavasana as part of the yoga nidra practice.", created_at:1779147748, source_id:"chunk-7886f1f557a9b4fb1480f7484e40bb20"}}, {start: {_id:1670}, end: {_id:1660}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=yDTGeNo-w0c)", truncate:"", keywords:"guided imagery,meditation focus", weight:1.0, description:"Visualization of a bright star at the eyebrow is incorporated into the meditation to enhance relaxation.", created_at:1779147748, source_id:"chunk-7886f1f557a9b4fb1480f7484e40bb20"}}, {start: {_id:1618}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=yDTGeNo-w0c)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=oUCZWSi8zY4)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=jW3JDLY0cDA)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", truncate:"", keywords:"acknowledgment,closing greeting,closure,content inclusion,cultural/spiritual symbolism,greeting,repetition", weight:4.0, description:"The video concludes with the traditional \"Namaste\" gesture to signify the end of the session.<SEP>The YouTube Video's text includes the greeting \"Namaste\" with adjusted punctuation.<SEP>The video concludes with the greeting \"Namaste,\" emphasizing its spiritual context.<SEP>The repeated use of \"Namaste\" in the video underscores themes of respect and universal connection.", created_at:1779242036, source_id:"chunk-7886f1f557a9b4fb1480f7484e40bb20<SEP>chunk-b9f36968ebf7bca3d8efa72e74d0fd0d<SEP>chunk-f78b0e4aa7017a9c67d7f42fb709f53c<SEP>chunk-f206cb9ee23deed8dce445b9e5d27182"}}, {start: {_id:1671}, end: {_id:1660}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=yDTGeNo-w0c)", truncate:"", keywords:"mental focus,practice objective", weight:1.0, description:"The practice emphasizes maintaining calmness in the body while keeping the mind alert and awake.", created_at:1779147748, source_id:"chunk-7886f1f557a9b4fb1480f7484e40bb20"}}, {start: {_id:1672}, end: {_id:1676}, properties:{file_path:"unknown_source", keywords:"health practice,spiritual principle", truncate:"", weight:1.0, description:"Langanam Parama Avashyam includes Fasting Food as a core component for holistic well-being.", created_at:1779147949, source_id:"chunk-9dee8f46d29882e9ac37655a29e4adbd"}}, {start: {_id:1673}, end: {_id:1686}, properties:{file_path:"unknown_source", truncate:"", keywords:"dietary immunity,infection resistance", weight:1.0, description:"Eating provides proteins that form Antibodies to fight diseases.", created_at:1779147949, source_id:"chunk-9dee8f46d29882e9ac37655a29e4adbd"}}, {start: {_id:1674}, end: {_id:1676}, properties:{file_path:"unknown_source", keywords:"health practice,spiritual principle", truncate:"", weight:1.0, description:"Langanam Parama Avashyam incorporates Fasting Breath to regulate cellular energy.", created_at:1779147949, source_id:"chunk-9dee8f46d29882e9ac37655a29e4adbd"}}, {start: {_id:1672}, end: {_id:1677}, properties:{file_path:"unknown_source", keywords:"dietary immunity,protein intake", truncate:"", weight:1.0, description:"Fasting Food regulates protein consumption to boost Immunoglobulins production.", created_at:1779147949, source_id:"chunk-9dee8f46d29882e9ac37655a29e4adbd"}}, {start: {_id:1672}, end: {_id:1682}, properties:{file_path:"unknown_source", truncate:"", keywords:"digestive efficiency,nostril breathing", weight:1.0, description:"Fasting Food aligns with Solar Energy Flow for optimal digestion when breath flows through nostrils.", created_at:1779147950, source_id:"chunk-9dee8f46d29882e9ac37655a29e4adbd"}}, {start: {_id:1656}, end: {_id:1674}, properties:{file_path:"unknown_source", keywords:"breath control,yogic practice", truncate:"", weight:1.0, description:"Ancient Yogis practiced Fasting Breath through controlled inhalations and exhalations.", created_at:1779147950, source_id:"chunk-9dee8f46d29882e9ac37655a29e4adbd"}}, {start: {_id:1678}, end: {_id:1676}, properties:{file_path:"unknown_source", keywords:"health practice,spiritual principle", truncate:"", weight:1.0, description:"Langanam Parama Avashyam mandates Fasting from Hurtful Speech to enhance Vak Shakti.", created_at:1779147950, source_id:"chunk-9dee8f46d29882e9ac37655a29e4adbd"}}, {start: {_id:1675}, end: {_id:1676}, properties:{file_path:"unknown_source", keywords:"health practice,spiritual principle", truncate:"", weight:1.0, description:"Langanam Parama Avashyam prescribes Fasting Movement to calm mind and body.", created_at:1779147950, source_id:"chunk-9dee8f46d29882e9ac37655a29e4adbd"}}, {start: {_id:1678}, end: {_id:1681}, properties:{file_path:"unknown_source", keywords:"goal manifestation,speech power", truncate:"", weight:1.0, description:"Fasting from Hurtful Speech amplifies Vak Shakti through mindful communication.", created_at:1779147950, source_id:"chunk-9dee8f46d29882e9ac37655a29e4adbd"}}, {start: {_id:1687}, end: {_id:1619}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"correction task,domain-specific terms", weight:2.0, description:"Mukthi Guru's role involves correcting the principle Langanam Parama Avshadam.<SEP>Mukthi Guru's role includes correcting the principle Langanam Parama Avshadam.", created_at:1779148009, source_id:"chunk-da65d8513f47f315e294fdae16ca03d0"}}, {start: {_id:486}, end: {_id:1687}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"ancient practices,historical principle", weight:1.0, description:"Langanam Parama Avshadam is a principle used by the ancients in India.", created_at:1779148009, source_id:"chunk-da65d8513f47f315e294fdae16ca03d0"}}, {start: {_id:1688}, end: {_id:1687}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"application,health principle,principle,traditional practice", weight:2.0, description:"Fasting is the ultimate medicine under the principle of Langanam Parama Avshadam.<SEP>Langanam Parama Avshadam prescribes fasting as a core component of holistic health.", created_at:1779148037, source_id:"chunk-da65d8513f47f315e294fdae16ca03d0<SEP>chunk-5f95b172448640801fae7c555ba54742"}}, {start: {_id:1694}, end: {_id:1693}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"digestive efficiency,energy flow", weight:1.0, description:"Right nostril breath aligns with solar energy to maximize nutrient absorption.", created_at:1779148037, source_id:"chunk-5f95b172448640801fae7c555ba54742"}}, {start: {_id:1695}, end: {_id:1691}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"immunity,nutritional balance", weight:1.0, description:"Proper protein consumption enhances antibody synthesis for disease resistance.", created_at:1779148037, source_id:"chunk-5f95b172448640801fae7c555ba54742"}}, {start: {_id:1688}, end: {_id:1677}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"immune support,protein metabolism", weight:1.0, description:"Fasting regulates protein intake to optimize antibody production for immunity.", created_at:1779148037, source_id:"chunk-5f95b172448640801fae7c555ba54742"}}, {start: {_id:1688}, end: {_id:1689}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=2z5qxSr4EaI)", truncate:"", keywords:"health application,method classification", weight:1.0, description:"Intermittent fasting is a structured fasting method for 