, created_at:1779655621, source_id:"chunk-12740ae94c3469761e52a81015d8effe"}}, {start: {_id:1179}, end: {_id:7118}, properties:{file_path:"YouTube Video: 1PlGMOAypCI (URL: https://www.youtube.com/watch?v=1PlGMOAypCI)", keywords:"identity,moral judgment", truncate:"", weight:1.0, description:"Ideals define one's sense of self and identity, and determine moral judgments.", created_at:1779655621, source_id:"chunk-12740ae94c3469761e52a81015d8effe"}}, {start: {_id:7119}, end: {_id:7120}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", truncate:"", keywords:"cause,result", weight:1.0, description:"The obsession and judgment over body appearance directly causes unhappiness in human beings.", created_at:1779655641, source_id:"chunk-53aef598f36a2b6f13abedf2e8766221"}}, {start: {_id:7119}, end: {_id:7121}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", truncate:"", keywords:"cause,result", weight:1.0, description:"The obsession and judgment over body appearance directly causes insecurity in human beings.", created_at:1779655641, source_id:"chunk-53aef598f36a2b6f13abedf2e8766221"}}, {start: {_id:1406}, end: {_id:7126}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", truncate:"", keywords:"mental health,psychological impact", weight:1.0, description:"Body-related shame contributes significantly to depression across global populations.", created_at:1779655665, source_id:"chunk-4ef399a9836bd5861ce4607a41690699"}}, {start: {_id:7122}, end: {_id:765}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", keywords:"perception,self-image", truncate:"", weight:1.0, description:"Inner judgment shapes self-perception through parental or societal validation of physical traits.", created_at:1779655665, source_id:"chunk-4ef399a9836bd5861ce4607a41690699"}}, {start: {_id:7123}, end: {_id:765}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", keywords:"self-image,statistics", truncate:"", weight:1.0, description:"Data highlights discrepancies between self-perception and others' perceptions of beauty.", created_at:1779655665, source_id:"chunk-4ef399a9836bd5861ce4607a41690699"}}, {start: {_id:7125}, end: {_id:765}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", truncate:"", keywords:"caregiver influence,emotional validation", weight:1.0, description:"Specialized love from caregivers shapes self-perception through validation of physical traits.", created_at:1779655666, source_id:"chunk-4ef399a9836bd5861ce4607a41690699"}}, {start: {_id:7124}, end: {_id:765}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", truncate:"", keywords:"psychological impact,self-image discrepancy", weight:1.0, description:"Quantifies the gap between self-perception and external perception of beauty.", created_at:1779655666, source_id:"chunk-4ef399a9836bd5861ce4607a41690699"}}, {start: {_id:7128}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=dqUq_a0DyLs)", truncate:"", keywords:"body image,self-acceptance", weight:1.0, description:"The video critiques societal obsession with physical appearance and advocates for self-acceptance despite bodily impermanence.", created_at:1779655686, source_id:"chunk-97eda5ea96b7f1db5f0d7a104094ffd9"}}] AS row
