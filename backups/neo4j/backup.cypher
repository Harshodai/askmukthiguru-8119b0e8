UNWIND [{start: {_id:6147}, end: {_id:6143}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"prevalence,symptoms", truncate:"", weight:1.0, description:"Mental health problems like depression and anxiety are key symptoms of the broader crisis.", created_at:1779555916, source_id:"chunk-748133f16cf9409e907621d95ac797bb"}}, {start: {_id:6148}, end: {_id:6143}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"demographic impact,statistical data", weight:1.0, description:"The large Indian youth population exacerbates the scale of the mental health crisis.", created_at:1779555916, source_id:"chunk-748133f16cf9409e907621d95ac797bb"}}, {start: {_id:6156}, end: {_id:6154}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"psychological impact,social pressure", weight:1.0, description:"Unrealistic comparisons via social media contribute to youth dissatisfaction with their realities.", created_at:1779555939, source_id:"chunk-bf3e14052a899fd14050d312f32aa97b"}}, {start: {_id:6114}, end: {_id:6151}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", truncate:"", keywords:"societal impact,technological transformation", weight:1.0, description:"The Fourth Revolution is driving the emergence of the \"new reality\" characterized by advanced technologies.", created_at:1779555939, source_id:"chunk-bf3e14052a899fd14050d312f32aa97b"}}, {start: {_id:6158}, end: {_id:2242}, properties:{file_path:"YouTube Video: nCkbv_lvFfg (URL: https://www.youtube.com/watch?v=nCkbv_lvFfg)", keywords:"causal factor,stressor", truncate:"", weight:1.0, description:"Peer pressure directly contributes to psychological pressure through social dynamics.", created_at:1779555940, source_id:"chunk-2d5e1779572c80b9567627b5320742fc"}}, {start: {_id:61