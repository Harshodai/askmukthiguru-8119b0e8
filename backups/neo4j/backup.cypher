UNWIND [{start: {_id:7707}, end: {_id:176}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"daily routine,intentional connection,practice,spiritual practice", weight:2.0, description:"The spiritual vision centers on the method of connecting with another person in an inner state.<SEP>Spiritual vision involves connecting with another person daily to learn and dissolve stress.", created_at:1779672066, source_id:"chunk-f367b232a1868597453e46a0827c00ef<SEP>chunk-8214f902f81ebb0b2df3cc231089a8c7"}}, {start: {_id:7707}, end: {_id:179}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Tc8f9ZasRRM)", truncate:"", keywords:"context,emotional state,environment,reflection", weight:2.0, description:"The method of connecting with another person occurs specifically within the framework of the inner state.<SEP>Connecting with another person requires reflecting on one's inner state and dissolving anxiety.", created_at:1779672066, source_id:"chunk-f367b232a1868597453e46a0827c00ef<SEP>chunk-8214f902f81ebb0b2df3cc231089a8c7"}}, {start: {_id:7713}, end: {_id:2390}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=U1qRvz3hnMA)", truncate:"", keywords:"societal impact,spiritual principles", weight:1.0, description:"Spirituality is linked to non-violence as a transformative force for collective awakening.", created_at:1779672146, source_id:"chunk-01f9faf5a613d1d1b6c6131312eef66b"}}, {start: {_id:2598}, end: {_id:7719}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=U1qRvz3hnMA)", truncate:"", keywords:"ethical erosion,media influence", weight:1.0, description:"Media is implicated in exacerbating destructive pleasure-seeking behaviors.", created_at:1779672146, source_id:"chunk-01f9faf5a613d1d1b6c6131312eef66b"}}, {start: {_id:7714}, end: {_id:7709}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=U1qRvz3hnMA)", truncate:"", keywords:"collective action,generational unity", weight:1.0, description:"Intergenerational collaboration is proposed as essential for societal transformation.", created_at:1779672146, source_id:"chunk-01f9faf5a613d1d1b6c6131312eef66b"}}, {start: {_id:7715}, end: {_id:2390}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=U1qRvz3hnMA)", truncate:"", keywords:"moral decay,societal issues", weight:1.0, description:"Spirituality's absence enables destructive forces like hunger-driven violence.", created_at:1779672146, source_id:"chunk-01f9faf5a613d1d1b6c6131312eef66b"}}, {start: {_id:486}, end: {_id:7713}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=U1qRvz3hnMA)", truncate:"", keywords:"cultural legacy,global influence", weight:1.0, description:"India's historical role in spreading non-violence is referenced as a societal model.", created_at:1779672146, source_id:"chunk-01f9faf5a613d1d1b6c6131312eef66b"}}, {start: {_id:486}, end: {_id:7716}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=U1qRvz3hnMA)", truncate:"", keywords:"cultural values,spiritual reverence", weight:1.0, description:"India's historical veneration of women is highlighted as a spiritual ideal.", created_at:1779672146, source_id:"chunk-01f9faf5a613d1d1b6c6131312eef66b"}}, {start: {_id:169}, end: {_id:7715}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=U1qRvz3hnMA)", truncate:"", keywords:"causes,social inequality,socioeconomic factors,violence", weight:2.0, description:"Poverty is directly tied to destructive rage stemming from deprivation.<SEP>Poverty directly fuels the rage of hunger through systemic deprivation.`", created_at:1779672227, source_id:"chunk-01f9faf5a613d1d1b6c6131312eef66b<SEP>chunk-4e900263f52a257effc9757bdfd34e24"}}, {start: {_id:7722}, end: {_id:7720}, properties:{file_path:"YouTube Vid