UNWIND [{start: {_id:533}, end: {name:"Consciousness"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: BZDXIQwOPdU (URL: https://www.youtube.com/watch?v=BZDXIQwOPdU)", keywords:"conceptual link,realization,transformative action,understanding", truncate:"", weight:2.0, description:"Consciousness leads to the realization of compassion by allowing one to observe all parts of oneself without judgment.<SEP>Consciousness allows individuals to act beyond selfishness, responding to suffering with compassion and creating positive change.", created_at:1779561380, source_id:"chunk-6a2ca3b4a00fd65d72ac5932a227e2a8<SEP>chunk-9645fe2118f4e6de1b034351a972ae59"}}, {start: {_id:738}, end: {name:"Consciousness"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>YouTube Video: ajMAwlKh3YM (URL: https://www.youtube.com/watch?v=ajMAwlKh3YM)", keywords:"absence,acceptance,influence,interconnection,observation,realization", truncate:"", weight:4.0, created_at:1779556969, description:"Consciousness allows for the acceptance of body as it is, without judgment.<SEP>The body and consciousness are interconnected, influencing each other during practice.<SEP>The body and consciousness are interconnected, influencing each other during practice.<SEP>In meditation, the body is seen without a sense of self, highlighting the absence of \"I.\"", source_id:"chunk-6a2ca3b4a00fd65d72ac5932a227e2a8<SEP>chunk-d887f374fce140e42345a26a703cd352<SEP>chunk-b04f7ebc196bc2024dc00fdd71633076"}}, {start: {_id:752}, end: {name:"Consciousness"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"acceptance,realization", truncate:"", weight:1.0, description:"Consciousness allows for the acceptance of community as it is, without judgment.", created_at:1779139430, source_id:"chunk-6a2ca3b4a00fd65d72ac5932a227e2a8"}}, {start: {_id:299}, end: {name:"Oneness"}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"transcendence,unity", truncate:"", weight:1.0, description:"