UNWIND [{start: {_id:7614}, end: {_id:7613}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"behavioral shift,contrast", truncate:"", weight:1.0, description:"Supporting Others contrasts with analyzing others, indicating a shift from analysis to support.", created_at:1779669211, source_id:"chunk-c5b629deefcb32f62e58cbc3ee1d28ae"}}, {start: {_id:4615}, end: {_id:7613}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"behavioral shift,inclusion", weight:1.0, description:"Supporting Others involves including others, contrasting with judging or analyzing them.", created_at:1779669211, source_id:"chunk-c5b629deefcb32f62e58cbc3ee1d28ae"}}, {start: {_id:7612}, end: {_id:4615}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"inclusion,self-perception", truncate:"", weight:1.0, description:"Expanded Sense includes others, indicating a broader self-concept.", created_at:1779669211, source_id:"chunk-c5b629deefcb32f62e58cbc3ee1d28ae"}}, {start: {_id:7613}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"content,content source,thematic focus,transcript", weight:2.0, description:"The YouTube video's content discusses the concept of supporting others.<SEP>The video discusses supporting others as a physical manifestation of interconnectedness.", created_at:1779669399, source_id:"chunk-d3241e43fceaf23540d1629ac06a9653<SEP>chunk-7aa2539edad7b667d56ec7a44037cb45"}}, {start: {_id:7617}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"content,transcript", truncate:"", weight:1.0, description:"The YouTube video's content includes the concept of expanding one's sense of self.", created_at:1779669236, source_id:"chunk-d3241e43fceaf23540d1629ac06a9653"}}, {start: {_id:7615}, end: {_id:7613}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"correction,editing", truncate:"", weight:1.0, description:"Supporting others is addressed by the method of correcting punctuation.", created_at:1779669236, source_id:"chunk-d3241e43fceaf23540d1629ac06a9653"}}, {start: {_id:7615}, end: {_id:7617}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"correction,editing", truncate:"", weight:1.0, description:"Expanding sense of self is addressed by the method of correcting punctuation.", created_at:1779669236, source_id:"chunk-d3241e43fceaf23540d1629ac06a9653"}}, {start: {_id:7618}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"content,transcript", truncate:"", weight:1.0, description:"The YouTube video's content requires the method of breaking up sentences.", created_at:1779669236, source_id:"chunk-d3241e43fceaf23540d1629ac06a9653"}}, {start: {_id:7616}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"content,transcript", truncate:"", weight:1.0, description:"The YouTube video's content requires the method of capitalizing sentences.", created_at:1779669236, source_id:"chunk-d3241e43fceaf23540d1629ac06a9653"}}, {start: {_id:7619}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"content,transcript", truncate:"", weight:1.0, description:"The YouTube video's content requires the method of ignoring domain terms.", created_at:1779669236, source_id:"chunk-d3241e43fceaf23540d1629ac06a9653"}}, {start: {_id:7615}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"content,transcript", truncate:"", weight:1.0, description:"The YouTube video's content requires the method of correcting punctuation.", created_at:1779669236, source_id:"chunk-d3241e43fceaf23540d1629ac06a9653"}}, {start: {_id:7586}, end: {_id:4394}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"emotional memory,relational patterns", weight:1.0, description:"Childhood experiences shape adult perceptions of interconnectedness and relationships.", created_at:1779669255, source_id:"chunk-149f1fa94cc8d81b9d634c9e418c534a"}}, {start: {_id:5924}, end: {_id:5621}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"identity shift,self-awareness", weight:1.0, description:"Consciousness expansion leads to a shift in the sense of self as it expands beyond individual boundaries.", created_at:1779669255, source_id:"chunk-149f1fa94cc8d81b9d634c9e418c534a"}}, {start: {_id:5621}, end: {_id:25}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"growth,self-perception", truncate:"", weight:1.0, description:"Transformation occurs as the sense of self evolves during consciousness expansion.", created_at:1779669256, source_id:"chunk-149f1fa94cc8d81b9d634c9e418c534a"}}, {start: {_id:1358}, end: {_id:4394}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"empathy,influence", weight:1.0, description:"Feeling interconnected enables individuals to impact and support others emotionally.", created_at:1779669256, source_id:"chunk-149f1fa94cc8d81b9d634c9e418c534a"}}, {start: {_id:5924}, end: {_id:4394}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"collective awareness,unity", weight:1.0, description:"Expanding consciousness fosters a sense of interconnectedness with others.", created_at:1779669256, source_id:"chunk-149f1fa94cc8d81b9d634c9e418c534a"}}, {start: {_id:5800}, end: {_id:7613}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"compassion,empathy", truncate:"", weight:2.0, description:"Supporting others physically and emotionally fosters caring for others' well-being.<SEP>Supporting others physically and emotionally fosters caring for others' well-being.", created_at:1779669327, source_id:"chunk-4f083f509b73a704942cae198b15e4c6"}}, {start: {_id:7620}, end: {_id:1338}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"clarity,compassion", truncate:"", weight:2.0, description:"Kindness in communication enhances the quality of speech to promote positive interactions.<SEP>Kindness in communication enhances the quality of speech to promote positive interactions.", created_at:1779669327, source_id:"chunk-4f083f509b73a704942cae198b15e4c6"}}, {start: {_id:7623}, end: {_id:1473}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", keywords:"empathy,personal growth", truncate:"", weight:2.0, description:"Transformed consciousness enables creating change in others by expanding one's sense of self beyond physical limits.<SEP>Transformed consciousness enables creating change in others by expanding one's sense of self beyond physical limits.", created_at:1779669327, source_id:"chunk-4f083f509b73a704942cae198b15e4c6"}}, {start: {_id:7621}, end: {_id:7613}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1kS_mQaBLdg)", truncate:"", keywords:"compassion,method", weight:2.0, description:"Supporting others physically (e.g., with arms) exemplifies compassionate care beyond verbal communication.<SEP>Supporting others physically (e.g., with arms) exemplifies compassionate care beyond verbal communication.", created_at:1779669328, source_id:"chunk-4f083f509b73a704942cae198b15e4c6"}}] AS row
