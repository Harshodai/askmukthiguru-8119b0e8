UNWIND [{start: {_id:4441}, end: {_id:2186}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"purpose,spiritual alignment", weight:1.0, description:"The state of connection leads to discovering one's unique purpose (Swadharma) and celebrating existence itself.", created_at:1779562356, source_id:"chunk-409e3173dcf6a797c05e310fb242993c"}}, {start: {_id:6533}, end: {_id:6532}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"artistic expression,nature appreciation", weight:1.0, description:"Monet's connection with nature drove him to paint the Lily Pond Bridge repeatedly to highlight its beauty.", created_at:1779562356, source_id:"chunk-409e3173dcf6a797c05e310fb242993c"}}, {start: {_id:6528}, end: {_id:2186}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"purpose,spiritual connection", weight:1.0, description:"Mr. Wongdu's work exemplifies Swadharma, a purpose born from spiritual awareness and global responsibility.", created_at:1779562356, source_id:"chunk-e0bf909f8e5d3cf013125e64d70b8365"}}, {start: {_id:6534}, end: {_id:4441}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"creative output,inspiration", weight:1.0, description:"Monet's state of connection resulted in masterpieces that evoke new perspectives on familiar subjects.", created_at:1779562356, source_id:"chunk-409e3173dcf6a797c05e310fb242993c"}}, {start: {_id:6533}, end: {_id:6535}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"artistic subject,location", truncate:"", weight:1.0, description:"Lily Pond served as the setting for Monet's paintings, reflecting his deep engagement with the natural world.", created_at:1779562356, source_id:"chunk-409e3173dcf6a797c05e310fb242993c"}}, {start: {_id:6529}, end: {_id:6528}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"environmental impact,spiritual alignment", weight:1.0, description:"His career path merges spiritual connection with practical solutions to Earth's problems.", created_at:1779562356, source_id:"chunk-e0bf909f8e5d3cf013125e64d70b8365"}}, {start: {_id:6536}, end: {_id:4441}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"potential,self-realization", truncate:"", weight:1.0, description:"Awakening to connection unlocks hidden gifts and genius within individuals.", created_at:1779562356, source_id:"chunk-409e3173dcf6a797c05e310fb242993c"}}, {start: {_id:6537}, end: {_id:4441}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"lack of awareness,passivity", weight:1.0, description:"The majority remain ordinary due to never awakening to the transformative power of connection.", created_at:1779562356, source_id:"chunk-409e3173dcf6a797c05e310fb242993c"}}, {start: {_id:6528}, end: {_id:348}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"case study,content source", truncate:"", weight:1.0, description:"The video features Mr. Wongdu's story as an example of purpose-driven action.", created_at:1779562356, source_id:"chunk-e0bf909f8e5d3cf013125e64d70b8365"}}, {start: {_id:6538}, end: {_id:2390}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"associated with,teaching approach", weight:2.0, description:"Pritaji emphasizes spirituality as an inward journey and contrasts it with religious teachings.", created_at:1779562376, source_id:"chunk-cea13f2b86c9f827be31632c60cac574"}}, {start: {_id:6539}, end: {_id:2390}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"aspect of,core principle", truncate:"", weight:1.0, description:"Spirituality centers on inner awakening as a key component.", created_at:1779562376, source_id:"chunk-cea13f2b86c9f827be31632c60cac574"}}, {start: {_id:6540}, end: {_id:2390}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"aspect of,core principle", truncate:"", weight:1.0, description:"Spirituality involves living in a sustained awakened state.", created_at:1779562376, source_id:"chunk-cea13f2b86c9f827be31632c60cac574"}}, {start: {_id:6538}, end: {_id:2392}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"contrast,teaching approach", weight:2.0, description:"Pritaji differentiates spirituality from religion, highlighting spirituality's focus on inner awakening.", created_at:1779562377, source_id:"chunk-cea13f2b86c9f827be31632c60cac574"}}, {start: {_id:2391}, end: {_id:501}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"causation,enlightenment", truncate:"", weight:3.0, description:"Enlightenment is a prerequisite for achieving success, as per the law of consciousness.<SEP>Enlightenment leads to success as per the law of consciousness.<SEP>Enlightenment contributes to success.", created_at:1779562387, source_id:"chunk-278a8d67c1e61197e34fdca6005f5c42"}}, {start: {_id:39}, end: {_id:501}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"causation,enlightenment", truncate:"", weight:2.0, description:"Joy leads to success as per the law of consciousness.<SEP>Joy contributes to success.", created_at:1779562388, source_id:"chunk-278a8d67c1e61197e34fdca6005f5c42"}}, {start: {_id:6541}, end: {_id:501}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"causation,enlightenment", truncate:"", weight:2.0, description:"Enlightenment and joy together lead to success.", created_at:1779562388, source_id:"chunk-278a8d67c1e61197e34fdca6005f5c42"}}, {start: {_id:3563}, end: {_id:6520}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"content,source", weight:1.0, description:"Krishna Ji is the speaker in the YouTube Video, where he discusses enlightenment and the challenges of the hungry mind.", created_at:1779562455, source_id:"chunk-f87f1002a8699b889bcce1050f8f041d"}}, {start: {_id:2391}, end: {_id:301}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"enlightenment,fulfillment", truncate:"", weight:1.0, description:"Attaining enlightenment leads to automatic fulfillment in life and the resolution of the hungry mind's struggles, resulting in happiness.", created_at:1779562455, source_id:"chunk-f87f1002a8699b889bcce1050f8f041d"}}, {start: {_id:301}, end: {_id:6542}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", keywords:"dissatisfaction,obstacle", truncate:"", weight:1.0, description:"The hungry mind's constant wanting and dissatisfaction prevent the achievement of true happiness.", created_at:1779562455, source_id:"chunk-f87f1002a8699b889bcce1050f8f041d"}}, {start: {_id:2391}, end: {_id:3563}, properties:{file_path:"YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", truncate:"", keywords:"spiritual guidance,teaching", weight:1.0, description:"Krishna Ji teaches the importance of enlightenment as a path to overcoming the hungry mind and achieving happiness.", created_at:1779562455, source_id:"chunk-f87f1002a8699b889bcce1050f8f041d"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
