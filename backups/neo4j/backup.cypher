UNWIND [{start: {_id:1620}, end: {_id:1969}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)<SEP>unknown_source", truncate:"", keywords:"domain-specific names,focus area,task,term correction", weight:2.0, description:"Corrects domain-specific names and terms as per the provided list.<SEP>Text Correction Expert is responsible for correcting domain-specific names and terms.", created_at:1779721204, source_id:"chunk-9670225f84c4c4d682af773cdfe87366<SEP>chunk-a8de9d54e57d76758c3eb9ce7b788164"}}, {start: {_id:3639}, end: {_id:1463}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"concealment,emotional concealment,emotional pain,expectation,help,ridicule,shared experience,societal reaction", weight:4.0, description:"People expected help for their pains but received ridicule instead.<SEP>People were ridiculed for their pains instead of being helped.<SEP>People hide their pains behind masks to avoid judgment.<SEP>People hide their pains behind masks due to past ridicule or lack of support, as explicitly mentioned in the text.", created_at:1779236602, source_id:"chunk-d720c7b9783846012decda752c188747<SEP>chunk-e8c3861302e4fee45689e6fb65d84e48"}}, {start: {_id:371}, end: {_id:1463}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"concealment,emotional concealment,isolation,shared experience", weight:2.0, description:"People conceal their loneliness with masks to prevent others from noticing.<SEP>Loneliness is concealed by individuals through masks, reflecting the text's emphasis on hidden struggles.", created_at:1779236603, source_id:"chunk-d720c7b9783846012decda752c188747<SEP>chunk-e8c3861302e4fee45689e6fb65d84e48"}}, {start: {_id:496}, end: {_id:1463}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"anxiety,concealment,courage,emotional concealment,expectation,shared experience,societal reaction,teasing", weight:4.0, description:"People were teased for their anxiety instead of being given courage.<SEP>People hide their anxiety behind masks to appear calm and composed.<SEP>People expected courage for their anxiety but were instead teased.<SEP>Anxiety is listed as an emotion people mask, tied to experiences of being teased or ridiculed.", created_at:1779236603, source_id:"chunk-d720c7b9783846012decda752c188747<SEP>chunk-e8c3861302e4fee45689e6fb65d84e48"}}, {start: {_id:3646}, end: {_id:3644}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"game type,solitary activity", weight:1.0, description:"Lonely games are a form of entertainment.", created_at:1779236225, source_id:"chunk-aec7e5d9768233c70894ac1802b148a7"}}, {start: {_id:371}, end: {_id:3641}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"cultural shift,isolation,modernization impact,societal change,societal impact", weight:3.0, description:"Modernization has brought loneliness to people.<SEP>Modernization and culture contribute to loneliness through fragmented social structures.<SEP>Modernization disrupts traditional social bonds, fostering loneliness.", created_at:1779236409, source_id:"chunk-aec7e5d9768233c70894ac1802b148a7<SEP>chunk-73cf209c2ca0aee45e9dc6e6411c0cb2"}}, {start: {_id:3647}, end: {_id:3644}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"entertainment medium,social isolation,technology,technology use", created_at:1779236648, weight:2.0, description:"Computers are used in lonely games.<SEP>Lonely games played with computers reflect modern solitary entertainment habits.", source_id:"chunk-aec7e5d9768233c70894ac1802b148a7<SEP>chunk-c2dfb10d73bb85ba3334f2281cc0afee"}}, {start: {_id:1024}, end: {_id:371}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"cultural impact,isolation,societal change", weight:2.0, description:"Culture is a factor contributing to loneliness.<SEP>Modern cultural shifts contribute to loneliness through fragmented social structures.", created_at:1779236410, source_id:"chunk-aec7e5d9768233c70894ac1802b148a7<SEP>chunk-73cf209c2ca0aee45e9dc6e6411c0cb2"}}, {start: {_id:371}, end: {_id:3642}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"family structure,individual isolation", weight:1.0, description:"Nuclear families are associated with lonely lives.", created_at:1779236225, source_id:"chunk-aec7e5d9768233c70894ac1802b148a7"}}, {start: {_id:3645}, end: {_id:371}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", keywords:"emotional impact,isolation,lifestyle", truncate:"", weight:2.0, description:"Individualistic lives are linked to loneliness.<SEP>Individualistic lives correlate with increased loneliness.", created_at:1779236410, source_id:"chunk-aec7e5d9768233c70894ac1802b148a7<SEP>chunk-73cf209c2ca0aee45e9dc6e6411c0cb2"}}, {start: {_id:3646}, end: {_id:371}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"activity,isolation,personalization,social isolation,solitary choices", weight:3.0, created_at:1779236456, description:"Entertainment is described as lonely.<SEP>Entertainment choices are individualized and solitary.<SEP>Entertainment is noted as lonely due to private consumption habits.", source_id:"chunk-aec7e5d9768233c70894ac1802b148a7<SEP>chunk-73cf209c2ca0aee45e9dc6e6411c0cb2<SEP>chunk-ad21c8251c43d2428c2c1fc6eaf57acc"}}, {start: {_id:3646}, end: {_id:3648}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", keywords:"content,individual choice", truncate:"", weight:1.0, description:"Movies are part of individualistic entertainment.", created_at:1779236225, source_id:"chunk-aec7e5d9768233c70894ac1802b148a7"}}, {start: {_id:3649}, end: {_id:371}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"consumption,individual behavior", weight:1.0, description:"Food is individualistic, contributing to loneliness.", created_at:1779236225, source_id:"chunk-aec7e5d9768233c70894ac1802b148a7"}}, {start: {_id:371}, end: {_id:3650}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", keywords:"location,social behavior", truncate:"", weight:1.0, description:"Restaurants are places where people eat alone.", created_at:1779236225, source_id:"chunk-aec7e5d9768233c70894ac1802b148a7"}}, {start: {_id:371}, end: {_id:3652}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", keywords:"cosmic law,self-awareness", truncate:"", weight:1.0, description:"Overcoming loneliness through self-awareness leads to greater opportunities in life.", created_at:1779236273, source_id:"chunk-1f205cfd4f752f944e4f589c26e28701"}}, {start: {_id:1406}, end: {_id:1799}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"emotional experience,empathy,healing,impact,mental state", weight:3.0, created_at:1779236694, description:"Human beings can heal depression through emotional connection and understanding others' feelings.<SEP>Human Beings can experience depression, which parents can recognize in their children.<SEP>Depression impacts individuals' emotional states and relationships.", source_id:"chunk-1f205cfd4f752f944e4f589c26e28701<SEP>chunk-1e483a5aae3e722cbcbaae7e0a2f3d19<SEP>chunk-41d7d19401b85a866185adb1962d3632"}}, {start: {_id:1406}, end: {_id:3653}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", keywords:"prevention,sensitivity", truncate:"", weight:1.0, description:"Sensitivity in partnered relationships can prevent depression through mutual emotional support.", created_at:1779236273, source_id:"chunk-1f205cfd4f752f944e4f589c26e28701"}}, {start: {_id:3654}, end: {_id:794}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"contrast,counterbalance,necessity,response,technological dominance", weight:4.0, created_at:1779236734, description:"Heart intelligence must rise as artificial intelligence advances to ensure holistic healing.<SEP>The video contrasts the rise of Artificial Intelligence with the necessity of Heart Intelligence to heal the world.<SEP>Artificial Intelligence taking over the world requires Heart Intelligence to rise.", source_id:"chunk-6537d9939653cd5b7d036dced5f9de7b<SEP>chunk-40bd05ead62aaeb01579393d5559a014<SEP>chunk-b4fe0cbe12e5b4a3116f1a065a295316"}}, {start: {_id:852}, end: {_id:2028}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"emotional progression,transformation", weight:1.0, description:"Sadness can progress into fear when not addressed through empathy or connection.", created_at:1779236324, source_id:"chunk-6537d9939653cd5b7d036dced5f9de7b"}}, {start: {_id:1406}, end: {_id:3655}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"empathy,healing", weight:1.0, description:"Emotional connection helps individuals overcome depression through mutual understanding.", created_at:1779236324, source_id:"chunk-6537d9939653cd5b7d036dced5f9de7b"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
UNWIND [{start: {_id:479}, end: {_id:2577}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"collective impact,individual healing", weight:1.0, description:"Individual healing processes contribute to the broader goal of healing the world.", created_at:1779236324, source_id:"chunk-6537d9939653cd5b7d036dced5f9de7b"}}, {start: {_id:3655}, end: {_id:852}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", keywords:"emotional support,healing", truncate:"", weight:1.0, description:"Emotional connection aids in addressing fear through shared sensitivity.", created_at:1779236324, source_id:"chunk-6537d9939653cd5b7d036dced5f9de7b"}}, {start: {_id:3655}, end: {_id:2028}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", keywords:"compassion,healing", truncate:"", weight:1.0, description:"Emotional connection alleviates sadness via empathetic engagement.", created_at:1779236324, source_id:"chunk-6537d9939653cd5b7d036dced5f9de7b"}}, {start: {_id:3655}, end: {_id:254}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"personal connection,workplace policies", weight:1.0, description:"Organizations can foster emotional connection by allowing time for personal interactions at work.", created_at:1779236324, source_id:"chunk-6537d9939653cd5b7d036dced5f9de7b"}}, {start: {_id:3655}, end: {_id:479}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"emotional support,healing process", weight:1.0, description:"Emotional connection is central to the process of healing individuals and the world.", created_at:1779236324, source_id:"chunk-6537d9939653cd5b7d036dced5f9de7b"}}, {start: {_id:3655}, end: {_id:3656}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"mutual understanding,sensitivity", weight:1.0, description:"Partnered relationships foster emotional connection through mutual sensitivity and understanding.", created_at:1779236324, source_id:"chunk-6537d9939653cd5b7d036dced5f9de7b"}}, {start: {_id:2384}, end: {_id:413}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", keywords:"breach,consequence", truncate:"", weight:1.0, description:"Trust was broken when feelings were shared, leading to further emotional hurt.", created_at:1779236366, source_id:"chunk-baa29517ede049854e2aecf133575342"}}, {start: {_id:2097}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", keywords:"analysis,discussion", truncate:"", weight:1.0, description:"The YouTube video discusses homophones as part of its content analysis.", created_at:1779236366, source_id:"chunk-baa29517ede049854e2aecf133575342"}}, {start: {_id:3637}, end: {_id:3639}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"concealment,emotional impact", weight:1.0, description:"Masks are used to hide pains, reflecting the text's discussion of emotional concealment.", created_at:1779236366, source_id:"chunk-baa29517ede049854e2aecf133575342"}}, {start: {_id:371}, end: {_id:3637}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"concealment,emotional impact", weight:1.0, description:"Masks conceal loneliness even from closest friends, as highlighted in the analysis.", created_at:1779236367, source_id:"chunk-baa29517ede049854e2aecf133575342"}}, {start: {_id:496}, end: {_id:3637}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"concealment,emotional impact", weight:1.0, description:"Masks hide anxiety despite the text's emphasis on emotional vulnerability.", created_at:1779236367, source_id:"chunk-baa29517ede049854e2aecf133575342"}}, {start: {_id:3642}, end: {_id:3657}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"social evolution,structure", weight:1.0, description:"Transition from tribes to nuclear families illustrates societal change.", created_at:1779236409, source_id:"chunk-73cf209c2ca0aee45e9dc6e6411c0cb2"}}, {start: {_id:3640}, end: {_id:3643}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"emotional nature,existence", weight:1.0, description:"Emotion is integral to human existence and identity.", created_at:1779236409, source_id:"chunk-73cf209c2ca0aee45e9dc6e6411c0cb2"}}, {start: {_id:3660}, end: {_id:3657}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"historical context,social evolution", weight:1.0, description:"Transition from tribal living to nuclear families illustrates societal change.", created_at:1779236410, source_id:"chunk-73cf209c2ca0aee45e9dc6e6411c0cb2"}}, {start: {_id:3658}, end: {_id:371}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"individualism,isolation,social interaction,solitary consumption", weight:2.0, description:"Games are described as \"lonely games\" reflecting modern isolation.<SEP>Games are described as inherently lonely through individual consumption patterns.", created_at:1779236455, source_id:"chunk-73cf209c2ca0aee45e9dc6e6411c0cb2<SEP>chunk-ad21c8251c43d2428c2c1fc6eaf57acc"}}, {start: {_id:3647}, end: {_id:3658}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"solitary engagement,technology", weight:1.0, description:"Playing with computers exemplifies solitary entertainment.", created_at:1779236410, source_id:"chunk-73cf209c2ca0aee45e9dc6e6411c0cb2"}}, {start: {_id:3645}, end: {_id:3642}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"family structure,societal trend", weight:1.0, description:"Nuclear families represent a step toward individualistic lifestyles.", created_at:1779236410, source_id:"chunk-73cf209c2ca0aee45e9dc6e6411c0cb2"}}, {start: {_id:371}, end: {_id:3659}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", keywords:"cause,emotional impact", truncate:"", weight:1.0, description:"Self-engrossment exacerbates loneliness in modern individualistic societies.", created_at:1779236410, source_id:"chunk-73cf209c2ca0aee45e9dc6e6411c0cb2"}}, {start: {_id:1406}, end: {_id:3661}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"emotional fragility,existential distress", weight:1.0, description:"Depression is linked to overemphasis on unmet desires and relationships.", created_at:1779236454, source_id:"chunk-ad21c8251c43d2428c2c1fc6eaf57acc"}}, {start: {_id:3649}, end: {_id:3664}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=fj2_d2lNGVk)", truncate:"", keywords:"social isolation,solitary eating", weight:1.0, description:"Food consumption is characterized by individualistic and isolated practices.", created_at:1779236454, source_id:"chunk-ad21c8251c43d2428c2c1fc6eaf57acc"}}] AS row
