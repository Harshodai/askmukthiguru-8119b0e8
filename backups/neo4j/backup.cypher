UNWIND [{_id:4428, properties:{file_path:"YouTube Video: UNdwPjyLGn0 (URL: https://www.youtube.com/watch?v=UNdwPjyLGn0)", entity_type:"concept", truncate:"", description:"Grammatical Distinction refers to the linguistic difference between \"every one\" (individuals) and \"everyone\" (group) in the text's context.", created_at:1779391075, source_id:"chunk-205423882b48f788157f2fc6f5ec5467", entity_id:"Grammatical Distinction"}}, {_id:4429, properties:{file_path:"YouTube Video: UNdwPjyLGn0 (URL: https://www.youtube.com/watch?v=UNdwPjyLGn0)", entity_type:"concept", truncate:"", description:"Every One Of Us is a grammatical term referring to each individual person in a group.", created_at:1779391120, source_id:"chunk-abf954b4076fde8130baee4b61745658", entity_id:"Every One Of Us"}}, {_id:4430, properties:{file_path:"YouTube Video: UNdwPjyLGn0 (URL: https://www.youtube.com/watch?v=UNdwPjyLGn0)", entity_type:"concept", truncate:"", description:"Being Buddha signifies the potential for every individual to achieve Buddhahood.", created_at:1779391120, source_id:"chunk-abf954b4076fde8130baee4b61745658", entity_id:"Being Buddha"}}, {_id:4431, properties:{file_path:"YouTube Video: UNdwPjyLGn0 (URL: https://www.youtube.com/watch?v=UNdwPjyLGn0)", entity_type:"UNKNOWN", truncate:"", description:"Everyone refers to the group as a whole.", created_at:1779391138, source_id:"chunk-abf954b4076fde8130baee4b61745658", entity_id:"group"}}, {_id:4432, properties:{file_path:"YouTube Video: UNdwPjyLGn0 (URL: https://www.youtube.com/watch?v=UNdwPjyLGn0)", entity_type:"UNKNOWN", truncate:"", description:"Every One Of Us refers to each person in the group individually.", created_at:1779391138, source_id:"chunk-abf954b4076fde8130baee4b61745658", entity_id:"individual people"}}, {_id:4435, properties:{file_path:"unknown_source<SEP>YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)<SEP>YouTube Video: ZD1nQPtpojM (URL: https://www.youtube.com/watch?v=ZD1nQPtpojM)", entity_type:"concept", truncate:"", created_at:1779673242, description:"Magic refers to the positive and transformative experiences, such as synchronicities, that arise from a state of abundance consciousness.<SEP>Unexplained phenomena that enrich life and contribute to a sense of wonder.<SEP>Magic represents the sense of wonder and extraordinary experiences that arise from abundance consciousness, enhancing life's richness.<SEP>Magic symbolizes extraordinary outcomes and harmonious connections arising from aligned consciousness.<SEP>Magic is used as a rhetorical device to emphasize the abstract and repetitive nature of the struggle.<SEP>A repeated word symbolizing a theme or concept, possibly representing power, mystery, or a central motif in the text.<SEP>Magic is a repeated term in the text, potentially symbolizing a concept, spell, or abstract idea, though its exact nature is unspecified in the input.", source_id:"chunk-9146e187edbee9cdbc50b048c433c6f9<SEP>chunk-3e00aec0d824214dc3b1bf504e305af0<SEP>chunk-407afcc34149e3cdc533c3a522a0ac53<SEP>chunk-80c1d7e6f2de50ad90c1a12150a2d57e<SEP>chunk-c6481baa2ca6ec863ed7690cee69e3d0<SEP>chunk-86bc8fb91a37e8144d3f7c50533a2a32<SEP>chunk-a640bfc6434a7f8fb5697b74897aa6c6", entity_id:"Magic"}}, {_id:4436, properties:{file_path:"unknown_source<SEP>YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)<SEP>YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", created_at:1779561778, description:"Contribution is the act of enriching one's life and contributing to the world, emerging from a state of abundance consciousness and deep connection.<SEP>Contribution refers to the capacity to positively impact the world, enabled by abundance consciousness and self-awareness.<SEP>Contribution is framed as a conscious human being's perspective on purpose, emphasizing societal impact.", source_id:"chunk-ed3411d338194fc612909c3d7018f6a6<SEP>chunk-9146e187edbee9cdbc50b048c433c6f9<SEP>chunk-407afcc34149e3cdc533c3a522a0ac53<SEP>chunk-98b12bb1e69b9ff2ff208afa4abc7737", entity_id:"Contribution"}}, {_id:4437, properties:{file_path:"unknown_source<SEP>YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)", entity_type:"concept", truncate:"", description:"Scarcity is a state of lack that drives individuals to scavenge for love, wealth, and money, leading to a focus on filling internal voids rather than contributing to the world.<SEP>A mindset of lack leading to scavenging for love, wealth, or resources without considering broader impact.", created_at:1779392959, source_id:"chunk-9146e187edbee9cdbc50b048c433c6f9<SEP>chunk-8c7d4ae28dcb0e3eed4f5fc9c1814de9", entity_id:"Scarcity"}}, {_id:4438, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"A foundational state of being that influences actions and their impact on others.", created_at:1779392874, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0", entity_id:"Deep State of Connection"}}, {_id:4439, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Intense emotional drive that shapes actions and their contributions to the world.", created_at:1779392874, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0", entity_id:"Deep Passion"}}, {_id:4440, properties:{file_path:"unknown_source", entity_type:"adjective", truncate:"", description:"Comparative form of easy, indicating a state of reduced difficulty.", created_at:1779392874, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0", entity_id:"Easier"}}, {_id:4441, properties:{file_path:"unknown_source<SEP>YouTube Video: oXRZhJTHuOA (URL: https://www.youtube.com/watch?v=oXRZhJTHuOA)<SEP>YouTube Video: YkIBYppBtro (URL: https://www.youtube.com/watch?v=YkIBYppBtro)", entity_type:"concept", truncate:"", created_at:1779562354, description:"A condition of being linked or connected, which facilitates meaningful actions.<SEP>A state of being characterized by deep connection and expansion, from which actions contribute to the world.<SEP>The state of connection is described as a spiritual or philosophical concept that awakens individuals to life's beauty and purpose, leading to self-realization and extraordinary potential.", source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0<SEP>chunk-8c7d4ae28dcb0e3eed4f5fc9c1814de9<SEP>chunk-409e3173dcf6a797c05e310fb242993c", entity_id:"State of Connection"}}, {_id:4442, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The act of actions that benefit or support those in one's immediate environment.", created_at:1779392875, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0", entity_id:"Contributing to the People Around You"}}, {_id:4443, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The impact of individual actions on the broader global community.", created_at:1779392875, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0", entity_id:"Contribution from You to the World"}}, {_id:4444, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Actions driven by a need for love, which may be redundant with \"scavenge for wealth\".", created_at:1779392875, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0", entity_id:"Scavenge for Love"}}, {_id:4445, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Actions focused on acquiring wealth, often linked to abundance consciousness.", created_at:1779392875, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0", entity_id:"Scavenge for Wealth"}}, {_id:4446, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"Actions centered on monetary gain, a subset of scavenging for wealth.", created_at:1779392875, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0", entity_id:"Scavenge for Money"}}, {_id:4447, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The broader global context, beyond immediate personal concerns.", created_at:1779392875, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0", entity_id:"World at Large"}}, {_id:4448, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"An empty or lacking state within oneself, which can be filled by abundance consciousness.", created_at:1779392875, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0", entity_id:"Void"}}, {_id:4449, properties:{file_path:"unknown_source", entity_type:"concept", truncate:"", description:"The choices and behaviors that enrich life and contribute to the world.", created_at:1779392875, source_id:"chunk-3e00aec0d824214dc3b1bf504e305af0", entity_id:"Decisions and Actions"}}] AS row
