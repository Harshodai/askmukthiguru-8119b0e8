UNWIND [{start: {_id:6670}, end: {_id:6671}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"confrontation,participation", truncate:"", weight:1.0, description:"The restless businessman participated in the incident, confronting Buddha due to anger over his children's involvement with Buddha.", created_at:1779564485, source_id:"chunk-3907dc38c0d0edd5d39a312bc7148a7e"}}, {start: {_id:6672}, end: {_id:348}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"self-awareness,transformation", truncate:"", weight:1.0, description:"The video emphasizes self-compassion as a path to personal transformation through recognizing destructive emotional states.", created_at:1779564485, source_id:"chunk-3907dc38c0d0edd5d39a312bc7148a7e"}}, {start: {_id:6670}, end: {_id:348}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"illustration,narrative", weight:1.0, description:"The video uses the", created_at:1779564486, source_id:"chunk-3907dc38c0d0edd5d39a312bc7148a7e"}}, {start: {_id:1335}, end: {_id:348}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"forgiveness,teaching", truncate:"", weight:1.0, description:"The video references Buddha's story to illustrate the application of self-compassion in resolving conflict and fostering understanding.", created_at:1779564492, source_id:"chunk-3907dc38c0d0edd5d39a312bc7148a7e"}}, {start: {_id:1335}, end: {_id:6670}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"forgiveness,teaching", truncate:"", weight:1.0, description:"Buddha's response to the businessman's anger demonstrated teachings on self-compassion and emotional awareness.", created_at:1779564492, source_id:"chunk-3907dc38c0d0edd5d39a312bc7148a7e"}}, {start: {_id:1335}, end: {_id:6673}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"shock,teaching moment", truncate:"", weight:1.0, description:"Buddha's disciples are shocked by his refusal to forgive, prompting reflection on his teachings about compassion.", created_at:1779564552, source_id:"chunk-24b5f3611aa0088cf040177e4f897986"}}, {start: {_id:6641}, end: {_id:991}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"guilt,philosophical inquiry", weight:1.0, description:"The businessman's actions and Buddha's response spark a deeper exploration of forgiveness as a concept beyond mere absolution.", created_at:1779564552, source_id:"chunk-24b5f3611aa0088cf040177e4f897986"}}, {start: {_id:6677}, end: {_id:6680}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"humiliation,injustice", truncate:"", weight:1.0, description:"Dharma Raja's wife was humiliated in front of the entire court, contributing to their shared suffering during exile.", created_at:1779564580, source_id:"chunk-cdfac554a3f7f2ebcb638a60cb844514"}}, {start: {_id:6679}, end: {_id:6677}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"exile duration,hardship", truncate:"", weight:1.0, description:"Dharma Raja endured 13 years of exile with unimaginable hardships alongside his wife.", created_at:1779564580, source_id:"chunk-cdfac554a3f7f2ebcb638a60cb844514"}}, {start: {_id:6676}, end: {_id:436}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"emotional response,injustice", weight:1.0, description:"Duryodhana harbored resentment due to being denied the right to rule the entire kingdom.", created_at:1779564589, source_id:"chunk-dadf662841fb50b7a5b2c3f5fc8512f2"}}, {start: {_id:3041}, end: {_id:436}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"emotional conflict,literary example", weight:1.0, description:"The Mahabharata illustrates resentment through Duryodhana's character.", created_at:1779564590, source_id:"chunk-dadf662841fb50b7a5b2c3f5fc8512f2"}}, {start: {_id:89}, end: {_id:6676}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"betrayal,emotional response", weight:1.0, description:"Duryodhana experienced anger over the division of his kingdom and distrust toward his cousins.", created_at:1779564590, source_id:"chunk-dadf662841fb50b7a5b2c3f5fc8512f2"}}, {start: {_id:6675}, end: {_id:3041}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"emotional struggle,narrative framework", weight:1.0, description:"The Mahabharata uses characters to explore inner violence and its consequences.", created_at:1779564590, source_id:"chunk-dadf662841fb50b7a5b2c3f5fc8512f2"}}, {start: {_id:6676}, end: {_id:292}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"disdain,emotional response", weight:1.0, description:"Duryodhana deeply hated his cousins and their perceived usurpation of his birthright.", created_at:1779564590, source_id:"chunk-dadf662841fb50b7a5b2c3f5fc8512f2"}}, {start: {_id:89}, end: {_id:3041}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"emotional response,literary example", weight:1.0, description:"The epic depicts anger as a key driver of Duryodhana's actions.", created_at:1779564590, source_id:"chunk-dadf662841fb50b7a5b2c3f5fc8512f2"}}, {start: {_id:6676}, end: {_id:6675}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"emotional conflict,self-harm", weight:1.0, description:"Duryodhana's inner violence manifested as seething revenge and self-destructive resentment.", created_at:1779564590, source_id:"chunk-dadf662841fb50b7a5b2c3f5fc8512f2"}}, {start: {_id:6676}, end: {_id:6678}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"motivation,retaliation", truncate:"", weight:1.0, description:"Duryodhana's actions were driven by a desire for revenge against those he perceived as wronging him.", created_at:1779564590, source_id:"chunk-dadf662841fb50b7a5b2c3f5fc8512f2"}}, {start: {_id:6677}, end: {_id:6676}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", keywords:"conflict,inevitability,war", truncate:"", weight:1.0, description:"Dharma Raja and Duryodhana's followers' mutual desire for war led to inevitable conflict despite Dharma Raja's efforts to avoid it.", created_at:1779564665, source_id:"chunk-d8c510c8750c7c378759ec2d9cfe2559"}}, {start: {_id:4518}, end: {_id:138}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"forgiveness,peaceful separation", weight:1.0, description:"The woman forgave her husband, leading to a peaceful divorce where she accepted whatever property he offered without legal disputes.", created_at:1779564665, source_id:"chunk-d8c510c8750c7c378759ec2d9cfe2559"}}, {start: {_id:6688}, end: {_id:348}, properties:{file_path:"YouTube Video: 1_-cZz8YRFw (URL: https://www.youtube.com/watch?v=1_-cZz8YRFw)", truncate:"", keywords:"content dissemination,source", weight:1.0, description:"The YouTube Video contains teachings attributed to Dharma Raja about forgiveness and inner peace.", created_at:1779564665, source_id:"chunk-d8c510c8750c7c378759ec2d9cfe2559"}}] AS row
