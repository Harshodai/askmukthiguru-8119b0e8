UNWIND [{start: {_id:8208}, end: {_id:8207}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=5Tdb7hBwX88)", truncate:"", keywords:"breath count,relaxation method", weight:1.0, description:"Humming for eight breaths is tied to deepening relaxation.", created_at:1779734281, source_id:"chunk-edcfa2369ad86b20d06a2814301a95a8"}}, {start: {_id:5343}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=5Tdb7hBwX88)", keywords:"content,intended meaning", truncate:"", weight:1.0, description:"The YouTube Video's intended content is the corrected sentence, despite the actual content being a transcription error with repeated \"Mm\"s.", created_at:1779734300, source_id:"chunk-66d052cfce333baac252a06ac5cc806d"}}, {start: {_id:704}, end: {_id:8212}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8fKvjHOD_kQ)", keywords:"neurological activity reduction,neurological impact,stress reduction,stress relief", truncate:"", weight:2.0, description:"Observation based meditations reduce excessive amygdala activity to break stressful thinking habits.<SEP>Observation based meditations reduce excessive amygdala activity, mitigating fear and anger responses.", created_at:1779734444, source_id:"chunk-753484c5afd977c9b325d198ce9f7e53<SEP>chunk-af42e7cfdd624cdf90c9e6e7cda51567"}}, {start: {_id:305}, end: {_id:8214}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=8fKvjHOD_kQ)", truncate:"", keywords:"brain region activation,emotional balance,neurological activation", weight:2.0, description:"Heart centered meditations activate the anterior cingulate to promote caring and balanced behavior.<SEP>Heart centered meditations activate the anterior cingulate, promoting caring and balanced behavior.", created_at:1779734444, source_id:"chunk-753484c5afd977c9b325d198ce9f7e53<SEP>chunk-af42e7cfdd624cdf90c9e6e7cda51567"}}, {start: {_id:8213}, end: {_id:8212}, properties:{file_path:"unknown_source", truncate:"", keywords:"cognitive enhancement,neurological impact", weight:1.0, description:"Observation based meditations increase neocortex activity to enhance clear thinking.", created_at:1779734337, source_id:"chunk-753484c5afd977c9b325d198ce9f7e53"}}, {start: {_id:8215}, end: {_id:8214}, properties:{file_path:"unknown_source", truncate:"", keywords:"psychological effect,social connection", weight:1.0, description:"Heart centered meditations enable connection flow from the practitioner to the world.", created_at:1779734337, source_id:"chunk-753484c5afd977c9b325d198ce9f7e53"}}, {start: {_id:3952}, end: {_id:1594}, properties:{file_path:"unknown_source", keywords:"Domain Specificity,Spiritual Term", truncate:"", weight:1.0, description:"Sadhana is a domain-specific term in the spiritual context.", created_at:1779734455, source_id:"chunk-4ffd283bc238983d474b77fd2c547d1f"}}, {start: {_id:3952}, end: {_id:1500}, properties:{file_path:"unknown_source", keywords:"Domain Specificity,Spiritual Term", truncate:"", weight:1.0, description:"Limitless Field is a domain-specific term in the spiritual context.", created_at:1779734455, source_id:"chunk-4ffd283bc238983d474b77fd2c547d1f"}}, {start: {_id:8224}, end: {_id:8223}, properties:{file_path:"unknown_source", keywords:"error type,grammatical issue", truncate:"", weight:1.0, description:"Sentence fragment is a grammatical error due to being an incomplete sentence.", created_at:1779734455, source_id:"chunk-116b33bee1824fad76dd5db282ddf141"}}, {start: {_id:8224}, end: {_id:8225}, properties:{file_path:"unknown_source", keywords:"ambiguity,stylistic choice", truncate:"", weight:1.0, description:"Sentence fragment could be a stylistic choice but is classified as a grammatical error.", created_at:1779734456, source_id:"chunk-116b33bee1824fad76dd5db282ddf141"}}, {start: {_id:8226}, end: {_id:8223}, properties:{file_path:"unknown_source", keywords:"correction approach,minimal change", truncate:"", weight:1.0, description:"Minimal fix was considered for the sentence fragment, though the original text left it as a fragment.", created_at:1779734456, source_id:"chunk-116b33bee1824fad76dd5db282ddf141"}}, {start: {_id:8228}, end: {_id:8223}, properties:{file_path:"unknown_source", keywords:"correction approach,minimal change", truncate:"", weight:1.0, description:"Least intrusive change was considered for the sentence fragment.", created_at:1779734456, source_id:"chunk-116b33bee1824fad76dd5db282ddf141"}}, {start: {_id:8224}, end: {_id:8221}, properties:{file_path:"unknown_source", keywords:"error type,typo", truncate:"", weight:1.0, description:"Hand hold is a grammatical error (typo) that was corrected to \"hand-hold\".", created_at:1779734456, source_id:"chunk-116b33bee1824fad76dd5db282ddf141"}}, {start: {_id:8227}, end: {_id:8223}, properties:{file_path:"unknown_source", keywords:"constraint,style", truncate:"", weight:1.0, description:"Rewriting was rejected for the sentence fragment to retain original meaning and style.", created_at:1779734456, source_id:"chunk-116b33bee1824fad76dd5db282ddf141"}}, {start: {_id:8218}, end: {_id:8239}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", truncate:"", keywords:"effectiveness,experience level,method,practice compatibility,practice preference,preference,suitability,user", weight:4.0, description:"Seasoned meditators can effectively use guided meditations.<SEP>Both guided and unguided meditations are used by seasoned meditators.<SEP>Seasoned meditators find guided meditations effective alongside independent practice.<SEP>Guided meditations are considered suitable for seasoned meditators alongside unguided practices.", created_at:1779735012, source_id:"chunk-b3d60e278a1f47b474049eb9d574026e<SEP>chunk-59826b76f9c0df8dac3d55bfd1895e81<SEP>chunk-a6282514b611392194d87cce5b2c4ab4<SEP>chunk-ea2c880e0817109d2e1724af65951447"}}, {start: {_id:348}, end: {_id:8242}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", truncate:"", keywords:"discussion topic,source content", weight:1.0, description:"The YouTube video discusses \"itations\" as part of meditation practices.", created_at:1779734577, source_id:"chunk-b3d60e278a1f47b474049eb9d574026e"}}, {start: {_id:8216}, end: {_id:8218}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", truncate:"", keywords:"appeal,challenge,practice difficulty,relevance", weight:2.0, description:"Beginners may attempt guided meditations intended for advanced practitioners.<SEP>Guided meditations are often preferred by beginners who feel daunted by unstructured practices.", created_at:1779735013, source_id:"chunk-b3d60e278a1f47b474049eb9d574026e<SEP>chunk-ea2c880e0817109d2e1724af65951447"}}, {start: {_id:8239}, end: {_id:8243}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", truncate:"", keywords:"autonomy,experience level,exploration,practice compatibility,preference,suitability", weight:3.0, description:"Seasoned meditators can effectively use unguided meditation.<SEP>Unguided meditation allows seasoned meditators to autonomously explore uncharted consciousness.<SEP>Unguided meditation is considered suitable for seasoned meditators alongside guided practices.", created_at:1779734986, source_id:"chunk-b3d60e278a1f47b474049eb9d574026e<SEP>chunk-ea2c880e0817109d2e1724af65951447"}}, {start: {_id:8216}, end: {_id:8244}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", keywords:"disappointment,expectation", truncate:"", weight:1.0, description:"Beginners give up due to expecting instant results from meditation.", created_at:1779734577, source_id:"chunk-b3d60e278a1f47b474049eb9d574026e"}}, {start: {_id:8238}, end: {_id:1463}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=0u9oe-5HPmk)", keywords:"disappointment,expectation", truncate:"", weight:1.0, description:"People hoping for instant results leads to disappointment.", created_at:1779734645, source_id:"chunk-a10e920484b4b5f03e118c89aee5a8de"}}] AS row
