UNWIND [{start: {_id:3452}, end: {_id:1782}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", keywords:"closed-mindedness,conflict", truncate:"", weight:1.0, description:"Rigid perceptions lead to insensitivity and disregard for the partner's feelings.", created_at:1779242495, source_id:"chunk-8b1cb9338748404cabaa24ac4be68f56"}}, {start: {_id:3860}, end: {_id:1782}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", truncate:"", keywords:"emotional disconnect,judgment", weight:1.0, description:"Intolerance reinforces the relational rift and emotional disconnect.", created_at:1779242495, source_id:"chunk-8b1cb9338748404cabaa24ac4be68f56"}}, {start: {_id:3870}, end: {_id:1782}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", truncate:"", keywords:"emotional harm,insensitivity", weight:1.0, description:"Judgmental behavior harms the relationship and reflects insensitivity to the partner.", created_at:1779242495, source_id:"chunk-8b1cb9338748404cabaa24ac4be68f56"}}, {start: {_id:3871}, end: {_id:1782}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", truncate:"", keywords:"emotional neglect,relational strain", weight:1.0, description:"Insensitivity exacerbates the rift and neglects the partner's emotional needs.", created_at:1779242495, source_id:"chunk-8b1cb9338748404cabaa24ac4be68f56"}}, {start: {_id:3872}, end: {_id:1782}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", truncate:"", keywords:"emotional needs,mutual understanding", weight:1.0, description:"The speaker acknowledges the need for mutual understanding of feelings to heal the rift.", created_at:1779242495, source_id:"chunk-8b1cb9338748404cabaa24ac4be68f56"}}, {start: {_id:299}, end: {_id:1782}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.you