UNWIND [{start: {_id:945}, end: {_id:176}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"contrast,opposition", truncate:"", weight:1.0, description:"Spiritual vision prevents the shadow of staleness by promoting growth and vitality in relationships.", created_at:1779142057, source_id:"chunk-dfd063e448fde077331ddbd4cc16008f"}}, {start: {_id:176}, end: {_id:1104}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"contrast,emphasis", truncate:"", weight:1.0, description:"The section emphasizes spiritual vision as superior to external factors like wealth or appearance in sustaining relationships.", created_at:1779142058, source_id:"chunk-dfd063e448fde077331ddbd4cc16008f"}}, {start: {_id:1105}, end: {_id:176}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"healing,preservation", truncate:"", weight:1.0, description:"Spiritual vision is shown to preserve marriages and friendships by healing emotional divides.", created_at:1779142058, source_id:"chunk-dfd063e448fde077331ddbd4cc16008f"}}, {start: {_id:940}, end: {_id:942}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"creation,transformation", truncate:"", weight:1.0, description:"Third fellow transforms the skeleton into a lion carcass by adding flesh and meat.", created_at:1779142106, source_id:"chunk-6e9975c29b6eeab07aa117c06143418a"}}, {start: {_id:1107}, end: {_id:1106}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"discovery,exploration", truncate:"", weight:1.0, description:"The four friends encounter the heap of bones in the forest, prompting their experiments.", created_at:1779142106, source_id:"chunk-6e9975c29b6eeab07aa117c06143418a"}}, {start: {_id:1107}, end: {_id:947}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"metaphorical struggle,overcoming pain", weight:1.0, description:"The characters' journey involves confronting and emerging from the shadow of hurt.", created_at:1779142106, source_id:"chunk-6e9975c29b6eeab07aa117c06143418a"}}, {start: {_id:941}, end: {_id:946}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"safety action,trigger", truncate:"", weight:1.0, description:"Fourth fellow's attempt to animate the carcass triggers the second fellow to climb the tree for safety.", created_at:1779142106, source_id:"chunk-6e9975c29b6eeab07aa117c06143418a"}}, {start: {_id:1107}, end: {_id:945}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"metaphorical struggle,seeking renewal", weight:1.0, description:"The characters aim to break free from the shadow of staleness through their experiments.", created_at:1779142106, source_id:"chunk-6e9975c29b6eeab07aa117c06143418a"}}, {start: {_id:1108}, end: {_id:598}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"escalation,progression", truncate:"", weight:1.0, description:"Judgment often leads to aversion, deepening relational disconnection.", created_at:1779142150, source_id:"chunk-3b8dde7779e0c2342011917f0bce24aa"}}, {start: {_id:1109}, end: {_id:1110}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"educational tool,illustration", truncate:"", weight:1.0, description:"The ancient fable illustrates the concept of initial hurt as part of relational disconnection.", created_at:1779142150, source_id:"chunk-3b8dde7779e0c2342011917f0bce24aa"}}, {start: {_id:1110}, end: {_id:598}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"escalation,progression", truncate:"", weight:1.0, description:"Initial hurt can escalate into judgment if not addressed promptly.", created_at:1779142150, source_id:"chunk-3b8dde7779e0c2342011917f0bce24aa"}}, {start: {_id:1111}, end: {_id:1110}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"escalation,psychological effect", truncate:"", weight:1.0, description:"Unaddressed hurt can transform into harmful obsessions affecting self-respect.", created_at:1779142150, source_id:"chunk-3b8dde7779e0c2342011917f0bce24aa"}}, {start: {_id:1109}, end: {_id:598}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"educational tool,illustration", truncate:"", weight:1.0, description:"The ancient fable demonstrates how judgment becomes a breeding ground for disconnection.", created_at:1779142150, source_id:"chunk-3b8dde7779e0c2342011917f0bce24aa"}}, {start: {_id:1109}, end: {_id:1108}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"educational tool,illustration", truncate:"", weight:1.0, description:"The fable portrays aversion as the final stage of relational disconnection.", created_at:1779142150, source_id:"chunk-3b8dde7779e0c2342011917f0bce24aa"}}, {start: {_id:964}, end: {_id:577}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cyclical bitterness,temporary relief", truncate:"", weight:1.0, description:"Dopamine-fueled escapes provide short-term relief but fail to address root causes, leading to recurring negativity.", created_at:1779142194, source_id:"chunk-8aad6ef1fd3889e4b8c9933c17173354"}}, {start: {_id:371}, end: {_id:1112}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"contextual persistence", truncate:"", weight:1.0, description:"Even in an idealized romantic setting, loneliness remains unchanged, underscoring the depth of emotional disconnection.", created_at:1779142194, source_id:"chunk-8aad6ef1fd3889e4b8c9933c17173354"}}, {start: {_id:1113}, end: {_id:1115}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional state", truncate:"", weight:1.0, description:"The third stage is defined by aversion, where negative perceptions of a partner intensify, leading to pain and loss of respect.", created_at:1779142194, source_id:"chunk-8aad6ef1fd3889e4b8c9933c17173354"}}, {start: {_id:577}, end: {_id:495}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional blockage,lack of energy", truncate:"", weight:1.0, description:"Unaddressed negative emotions prevent experiencing joy, gratitude, or connection due to preoccupation with pain.", created_at:1779142194, source_id:"chunk-8aad6ef1fd3889e4b8c9933c17173354"}}, {start: {_id:1114}, end: {_id:1113}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"aversion,emotional reaction", truncate:"", weight:1.0, description:"The presence and actions of a partner become irritating and painful, contributing to the third stage of disconnection.", created_at:1779142194, source_id:"chunk-8aad6ef1fd3889e4b8c9933c17173354"}}, {start: {_id:1117}, end: {_id:968}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"capture technique,problem-solving", truncate:"", weight:1.0, description:"Villagers use the method to capture mischievous monkeys.", created_at:1779142223, source_id:"chunk-b0b6f9f02020768407fee531e6074a4d"}}] AS row
