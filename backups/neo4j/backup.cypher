UNWIND [{start: {_id:3990}, end: {_id:4011}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", truncate:"", keywords:"geological feature,pressure comparison", weight:1.0, description:"The Mariana Trench experiences pressures 1071 times greater than standard atmospheric pressure at sea level.", created_at:1779250515, source_id:"chunk-3fc0440bd350f3b05bf870c0f550544d"}}, {start: {_id:1703}, end: {_id:4025}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", truncate:"", keywords:"decision-making,leadership ethics", weight:1.0, description:"Power and responsibility are interconnected in fostering inclusive and ethical leadership.", created_at:1779250515, source_id:"chunk-3fc0440bd350f3b05bf870c0f550544d"}}, {start: {_id:4026}, end: {_id:3998}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", truncate:"", keywords:"environmental practices,well-being", weight:1.0, description:"Sustainability practices are linked to achieving longevity through ecological balance.", created_at:1779250515, source_id:"chunk-3fc0440bd350f3b05bf870c0f550544d"}}, {start: {_id:4024}, end: {_id:3990}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", truncate:"", keywords:"biodiversity,survival adaptation", weight:1.0, description:"Living forms in the Mariana Trench demonstrate remarkable adaptation to extreme pressure and darkness.", created_at:1779250516, source_id:"chunk-3fc0440bd350f3b05bf870c0f550544d"}}, {start: {_id:4024}, end: {_id:3998}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=obK5uqYXOJU)", truncate:"", keywords:"biodiversity,environmental focus", weight:1.0, description:"Sustainability practices involve studying and preserving flora and fauna in different regions of the world.", created_at:1779250516, source_id:"chunk-3fc0440bd350f3b05bf870c0f550544d