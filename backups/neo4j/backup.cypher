UNWIND [{start: {_id:2731}, end: {_id:578}, properties:{file_path:"unknown_source", keywords:"life phase,temporal context", truncate:"", weight:1.0, description:"The second life journey is part of the future and is undertaken within its temporal context.", created_at:1779179368, source_id:"chunk-14473e52fc6ef3ac056612345f72aa74"}}, {start: {_id:2733}, end: {_id:2732}, properties:{file_path:"unknown_source", keywords:"acceptance,attitude", truncate:"", weight:1.0, description:"The present is accepted with grace and ease, reflecting a positive approach.", created_at:1779179368, source_id:"chunk-14473e52fc6ef3ac056612345f72aa74"}}, {start: {_id:536}, end: {_id:542}, properties:{file_path:"unknown_source", truncate:"", keywords:"conflict,relationship strain,self-preoccupation,timidity", weight:2.0, description:"The man's self-preoccupation drives his desire to control his girlfriend and fear of losing her.<SEP>The girlfriend's resistance to adventure creates tension and highlights the man's insecurity.", created_at:1779179368, source_id:"chunk-107b2dccdd97eea5e4e04ec3f64a95a9"}}, {start: {_id:473}, end: {_id:578}, properties:{file_path:"unknown_source", keywords:"foundation,preparation", truncate:"", weight:1.0, description:"Accessing one's inner truth is a foundational step in preparing for the second life journey.", created_at:1779179368, source_id:"chunk-14473e52fc6ef3ac056612345f72aa74"}}, {start: {_id:89}, end: {_id:688}, properties:{file_path:"unknown_source", keywords:"conflict,emotional spiral", truncate:"", weight:1.0, description:"Anger arises from self-preoccupation and exacerbates relationship challenges.", created_at:1779179368, source_id:"chunk-107b2dccdd97eea5e4e04ec3f64a95a9"}}, {start: {_id:473}, end: {_id:688}, properties:{file_path:"unknown_source", keywords:"emotional growth,suffering", truncate:"", weight:1.0, description:"Observing inner truth dissolves self-preoccupation and fosters healthier relationships.", created_at:1779179368, source_id:"chunk-107b2dccdd97eea5e4e04ec3f64a95a9"}}, {start: {_id:62}, end: {_id:573}, properties:{file_path:"unknown_source", keywords:"authorship,content", truncate:"", weight:1.0, description:"Preethaji authored the book \"The Second Sacred Secret,\" which explores the concept of inner truth.", created_at:1779179397, source_id:"chunk-dec047b5cab8e88110c88f8cc2cfcd7d"}}, {start: {_id:696}, end: {_id:404}, properties:{file_path:"unknown_source", keywords:"achieved through,requires", truncate:"", weight:1.0, description:"Authentic self-love is achieved by transitioning from self-obsession to observation, fostering calm and self-acceptance.`", created_at:1779179452, source_id:"chunk-dc33576be7c40b3be079f258d63f03be"}}, {start: {_id:612}, end: {_id:506}, properties:{file_path:"unknown_source", keywords:"causes,internal conflict,perpetuates,psychological impact", truncate:"", weight:2.0, description:"Self-obsession directly causes and perpetuates the inner war through cycles of comparison, self-criticism, and dissatisfaction.`<SEP>Self-obsession fuels inner war through constant self-measurement and preoccupation with others' perceptions.", created_at:1779184159, source_id:"chunk-dc33576be7c40b3be079f258d63f03be<SEP>chunk-5c02e046d7832f0655166e3f716f3e10"}}, {start: {_id:754}, end: {_id:755}, properties:{file_path:"unknown_source", keywords:"embodiment,emotional state", truncate:"", weight:1.0, description:"The Beautiful Self naturally radiates peace through self-acceptance and lack of internal strife.", created_at:1779179452, source_id:"chunk-6af7eefe80697b9b2cf1b0520fd6a984"}}, {start: {_id:2742}, end: {_id:404}, properties:{file_path:"unknown_source", keywords:"activates,shifts", truncate:"", weight:1.0, description:"Observation shifts neural activity from the amygdala (fear/anger) to the mid-prefrontal cortex (intelligent thought/connection), as per Dr. Siegel's research.`", created_at:1779179453, source_id:"chunk-dc33576be7c40b3be079f258d63f03be"}}, {start: {_id:690}, end: {_id:506}, properties:{file_path:"unknown_source", keywords:"distracts from,exacerbates", truncate:"", weight:1.0, description:"Self-obsession distracts individuals from addressing external challenges and exacerbates perceived injustices in life.`", created_at:1779179453, source_id:"chunk-dc33576be7c40b3be079f258d63f03be"}}, {start: {_id:2734}, end: {_id:464}, properties:{file_path:"unknown_source", keywords:"outcome,self-integration", truncate:"", weight:1.0, description:"The practice promotes inner wholeness by harmonizing conflicting self-perceptions.", created_at:1779179453, source_id:"chunk-6af7eefe80697b9b2cf1b0520fd6a984"}}, {start: {_id:713}, end: {_id:2743}, properties:{file_path:"unknown_source", keywords:"self-discovery,transformation", truncate:"", weight:1.0, description:"Maureen's participation in the retreat led to her transformative experience and self-discovery.", created_at:1779179453, source_id:"chunk-7146bcb62c68c22b68c6b0cc9e8d3a09"}}, {start: {_id:2736}, end: {_id:2735}, properties:{file_path:"unknown_source", truncate:"", keywords:"psychological conflict,self-criticism", weight:3.0, description:"Warring-self states manifest as inner critics leading to self-criticism and psychological conflict.<SEP>Warring-self states manifest as inner critics causing self-criticism and psychological conflict.", created_at:1779179453, source_id:"chunk-7146bcb62c68c22b68c6b0cc9e8d3a09"}}, {start: {_id:705}, end: {_id:404}, properties:{file_path:"unknown_source", keywords:"supports,validates", truncate:"", weight:1.0, description:"Dr. Siegel's work scientifically validates the benefits of observation in reducing inner conflict and enhancing mental clarity.`", created_at:1779179453, source_id:"chunk-dc33576be7c40b3be079f258d63f03be"}}, {start: {_id:721}, end: {_id:713}, properties:{file_path:"unknown_source", keywords:"healing,transcendental experience", truncate:"", weight:1.0, description:"Maureen's meditation experience allowed her to heal from past trauma.", created_at:1779179453, source_id:"chunk-7146bcb62c68c22b68c6b0cc9e8d3a09"}}, {start: {_id:2737}, end: {_id:732}, properties:{file_path:"unknown_source", keywords:"self-criticism", truncate:"", weight:1.0, description:"Inner critics prevent the experience of calm and joy by fostering judgment and comparison.", created_at:1779179453, source_id:"chunk-7146bcb62c68c22b68c6b0cc9e8d3a09"}}, {start: {_id:713}, end: {_id:2744}, properties:{file_path:"unknown_source", keywords:"compassion,mentorship", truncate:"", weight:1.0, description:"Maureen became a mentor to young employees, showing compassion and guiding them.", created_at:1779179453, source_id:"chunk-7146bcb62c68c22b68c6b0cc9e8d3a09"}}, {start: {_id:2737}, end: {_id:737}, properties:{file_path:"unknown_source", keywords:"divide,self-criticism,steal", truncate:"", weight:2.0, description:"Calm and joy are achieved when warring-self states and inner critics are absent.<SEP>Warring-self states steal joy and calm by dividing experiences into \"should be\" and \"should not be.\"", created_at:1779179602, source_id:"chunk-7146bcb62c68c22b68c6b0cc9e8d3a09<SEP>chunk-6d0566c8fa6f2aed45fb2e69b00761b1"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
UNWIND [{start: {_id:279}, end: {_id:2738}, properties:{file_path:"unknown_source", keywords:"behavioral pattern,insecurity", truncate:"", weight:1.0, description:"Alex's obsessive habit of comparing himself to others perpetuates feelings of inferiority despite his achievements.", created_at:1779179454, source_id:"chunk-676c070f41c08ddde395290878529cf3"}}, {start: {_id:2738}, end: {_id:642}, properties:{file_path:"unknown_source", keywords:"avoidance,insecurity,manifestation", truncate:"", weight:3.0, description:"The shrinking self directly manifests as self-comparison, perpetuating cycles of dissatisfaction and external validation-seeking.<SEP>The shrinking self is perpetuated by addictive self-comparison, leading to avoidance of life?s opportunities.`", created_at:1779179603, source_id:"chunk-676c070f41c08ddde395290878529cf3<SEP>chunk-747dd6f3fc344d596e672f021c5892ee"}}, {start: {_id:279}, end: {_id:2739}, properties:{file_path:"unknown_source", keywords:"resolution,transcendence", truncate:"", weight:1.0, description:"Through mystic meditation with Krishnaji, Alex dissolved inner disharmony and experienced unity beyond self-division.", created_at:1779179454, source_id:"chunk-676c070f41c08ddde395290878529cf3"}}, {start: {_id:1616}, end: {_id:2739}, properties:{file_path:"unknown_source", keywords:"transcendence,unity", truncate:"", weight:1.0, description:"Mystic meditation enabled Alex to transcend the illusion of a limited self and experience undivided consciousness.", created_at:1779179454, source_id:"chunk-676c070f41c08ddde395290878529cf3"}}, {start: {_id:612}, end: {_id:2738}, properties:{file_path:"unknown_source", keywords:"conflict,psychological driver", truncate:"", weight:1.0, description:"Self-comparison arises from the inner war between conflicting desires for validation and self-worth.", created_at:1779179454, source_id:"chunk-676c070f41c08ddde395290878529cf3"}}, {start: {_id:2745}, end: {_id:2746}, properties:{file_path:"unknown_source", keywords:"approval,feedback", truncate:"", weight:1.0, description:"The tutor provided feedback on Lokaa's poem, noting its lack of inner divide and expressing approval.", created_at:1779179455, source_id:"chunk-2bd00175db71e25481fb9ce67f057b84"}}, {start: {_id:768}, end: {_id:2747}, properties:{file_path:"unknown_source", keywords:"decision-making,psychological impact", truncate:"", weight:1.0, description:"Self-obsession leads to indecisiveness and reliance on luck in important decisions.", created_at:1779179455, source_id:"chunk-2bd00175db71e25481fb9ce67f057b84"}}, {start: {_id:768}, end: {_id:2740}, properties:{file_path:"unknown_source", truncate:"", keywords:"metaphorical comparison,psychological impact", weight:1.0, description:"The metaphor of playing tag illustrates how lack of self-harmony leads to indecisiveness in adult decisions.", created_at:1779179455, source_id:"chunk-2bd00175db71e25481fb9ce67f057b84"}}, {start: {_id:768}, end: {_id:506}, properties:{file_path:"unknown_source", keywords:"decision-making,psychological impact", truncate:"", weight:1.0, description:"Self-obsession leads to indecisiveness and reliance on luck in important decisions.", created_at:1779179455, source_id:"chunk-2bd00175db71e25481fb9ce67f057b84"}}, {start: {_id:466}, end: {_id:42}, properties:{file_path:"unknown_source", keywords:"mental state,self-perception", truncate:"", weight:1.0, description:"Self-acceptance is linked to a state of wholeness and lack of internal conflict.", created_at:1779179455, source_id:"chunk-2bd00175db71e25481fb9ce67f057b84"}}, {start: {_id:62}, end: {_id:466}, properties:{file_path:"unknown_source", keywords:"advocacy,message", truncate:"", weight:1.0, description:"Preethaji's work advocates for self-acceptance and dissolving the inner divide.", created_at:1779179456, source_id:"chunk-2bd00175db71e25481fb9ce67f057b84"}}, {start: {_id:584}, end: {_id:61}, properties:{file_path:"unknown_source", keywords:"poem contrast,thematic difference", truncate:"", weight:1.0, description:"Lokaa's poem contrasts with Abigail Grith's \"Inside-Outside,\" lacking the inner divide.", created_at:1779179456, source_id:"chunk-2bd00175db71e25481fb9ce67f057b84"}}, {start: {_id:734}, end: {_id:612}, properties:{file_path:"unknown_source", keywords:"enable,lead to", truncate:"", weight:1.0, description:"Incessant commentary leads to inner war by fostering comparison and self-criticism.", created_at:1779179602, source_id:"chunk-6d0566c8fa6f2aed45fb2e69b00761b1"}}, {start: {_id:761}, end: {_id:2752}, properties:{file_path:"unknown_source", keywords:"dissolve,transform", truncate:"", weight:1.0, description:"Self-criticism dissolves through serene observation, leading to inner wholeness.", created_at:1779179602, source_id:"chunk-6d0566c8fa6f2aed45fb2e69b00761b1"}}, {start: {_id:110}, end: {_id:753}, properties:{file_path:"unknown_source", keywords:"celebrate,embody", truncate:"", weight:1.0, description:"The beautiful life embodies harmony by celebrating existence without judgment.", created_at:1779179602, source_id:"chunk-6d0566c8fa6f2aed45fb2e69b00761b1"}}, {start: {_id:2763}, end: {_id:2751}, properties:{file_path:"unknown_source", keywords:"awaken,enable", truncate:"", weight:1.0, description:"The absence of commentary enables pure consciousness and awakens harmony.", created_at:1779179602, source_id:"chunk-6d0566c8fa6f2aed45fb2e69b00761b1"}}, {start: {_id:2734}, end: {_id:2752}, properties:{file_path:"unknown_source", keywords:"cultivate,embrace", truncate:"", weight:1.0, description:"Serene observation cultivates inner wholeness by embracing all aspects of oneself.", created_at:1779179602, source_id:"chunk-6d0566c8fa6f2aed45fb2e69b00761b1"}}, {start: {_id:2737}, end: {_id:734}, properties:{file_path:"unknown_source", keywords:"destroy,erode", truncate:"", weight:1.0, description:"Incessant commentary erodes calm and joy by perpetuating self-judgment.", created_at:1779179602, source_id:"chunk-6d0566c8fa6f2aed45fb2e69b00761b1"}}, {start: {_id:2750}, end: {_id:2751}, properties:{file_path:"unknown_source", keywords:"manifest,realize", truncate:"", weight:1.0, description:"Pure consciousness realizes compassion and freedom through acceptance of \"what is.\"", created_at:1779179602, source_id:"chunk-6d0566c8fa6f2aed45fb2e69b00761b1"}}, {start: {_id:659}, end: {_id:662}, properties:{file_path:"unknown_source", keywords:"resignation,self-comparison", truncate:"", weight:2.0, description:"Beth?s lifelong comparison with siblings resulted in an inert self, marked by passivity and low self-esteem.`", created_at:1779179602, source_id:"chunk-747dd6f3fc344d596e672f021c5892ee"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTED]->(end) SET r += row.properties;
