UNWIND [{start: {_id:539}, end: {_id:535}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"adventurous activities,courage", truncate:"", weight:1.0, description:"Bungee jumping reflects the participant's pursuit of challenging experiences.", created_at:1779138389, source_id:"chunk-b6f27d31a498b77b0b04616019c42b1a"}}, {start: {_id:540}, end: {_id:535}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"adventurous activities,courage", truncate:"", weight:1.0, description:"Paragliding underscores the participant's willingness to engage in high-risk activities.", created_at:1779138389, source_id:"chunk-b6f27d31a498b77b0b04616019c42b1a"}}, {start: {_id:536}, end: {_id:535}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"motivation,request for help", truncate:"", weight:1.0, description:"The participant explicitly requests help for his girlfriend to ensure their happiness, indicating his motivation to assist her.", created_at:1779138389, source_id:"chunk-b6f27d31a498b77b0b04616019c42b1a"}}, {start: {_id:17}, end: {_id:535}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"anticipation,silent observation", truncate:"", weight:1.0, description:"Krishnaji's silence and anticipation suggest his awareness of the participant's impending self-realization.", created_at:1779138390, source_id:"chunk-b6f27d31a498b77b0b04616019c42b1a"}}, {start: {_id:17}, end: {_id:542}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", truncate:"", keywords:"boldness,fear,guidance,inner truth,questioning,self-awareness", weight:3.0, description:"Krishnaji questions the man about his fears and the nature of being bold and free of fear.<SEP>Krishnaji's questions prompt the man to observe his inner truth and relationship.<SEP>Krishnaji helps the man confront his self-obsession and observe his inner truth.", created_at:1779179368, source_id:"chunk-d3a4dff4595123f3b03c3ba55182efe7<SEP>chunk-107b2dccdd97eea5e4e04ec3f64a95a9"}}, {start: {_id:225}, end: {_id:542}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"education,employment,learning,self-obsession", weight:12.0, description:"Man shares his realization with a teacher at the academy, indicating a connection between his learning and the institution.<SEP>Man's self-obsession is addressed through his learning and observation at the academy.", created_at:1779138417, source_id:"chunk-d3a4dff4595123f3b03c3ba55182efe7"}}, {start: {_id:197}, end: {_id:542}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"inner truth,introspection,relationship,self-observation", weight:13.0, description:"Man's inner truth bears on his relationship and is observed through introspection.<SEP>Man's inner truth is observed through his introspection and self-observation.<SEP>Man began to observe his inner world, leading to self-realization.", created_at:1779138417, source_id:"chunk-d3a4dff4595123f3b03c3ba55182efe7"}}, {start: {_id:542}, end: {_id:506}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"inner truth,realization,self-awareness", weight:12.0, description:"Man realized his self-obsession through self-observation and introspection.<SEP>Man's self-obsession is a result of observing his inner truth.", created_at:1779138417, source_id:"chunk-d3a4dff4595123f3b03c3ba55182efe7"}}, {start: {_id:546}, end: {_id:544}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"creating,family goals", truncate:"", weight:2.0, description:"The Man is creating a loving family with The Woman.", created_at:1779138446, source_id:"chunk-3cea1660026a8c404547b5881940bd50"}}, {start: {_id:544}, end: {_id:547}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"family goals,transformation", truncate:"", weight:2.0, description:"They are creating a loving family together, transforming their relationship.", created_at:1779138446, source_id:"chunk-3cea1660026a8c404547b5881940bd50"}}, {start: {_id:514}, end: {_id:544}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"practice,prevention", truncate:"", weight:1.0, description:"The Sacred Secret helps prevent separation and loss.", created_at:1779138446, source_id:"chunk-3cea1660026a8c404547b5881940bd50"}}, {start: {_id:549}, end: {_id:544}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"convincing,love expression", truncate:"", weight:1.0, description:"The man uses the gift to convince the woman of his love.", created_at:1779138446, source_id:"chunk-3cea1660026a8c404547b5881940bd50"}}, {start: {_id:543}, end: {_id:544}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"insecurity,possessiveness", truncate:"", weight:1.0, description:"The man's insecurity and possessiveness affect the relationship.", created_at:1779138446, source_id:"chunk-3cea1660026a8c404547b5881940bd50"}}, {start: {_id:548}, end: {_id:544}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"practice,prevention", truncate:"", weight:1.0, description:"The Sacred Secret helps prevent separation and loss.", created_at:1779138446, source_id:"chunk-3cea1660026a8c404547b5881940bd50"}}, {start: {_id:543}, end: {_id:547}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"insecurity,possessiveness", truncate:"", weight:40.0, description:"The woman's response affects the man's insecurity.<SEP>The woman's response", created_at:1779138446, source_id:"chunk-3cea1660026a8c404547b5881940bd50"}}, {start: {_id:545}, end: {_id:544}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"avoidance,prevention", truncate:"", weight:1.0, description:"The Sacred Secret helps avoid costly mistakes.", created_at:1779138446, source_id:"chunk-3cea1660026a8c404547b5881940bd50"}}, {start: {_id:550}, end: {_id:514}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional regulation,habit reduction", truncate:"", weight:1.0, description:"The secret aids in controlling and diminishing harmful emotional habits.", created_at:1779138470, source_id:"chunk-031bd1294ef04a689b10ae93123dbc7a"}}, {start: {_id:553}, end: {_id:17}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", truncate:"", keywords:"empathy,forgiveness,healing,meditation,mentor,mentor-student,process design,self-realization,therapeutic guidance", weight:5.0, description:"Krishnaji helps Diego through a process that reveals his self-absorption and guilt as the root of his suffering.<SEP>Diego meditates with Krishnaji to seek forgiveness for his emotional absence.<SEP>Krishnaji guides Diego to process his grief and accept his son's death.<SEP>Diego seeks guidance from Krishnaji to overcome his guilt and depression, leading to the adoption of the Serene Mind Practice.<SEP>Krishnaji acted as a mentor to Diego, designing a process to help him overcome his suffering.", created_at:1779183982, source_id:"chunk-aba350ed9d0892b4b1d22f7c1f604b21<SEP>chunk-0c857ef7148c7fabda317a3a8fe52f05<SEP>chunk-214089f71bed8468f80247a24979283e<SEP>chunk-107b2dccdd97eea5e4e04ec3f64a95a9<SEP>chunk-999192b96103e7c498639cfadd062722"}}, {start: {_id:553}, end: {_id:506}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"internal conflict,realization", truncate:"", weight:1.0, description:"Diego recognizes that his guilt and self-punishment stem from a meaningless obsession with himself rather than genuine love.", created_at:1779138559, source_id:"chunk-aba350ed9d0892b4b1d22f7c1f604b21"}}, {start: {_id:553}, end: {_id:557}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"death,guilt", truncate:"", weight:1.0, description:"Diego's guilt stems from his role in his son's death and his disconnection from his son.", created_at:1779138598, source_id:"chunk-0c857ef7148c7fabda317a3a8fe52f05"}}] AS row
