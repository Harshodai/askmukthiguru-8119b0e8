UNWIND [{start: {_id:1406}, end: {_id:1463}, properties:{file_path:"unknown_source", keywords:"role model pressure,self-judgment", truncate:"", weight:1.0, description:"Depression arises from constant self-measurement against imposed role models and internal conflict.", created_at:1779524873, source_id:"chunk-3d3e1db7059b50ed67e675540955de81"}}, {start: {_id:292}, end: {_id:1188}, properties:{file_path:"unknown_source", keywords:"role model pressure,self-hatred", truncate:"", weight:1.0, description:"The enforced role model leads to self-hatred and dissatisfaction among individuals.", created_at:1779524874, source_id:"chunk-3d3e1db7059b50ed67e675540955de81"}}, {start: {_id:684}, end: {_id:2604}, properties:{file_path:"unknown_source", keywords:"societal norms,upbringing", truncate:"", weight:1.0, description:"The civilization perpetuates societal norms through the upbringing of children.", created_at:1779524874, source_id:"chunk-3d3e1db7059b50ed67e675540955de81"}}, {start: {_id:5764}, end: {_id:1188}, properties:{file_path:"unknown_source", keywords:"consequence,dissatisfaction", truncate:"", weight:1.0, description:"The pressure to conform to role models results in a lost generation.", created_at:1779524874, source_id:"chunk-3d3e1db7059b50ed67e675540955de81"}}, {start: {_id:5781}, end: {_id:3255}, properties:{file_path:"unknown_source", truncate:"", keywords:"historical conflict,societal struggle", weight:2.0, description:"The United States has faced a prolonged struggle between ideals of unity and actual divisiveness.<SEP>The United States has faced a prolonged struggle between ideals of unity and actual divisiveness.", created_at:1779530954, source_id:"chunk-bfec7ed2213b36e2e9d3090ab708cd73"}}, {start: {_id:89}, end: {_id:292}, properties:{file_path:"unknown_source", keywords:"emotional cycle,escalation", truncate:"", weight:2.0, description:"Anger and hate perpetuate a cycle of division.<SEP>Anger and hate perpetuate a cycle of division.", created_at:1779530954, source_id:"chunk-bfec7ed2213b36e2e9d3090ab708cd73"}}, {start: {_id:5781}, end: {_id:3271}, properties:{file_path:"unknown_source", keywords:"cause and effect,societal impact", truncate:"", weight:2.0, description:"Divisiveness manifests as violence and death in society.<SEP>Divisiveness manifests as violence and death in society.", created_at:1779530955, source_id:"chunk-bfec7ed2213b36e2e9d3090ab708cd73"}}, {start: {_id:1179}, end: {_id:3255}, properties:{file_path:"unknown_source", keywords:"aspirational conflict,tension", truncate:"", weight:2.0, description:"The United States struggles to reconcile its ideals with societal divisiveness.<SEP>The United States struggles to reconcile its ideals with societal divisiveness.", created_at:1779530955, source_id:"chunk-bfec7ed2213b36e2e9d3090ab708cd73"}}, {start: {_id:5057}, end: {_id:5781}, properties:{file_path:"unknown_source", truncate:"", keywords:"direct consequence,interpersonal dynamics", weight:2.0, description:"Divisiveness causes conflicts within families and communities.<SEP>Divisiveness causes conflicts within families and communities.", created_at:1779530955, source_id:"chunk-bfec7ed2213b36e2e9d3090ab708cd73"}}, {start: {_id:5781}, end: {_id:5778}, properties:{file_path:"unknown_source", keywords:"amplification,political impact", truncate:"", weight:2.0, description:"Elections intensify societal divisions and anger.<SEP>Elections intensify societal divisions and anger.", created_at:1779530955, source_id:"chunk-bfec7ed2213b36e2e9d3090ab708cd73"}}, {start: {_id:5781}, end: {_id:1395}, properties:{file_path:"unknown_source", keywords:"influence,societal dynamics", truncate:"", weight:2.0, description:"Leaders play a role in either perpetuating or mitigating divisiveness.<SEP>Leaders play a role in either perpetuating or mitigating divisiveness.", created_at:1779530956, source_id:"chunk-bfec7ed2213b36e2e9d3090ab708cd73"}}, {start: {_id:2023}, end: {_id:5781}, properties:{file_path:"unknown_source", keywords:"cause and effect,extreme consequence", truncate:"", weight:2.0, description:"Divisiveness leads to death through conflicts and violence.<SEP>Divisiveness leads to death through conflicts and violence.", created_at:1779530955, source_id:"chunk-bfec7ed2213b36e2e9d3090ab708cd73"}}, {start: {_id:605}, end: {_id:3255}, properties:{file_path:"YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)", truncate:"", keywords:"historical context,societal dynamics", weight:1.0, description:"The United States has a history of division between ideals of universality and actual divisiveness.` - Seems correct.", created_at:1779530952, source_id:"chunk-08c5fbdcd35ed15300b9915ca1fced8a"}}, {start: {_id:605}, end: {_id:3271}, properties:{file_path:"YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)<SEP>unknown_source", truncate:"", keywords:"cause and effect,consequence,destruction,societal impact", weight:2.0, description:"Division leads to violence and death as consequences.` - Seems correct.<SEP>Violence leads to the consequence of division and destruction.", created_at:1779675542, source_id:"chunk-08c5fbdcd35ed15300b9915ca1fced8a<SEP>chunk-97a582a6bc26174c8bc3002eb473cbb9"}}, {start: {_id:25}, end: {_id:707}, properties:{file_path:"YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)", truncate:"", keywords:"requirement,societal change", weight:1.0, description:"Transformation requires confronting the truth in its entirety.` - Seems correct.", created_at:1779530954, source_id:"chunk-08c5fbdcd35ed15300b9915ca1fced8a"}}, {start: {_id:2162}, end: {_id:904}, properties:{file_path:"YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)", truncate:"", keywords:"cause and effect,human interaction", weight:1.0, description:"Labels cause separation between individuals.` - Seems correct.", created_at:1779530954, source_id:"chunk-08c5fbdcd35ed15300b9915ca1fced8a"}}, {start: {_id:605}, end: {_id:577