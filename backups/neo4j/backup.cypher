UNWIND [{start: {_id:266}, end: {_id:413}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"emotional well-being,interpersonal dynamics", weight:1.0, description:"Platform aims to improve trust-related communication challenges.", created_at:1779414172, source_id:"chunk-455b122fda4addf20dfaf68404d297db"}}, {start: {_id:266}, end: {_id:4871}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"anxiety management,mindfulness", weight:1.0, description:"Platform helps mitigate worry through meditation practices.", created_at:1779414172, source_id:"chunk-455b122fda4addf20dfaf68404d297db"}}, {start: {_id:266}, end: {_id:14}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"meditation,philosophy,practices", weight:1.0, description:"Breathing Room incorporates well-tested meditation practices from the O&O Academy into its platform.", created_at:1779414196, source_id:"chunk-09d79ee40c176e3ec0ecf0d2471f0b89"}}, {start: {_id:4873}, end: {_id:266}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", keywords:"meditation,practices", truncate:"", weight:1.0, description:"Breathing Room uses ancient meditation practices adapted to help users achieve calmness and joy.", created_at:1779414196, source_id:"chunk-09d79ee40c176e3ec0ecf0d2471f0b89"}}, {start: {_id:4875}, end: {_id:348}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"content focus,error correction", weight:1.0, description:"The video's content centers on identifying and fixing transcription errors in text.", created_at:1779414215, source_id:"chunk-0aa7c64571d312e22700180e7e895ad6"}}, {start: {_id:2097}, end: {_id:4875}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"error category,linguistic challenge", weight:1.0, description:"Homophones are a key type of transcription error addressed in the task.", created_at:1779414215, source_id:"chunk-0aa7c64571d312e22700180e7e895ad6"}}, {start: {_id:4877}, end: {_id:348}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"example,linguistic analysis", weight:1.0, description:"Namast? is used as an example to demonstrate transcription error analysis.", created_at:1779414215, source_id:"chunk-0aa7c64571d312e22700180e7e895ad6"}}, {start: {_id:4874}, end: {_id:4875}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"error category,technical accuracy", weight:1.0, description:"Domain terms require special attention for correct transcription.", created_at:1779414215, source_id:"chunk-0aa7c64571d312e22700180e7e895ad6"}}, {start: {_id:4876}, end: {_id:348}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"contextual analysis,example", weight:1.0, description:"Namast? Modern life is analyzed for spacing and punctuation accuracy in the video.", created_at:1779414215, source_id:"chunk-0aa7c64571d312e22700180e7e895ad6"}}, {start: {_id:1760}, end: {_id:4875}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", keywords:"formatting,readability", truncate:"", weight:1.0, description:"Punctuation and capitalization errors affect text clarity and are targeted for correction.", created_at:1779414215, source_id:"chunk-0aa7c64571d312e22700180e7e895ad6"}}, {start: {_id:4880}, end: {_id:499}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"anxiety,causes", weight:1.0, description:"Stress leads to anxiety symptoms like butterflies in the stomach.", created_at:1779414245, source_id:"chunk-4bed43ee7fc71a8a85a60323529265cc"}}, {start: {_id:4879}, end: {_id:4857}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", keywords:"contrast,unmet needs", truncate:"", weight:1.0, description:"Modern life's comforts and connectivity do not ensure waking up with a smile or living a fulfilling day, highlighting a disconnect between material abundance and emotional well-being.", created_at:1779414245, source_id:"chunk-4bed43ee7fc71a8a85a60323529265cc"}}, {start: {_id:4881}, end: {_id:499}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"causes,physiological impact", weight:1.0, description:"Stress causes habitual shallow breathing and inability to breathe fully.", created_at:1779414245, source_id:"chunk-4bed43ee7fc71a8a85a60323529265cc"}}, {start: {_id:4882}, end: {_id:348}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"discussion topic,thematic focus", weight:1.0, description:"The video critiques modern life's failure to provide fulfillment despite its advancements, using the phrase \"Namast? Modern Life\" as a central metaphor.", created_at:1779414275, source_id:"chunk-61b4ea6aaf1b9ba778cf54922eb9b8fa"}}, {start: {_id:4872}, end: {_id:4882}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"characteristic analysis,paradox", weight:1.0, description:"Modern life's global connectivity coexists with emotional disconnection and stress, as highlighted in the video's narrative.", created_at:1779414275, source_id:"chunk-61b4ea6aaf1b9ba778cf54922eb9b8fa"}}, {start: {_id:4880}, end: {_id:4857}, properties:{file_path:"YouTube Video: r_l2RNcSPPA (URL: https://www.youtube.com/watch?v=r_l2RNcSPPA)", truncate:"", keywords:"emotional response,symbolism", weight:1.0, description:"The phrase \"butterflies in our stomach\" symbolizes anxiety triggered by life changes in the modern era.", created_at:1779414275, source_id:"chunk-61b4ea6aaf1b9ba778cf54922eb9b8fa"}}, {start: {_id:2144}, end: {_id:4883}, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)", truncate:"", keywords:"no matches,rule application", weight:1.0, description:"Rule 1 was applied to the original text", created_at:1779415210, source_id:"chunk-d41c554dd0c716bd78a2547adde2a335"}}, {start: {_id:4821}, end: {_id:4884}, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)", truncate:"", keywords:"content focus,media hosting", weight:1.0, description:"The YouTube video hosts and discusses the punctuation and capitalization analysis as its primary content.", created_at:1779415230, source_id:"chunk-c7379196e71801ae32380230fbd6d871"}}, {start: {_id:1385}, end: {_id:4884}, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)", truncate:"", keywords:"content inclusion,rhetorical inquiry", weight:1.0, description:"The video includes three questions addressing disconnection and priorities as part of its analytical content.", created_at:1779415230, source_id:"chunk-c7379196e71801ae32380230fbd6d871"}}, {start: {_id:4821}, end: {_id:1952}, properties:{file_path:"YouTube Video: I6yC-aUQUvw (URL: https://www.youtube.com/watch?v=I6yC-aUQUvw)", truncate:"", keywords:"conceptual relationship,readability factors", weight:1.0, description:"The analysis evaluates how punctuation and capitalization directly impact readability in written text.", created_at:1779415230, source_id:"chunk-c7379196e71801ae32380230fbd6d871"}}] AS row
