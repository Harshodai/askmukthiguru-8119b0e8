UNWIND [{start: {_id:4606}, end: {_id:254}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", truncate:"", keywords:"shared goals,success foundation", weight:1.0, description:"The organization's success is built from a unified collective brain and connected cognitive state.", created_at:1779400900, source_id:"chunk-6ae1a5128f5bd3988c5b8902bc010873"}}, {start: {_id:4606}, end: {_id:4605}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", truncate:"", keywords:"catalyst,inspiration trigger", weight:1.0, description:"The strange event initiates the connection of individual brains into a collective and connected state.", created_at:1779400900, source_id:"chunk-6ae1a5128f5bd3988c5b8902bc010873"}}, {start: {_id:4604}, end: {_id:254}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", truncate:"", keywords:"metaphor,organizational state", weight:1.0, description:"The metaphor illustrates the organization's current disunity and lack of collective direction.", created_at:1779400900, source_id:"chunk-6ae1a5128f5bd3988c5b8902bc010873"}}, {start: {_id:4606}, end: {_id:4607}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", truncate:"", keywords:"synergistic concepts,unified intelligence", weight:1.0, description:"Collective and connected brains represent complementary aspects of shared inspiration and goals.", created_at:1779400900, source_id:"chunk-6ae1a5128f5bd3988c5b8902bc010873"}}, {start: {_id:4606}, end: {_id:4604}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", keywords:"contrast,opposition", truncate:"", weight:1.0, description:"The metaphor contrasts with the collective brain concept, highlighting the need for unity.", created_at:1779400901, source_id:"chunk-6ae1a5128f5bd3988c5b8902bc010873"}}, {start: {_id:4606}, end: {_id:501}, properties:{file_path:"YouTube Video: l6svaRx35TI (URL: https://www.youtube.com/watch?v=l6svaRx35TI)", keywords:"achievement,foundation", truncate:"", weight:1.0, description:"Building a collective brain is foundational to achieving organizational success.", created_at:1779400901, source_id:"chunk-6ae1a5128f5bd3988c5b8902bc010873"}}, {start: {_id:82}, end: {_id:4274}, properties:{file_path:"unknown_source<SEP>YouTube Video: idoWVpnJz-Y (URL: https://www.youtube.com/watch?v=idoWVpnJz-Y)", keywords:"celebration,commemoration,event,honor,role", truncate:"", weight:17.0, created_at:1779401986, description:"Father's Day is dedicated to celebrating and honoring fathers and father figures.<SEP>Father's Day is dedicated to honoring fathers and father figures, celebrating their contributions and the role they play in one's life.<SEP>Father's Day is a celebration of fathers and their role.", source_id:"chunk-a0d6a357e4a9a2e2dd0c278e4793f48a<SEP>chunk-ed9bd777897b8b08ed12f0776796982a<SEP>chunk-c1b8715ddbbe0589011d5273af6804ce"}}, {start: {_id:1707}, end: {_id:82}, properties:{file_path:"unknown_source<SEP>YouTube Video: idoWVpnJz-Y (URL: https://www.youtube.com/watch?v=idoWVpnJz-Y)", keywords:"cultural recognition,recognition,roles", truncate:"", weight:2.0, description:"The Ancients in India identified and defined five key roles and attributes associated with fatherhood.<SEP>The ancients in India identified and defined the five key roles of a father, shaping the understanding of fatherhood.", created_at:1779401958, source_id:"chunk-a0d6a357e4a9a2e2dd0c278e4793f48a<SEP>chunk-ed9bd777897b8b08ed12f0776796982a"}}, {start: {_id:82}, end: {_id:4285}, properties:{file_path:"unknown_source", keywords:"conceptual framework,embodiment", truncate:"", weight:1.0, description:"Fatherhood represents the embodiment of paternal qualities and responsibilities beyond biological ties, as described in the text.", created_at:1779401919, source_id:"chunk-a0d6a357e4a9a2e2dd0c278e4793f48a"}}, {start: {_id:1707}, end: {_id:4608}, properties:{file_path:"unknown_source", keywords:"codification,recognition", truncate:"", weight:1.0, description:"The Ancients in India identified and codified the five essential roles of a father in their traditions.", created_at:1779401919, source_id:"chunk-a0d6a357e4a9a2e2dd0c278e4793f48a"}}, {start: {_id:82}, end: {_id:4608}, properties:{file_path:"unknown_source", keywords:"attributes,definitional framework", truncate:"", weight:1.0, description:"The five roles serve as a definitional framework for understanding the multifaceted attributes of fatherhood.", created_at:1779401919, source_id:"chunk-a0d6a357e4a9a2e2dd0c278e4793f48a"}}, {start: {_id:4306}, end: {_id:4274}, properties:{file_path:"YouTube Video: idoWVpnJz-Y (URL: https://www.youtube.com/watch?v=idoWVpnJz-Y)", keywords:"celebration,recognition", truncate:"", weight:1.0, description:"Father's Day includes honoring biological fathers as part of the celebration.", created_at:1779401958, source_id:"chunk-ed9bd777897b8b08ed12f0776796982a"}}, {start: {_id:82}, end: {_id:348}, properties:{file_path:"YouTube Video: idoWVpnJz-Y (URL: https://www.youtube.com/watch?v=idoWVpnJz-Y)", truncate:"", keywords:"content source,role discussion", weight:1.0, description:"The YouTube Video discusses the role of fathers and their impact on others.", created_at:1779401986, source_id:"chunk-c1b8715ddbbe0589011d5273af6804ce"}}, {start: {_id:3032}, end: {_id:1932}, properties:{file_path:"unknown_source<SEP>YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"ecological purpose,existence,existential significance,metaphorical symbolism,natural phenomena,necessity,ontological question,philosophical inquiry,philosophical metaphor,purpose", weight:5.0, description:"The tree?s existence serves the earth and life forms, illustrating the functional role of natural objects in existence.<SEP>The tree serves as a physical manifestation of the abstract concept of existence in the text's existential discussion.<SEP>The tree's existence serves millions of life forms, demonstrating its functional role in the ecosystem despite lacking inherent meaning.<SEP>The tree is used to interrogate the meaning (or lack thereof) of existence.<SEP>The tree's existence is interrogated as an example of pure existence without predetermined meaning.", created_at:1779402773, source_id:"chunk-075b8e71a3c71d11c785be4bbfe965ed<SEP>chunk-b85547a9c5ce2c1aff2a86073a2bcb87<SEP>chunk-cd11c060af63780157ebf40717dc0fe2<SEP>chunk-8ac203494cdcc9d8041ac912b2411f28<SEP>chunk-e94d81180e7457d6f36d99965cfbf34d"}}, {start: {_id:1406}, end: {_id:4612}, properties:{file_path:"unknown_source", truncate:"", keywords:"existential inquiry,psychological state", weight:1.0, description:"Depression is intertwined with the existential quest for meaning, reflecting a deeper search for purpose.", created_at:1779402344, source_id:"chunk-075b8e71a3c71d11c785be4bbfe965ed"}}, {start: {_id:1474}, end: {_id:3616}, properties:{file_path:"unknown_source", truncate:"", keywords:"existential resolution,spiritual progression", weight:1.0, description:"The journey culminates in awakening, transcending depression and superficiality.", created_at:1779402345, source_id:"chunk-075b8e71a3c71d11c785be4bbfe965ed"}}, {start: {_id:4612}, end: {_id:4609}, properties:{file_path:"unknown_source", truncate:"", keywords:"intrinsic purpose,philosophical inquiry", weight:1.0, description:"The quest seeks to resolve the paradox of existence?s inherent meaninglessness versus its functional purpose.", created_at:1779402345, source_id:"chunk-075b8e71a3c71d11c785be4bbfe965ed"}}, {start: {_id:4615}, end: {_id:4283}, properties:{file_path:"unknown_source<SEP>YouTube Video: vjEsXpEtpH4 (URL: https://www.youtube.com/watch?v=vjEsXpEtpH4)", truncate:"", keywords:"emotional impact,joy,relational significance", weight:2.0, description:"A smile is framed as a meaningful act within human connections, contrasting with superficiality.<SEP>The smile brings joy to others, illustrating its purpose in fostering positive human connections.", created_at:1779402546, source_id:"chunk-075b8e71a3c71d11c785be4bbfe965ed<SEP>chunk-cd11c060af63780157ebf40717dc0fe2"}}, {start: {_id:4610}, end: {_id:1071}, properties:{file_path:"unknown_source", keywords:"ecological impact,nourishment", truncate:"", weight:1.0, description:"Raindrops nourish the earth, symbolizing the interconnectedness of existence and purpose.", created_at:1779402345, source_id:"chunk-075b8e71a3c71d11c785be4bbfe965ed"}}, {start: {_id:4613}, end: {_id:449}, properties:{file_path:"unknown_source", truncate:"", keywords:"emotional impact,existential critique", weight:1.0, description:"Discontent permeates relationships, reflecting the superficiality of mind-created constructs.", created_at:1779402345, source_id:"chunk-075b8e71a3c71d11c785be4bbfe965ed"}}] AS row
