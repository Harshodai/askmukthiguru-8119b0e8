UNWIND [{start: {_id:605}, end: {_id:5783}, properties:{file_path:"YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)", truncate:"", keywords:"manifestation,societal consequence", weight:1.0, description:"Violence on streets results from societal division.` - Seems correct.", created_at:1779530956, source_id:"chunk-08c5fbdcd35ed15300b9915ca1fced8a"}}, {start: {_id:5784}, end: {_id:605}, properties:{file_path:"YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)", truncate:"", keywords:"manifestation,societal consequence", weight:1.0, description:"Conflicts within families result from societal division.` - Seems correct.", created_at:1779530956, source_id:"chunk-08c5fbdcd35ed15300b9915ca1fced8a"}}, {start: {_id:3255}, end: {_id:348}, properties:{file_path:"YouTube Video: oSqD_BvF7vA (URL: https://www.youtube.com/watch?v=oSqD_BvF7vA)", keywords:"source,subject matter", truncate:"", weight:1.0, description:"The YouTube Video discusses division in the United States.` - Seems correct.", created_at:1779530958, source_id:"chunk-08c5fbdcd35ed15300b9915ca1fced8a"}}, {start: {_id:3833}, end: {_id:3649}, properties:{file_path:"unknown_source", keywords:"consumption,survival", truncate:"", weight:1.0, description:"All creatures in the universe consume food as a fundamental act of survival and existence.", created_at:1779531041, source_id:"chunk-e5bc7202d0a09227aeb490c17e163a8e"}}, {start: {_id:5787}, end: {_id:5786}, properties:{file_path:"unknown_source<SEP>YouTube Video: TQ0TGyaByhs (URL: https://www.youtube.com/watch?v=TQ0TGyaByhs)", keywords:"consumption,cosmic consumption,future event,inevitability", truncate:"", weight:2.0, description:"The black hole is destined to consume the Milky Way galaxy in the distant future.<SEP>The black hole is expected to consume the Milky Way in the distant future.", created_at:1779531118, source_id:"chunk-e5bc7202d0a09227aeb490c17e163a8e<SEP>chunk-ce2308cda5fca23d965042def4191e27"}}, {start: {_id:5791}, end: {_id:5789}, properties:{file_path:"unknown_source", keywords:"sacred consumption,transformation", truncate:"", weight:1.0, description:"Yagna's fire consumes offerings and transmutes them into energy and life force.", created_at:1779531041, source_id:"chunk-e5bc7202d0a09227aeb490c17e163a8e"}}, {start: {_id:5785}, end: {_id:5797}, properties:{file_path:"unknown_source", keywords:"cosmic consumption,predation", truncate:"", weight:1.0, description:"Giant stars consume smaller stars, demonstrating celestial predation dynamics.", created_at:1779531042, source_id:"chunk-e5bc7202d0a09227aeb490c17e163a8e"}}, {start: {_id:1479}, end: {_id:5789}, properties:{file_path:"unknown_source", keywords:"metaphor,philosophical comparison", truncate:"", weight:1.0, description:"The ancients metaphorically compared the universe to a Yagna, a fire sacrifice.", created_at:1779531042, source_id:"chunk-e5bc7202d0a09227aeb490c17e163a8e"}}, {start: {_id:5800}, end: {_id:1176}, properties:{file_path:"unknown_source", keywords:"empathy,mutual respect", truncate:"", weight:1.0, description:"Caring for others fosters well-being and strengthens connections.", created_at:1779531249, source_id:"chunk-c3b39a7ccf4908b1d880b7e4b31351a8"}}, {start: {_id:5801}, end: {_id:5805}, properties:{file_path:"unknown_source", keywords:"foundation,interconnectedness", truncate:"", weight:1.0, description:"A beautiful ecosystem enables the creation of beautiful families, friendships, and nations through mutual respect.", created_at:1779531249, source_id:"chunk-c3b39a7ccf4908b1d880b7e4b31351a8"}}, {start: {_id:5804}, end: {_id:5799}, properties:{file_path:"unknown_source", truncate:"", keywords:"lack of fulfillment,self-centeredness", weight:1.0, description:"An obsessive state prevents individuals from finding love, joy, or prosperity due to its self-focused nature.", created_at:1779531249, source_id:"chunk-c3b39a7ccf4908b1d880b7e4b31351a8"}}, {start: {_id:5801}, end: {_id:5800}, properties:{file_path:"unknown_source", keywords:"collective growth,respect", truncate:"", weight:1.0, description:"Caring for others contributes to a beautiful ecosystem by prioritizing collective well-being over self-interest.", created_at:1779531249, source_id:"chunk-c3b39a7ccf4908b1d880b7e4b31351a8"}}, {start: {_id:5801}, end: {_id:5806}, properties:{file_path:"YouTube Video: x1Neqc9ytqE (URL: https://www.youtube.com/watch?v=x1Neqc9ytqE)", truncate:"", keywords:"mutual respect,social harmony", weight:1.0, description:"The ecosystem metaphor explains how harmonious social structures are built through collective respect and connection.", created_at:1779531263, source_id:"chunk-f3307407c5f7e2531c4c02a27d0e2d09"}}, {start: {_id:5804}, end: {_id:348}, properties:{file_path:"YouTube Video: x1Neqc9ytqE (URL: https://www.youtube.com/watch?v=x1Neqc9ytqE)", truncate:"", keywords:"interconnectedness,life philosophy", weight:1.0, description:"The video discusses how love, joy, and prosperity emerge from mutual care and connection rather than self-obsession.", created_at:1779531263, source_id:"chunk-f3307407c5f7e2531c4c02a27d0e2d09"}}, {start: {_id:5801}, end: {_id:5804}, properties:{file_path:"YouTube Video: x1Neqc9ytqE (URL: https://www.youtube.com/watch?v=x1Neqc9ytqE)", keywords:"foundation,manifestation", truncate:"", weight:1.0, description:"The ecosystem serves as the foundation for the manifestation of love, joy, and prosperity in life.", created_at:1779531263, source_id:"chunk-f3307407c5f7e2531c4c02a27d0e2d09"}}, {start: {_id:5813}, end: {_id:1071}, properties:{file_path:"unknown_source", keywords:"deforestation,environmental impact", truncate:"", weight:1.0, description:"The deforestation of 50% of the rainforests is an environmental impact on the Earth.", created_at:1779531587, source_id:"chunk-aa80ceeb1e8b2dd7460f820d674a1d04"}}, {start: {_id:123}, end: {_id:5807}, properties:{file_path:"unknown_source", keywords:"animal killing,consumption", truncate:"", weight:1.0, description:"Humanity kills 72 billion land animals annually, reflecting consumption patterns.", created_at:1779531587, source_id:"chunk-aa80ceeb1e8b2dd7460f820d674a1d04"}}, {start: {_id:5808}, end: {_id:1071}, properties:{file_path:"unknown_source", keywords:"deforestation,environmental impact", truncate:"", weight:1.0, description:"The deforestation of 50% of the rainforests is an environmental impact on the Earth.", created_at:1779531588, source_id:"chunk-aa80ceeb1e8b2dd7460f820d674a1d04"}}, {start: {_id:5811}, end: {_id:123}, properties:{file_path:"unknown_source", keywords:"animal killing,consumption", truncate:"", weight:1.0, description:"Humanity kills 1.2 trillion aquatic animals annually, showing consumption impact.", created_at:1779531588, source_id:"chunk-aa80ceeb1e8b2dd7460f820d674a1d04"}}, {start: {_id:5812}, end: {_id:5810}, properties:{file_path:"unknown_source", keywords:"ethical violation,harm", truncate:"", weight:1.0, description:"Adharma represents unethical actions that contribute to vertebrate extinction.", created_at:1779531588, source_id:"chunk-aa80ceeb1e8b2dd7460f820d674a1d04"}}] AS row
