UNWIND [{start: {_id:1500}, end: {_id:775}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", keywords:"context,correction,list", truncate:"", weight:2.0, description:"The term \"manenath trananath\" is being corrected based on the context of the list of terms.<SEP>The term \"manenath trananath\" is part of a list of terms including \"Limitless Field\".", created_at:1779212742, source_id:"chunk-22ae4a6d383bcd6eb1c726163e13f796"}}, {start: {_id:849}, end: {_id:841}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"combination,esoteric practice,protection", weight:3.0, description:"The combination of dharana and mantra results in protection.<SEP>dharana contributes to protection as part of an esoteric practice<SEP>dharana is part of a combination that provides protection.", created_at:1779212958, source_id:"chunk-9b83c76bc3fe3180b40c2a152ab4f314<SEP>chunk-70481ae3ddabb1adcaf55702b0b1f2a9"}}, {start: {_id:697}, end: {_id:841}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"combination,esoteric practice,protection", weight:2.0, description:"The combination of dharana and mantra results in protection.<SEP>mantra is part of a combination that provides protection.", created_at:1779212958, source_id:"chunk-9b83c76bc3fe3180b40c2a152ab4f314<SEP>chunk-70481ae3ddabb1adcaf55702b0b1f2a9"}}, {start: {_id:775}, end: {_id:841}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"meaning,outcome,terminology", weight:2.0, description:"The term \"manenath trananath\" is intended to signify the concept of protection.<SEP>manenath trananath is defined as \"that which protects,\" directly linking to the concept of protection.", created_at:1779212885, source_id:"chunk-9b83c76bc3fe3180b40c2a152ab4f314<SEP>chunk-e326636f3919b50a883c59b61202f73d"}}, {start: {_id:774}, end: {_id:850}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"conceptual purpose,intended concept,meaning,spiritual function,term representation", weight:3.0, created_at:1779212926, description:"The term manenath trananath is intended to mean protection, though it is not a recognized term.<SEP>Manenath trananath is presented as the term representing the concept of protection.<SEP>\"Manenath trananath\" is interpreted as a protective spiritual force derived from mantra and dharana.", source_id:"chunk-fe04edafc045a28a3551d9aaa81cc514<SEP>chunk-e9d6a455cfecdcbfbf4b9187a0f8773c<SEP>chunk-242c86adb935c1461785f26c0c3f9e28"}}, {start: {_id:774}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"analysis,content,discussion,linguistic critique", weight:2.0, description:"The YouTube Video contains a discussion about the incorrect term manenath trananath and its intended meaning.<SEP>The video critiques the term \"manenath trananath\" as a mangled but contextually inferred concept.", created_at:1779212926, source_id:"chunk-fe04edafc045a28a3551d9aaa81cc514<SEP>chunk-242c86adb935c1461785f26c0c3f9e28"}}, {start: {_id:850}, end: {_id:2275}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"contextual result,intended meaning", weight:1.0, description:"The text's intended meaning is that the combination of mantra and dharana results in protection, despite the incorrect use of the term \"manenath trananath.\"", created_at:1779212851, source_id:"chunk-e9d6a455cfecdcbfbf4b9187a0f8773c"}}, {start: {_id:774}, end: {_id:2275}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"error,terminology", weight:1.0, description:"The text is noted to contain an error in using the term \"manenath trananath,\" which is described as incorrect but contextually inferred to mean \"that which protects.\"", created_at:1779212851, source_id:"chunk-e9d6a455cfecdcbfbf4b9187a0f8773c"}}, {start: {_id:849}, end: {_id:697}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"combination,esoteric science,protection,spiritual practice", weight:2.0, description:"dharana and mantra are combined in the context of spiritual practice, leading to the formation of manenath trananath.<SEP>The combination of dharana and mantra is stated to protect, indicating their role in an esoteric practice.", created_at:1779212957, source_id:"chunk-e326636f3919b50a883c59b61202f73d<SEP>chunk-70481ae3ddabb1adcaf55702b0b1f2a9"}}, {start: {_id:775}, end: {_id:697}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", keywords:"result,transformation", truncate:"", weight:1.0, description:"the combination of dharana and mantra transforms mantra into manenath trananath, which embodies protection.", created_at:1779212885, source_id:"chunk-e326636f3919b50a883c59b61202f73d"}}, {start: {_id:849}, end: {_id:775}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", keywords:"result,transformation", truncate:"", weight:1.0, description:"the combination of dharana and mantra transforms into manenath trananath, which embodies protection.", created_at:1779212885, source_id:"chunk-e326636f3919b50a883c59b61202f73d"}}, {start: {_id:748}, end: {_id:774}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"conceptual origin,protection", weight:1.0, description:"Dharana contributes to the formation of \"manenath trananath,\" a protective concept.", created_at:1779212926, source_id:"chunk-242c86adb935c1461785f26c0c3f9e28"}}, {start: {_id:748}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"discussion topic,esoteric concepts", weight:1.0, description:"The video discusses dharana as part of its content on spiritual practices.", created_at:1779212927, source_id:"chunk-242c86adb935c1461785f26c0c3f9e28"}}, {start: {_id:927}, end: {_id:697}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"esoteric significance,vast science", weight:2.0, description:"Mantra is described as part of a vast esoteric science with significant power.<SEP>Mantra is part of a vast esoteric science.", created_at:1779212958, source_id:"chunk-70481ae3ddabb1adcaf55702b0b1f2a9"}}, {start: {_id:967}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"content contains,content focus,linguistic pattern,repeated emphasis,repetition,text repetition,topic,video content", weight:5.0, created_at:1779213154, description:"The YouTube video repeatedly mentions the term \"buoyancy\" as its primary content focus.<SEP>The video repeatedly mentions buoyancy, indicating it as a central thematic focus.<SEP>The YouTube Video contains repeated mentions of buoyancy, indicating it as a central topic.<SEP>YouTube Video repeatedly highlights the concept of buoyancy as its central theme.<SEP>The video contains the word \"buoyancy\" repeated extensively, creating a notable textual pattern.", source_id:"chunk-8c448954f44e55adfb78a88bf94086a4<SEP>chunk-bf3f97cb451463455d671e0a082344f3<SEP>chunk-1c8d4bc914611703bebe2542ed5cda16<SEP>chunk-e7917c269a8f8474e277f4da3ddd7c86<SEP>chunk-0035351daa774a335861e47cf4f9373b"}}, {start: {_id:348}, end: {_id:980}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", truncate:"", keywords:"features,mentions", weight:1.0, description:"The video repeatedly features the term \"uoyancy\" as a central focus of its content.", created_at:1779213026, source_id:"chunk-560f0ad50210b9deafa343b7a961d969"}}, {start: {_id:348}, end: {_id:966}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=hh61tFdyX8c)", keywords:"content focus,repetition", truncate:"", weight:1.0, description:"The YouTube video repeatedly emphasizes the concept of buoyancy through textual content.", created_at:1779213041, source_id:"chunk-1ee21367fd4b548afa67a98953c2520f"}}, {start: {_id:1043}, end: {_id:1021}, properties:{file_path:"unknown_source", keywords:"correction attempt,proposed fix", truncate:"", weight:10.0, description:"The first entity is attempting to fix the error represented by the second entity.", created_at:1779213761, source_id:"chunk-b0299a0d78edfc930128232df6ad17a7"}}, {start: {_id:1012}, end: {_id:1240}, properties:{file_path:"unknown_source", keywords:"historical leadership,transformation", truncate:"", weight:1.0, description:"Both figures are cited as examples of leaders who underwent significant personal or philosophical transformations.", created_at:1779213761, source_id:"chunk-84231a38981e55784ff03ce5211e679e"}}, {start: {_id:1014}, end: {_id:1067}, properties:{file_path:"unknown_source", keywords:"economic impact,financial policy", truncate:"", weight:1.0, description:"The Federal Reserve's policies are implied to influence investor confidence and market dynamics.", created_at:1779213762, source_id:"chunk-84231a38981e55784ff03ce5211e679e"}}] AS row
