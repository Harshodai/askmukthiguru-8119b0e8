UNWIND [{start: {_id:6568}, end: {_id:6557}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"excess characteristics,population growth", weight:1.0, description:"The civilization of excess is characterized by an excess population.", created_at:1779562484, source_id:"chunk-458ec7ed8021b6846b23a3c0fa7e9821"}}, {start: {_id:2415}, end: {_id:6558}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"cause,disease classification", weight:1.0, description:"Diabetes is one of the modern diseases caused by lifestyle excesses.", created_at:1779562484, source_id:"chunk-458ec7ed8021b6846b23a3c0fa7e9821"}}, {start: {_id:6575}, end: {_id:6576}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"health impact,lifestyle factors", weight:1.0, description:"Excess is linked to lifestyle factors that impact health.", created_at:1779562484, source_id:"chunk-458ec7ed8021b6846b23a3c0fa7e9821"}}, {start: {_id:6567}, end: {_id:6558}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"cause,disease classification", weight:1.0, description:"High blood pressure is a modern disease linked to excess.", created_at:1779562485, source_id:"chunk-458ec7ed8021b6846b23a3c0fa7e9821"}}, {start: {_id:6576}, end: {_id:6574}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"child development,cognitive effects", weight:1.0, description:"Excessive activities contribute to impoverished brains in children.", created_at:1779562485, source_id:"chunk-458ec7ed8021b6846b23a3c0fa7e9821"}}, {start: {_id:6566}, end: {_id:6557}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"growth rate,population statistics", weight:1.0, description:"The excess population has grown from 1 billion to 8 billion in 230 years.", created_at:1779562485, source_id:"chunk-458ec7ed8021b6846b23a3c0fa7e9821"}}, {start: {_id:6558}, end: {_id:6310}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"cause,disease classification", weight:1.0, description:"Stroke is a modern disease resulting from excess.", created_at:1779562485, source_id:"chunk-458ec7ed8021b6846b23a3c0fa7e9821"}}, {start: {_id:2417}, end: {_id:6558}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"cause,disease classification", weight:1.0, description:"Heart disease is a modern disease caused by excess.", created_at:1779562485, source_id:"chunk-458ec7ed8021b6846b23a3c0fa7e9821"}}, {start: {_id:1654}, end: {_id:6559}, properties:{file_path:"unknown_source", keywords:"conceptual synergy", truncate:"", weight:1.0, description:"Both terms represent breath as a sacred life force connecting all existence across cultures.", created_at:1779562504, source_id:"chunk-3f9b4215b066d2d74445f8aa497138dc"}}, {start: {_id:6556}, end: {_id:6558}, properties:{file_path:"unknown_source", keywords:"causation,lifestyle impact", truncate:"", weight:1.0, description:"Excessive consumption and sedentary lifestyles directly cause chronic diseases like diabetes and obesity.", created_at:1779562504, source_id:"chunk-3f9b4215b066d2d74445f8aa497138dc"}}, {start: {_id:6544}, end: {_id:542}, properties:{file_path:"unknown_source", keywords:"decision-making,judgment", truncate:"", weight:1.0, description:"Chitragupta judges the Man's life and offers him a choice between hell and heaven.", created_at:1779562504, source_id:"chunk-6ceb252506f04dd8db2d80559d756bc3"}}, {start: {_id:6564}, end: {_id:6563}, properties:{file_path:"unknown_source", keywords:"analogical explanation", truncate:"", weight:1.0, description:"The six-body concept is metaphorically explained through the nested structure of Matryoshka dolls.", created_at:1779562505, source_id:"chunk-3f9b4215b066d2d74445f8aa497138dc"}}, {start: {_id:5762}, end: {_id:6561}, properties:{file_path:"unknown_source", keywords:"energy regulation", truncate:"", weight:1.0, description:"Ida Nadi governs lunar energy in the energy body, balancing creativity and relaxation.", created_at:1779562505, source_id:"chunk-3f9b4215b066d2d74445f8aa497138dc"}}, {start: {_id:6547}, end: {_id:542}, properties:{file_path:"unknown_source", keywords:"experience,frustration", truncate:"", weight:1.0, description:"The Man experiences hell, where individuals struggle to satisfy their needs despite abundant resources.", created_at:1779562505, source_id:"chunk-6ceb252506f04dd8db2d80559d756bc3"}}, {start: {_id:5762}, end: {_id:6562}, properties:{file_path:"unknown_source", keywords:"energy regulation", truncate:"", weight:1.0, description:"Pingala Nadi channels solar energy, enhancing logic and alertness in the brain.", created_at:1779562505, source_id:"chunk-3f9b4215b066d2d74445f8aa497138dc"}}, {start: {_id:6543}, end: {_id:542}, properties:{file_path:"unknown_source", keywords:"experience,fulfillment", truncate:"", weight:1.0, description:"The Man experiences heaven, where individuals cooperate and find happiness in shared abundance.", created_at:1779562505, source_id:"chunk-6ceb252506f04dd8db2d80559d756bc3"}}, {start: {_id:5762}, end: {_id:6549}, properties:{file_path:"unknown_source", truncate:"", keywords:"energy balancing", weight:1.0, description:"Practicing", created_at:1779562505, source_id:"chunk-3f9b4215b066d2d74445f8aa497138dc"}}, {start: {_id:6543}, end: {_id:6547}, properties:{file_path:"unknown_source<SEP>YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"contrast,existential choice,moral duality,symbolism", truncate:"", weight:2.0, description:"The story contrasts hell and heaven to illustrate the difference between external pursuits and inner peace.<SEP>The story illustrates the paradox of human choice between suffering and enlightenment.", created_at:1779564202, source_id:"chunk-6ceb252506f04dd8db2d80559d756bc3<SEP>chunk-ab3c93f98db9784d720f1684c8d13dfb"}}, {start: {_id:6583}, end: {_id:6581}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", truncate:"", keywords:"historical continuity,shared molecules", weight:1.0, description:"Molecules are described as flowing through all living beings, shared across dinosaurs.", created_at:1779563149, source_id:"chunk-7234398961838f3894f5b3cb8bdb630b"}}, {start: {_id:1615}, end: {_id:1654}, properties:{file_path:"YouTube Video: Lst4MvxPCx4 (URL: https://www.youtube.com/watch?v=Lst4MvxPCx4)", keywords:"Sanskrit,ancient term", truncate:"", weight:1.0, description:"Prana is the Sanskrit term for breath, representing life force.", created_at:1779563149, source_id:"chunk-7234398961838f3894f5b3cb8bdb630b"}}] AS row
