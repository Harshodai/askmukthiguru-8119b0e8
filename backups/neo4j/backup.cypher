UNWIND [{start: {_id:1335}, end: {_id:4269}, properties:{file_path:"unknown_source", keywords:"self-realization,teachings", truncate:"", weight:1.0, description:"Buddha's teachings explain the concept of being Buddha, which involves self-realization and realizing the illusion of self.", created_at:1779260739, source_id:"chunk-955183a7876a0d1c45e94af3baafdb73"}}, {start: {_id:1335}, end: {_id:4268}, properties:{file_path:"unknown_source", keywords:"self-realization,teachings", truncate:"", weight:1.0, description:"Buddha's teachings explain the concept of being Buddha, which involves self-realization and realizing the illusion of self.", created_at:1779260739, source_id:"chunk-955183a7876a0d1c45e94af3baafdb73"}}, {start: {_id:4274}, end: {_id:4276}, properties:{file_path:"unknown_source", keywords:"fatherhood,spiritual significance", truncate:"", weight:1.0, description:"The Hindu chant provides spiritual significance and explains the roles of five figures as fathers.", created_at:1779261161, source_id:"chunk-b996638425e80c3edd726b4647655b80"}}, {start: {_id:2207}, end: {_id:4281}, properties:{file_path:"unknown_source", keywords:"reflection,self-perception", truncate:"", weight:1.0, description:"The mirror reflects the human being's perception of their father.", created_at:1779261161, source_id:"chunk-db4a0e7f56cb73058e9f9de5ef38915f"}}, {start: {_id:4271}, end: {_id:4275}, properties:{file_path:"unknown_source", keywords:"explanation,meaning", truncate:"", weight:1.0, description:"The five fathers are explained in the Hindu chant.", created_at:1779261161, source_id:"chunk-db4a0e7f56cb73058e9f9de5ef38915f"}}, {start: {_id:4282}, end: {_id:2207}, properties:{file_path:"unknown_source", keywords:"perception,reflection", truncate:"", weight:1.0, description:"The eyes perceive the father's reflection.", created_at:1779261161, source_id:"chunk-db4a0e7f56cb73058e9f9de5ef38915f"}}, {start: {_id:2207}, end: {_id:4283}, properties:{file_path:"unknown_source", keywords:"expression,reflection", truncate:"", weight:1.0, description:"The smile reflects the father's presence.", created_at:1779261161, source_id:"chunk-db4a0e7f56cb73058e9f9de5ef38915f"}}, {start: {_id:4285}, end: {_id:4275}, properties:{file_path:"unknown_source", truncate:"", keywords:"cultural reference,spiritual guidance", weight:1.0, description:"The Hindu chant culturally references fatherhood by honoring figures fulfilling paternal roles spiritually and materially.", created_at:1779261161, source_id:"chunk-0bdbf1797b9374df3923aee96614874c"}}, {start: {_id:4274}, end: {_id:4287}, properties:{file_path:"unknown_source", keywords:"celebration,inclusivity", truncate:"", weight:1.0, description:"Father's Day should celebrate anyone who stood by as a father, not just biological fathers.", created_at:1779261161, source_id:"chunk-b996638425e80c3edd726b4647655b80"}}, {start: {_id:2207}, end: {_id:4284}, properties:{file_path:"unknown_source", keywords:"reflection,voice", truncate:"", weight:1.0, description:"The voice reflects the father's presence.", created_at:1779261161, source_id:"chunk-db4a0e7f56cb73058e9f9de5ef38915f"}}, {start: {_id:4278}, end: {_id:4286}, properties:{file_path:"unknown_source<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", keywords:"component,karmic process,psychological framework,spiritual growth", truncate:"", weight:2.0, description:"Samskaras are dissolved and nurtured as part of karmic evolution to achieve spiritual growth and fulfillment.<SEP>Samskaras are presented as part of the broader framework of karmic evolution and personal growth.", created_at:1779261603, source_id:"chunk-0bdbf1797b9374df3923aee96614874c<SEP>chunk-accdc31e9607c3940aed49cc5de73ff1"}}, {start: {_id:4285}, end: {_id:4288}, properties:{file_path:"unknown_source", keywords:"life journey,personal growth", truncate:"", weight:1.0, description:"Paternal influence shapes human fulfillment through inherited tendencies and spiritual evolution.", created_at:1779261162, source_id:"chunk-0bdbf1797b9374df3923aee96614874c"}}, {start: {_id:4274}, end: {_id:4289}, properties:{file_path:"unknown_source", keywords:"celebration,tradition", truncate:"", weight:1.0, description:"Father's Day is a recent tradition that helps bring healing and connection.", created_at:1779261162, source_id:"chunk-b996638425e80c3edd726b4647655b80"}}, {start: {_id:4274}, end: {_id:4275}, properties:{file_path:"unknown_source", keywords:"celebration,tradition", truncate:"", weight:1.0, description:"The Hindu chant is part of the Father's Day tradition.", created_at:1779261162, source_id:"chunk-db4a0e7f56cb73058e9f9de5ef38915f"}}, {start: {_id:4274}, end: {_id:2207}, properties:{file_path:"unknown_source", keywords:"celebration,journey", truncate:"", weight:1.0, description:"Father's Day is part of the journey of human beings.", created_at:1779261162, source_id:"chunk-db4a0e7f56cb73058e9f9de5ef38915f"}}, {start: {_id:4274}, end: {_id:4290}, properties:{file_path:"unknown_source", keywords:"connection,healing,tradition", truncate:"", weight:1.0, description:"Father's Day fosters healing and connection between fathers and children through a recent tradition.", created_at:1779261163, source_id:"chunk-0bdbf1797b9374df3923aee96614874c"}}, {start: {_id:4306}, end: {_id:4304}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"familial relationship,presence", weight:1.0, description:"The sentence implies the presence of a biological father in one's expressions.", created_at:1779261550, source_id:"chunk-1d975f0d94f46d7a04c2a2a43677deb7"}}, {start: {_id:4306}, end: {_id:4305}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1w-IStuMl3M)", truncate:"", keywords:"familial relationship,presence", weight:1.0, description:"The sentence implies the presence of a biological father in one's voice.", created_at:1779261550, source_id:"chunk-1d975f0d94f46d7a04c2a