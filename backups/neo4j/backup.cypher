UNWIND [{_id:3829, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"naturalobject", truncate:"", description:"sea represents the broader world beyond the frog's confined perspective, metaphorically symbolizing unacknowledged realities.", created_at:1779241935, source_id:"chunk-6dcca6a19001c05e809233dafe613e17", entity_id:"sea"}}, {_id:3830, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"naturalobject", truncate:"", description:"river embodies another falsified reality in the frog's worldview, highlighting perceptual rigidity.", created_at:1779241935, source_id:"chunk-6dcca6a19001c05e809233dafe613e17", entity_id:"river"}}, {_id:3831, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"naturalobject", truncate:"", description:"The sea is described as a \"lie\" from the frog's perspective, representing its inability to comprehend broader realities.<SEP>The sea represents the vast, unacknowledged truths beyond the frog's limited experience.", created_at:1779242306, source_id:"chunk-9ce1c80b4cf41412d36baabed73cd0a7<SEP>chunk-082ee41f700ea9a8a29b83bfbf36abec", entity_id:"Sea"}}, {_id:3832, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"creature", truncate:"", description:"A frog with a limited worldview perceiving the sea, lake, and river as lies/myths due to its confined existence in a well.<SEP>The frog represents an individual with a limited perspective, confined to its well and dismissive of broader realities.", created_at:1779242306, source_id:"chunk-9ce1c80b4cf41412d36baabed73cd0a7<SEP>chunk-082ee41f700ea9a8a29b83bfbf36abec", entity_id:"Frog"}}, {_id:3833, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)<SEP>unknown_source<SEP>YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"concept", truncate:"", created_at:1779659276, description:"A general reference to creatures that contradict the frog's views, categorized as liars or enemies.<SEP>The word \"creature\" in the text is identified as a Creature entity, though its context suggests it may be an error for \"person\" or \"being\".<SEP>Creature refers to all living beings in the universe that consume food, ranging from single-celled organisms to humans.<SEP>Creature symbolizes living beings in a metaphorical context, highlighting the paradox of humans exploiting other life forms.<SEP>Creature symbolizes the existential paradox of becoming the entity one seeks to destroy, leading to awakened perception and renewal.", source_id:"chunk-9ce1c80b4cf41412d36baabed73cd0a7<SEP>chunk-04d56d56ff3befc2a05ebcfab17f9d42<SEP>chunk-e5bc7202d0a09227aeb490c17e163a8e<SEP>chunk-c70b663ec8c2f1951db8e07e51d5edd1<SEP>chunk-b0aa1897202602a9be2a7516d39d5400", entity_id:"Creature"}}, {_id:3834, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"naturalobject", truncate:"", description:"The lake is labeled a \"myth\" in the frog's worldview, symbolizing its distorted understanding of reality.<SEP>The lake symbolizes additional realities dismissed by the frog's narrow worldview.", created_at:1779242306, source_id:"chunk-30b3ce6bb0954806ce5e0dee5f14e7c3<SEP>chunk-9ce1c80b4cf41412d36baabed73cd0a7<SEP>chunk-082ee41f700ea9a8a29b83bfbf36abec", entity_id:"Lake"}}, {_id:3836, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"concept", truncate:"", description:"A guided exercise involving breath awareness and mutual understanding to overcome rigid views in relationships.", created_at:1779241988, source_id:"chunk-9ce1c80b4cf41412d36baabed73cd0a7", entity_id:"Reflection"}}, {_id:3837, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"concept", truncate:"", description:"A recurring disagreement between partners that reinforces egoistic and stubborn responses.", created_at:1779241989, source_id:"chunk-9ce1c80b4cf41412d36baabed73cd0a7", entity_id:"Conflicting Situation"}}, {_id:3838, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"concept", truncate:"", description:"Egoistic, stubborn, and unwise reactions triggered by rigid adherence to personal opinions during conflicts.", created_at:1779241989, source_id:"chunk-9ce1c80b4cf41412d36baabed73cd0a7", entity_id:"Response"}}, {_id:3839, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"concept", truncate:"", description:"Rigid Ideas refer to inflexible opinions or beliefs that hinder open-mindedness and relationship growth.", created_at:1779241989, source_id:"chunk-9ce1c80b4cf41412d36baabed73cd0a7<SEP>chunk-082ee41f700ea9a8a29b83bfbf36abec", entity_id:"Rigid Ideas"}}, {_id:3840, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"UNKNOWN", truncate:"", description:"Releasing rigid views", created_at:1779241990, source_id:"chunk-9ce1c80b4cf41412d36baabed73cd0a7", entity_id:"Letting Go of Rigid Views"}}, {_id:3841, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"UNKNOWN", truncate:"", description:"Releasing rigid views", created_at:1779241990, source_id:"chunk-9ce1c80b4cf41412d36baabed73cd0a7", entity_id:"Love in Relationship"}}, {_id:3842, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"UNKNOWN", truncate:"", description:"Both \"kupastha\" and \"manduka\" are Sanskrit terms meaning frog, leading to the entity description of a frog raised in a well.", created_at:1779242086, source_id:"chunk-1fed5f5d5a60fdd3201f9ce6b7a60c39", entity_id:"kupastha"}}, {_id:3843, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"UNKNOWN", truncate:"", description:"The YouTube Video is directly linked to the provided URL as its source material.", created_at:1779242086, source_id:"chunk-1fed5f5d5a60fdd3201f9ce6b7a60c39", entity_id:"https://www.youtube.com/watch?v=M8XASiz30oE"}}, {_id:3844, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"UNKNOWN", truncate:"", description:"Both \"kupastha\" and \"manduka\" are Sanskrit terms meaning frog, leading to the entity description of a frog raised in a well.", created_at:1779242087, source_id:"chunk-1fed5f5d5a60fdd3201f9ce6b7a60c39", entity_id:"manduka"}}, {_id:3852, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"UNKNOWN", truncate:"", description:"The video contains a transcription error with the term \"UP\" at the end.` - Correct.", created_at:1779242173, source_id:"chunk-38d459f7517c4d43d87f88ce27859776", entity_id:"UP"}}, {_id:3853, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"content", truncate:"", description:"Original uncorrected phrase from the text.", created_at:1779242200, source_id:"chunk-565f31c778a5c7a7dca6ba7639c9783c", entity_id:"seven times.UP Thank you."}}, {_id:3854, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"content", truncate:"", description:"A repetitive phrase in the text, mentioned multiple times at the end.", created_at:1779242200, source_id:"chunk-565f31c778a5c7a7dca6ba7639c9783c", entity_id:"Have a beautiful day in a beautiful state"}}, {_id:3855, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"content", truncate:"", description:"Corrected version of the phrase with proper capitalization and punctuation.", created_at:1779242200, source_id:"chunk-565f31c778a5c7a7dca6ba7639c9783c", entity_id:"seven times. Up, thank you."}}, {_id:3856, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M8XASiz30oE)", entity_type:"content", truncate:"", description:"Initial question posed in the text, repeated later.", created_at:1779242200, source_id:"chunk-565f31c778a5c7a7dca6ba7639c9783c", entity_id:"Is there love in all this?"}}] AS row
