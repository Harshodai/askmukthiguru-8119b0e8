UNWIND [{start: {_id:1026}, end: {_id:1036}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"conflict,marital conflict,separation", truncate:"", weight:2.0, description:"Sunil's wife demands he prioritize parenting, leading to conflict and eventual divorce due to his refusal.<SEP>Sunil's refusal to prioritize family leads to divorce, highlighting a disconnect in their relationship.", created_at:1779186683, source_id:"chunk-562a8cc0548c2eafa4b1166a020d46a2<SEP>chunk-7f41805cd78c323a0c0383328a52c327"}}, {start: {_id:1026}, end: {_id:1038}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"compassion,spiritual awakening", truncate:"", weight:1.0, description:"The crab's presence during meditation sparks intense compassion and love in Sunil, leading to self-realization.", created_at:1779141312, source_id:"chunk-562a8cc0548c2eafa4b1166a020d46a2"}}, {start: {_id:1034}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"introspection,spiritual awakening,transformation", truncate:"", weight:2.0, description:"The meditation induces a profound realization about Sunil's relationships and self-perception.<SEP>The meditation triggers Sunil's profound shift from disconnection to compassion and love.", created_at:1779186683, source_id:"chunk-562a8cc0548c2eafa4b1166a020d46a2<SEP>chunk-7f41805cd78c323a0c0383328a52c327"}}, {start: {_id:1026}, end: {_id:1033}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"education,spiritual growth", truncate:"", weight:1.0, description:"Sunil participates in the course containing the Mystic Limitless Field meditation, leading to personal transformation.", created_at:1779141312, source_id:"chunk-562a8cc0548c2eafa4b1166a020d46a2"}}, {start: {_id:1026}, end: {_id:1037}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional distance,parental duty", truncate:"", weight:1.0, description:"Sunil maintains a duty-driven relationship with his daughter post-divorce, visiting her infrequently without emotional connection.", created_at:1779141312, source_id:"chunk-562a8cc0548c2eafa4b1166a020d46a2"}}, {start: {_id:862}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"deep connection,transformed relationship", weight:1.0, description:"Sunil's spiritual experience enables him to connect with his daughter's emotions and perspectives, leading to a joyful and affectionate relationship.", created_at:1779141339, source_id:"chunk-f8449165361188bfe6afa260ab623922"}}, {start: {_id:1039}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"enlightenment,spiritual practice", truncate:"", weight:1.0, description:"Sunil's meditation on the Mystic Limitless Field triggers his transformative experience of love and compassion.", created_at:1779141339, source_id:"chunk-f8449165361188bfe6afa260ab623922"}}, {start: {_id:1042}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"compassion,interconnectedness,universal kinship", truncate:"", weight:2.0, description:"Observing the crab during meditation sparks Sunil's feelings of kinship with all living beings.<SEP>Observing a crab during meditation triggered Sunil's profound empathy for all living beings.", created_at:1779187117, source_id:"chunk-f8449165361188bfe6afa260ab623922<SEP>chunk-9a28e4054912d7c9812d1628ee5acb4a"}}, {start: {_id:556}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"family bonding,proximity", truncate:"", weight:1.0, description:"Sunil chooses to live part-time in the city to maintain close contact with his daughter.", created_at:1779141339, source_id:"chunk-f8449165361188bfe6afa260ab623922"}}, {start: {_id:1041}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"joy,life appreciation", truncate:"", weight:1.0, description:"Hearing children's laughter reinforces Sunil's sense of belonging and connection to life.", created_at:1779141340, source_id:"chunk-f8449165361188bfe6afa260ab623922"}}, {start: {_id:1040}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"mutual appreciation,romantic connection", weight:1.0, description:"Sunil's transformed state attracts a partner who admires his spiritual growth.", created_at:1779141340, source_id:"chunk-f8449165361188bfe6afa260ab623922"}}, {start: {_id:74}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"parental involvement,understanding", truncate:"", weight:1.0, description:"Sunil's newfound connection helps him engage with his daughter's school-related experiences.", created_at:1779141340, source_id:"chunk-f8449165361188bfe6afa260ab623922"}}, {start: {_id:1047}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"conflict resolution,empathy", truncate:"", weight:1.0, description:"Sunil understands his daughter's squabbles with friends through his deepened emotional connection.", created_at:1779141340, source_id:"chunk-f8449165361188bfe6afa260ab623922"}}, {start: {_id:1044}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional alignment,relational harmony", weight:1.0, description:"Sunil's state of love enables him to connect with his daughter's desires and views harmoniously.", created_at:1779141340, source_id:"chunk-f8449165361188bfe6afa260ab623922"}}, {start: {_id:1045}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"bonding,emotional resonance", truncate:"", weight:1.0, description:"Sunil's daughter's joyful chatter reflects their strengthened relationship post-transformation.", created_at:1779141340, source_id:"chunk-f8449165361188bfe6afa260ab623922"}}, {start: {_id:1048}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional intensity,physical manifestation", weight:1.0, description:"Sunil's physical reaction underscores the depth of his emotional experience during family interactions.", created_at:1779141340, source_id:"chunk-f8449165361188bfe6afa260ab623922"}}, {start: {_id:1049}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"relational transformation,worldview shift", weight:1.0, description:"Sunil's experience of love fundamentally changes his approach to relationships and life.", created_at:1779141340, source_id:"chunk-f8449165361188bfe6afa260ab623922"}}, {start: {_id:1050}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional fulfillment,universal connection", weight:1.0, description:"Sunil's sense of belonging extends to nature, humanity, and his daughter after his transformation.", created_at:1779141340, source_id:"chunk-f8449165361188bfe6afa260ab623922"}}, {start: {_id:455}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"familial and universal bonds", truncate:"", weight:1.0, description:"Sunil's kinship with all living beings intensifies after his spiritual awakening.", created_at:1779141340, source_id:"chunk-f8449165361188bfe6afa260ab623922"}}, {start: {_id:1051}, end: {_id:1026}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"emotional attunement,relational harmony", weight:1.0, description:"Sunil aligns with his daughter's emotional needs through his newfound state of love.", created_at:1779141340, source_id:"chunk-f8449165361188bfe6afa260ab623922"}}] AS row
