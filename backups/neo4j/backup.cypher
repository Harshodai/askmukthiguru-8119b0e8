UNWIND [{start: {_id:1613}, end: {_id:8281}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1sMxPhQcvEA)", truncate:"", keywords:"outcomes,practice", weight:1.0, description:"Meditations can lead to transcendental states like trance or divine communion.", created_at:1779735170, source_id:"chunk-dbd47932643e18935fb4241ff99a2dc0"}}, {start: {_id:8282}, end: {_id:8277}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1sMxPhQcvEA)", keywords:"spontaneity,trigger", truncate:"", weight:1.0, description:"Breathtaking beauty can spontaneously induce meditative states of well-being.", created_at:1779735171, source_id:"chunk-dbd47932643e18935fb4241ff99a2dc0"}}, {start: {_id:8279}, end: {_id:8277}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1sMxPhQcvEA)", keywords:"induction,practice", truncate:"", weight:1.0, description:"Induction methods like solitude or fasting are used to intentionally provoke meditative states.", created_at:1779735171, source_id:"chunk-dbd47932643e18935fb4241ff99a2dc0"}}, {start: {_id:8283}, end: {_id:8277}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1sMxPhQcvEA)", truncate:"", keywords:"achievement,passive", weight:1.0, description:"Meditation", created_at:1779735171, source_id:"chunk-dbd47932643e18935fb4241ff99a2dc0"}}, {start: {_id:8278}, end: {_id:8283}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=1sMxPhQcvEA)", keywords:"spontaneity,trigger", truncate:"", weight:1.0, description:"Intense crises like illness or near-death experiences can spontaneously induce meditation as a happening.", created_at:1779735171, source_id:"chunk-dbd47932643e18935fb4241ff99a2dc0"}}, {start: {_id:1619}, end: {_id:8287}, properties:{file_path:"unknown_source", keywords:"error correction,service provision", truncate:"", weight:2.0, description:"Mukthi Guru platform requires text correction services for transcription errors in its content.<SEP>Mukthi Guru platform requires text correction services for transcription errors in its content.", created_at:1779735379, source_id:"chunk-24979790543830f1142942642c3d852a"}}, {start: {_id:1883}, end: {_id:8287}, properties:{file_path:"unknown_source", truncate:"", keywords:"error resolution,grammatical accuracy", weight:2.0, description:"User's Request focuses on resolving transcription errors including homophones and domain terms.<SEP>User's Request focuses on resolving transcription errors including homophones and domain terms.", created_at:1779735379, source_id:"chunk-24979790543830f1142942642c3d852a"}}, {start: {_id:1996}, end: {_id:8287}, properties:{file_path:"unknown_source", keywords:"error type,linguistic accuracy", truncate:"", weight:2.0, description:"User's Request specifically addresses homophones/misheard words as part of error correction.<SEP>User's Request specifically addresses homophones/misheard words as part of error correction.", created_at:1779735379, source_id:"chunk-24979790543830f1142942642c3d852a"}}, {start: {_id:8286}, end: {_id:8287}, properties:{file_path:"unknown_source", keywords:"contextual relevance,error type", truncate:"", weight:2.0, description:"User's Request requires accurate transcription of domain-specific terms from the provided list.<SEP>User's Request requires accurate transcription of domain-specific terms from the provided list.", created_at:1779735379, source_id:"chunk-24979790543830f1142942642c3d852a"}}, {start: {_id:2462}, end: {_id:8287}, properties:{file_path:"unknown_source", keywords:"error type,grammatical structure", truncate:"", weight:2.0, description:"User's Request includes fixing punctuation and capitalization in the repetitive text.<SEP>User's Request includes fixing punctuation and capitalization in the repetitive text.", created_at:1779735379, source_id:"chunk-24979790543830f1142942642c3d852a"}}, {start: {_id:4334}, end: {_id:8287}, properties:{file_path:"unknown_source", keywords:"constraint,content preservation", truncate:"", weight:2.0, description:"User's Request enforces avoiding retention of original non-existent meaning during corrections.<SEP>User's Request enforces avoiding retention of original non-existent meaning during corrections.", created_at:1779735379, source_id:"chunk-24979790543830f1142942642c3d852a"}}, {start: {_id:8285}, end: {_id:8287}, properties:{file_path:"unknown_source", keywords:"constraint,output requirement", truncate:"", weight:2.0, description:"User's Request requires transforming repetitive text into a readable sentence while maintaining emphasis.<SEP>User's Request requires transforming repetitive text into a readable sentence while maintaining emphasis.", created_at:1779735380, source_id:"chunk-24979790543830f1142942642c3d852a"}}, {start: {_id:8288}, end: {_id:8287}, properties:{file_path:"unknown_source", truncate:"", keywords:"content transformation,emphasis preservation", weight:2.0, description:"User's Request involves converting repeated \"Each\" into a meaningful sentence with preserved emphasis.<SEP>User's Request involves converting repeated \"Each\" into a meaningful sentence with preserved emphasis.", created_at:1779735380, source_id:"chunk-24979790543830f1142942642c3d852a"}}, {start: {_id:8289}, end: {_id:2144}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=tDcy09esbe8)", truncate:"", keywords:"constraint application,content processing", weight:2.0, description:"Original meaning is discarded to create meaningful text from gibberish input.<SEP>Original meaning is discarded to create meaningful text from gibberish input.", created_at:1779735359, source_id:"chunk-c78b80b3d190a3dd471274fce89c4224"}}, {start: {_id:8292}, end: {_id:2406}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Vt_CjAdzebM)", truncate:"", keywords:"error resolution,literal replacement", weight:1.0, description:"The transcription error could be replaced with a blank string to represent absent text.", created_at:1779735882, source_id:"chunk-10cfea730dda35fa45c5ab791a46e19c"}}, {start: {_id:2343}, end: {_id:2406}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Vt_CjAdzebM)", truncate:"", keywords:"content,error", weight:2.0, description:"Input Text contains a transcription error represented by the string '?l?l?l...'.", created_at:1779736468, source_id:"chunk-55556acea804a1064101176b4fd1d907"}}, {start: {_id:2343}, end: {_id:1619}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Vt_CjAdzebM)", truncate:"", keywords:"context,reference", weight:1.0, description:"Input Text is discussed in the context of Mukthi Guru, a spiritual platform.", created_at:1779736468, source_id:"chunk-55556acea804a1064101176b4fd1d907"}}, {start: {_id:1881}, end: {_id:1996}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Vt_CjAdzebM)", truncate:"", keywords:"error analysis,linguistic evaluation", weight:2.0, description:"Both concepts are systematically evaluated during error identification despite no direct matches in the text.<SEP>Both concepts are systematically evaluated during error identification despite no direct matches in the text.", created_at:1779736656, source_id:"chunk-18cbd171bb5b60b25e9939f225a974d3"}}, {start: {_id:8295}, end: {_id:8294}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Vt_CjAdzebM)", truncate:"", keywords:"content inclusion,corruption", weight:2.0, description:"The corrupted file contains unreadable placeholder text requiring resolution.<SEP>The corrupted file contains unreadable placeholder text requiring resolution.", created_at:1779736656, source_id:"chunk-18cbd171bb5b60b25e9939f225a974d3"}}, {start: {_id:8295}, end: {_id:8293}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Vt_CjAdzebM)", truncate:"", keywords:"principle application,problem context", weight:2.0, description:"The concept explains the origin of the corrupted file's poor output from poor input quality.<SEP>The concept explains the origin of the corrupted file's poor output from poor input quality.", created_at:1779736656, source_id:"chunk-18cbd171bb5b60b25e9939f225a974d3"}}] AS row
