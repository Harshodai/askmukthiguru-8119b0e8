UNWIND [{start: {_id:6701}, end: {_id:6894}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"contextual relevance,thematic connection", weight:1.0, description:"The phrase \"Fix us a day\" is contextually linked to the concept of \"attitude\" in the video's narrative.", created_at:1779651656, source_id:"chunk-b01bb0caae1e2017827b09d9e858a6e3"}}, {start: {_id:6891}, end: {_id:6740}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"content analysis,contextual reference", weight:1.0, description:"The YouTube video contains the phrase \"Fix us a day\" as part of its transcript content.", created_at:1779651722, source_id:"chunk-276e2821a658fe03b04118b0a70183e8"}}, {start: {_id:6895}, end: {_id:6693}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"academic,academic activity,institutional context,related", weight:2.0, description:"Homework is mentioned as part of the speaker's college-related activities and responsibilities.<SEP>College is the context for the speaker's homework.", created_at:1779652100, source_id:"chunk-276e2821a658fe03b04118b0a70183e8<SEP>chunk-f5593ece4d6fefc307d1c996f846a8c5"}}, {start: {_id:6701}, end: {_id:6895}, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", truncate:"", keywords:"educational context,personal reference", weight:1.0, description:"The discussion of \"attitude\" occurs within the context of the speaker's college-related experiences.", created_at:1779651722, source_id:"chunk-276e2821a658fe03b04118b0a70183e8"}}, {start: {_id:992}, end: {_id:3278}, properties:{file_path:"unknown_source", keywords:"karma,unresolved experiences", truncate:"", weight:1.0, description:"The couple's relationship is driven by shared vasanas and past-life connections, manifestin