UNWIND [{start: {_id:4698}, end: {_id:2232}, properties:{file_path:"unknown_source<SEP>YouTube Video: WwgBOejW_pI (URL: https://www.youtube.com/watch?v=WwgBOejW_pI)", truncate:"", keywords:"awakening processes,environmental impact,environmental transformation,spiritual connection", weight:2.0, description:"Mother Earth's living consciousness is directly linked to AECOM's awakening processes and subsequent environmental changes.<SEP>Mother Earth has responded to awakening processes at AECOM with changes in weather patterns and ecological conditions.", created_at:1779404656, source_id:"chunk-320aa2dc5a7e3281f4a1c7e49431004a<SEP>chunk-75ff5096ac3ca5ee13943606970189d6"}}, {start: {_id:4696}, end: {_id:4694}, properties:{file_path:"unknown_source", keywords:"environmental change,natural renewal", truncate:"", weight:1.0, description:"The rains transformed the dry lands and hills into green, life-sustaining ecosystems.", created_at:1779404590, source_id:"chunk-320aa2dc5a7e3281f4a1c7e49431004a"}}, {start: {_id:4695}, end: {_id:4693}, properties:{file_path:"unknown_source<SEP>YouTube Video: WwgBOejW_pI (URL: https://www.youtube.com/watch?v=WwgBOejW_pI)", keywords:"biodiversity,ecological recovery", truncate:"", weight:2.0, description:"The previously dry lands and hills became habitable for birds and animals after environmental restoration.<SEP>The hills have seen increased wildlife activity due to the greened environment and restored water sources.", created_at:1779404657, source_id:"chunk-320aa2dc5a7e3281f4a1c7e49431004a<SEP>chunk-75ff5096ac3ca5ee13943606970189d6"}}, {start: {_id:4699}, end: {_id:4697}, properties:{file_path:"unknown_source", truncate:"", keywords:"cause and effect,environmental impact", weight:1.0, description:"The awakening processes caused dramatic changes in weather patterns, including increased rainfall.", created_at:1779404590, source_id:"chunk-320aa2dc5a7e3281f4a1c7e49431004a"}}, {start: {_id:4698}, end: {_id:4699}, properties:{file_path:"unknown_source", truncate:"", keywords:"organizational initiative,spiritual practice", weight:1.0, description:"AECOM conducted profound awakening processes that led to ecological restoration.", created_at:1779404591, source_id:"chunk-320aa2dc5a7e3281f4a1c7e49431004a"}}, {start: {_id:2232}, end: {_id:4694}, properties:{file_path:"unknown_source<SEP>YouTube Video: WwgBOejW_pI (URL: https://www.youtube.com/watch?v=WwgBOejW_pI)", keywords:"benevolence,ecological response", truncate:"", weight:2.0, description:"Mother Earth responded benevolently to respectful engagement, resulting in life-sustaining rains.<SEP>Mother Earth has responded benevolently to human actions, sending rains to replenish the land.", created_at:1779404657, source_id:"chunk-320aa2dc5a7e3281f4a1c7e49431004a<SEP>chunk-75ff5096ac3ca5ee13943606970189d6"}}, {start: {_id:4693}, end: {_id:4694}, properties:{file_path:"YouTube Video: WwgBOejW_pI (URL: https://www.youtube.com/watch?v=WwgBOejW_pI)", truncate:"", keywords:"ecological restoration,water supply", weight:1.0, description:"The rains have wetted the previously dry lands and hills, enabling ecological restoration.", created_at:1779404656, source_id:"chunk-75ff5096ac3ca5ee13943606970189d6"}}, {start: {_id:299}, end: {_id:4702}, properties:{file_path:"YouTube Video: WwgBOejW_pI (URL: https://www.youtube.com/watch?v=WwgBOejW_pI)", keywords:"respect,sustainability", truncate:"", weight:1.0, description:"The concept of not exploiting aligns with love, emphasizing respect and replenishment of resources.", created_at:1779404656, source_id:"chunk-75ff5096ac3ca5ee13943606970189d6"}}, {start: {_id:4698}, end: {_id:4697}, properties:{file_path:"YouTube Video: WwgBOejW_pI (URL: https://www.youtube.com/watch?v=WwgBOejW_pI)", truncate:"", keywords:"awakening processes,environmental change", weight:1.0, description:"AECOM's awakening processes have triggered significant changes in local weather patterns.", created_at:1779404657, source_id:"chunk-75ff5096ac3ca5ee13943606970189d6"}}, {start: {_id:4711}, end: {_id:4709}, properties:{file_path:"unknown_source", keywords:"ineffective solutions,ongoing issue", truncate:"", weight:1.0, description:"The habit of disappointment persists alongside the habit of anxiety, indicating ineffective solutions.", created_at:1779404783, source_id:"chunk-0b8200467f9ed7bc0b0109cef2c5f58c"}}, {start: {_id:4710}, end: {_id:4712}, properties:{file_path:"unknown_source", keywords:"mind's prison,psychological state", truncate:"", weight:1.0, description:"Loneliness is part of the prison of the mind, reflecting the psychological state.", created_at:1779404783, source_id:"chunk-0b8200467f9ed7bc0b0109cef2c5f58c"}}, {start: {_id:496}, end: {_id:3605}, properties:{file_path:"unknown_source", truncate:"", keywords:"cyclical patterns,emotional transitions", weight:1.0, description:"The mind hops from one anxiety to another, then to disappointment, creating a cycle of negative emotions.", created_at:1779404783, source_id:"chunk-0b8200467f9ed7bc0b0109cef2c5f58c"}}, {start: {_id:4705}, end: {_id:4714}, properties:{file_path:"unknown_source", keywords:"coping strategy,response mechanism", truncate:"", weight:1.0, description:"The inner crisis prompts the search for change as a response to emotional turmoil.", created_at:1779404783, source_id:"chunk-0b8200467f9ed7bc0b0109cef2c5f58c"}}, {start: {_id:4711}, end: {_id:4712}, properties:{file_path:"unknown_source", keywords:"mind's prison,psychological state", truncate:"", weight:1.0, description:"Anxiety is part of the prison of the mind, contributing to the psychological state.", created_at:1779404783, source_id:"chunk-0b8200467f9ed7bc0b0109cef2c5f58c"}}, {start: {_id:496}, end: {_id:4703}, properties:{file_path:"unknown_source", keywords:"medication,temporary relief", truncate:"", weight:1.0, description:"Pills are used as a response to anxiety, providing temporary relief.", created_at:1779404783, source_id:"chunk-0b8200467f9ed7bc0b0109cef2c5f58c"}}, {start: {_id:4704}, end: {_id:4714}, properties:{file_path:"unknown_source", keywords:"attempted solution,external change", truncate:"", weight:1.0, description:"Seeking change leads to pursuing a more secure career choice as a solution.", created_at:1779404783, source_id:"chunk-0b8200467f9ed7bc0b0109cef2c5f58c"}}, {start: {_id:4713}, end: {_id:4712}, properties:{file_path:"unknown_source", keywords:"identity,mind's prison", truncate:"", weight:1.0, description:"The prison of the mind is linked to the illusory self, affecting identity.", created_at:1779404783, source_id:"chunk-0b8200467f9ed7bc0b0109cef2c5f58c"}}, {start: {_id:4706}, end: {_id:4714}, properties:{file_path:"unknown_source", keywords:"attempted solution,external change", truncate:"", weight:1.0, description:"Seeking change results in searching for a more secure relationship to combat anxiety.", created_at:1779404784, source_id:"chunk-0b8200467f9ed7bc0b0109cef2c5f58c"}}, {start: {_id:4559}, end: {_id:4712}, properties:{file_path:"unknown_source", keywords:"mind's prison,self-realization", truncate:"", weight:1.0, description:"Liberation is the solution to the prison of the mind.", created_at:1779404784, source_id:"chunk-0b8200467f9ed7bc0b0109cef2c5f58c"}}, {start: {_id:4713}, end: {_id:4559}, properties:{file_path:"unknown_source", keywords:"mind's prison,self-realization", truncate:"", weight:1.0, description:"Liberation addresses the illusory self.", created_at:1779404784, source_id:"chunk-0b8200467f9ed7bc0b0109cef2c5f58c"}}] AS row
