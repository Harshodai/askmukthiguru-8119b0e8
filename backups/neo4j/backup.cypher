UNWIND [{start: {_id:4745}, end: {_id:1703}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"experiencing power,manifestation", weight:2.0, description:"Leaders experience immense power to change systems.", created_at:1779560282, source_id:"chunk-8fe41869f1b0fa2b6e988f652c7091c5"}}, {start: {_id:591}, end: {_id:311}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"driving force,universal experience", weight:1.0, description:"The stressful state underlies all human experiences, including conflict, failure, and pressure.", created_at:1779560377, source_id:"chunk-a6934bb5f3e6b9a7dbc975f40692be35"}}, {start: {_id:6411}, end: {_id:311}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", truncate:"", keywords:"behavioral influence,driving force", weight:1.0, description:"Stressful consciousness directly influences human actions, leading to reactive or pressured decisions.", created_at:1779560378, source_id:"chunk-a6934bb5f3e6b9a7dbc975f40692be35"}}, {start: {_id:6410}, end: {_id:1381}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"global change,speed", truncate:"", weight:1.0, description:"The world's rapid acceleration creates both challenges and opportunities for transformative action.", created_at:1779560390, source_id:"chunk-fb34444d5342f0a266be4edca9184fcf"}}, {start: {_id:6414}, end: {_id:5561}, properties:{file_path:"YouTube Video: mmpmX3-qfc4 (URL: https://www.youtube.com/watch?v=mmpmX3-qfc4)", keywords:"lifestyle,social impact", truncate:"", weight:1.0, description:"Social media contributes to fragmented relationships and shortened attention spans through constant connectivity and rapid content consumption.", created_at:1779560420, source_id:"chunk-1b2894d7e044a8fc57ea102bdd508b16"}}, {start: 