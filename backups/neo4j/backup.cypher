UNWIND [{start: {_id:1202}, end: {_id:1203}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"danger,predation", truncate:"", weight:1.0, description:"The crocodile is in the pit, threatening the protagonist from below.", created_at:1779142956, source_id:"chunk-351f2fd92d6acb5e48e41564a39fe72b"}}, {start: {_id:1203}, end: {_id:1201}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"elevation,location", truncate:"", weight:1.0, description:"The honeycomb is located high above the pit, indicating its position relative to the pit.", created_at:1779142956, source_id:"chunk-351f2fd92d6acb5e48e41564a39fe72b"}}, {start: {_id:1203}, end: {_id:1199}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"composition,danger", truncate:"", weight:1.0, description:"The pit contains murky water, adding to the danger of the environment.", created_at:1779142956, source_id:"chunk-351f2fd92d6acb5e48e41564a39fe72b"}}, {start: {_id:1205}, end: {_id:1200}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"psychological state,representation,symbolism", truncate:"", weight:2.0, description:"The tiger represents the \"Nobody State,\" symbolizing fear and self-obsession.<SEP>The tiger embodies the \"Nobody State,\" representing fear of insignificance and self-obsession.", created_at:1779187431, source_id:"chunk-559824e00f03935bd6001bc6f83f121d<SEP>chunk-f85d41f2377858e80129dfbf7af31bf8"}}, {start: {_id:1206}, end: {_id:1207}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"negative impact,pursuit", truncate:"", weight:1.0, description:"The pit is linked to the aggressive and unconscious pursuit of wealth creation.", created_at:1779142994, source_id:"chunk-559824e00f03935bd6001bc6f83f121d"}}, {start: {_id:1205}, end: {_id:1209}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"causes,consequence", truncate:"", weight:1.0, description:"The Nobody State drives individuals to plunge into the pit out of fear of insignificance.", created_at:1779143014, source_id:"chunk-c8545c7b1dfe1b63a7ef3407fb082e4d"}}, {start: {_id:1210}, end: {_id:1211}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"eroding,thinning", truncate:"", weight:1.0, description:"The mice nibble at the vine, eroding hope over time.", created_at:1779143014, source_id:"chunk-c8545c7b1dfe1b63a7ef3407fb082e4d"}}, {start: {_id:1214}, end: {_id:1208}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"causes,consequence", truncate:"", weight:1.0, description:"Self-obsession leads to the crocodile's endless loop of financial problems and mediocrity.", created_at:1779143014, source_id:"chunk-c8545c7b1dfe1b63a7ef3407fb082e4d"}}, {start: {_id:1209}, end: {_id:1213}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"confrontation,temptation", truncate:"", weight:1.0, description:"The tiger's presence tempts individuals to confront the pit recklessly.", created_at:1779143014, source_id:"chunk-c8545c7b1dfe1b63a7ef3407fb082e4d"}}, {start: {_id:1208}, end: {_id:1209}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"consequence,leads to", truncate:"", weight:1.0, description:"The pit leads to the crocodile's endless loop of financial problems and mediocrity as individuals slide into it.", created_at:1779143014, source_id:"chunk-c8545c7b1dfe1b63a7ef3407fb082e4d"}}, {start: {_id:1215}, end: {_id:1216}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"employment,leadership,professional identity,professional role,workplace", truncate:"", weight:3.0, created_at:1779187431, description:"Mike serves as the CEO of the architecture firm, leading its rise to recognition.<SEP>Mike was the CEO of the architecture firm, which is the context of his previous work and transformation.<SEP>Mike served as CEO of the architecture firm, which became central to his identity and eventual downfall.", source_id:"chunk-7503a6ae65b185937e995c2f50e85b5c<SEP>chunk-200c896d057fae8b41a69675f296365e<SEP>chunk-2093a273636983f00fe7dc86ea163faa"}}, {start: {_id:1216}, end: {_id:1218}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"emotional trauma,motivation", truncate:"", weight:1.0, description:"The shameful feeling from being ditched motivated Mike's later arrogance and career striving.", created_at:1779143066, source_id:"chunk-7503a6ae65b185937e995c2f50e85b5c"}}, {start: {_id:1215}, end: {_id:1222}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"achievement,dissatisfaction", truncate:"", weight:1.0, description:"The firm's success did not fulfill Mike's hoped-for happiness, highlighting his inner emptiness.", created_at:1779143066, source_id:"chunk-7503a6ae65b185937e995c2f50e85b5c"}}, {start: {_id:1220}, end: {_id:1216}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", truncate:"", keywords:"defense mechanism,negative consequence", weight:1.0, description:"Mike adopted arrogance to counter shame, creating a negative energy vortex.", created_at:1779143066, source_id:"chunk-7503a6ae65b185937e995c2f50e85b5c"}}, {start: {_id:1216}, end: {_id:1221}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"aspiration,contrast", truncate:"", weight:1.0, description:"Mike's journey contrasts with the transcendent consciousness of the Nobody State.", created_at:1779143066, source_id:"chunk-7503a6ae65b185937e995c2f50e85b5c"}}, {start: {_id:1220}, end: {_id:1217}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"consciousness state,life impact", truncate:"", weight:1.0, description:"Arrogance perpetuates a chaotic energy state hindering true happiness and abundance.", created_at:1779143066, source_id:"chunk-7503a6ae65b185937e995c2f50e85b5c"}}, {start: {_id:972}, end: {_id:1216}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"futile attempts,inner void", truncate:"", weight:1.0, description:"Mike's pursuit of wealth and success was a futile attempt to fill his inner void stemming from feelings of inadequacy.", created_at:1779143119, source_id:"chunk-cd472120781d30f6deb417cdc30ee13c"}}, {start: {_id:497}, end: {_id:1216}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"addiction,self-realization", truncate:"", weight:1.0, description:"Mike realized that his relentless drive for success and wealth was an addiction driven by his inner void.", created_at:1779143119, source_id:"chunk-cd472120781d30f6deb417cdc30ee13c"}}, {start: {_id:1224}, end: {_id:1216}, properties:{file_path:"The_Four_Sacred_Secrets.pdf<SEP>unknown_source", keywords:"image tarnishing,public perception,reputation", truncate:"", weight:2.0, description:"Mike's downfall and loss of reputation were tarnished in the media, affecting his public image.<SEP>Media exposure tarnishes Mike's image after his unethical actions against a competitor.", created_at:1779187431, source_id:"chunk-cd472120781d30f6deb417cdc30ee13c<SEP>chunk-2093a273636983f00fe7dc86ea163faa"}}, {start: {_id:497}, end: {_id:972}, properties:{file_path:"The_Four_Sacred_Secrets.pdf", keywords:"cause,manifestation", truncate:"", weight:1.0, description:"The inner void led to Mike's addiction to success and wealth as a futile attempt to fill the void.", created_at:1779143119, source_id:"chunk-cd472120781d30f6deb417cdc30ee13c"}}] AS row
