24ecdfc2f30a<SEP>chunk-5a061c3e192c4aaa5026aa79274bb0f1<SEP>chunk-7ac9109abdb5bdc9de2685e960e358c1<SEP>chunk-dd4f29607e86446996b5a0f4d31130d7", entity_id:"Mahal-e-amavasya"}}, {_id:3281, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", entity_type:"concept", truncate:"", description:"Anger and hate lead to unthinkable cruelty.<SEP>Anger and Hate are concepts that lead to violence and cruelty.", created_at:1779193436, source_id:"chunk-a1ec36477897e4ff74fcbce70331c0fc<SEP>chunk-acb941e2e31d401b209b5294a9065fb1", entity_id:"Anger and Hate"}}, {_id:3282, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", entity_type:"concept", truncate:"", description:"Values and ideals are principles America uses to address racial violence, though criticized as insufficient.", created_at:1779192042, source_id:"chunk-3ae96ad01fcb39bd7a75f6d45072f0d6<SEP>chunk-a466e41ebd2dd29a05776a329c8e9dec", entity_id:"Values and Ideals"}}, {_id:3283, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", entity_type:"concept", truncate:"", created_at:1779193828, description:"Hates are emotions perpetuating violence and division within individuals and generations.<SEP>Hates are intense emotions rooted in fear and insecurity, spreading contagiously across individuals and generations.<SEP>Hates stem from fear and insecurity, perpetuating violence.", source_id:"chunk-3ae96ad01fcb39bd7a75f6d45072f0d6<SEP>chunk-7d81041aa6a8c1ffd7fa363d2179e32d<SEP>chunk-18dfe327019b4987cc16243e45ad4a98", entity_id:"Hates"}}, {_id:3284, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", entity_type:"concept", truncate:"", description:"Prejudices are ingrained biases contributing to societal conflict and violence.<SEP>Prejudices are ingrained judgments or biases held by individuals, contributing to societal discrimination.<SEP>Prejudices are deeply ingrained judgments and biases that perpetuate discrimination and violence.<SEP>Prejudices are ingrained judgments and biases requiring recognition for societal progress.", created_at:1779193828, source_id:"chunk-3ae96ad01fcb39bd7a75f6d45072f0d6<SEP>chunk-7d81041aa6a8c1ffd7fa363d2179e32d<SEP>chunk-0cb21e09915c74bf08c75e2e9b3c1480<SEP>chunk-18dfe327019b4987cc16243e45ad4a98", entity_id:"Prejudices"}}, {_id:3285, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"person", truncate:"", description:"Ancient Hindus performed ancestral samskaras and held philosophical beliefs about life after death.`", created_at:1779228758, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281", entity_id:"Ancient Hindus"}}, {_id:3286, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", entity_type:"event", truncate:"", description:"The Italian Rebellion is referenced as an example of violence stemming from unresolved societal tensions.<SEP>The Italian rebellion is referenced as an example of historical conflict and violence.", created_at:1779193292, source_id:"chunk-9d6f79b5d9addaa1bb7ed5a41e6ca13e<SEP>chunk-4be5f58baaab4360b84499e4e9c8f89b", entity_id:"Italian Rebellion"}}, {_id:3287, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"concept", truncate:"", description:"Ancient ceremonies aimed to resolve ancestral vasanas through rituals performed by spiritually attuned priests.`<SEP>Ancient Ceremonies were effective due to the intuition of priests and the philosophy of the ancient people regarding life after death.", created_at:1779228940, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281<SEP>chunk-ff31f73b2ef0618c73b0f438087fdec4", entity_id:"Ancient Ceremonies"}}, {_id:3288, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"concept", truncate:"", description:"Ancient philosophy integrated beliefs about life after death and spiritual realities into daily practices.`", created_at:1779228759, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281", entity_id:"General Philosophy"}}, {_id:3289, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", entity_type:"concept", truncate:"", description:"Unhappy conditions during life result in a grief-filled afterlife for ancestors.`", created_at:1779228759, source_id:"chunk-fd88fca76d8bbe7034dd353f047d1281", entity_id:"Unhappy Conditions"}}, {_id:3290, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", entity_type:"concept", truncate:"", description:"Inner Evolution<SEP>Inner evolution refers to the need for personal and societal transformation through non-violent means.`<SEP>Inner evolution emphasizes personal and societal growth through non-violent methods.", created_at:1779193293, source_id:"chunk-9d6f79b5d9addaa1bb7ed5a41e6ca13e<SEP>chunk-08f2f333c27085728d7608b7e47baa48<SEP>chunk-1a2d9f9a94f699ed87aa72d476d3870c<SEP>chunk-4be5f58baaab4360b84499e4e9c8f89b", entity_id:"Inner Evolution"}}, {_id:3291, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)<SEP>YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", entity_type:"concept", truncate:"", created_at:1779453183, description:"India's discrimination is rooted in caste-based social stratification.<SEP>Discrimination based on social hierarchy, mentioned in the context of Indian societal challenges.<SEP>Caste Discrimination refers to hierarchical social stratification and associated prejudice.", source_id:"chunk-9d6f79b5d9addaa1bb7ed5a41e6ca13e<SEP>chunk-c5d032c6a2271ec421a56c36fda060bb<SEP>chunk-a85ada8ef40f654a099ee00af9f2432f", entity_id:"Caste Discrimination"}}, {_id:3292, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", entity_type:"UNKNOWN", truncate:"", description:"Discriminatory behaviors are perpetuated through stories passed down by parents and grandparents.", created_at:1779192110, source_id:"chunk-9d6f79b5d9addaa1bb7ed5a41e6ca13e", entity_id:"Discriminatory Behaviors"}}, {_id:3293, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)", entity_type:"UNKNOWN", truncate:"", description:"China's societal issues are linked to class-based discrimination.", created_at:1779192110, source_id:"chunk-9d6f79b5d9addaa1bb7ed5a41e6ca13e", entity_id:"Class Discrimination"}}, {_id:3294, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=kPuvsIyt6UI)<SEP>YouTube Video: uNkgwv4dqEs (URL: https://www.youtube.com/watch?v=uNkgwv4dqEs)", entity_type:"concept", truncate:"", created_at:1779453183, description:"America's societal structure is tied to racial discrimination as a basis for social hierarchy.<SEP>Racial discrimination is a form of discrimination based on race, perpetuated through generational narratives.<SEP>Racial discrimination is a form of discrimination based on race, exemplified by America's historical context.<SEP>Racial discrimination refers to prejudiced treatment based on race or ethnicity.<SEP>Form of discrimination highlighted in the video as a source of conflict and separation.<SEP>Racial Discrimination is a form of social division based on perceived racial differences.", source_id:"chunk-9d6f79b5d9addaa1bb7ed5a41e6ca13e<SEP>chunk-7d81041aa6a8c1ffd7fa363d2179e32d<SEP>chunk-0cb21e09915c74bf08c75e2e9b3c1480<SEP>chunk-4be5f58baaab4360b84499e4e9c8f89b<SEP>chunk-c5d032c6a2271ec421a56c36fda060bb<SEP>chunk-a85ada8ef40f654a099ee00af9f2432f", entity_id:"Racial Discrimination"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
