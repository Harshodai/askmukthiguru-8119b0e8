UNWIND [{start: {_id:2080}, end: {_id:2086}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=bCzjP2UaKRI)", keywords:"emphasis,recurring theme", truncate:"", weight:1.0, description:"The repeated mention of \"Christian\" underscores its significance in the exploration of human essence.", created_at:1779219096, source_id:"chunk-a0bfcd7158587f7aa70a148fe1dcdffb"}}, {start: {_id:2088}, end: {_id:2098}, properties:{file_path:"unknown_source", truncate:"", keywords:"metaphorical explanation,mind's activity", weight:1.0, description:"The subway station", created_at:1779219940, source_id:"chunk-5250e80e79b58c377f139a5f0c1cbb95"}}, {start: {_id:2122}, end: {_id:2120}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ehkqJ54DIC0)", truncate:"", keywords:"historical context,sages' residence", weight:1.0, description:"Sages lived in the forests and hills of India, where they developed their understanding of the mind.", created_at:1779220120, source_id:"chunk-6df1d0ea6f9bdedd3be52be35afd52d9"}}, {start: {_id:2119}, end: {_id:2088}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ehkqJ54DIC0)", truncate:"", keywords:"cognitive process,mind structure", weight:1.0, description:"Manas represents the thinking dimension of the mind with recurring thought trains.", created_at:1779220120, source_id:"chunk-6df1d0ea6f9bdedd3be52be35afd52d9"}}, {start: {_id:2088}, end: {_id:2130}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ehkqJ54DIC0)", truncate:"", keywords:"cognitive process,metaphorical representation", weight:1.0, description:"Thought trains are a metaphor for the constant flow of thoughts in the thinking mind (Manas).", created_at:1779220120, source_id:"chunk-6df1d0ea6f9bdedd3be52be35afd52d9"}}, {start: {_id:2089}, end: {_id:2119}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ehkqJ54DIC0)", truncate:"", keywords:"ego identification,mind structure", weight:1.0, description:"Ahankara embodies the ego's tendency to identify with thoughts and experiences.", created_at:1779220120, source_id:"chunk-6df1d0ea6f9bdedd3be52be35afd52d9"}}, {start: {_id:2090}, end: {_id:2119}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ehkqJ54DIC0)", truncate:"", keywords:"intellectual function,mind structure", weight:1.0, description:"Buddhahy represents the intellect that categorizes and judges thoughts.", created_at:1779220120, source_id:"chunk-6df1d0ea6f9bdedd3be52be35afd52d9"}}, {start: {_id:2088}, end: {_id:2121}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ehkqJ54DIC0)", truncate:"", keywords:"cognitive process,metaphorical representation", weight:1.0, description:"The mind's thinking process is likened to a subway station with continuous thought trains.", created_at:1779220120, source_id:"chunk-6df1d0ea6f9bdedd3be52be35afd52d9"}}, {start: {_id:2090}, end: {_id:2133}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ehkqJ54DIC0)", truncate:"", keywords:"cognitive function,intellectual activity", weight:1.0, description:"Buddhahy divides thoughts into good, bad, and other categories based on conditioning.", created_at:1779220121, source_id:"chunk-6df1d0ea6f9bdedd3be52be35afd52d9"}}, {start: {_id:2091}, end: {_id:2136}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ehkqJ54DIC0)", truncate:"", keywords:"layer,structure", weight:1.0, description:"Chitta is the fourth layer within the matrix of the mind.", created_at:1779220168, source_id:"chunk-168f7db76a78fdae540996d31ccc165d"}}, {start: {_id:2135}, end: {_id:2136}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ehkqJ54DIC0)", truncate:"", keywords:"layer,structure", weight:1.0, description:"The four mattresses are part of the matrix of the mind's structure.", created_at:1779220168, source_id:"chunk-168f7db76a78fdae540996d31ccc165d"}}, {start: {_id:2091}, end: {_id:2137}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ehkqJ54DIC0)", truncate:"", keywords:"activity,outcome", weight:1.0, description:"Increased activity of Chitta leads to greater wisdom.", created_at:1779220168, source_id:"chunk-168f7db76a78fdae540996d31ccc165d"}}, {start: {_id:2454}, end: {_id:2135}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ehkqJ54DIC0)", keywords:"entanglement,freedom", truncate:"", weight:1.0, description:"The enlightened state involves freedom from entanglement with the four mattresses.", created_at:1779220168, source_id:"chunk-168f7db76a78fdae540996d31ccc165d"}}, {start: {_id:2454}, end: {_id:2138}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ehkqJ54DIC0)", truncate:"", keywords:"capability,state", weight:2.0, description:"In the enlightened state, one can make intelligent decisions and take powerful actions.", created_at:1779220168, source_id:"chunk-168f7db76a78fdae540996d31ccc165d"}}, {start: {_id:2143}, end: {_id:2142}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ehkqJ54DIC0)", truncate:"", keywords:"repetitive emphasis,thematic focus", weight:1.0, description:"The video centers on the conceptual phrase \"The chemistry of chemistry\" through repeated narration, establishing it as the core thematic element.", created_at:1779220182, source_id:"chunk-6ed33350450ca76ba63a9999f907973f"}}, {start: {_id:2073}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=ehkqJ54DIC0)", truncate:"", keywords:"content theme,repetitive phrasing", weight:1.0, description:"The YouTube video repeatedly emphasizes the phrase \"The chemistry of chemistry\" as its central thematic content, creating a rhythmic focus on the concept.", created_