UNWIND [{_id:6951, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"Second stage of food where emotional states during preparation influence the food's energetic properties.", created_at:1779652259, source_id:"chunk-eaeab9baa97a4cf5f954f6f446db65b6", entity_id:"Cooking Stage"}}, {_id:6952, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"content", truncate:"", description:"Video titled \"ffhDTzE4nDU\" discussing stages of food and emotional influences on cooking.<SEP>Video titled \"ffhDTzE4nDU\" discussing emotional influences on food and bodily responses to eating.<SEP>Video titled \"ffhDTzE4nDU\" discussing emotional influences on food and bodily responses to eating.", created_at:1779652416, source_id:"chunk-eaeab9baa97a4cf5f954f6f446db65b6<SEP>chunk-546119e1ccb1dd4a85da9dd32fbd031d", entity_id:"ffhDTzE4nDU"}}, {_id:6953, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"Tradition of showering and changing clothes after visiting a house to remove negative impressions.", created_at:1779652259, source_id:"chunk-eaeab9baa97a4cf5f954f6f446db65b6", entity_id:"Indian Cultural Practice"}}, {_id:6954, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"UNKNOWN", truncate:"", description:"Growing principles prioritize plant health to avoid energetic harm to humans.", created_at:1779652282, source_id:"chunk-eaeab9baa97a4cf5f954f6f446db65b6", entity_id:"Plant Health"}}, {_id:6955, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"A 14-hour gap is recommended between the last meal of the day and the first meal of the next day.", created_at:1779652308, source_id:"chunk-01a258778ec29d7cae94bc0be28d0cb3", entity_id:"14-Hour Gap"}}, {_id:6956, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"The sun's position, specifically not having set below the horizon, is a factor in determining the best time to eat.", created_at:1779652308, source_id:"chunk-01a258778ec29d7cae94bc0be28d0cb3", entity_id:"Sun's Position"}}, {_id:6957, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"The body's feelings after eating, such as feeling heavy, drowsy, agitated, or light, determine the suitability of the food.", created_at:1779652308, source_id:"chunk-01a258778ec29d7cae94bc0be28d0cb3", entity_id:"Body's Feelings After Eating"}}, {_id:6958, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"The third stage of food refers to the timing of consumption and its effect on the body.", created_at:1779652308, source_id:"chunk-01a258778ec29d7cae94bc0be28d0cb3", entity_id:"The Third Stage of Food"}}, {_id:6959, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"Happiness or unhappiness are key factors considered for chefs on the campus, influencing the emotional state of the food.", created_at:1779652308, source_id:"chunk-01a258778ec29d7cae94bc0be28d0cb3", entity_id:"Happiness or Unhappiness"}}, {_id:6960, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"method", truncate:"", description:"Conscious eating is a meditative approach to food consumption involving full awareness, gratitude, and slow consumption to promote health and spiritual connection.", created_at:1779652329, source_id:"chunk-463d3565b6195eb54c22ef1f1f467400", entity_id:"Conscious Eating"}}, {_id:6961, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"Weight gain problems refer to health concerns related to excessive body fat accumulation, mitigated by mindful eating methods.", created_at:1779652329, source_id:"chunk-463d3565b6195eb54c22ef1f1f467400", entity_id:"Weight Gain Problems"}}, {_id:6962, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)<SEP>YouTube Video: Mr1cjAz2y9I (URL: https://www.youtube.com/watch?v=Mr1cjAz2y9I)", entity_type:"natural_object", truncate:"", description:"Wind is a natural element acknowledged in the gratitude practice for its role in food production.<SEP>Wind is a natural object mentioned as part of Mother Earth.", created_at:1779659820, source_id:"chunk-463d3565b6195eb54c22ef1f1f467400<SEP>chunk-831e414d3c516304d3109f8ff76d5f01", entity_id:"Wind"}}, {_id:6963, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"UNKNOWN", truncate:"", description:"Gratitude toward natural elements and contributors is integral to the conscious eating method as a meditative act.", created_at:1779652358, source_id:"chunk-463d3565b6195eb54c22ef1f1f467400", entity_id:"Gratitude (Earth, Wind, etc.)"}}, {_id:6964, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"The concept of allowing personal desires (tongue) to dictate eating decisions rather than awareness.<SEP>The concept of allowing personal desires (tongue) to dictate eating decisions rather than awareness.", created_at:1779652416, source_id:"chunk-546119e1ccb1dd4a85da9dd32fbd031d", entity_id:"Tongue as Master"}}, {_id:6965, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"The concept referring to the timing and awareness of eating as a critical factor in dietary choices.<SEP>The concept referring to the timing and awareness of eating as a critical factor in dietary choices.", created_at:1779652416, source_id:"chunk-546119e1ccb1dd4a85da9dd32fbd031d", entity_id:"Third Stage Of Food"}}, {_id:6966, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"data", truncate:"", description:"URL link to the YouTube video containing the discussed content.<SEP>URL link to the YouTube video containing the discussed content.", created_at:1779652416, source_id:"chunk-546119e1ccb1dd4a85da9dd32fbd031d", entity_id:"https://www.youtube.com/watch?v=ffhDTzE4nDU"}}, {_id:6967, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"The idea that physical sensations after eating (e.g., heavy/drowsy, agitated, light/awake) determine food suitability.<SEP>The idea that physical sensations after eating (e.g., heavy/drowsy, agitated, light/awake) determine food suitability.", created_at:1779652416, source_id:"chunk-546119e1ccb1dd4a85da9dd32fbd031d", entity_id:"Body's Response To Food"}}, {_id:6968, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"The concept that a chef's emotional state during cooking affects the psychological impact of food on consumers.<SEP>The concept that a chef's emotional state during cooking affects the psychological impact of food on consumers.", created_at:1779652416, source_id:"chunk-546119e1ccb1dd4a85da9dd32fbd031d", entity_id:"Emotional Influence On Food"}}, {_id:6969, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"organization", truncate:"", description:"Group of chefs on the campus whose happiness levels are considered in culinary practices.<SEP>Group of chefs on the campus whose happiness levels are considered in culinary practices.", created_at:1779652416, source_id:"chunk-546119e1ccb1dd4a85da9dd32fbd031d", entity_id:"Chefs on the campus"}}, {_id:6970, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"The principle of using conscious awareness over physical cravings to govern eating habits.<SEP>The principle of using conscious awareness over physical cravings to govern eating habits.", created_at:1779652417, source_id:"chunk-546119e1ccb1dd4a85da9dd32fbd031d", entity_id:"Awareness as Master"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:base;
UNWIND [{_id:6971, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"Four stages of food with associated fundamental insights for each stage.<SEP>Four stages of food with associated fundamental insights for each stage.<SEP>Discussed framework in the video outlining different stages of food consumption and associated insights.", created_at:1779652723, source_id:"chunk-295ece324351da0c7194c4e2d4f58e99<SEP>chunk-89dfa3ffec6d1e4a1024414f267e4312", entity_id:"Four Stages of Food"}}, {_id:6978, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"Recommended eating time when the sun has not set and a 14-hour gap between last and first meal of the day.<SEP>Discussed concept in the video's content regarding optimal eating schedules.", created_at:1779652723, source_id:"chunk-78435e02477a2c8cddea91202785185f<SEP>chunk-89dfa3ffec6d1e4a1024414f267e4312", entity_id:"Best Time to Eat"}}, {_id:6979, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"The fourth stage of eating guidelines emphasizing mindful consumption and adherence to natural cycles as described in the video.", created_at:1779652517, source_id:"chunk-78435e02477a2c8cddea91202785185f", entity_id:"Fourth Stage"}}, {_id:6980, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"Initial version of eating guidelines without the comma after \"horizon,\" later corrected for clarity.", created_at:1779652517, source_id:"chunk-78435e02477a2c8cddea91202785185f", entity_id:"Original Statement"}}, {_id:6981, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"Revised phrasing of eating guidelines with improved readability, including a comma after \"horizon.\"", created_at:1779652517, source_id:"chunk-78435e02477a2c8cddea91202785185f", entity_id:"Corrected Statement"}}, {_id:6982, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"A health concern related to excessive weight accumulation, addressed through mindful eating practices.", created_at:1779652520, source_id:"chunk-015d119d7681255e33a079f69eb0532c", entity_id:"Weight Gain Problem"}}, {_id:6983, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"A state of emotional well-being and positive energy resulting from conscious eating practices.", created_at:1779652520, source_id:"chunk-015d119d7681255e33a079f69eb0532c", entity_id:"Joyful and Radiant State"}}, {_id:6984, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"method", truncate:"", description:"A mindful eating method involving slow chewing, holding food in the mouth, and conscious consumption to prevent eating disorders and promote well-being.", created_at:1779652520, source_id:"chunk-015d119d7681255e33a079f69eb0532c", entity_id:"Eating Meditation"}}, {_id:6985, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"UNKNOWN", truncate:"", description:"Eating is advised while the sun is still visible, aligning with natural light-dark cycles.", created_at:1779652571, source_id:"chunk-78435e02477a2c8cddea91202785185f", entity_id:"Sun Position"}}, {_id:6986, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"The second stage of food involves cooking, emphasizing the influence of emotional energy and impressions during food preparation.", created_at:1779652585, source_id:"chunk-8699f9cbb008056691a7d8286116e456", entity_id:"Second Stage of Food"}}, {_id:6987, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"In India, practices like showering and changing clothes after visiting a house are linked to removing negative impressions carried on the body.", created_at:1779652585, source_id:"chunk-8699f9cbb008056691a7d8286116e456", entity_id:"Cultural Practice in India"}}, {_id:6988, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"The emotional state during cooking significantly impacts food, as emotions create energetic impressions that affect the outcome.", created_at:1779652585, source_id:"chunk-8699f9cbb008056691a7d8286116e456", entity_id:"Emotional State in Cooking"}}, {_id:6989, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"The first stage of food involves growing food in farms, emphasizing the principle of not using harmful substances on plants to avoid energetic transfer of suffering to humans.", created_at:1779652585, source_id:"chunk-8699f9cbb008056691a7d8286116e456", entity_id:"First Stage of Food"}}, {_id:6990, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"UNKNOWN", truncate:"", description:"The first stage emphasizes not using harmful substances on plants to prevent energetic transfer of suffering to humans.", created_at:1779652586, source_id:"chunk-8699f9cbb008056691a7d8286116e456", entity_id:"Growing Principle"}}, {_id:6991, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"organization", truncate:"", description:"Chefs on the campus are evaluated based on their happiness levels and cooking practices.", created_at:1779652747, source_id:"chunk-55aaec42564a83029ead3fc6a21e8be6", entity_id:"Chefs on the Campus"}}, {_id:6992, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"Happiness or unhappiness levels in chefs are considered important factors for their role on campus.", created_at:1779652747, source_id:"chunk-55aaec42564a83029ead3fc6a21e8be6", entity_id:"Happiness/Unhappiness Levels"}}, {_id:6993, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"concept", truncate:"", description:"Meals are categorized by timing, with emphasis on the gap between last and first meals of the day.", created_at:1779652748, source_id:"chunk-55aaec42564a83029ead3fc6a21e8be6", entity_id:"Meals"}}, {_id:6994, properties:{file_path:"YouTube Video: ffhDTzE4nDU (URL: https://www.youtube.com/watch?v=ffhDTzE4nDU)", entity_type:"UNKNOWN", truncate:"", description:"Food prepared with joy/peace uplifts eaters, while negative emotions create similar thoughts in them.", created_at:1779652749, source_id:"chunk-55aaec42564a83029ead3fc6a21e8be6", entity_id:"Eaters"}}, {_id:6995, properties:{file_path:"YouTube Video: _GEMrEWCiXw (URL: https://www.youtube.com/watch?v=_GEMrEWCiXw)", entity_type:"content", truncate:"", description:"A phrase analyzed as a non-sequitur in the video, potentially a transcription error or stray phrase.<SEP>A phrase analyzed as a non-sequitur in the video, potentially a transcription error or stray phrase.", created_at:1779652780, source_id:"chunk-3a5d8d7606e9b8e3d7ef11bf46090954", entity_id:"Fix Us a Day"}}, {_id:6996, properties:{file_path:"YouTube Video: uZg9XnRub7w (URL: https://www.youtube.com/watch?v=uZg9XnRub7w)", entity_type:"concept", truncate:"", description:"Cytokines are defense proteins released by cells to combat bacteria and viruses.<SEP>Cytokines are defense proteins released by cells to combat bacteria and viruses.", created_at:1779652962, source_id:"chunk-3da16f4292642f8022ca187ac2cb1ede", entity_id:"Cytokines"}}] AS row
