UNWIND [{start: {_id:3704}, end: {_id:1490}, properties:{file_path:"unknown_source", keywords:"isolation,vulnerability", truncate:"", weight:1.0, description:"Isolated consciousness makes individuals susceptible to collective negativity, unlike community-supported consciousness.>", created_at:1779238806, source_id:"chunk-2937f9db737764b56ab13c05271ce216"}}, {start: {_id:752}, end: {_id:176}, properties:{file_path:"unknown_source", keywords:"collective strength,spiritual growth", truncate:"", weight:1.0, description:"Communities rooted in shared spiritual vision provide resilience against negativity and foster growth.>", created_at:1779238806, source_id:"chunk-2937f9db737764b56ab13c05271ce216"}}, {start: {_id:2391}, end: {_id:753}, properties:{file_path:"unknown_source", keywords:"holistic balance,spiritual alignment", truncate:"", weight:1.0, description:"Enlightened living creates harmony across all life aspects through spiritual alignment.>", created_at:1779238806, source_id:"chunk-2937f9db737764b56ab13c05271ce216"}}, {start: {_id:108}, end: {_id:785}, properties:{file_path:"unknown_source", keywords:"connection,heartfelt engagement", truncate:"", weight:1.0, description:"Connecting with universal intelligence through sincere spiritual connection manifests divine guidance.>", created_at:1779238806, source_id:"chunk-2937f9db737764b56ab13c05271ce216"}}, {start: {_id:752}, end: {_id:3703}, properties:{file_path:"unknown_source", keywords:"mutual support,spiritual sustenance", truncate:"", weight:1.0, description:"Nurturing within communities mirrors the mother-child bond, fostering collective well-being.>", created_at:1779238807, source_id:"chunk-2937f9db737764b56ab13c05271ce216"}}, {start: {_id:785}, end: {_id:348}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=IGryscyFmV8)<SEP>YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=M7ItOHTrvz8)", keywords:"content,covers,discusses,explores", truncate:"", weight:5.0, descri