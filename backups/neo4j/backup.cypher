UNWIND [{start: {_id:3436}, end: {_id:3433}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"energy release,spiritual resolution", weight:1.0, description:"Rituals like Obon and Chisok clear stuck energy associated with the departed.", created_at:1779229188, source_id:"chunk-dd4f29607e86446996b5a0f4d31130d7"}}, {start: {_id:3432}, end: {_id:3280}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"ancestral release,ritual observance", weight:1.0, description:"Mahal-e-amavasya honors ancestors and releases departed souls in suffering.", created_at:1779229188, source_id:"chunk-dd4f29607e86446996b5a0f4d31130d7"}}, {start: {_id:3274}, end: {_id:3438}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"ancestral connection,honoring", weight:1.0, description:"New Moon Day is observed to honor ancestors and release departed souls believed to be trapped in the earthly plane.", created_at:1779229238, source_id:"chunk-98219edafe8ffc379bb20679c2f8f076"}}, {start: {_id:3437}, end: {_id:3240}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"doctrinal belief,spiritual continuity", weight:1.0, description:"Jewish Tradition included beliefs in reincarnation as per Gnostic gospel and Dead Sea Scrolls.", created_at:1779229238, source_id:"chunk-98219edafe8ffc379bb20679c2f8f076"}}, {start: {_id:3439}, end: {_id:1005}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"emotional state,existential readiness", weight:1.0, description:"Fearlessness about death is achieved through living fully without regret or reservations.", created_at:1779229239, source_id:"chunk-98219edafe8ffc379bb20679c2f8f076"}}, {start: {_id:3440}, end: {_id:299}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"acceptance,existential embrace", weight:1.0, description:"Love for the \"end of the day\" symbolizes acceptance of life's impermanence and death's inevitability.", created_at:1779229240, source_id:"chunk-98219edafe8ffc379bb20679c2f8f076"}}, {start: {_id:287}, end: {_id:3405}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"existential continuity,metaphysical perspective", weight:1.0, description:"Life is viewed as an unending flow of experience beyond birth and death.", created_at:1779229240, source_id:"chunk-98219edafe8ffc379bb20679c2f8f076"}}, {start: {_id:3231}, end: {_id:3228}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=Oc5ar2g2rnI)", truncate:"", keywords:"afterlife,eschatological concept", weight:1.0, description:"Early Christianity believed in life after death as part of its theological framework.", created_at:1779229240, source_id:"chunk-98219edafe8ffc379bb20679c2f8f076"}}, {start: {_id:3445}, end: {_id:3442}, properties:{file_path:"unknown_source", truncate:"", keywords:"error correction,subject-verb agreement", weight:1.0, description:"Verb agreement correction for plural subject consistency and grammatical accuracy.", created_at:1779229931, source_id:"chunk-08f4904e8e77b13454b5704d698bedbc"}}, {start: {_id:3447}, end: {_id:3441}, properties:{file_path:"unknown_source", truncate:"", keywords:"adjective misplacement,error correction", weight:1.0, description:"Removal of \"beautiful\" to align with conceptual list structure and eliminate stylistic inconsistency.", created_at:1779229931, source_id:"chunk-08f4904e8e77b13454b5704d698bedbc"}}, {start: {_id:3444}, end: {_id:3446}, properties:{file_path:"unknown_source", truncate:"", keywords:"error correction,subject-verb agreement", weight:1.0, description:"Noun form correction for singular agreement with subject \"You\".", created_at:1779229931, source_id:"chunk-08f4904e8e77b13454b5704d698bedbc"}}, {start: {_id:3448}, end: {_id:3443}, properties:{file_path:"unknown_source", keywords:"error correction,transcription error", truncate:"", weight:1.0, description:"Direct fix removing extraneous \"no\" to eliminate redundancy, though creating repetition.", created_at:1779229931, source_id:"chunk-08f4904e8e77b13454b5704d698bedbc"}}, {start: {_id:2466}, end: {_id:2364}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=OWMBvMlGWTA)", truncate:"", keywords:"causation,mental processes", weight:1.0, description:"State arises from thoughts, emotions, perceptions, neurochemistry, neurophysiology, and spiritual energy.`", created_at:1779230028, source_id:"chunk-f75c5d6ff6cf90a0c79623ead0773fbc"}}, {start: {_id:3454}, end: {_id:3455}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=OWMBvMlGWTA)", truncate:"", keywords:"collective impact,transcendence", weight:1.0, description:"Awakened state fosters blessings for others and transcends personal suffering.", created_at:1779230028, source_id:"chunk-f75c5d6ff6cf90a0c79623ead0773fbc"}}, {start: {_id:786}, end: {_id:3458}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=OWMBvMlGWTA)", truncate:"", keywords:"emotional unity,empathic connection", weight:1.0, description:"Heart opening enables feeling others' joys and sorrows as one's own.", created_at:1779230028, source_id:"chunk-f75c5d6ff6cf90a0c79623ead0773fbc"}}, {start: {_id:1820}, end: {_id:2466}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=OWMBvMlGWTA)", truncate:"", keywords:"energy interaction,spiritual influence", weight:1.0, description:"Spiritual energy (Kundalini) impacts the depth of one's state and consciousness.", created_at:1779230028, source_id:"chunk-f75c5d6ff6cf90a0c79623ead0773fbc"}}, {start: {_id:3457}, end: {_id:39}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=OWMBvMlGWTA)", truncate:"", keywords:"emotional resonance,life alignment", weight:1.0, description:"Joyful states draw harmonious events and positive outcomes.", created_at:1779230029, source_id:"chunk-f75c5d6ff6cf90a0c79623ead0773fbc"}}, {start: {_id:2391}, end: {_id:3459}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=OWMBvMlGWTA)", truncate:"", keywords:"spiritual realization,unity", weight:1.0, description:"Experiencing the third level of oneness leads to enlightenment, where separation disappears and one realizes complete unity with all existence.", created_at:1779230078, source_id:"chunk-b1776121cc5dfb12d2007497b9b6d6fe"}}, {start: {_id:3462}, end: {_id:3460}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=OWMBvMlGWTA)", truncate:"", keywords:"emotional emergence,spiritual growth", weight:1.0, description:"In the second level of oneness, faith, love, and compassion arise within the individual, transcending previous judgments.", created_at:1779230078, source_id:"chunk-b1776121cc5dfb12d2007497b9b6d6fe"}}, {start: {_id:3317}, end: {_id:3460}, properties:{file_path:"YouTube Video: Unknown (URL: https://www.youtube.com/watch?v=OWMBvMlGWTA)", truncate:"", keywords:"social constructs,transcendence", weight:1.0, description:"The dissolution of class, gender, caste, race, and ideology occurs in the second level of oneness, as these categories no longer disconnect the individual.", created_at:1779230079, source_id:"chunk-b1776121cc5dfb12d2007497b9b6d6fe"}}] AS row
