# Mukthi Guru — local backup cron (disk only, no S3)
# =====================================================
# Install:
#   1. sudo mkdir -p /etc/mukthiguru /var/backups/mukthiguru /var/log/mukthiguru
#   2. Write env file /etc/mukthiguru/backup.env (chmod 600, root-owned):
#        REPO=/opt/askmukthiguru
#        QDRANT_URL=http://localhost:6333
#        BACKUP_BASE_DIR=/var/backups/mukthiguru
#        NEO4J_PASSWORD=<from backend/.env, never commit>
#        NEO4J_CONTAINER=mukthiguru-neo4j
#        QDRANT_WRITE_API_KEY=<write key; needed to create a snapshot, never given to the backend>
#        BACKUP_METRICS_DIR=/var/lib/node_exporter/textfile   (node_exporter textfile collector dir)
#        # or PUSHGATEWAY_URL=http://<pushgateway>:9091 instead of BACKUP_METRICS_DIR
#      With neither metrics sink set, backup_last_success_timestamp_seconds is not
#      reported and the BackupStale alert fires (nothing is reporting).
#      The first-person job runs from the backend virtualenv so --serving can read
#      the same Settings the backend reads: set PYTHON_BACKEND=/opt/askmukthiguru/backend/.venv/bin/python3
#   3. sudo cp infrastructure/cron/mukthiguru-backup /etc/cron.d/mukthiguru-backup
#      (Replace /opt/askmukthiguru below with the real checkout path if different;
#       the scripts resolve BACKUP_BASE_DIR/qdrant and .../neo4j beneath it.)
#   4. Verify next morning: ls -l /var/backups/mukthiguru/qdrant /var/backups/mukthiguru/neo4j
#
# Schedule: Qdrant snapshots 02:00, Neo4j dumps 02:30 daily. Retention 7 each.
# Restore procedure: docs/BACKUP_RESTORE.md (scratch-restore proof recorded there).

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 2 * * * root . /etc/mukthiguru/backup.env; /usr/bin/python3 $REPO/scripts/ops/backup_qdrant.py --collection spiritual_wisdom_contextual --retention 7 >> /var/log/mukthiguru/backup-qdrant.log 2>&1
# NEW-OPS-4 (2026-11-06): the serving collection is no longer pinned by name.
# --serving backs up first_person_collection and first_person_context_collection
# as the backend reads them from Settings (FIRST_PERSON_COLLECTION,
# FIRST_PERSON_CONTEXT_COLLECTION, FIRST_PERSON_ACTIVE_COLLECTION in
# /etc/mukthiguru/backup.env). It exits non-zero when no name resolves.
5 2 * * * root . /etc/mukthiguru/backup.env; $PYTHON_BACKEND $REPO/scripts/ops/backup_qdrant.py --serving --retention 7 >> /var/log/mukthiguru/backup-qdrant-fp.log 2>&1

30 2 * * * root . /etc/mukthiguru/backup.env; /usr/bin/python3 $REPO/scripts/ops/backup_neo4j.py --format dump --retention 7 >> /var/log/mukthiguru/backup-neo4j.log 2>&1
